// ============================================================================
// kütüphane/dizi.kem — KEMGU stdlib: bölge-tabanlı büyüyen Liste<T> (v2)
// ============================================================================
//
// GERÇEK ÇAPRAZ-DOSYA MODÜL. Ayrı bir main'den `kullan dizi;` ile import
// edilir; üyelere `dizi::oluştur` / `dizi::ekle` / `dizi::al` ... nitelikli
// erişimle (INFERENCE üzerinden) ulaşılır.
//
// v1 → v2 RELOCATION (B+A+C ile mümkün oldu):
//  - v1'de Liste<T> TOP-LEVEL'a zorlanmıştı + dosya self-contained'di
//    (modül + in-file main): çünkü (a) modül-içi struct emisyonu ve
//    (b) çapraz-modül generic routing YOKTU. İkisi de artık var:
//      * A (cok-dosya whole-program loader): dosya = modül; top-level
//        `genel` bildirimleri sentetik `modül dizi` ÜYESİ olur (mat.kem
//        düzeni). Böylece `yapı Liste<T>` artık modül dizi üyesi —
//        modül-içi yapı emisyonu type-erased `%Liste` üretir.
//      * C (capraz-modul generic mono): `dizi::ekle$i64` vb. çağrı-yerinde
//        owning-modül ("dizi") bağlamında specialize + emit edilir.
//  - Açık `modül dizi { }` SARMALAYICISI KALDIRILDI: loader dosyayı zaten
//    `modül dizi`'ye sarar; açık sarmalayıcı `dizi.dizi` İÇ-İÇE olurdu.
//  - In-file `main` + test_* KALDIRILDI (import edilince entry main'iyle
//    çakışır); doğrulama artık ayrı çapraz-dosya entry'lerinde
//    (test/moduller/dizi_*.kem).
//
// Tasarım notları (korunan):
//  - Liste<T> type-erased: `%Liste = {ptr,i64,i64}` (*T → ptr); T yalnız
//    specialized gövdede subst + inference yan-kanalıyla taşınır.
//  - Yetki disiplini: yetki<Bellek> LINEER — fonksiyona geçiş MOVE'dur
//    (Capability V1 sınırı, borrow yok). Her op yetkiyi son noktada TEK
//    geri_al ile tüketir; çağıran her çağrı için taze yetki üretir
//    (yetki_olustur ambient). ekle yetkiyi büyü'ye MOVE eder.
//  - Grow eleman-eleman döngüyle (dilde sizeof(T) yok → bayt-kopya değil).
//  - al() `varsayilan: T` ŞAHİT-paramı: sınır-dışında ÇÖKMEZLİK (panik yok)
//    + dönüş-T'sinin çıkarsanabilirliği.
//  - *T indeksleme yalnız güvensiz blokta (G001).
//
// İNFERENCE (D dilim-1 ile çözüldü — bkz. DECISIONS_LOG D-015):
//  - `oluştur(böl: yetki<Bellek>) -> Liste<T>` paramlarında T YOK → T yalnız
//    dönüş-bağlamı annotasyonundan çıkarsanır. ÜRETİM imzası budur. D dilim-1
//    nitelikli tip annotation (`değişken l: dizi::Liste<i64> = dizi::oluştur(böl)`)
//    çapraz-dosya T'yi verir (in-file return-context inference'ın çapraz-dosya
//    açılımı). D-014'teki DEMO witness-param (`taban: T`) KALDIRILDI — artık
//    gerek yok. `ekle`/`al` zaten T-değer param'lı (witness'sız çıkarsanır).

genel yapı Liste<T> {
    veri: *T;
    boy: tam64;
    kapasite: tam64;
}

// Boş liste (kapasite 0). Yetki yalnız 0-tahsis için ödünç alınır ve burada
// tüketilir (lineer disiplin). T dönüş-bağlamı (nitelikli annotation) ile gelir.
genel işlev oluştur<T>(böl: yetki<Bellek>) -> Liste<T> {
    değişken tampon: *T = bölge_al(böl, 0);
    geri_al(böl);
    ver Liste { veri: tampon, boy: 0, kapasite: 0 };
}

// Kapasiteyi tam n'e ayır (içerik korunmaz — ilk ayırma için).
genel işlev kapasiteAyır<T>(l: &Liste<T>, böl: yetki<Bellek>, n: tam64) {
    değişken yeni_veri: *T = bölge_al(böl, n);
    geri_al(böl);
    l.veri = yeni_veri;
    l.kapasite = n;
}

// Doluysa büyüt: 0 → 4, sonra 2×. İçerik eleman-eleman taşınır; eski tampon
// bölgeye terk edilir (v1 malloc-vekâleten, free yok). geri_al KOŞULSUZ son
// noktada (lineer denetçi akış-duyarsız — L005).
genel işlev büyü<T>(l: &Liste<T>, böl: yetki<Bellek>) {
    eğer l.boy == l.kapasite {
        değişken yeni_kap: tam64 = 4;
        eğer l.kapasite > (0 olarak tam64) {
            yeni_kap = l.kapasite * (2 olarak tam64);
        }
        değişken yeni_veri: *T = bölge_al(böl, yeni_kap);
        değişken eski: *T = l.veri;
        güvensiz {
            değişken i: tam64 = 0;
            iken i < l.boy {
                yeni_veri[i] = eski[i];
                i = i + (1 olarak tam64);
            }
        }
        l.veri = yeni_veri;
        l.kapasite = yeni_kap;
        ver;
    }
    geri_al(böl);
}

// Sona ekle; gerekirse büyür. Yetki büyü'ye MOVE edilir (tek tüketim).
genel işlev ekle<T>(l: &Liste<T>, böl: yetki<Bellek>, v: T) {
    büyü(l, böl);
    değişken d: *T = l.veri;
    güvensiz {
        d[l.boy] = v;
    }
    l.boy = l.boy + (1 olarak tam64);
}

// i. elemanı oku. Sınır dışı → varsayilan (ÇÖKMEZLİK: panik yok).
genel işlev al<T>(l: &Liste<T>, i: tam64, varsayilan: T) -> T {
    eğer i >= l.boy {
        ver varsayilan;
    }
    değişken d: *T = l.veri;
    güvensiz {
        ver d[i];
    }
}

genel işlev boy<T>(l: &Liste<T>) -> tam64 {
    ver l.boy;
}

// v1 NO-OP: tampon bölgeye aittir, bölgeyle birlikte ölür (gerçek arena V2).
genel işlev serbest<T>(l: Liste<T>) {
}
