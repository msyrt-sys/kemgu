// Gerçek QEMU xHCI enumerasyonu. Sabitler Python ile: int('febd0000',16), 2**20.
kullan drivers::usb::xhci_cekirdek::{ XhciDurum, XhciAygit, xhci_yeni, xhci_adim };
kullan drivers::usb::xhci_kayit::{ XhciYetenek };
kullan drivers::usb::xhci_trb::{ XhciHalka, XhciOlayHalkasi };
kullan drivers::usb::tanim::{ UsbAygit, UsbArayuz, UsbUc, UsbHid, UsbHidEk, UsbYapilandirma };
kullan drivers::ortak::gc::{ GcIstek, GcYanit, gc_bos };
kullan tests::qemu::qtest::{ Qt, qt_ac, qt_kapat, qt_pci_bul, qt_pci_bar_ata, qt_yurut, qt_bellek_oku };

kullan drivers::ortak::bayt::{ oku_le32 };
kullan tests::qemu::xhci_iz::{ iz_yaz };

genel sabit XHCI_BAR: tam64 = 4273799168;
genel işlev xhci_qsur(q: &değişken Qt, s: &değişken XhciDurum) -> sonuç<mantıksal,metin> {
    değişken y: GcYanit = gc_bos(); değişken i: tam32 = 0;
    iken i < 100000 {
        değişken istek: GcIstek = xhci_adim(s,y);
        eşleş istek { GcIstek::Bitti => { ver tamam(doğru); } GcIstek::Hata(e) => { ver hata(e); } _ => { y=qt_yurut(q,XHCI_BAR,istek); eğer arg_sayi() > 2 { eğer arg_al(2) == "iz" { iz_yaz(istek,y); } } } }
        i=i+1;
    } ver hata("xhci qtest adim siniri");
}
genel işlev xhci_qbaslat(q: &değişken Qt) -> sonuç<XhciDurum,metin> {
    eşleş qt_pci_bul(q,12,3,48) { hata(e) => { ver hata(e); } tamam(a) => { eşleş qt_pci_bar_ata(q,a,16,XHCI_BAR,doğru) { hata(e) => { ver hata(e); } tamam(v) => { } } } }
    eşleş xhci_yeni(1048576,16384) { hata(e) => { ver hata(e); } tamam(v) => { değişken s: XhciDurum = v; eşleş xhci_qsur(q,&değişken s) { hata(e) => { ver hata(e); } tamam(v) => { ver tamam(s); } } } }
}
// QEMU tarafından yazılan çıkış bağlamları; yalnız sürücünün tuttuğu kayıt yetmez.
genel işlev xhci_qdogrula(q: &değişken Qt, s: XhciDurum) -> sonuç<mantıksal,metin> {
    eğer dizi_boyut(s.aygitlar) != 2 { ver hata("xhci aygit sayisi"); }
    değişken depo: tam32 = 0; değişken klavye: tam32 = 0; değişken i: tam32 = 0;
    iken i < dizi_boyut(s.aygitlar) {
        değişken a: XhciAygit = dizi_al(s.aygitlar,i); i=i+1;
        eğer a.kimlik.pid != 1 veya dizi_boyut(a.yapi.arayuzlar) != 1 { ver hata("xhci kimlik veya arayuz sayisi"); }
        değişken ar: UsbArayuz = dizi_al(a.yapi.arayuzlar,0);
        eğer a.kimlik.vid == 18164 ve ar.sinif == 8 ve ar.alt_sinif == 6 ve ar.protokol == 80 {
            depo=depo+1; eğer dizi_boyut(a.yapi.uclar) != 2 { ver hata("xhci depo uc sayisi"); }
        } değilse eğer a.kimlik.vid == 1575 ve ar.sinif == 3 ve ar.alt_sinif == 1 ve ar.protokol == 1 {
            klavye=klavye+1; eğer dizi_boyut(a.yapi.uclar) != 1 { ver hata("xhci klavye uc sayisi"); }
        } değilse { ver hata("xhci olculen aygit kimligi"); }
        değişken taban: tam64 = s.dma+65536+(a.yuva olarak tam64)*2048;
        eşleş qt_bellek_oku(q,taban,s.c.baglam_boy) { hata(e) => { ver hata(e); } tamam(b) => { eğer ((oku_le32(b,12)>>27)&31) != 3 { ver hata("xhci yuva yapilandirilmadi"); } } }
        değişken uclar: Dizi<UsbUc> = a.yapi.uclar; değişken yonler: tam32 = 0;
        için u: uclar {
            değişken dci: tam32 = (u.adres&15)*2; değişken tur: tam32 = u.tur;
            eğer (u.adres&128) != 0 { dci=dci+1; tur=tur+4; yonler=yonler|1; } değilse { yonler=yonler|2; }
            eğer ar.sinif == 8 ve (u.tur != 2 veya (u.adres != 129 ve u.adres != 2) veya u.paket_bayt != 1024) { ver hata("xhci bulk tanimlayici"); }
            eğer ar.sinif == 3 ve (u.tur != 3 veya u.adres != 129 veya u.paket_bayt != 8 veya u.aralik != 7) { ver hata("xhci hid tanimlayici"); }
            eşleş qt_bellek_oku(q,taban+(dci*s.c.baglam_boy) olarak tam64,s.c.baglam_boy) {
                hata(e) => { ver hata(e); }
                tamam(b) => { eğer (oku_le32(b,0)&7) != 1 veya ((oku_le32(b,4)>>3)&7) != (tur olarak tam64) veya (oku_le32(b,4)>>16) != (u.paket_bayt olarak tam64) { ver hata("xhci gercek uc baglami"); } }
            }
        }
        eğer ar.sinif == 8 ve yonler != 3 { ver hata("xhci bulk yonleri"); }
    }
    eğer depo != 1 veya klavye != 1 { ver hata("xhci aygit siniflari"); }
    ver tamam(doğru);
}
işlev main() -> tam32 {
    eşleş qt_ac(metin_tam(arg_al(1)) olarak tam32) {
        hata(e) => { yazdir_metin(e); ver 1; }
        tamam(v) => {
            değişken q: Qt = v; değişken rc: tam32 = 0;
            eşleş xhci_qbaslat(&değişken q) {
                hata(e) => { yazdir_metin(metin_birlestir("QTEST_XHCI HATA ",e)); rc=1; }
                tamam(s) => {
                    eşleş xhci_qdogrula(&değişken q,s) { hata(e) => { yazdir_metin(metin_birlestir("QTEST_XHCI HATA ",e)); qt_kapat(&değişken q); ver 1; } tamam(v) => { } }
                    değişken ai: tam32 = 0; iken ai < dizi_boyut(s.aygitlar) { değişken a: XhciAygit = dizi_al(s.aygitlar,ai); ai=ai+1;
                        yazdir_metin(metin_birlestir("AYGIT ",tam_metin(a.port olarak tam64)));
                        yazdir_tam(a.yuva); yazdir_tam(a.hiz); yazdir_tam(a.kimlik.vid); yazdir_tam(a.kimlik.pid);
                        değişken ars: Dizi<UsbArayuz> = a.yapi.arayuzlar; için ar: ars { yazdir_metin("ARAYUZ"); yazdir_tam(ar.sinif); yazdir_tam(ar.alt_sinif); yazdir_tam(ar.protokol); }
                        değişken ucs: Dizi<UsbUc> = a.yapi.uclar; için u: ucs { yazdir_metin("UC"); yazdir_tam(u.adres); yazdir_tam(u.tur); yazdir_tam(u.paket_bayt); yazdir_tam(u.aralik); }
                    }
                    eğer dizi_boyut(s.aygitlar) != 2 { rc=1; } değilse { yazdir_metin("QTEST_XHCI OK"); }
                }
            }
            qt_kapat(&değişken q); ver rc;
        }
    }
}
