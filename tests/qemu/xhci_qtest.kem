// Gerçek QEMU xHCI enumerasyonu. Sabitler Python ile: int('febd0000',16), 2**20.
kullan drivers::usb::xhci_cekirdek::{ XhciDurum, XhciAygit, xhci_yeni, xhci_adim };
kullan drivers::usb::xhci_kayit::{ XhciYetenek };
kullan drivers::usb::xhci_trb::{ XhciHalka, XhciOlayHalkasi };
kullan drivers::usb::tanim::{ UsbAygit, UsbArayuz, UsbUc, UsbHid, UsbHidEk, UsbYapilandirma };
kullan drivers::ortak::gc::{ GcIstek, GcYanit, gc_bos };
kullan tests::qemu::qtest::{ Qt, qt_ac, qt_kapat, qt_pci_bul, qt_pci_bar_ata, qt_yurut };

genel sabit XHCI_BAR: tam64 = 4273799168;
genel işlev xhci_qsur(q: &değişken Qt, s: &değişken XhciDurum) -> sonuç<mantıksal,metin> {
    değişken y: GcYanit = gc_bos(); değişken i: tam32 = 0;
    iken i < 100000 {
        değişken istek: GcIstek = xhci_adim(s,y);
        eşleş istek { GcIstek::Bitti => { ver tamam(doğru); } GcIstek::Hata(e) => { ver hata(e); } _ => { y=qt_yurut(q,XHCI_BAR,istek); } }
        i=i+1;
    } ver hata("xhci qtest adim siniri");
}
genel işlev xhci_qbaslat(q: &değişken Qt) -> sonuç<XhciDurum,metin> {
    eşleş qt_pci_bul(q,12,3,48) { hata(e) => { ver hata(e); } tamam(a) => { eşleş qt_pci_bar_ata(q,a,16,XHCI_BAR,doğru) { hata(e) => { ver hata(e); } tamam(v) => { } } } }
    eşleş xhci_yeni(1048576,16384) { hata(e) => { ver hata(e); } tamam(v) => { değişken s: XhciDurum = v; eşleş xhci_qsur(q,&değişken s) { hata(e) => { ver hata(e); } tamam(v) => { ver tamam(s); } } } }
}
işlev main() -> tam32 {
    eşleş qt_ac(metin_tam(arg_al(1)) olarak tam32) {
        hata(e) => { yazdir_metin(e); ver 1; }
        tamam(v) => {
            değişken q: Qt = v; değişken rc: tam32 = 0;
            eşleş xhci_qbaslat(&değişken q) {
                hata(e) => { yazdir_metin(metin_birlestir("QTEST_XHCI HATA ",e)); rc=1; }
                tamam(s) => {
                    değişken ai: tam32 = 0; iken ai < dizi_boyut(s.aygitlar) { değişken a: XhciAygit = dizi_al(s.aygitlar,ai); ai=ai+1;
                        yazdir_metin(metin_birlestir("AYGIT ",tam_metin(a.port olarak tam64)));
                        yazdir_tam(a.yuva); yazdir_tam(a.hiz); yazdir_tam(a.kimlik.vid); yazdir_tam(a.kimlik.pid);
                        değişken ars: Dizi<UsbArayuz> = a.yapi.arayuzlar; için ar: ars { yazdir_metin("ARAYUZ"); yazdir_tam(ar.sinif); yazdir_tam(ar.alt_sinif); yazdir_tam(ar.protokol); }
                        değişken ucs: Dizi<UsbUc> = a.yapi.uclar; için u: ucs { yazdir_metin("UC"); yazdir_tam(u.adres); yazdir_tam(u.tur); yazdir_tam(u.paket_bayt); yazdir_tam(u.aralik); }
                    }
                    eğer dizi_boyut(s.aygitlar) != 2 { rc=1; } değilse { yazdir_metin("QTEST_XHCI OK"); }
                }
            }
            qt_kapat(&değişken q); ver rc;
        }
    }
}
