// NVMe sürücüsü (drivers/nvme/cekirdek.kem) GERÇEK QEMU NVMe aygıtına karşı.
// Çalıştırma: test/qtest_harness.sh nvme (QEMU'yu başlatır, diski hazırlar, sonucu
// ana makinede bağımsız doğrular). Argüman 1: qtest TCP portu.
// Disk deseni (harness yazar): sektör s'nin j. baytı = (s * 7 + j * 13 + 5) & 255.
// Yazma deseni (bu program yazar, harness doğrular): LBA 200.. bayt j = (j * 31 + 11) & 255.
kullan drivers::nvme::cekirdek::{ NvmeDurum, nvme_yeni, nvme_adim, nvme_oku, nvme_yaz, nvme_flush };
kullan drivers::ortak::gc::{ GcIstek, GcYanit, gc_bos };
kullan drivers::pci::yapilandirma::{ PciAygit, pci_coz };
kullan tests::qemu::qtest::{ Qt, qt_ac, qt_kapat, qt_pci_oku32, qt_pci_yaz32, qt_pci_baslik, qt_yurut };

sabit BAR0_TABANI: tam64 = 4273930240;   // 0xFEBF0000 — firmware yok, BAR'ı biz atıyoruz
sabit DMA_TABANI: tam64 = 1048576;       // 1 MiB — misafir RAM'i, sayfa hizalı
sabit YAZMA_LBA: tam64 = 200;
sabit YAZMA_SEKTOR: tam32 = 9;           // birden çok PRP sayfası (4608 bayt)

// Sürücüyü Bitti'ye kadar sür; her isteği gerçek aygıta yürüt.
işlev sur(q: &değişken Qt, s: &değişken NvmeDurum) -> sonuç<mantıksal, metin> {
    değişken y: GcYanit = gc_bos();
    değişken i: tam32 = 0;
    iken i < 200000 {
        değişken istek: GcIstek = nvme_adim(s, y);
        eşleş istek {
            GcIstek::Bitti => { ver tamam(doğru); }
            GcIstek::Hata(m) => { ver hata(m); }
            _ => { y = qt_yurut(q, BAR0_TABANI, istek); }
        }
        i = i + 1;
    }
    ver hata("adim siniri");
}

// Veriyolu 0'da sınıf 01/08/02 (NVMe) aygıtı ara.
işlev nvme_bul(q: &değişken Qt) -> sonuç<tam32, metin> {
    değişken a: tam32 = 0;
    iken a < 32 {
        eşleş qt_pci_oku32(q, a, 0) {
            hata(e) => { ver hata(e); }
            tamam(v) => {
                eğer (v & 65535) != 65535 {
                    eşleş qt_pci_baslik(q, a) {
                        hata(e) => { ver hata(e); }
                        tamam(b) => {
                            eşleş pci_coz(b) {
                                hiç => { }
                                değer(p) => {
                                    eğer p.sinif == 1 ve p.alt_sinif == 8 ve p.prog_if == 2 { ver tamam(a); }
                                }
                            }
                        }
                    }
                }
            }
        }
        a = a + 1;
    }
    ver hata("NVMe aygiti bulunamadi");
}

işlev beklenen(s: tam64, j: tam32) -> tam32 {
    ver (((s * 7) olarak tam32) + j * 13 + 5) & 255;
}

işlev calis(q: &değişken Qt) -> sonuç<metin, metin> {
    değişken aygit: tam32 = 0;
    eşleş nvme_bul(q) { hata(e) => { ver hata(e); } tamam(a) => { aygit = a; } }
    // BAR0 (64 bit bellek BAR'ı) ata, komut yazmacında bellek + veriyolu yöneticisi aç.
    eşleş qt_pci_yaz32(q, aygit, 16, BAR0_TABANI) { hata(e) => { ver hata(e); } tamam(x) => { } }
    eşleş qt_pci_yaz32(q, aygit, 20, 0) { hata(e) => { ver hata(e); } tamam(x) => { } }
    eşleş qt_pci_oku32(q, aygit, 4) {
        hata(e) => { ver hata(e); }
        tamam(k) => {
            eşleş qt_pci_yaz32(q, aygit, 4, (k & 4294901760) | (k & 65535) | 6) { hata(e) => { ver hata(e); } tamam(x) => { } }
        }
    }

    eşleş nvme_yeni(DMA_TABANI, 16) {
        hata(e) => { ver hata(e); }
        tamam(d) => { değişken s: NvmeDurum = d; ver akis(q, &değişken s); }
    }
}

işlev akis(q: &değişken Qt, s: &değişken NvmeDurum) -> sonuç<metin, metin> {
    eşleş sur(q, s) { hata(e) => { ver hata(metin_birlestir("baslatma: ", e)); } tamam(x) => { } }

    // (1) Oku: LBA 0..7, deseni doğrula.
    eşleş nvme_oku(s, 0, 8) { hata(e) => { ver hata(e); } tamam(x) => { } }
    eşleş sur(q, s) { hata(e) => { ver hata(metin_birlestir("okuma: ", e)); } tamam(x) => { } }
    eğer dizi_boyut(s.sonuc) != 8 * 512 { ver hata("okuma boyu"); }
    değişken i: tam32 = 0;
    iken i < 8 * 512 {
        eğer (dizi_al(s.sonuc, i) olarak tam32) != beklenen((i / 512) olarak tam64, i % 512) {
            ver hata(metin_birlestir("okuma deseni bozuk, bayt ", tam_metin(i olarak tam64)));
        }
        i = i + 1;
    }

    // (2) Yaz + flush: harness ana makinede imajdan doğrular.
    değişken veri: Dizi<dtam8> = [];
    i = 0;
    iken i < YAZMA_SEKTOR * 512 {
        dizi_ekle(veri, ((i * 31 + 11) & 255) olarak dtam8);
        i = i + 1;
    }
    eşleş nvme_yaz(s, YAZMA_LBA, veri) { hata(e) => { ver hata(e); } tamam(x) => { } }
    eşleş sur(q, s) { hata(e) => { ver hata(metin_birlestir("yazma: ", e)); } tamam(x) => { } }
    eşleş nvme_flush(s) { hata(e) => { ver hata(e); } tamam(x) => { } }
    eşleş sur(q, s) { hata(e) => { ver hata(metin_birlestir("flush: ", e)); } tamam(x) => { } }

    // (3) Geri oku (aygıt üzerinden gidiş-dönüş).
    eşleş nvme_oku(s, YAZMA_LBA, YAZMA_SEKTOR) { hata(e) => { ver hata(e); } tamam(x) => { } }
    eşleş sur(q, s) { hata(e) => { ver hata(metin_birlestir("geri okuma: ", e)); } tamam(x) => { } }
    i = 0;
    iken i < YAZMA_SEKTOR * 512 {
        eğer (dizi_al(s.sonuc, i) olarak tam32) != ((i * 31 + 11) & 255) { ver hata("geri okuma deseni bozuk"); }
        i = i + 1;
    }
    ver tamam(metin_birlestir(metin_birlestir("kapasite=", tam_metin(s.kapasite)),
        metin_birlestir(" blok=", tam_metin(s.blok_bayt olarak tam64))));
}

işlev main() -> tam32 {
    değişken port: tam32 = 45200;
    eğer arg_sayi() > 1 { port = metin_tam(arg_al(1)) olarak tam32; }
    eşleş qt_ac(port) {
        hata(e) => { yazdir_metin(metin_birlestir("QTEST_NVME HATA ", e)); ver 1; }
        tamam(q0) => {
            değişken q: Qt = q0;
            değişken kod: tam32 = 0;
            eşleş calis(&değişken q) {
                hata(e) => { yazdir_metin(metin_birlestir("QTEST_NVME HATA ", e)); kod = 1; }
                tamam(m) => { yazdir_metin(metin_birlestir("QTEST_NVME OK ", m)); }
            }
            qt_kapat(&değişken q);
            ver kod;
        }
    }
}
