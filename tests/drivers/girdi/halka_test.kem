// Beklentiler: python3 tools/codex/d8.py; bağımsız collections.deque FIFO modeli.
kullan drivers::girdi::halka::{ Halka, halka_yeni, it, al, bos_mu, sayi };
işlev esit(o: seçimlik<tam64>, n: tam64) -> mantıksal { eşleş o { hiç => { ver yanlış; } değer(v) => { ver v == n; } } }
işlev bos(o: seçimlik<tam64>) -> mantıksal { eşleş o { hiç => { ver doğru; } değer(v) => { ver yanlış; } } }

işlev test_bos() -> mantıksal {
    eşleş halka_yeni(3) { hata(e) => { ver yanlış; } tamam(v) => { değişken d: Halka = v;
        ver bos_mu(d) ve sayi(d) == 0 ve d.kayip == 0 ve bos(al(&değişken d));
    } }
}

işlev test_fifo() -> mantıksal {
    eşleş halka_yeni(3) { hata(e) => { ver yanlış; } tamam(v) => { değişken d: Halka = v;
        it(&değişken d, 4294967297 olarak tam64); it(&değişken d, -7 olarak tam64); it(&değişken d, 9223372036854775807 olarak tam64);
        ver esit(al(&değişken d), 4294967297 olarak tam64) ve esit(al(&değişken d), -7 olarak tam64) ve esit(al(&değişken d), 9223372036854775807 olarak tam64) ve bos_mu(d);
    } }
}

işlev test_en_yeniyi_at() -> mantıksal {
    eşleş halka_yeni(3) { hata(e) => { ver yanlış; } tamam(v) => { değişken d: Halka = v;
        it(&değişken d, 11 olarak tam64); it(&değişken d, 22 olarak tam64); it(&değişken d, 33 olarak tam64);
        eğer it(&değişken d, 44 olarak tam64) { ver yanlış; }
        ver d.kayip == 1 ve sayi(d) == 3 ve esit(al(&değişken d), 11 olarak tam64) ve esit(al(&değişken d), 22 olarak tam64) ve esit(al(&değişken d), 33 olarak tam64);
    } }
}

işlev test_sifir() -> mantıksal {
    eşleş halka_yeni(0) { hata(e) => { ver yanlış; } tamam(v) => { değişken d: Halka = v;
        ver değil it(&değişken d, 1 olarak tam64) ve bos(al(&değişken d)) ve bos_mu(d) ve d.kayip == 1;
    } }
}

işlev test_bir() -> mantıksal {
    eşleş halka_yeni(1) { hata(e) => { ver yanlış; } tamam(v) => { değişken d: Halka = v;
        değişken i: tam32 = 0;
        iken i < 100 { eğer değil it(&değişken d, i olarak tam64) { ver yanlış; } eğer değil esit(al(&değişken d), i olarak tam64) { ver yanlış; } i = i + 1; }
        ver bos_mu(d) ve d.kayip == 0;
    } }
}

işlev test_kayip_doygun() -> mantıksal {
    eşleş halka_yeni(0) { hata(e) => { ver yanlış; } tamam(v) => { değişken d: Halka = v;
        d.kayip = 9223372036854775807; it(&değişken d, 3 olarak tam64); ver d.kayip == 9223372036854775807;
    } }
}

işlev test_gecersiz_1() -> mantıksal {
    eşleş halka_yeni(-1) { tamam(v) => { ver yanlış; } hata(e) => { ver metin_esit(e, "kapasite"); } }
}

işlev test_gecersiz_1048577() -> mantıksal {
    eşleş halka_yeni(1048577) { tamam(v) => { ver yanlış; } hata(e) => { ver metin_esit(e, "kapasite"); } }
}

işlev test_ust_sinir() -> mantıksal {
    eşleş halka_yeni(1048576) { hata(e) => { ver yanlış; } tamam(v) => { değişken d: Halka = v;
        ver dizi_boyut(d.veri) == 1048576 ve sayi(d) == 0;
    } }
}

