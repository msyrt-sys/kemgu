// Fikstürler: python3 tools/codex/c6.py; struct ve readelf -lhW /bin/true.
kullan drivers::elf::elf64::{ Elf64, ElfSegment, elf64_coz };
kullan drivers::ortak::bayt::{ bayt_sifir, yaz_u8, yaz_le16, yaz_le32, yaz_le64 };
kullan tests::drivers::elf::veri::gercek_elf::{ gercek_imaj };
işlev elf_verisi() -> Dizi<dtam8> {
    değişken b: Dizi<dtam8> = bayt_sifir(512);
    yaz_u8(b, 0, 127);
    yaz_u8(b, 1, 69);
    yaz_u8(b, 2, 76);
    yaz_u8(b, 3, 70);
    yaz_u8(b, 4, 2);
    yaz_u8(b, 5, 1);
    yaz_u8(b, 6, 1);
    yaz_u8(b, 16, 2);
    yaz_u8(b, 18, 62);
    yaz_u8(b, 20, 1);
    yaz_u8(b, 24, 1);
    yaz_u8(b, 26, 64);
    yaz_u8(b, 32, 64);
    yaz_u8(b, 52, 64);
    yaz_u8(b, 54, 56);
    yaz_u8(b, 56, 2);
    yaz_u8(b, 64, 1);
    yaz_u8(b, 68, 5);
    yaz_u8(b, 72, 128);
    yaz_u8(b, 73, 1);
    yaz_u8(b, 82, 64);
    yaz_u8(b, 96, 16);
    yaz_u8(b, 104, 32);
    yaz_u8(b, 112, 1);
    yaz_u8(b, 120, 1);
    yaz_u8(b, 124, 6);
    yaz_u8(b, 128, 144);
    yaz_u8(b, 129, 1);
    yaz_u8(b, 138, 80);
    yaz_u8(b, 152, 16);
    yaz_u8(b, 160, 32);
    yaz_u8(b, 168, 1);
    ver b;
}

işlev test_yuklemeler() -> mantıksal {
    eşleş elf64_coz(elf_verisi()) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken e: Elf64 = v; değişken xs: Dizi<ElfSegment> = e.yuklemeler;
        eğer e.makine != 62 veya e.tur != 2 veya e.giris != 4194305 veya dizi_boyut(xs) != 2 { ver yanlış; }
        değişken x: ElfSegment = dizi_al(xs, 0);
        ver x.dosya_ofseti == 384 ve x.sanal_adres == 4194304 ve x.dosya_boyu == 16 ve x.bellek_boyu == 32 ve x.bayraklar == 5;
    } }
}

işlev test_imza() -> mantıksal {
    değişken b: Dizi<dtam8> = elf_verisi(); yaz_u8(b, 0, 0);
    eşleş elf64_coz(b) { tamam(v) => { ver yanlış; } hata(e) => { ver metin_esit(e, "imza"); } }
}

işlev test_sinif() -> mantıksal {
    değişken b: Dizi<dtam8> = elf_verisi(); yaz_u8(b, 4, 1);
    eşleş elf64_coz(b) { tamam(v) => { ver yanlış; } hata(e) => { ver metin_esit(e, "bicim"); } }
}

