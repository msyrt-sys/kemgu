işlev test_kisa() -> mantıksal {
    eşleş elf64_coz(bayt_sifir(63)) { tamam(v) => { ver yanlış; } hata(e) => { ver metin_esit(e, "kisa elf"); } }
}

işlev test_aarch64() -> mantıksal {
    değişken b: Dizi<dtam8> = elf_verisi(); yaz_le16(b, 18, 183);
    eşleş elf64_coz(b) { hata(e) => { ver yanlış; } tamam(v) => { değişken e: Elf64 = v; ver e.makine == 183; } }
}

işlev test_gercek() -> mantıksal {
    eşleş elf64_coz(gercek_imaj()) { hata(e) => { yazdir_metin(e); ver yanlış; } tamam(v) => {
        değişken e: Elf64 = v; değişken xs: Dizi<ElfSegment> = e.yuklemeler;
        eğer e.giris != 6208 veya e.makine != 183 veya dizi_boyut(xs) != 2 { ver yanlış; }
        değişken s0: ElfSegment = dizi_al(xs, 0);
        eğer s0.bayraklar != 5 veya s0.dosya_ofseti != 0 veya s0.sanal_adres != 0 veya s0.dosya_boyu != 17148 veya s0.bellek_boyu != 17148 veya s0.hiza != 65536 { ver yanlış; }
        değişken s1: ElfSegment = dizi_al(xs, 1);
        eğer s1.bayraklar != 6 veya s1.dosya_ofseti != 64592 veya s1.sanal_adres != 130128 veya s1.dosya_boyu != 1080 veya s1.bellek_boyu != 1096 veya s1.hiza != 65536 { ver yanlış; }
        ver doğru;
    } }
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_yuklemeler() { yazdir_metin("BASARISIZ yuklemeler"); h = h + 1; }
    eğer değil test_imza() { yazdir_metin("BASARISIZ imza"); h = h + 1; }
    eğer değil test_sinif() { yazdir_metin("BASARISIZ sinif"); h = h + 1; }
    eğer değil test_endian() { yazdir_metin("BASARISIZ endian"); h = h + 1; }
    eğer değil test_makine() { yazdir_metin("BASARISIZ makine"); h = h + 1; }
    eğer değil test_ph_boyu() { yazdir_metin("BASARISIZ ph_boyu"); h = h + 1; }
    eğer değil test_ph_tasma() { yazdir_metin("BASARISIZ ph_tasma"); h = h + 1; }
    eğer değil test_dosya_buyuk() { yazdir_metin("BASARISIZ dosya_buyuk"); h = h + 1; }
    eğer değil test_dosya_sinir() { yazdir_metin("BASARISIZ dosya_sinir"); h = h + 1; }
    eğer değil test_wx() { yazdir_metin("BASARISIZ wx"); h = h + 1; }
    eğer değil test_ortusme() { yazdir_metin("BASARISIZ ortusme"); h = h + 1; }
    eğer değil test_giris_rw() { yazdir_metin("BASARISIZ giris_rw"); h = h + 1; }
    eğer değil test_giris_son() { yazdir_metin("BASARISIZ giris_son"); h = h + 1; }
    eğer değil test_adres_tasma() { yazdir_metin("BASARISIZ adres_tasma"); h = h + 1; }
    eğer değil test_hiza() { yazdir_metin("BASARISIZ hiza"); h = h + 1; }
    eğer değil test_ph_sayi() { yazdir_metin("BASARISIZ ph_sayi"); h = h + 1; }
    eğer değil test_kisa() { yazdir_metin("BASARISIZ kisa"); h = h + 1; }
    eğer değil test_aarch64() { yazdir_metin("BASARISIZ aarch64"); h = h + 1; }
    eğer değil test_gercek() { yazdir_metin("BASARISIZ gercek"); h = h + 1; }
    ver h;
}
