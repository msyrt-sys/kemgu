}
işlev test_sinir() -> mantıksal {
    değişken b: Dizi<dtam8> = bayt_sifir(8);
    eşleş oku_be16(b,7) { tamam(v) => { ver yanlış; } hata(e) => { } }
    eşleş oku_be32(b,0-1) { tamam(v) => { ver yanlış; } hata(e) => { } }
