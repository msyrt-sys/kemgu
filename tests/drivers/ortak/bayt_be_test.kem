    eşleş oku_be32(b,2) { hata(e) => { ver yanlış; } tamam(v) => { eğer v != 2309737967 { ver yanlış; } } }
    eşleş oku_be64(b,6) { hata(e) => { ver yanlış; } tamam(v) => { ver v == 81985529216486895; } }
