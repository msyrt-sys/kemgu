// Kâhin: python3 -c "import struct; print(list(struct.pack('>HIQ',0x1234,0x89abcdef,0x0123456789abcdef)))"
kullan drivers::ortak::bayt::{ bayt_sifir, oku_be16, oku_be32, oku_be64, yaz_be16, yaz_be32, yaz_be64 };
işlev test_okuma() -> mantıksal {
