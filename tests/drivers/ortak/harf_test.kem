// Kahin: python3 tools/codex/f4.py; Python Unicode 15.0.0, Türkçe özel çiftleri.
kullan drivers::ortak::harf_veri::{ HarfEsleme };
kullan drivers::ortak::harf::{ buyuk_harf, kucuk_harf };
kullan drivers::fs::yol_harf::{ yol_esit };

işlev test_donus_0() -> mantıksal {
    ver metin_esit(buyuk_harf("iİıI"), "İİII") ve metin_esit(kucuk_harf("iİıI"), "iiıı");
}

işlev test_donus_1() -> mantıksal {
    ver metin_esit(buyuk_harf("çğıöşü ÇĞIÖŞÜ"), "ÇĞIÖŞÜ ÇĞIÖŞÜ") ve metin_esit(kucuk_harf("çğıöşü ÇĞIÖŞÜ"), "çğıöşü çğıöşü");
}

işlev test_donus_2() -> mantıksal {
    ver metin_esit(buyuk_harf("istanbul IĞDIR İZMİR"), "İSTANBUL IĞDIR İZMİR") ve metin_esit(kucuk_harf("istanbul IĞDIR İZMİR"), "istanbul ığdır izmir");
}

işlev test_donus_3() -> mantıksal {
    ver metin_esit(buyuk_harf("abcXYZ"), "ABCXYZ") ve metin_esit(kucuk_harf("abcXYZ"), "abcxyz");
}

işlev test_donus_4() -> mantıksal {
    ver metin_esit(buyuk_harf("Straße ﬃ"), "STRASSE FFI") ve metin_esit(kucuk_harf("Straße ﬃ"), "straße ﬃ");
}

işlev test_donus_5() -> mantıksal {
    ver metin_esit(buyuk_harf("Σσς"), "ΣΣΣ") ve metin_esit(kucuk_harf("Σσς"), "σσς");
}

işlev test_donus_6() -> mantıksal {
    ver metin_esit(buyuk_harf("ЯБВ абв"), "ЯБВ АБВ") ve metin_esit(kucuk_harf("ЯБВ абв"), "ябв абв");
}

işlev test_donus_7() -> mantıksal {
    ver metin_esit(buyuk_harf("𐐨𐐀"), "𐐀𐐀") ve metin_esit(kucuk_harf("𐐨𐐀"), "𐐨𐐨");
}

işlev test_donus_8() -> mantıksal {
    ver metin_esit(buyuk_harf("😀 123!?"), "😀 123!?") ve metin_esit(kucuk_harf("😀 123!?"), "😀 123!?");
}

işlev test_donus_9() -> mantıksal {
    ver metin_esit(buyuk_harf(""), "") ve metin_esit(kucuk_harf(""), "");
}

