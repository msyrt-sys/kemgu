işlev test_bozuk_utf8() -> mantıksal {
    değişken s: metin = metin_kes("ğ", 0, 1); ver metin_esit(buyuk_harf(s), "�") ve metin_esit(kucuk_harf(s), "�");
}

işlev test_yol_0() -> mantıksal {
    eşleş yol_esit("/İZMİR/./a", "//izmir/a", doğru) { hata(e) => { ver yanlış; } tamam(v) => { ver v == doğru; } }
}

işlev test_yol_1() -> mantıksal {
    eşleş yol_esit("/IĞDIR", "/ığdır", doğru) { hata(e) => { ver yanlış; } tamam(v) => { ver v == doğru; } }
}

işlev test_yol_2() -> mantıksal {
    eşleş yol_esit("/I", "/i", doğru) { hata(e) => { ver yanlış; } tamam(v) => { ver v == yanlış; } }
}

işlev test_yol_3() -> mantıksal {
    eşleş yol_esit("/İ", "/ı", doğru) { hata(e) => { ver yanlış; } tamam(v) => { ver v == yanlış; } }
}

işlev test_yol_4() -> mantıksal {
    eşleş yol_esit("/Ğ", "/ğ", yanlış) { hata(e) => { ver yanlış; } tamam(v) => { ver v == yanlış; } }
}

işlev test_yol_5() -> mantıksal {
    eşleş yol_esit("/x/../a", "/a", yanlış) { hata(e) => { ver yanlış; } tamam(v) => { ver v == doğru; } }
}

işlev test_yol_6() -> mantıksal {
    eşleş yol_esit("/ß", "/ss", doğru) { hata(e) => { ver yanlış; } tamam(v) => { ver v == yanlış; } }
}

işlev test_yol_7() -> mantıksal {
    eşleş yol_esit("/é", "/é", doğru) { hata(e) => { ver yanlış; } tamam(v) => { ver v == yanlış; } }
}

işlev test_yol_red() -> mantıksal {
    eşleş yol_esit("goreli", "/goreli", doğru) { tamam(v) => { ver yanlış; } hata(e) => { ver metin_esit(e, "goreli"); } }
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_donus_0() { yazdir_metin("BASARISIZ donus_0"); h = h + 1; }
    eğer değil test_donus_1() { yazdir_metin("BASARISIZ donus_1"); h = h + 1; }
    eğer değil test_donus_2() { yazdir_metin("BASARISIZ donus_2"); h = h + 1; }
    eğer değil test_donus_3() { yazdir_metin("BASARISIZ donus_3"); h = h + 1; }
    eğer değil test_donus_4() { yazdir_metin("BASARISIZ donus_4"); h = h + 1; }
    eğer değil test_donus_5() { yazdir_metin("BASARISIZ donus_5"); h = h + 1; }
