    eğer değil test_bozuk_utf8_7() { yazdir_metin("BASARISIZ bozuk_utf8_7"); h = h + 1; }
    eğer değil test_bozuk_utf8_8() { yazdir_metin("BASARISIZ bozuk_utf8_8"); h = h + 1; }
    eğer değil test_bozuk_utf8_9() { yazdir_metin("BASARISIZ bozuk_utf8_9"); h = h + 1; }
    eğer değil test_bozuk_utf8_10() { yazdir_metin("BASARISIZ bozuk_utf8_10"); h = h + 1; }
    eğer değil test_bozuk_utf16_0() { yazdir_metin("BASARISIZ bozuk_utf16_0"); h = h + 1; }
    eğer değil test_bozuk_utf16_1() { yazdir_metin("BASARISIZ bozuk_utf16_1"); h = h + 1; }
    eğer değil test_bozuk_utf16_2() { yazdir_metin("BASARISIZ bozuk_utf16_2"); h = h + 1; }
    eğer değil test_bozuk_utf16_3() { yazdir_metin("BASARISIZ bozuk_utf16_3"); h = h + 1; }
    eğer değil test_bozuk_utf16_4() { yazdir_metin("BASARISIZ bozuk_utf16_4"); h = h + 1; }
    eğer değil test_bozuk_utf16_5() { yazdir_metin("BASARISIZ bozuk_utf16_5"); h = h + 1; }
    eğer değil test_sinir_ofset() { yazdir_metin("BASARISIZ sinir_ofset"); h = h + 1; }
    eğer değil test_gecersiz_skaler() { yazdir_metin("BASARISIZ gecersiz_skaler"); h = h + 1; }
    ver h;
}
