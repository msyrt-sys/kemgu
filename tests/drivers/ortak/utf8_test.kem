    değişken b: Dizi<dtam8> = bayt_sifir(2);
    yaz_u8(b, 0, 0);
    yaz_u8(b, 1, 220);
    değişken beklenen: Dizi<tam32> = [65533];
    ver kod_esit(utf16le_coz(b, 0, 8), beklenen);
}

