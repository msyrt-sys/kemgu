    değişken s: metin = metin_birlestir(metin_birlestir(metin_birlestir(metin_birlestir("", metin_kes(kod_metin(1114111), 0, 1)), metin_kes(kod_metin(1114111), 2, 1)), metin_kes(kod_metin(1114111), 2, 1)), metin_kes(kod_metin(1114111), 2, 1));
    değişken beklenen: Dizi<tam32> = [65533, 65533, 65533, 65533];
