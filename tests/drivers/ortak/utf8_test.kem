işlev test_sinir_ofset() -> mantıksal {
    değişken b: Dizi<dtam8> = bayt_sifir(10);
    yaz_u8(b, 0, 120);
    yaz_u8(b, 1, 0);
    yaz_u8(b, 2, 61);
    yaz_u8(b, 3, 216);
    yaz_u8(b, 4, 0);
    yaz_u8(b, 5, 222);
    yaz_u8(b, 6, 0);
    yaz_u8(b, 7, 0);
    yaz_u8(b, 8, 65);
    yaz_u8(b, 9, 0);
    değişken emoji: Dizi<tam32> = [128512];
    değişken eksik: Dizi<tam32> = [65533];
    ver kod_esit(utf16le_coz(b, 2, 4), emoji) ve kod_esit(utf16le_coz(b, 2, 1), eksik) ve
        dizi_boyut(utf16le_coz(b, -1, 1)) == 0 ve dizi_boyut(utf16le_coz(b, 2147483647, 1)) == 0 ve
        dizi_boyut(utf16le_coz(b, 0, -1)) == 0;
}

işlev test_gecersiz_skaler() -> mantıksal {
    değişken k: Dizi<tam32> = [-1, 55296, 57343, 1114112];
    değişken beklenen: Dizi<tam32> = [65533, 65533, 65533, 65533];
    ver kod_esit(utf8_coz(utf8_kodla(k)), beklenen) ve kod_esit(utf16le_coz(utf16le_kodla(k), 0, 4), beklenen);
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_bos() { yazdir_metin("BASARISIZ bos"); h = h + 1; }
    eğer değil test_turkce() { yazdir_metin("BASARISIZ turkce"); h = h + 1; }
    eğer değil test_emoji() { yazdir_metin("BASARISIZ emoji"); h = h + 1; }
    eğer değil test_sinir() { yazdir_metin("BASARISIZ sinir"); h = h + 1; }
    eğer değil test_bozuk_utf8_0() { yazdir_metin("BASARISIZ bozuk_utf8_0"); h = h + 1; }
    eğer değil test_bozuk_utf8_1() { yazdir_metin("BASARISIZ bozuk_utf8_1"); h = h + 1; }
    eğer değil test_bozuk_utf8_2() { yazdir_metin("BASARISIZ bozuk_utf8_2"); h = h + 1; }
