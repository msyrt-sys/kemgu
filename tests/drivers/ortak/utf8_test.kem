    değişken beklenen: Dizi<tam32> = [65533, 65];
    ver kod_esit(utf8_coz(s), beklenen);
}

işlev test_bozuk_utf8_9() -> mantıksal {
    değişken s: metin = metin_birlestir(metin_birlestir(metin_birlestir("", metin_kes(kod_metin(8364), 0, 1)), "A"), metin_kes(kod_metin(8364), 2, 1));
    değişken beklenen: Dizi<tam32> = [65533, 65, 65533];
    ver kod_esit(utf8_coz(s), beklenen);
