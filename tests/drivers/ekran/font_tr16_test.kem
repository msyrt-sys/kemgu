        eşleş glif_indeksi(f,252) { hiç => { ver 5; } değer(g) => { eğer g != 129 { ver 6; } } } // ü
        eşleş glif_indeksi(f,220) { hiç => { ver 5; } değer(g) => { eğer g != 154 { ver 6; } } } // Ü
        eşleş glif_indeksi(f,9472) { hiç => { ver 5; } değer(g) => { eğer g != 196 { ver 6; } } } // ─
        eşleş glif_indeksi(f,9474) { hiç => { ver 5; } değer(g) => { eğer g != 179 { ver 6; } } } // │
        eşleş glif_indeksi(f,9484) { hiç => { ver 5; } değer(g) => { eğer g != 218 { ver 6; } } } // ┌
        eşleş glif_indeksi(f,9488) { hiç => { ver 5; } değer(g) => { eğer g != 191 { ver 6; } } } // ┐
        eşleş glif_indeksi(f,9492) { hiç => { ver 5; } değer(g) => { eğer g != 192 { ver 6; } } } // └
        eşleş glif_indeksi(f,9496) { hiç => { ver 5; } değer(g) => { eğer g != 217 { ver 6; } } } // ┘
        eşleş glif_indeksi(f,9500) { hiç => { ver 5; } değer(g) => { eğer g != 195 { ver 6; } } } // ├
        eşleş glif_indeksi(f,9508) { hiç => { ver 5; } değer(g) => { eğer g != 180 { ver 6; } } } // ┤
        eşleş glif_indeksi(f,9516) { hiç => { ver 5; } değer(g) => { eğer g != 194 { ver 6; } } } // ┬
        eşleş glif_indeksi(f,9524) { hiç => { ver 5; } değer(g) => { eğer g != 193 { ver 6; } } } // ┴
        eşleş glif_indeksi(f,9532) { hiç => { ver 5; } değer(g) => { eğer g != 197 { ver 6; } } } // ┼
        eşleş glif_indeksi(f,9552) { hiç => { ver 5; } değer(g) => { eğer g != 196 { ver 6; } } } // ═
        eşleş glif_indeksi(f,9553) { hiç => { ver 5; } değer(g) => { eğer g != 179 { ver 6; } } } // ║
        eşleş glif_indeksi(f,65533) { hiç => { ver 5; } değer(g) => { eğer g != 4 { ver 6; } } } // �
        eşleş glif_indeksi(f,1114112) { hiç => { } değer(g) => { ver 7; } }
    } }
    değişken kisa: Dizi<dtam8> = [54 olarak dtam8,4 olarak dtam8,3 olarak dtam8,16 olarak dtam8];
    eşleş psf_coz(kisa) { hata(e) => { } tamam(f) => { ver 8; } }
