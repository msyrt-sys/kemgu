// Beklenenler: Python gzip + struct PSF1 ayrıştırıcısı; toplam=sum((i+1)*v for i,v in enumerate(b)).
kullan drivers::ekran::font_tr16::{ font_tr16 } olarak ft;
kullan drivers::ekran::psf::{ psf_coz, glif_indeksi };
kullan drivers::ortak::bayt::{ oku_u8 };
işlev main() -> tam32 {
    değişken b: Dizi<dtam8> = font_tr16();
    eğer dizi_boyut(b) != 10804 { ver 1; }
    değişken sum: tam64 = 0; değişken i: tam32 = 0;
    iken i < dizi_boyut(b) { sum=sum+((i+1) olarak tam64)*(oku_u8(b,i) olarak tam64); i=i+1; }
    eğer sum != 4561817562 { ver 2; }
    eşleş psf_coz(b) { hata(e) => { ver 3; } tamam(f) => {
        eğer f.genislik != 8 veya f.yukseklik != 16 veya f.glif_sayisi != 512 { ver 4; }
        eşleş glif_indeksi(f,231) { hiç => { ver 5; } değer(g) => { eğer g != 135 { ver 6; } } } // ç
