// Beklentiler: python3 tools/codex/d4.py; ord ve 8-(x%8) sekme hesabı.
kullan drivers::ekran::konsol::{ Konsol, konsol_yeni, konsol_kod, konsol_metin, konsol_imlec, konsol_alan_sil, kirli_satirlar, konsol_satir };

işlev test_sarma() -> mantıksal {
    eşleş konsol_yeni(4, 3, 7, 0) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken k: Konsol = v;
        konsol_metin(&değişken k, "ABCDE");
        ver metin_esit(konsol_satir(k, 0), "ABCD") ve metin_esit(konsol_satir(k, 1), "E   ") ve k.x == 1 ve k.y == 1;
    } }
}

işlev test_kaydir() -> mantıksal {
    eşleş konsol_yeni(4, 3, 7, 0) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken k: Konsol = v;
        konsol_metin(&değişken k, "ABCDEFGHIJKL");
        ver metin_esit(konsol_satir(k, 0), "EFGH") ve metin_esit(konsol_satir(k, 1), "IJKL") ve metin_esit(konsol_satir(k, 2), "    ") ve k.x == 0 ve k.y == 2;
    } }
}

işlev test_cr_lf() -> mantıksal {
    eşleş konsol_yeni(4, 3, 7, 0) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken k: Konsol = v;
        konsol_metin(&değişken k, "AB"); konsol_kod(&değişken k, 13); konsol_metin(&değişken k, "X"); konsol_kod(&değişken k, 10);
        konsol_metin(&değişken k, "Y");
        ver metin_esit(konsol_satir(k, 0), "XB  ") ve metin_esit(konsol_satir(k, 1), "Y   ");
    } }
}

işlev test_geri_sil() -> mantıksal {
    eşleş konsol_yeni(4, 3, 7, 0) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken k: Konsol = v;
        konsol_kod(&değişken k, 8); konsol_metin(&değişken k, "ABCD"); konsol_kod(&değişken k, 8);
        ver k.x == 3 ve k.y == 0 ve metin_esit(konsol_satir(k, 0), "ABC ");
    } }
}

işlev test_sekme() -> mantıksal {
    eşleş konsol_yeni(12, 2, 7, 0) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken k: Konsol = v;
        konsol_metin(&değişken k, "A"); konsol_kod(&değişken k, 9);
        eğer k.x != 8 veya k.y != 0 { ver yanlış; }
        konsol_metin(&değişken k, "B"); ver metin_esit(konsol_satir(k, 0), "A       B   ");
    } }
}

işlev test_unicode() -> mantıksal {
    eşleş konsol_yeni(4, 3, 7, 0) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken k: Konsol = v;
        konsol_metin(&değişken k, "ğ😀");
        ver dizi_al(k.kodlar, 0) == 287 ve dizi_al(k.kodlar, 1) == 128512 ve k.x == 2;
    } }
}

işlev test_kirli() -> mantıksal {
    eşleş konsol_yeni(4, 3, 7, 0) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken k: Konsol = v;
        değişken ilk: Dizi<tam32> = kirli_satirlar(&değişken k);
        eğer dizi_boyut(ilk) != 3 veya dizi_boyut(kirli_satirlar(&değişken k)) != 0 { ver yanlış; }
        konsol_metin(&değişken k, "A");
        değişken xs: Dizi<tam32> = kirli_satirlar(&değişken k);
        ver dizi_boyut(xs) == 1 ve dizi_al(xs, 0) == 0 ve dizi_boyut(kirli_satirlar(&değişken k)) == 0;
    } }
}

işlev test_renk_kaydir() -> mantıksal {
    eşleş konsol_yeni(4, 3, 7, 0) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken k: Konsol = v;
        k.on = 1193046; k.arka = 11259375; konsol_metin(&değişken k, "A"); konsol_kod(&değişken k, 10);
        k.on = 7; k.arka = 0; konsol_metin(&değişken k, "B"); konsol_kod(&değişken k, 10);
        konsol_metin(&değişken k, "C"); konsol_kod(&değişken k, 10);
        ver dizi_al(k.kodlar, 0) == 66 ve dizi_al(k.renkler, 0) == 7 ve dizi_al(k.arkalar, 0) == 0;
    } }
}

işlev test_sil_ve_imlec() -> mantıksal {
    eşleş konsol_yeni(4, 3, 7, 0) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken k: Konsol = v;
        konsol_metin(&değişken k, "ABCDE"); konsol_alan_sil(&değişken k, -1, 3);
        konsol_imlec(&değişken k, 999, -1);
        ver metin_esit(konsol_satir(k, 0), "  CD") ve k.x == 3 ve k.y == 0;
    } }
}

işlev test_gecersiz_kod() -> mantıksal {
    eşleş konsol_yeni(4, 3, 7, 0) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken k: Konsol = v;
        konsol_kod(&değişken k, 0); konsol_kod(&değişken k, 127); konsol_kod(&değişken k, 55296);
        ver k.x == 1 ve dizi_al(k.kodlar, 0) == 65533;
    } }
}

işlev test_boyut_0() -> mantıksal {
    eşleş konsol_yeni(0, 1, 7, 0) { tamam(v) => { ver yanlış; } hata(e) => { ver metin_esit(e, "boyut"); } }
}

işlev test_boyut_1() -> mantıksal {
    eşleş konsol_yeni(1, 0, 7, 0) { tamam(v) => { ver yanlış; } hata(e) => { ver metin_esit(e, "boyut"); } }
}

işlev test_boyut_2() -> mantıksal {
    eşleş konsol_yeni(-1, 1, 7, 0) { tamam(v) => { ver yanlış; } hata(e) => { ver metin_esit(e, "boyut"); } }
}

işlev test_boyut_3() -> mantıksal {
    eşleş konsol_yeni(4096, 4096, 7, 0) { tamam(v) => { ver yanlış; } hata(e) => { ver metin_esit(e, "boyut"); } }
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_sarma() { yazdir_metin("BASARISIZ sarma"); h = h + 1; }
    eğer değil test_kaydir() { yazdir_metin("BASARISIZ kaydir"); h = h + 1; }
    eğer değil test_cr_lf() { yazdir_metin("BASARISIZ cr_lf"); h = h + 1; }
    eğer değil test_geri_sil() { yazdir_metin("BASARISIZ geri_sil"); h = h + 1; }
    eğer değil test_sekme() { yazdir_metin("BASARISIZ sekme"); h = h + 1; }
    eğer değil test_unicode() { yazdir_metin("BASARISIZ unicode"); h = h + 1; }
    eğer değil test_kirli() { yazdir_metin("BASARISIZ kirli"); h = h + 1; }
    eğer değil test_renk_kaydir() { yazdir_metin("BASARISIZ renk_kaydir"); h = h + 1; }
    eğer değil test_sil_ve_imlec() { yazdir_metin("BASARISIZ sil_ve_imlec"); h = h + 1; }
    eğer değil test_gecersiz_kod() { yazdir_metin("BASARISIZ gecersiz_kod"); h = h + 1; }
    eğer değil test_boyut_0() { yazdir_metin("BASARISIZ boyut_0"); h = h + 1; }
    eğer değil test_boyut_1() { yazdir_metin("BASARISIZ boyut_1"); h = h + 1; }
    eğer değil test_boyut_2() { yazdir_metin("BASARISIZ boyut_2"); h = h + 1; }
    eğer değil test_boyut_3() { yazdir_metin("BASARISIZ boyut_3"); h = h + 1; }
    ver h;
}
