işlev reddet(b: Dizi<dtam8>, x: mantıksal) -> mantıksal { eşleş acpi_kok_coz(b,x) { hata(e) => { ver doğru; } tamam(v) => { ver yanlış; } } }
işlev main() -> tam32 {
 değişken h: tam32 = 0;
 eşleş acpi_kok_coz(xsdt(),doğru) { hata(e) => { h=h+1; } tamam(a) => { eğer dizi_boyut(a) != 3 veya dizi_al(a,0) != 1234605616436508552 veya dizi_al(a,1) != 4275834880 veya dizi_al(a,2) != 4600385536 { h=h+1; } } }
 eşleş acpi_kok_coz(rsdt(),yanlış) { hata(e) => { h=h+1; } tamam(a) => { eğer dizi_boyut(a) != 2 veya dizi_al(a,0) != 324505600 veya dizi_al(a,1) != 610836480 { h=h+1; } } }
 eğer değil reddet(xsdt(),yanlış) { h=h+1; }
 eğer değil reddet(rsdt(),doğru) { h=h+1; }
 eğer değil reddet(bayt_sifir(35),doğru) { h=h+1; }
 değişken b: Dizi<dtam8> = xsdt(); yaz_u8(b,9,0); eğer değil reddet(b,doğru) { h=h+1; }
 b=rsdt(); yaz_u8(b,4,255); eğer değil reddet(b,yanlış) { h=h+1; }
 b=xsdt(); yaz_u8(b,4,59); yaz_u8(b,9,179); eğer değil reddet(b,doğru) { h=h+1; }
 b=rsdt(); yaz_u8(b,4,43); yaz_u8(b,9,172); eğer değil reddet(b,yanlış) { h=h+1; }
 ver h;
}
