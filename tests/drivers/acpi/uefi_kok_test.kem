// Python struct: XSDT 36+3*8=60, RSDT 36+2*4=44; sağlama toplamı sıfır.
kullan drivers::acpi::kok::{ acpi_kok_coz };
kullan drivers::ortak::bayt::{ bayt_sifir, yaz_u8 };
işlev xsdt() -> Dizi<dtam8> {
 değişken b: Dizi<dtam8> = bayt_sifir(60);
