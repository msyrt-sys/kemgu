kullan drivers::usb::depo::{ UsbDepo, usb_depo_yeni, usb_depo_oku, usb_depo_yaz, usb_depo_flush };
kullan tests::drivers::usb::sahte_depo::{ SahteDepo, sahte_depo_yeni };
kullan tests::drivers::usb::sahte_depo_sur::{ usb_test_sur };
kullan drivers::ortak::bayt::{ bayt_sifir, oku_u8, yaz_u8 };
işlev kabul(r: sonuç<mantıksal,metin>) -> mantıksal { eşleş r { tamam(v) => { ver v; } hata(e) => { yazdir_metin(e); ver yanlış; } } }
işlev test_io() -> mantıksal {
    değişken a: SahteDepo = sahte_depo_yeni();
    eşleş usb_depo_yeni(65536,8196,4152,1,2,130,1) { hata(e) => { ver yanlış; } tamam(d) => {
        değişken s: UsbDepo = d; eğer değil kabul(usb_test_sur(&değişken s,&değişken a)) veya s.kapasite != 80000 veya s.blok_bayt != 512 { ver yanlış; }
        değişken b: Dizi<dtam8> = bayt_sifir(66560); değişken i: tam32 = 0; iken i < 66560 { yaz_u8(b,i,((i*17+3)&255) olarak tam64); i=i+1; }
        eğer değil kabul(usb_depo_yaz(&değişken s,2,b)) veya değil kabul(usb_test_sur(&değişken s,&değişken a)) { ver yanlış; }
        eğer değil kabul(usb_depo_oku(&değişken s,2,130)) veya değil kabul(usb_test_sur(&değişken s,&değişken a)) veya dizi_boyut(s.sonuc) != 66560 { ver yanlış; }
        i=0; iken i < 66560 { eğer oku_u8(s.sonuc,i) != ((i*17+3)&255) { ver yanlış; } i=i+1; }
        eğer değil kabul(usb_depo_flush(&değişken s)) veya değil kabul(usb_test_sur(&değişken s,&değişken a)) { ver yanlış; }
        ver a.io_sayisi == 4 ve a.flush_sayisi == 1 ve a.ack_sayisi == 22;
    } }
}
işlev test_hata() -> mantıksal {
    değişken mod: tam32 = 1;
    iken mod <= 6 {
        değişken a: SahteDepo = sahte_depo_yeni();
        eşleş usb_depo_yeni(65536,8196,4152,1,2,130,1) { hata(e) => { ver yanlış; } tamam(d) => {
            değişken s: UsbDepo = d; eğer değil kabul(usb_test_sur(&değişken s,&değişken a)) { ver yanlış; } a.ariza=mod;
            eğer değil kabul(usb_depo_oku(&değişken s,1,1)) { ver yanlış; }
            eşleş usb_test_sur(&değişken s,&değişken a) { tamam(v) => { ver yanlış; } hata(e) => { } }
            eğer mod == 3 ve (a.kurtarma != 3 veya s.kurtarma != 3) { ver yanlış; }
            eğer mod == 5 ve (a.sense_sayisi != 1 veya s.anahtar != 5 veya s.asc != 32) { ver yanlış; }
        } } mod=mod+1;
    } ver doğru;
}
işlev main() -> tam32 { değişken h: tam32 = 0; eğer değil test_io() { yazdir_metin("io"); h=h+1; } eğer değil test_hata() { yazdir_metin("hata"); h=h+1; } ver h; }
