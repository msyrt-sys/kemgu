yapı Nokta { x: tam32; y: tam64; }
işlev uret() -> sonuç<Dizi<Nokta>, metin> {
    değişken d: Dizi<Nokta> = [];
    dizi_ekle(d, Nokta { x: 12, y: 2048 }); ver tamam(d);
}
işlev main() -> tam32 {
    eşleş uret() {
        hata(e) => { ver 1; }
        tamam(v) => {
            değişken xs: Dizi<Nokta> = v;
            değişken n: Nokta = dizi_al(xs, 0);
            eğer n.y == 2048 { ver 0; } ver 1;
        }
    }
}
