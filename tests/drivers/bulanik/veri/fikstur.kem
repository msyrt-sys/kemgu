genel işlev rsdp2() -> Dizi<dtam8> {
    değişken b: Dizi<dtam8> = bayt_sifir(36);
    yaz_u8(b, 0, 82);
    yaz_u8(b, 1, 83);
    yaz_u8(b, 2, 68);
    yaz_u8(b, 3, 32);
    yaz_u8(b, 4, 80);
    yaz_u8(b, 5, 84);
    yaz_u8(b, 6, 82);
    yaz_u8(b, 7, 32);
    yaz_u8(b, 9, 75);
    yaz_u8(b, 10, 69);
    yaz_u8(b, 11, 77);
    yaz_u8(b, 12, 71);
    yaz_u8(b, 13, 85);
    yaz_u8(b, 14, 32);
    yaz_u8(b, 15, 2);
    yaz_u8(b, 18, 16);
    yaz_u8(b, 20, 36);
    yaz_u8(b, 28, 2);
    yaz_u8(b, 8, ((256 - bayt_toplam8(b, 0, 20)) & 255) olarak tam64);
    yaz_u8(b, 32, ((256 - bayt_toplam8(b, 0, 36)) & 255) olarak tam64);
    ver b;
}
genel işlev sdt_verisi(xsdt: mantıksal) -> Dizi<dtam8> {
    değişken n: tam32 = 44;
    eğer xsdt { n = 52; }
    değişken b: Dizi<dtam8> = bayt_sifir(n);
    eğer xsdt { yaz_ascii(b, 0, "XSDT"); } değilse { yaz_ascii(b, 0, "RSDT"); }
    yaz_le32(b, 4, n olarak tam64); yaz_u8(b, 8, 1); yaz_ascii(b, 10, "KEMGU ");
    eğer xsdt { yaz_le64(b, 36, 4096); yaz_le64(b, 44, 8192); }
    değilse { yaz_le32(b, 36, 4096); yaz_le32(b, 40, 8192); }
    yaz_u8(b, 9, ((256 - bayt_toplam8(b, 0, n)) & 255) olarak tam64); ver b;
}
