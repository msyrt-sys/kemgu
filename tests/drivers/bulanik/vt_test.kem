// Deterministik panik-yok kahini: python3 tools/codex/e2.py; her döngü tam 300 örnek.
kullan drivers::ortak::bayt::{ bayt_sifir, oku_u8, yaz_u8 };
yapı Tohum { x: tam64; }
işlev rastgele(s: &değişken Tohum) -> tam32 {
    s.x = (s.x * 1103515245 + 12345) & 2147483647; ver s.x olarak tam32;
}
kullan drivers::ekran::konsol::{ Konsol, konsol_yeni };
kullan drivers::ekran::vt::{ VtDurumu, vt_yeni, vt_bayt, vt_bitir };
işlev dene(b: Dizi<dtam8>) -> mantıksal {
    eşleş konsol_yeni(16, 4, 7, 0) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken k: Konsol = v; değişken d: VtDurumu = vt_yeni(7, 0); değişken i: tam32 = 0;
        iken i < dizi_boyut(b) { vt_bayt(&değişken d, &değişken k, oku_u8(b, i)); i = i + 1; }
        vt_bitir(&değişken d, &değişken k);
        ver k.x >= 0 ve k.x < 16 ve k.y >= 0 ve k.y < 4 ve dizi_boyut(d.utf8) == 0 ve dizi_boyut(d.parametreler) <= 16;
    } }
}

işlev test_sifir_ve_bir() -> mantıksal {
    ver dene(bayt_sifir(0)) ve dene(bayt_sifir(1));
}

işlev test_rastgele() -> mantıksal {
    değişken s: Tohum = Tohum { x: 123 }; değişken i: tam32 = 0;
    iken i < 300 {
        değişken n: tam32 = rastgele(&değişken s) % 601; değişken b: Dizi<dtam8> = []; değişken j: tam32 = 0;
        iken j < n { dizi_ekle(b, (rastgele(&değişken s) & 255) olarak dtam8); j = j + 1; }
        eğer değil dene(b) { ver yanlış; } i = i + 1;
    }
    ver i == 300;
}

işlev test_mutasyon() -> mantıksal {
    değişken b: Dizi<dtam8> = [27 olarak dtam8, 91 olarak dtam8, 50 olarak dtam8, 74 olarak dtam8, 27 olarak dtam8, 91 olarak dtam8, 49 olarak dtam8, 59 olarak dtam8, 49 olarak dtam8, 72 olarak dtam8, 196 olarak dtam8, 159 olarak dtam8, 240 olarak dtam8, 159 olarak dtam8, 152 olarak dtam8, 128 olarak dtam8, 27 olarak dtam8, 91 olarak dtam8, 51 olarak dtam8, 49 olarak dtam8, 109 olarak dtam8, 65 olarak dtam8, 66 olarak dtam8, 67 olarak dtam8, 27 olarak dtam8, 91 olarak dtam8, 48 olarak dtam8, 109 olarak dtam8, 10 olarak dtam8];
    eğer değil dene(b) { ver yanlış; } değişken s: Tohum = Tohum { x: 456 }; değişken i: tam32 = 0;
    iken i < 300 { değişken yer: tam32 = rastgele(&değişken s) % dizi_boyut(b); değişken eski: tam32 = oku_u8(b, yer);
        değişken fark: tam32 = 1 + rastgele(&değişken s) % 255; yaz_u8(b, yer, (eski ^ fark) olarak tam64);
        eğer değil dene(b) { ver yanlış; } yaz_u8(b, yer, eski olarak tam64); i = i + 1;
    } ver i == 300;
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_sifir_ve_bir() { yazdir_metin("BASARISIZ sifir_ve_bir"); h = h + 1; }
    eğer değil test_rastgele() { yazdir_metin("BASARISIZ rastgele"); h = h + 1; }
    eğer değil test_mutasyon() { yazdir_metin("BASARISIZ mutasyon"); h = h + 1; }
    ver h;
}
