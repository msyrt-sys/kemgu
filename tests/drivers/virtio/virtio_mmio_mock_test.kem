    // MMIO yetkisi queue_num_max=0 hata yolunu calistirmak icin kullanilir.
    değişken y0: yetki<MMIO> = yetki_olustur(6, TEST_MMIO_OKU_YAZ);
    // MMIO yetkisi seed helper'indan init hata yoluna aktarilan sahipligi temsil eder.
    değişken y1: yetki<MMIO> = virtio_mmio_test_seed(
        y0,
        VIRTIO_MMIO_MAGIC_BEKLENEN,
        VIRTIO_MMIO_VERSION_MODERN,
        VIRTIO_MMIO_DEVICE_ID_BLOCK,
        VIRTIO_BLK_F_BLK_SIZE() olarak tam32,
