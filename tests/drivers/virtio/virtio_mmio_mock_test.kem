işlev test_queue_size_max_ustu_reject() -> mantıksal {
    // MMIO yetkisi queue_size > queue_num_max hata yolunu calistirmak icin kullanilir.
    değişken y0: yetki<MMIO> = yetki_olustur(6, TEST_MMIO_OKU_YAZ);
    // MMIO yetkisi seed helper'indan init hata yoluna aktarilan sahipligi temsil eder.
