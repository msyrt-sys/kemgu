işlev test_status_features_ok_helper() -> mantıksal {
    ver virtio_mmio_features_ok_set_mi(11) ve
        değil virtio_mmio_features_ok_set_mi(3);
}

işlev main() -> tam32 {
    eğer test_mmio_round_trip_magic() ve
       test_probe_okur() ve
       test_init_basari_final_status_15() ve
       test_status_register_final_15() ve
       test_invalid_magic_failed() ve
       test_legacy_version_reject() ve
       test_device_block_degil_reject() ve
       test_required_feature_missing_reject() ve
       test_queue_max_sifir_reject() ve
       test_queue_size_iki_kuvveti_degil_reject() ve
       test_queue_size_max_ustu_reject() ve
       test_status_features_ok_helper() {
        ver 0;
    }
    ver 1;
}
