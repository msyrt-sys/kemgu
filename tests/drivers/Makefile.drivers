# KEMGU sürücü testleri — kök Makefile'a DOKUNMADAN ayrı harness (AGENTS.md:72).
#
# Kullanım (repo kökünden):
#   make -f tests/drivers/Makefile.drivers                       # tüm yeşil sürücü testleri
#   make -f tests/drivers/Makefile.drivers calistir_blk_oku_test # tek test
#
# Önkoşul kemgu + runtime: kök Makefile target'ları ile derlenir (kök Makefile
# DEĞİŞTİRİLMEZ, yalnız çağrılır). Recipe: `kullan` import'ları kemgu tarafından
# CWD-göreli (repo kökü) çözülür; --llvm | clang -x ir | çalıştır, exit 0 = geçti.

ifeq ($(OS),Windows_NT)
EXE := .exe
else
EXE :=
endif

KEMGU  := build/kemgu$(EXE)
RT     := build/kdl_runtime.o build/kdl_runtime_mmio.o
DTESTS := tests/drivers/virtio

# Tüm host-mock sürücü testleri (9/9 yeşil). Ucuz/saf modeller önce, ağır
# blk init/oku/config sonra. Her test `--llvm | clang -x ir | run` ile koşar.
#
# NOT: `virtio_blk_init_test` (ve dolayısıyla `&Virtqueue` param + `sonuç<tam32,
# BagHatasi>` dönüş + `yetki<MMIO>` capability + nested-&Struct + mmio deseni)
# C-track codegen düzeltmeleriyle (D-086 `&ref param deref` + D1 generic
# `sonuç<T,E>` ptr layout) ARTIK YEŞİL — eski "&Struct+sonuç segfault" notu
# geçersiz. Diğer testler eksik `kullan` import'u eklenerek yeşillendi.
VIRTIO_TESTS := \
	virtio_status_test \
	virtio_feature_negotiation_test \
	virtqueue_layout_test \
	virtio_mock_transport_test \
	virtio_mmio_mock_test \
	virtqueue_bind_test \
	virtio_blk_config_test \
	virtio_blk_oku_test \
	virtio_blk_init_test

.PHONY: drivers_test onkosul $(addprefix calistir_,$(VIRTIO_TESTS))

drivers_test: $(addprefix calistir_,$(VIRTIO_TESTS))
	@echo "=== Tum (9/9) host-mock surucu testi gecti ==="

onkosul:
	$(MAKE) -f Makefile $(KEMGU) build/kdl_runtime.o build/kdl_runtime_mmio.o

# Her test için tek tip recipe:
#   1) kemgu --check  (cross-file kullan import + tip kontrol — exit 0)
#   2) kemgu --llvm | clang -x ir | çalıştır  (codegen + runtime — exit 0)
# Herhangi bir adım başarısızsa make hata ile durur (gate kırmızı olur).
# --check adımı, legacy cok-segment 'kullan a::b::c;' import çözümünün (ana.c
# legacy_kullan_yukle) regresyona girmemesini garanti eder.
define RUN_DTEST
calistir_$(1): onkosul
	@echo "--- $(1) ---"
	$$(KEMGU) --check $$(DTESTS)/$(1).kem
	$$(KEMGU) --llvm $$(DTESTS)/$(1).kem > build/_d_$(1).ll 2>build/_d_$(1).err
	clang -x ir build/_d_$(1).ll -x none $$(RT) -o build/_d_$(1)$$(EXE) 2>build/_d_$(1).cerr
	./build/_d_$(1)$$(EXE)
	@echo "  $(1): GECTI (--check + --llvm exit 0)"
endef
$(foreach t,$(VIRTIO_TESTS),$(eval $(call RUN_DTEST,$(t))))
