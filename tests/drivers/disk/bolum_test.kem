işlev baslik_onar(b: Dizi<dtam8>) {
    yaz_le32(b, 528, 0); yaz_le32(b, 528, crc32::crc32(b, 512, 92));
}
işlev hata_kodu(r: sonuç<Dizi<Bolum>, BolumHatasi>) -> tam32 {
    eşleş r {
        tamam(v) => { ver 0; }
        hata(e) => { eşleş e {
            BolumHatasi::KisaGirdi => { ver 1; } BolumHatasi::ImzaYok => { ver 2; }
            BolumHatasi::KorumaciMBRDegil => { ver 3; } BolumHatasi::GptImzaYok => { ver 4; }
            BolumHatasi::GptBaslikCrc => { ver 5; } BolumHatasi::GptGirdiCrc => { ver 6; }
            BolumHatasi::GptBoyut => { ver 7; }
        } }
    }
    ver 99;
}

işlev test_crc_rakam() -> mantıksal {
    değişken b: Dizi<dtam8> = bayt_sifir(9);
    yaz_ascii(b, 0, "123456789");
    ver crc32::crc32(b, 0, 9) == 3421780262 ve crc32::crc32(b, -1, 1) == 0 ve crc32::crc32(b, 0, 2147483647) == 0;
}

işlev test_crc_bos() -> mantıksal {
    değişken b: Dizi<dtam8> = bayt_sifir(0);
    yaz_ascii(b, 0, "");
    ver crc32::crc32(b, 0, 0) == 0 ve crc32::crc32(b, -1, 1) == 0 ve crc32::crc32(b, 0, 2147483647) == 0;
}

işlev test_crc_a() -> mantıksal {
    değişken b: Dizi<dtam8> = bayt_sifir(1);
    yaz_ascii(b, 0, "a");
    ver crc32::crc32(b, 0, 1) == 3904355907 ve crc32::crc32(b, -1, 1) == 0 ve crc32::crc32(b, 0, 2147483647) == 0;
}

işlev test_mbr() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    yaz_u8(b, 450, 12); yaz_le32(b, 454, 2048); yaz_le32(b, 458, 100000);
    eğer gpt_mi(b) { ver yanlış; }
    eşleş mbr_coz(b) { hata(e) => { ver yanlış; } tamam(v) => {
        eğer dizi_boyut(v) != 1 { ver yanlış; }
        // Bulgu C003: eşleş bağını açık dizi tipiyle yerel değişkene al.
        değişken bolumler: Dizi<Bolum> = v;
        değişken p: Bolum = dizi_al(bolumler, 0);
        ver p.tur == 12 ve p.baslangic_lba == 2048 ve p.sektor_sayisi == 100000 ve metin_esit(p.ad, "");
    } }
}

işlev test_gpt() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    eğer değil gpt_mi(b) { ver yanlış; }
    eşleş gpt_coz(b, 512) { hata(e) => { ver yanlış; } tamam(v) => {
        eğer dizi_boyut(v) != 1 { ver yanlış; }
        // Bulgu C003: eşleş bağını açık dizi tipiyle yerel değişkene al.
        değişken bolumler: Dizi<Bolum> = v;
        değişken p: Bolum = dizi_al(bolumler, 0);
        ver p.tur == 238 ve p.baslangic_lba == 34 ve p.sektor_sayisi == 1981 ve metin_esit(p.ad, "EFI");
    } }
}

işlev test_kisa() -> mantıksal {
    ver hata_kodu(mbr_coz(bayt_sifir(511))) == 1 ve değil gpt_mi(bayt_sifir(0));
}

işlev test_mbr_imza() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    yaz_u8(b, 510, 0);
    ver hata_kodu(mbr_coz(b)) == 2;
}

işlev test_korumaci() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    yaz_u8(b, 450, 12);
    ver hata_kodu(gpt_coz(b, 512)) == 3;
}

işlev test_gpt_imza() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    yaz_u8(b, 512, 0);
    ver hata_kodu(gpt_coz(b, 512)) == 4;
}

işlev test_baslik_crc() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    yaz_u8(b, 528, 0);
    ver hata_kodu(gpt_coz(b, 512)) == 5;
}

işlev test_girdi_crc() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    yaz_u8(b, 1024, 0);
    ver hata_kodu(gpt_coz(b, 512)) == 6;
}

işlev test_baslik_kisa() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    yaz_le32(b, 524, 91);
    ver hata_kodu(gpt_coz(b, 512)) == 7;
}

işlev test_baslik_tasma() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    yaz_le32(b, 524, 4294967295);
    ver hata_kodu(gpt_coz(b, 512)) == 7;
}

işlev test_girdi_kisa() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    yaz_le32(b, 596, 127); baslik_onar(b);
    ver hata_kodu(gpt_coz(b, 512)) == 7;
}

işlev test_girdi_tasma() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    yaz_le32(b, 592, 4294967295); baslik_onar(b);
    ver hata_kodu(gpt_coz(b, 512)) == 7;
}

işlev test_lba_tasma() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    yaz_le64(b, 584, 9223372036854775807); baslik_onar(b);
    ver hata_kodu(gpt_coz(b, 512)) == 7;
}

işlev test_lba_negatif() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    yaz_le64(b, 584, -1); baslik_onar(b);
    ver hata_kodu(gpt_coz(b, 512)) == 7;
}

işlev test_sektor_sifir() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    
    ver hata_kodu(gpt_coz(b, 0)) == 7;
}

işlev test_sektor_tasma() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    
    ver hata_kodu(gpt_coz(b, 2147483647)) == 7;
}

işlev test_ters_lba() -> mantıksal {
    değişken b: Dizi<dtam8> = test_diski();
    yaz_le64(b, 1064, 33); yaz_le32(b, 600, crc32::crc32(b, 1024, 512)); baslik_onar(b);
    ver hata_kodu(gpt_coz(b, 512)) == 7;
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_crc_rakam() { yazdir_metin("BASARISIZ crc_rakam"); h = h + 1; }
    eğer değil test_crc_bos() { yazdir_metin("BASARISIZ crc_bos"); h = h + 1; }
    eğer değil test_crc_a() { yazdir_metin("BASARISIZ crc_a"); h = h + 1; }
    eğer değil test_mbr() { yazdir_metin("BASARISIZ mbr"); h = h + 1; }
    eğer değil test_gpt() { yazdir_metin("BASARISIZ gpt"); h = h + 1; }
    eğer değil test_kisa() { yazdir_metin("BASARISIZ kisa"); h = h + 1; }
    eğer değil test_mbr_imza() { yazdir_metin("BASARISIZ mbr_imza"); h = h + 1; }
    eğer değil test_korumaci() { yazdir_metin("BASARISIZ korumaci"); h = h + 1; }
    eğer değil test_gpt_imza() { yazdir_metin("BASARISIZ gpt_imza"); h = h + 1; }
    eğer değil test_baslik_crc() { yazdir_metin("BASARISIZ baslik_crc"); h = h + 1; }
    eğer değil test_girdi_crc() { yazdir_metin("BASARISIZ girdi_crc"); h = h + 1; }
    eğer değil test_baslik_kisa() { yazdir_metin("BASARISIZ baslik_kisa"); h = h + 1; }
    eğer değil test_baslik_tasma() { yazdir_metin("BASARISIZ baslik_tasma"); h = h + 1; }
    eğer değil test_girdi_kisa() { yazdir_metin("BASARISIZ girdi_kisa"); h = h + 1; }
    eğer değil test_girdi_tasma() { yazdir_metin("BASARISIZ girdi_tasma"); h = h + 1; }
    eğer değil test_lba_tasma() { yazdir_metin("BASARISIZ lba_tasma"); h = h + 1; }
    eğer değil test_lba_negatif() { yazdir_metin("BASARISIZ lba_negatif"); h = h + 1; }
    eğer değil test_sektor_sifir() { yazdir_metin("BASARISIZ sektor_sifir"); h = h + 1; }
    eğer değil test_sektor_tasma() { yazdir_metin("BASARISIZ sektor_tasma"); h = h + 1; }
    eğer değil test_ters_lba() { yazdir_metin("BASARISIZ ters_lba"); h = h + 1; }
    ver h;
}
