işlev gpt_test() -> mantıksal {
    değişken h: Dizi<dtam8> = baslik();
    değişken b: Dizi<dtam8> = girdiler();
    değişken yol: Dizi<dtam8> = dugum();
    eşleş gpt_konum(h,8192) { hata(e) => { ver yanlış; } tamam(k) => {
        eşleş gpt_kimlikli(k,b) { hata(e) => { ver yanlış; } tamam(xs) => {
            eğer dizi_boyut(xs) != 1 { ver yanlış; }
            değişken p: DiskBolumu = dizi_al(xs,0);
            eğer p.no != 2 veya p.bas != 2048 veya p.adet != 4096 { ver yanlış; }
            eşleş acilis_dugumu(yol) { hata(e) => { ver yanlış; } tamam(a) => {
                eğer değil bolum_eslesir(a,p) { ver yanlış; }
            } }
            yaz_u8(yol,24,42);
            eşleş acilis_dugumu(yol) { hata(e) => { ver yanlış; } tamam(a) => {
                eğer bolum_eslesir(a,p) { ver yanlış; }
            } }
        } }
        // Girdi değişti, başlık CRC'si yerinde. İki CRC bağımsız denetlenir.
        yaz_u8(b,0,1);
        eşleş gpt_kimlikli(k,b) { tamam(v) => { ver yanlış; } hata(e) => {
            eğer değil metin_esit(e,"GPT girdi CRC") { ver yanlış; }
        } }
    } }
    yaz_u8(h,56,1);
    eşleş gpt_konum(h,8192) { tamam(v) => { ver yanlış; } hata(e) => { ver metin_esit(e,"GPT baslik CRC"); } }
}
işlev mbr_test() -> mantıksal {
    değişken m: Dizi<dtam8> = bayt_sifir(512);
    yaz_u8(m,510,85); yaz_u8(m,511,170);
    yaz_u8(m,466,12); yaz_le32(m,470,2048); yaz_le32(m,474,4096);
    yaz_le32(m,440,270544960);
    değişken yol: Dizi<dtam8> = dugum();
    yaz_le32(yol,24,270544960); yaz_u8(yol,40,1); yaz_u8(yol,41,1);
    eşleş mbr_kimlikli(m,8192) { hata(e) => { ver yanlış; } tamam(xs) => {
        eğer dizi_boyut(xs) != 1 { ver yanlış; }
        değişken p: DiskBolumu = dizi_al(xs,0);
        eşleş acilis_dugumu(yol) { hata(e) => { ver yanlış; } tamam(a) => {
            eğer değil bolum_eslesir(a,p) { ver yanlış; }
        } }
    } }
    eşleş mbr_kimlikli(m,6143) { tamam(v) => { ver yanlış; } hata(e) => { ver doğru; } }
}
işlev main() -> tam32 {
    eğer değil gpt_test() { ver 1; }
    eğer değil mbr_test() { ver 2; }
    ver 0;
}
