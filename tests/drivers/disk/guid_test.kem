// Beklentiler: python3 tools/codex/b9.py; uuid.UUID(...).bytes_le.
kullan drivers::disk::guid::{ guid_bicimle, guid_coz, guid_tur_adi };
kullan drivers::ortak::bayt::{ bayt_sifir, yaz_u8, oku_u8 };

işlev test_guid_0() -> mantıksal {
    değişken b: Dizi<dtam8> = bayt_sifir(16);
    yaz_u8(b, 0, 40);
    yaz_u8(b, 1, 115);
    yaz_u8(b, 2, 42);
    yaz_u8(b, 3, 193);
    yaz_u8(b, 4, 31);
    yaz_u8(b, 5, 248);
    yaz_u8(b, 6, 210);
    yaz_u8(b, 7, 17);
    yaz_u8(b, 8, 186);
    yaz_u8(b, 9, 75);
    yaz_u8(b, 10, 0);
    yaz_u8(b, 11, 160);
    yaz_u8(b, 12, 201);
    yaz_u8(b, 13, 62);
    yaz_u8(b, 14, 201);
    yaz_u8(b, 15, 59);
    eğer değil metin_esit(guid_tur_adi(b), "EFI System") { ver yanlış; }
    eşleş guid_bicimle(b) { hata(e) => { ver yanlış; } tamam(v) => { eğer değil metin_esit(v, "C12A7328-F81F-11D2-BA4B-00A0C93EC93B") { ver yanlış; } } }
    eşleş guid_coz("c12a7328-f81f-11d2-ba4b-00a0c93ec93b") { hata(e) => { ver yanlış; } tamam(v) => {
        değişken a: Dizi<dtam8> = v; değişken j: tam32 = 0;
        iken j < 16 { eğer oku_u8(a, j) != oku_u8(b, j) { ver yanlış; } j = j + 1; }
    } }
    ver doğru;
}

