işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_guid_0() { yazdir_metin("BASARISIZ guid_0"); h = h + 1; }
    eğer değil test_guid_1() { yazdir_metin("BASARISIZ guid_1"); h = h + 1; }
    eğer değil test_guid_2() { yazdir_metin("BASARISIZ guid_2"); h = h + 1; }
    eğer değil test_guid_3() { yazdir_metin("BASARISIZ guid_3"); h = h + 1; }
    eğer değil test_guid_4() { yazdir_metin("BASARISIZ guid_4"); h = h + 1; }
    eğer değil test_gecersiz_0() { yazdir_metin("BASARISIZ gecersiz_0"); h = h + 1; }
    eğer değil test_gecersiz_1() { yazdir_metin("BASARISIZ gecersiz_1"); h = h + 1; }
