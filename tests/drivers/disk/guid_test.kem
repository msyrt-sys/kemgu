    eğer değil test_boy_0() { yazdir_metin("BASARISIZ boy_0"); h = h + 1; }
    eğer değil test_boy_15() { yazdir_metin("BASARISIZ boy_15"); h = h + 1; }
    eğer değil test_boy_17() { yazdir_metin("BASARISIZ boy_17"); h = h + 1; }
