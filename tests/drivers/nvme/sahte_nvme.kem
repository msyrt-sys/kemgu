// F003: yapı alanındaki dtam8 okumaları oku_u8 ile açık tipte taşınır.
// Sahte NVMe aygıtı: SQ'yu bağımsız alan ofsetleriyle okur, DMA ve CQ'yu üretir.
// Kaynak/hesap: tools/codex/dalga4_nvme_sahte.py; sürücü komut çözücülerini kullanmaz.
kullan drivers::ortak::gc::{ GcIstek, GcYanit, gc_bos };
kullan drivers::ortak::bayt::{ bayt_sifir, oku_u8, oku_le16, oku_le32, oku_le64, yaz_u8, yaz_le16, yaz_le32, yaz_le64 };
kullan tests::drivers::nvme::kimlik_fikstur::{ denetleyici_ornek, ad_alani_ornek };
genel yapı SahteNvme {
    taban: tam64; bellek: Dizi<dtam8>; disk: Dizi<dtam8>; kapasite: tam64;
    cc: tam64; aqa: tam64; asq: tam64; acq: tam64; isq: tam64; icq: tam64;
    aqboy: tam32; iqboy: tam32; aqbas: tam32; iqbas: tam32; aqson: tam32; iqson: tam32;
    aqfaz: mantıksal; iqfaz: mantıksal; aqbekleyen: tam32; iqbekleyen: tam32;
    ariza: tam32; bekleme: tam32; yonetim: tam32; gc_sayisi: tam32; flush_sayisi: tam32;
}
genel işlev sahte_nvme_yeni() -> SahteNvme {
    değişken bellek: Dizi<dtam8> = bayt_sifir(86016); değişken disk: Dizi<dtam8> = [];
    ver SahteNvme { taban: 65536, bellek: bellek, disk: disk, kapasite: 80000, cc: 1, aqa: 0, asq: 0, acq: 0, isq: 0, icq: 0, aqboy: 0, iqboy: 0, aqbas: 0, iqbas: 0, aqson: 0, iqson: 0, aqfaz: doğru, iqfaz: doğru, aqbekleyen: 0, iqbekleyen: 0, ariza: 0, bekleme: 0, yonetim: 0, gc_sayisi: 0, flush_sayisi: 0 };
}
işlev dma_var(s: &değişken SahteNvme, adres: tam64, boy: tam64) -> mantıksal {
    ver adres >= s.taban ve adres-s.taban <= (dizi_boyut(s.bellek) olarak tam64) ve boy >= 0 ve boy <= (dizi_boyut(s.bellek) olarak tam64)-(adres-s.taban);
}
işlev dma_yaz(s: &değişken SahteNvme, adres: tam64, veri: Dizi<dtam8>) -> mantıksal {
    eğer değil dma_var(s,adres,dizi_boyut(veri) olarak tam64) { ver yanlış; }
    değişken i: tam32 = 0; değişken o: tam32 = (adres-s.taban) olarak tam32;
    iken i < dizi_boyut(veri) { yaz_u8(s.bellek,o+i,oku_u8(veri,i) olarak tam64); i=i+1; } ver doğru;
}
işlev prp_aktar(s: &değişken SahteNvme, p1: tam64, p2: tam64, lba: tam64, sayi: tam32, yaz: mantıksal) -> mantıksal {
    eğer lba < 0 veya lba >= s.kapasite veya (sayi olarak tam64) > s.kapasite-lba veya sayi < 1 veya sayi > 16 veya p1%4 != 0 { ver yanlış; }
    değişken boy: tam32 = sayi*512; değişken disk_ofs: tam32 = (lba*512) olarak tam32;
    eğer yaz {
        eğer disk_ofs > 16777216-boy { ver yanlış; }
        iken dizi_boyut(s.disk) < disk_ofs+boy { dizi_ekle(s.disk,0 olarak dtam8); }
    }
    değişken ilk: tam32 = 4096-((p1%4096) olarak tam32);
    değişken liste: mantıksal = boy > ilk+4096;
    değişken liste_adres: tam64 = p2; değişken liste_i: tam32 = 0;
    değişken adres: tam64 = p1; değişken n: tam32 = 0;
    iken n < boy {
        eğer n > 0 {
            eğer liste {
                eğer değil dma_var(s,liste_adres,4096) veya liste_adres%4096 != 0 { ver yanlış; }
                eğer liste_i == 511 ve boy-n > 4096 { liste_adres=oku_le64(s.bellek,(liste_adres-s.taban) olarak tam32+4088); liste_i=0; eğer değil dma_var(s,liste_adres,4096) { ver yanlış; } }
                adres=oku_le64(s.bellek,(liste_adres-s.taban) olarak tam32+liste_i*8); liste_i=liste_i+1;
            } değilse { adres=p2; }
            eğer adres%4096 != 0 { ver yanlış; }
        }
        değişken al: tam32 = 4096-((adres%4096) olarak tam32); eğer al > boy-n { al=boy-n; }
        eğer değil dma_var(s,adres,al olarak tam64) { ver yanlış; }
        değişken j: tam32 = 0; değişken o: tam32 = (adres-s.taban) olarak tam32;
        iken j < al {
            eğer yaz { yaz_u8(s.disk,disk_ofs+n+j,oku_u8(s.bellek,o+j) olarak tam64); }
            değilse { değişken v: dtam8 = 0 olarak dtam8; eğer disk_ofs+n+j < dizi_boyut(s.disk) { v=dizi_al(s.disk,disk_ofs+n+j); } yaz_u8(s.bellek,o+j,(v olarak tam64)&255); }
            j=j+1;
        }
        n=n+al;
    }
    ver doğru;
}
işlev kuyruk_isle(s: &değişken SahteNvme, io: mantıksal, yeni_son: tam32) -> mantıksal {
    değişken sq: tam64 = s.asq; değişken cq: tam64 = s.acq; değişken boy: tam32 = s.aqboy; değişken bas: tam32 = s.aqbas; değişken son: tam32 = s.aqson; değişken faz: mantıksal = s.aqfaz; değişken qid: tam32 = 0;
    eğer io { sq=s.isq; cq=s.icq; boy=s.iqboy; bas=s.iqbas; son=s.iqson; faz=s.iqfaz; qid=1; }
    eğer boy < 2 veya yeni_son != (bas+1)%boy veya değil dma_var(s,sq+(bas olarak tam64)*64,64) veya değil dma_var(s,cq+(son olarak tam64)*16,16) { ver yanlış; }
    değişken o: tam32 = (sq-s.taban) olarak tam32+bas*64;
    değişken op: tam32 = oku_u8(s.bellek,o); değişken cid: tam32 = oku_le16(s.bellek,o+2);
    değişken p1: tam64 = oku_le64(s.bellek,o+24); değişken p2: tam64 = oku_le64(s.bellek,o+32);
    değişken durum: tam64 = 0;
    eğer io {
        s.gc_sayisi=s.gc_sayisi+1;
        eğer oku_le32(s.bellek,o+4) != 1 { durum=2; }
        değilse eğer op == 0 { s.flush_sayisi=s.flush_sayisi+1; }
        değilse eğer op == 1 veya op == 2 {
            değişken lba: tam64 = oku_le64(s.bellek,o+40); değişken sayi: tam32 = oku_le16(s.bellek,o+48)+1;
            eğer değil prp_aktar(s,p1,p2,lba,sayi,op == 1) { durum=2; }
        } değilse { durum=1; }
    } değilse {
        s.yonetim=s.yonetim+1;
        eğer op == 6 {
            değişken b: Dizi<dtam8> = denetleyici_ornek(); değişken cns: tam64 = oku_le32(s.bellek,o+40);
            eğer cns == 1 { yaz_u8(b,77,1); yaz_le32(b,516,1); }
            değilse eğer cns == 0 ve oku_le32(s.bellek,o+4) == 1 { b=ad_alani_ornek(); yaz_le64(b,0,s.kapasite); yaz_u8(b,26,0); }
            değilse { durum=2; }
            eğer değil dma_yaz(s,p1,b) { durum=2; }
        }
        değilse eğer op == 5 veya op == 1 {
            değişken q: tam32 = oku_le16(s.bellek,o+40); değişken n: tam32 = oku_le16(s.bellek,o+42)+1;
            eğer q != 1 veya n < 2 veya n > 64 veya p1%4096 != 0 veya değil dma_var(s,p1,4096) veya (oku_le32(s.bellek,o+44)&1) == 0 { durum=2; }
            değilse eğer op == 5 { s.icq=p1; s.iqboy=n; }
            değilse { eğer s.icq == 0 veya n != s.iqboy veya oku_le16(s.bellek,o+46) != 1 { durum=2; } değilse { s.isq=p1; } }
        } değilse { durum=1; }
    }
    bas=(bas+1)%boy;
    eğer s.ariza == 3 { durum=1; }
    eğer s.ariza == 4 { faz=değil faz; }
    eğer s.ariza == 5 { cid=(cid+1)&65535; }
    değişken co: tam32 = (cq-s.taban) olarak tam32+son*16;
    değişken dw3: tam64 = (cid olarak tam64)|(durum<<17); eğer faz { dw3=dw3|65536; }
    yaz_le32(s.bellek,co+8,(bas olarak tam64)|((qid olarak tam64)<<16)); yaz_le32(s.bellek,co+12,dw3);
    son=(son+1)%boy;
    eğer io { s.iqbas=bas; s.iqson=son; eğer son == 0 { s.iqfaz=değil s.iqfaz; } s.iqbekleyen=s.iqbekleyen+1; }
    değilse { s.aqbas=bas; s.aqson=son; eğer son == 0 { s.aqfaz=değil s.aqfaz; } s.aqbekleyen=s.aqbekleyen+1; }
    ver doğru;
}
genel işlev sahte_nvme_yanit(s: &değişken SahteNvme, i: GcIstek) -> GcYanit {
    değişken y: GcYanit = gc_bos();
    eşleş i {
        GcIstek::Oku64(a) => { eğer a == 0 { y.deger=137455796231; } değilse { y.basarili=yanlış; } }
        GcIstek::Oku32(a) => {
            eğer a == 20 { y.deger=s.cc; }
            değilse eğer a == 28 { y.deger=s.cc&1; eğer s.ariza == 1 { y.deger=2; } eğer s.ariza == 2 { y.deger=0; } }
            değilse { y.basarili=yanlış; }
        }
        GcIstek::Yaz64(a,v) => { eğer a == 40 { s.asq=v; } değilse eğer a == 48 { s.acq=v; } değilse { y.basarili=yanlış; } }
        GcIstek::Yaz32(a,v) => {
            eğer a == 20 { s.cc=v; }
            değilse eğer a == 36 { s.aqa=v; s.aqboy=((v&65535) olarak tam32)+1; eğer (v>>16) != ((s.aqboy-1) olarak tam64) { y.basarili=yanlış; } }
            değilse eğer a == 4096 { y.basarili=kuyruk_isle(s,yanlış,v olarak tam32); }
            değilse eğer a == 4104 { y.basarili=kuyruk_isle(s,doğru,v olarak tam32); }
            değilse eğer a == 4100 { eğer v != (s.aqson olarak tam64) veya s.aqbekleyen != 1 { y.basarili=yanlış; } s.aqbekleyen=0; }
            değilse eğer a == 4108 { eğer v != (s.iqson olarak tam64) veya s.iqbekleyen != 1 { y.basarili=yanlış; } s.iqbekleyen=0; }
            değilse { y.basarili=yanlış; }
        }
        GcIstek::BellekYaz(a,b) => { y.basarili=dma_yaz(s,a,b); }
        GcIstek::BellekOku(a,n) => {
            eğer değil dma_var(s,a,n olarak tam64) { y.basarili=yanlış; }
            değilse {
                değişken b: Dizi<dtam8> = []; değişken j: tam32 = 0; değişken boy: tam32 = n;
                eğer s.ariza == 6 ve boy > 0 { boy=boy-1; }
                iken j < boy { dizi_ekle(b,oku_u8(s.bellek,(a-s.taban) olarak tam32+j) olarak dtam8); j=j+1; } y.baytlar=b;
            }
        }
        GcIstek::Bekle(us) => { s.bekleme=s.bekleme+1; }
        GcIstek::Bitti => { }
        GcIstek::Hata(m) => { y.basarili=yanlış; }
    }
    ver y;
}
