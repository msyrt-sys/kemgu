// Test yürütücüsü: gerçek OS bu döngüde aynı GcIstek'leri MMIO/DMA ile yanıtlar.
kullan drivers::nvme::cekirdek::{ NvmeDurum, nvme_adim, nvme_oku, nvme_yaz, nvme_flush };
kullan drivers::ortak::gc::{ GcIstek, GcYanit, gc_bos };
kullan tests::drivers::nvme::sahte_nvme::{ SahteNvme, sahte_nvme_yanit };
genel işlev nvme_test_sur(s: &değişken NvmeDurum, a: &değişken SahteNvme) -> sonuç<mantıksal,metin> {
    değişken y: GcYanit = gc_bos(); değişken i: tam32 = 0;
    iken i < 100000 {
        değişken istek: GcIstek = nvme_adim(s,y);
        eşleş istek { GcIstek::Bitti => { ver tamam(doğru); } GcIstek::Hata(m) => { ver hata(m); } _ => { y=sahte_nvme_yanit(a,istek); } } i=i+1;
    }
    ver hata("test adim siniri");
}
genel işlev nvme_test_oku(s: &değişken NvmeDurum, a: &değişken SahteNvme, lba: tam64, sayi: tam32) -> sonuç<Dizi<dtam8>,metin> {
    eşleş nvme_oku(s,lba,sayi) { hata(e) => { ver hata(e); } tamam(v) => { } }
    eşleş nvme_test_sur(s,a) { hata(e) => { ver hata(e); } tamam(v) => { ver tamam(s.sonuc); } }
}
