// Kâhin: python3 tools/codex/dalga4_nvme_sahte.py; aktarım=36*512, MDTS=8192.
kullan drivers::nvme::cekirdek::{ NvmeDurum, nvme_yeni, nvme_adim, nvme_oku, nvme_yaz, nvme_flush };
kullan drivers::ortak::gc::{ GcIstek, GcYanit, gc_bos };
kullan drivers::ortak::bayt::{ bayt_sifir, yaz_u8, oku_u8 };
kullan tests::drivers::nvme::sahte_nvme::{ SahteNvme, sahte_nvme_yeni, sahte_nvme_yanit };
işlev sur(s: &değişken NvmeDurum, a: &değişken SahteNvme) -> mantıksal {
    değişken y: GcYanit = gc_bos(); değişken i: tam32 = 0;
    iken i < 10000 {
        değişken istek: GcIstek = nvme_adim(s,y);
        eşleş istek { GcIstek::Bitti => { ver doğru; } GcIstek::Hata(m) => { ver yanlış; } _ => { y=sahte_nvme_yanit(a,istek); } }
        i=i+1;
    }
    ver yanlış;
}
işlev kabul(r: sonuç<mantıksal,metin>) -> mantıksal { eşleş r { tamam(v) => { ver v; } hata(e) => { ver yanlış; } } }
işlev test_baslat_io() -> mantıksal {
    değişken a: SahteNvme = sahte_nvme_yeni();
    eşleş nvme_yeni(65536,2) {
        hata(e) => { ver yanlış; }
        tamam(durum) => {
            değişken s: NvmeDurum = durum;
            eğer değil sur(&değişken s,&değişken a) veya değil s.hazir veya s.blok_bayt != 512 veya s.azami != 8192 veya a.yonetim != 4 { ver yanlış; }
            değişken veri: Dizi<dtam8> = bayt_sifir(18432); değişken i: tam32 = 0;
            iken i < dizi_boyut(veri) { yaz_u8(veri,i,((i*17+3)&255) olarak tam64); i=i+1; }
            eğer değil kabul(nvme_yaz(&değişken s,2,veri)) veya değil sur(&değişken s,&değişken a) { ver yanlış; }
            eğer değil kabul(nvme_oku(&değişken s,2,36)) veya değil sur(&değişken s,&değişken a) { ver yanlış; }
            eğer dizi_boyut(s.sonuc) != 18432 { ver yanlış; }
            i=0; iken i < 18432 { eğer oku_u8(s.sonuc,i) != ((i*17+3)&255) { ver yanlış; } i=i+1; }
            eğer değil kabul(nvme_flush(&değişken s)) veya değil sur(&değişken s,&değişken a) { ver yanlış; }
            eğer a.gc_sayisi != 7 veya a.flush_sayisi != 1 { ver yanlış; }
            eğer kabul(nvme_oku(&değişken s,0-1,1)) veya kabul(nvme_oku(&değişken s,s.kapasite,1)) veya kabul(nvme_yaz(&değişken s,0,bayt_sifir(513))) { ver yanlış; }
            ver doğru;
        }
    }
}
işlev test_fatal_timeout() -> mantıksal {
    değişken a: SahteNvme = sahte_nvme_yeni(); a.ariza=1;
    eşleş nvme_yeni(65536,2) { hata(e) => { ver yanlış; } tamam(d) => { değişken s: NvmeDurum = d; eğer sur(&değişken s,&değişken a) { ver yanlış; } } }
    a=sahte_nvme_yeni(); a.ariza=2;
    eşleş nvme_yeni(65536,2) { hata(e) => { ver yanlış; } tamam(d) => { değişken s: NvmeDurum = d; eğer sur(&değişken s,&değişken a) veya a.bekleme != 500 { ver yanlış; } } }
    eşleş nvme_yeni(65537,2) { tamam(v) => { ver yanlış; } hata(e) => { } }
    eşleş nvme_yeni(65536,1) { tamam(v) => { ver yanlış; } hata(e) => { ver doğru; } }
}
işlev main() -> tam32 { değişken h: tam32 = 0; eğer değil test_baslat_io() { yazdir_metin("nvme io"); h=h+1; } eğer değil test_fatal_timeout() { yazdir_metin("nvme hata"); h=h+1; } ver h; }
