    eğer değil yok(fare_bayt(&değişken d, 200)) { ver yanlış; }
    eğer değil yok(fare_bayt(&değişken d, 1)) { ver yanlış; }
    eğer değil yok(fare_bayt(&değişken d, 1)) { ver yanlış; }
