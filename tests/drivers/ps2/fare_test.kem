// Sabitler: python3 tools/codex/a2.py; x=b1-256*(b0>>4&1), z=(b3&15)-16*(b3&8!=0).
kullan drivers::ps2::fare::{ FareDurumu, FareOlayi, fare_yeni, fare_bayt };
işlev yok(o: seçimlik<FareOlayi>) -> mantıksal {
    eşleş o { hiç => { ver doğru; } değer(v) => { ver yanlış; } }
}
işlev esit(o: seçimlik<FareOlayi>, x: tam32, y: tam32, z: tam32, tus: tam32) -> mantıksal {
    eşleş o {
        hiç => { ver yanlış; }
        değer(v) => { ver v.dx == x ve v.dy == y ve v.dz == z ve
            v.sol == ((tus & 1) != 0) ve v.sag == ((tus & 2) != 0) ve v.orta == ((tus & 4) != 0); }
    }
}

işlev test_paket_0() -> mantıksal {
    değişken d: FareDurumu = fare_yeni(yanlış);
    eğer değil yok(fare_bayt(&değişken d, 8)) { ver yanlış; }
    eğer değil yok(fare_bayt(&değişken d, 5)) { ver yanlış; }
    ver esit(fare_bayt(&değişken d, 3), 5, 3, 0, 0) ve d.n == 0;
}

işlev test_paket_1() -> mantıksal {
    değişken d: FareDurumu = fare_yeni(yanlış);
    eğer değil yok(fare_bayt(&değişken d, 9)) { ver yanlış; }
    eğer değil yok(fare_bayt(&değişken d, 0)) { ver yanlış; }
    ver esit(fare_bayt(&değişken d, 0), 0, 0, 0, 1) ve d.n == 0;
}

