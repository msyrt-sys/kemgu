işlev test_tasma_3_64() -> mantıksal {
    değişken d: FareDurumu = fare_yeni(yanlış);
    eğer değil yok(fare_bayt(&değişken d, 72)) { ver yanlış; }
    eğer değil yok(fare_bayt(&değişken d, 1)) { ver yanlış; }
    eğer değil yok(fare_bayt(&değişken d, 1)) { ver yanlış; }
    eğer d.n != 0 { ver yanlış; }
    fare_bayt(&değişken d, 8);
    fare_bayt(&değişken d, 5);
    ver esit(fare_bayt(&değişken d, 3), 5, 3, 0, 0);
}

