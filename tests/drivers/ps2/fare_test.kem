işlev test_senkron() -> mantıksal {
    değişken d: FareDurumu = fare_yeni(yanlış);
    eğer değil yok(fare_bayt(&değişken d, 0)) veya d.n != 0 { ver yanlış; }
    fare_bayt(&değişken d, 8); fare_bayt(&değişken d, 1);
    eğer değil esit(fare_bayt(&değişken d, 2), 1, 2, 0, 0) { ver yanlış; }
    fare_bayt(&değişken d, 9); fare_bayt(&değişken d, 0);
    ver esit(fare_bayt(&değişken d, 0), 0, 0, 0, 1);
}

işlev test_bozuk_girdi() -> mantıksal {
    değişken d: FareDurumu = fare_yeni(yanlış);
    fare_bayt(&değişken d, 8);
    eğer değil yok(fare_bayt(&değişken d, -1)) veya d.n != 0 { ver yanlış; }
    eğer değil yok(fare_bayt(&değişken d, 256)) { ver yanlış; }
    d.paket_boyu = 0;
    ver yok(fare_bayt(&değişken d, 8)) ve d.n == 0;
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_paket_0() { yazdir_metin("BASARISIZ paket_0"); h = h + 1; }
    eğer değil test_paket_1() { yazdir_metin("BASARISIZ paket_1"); h = h + 1; }
    eğer değil test_paket_2() { yazdir_metin("BASARISIZ paket_2"); h = h + 1; }
    eğer değil test_paket_3() { yazdir_metin("BASARISIZ paket_3"); h = h + 1; }
    eğer değil test_paket_4() { yazdir_metin("BASARISIZ paket_4"); h = h + 1; }
    eğer değil test_paket_5() { yazdir_metin("BASARISIZ paket_5"); h = h + 1; }
    eğer değil test_paket_6() { yazdir_metin("BASARISIZ paket_6"); h = h + 1; }
    eğer değil test_paket_7() { yazdir_metin("BASARISIZ paket_7"); h = h + 1; }
    eğer değil test_paket_8() { yazdir_metin("BASARISIZ paket_8"); h = h + 1; }
    eğer değil test_paket_9() { yazdir_metin("BASARISIZ paket_9"); h = h + 1; }
    eğer değil test_paket_10() { yazdir_metin("BASARISIZ paket_10"); h = h + 1; }
    eğer değil test_tasma_3_64() { yazdir_metin("BASARISIZ tasma_3_64"); h = h + 1; }
    eğer değil test_tasma_3_128() { yazdir_metin("BASARISIZ tasma_3_128"); h = h + 1; }
    eğer değil test_tasma_3_192() { yazdir_metin("BASARISIZ tasma_3_192"); h = h + 1; }
    eğer değil test_tasma_4_64() { yazdir_metin("BASARISIZ tasma_4_64"); h = h + 1; }
    eğer değil test_tasma_4_128() { yazdir_metin("BASARISIZ tasma_4_128"); h = h + 1; }
    eğer değil test_tasma_4_192() { yazdir_metin("BASARISIZ tasma_4_192"); h = h + 1; }
    eğer değil test_senkron() { yazdir_metin("BASARISIZ senkron"); h = h + 1; }
    eğer değil test_bozuk_girdi() { yazdir_metin("BASARISIZ bozuk_girdi"); h = h + 1; }
    ver h;
}
