// Sabitler: python3 tools/codex/a1.py — ord(karakter), enumerate ve make + 128.
kullan drivers::ps2::klavye_tr::{ KlavyeDurumu, TusOlayi, klavye_yeni, klavye_bayt };
işlev karakter(o: TusOlayi, k: tam32) -> mantıksal {
    eşleş o { TusOlayi::Karakter(v) => { ver v == k; } _ => { ver yanlış; } }
}
işlev yok(o: TusOlayi) -> mantıksal {
    eşleş o { TusOlayi::Yok => { ver doğru; } _ => { ver yanlış; } }
}
işlev ozel(o: TusOlayi, k: tam32, bas: mantıksal) -> mantıksal {
    eşleş o { TusOlayi::Ozel(v, b) => { ver v == k ve b == bas; } _ => { ver yanlış; } }
}

işlev test_tablo_41() -> mantıksal {
    değişken d: KlavyeDurumu = klavye_yeni();
    eğer değil karakter(klavye_bayt(&değişken d, 41), 34) { ver yanlış; }
    eğer değil yok(klavye_bayt(&değişken d, 169)) { ver yanlış; }
    d.caps = yanlış; d.sol_shift = doğru;
    eğer değil karakter(klavye_bayt(&değişken d, 41), 233) { ver yanlış; }
    d.caps = doğru; d.sol_shift = doğru;
    eğer değil karakter(klavye_bayt(&değişken d, 41), 233) { ver yanlış; }
    d.caps = doğru; d.sol_shift = yanlış;
    eğer değil karakter(klavye_bayt(&değişken d, 41), 34) { ver yanlış; }
    d.caps = yanlış; d.sol_shift = yanlış;
    eğer değil karakter(klavye_bayt(&değişken d, 41), 34) { ver yanlış; }
    ver doğru;
}

