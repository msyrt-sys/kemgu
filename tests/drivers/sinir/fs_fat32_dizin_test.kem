// Kahin: python3 tools/codex/f5.py; LFN parça sayısı; geçersiz uzun ad kısa ada düşer; değerler [0, 1, 20, 21].
kullan drivers::ortak::bayt::{ bayt_sifir, oku_u8, oku_le16, oku_le32, yaz_u8, yaz_le16, yaz_le32, yaz_le64, yaz_ascii, bayt_toplam8, bayt_sinirda, imza_esit };
kullan drivers::fs::fat32_dizin::{ DizinGirdisi, dizin_coz };

işlev test_sinir_0() -> mantıksal {
    değişken b: Dizi<dtam8> = bayt_sifir(32);
    yaz_u8(b,0,83 olarak tam64);
    yaz_u8(b,1,72 olarak tam64);
    yaz_u8(b,2,79 olarak tam64);
    yaz_u8(b,3,82 olarak tam64);
    yaz_u8(b,4,84 olarak tam64);
    yaz_u8(b,5,32 olarak tam64);
    yaz_u8(b,6,32 olarak tam64);
    yaz_u8(b,7,32 olarak tam64);
    yaz_u8(b,8,84 olarak tam64);
    yaz_u8(b,9,88 olarak tam64);
    yaz_u8(b,10,84 olarak tam64);
    yaz_u8(b,11,32 olarak tam64);
    eşleş dizin_coz(b) { hata(e) => { ver yanlış; } tamam(v) => { değişken xs: Dizi<DizinGirdisi> = v;
        eğer dizi_boyut(xs)!=1 { ver yanlış; } değişken g: DizinGirdisi = dizi_al(xs,0); ver metin_esit(g.ad,"SHORT.TXT");
    } }
}

