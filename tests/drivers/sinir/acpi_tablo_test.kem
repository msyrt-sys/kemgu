// Kahin: python3 tools/codex/f5.py; 52 baytlık XSDT içindeki kullanılabilir yük uzunluğu; değerler [0, 1, 16, 17].
kullan drivers::ortak::bayt::{ bayt_sifir, oku_u8, oku_le16, oku_le32, yaz_u8, yaz_le16, yaz_le32, yaz_le64, yaz_ascii, bayt_toplam8, bayt_sinirda, imza_esit };
kullan tests::drivers::bulanik::veri::fikstur::{ bpb_verisi, pci_verisi, elf_verisi, madt_verisi, fadt_verisi, sdt_verisi };
kullan drivers::acpi::tablo::{ SdtBaslik, AcpiHatasi };
kullan drivers::acpi::tablo::{ sdt_girdileri };

işlev test_sinir_0() -> mantıksal {
    değişken b: Dizi<dtam8> = sdt_verisi(doğru); yaz_le32(b,4,36 olarak tam64); yaz_u8(b,9,0 olarak tam64);
    yaz_u8(b,9, ((256-bayt_toplam8(b,0,36)) & 255) olarak tam64);
    eşleş sdt_girdileri(b, doğru) { hata(e) => { ver yanlış; } tamam(v) => { değişken xs: Dizi<tam64> = v; ver dizi_boyut(xs) == 0; } }
}

işlev test_sinir_1() -> mantıksal {
    değişken b: Dizi<dtam8> = sdt_verisi(doğru); yaz_le32(b,4,37 olarak tam64); yaz_u8(b,9,0 olarak tam64);
    yaz_u8(b,9, ((256-bayt_toplam8(b,0,37)) & 255) olarak tam64);
    eşleş sdt_girdileri(b, doğru) { hata(e) => { ver doğru; } tamam(v) => { değişken xs: Dizi<tam64> = v; ver yanlış; } }
}

işlev test_sinir_2() -> mantıksal {
    değişken b: Dizi<dtam8> = sdt_verisi(doğru); yaz_le32(b,4,52 olarak tam64); yaz_u8(b,9,0 olarak tam64);
    yaz_u8(b,9, ((256-bayt_toplam8(b,0,52)) & 255) olarak tam64);
    eşleş sdt_girdileri(b, doğru) { hata(e) => { ver yanlış; } tamam(v) => { değişken xs: Dizi<tam64> = v; ver dizi_boyut(xs) == 2; } }
}

işlev test_sinir_3() -> mantıksal {
    değişken b: Dizi<dtam8> = sdt_verisi(doğru); yaz_le32(b,4,53 olarak tam64); yaz_u8(b,9,0 olarak tam64);
    yaz_u8(b,9, ((256-bayt_toplam8(b,0,52)) & 255) olarak tam64);
    eşleş sdt_girdileri(b, doğru) { hata(e) => { ver doğru; } tamam(v) => { değişken xs: Dizi<tam64> = v; ver yanlış; } }
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_sinir_0() { yazdir_metin("BASARISIZ sinir_0"); h = h + 1; }
    eğer değil test_sinir_1() { yazdir_metin("BASARISIZ sinir_1"); h = h + 1; }
    eğer değil test_sinir_2() { yazdir_metin("BASARISIZ sinir_2"); h = h + 1; }
    eğer değil test_sinir_3() { yazdir_metin("BASARISIZ sinir_3"); h = h + 1; }
    ver h;
}
