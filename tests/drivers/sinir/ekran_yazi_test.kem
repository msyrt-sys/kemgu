// Kahin: python3 tools/codex/f5.py; dört glifli fontun glif indeksi; değerler [0, 1, 3, 4].
kullan drivers::ekran::cerceve::{ Cerceve, cerceve_yeni, piksel_yaz, piksel_oku };
kullan drivers::ekran::cerceve::{ dikdortgen_doldur };
kullan drivers::ekran::psf::{ PsfFont, psf_coz };
kullan drivers::ekran::yazi::{ glif_ciz };
kullan tests::drivers::ekran::veri::psf_sentetik::{ sentetik_font };

işlev test_sinir_0() -> mantıksal {
    eşleş psf_coz(sentetik_font()) { hata(e) => { ver yanlış; } tamam(fv) => { değişken f: PsfFont = fv;
    eşleş cerceve_yeni(9,2,36) { hata(e) => { ver yanlış; } tamam(cv) => { değişken c: Cerceve = cv;
        dikdortgen_doldur(c,0,0,9,2,5); glif_ciz(c,f,0,0,0,7,0);
        eşleş piksel_oku(c,0,0) { hiç => { ver yanlış; } değer(v) => { eğer v != 7 { ver yanlış; } } }
        eşleş piksel_oku(c,1,0) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,2,0) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,3,0) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,4,0) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,5,0) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,6,0) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,7,0) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,8,0) { hiç => { ver yanlış; } değer(v) => { eğer v != 7 { ver yanlış; } } }
        eşleş piksel_oku(c,0,1) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,1,1) { hiç => { ver yanlış; } değer(v) => { eğer v != 7 { ver yanlış; } } }
        eşleş piksel_oku(c,2,1) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,3,1) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,4,1) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,5,1) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,6,1) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,7,1) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        eşleş piksel_oku(c,8,1) { hiç => { ver yanlış; } değer(v) => { eğer v != 0 { ver yanlış; } } }
        ver doğru;
    } } } }
}

