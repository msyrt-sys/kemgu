// Kahin: python3 tools/codex/f5.py; 3 baytlık tamponun erişim uzunluğu; değerler [0, 1, 3, 4].
kullan drivers::ortak::bayt::{ bayt_sifir, oku_u8, oku_le16, oku_le32, yaz_u8, yaz_le16, yaz_le32, yaz_le64, yaz_ascii, bayt_toplam8, bayt_sinirda, imza_esit };

işlev test_sinir_0() -> mantıksal {
    değişken b: Dizi<dtam8> = bayt_sifir(3); ver bayt_sinirda(b, 0, 0) == doğru;
}

işlev test_sinir_1() -> mantıksal {
    değişken b: Dizi<dtam8> = bayt_sifir(3); ver bayt_sinirda(b, 0, 1) == doğru;
}

işlev test_sinir_2() -> mantıksal {
    değişken b: Dizi<dtam8> = bayt_sifir(3); ver bayt_sinirda(b, 0, 3) == doğru;
}

işlev test_sinir_3() -> mantıksal {
    değişken b: Dizi<dtam8> = bayt_sifir(3); ver bayt_sinirda(b, 0, 4) == yanlış;
}

işlev test_toplama_tasmasi() -> mantıksal {
    değişken b: Dizi<dtam8> = bayt_sifir(3); ver değil bayt_sinirda(b, 2147483647, 2147483647);
}

işlev test_imza_tasmasi() -> mantıksal {
    değişken b: Dizi<dtam8> = bayt_sifir(3); ver değil imza_esit(b, 2147483647, "x");
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_sinir_0() { yazdir_metin("BASARISIZ sinir_0"); h = h + 1; }
    eğer değil test_sinir_1() { yazdir_metin("BASARISIZ sinir_1"); h = h + 1; }
    eğer değil test_sinir_2() { yazdir_metin("BASARISIZ sinir_2"); h = h + 1; }
    eğer değil test_sinir_3() { yazdir_metin("BASARISIZ sinir_3"); h = h + 1; }
    eğer değil test_toplama_tasmasi() { yazdir_metin("BASARISIZ toplama_tasmasi"); h = h + 1; }
    eğer değil test_imza_tasmasi() { yazdir_metin("BASARISIZ imza_tasmasi"); h = h + 1; }
    ver h;
}
