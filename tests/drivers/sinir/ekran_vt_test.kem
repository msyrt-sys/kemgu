// Kahin: python3 tools/codex/f5.py; CSI parametre sayısı; değerler [0, 1, 16, 17].
kullan drivers::ekran::konsol::{ Konsol, konsol_yeni };
kullan drivers::ekran::vt::{ VtDurumu, vt_yeni, vt_metin };

işlev test_sinir_0() -> mantıksal {
    eşleş konsol_yeni(4,2,7,0) { hata(e) => { ver yanlış; } tamam(v) => { değişken k: Konsol = v; değişken d: VtDurumu = vt_yeni(7,0);
        vt_metin(&değişken d, &değişken k, metin_birlestir(kod_metin(27), "[mX"));
        ver dizi_al(k.renkler,0) == 7 ve dizi_al(k.kodlar,0) == 88 ve k.x == 1;
    } }
}

işlev test_sinir_1() -> mantıksal {
    eşleş konsol_yeni(4,2,7,0) { hata(e) => { ver yanlış; } tamam(v) => { değişken k: Konsol = v; değişken d: VtDurumu = vt_yeni(7,0);
        vt_metin(&değişken d, &değişken k, metin_birlestir(kod_metin(27), "[31mX"));
        ver dizi_al(k.renkler,0) == 11141120 ve dizi_al(k.kodlar,0) == 88 ve k.x == 1;
    } }
}

işlev test_sinir_2() -> mantıksal {
    eşleş konsol_yeni(4,2,7,0) { hata(e) => { ver yanlış; } tamam(v) => { değişken k: Konsol = v; değişken d: VtDurumu = vt_yeni(7,0);
        vt_metin(&değişken d, &değişken k, metin_birlestir(kod_metin(27), "[31;31;31;31;31;31;31;31;31;31;31;31;31;31;31;31mX"));
        ver dizi_al(k.renkler,0) == 11141120 ve dizi_al(k.kodlar,0) == 88 ve k.x == 1;
    } }
}

işlev test_sinir_3() -> mantıksal {
    eşleş konsol_yeni(4,2,7,0) { hata(e) => { ver yanlış; } tamam(v) => { değişken k: Konsol = v; değişken d: VtDurumu = vt_yeni(7,0);
        vt_metin(&değişken d, &değişken k, metin_birlestir(kod_metin(27), "[31;31;31;31;31;31;31;31;31;31;31;31;31;31;31;31;31mX"));
        ver dizi_al(k.renkler,0) == 7 ve dizi_al(k.kodlar,0) == 88 ve k.x == 1;
    } }
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_sinir_0() { yazdir_metin("BASARISIZ sinir_0"); h = h + 1; }
    eğer değil test_sinir_1() { yazdir_metin("BASARISIZ sinir_1"); h = h + 1; }
    eğer değil test_sinir_2() { yazdir_metin("BASARISIZ sinir_2"); h = h + 1; }
    eğer değil test_sinir_3() { yazdir_metin("BASARISIZ sinir_3"); h = h + 1; }
    ver h;
}
