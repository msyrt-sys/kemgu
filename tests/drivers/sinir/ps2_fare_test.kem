// Kahin: python3 tools/codex/f5.py; fare X paket baytı; değerler [0, 1, 255, 256].
kullan drivers::ps2::fare::{ FareDurumu, FareOlayi, fare_yeni, fare_bayt };

işlev test_sinir_0() -> mantıksal {
    değişken d: FareDurumu = fare_yeni(yanlış); fare_bayt(&değişken d, 8); fare_bayt(&değişken d, 0);
    eşleş fare_bayt(&değişken d, 0) { hiç => { ver yanlış; } değer(v) => { ver v.dx == 0 ve v.dy == 0; } }
}

işlev test_sinir_1() -> mantıksal {
    değişken d: FareDurumu = fare_yeni(yanlış); fare_bayt(&değişken d, 8); fare_bayt(&değişken d, 1);
    eşleş fare_bayt(&değişken d, 0) { hiç => { ver yanlış; } değer(v) => { ver v.dx == 1 ve v.dy == 0; } }
}

işlev test_sinir_2() -> mantıksal {
    değişken d: FareDurumu = fare_yeni(yanlış); fare_bayt(&değişken d, 8); fare_bayt(&değişken d, 255);
    eşleş fare_bayt(&değişken d, 0) { hiç => { ver yanlış; } değer(v) => { ver v.dx == 255 ve v.dy == 0; } }
}

işlev test_sinir_3() -> mantıksal {
    değişken d: FareDurumu = fare_yeni(yanlış); fare_bayt(&değişken d, 8); fare_bayt(&değişken d, 256);
    eşleş fare_bayt(&değişken d, 0) { hiç => { ver doğru; } değer(v) => { ver yanlış; } }
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_sinir_0() { yazdir_metin("BASARISIZ sinir_0"); h = h + 1; }
    eğer değil test_sinir_1() { yazdir_metin("BASARISIZ sinir_1"); h = h + 1; }
    eğer değil test_sinir_2() { yazdir_metin("BASARISIZ sinir_2"); h = h + 1; }
    eğer değil test_sinir_3() { yazdir_metin("BASARISIZ sinir_3"); h = h + 1; }
    ver h;
}
