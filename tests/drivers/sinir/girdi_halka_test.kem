// Kahin: python3 tools/codex/f5.py; FIFO eleman kapasitesi; değerler [0, 1, 1048576, 1048577].
kullan drivers::girdi::halka::{ Halka, halka_yeni, it, sayi };

işlev test_sinir_0() -> mantıksal {
    eşleş halka_yeni(0) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken d: Halka = v; değişken kabul: mantıksal = it(&değişken d, 7 olarak tam64);
        ver dizi_boyut(d.veri) == 0 ve kabul == yanlış ve sayi(d) == 0;
    } }
}

işlev test_sinir_1() -> mantıksal {
    eşleş halka_yeni(1) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken d: Halka = v; değişken kabul: mantıksal = it(&değişken d, 7 olarak tam64);
        ver dizi_boyut(d.veri) == 1 ve kabul == doğru ve sayi(d) == 1;
    } }
}

işlev test_sinir_2() -> mantıksal {
    eşleş halka_yeni(1048576) { hata(e) => { ver yanlış; } tamam(v) => {
        değişken d: Halka = v; değişken kabul: mantıksal = it(&değişken d, 7 olarak tam64);
        ver dizi_boyut(d.veri) == 1048576 ve kabul == doğru ve sayi(d) == 1;
    } }
}

işlev test_sinir_3() -> mantıksal {
    eşleş halka_yeni(1048577) { hata(e) => { ver doğru; } tamam(v) => {
        değişken d: Halka = v; değişken kabul: mantıksal = it(&değişken d, 7 olarak tam64);
        ver yanlış;
    } }
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_sinir_0() { yazdir_metin("BASARISIZ sinir_0"); h = h + 1; }
    eğer değil test_sinir_1() { yazdir_metin("BASARISIZ sinir_1"); h = h + 1; }
    eğer değil test_sinir_2() { yazdir_metin("BASARISIZ sinir_2"); h = h + 1; }
    eğer değil test_sinir_3() { yazdir_metin("BASARISIZ sinir_3"); h = h + 1; }
    ver h;
}
