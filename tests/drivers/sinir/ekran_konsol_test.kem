// Kahin: python3 tools/codex/f5.py; konsol sütun sayısı; değerler [0, 1, 4096, 4097].
kullan drivers::ekran::konsol::{ Konsol, konsol_yeni };

işlev test_sinir_0() -> mantıksal {
    eşleş konsol_yeni(0, 1, 7, 0) { hata(e) => { ver doğru; } tamam(v) => { değişken k: Konsol = v; ver yanlış; } }
}

işlev test_sinir_1() -> mantıksal {
    eşleş konsol_yeni(1, 1, 7, 0) { hata(e) => { ver yanlış; } tamam(v) => { değişken k: Konsol = v; ver k.sutunlar == 1 ve dizi_boyut(k.kodlar) == 1; } }
}

işlev test_sinir_2() -> mantıksal {
    eşleş konsol_yeni(4096, 1, 7, 0) { hata(e) => { ver yanlış; } tamam(v) => { değişken k: Konsol = v; ver k.sutunlar == 4096 ve dizi_boyut(k.kodlar) == 4096; } }
}

işlev test_sinir_3() -> mantıksal {
    eşleş konsol_yeni(4097, 1, 7, 0) { hata(e) => { ver doğru; } tamam(v) => { değişken k: Konsol = v; ver yanlış; } }
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_sinir_0() { yazdir_metin("BASARISIZ sinir_0"); h = h + 1; }
    eğer değil test_sinir_1() { yazdir_metin("BASARISIZ sinir_1"); h = h + 1; }
    eğer değil test_sinir_2() { yazdir_metin("BASARISIZ sinir_2"); h = h + 1; }
    eğer değil test_sinir_3() { yazdir_metin("BASARISIZ sinir_3"); h = h + 1; }
    ver h;
}
