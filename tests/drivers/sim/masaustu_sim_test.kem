işlev test_echo() -> mantıksal {
    değişken b: Dizi<dtam8> = []; ver metin_esit(kabuk_calistir(b, "  echo  ğ😀"), bitir("ğ😀"));
}

işlev test_bilinmeyen() -> mantıksal {
    değişken b: Dizi<dtam8> = []; ver metin_esit(kabuk_calistir(b, "sil /x"), bitir("bilinmeyen komut: sil"));
}

işlev test_cat_arg() -> mantıksal {
    değişken b: Dizi<dtam8> = []; ver metin_esit(kabuk_calistir(b, "cat"), bitir("kullanim: cat /yol"));
}

işlev test_bos() -> mantıksal {
    değişken b: Dizi<dtam8> = []; ver metin_esit(kabuk_calistir(b, "   "), "");
}

işlev test_eksik() -> mantıksal {
    değişken b: Dizi<dtam8> = imaj_yeni(); ver metin_esit(kabuk_calistir(b, "cat /yok"), bitir("hata: yok"));
}

işlev test_kok_liste() -> mantıksal {
    değişken b: Dizi<dtam8> = imaj_yeni(); ver metin_esit(kabuk_calistir(b, "ls"), "");
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_masaustu() { yazdir_metin("BASARISIZ masaustu"); h = h + 1; }
    eğer değil test_echo() { yazdir_metin("BASARISIZ echo"); h = h + 1; }
    eğer değil test_bilinmeyen() { yazdir_metin("BASARISIZ bilinmeyen"); h = h + 1; }
    eğer değil test_cat_arg() { yazdir_metin("BASARISIZ cat_arg"); h = h + 1; }
    eğer değil test_bos() { yazdir_metin("BASARISIZ bos"); h = h + 1; }
    eğer değil test_eksik() { yazdir_metin("BASARISIZ eksik"); h = h + 1; }
    eğer değil test_kok_liste() { yazdir_metin("BASARISIZ kok_liste"); h = h + 1; }
    ver h;
}
