    eşleş piksel_oku(c, 6, 0) { hiç => { ver yanlış; } değer(v) => { eğer v != 1056816 { ver yanlış; } } }
    eşleş piksel_oku(c, 7, 0) { hiç => { ver yanlış; } değer(v) => { eğer v != 1056816 { ver yanlış; } } }
    eşleş piksel_oku(c, 0, 1) { hiç => { ver yanlış; } değer(v) => { eğer v != 1056816 { ver yanlış; } } }
    eşleş piksel_oku(c, 1, 1) { hiç => { ver yanlış; } değer(v) => { eğer v != 1056816 { ver yanlış; } } }
    eşleş piksel_oku(c, 2, 1) { hiç => { ver yanlış; } değer(v) => { eğer v != 1056816 { ver yanlış; } } }
    eşleş piksel_oku(c, 3, 1) { hiç => { ver yanlış; } değer(v) => { eğer v != 1056816 { ver yanlış; } } }
    eşleş piksel_oku(c, 4, 1) { hiç => { ver yanlış; } değer(v) => { eğer v != 1056816 { ver yanlış; } } }
    eşleş piksel_oku(c, 5, 1) { hiç => { ver yanlış; } değer(v) => { eğer v != 1056816 { ver yanlış; } } }
