// D-341: KAPANIŞ DİZİ ELEMANINDA — `xs[i]()`. Fat value 16 bayt → BY-VALUE
// (kdl_dizi_*_yapi, memcpy) saklanır; skaler sanılsaydı 16 baytlık agregat
// `kdl_dizi_ekle_tam(i32)` imzasına geçirilirdi (LLVM bunu SESSİZCE kabul eder
// → bozuk dizi). Kapsam: tek eleman, çok eleman + yakalama + argüman. Exit: 42
işlev main() -> tam32 {
    değişken tek: Dizi<işlev() -> tam32> = [|| 12];
    değişken k: tam32 = 5;
    değişken xs: Dizi<işlev(tam32) -> tam32> = [|v: tam32| v + 1, |v: tam32| v + k];
    ver tek[0]() + xs[0](4) + xs[1](20);
}
