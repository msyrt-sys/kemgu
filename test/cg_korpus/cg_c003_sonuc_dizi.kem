// C003: sonuç içindeki yapı dizisinin eleman bilgisi desen bağına taşınmalı.
yapı Nokta { x: tam32; y: tam64; }
işlev uret(ok: mantıksal) -> sonuç<Dizi<Nokta>, metin> {
    eğer ok == yanlış { ver hata("hata"); }
    değişken d: Dizi<Nokta> = [];
    dizi_ekle(d, Nokta { x: 12, y: 8589934595 });
    dizi_ekle(d, Nokta { x: 25, y: 17179869189 });
    dizi_ekle(d, Nokta { x: 37, y: 34359738375 });
    ver tamam(d);
}
işlev kontrol(r: sonuç<Dizi<Nokta>, metin>) -> tam32 {
    eşleş r {
        hata(e) => { eğer metin_uzunluk(e) == 4 { ver 17; } ver 1; }
        tamam(xs) => {
            değişken a: Nokta = dizi_al(xs, 0);
            değişken b: Nokta = dizi_al(xs, 1);
            değişken c: Nokta = dizi_al(xs, 2);
            eğer a.x != 12 veya a.y != 8589934595 { ver 2; }
            eğer b.x != 25 veya b.y != 17179869189 { ver 3; }
            eğer c.x != 37 veya c.y != 34359738375 { ver 4; }
            ver 42;
        }
    }
}
işlev main() -> tam32 {
    // Parametre, açık tipli yerel ve doğrudan çağrı yolları birlikte ölçülür.
    değişken r: sonuç<Dizi<Nokta>, metin> = uret(doğru);
    eğer kontrol(r) != 42 { ver 1; }
    // Pozitif: ilk olmayan hata varyantının metin yükü de korunmalı.
    eğer kontrol(uret(yanlış)) != 17 { ver 2; }
    eşleş uret(doğru) {
        hata(e) => { ver 3; }
        tamam(xs) => {
            değişken n: Nokta = dizi_al(xs, 2);
            eğer n.x != 37 veya n.y != 34359738375 { ver 4; }
        }
    }
    eşleş r {
        hata(e) => { ver 5; }
        tamam(xs) => {
            değişken n: Nokta = dizi_al(xs, 1);
            eğer n.x != 25 veya n.y != 17179869189 { ver 6; }
        }
    }
    ver 42;
}
