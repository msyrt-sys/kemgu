// [D-451] `Dizi<kesirli64>` / `Dizi<kesirli32>` — okuma VE yazma.
//
// Runtime dizi API'si tamsayı/işaretçi taşır. Eleman BAYT GENİŞLİĞİ zaten
// doğruydu (`kdl_dizi_olustur` eleman_byte) — yanlış olan ERİŞİMCİ SONEĞİYDİ:
// `double` değer `_tam` (i32) imzasına geçiriliyordu. Çözüm runtime
// DEĞİŞİKLİĞİ İSTEMEZ: `_tam64` 8 baytı int64 taşır, BİTLER korunur; derleyici
// yazarken `bitcast double->i64`, okurken tersini yapar.
//
// DÖRT AYRI KOD NOKTASI sınanır — her biri ayrı emisyon yeri, biri onarılınca
// diğerleri kendiliğinden düzelmiyor (ölçüldü):
//   (a) `dizi_al` yerleşiği     (b) `xs[i]` indeksleme
//   (c) `için x: xs` döngüsü    (d) annotasyonlu literal dizi `[1.5, 2.5]`
// Ayrıca `dizi_yaz` (yerinde güncelleme) ve `kesirli32` (taşıyıcı i32) ve
// TAMSAYI kontrolü (regresyon koruması) ölçülür.
// Exit: 42

işlev topla_indeks(xs: Dizi<kesirli64>) -> kesirli64 { ver xs[0] + xs[1]; }

işlev topla_dongu(xs: Dizi<kesirli64>) -> kesirli64 {
    değişken t: kesirli64 = 0.0;
    için x: xs { t = t + x; }
    ver t;
}

işlev main() -> tam32 {
    değişken t: tam32 = 0;

    // (a) dizi_al yerleşiği
    değişken a: Dizi<kesirli64> = [];
    dizi_ekle(a, 4.0); dizi_ekle(a, 6.0);
    t = t + ((dizi_al(a, 0) + dizi_al(a, 1)) olarak tam32);        // 10

    // (b) indeksleme + (c) döngü — aynı diziden
    t = t + (topla_indeks(a) olarak tam32);                        // 20
    t = t + (topla_dongu(a) olarak tam32);                         // 30

    // (d) annotasyonlu LİTERAL dizi (kendi emisyon noktası)
    değişken b: Dizi<kesirli64> = [2.5, 3.5];
    t = t + ((b[0] + b[1]) olarak tam32);                          // 36

    // dizi_yaz — yerinde güncelleme
    dizi_yaz(a, 0, 1.0); dizi_yaz(a, 1, 2.0);
    t = t + ((dizi_al(a, 0) + dizi_al(a, 1)) olarak tam32);        // 39

    // kesirli32 — TAŞIYICI i32 (double DEĞİL). Göze 4 bayt; 8 bayt yazmak
    // heap taşması olurdu, o yüzden eleman tipi DİZİDEN alınmalı.
    değişken c: Dizi<kesirli32> = [];
    dizi_ekle(c, 1.0); dizi_ekle(c, 1.0);
    t = t + ((dizi_al(c, 0) + dizi_al(c, 1)) olarak tam32);        // 41

    // TAMSAYI kontrolü — kesirli yol tamsayıyı BOZMAMALI. Ayrıca literal
    // genişliği diziden gelmeli (`tam64` gözeye i32 yazıp i64 okumak
    // yazma/okuma ayrışmasıydı; self-host'ta ölçüldü).
    değişken d: Dizi<tam64> = [];
    dizi_ekle(d, 1); dizi_ekle(d, 0);
    t = t + ((dizi_al(d, 0) + dizi_al(d, 1)) olarak tam32);        // 42

    ver t;
}
