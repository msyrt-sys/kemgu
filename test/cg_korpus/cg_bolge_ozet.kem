// [D-488] Cagrilan-ozeti: `f(xs)` cagrisinda f xs'i SAKLAMIYORSA hapsedilme
// kaniti korunur -> dizi ρ_yerel'de tahsis edilir (islev sonunda serbest).
// Saklıyorsa (parametreyi dondurur) ρ_caller'da KALIR.
//
// ⚠ BU DOSYA DAVRANISSAL OLARAK AYRIM YAPMAZ: iki yol da 42 doner. Yapisal
// ayrimi `calistir_bolge_yonlendirme` kapisi olcer (D-417'nin dersi).

// (a) SAKLAMAZ — yalnız okur
işlev topla(xs: Dizi<tam32>) -> tam32 {
    ver dizi_al(xs, 0) + dizi_al(xs, 1);
}

// (b) SAKLAR — parametreyi geri dondurur
işlev aynen(ys: Dizi<tam32>) -> Dizi<tam32> {
    ver ys;
}


// (c) SAKLAR — parametreyi YAPI ALANINA yazar. `stdlib/regex.kem`'in gercek
// deseni (`Regex.op: Dizi<tam32>`). Bu dizinin ρ_caller'da KALMASI DOGRUDUR;
// serbest edilseydi yapi olu belleğe isaret ederdi = UAF.
yapı Kap { ic: Dizi<tam32>; }

işlev sakla(zs: Dizi<tam32>) -> Kap {
    ver Kap { ic: zs };
}

işlev main() -> tam32 {
    değişken a: Dizi<tam32> = [20, 22];
    değişken t: tam32 = topla(a);

    değişken b: Dizi<tam32> = [1, 2];
    değişken c: Dizi<tam32> = aynen(b);

    değişken d: Dizi<tam32> = [7, 8];
    değişken k: Kap = sakla(d);

    ver t + dizi_al(c, 0) + dizi_al(k.ic, 0) - 8;
}
