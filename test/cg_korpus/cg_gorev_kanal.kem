// D-30x: görev_başlat + kanal (capture k) — çapraz-thread; sonuç açılır. Exit: 15
işlev uretici(k: kanal<tam32>) -> tam32 {
    değişken i: tam32 = 1;
    iken i <= 5 { kanal_gönder(k, i); i = i + 1; }
    ver 0;
}
işlev main() -> tam32 {
    değişken k: kanal<tam32> = kanal_oluştur(2);
    eşleş görev_başlat(|| uretici(k)) {
        tamam(g) => {
            değişken t: tam32 = 0;
            değişken n: tam32 = 0;
            iken n < 5 { t = t + kanal_al(k); n = n + 1; }
            görev_birleştir(g);
            ver t;
        }
        hata(e) => { ver 1; }
    }
    ver 99;
}
