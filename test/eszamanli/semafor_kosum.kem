// [D-645] SEMAFOR KOŞUM KANITI — sayılı izin (n=1) karşılıklı dışlama GERÇEKTEN çalışıyor mu?
//
// `stdlib/semafor.kem` bugüne dek YALNIZ tip-denetleniyordu (`stdlib_check`) ve
// depoda onu kullanan TEK dosya yoktu (ölçüldü). Tip denetimi çalışmayı
// KANITLAMAZ (D-425) — bu dosya onu koşturur.
//
// ŞEKİL: 3 koşucu (2 görev + ana) × 500 artırma = 1500. Kilit olmadan
// oku-değiştir-yaz yarışı artırmaları KAYBETTİRİR, yani sabotaj bu sayıyı
// düşürür. Sayı eşitliği tek başına kanıt değil; sabotajın kırmızı vermesi kanıt.
//
// ⚠ `görev<T>` LİNEERDİR: `hata` kolunda da tüketilmeli, yoksa L005.
// Bu dosya `stdlib/semafor.kem` ile BİRLEŞTİRİLEREK derlenir (stdlib_check idiomu).
küresel değişken sayac: tam64 = 0;

işlev artir(s: Semafor) -> tam32 {
    değişken i: tam32 = 0;
    iken i < 500 {
        semaforda(s, || { güvensiz { sayac = sayac + 1; } ver 0; });
        i = i + 1;
    }
    ver 0;
}

işlev main() -> tam32 {
    değişken s: Semafor = olustur(1);   // n=1 -> kilit gibi
    eşleş görev_başlat(|| artir(s)) {
        tamam(g1) => {
            eşleş görev_başlat(|| artir(s)) {
                tamam(g2) => {
                    artir(s);
                    görev_birleştir(g1);
                    görev_birleştir(g2);
                }
                hata(e2) => { görev_birleştir(g1); ver 1; }
            }
        }
        hata(e1) => { ver 1; }
    }
    yok_et(s);
    değişken t: tam64 = 0;
    güvensiz { t = sayac; }
    eğer t != 1500 { ver 1; }
    ver 42;
}
