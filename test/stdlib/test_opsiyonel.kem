// KEMGU Stdlib Testi — Opsiyonel
// =================================
//
// Bu dosya `stdlib/opsiyonel.kem` ile birleştirilerek --check edilir.

// --- var_mi / yok_mu / bos_mu ---
işlev test_var_deger() -> mantıksal {
    değişken o: seçimlik<tam32> = değer(42);
    ver var_mi(o);
}

işlev test_var_hic() -> mantıksal {
    değişken o: seçimlik<tam32> = hiç;
    ver var_mi(o);
}

işlev test_yok_deger() -> mantıksal {
    değişken o: seçimlik<tam32> = değer(42);
    ver yok_mu(o);
}

işlev test_yok_hic() -> mantıksal {
    değişken o: seçimlik<tam32> = hiç;
    ver yok_mu(o);
}

işlev test_bos_hic() -> mantıksal {
    değişken o: seçimlik<metin> = hiç;
    ver bos_mu(o);
}

// --- ya_da_varsayilan ---
işlev test_ya_da_var() -> tam32 {
    değişken o: seçimlik<tam32> = değer(7);
    ver ya_da_varsayilan(o, 0);
}

işlev test_ya_da_yok() -> tam32 {
    değişken o: seçimlik<tam32> = hiç;
    ver ya_da_varsayilan(o, 99);
}

işlev test_ya_da_metin() -> metin {
    değişken o: seçimlik<metin> = hiç;
    ver ya_da_varsayilan(o, "varsayilan");
}

// --- ilk_var / her_iki_var ---
işlev test_ilk_var_a() -> tam32 {
    değişken a: seçimlik<tam32> = değer(10);
    değişken b: seçimlik<tam32> = değer(20);
    değişken s: seçimlik<tam32> = ilk_var(a, b);
    ver ya_da_varsayilan(s, 0);
}

işlev test_ilk_var_b() -> tam32 {
    değişken a: seçimlik<tam32> = hiç;
    değişken b: seçimlik<tam32> = değer(20);
    değişken s: seçimlik<tam32> = ilk_var(a, b);
    ver ya_da_varsayilan(s, 0);
}

işlev test_her_iki_var() -> mantıksal {
    değişken a: seçimlik<tam32> = değer(1);
    değişken b: seçimlik<tam32> = değer(2);
    değişken c: seçimlik<tam32> = her_iki_var(a, b);
    ver var_mi(c);
}

// --- esit_mi ---
işlev test_esit_iki_deger() -> mantıksal {
    değişken a: seçimlik<tam32> = değer(5);
    değişken b: seçimlik<tam32> = değer(5);
    ver esit_mi(a, b);
}

işlev test_esit_iki_hic() -> mantıksal {
    değişken a: seçimlik<tam32> = hiç;
    değişken b: seçimlik<tam32> = hiç;
    ver esit_mi(a, b);
}

işlev test_esit_farkli() -> mantıksal {
    değişken a: seçimlik<tam32> = değer(5);
    değişken b: seçimlik<tam32> = hiç;
    ver esit_mi(a, b);
}

// --- sarmala / bos_olustur ---
işlev test_sarmala() -> mantıksal {
    değişken o: seçimlik<tam32> = sarmala(42);
    ver var_mi(o);
}

// --- harita_tam ---
işlev iki_kat_lokal(x: tam32) -> tam32 { ver x * 2; }

işlev test_harita_deger() -> tam32 {
    değişken o: seçimlik<tam32> = değer(21);
    değişken r: seçimlik<tam32> = harita_tam(o, iki_kat_lokal);
    ver ya_da_varsayilan(r, 0);
}

işlev test_harita_hic() -> tam32 {
    değişken o: seçimlik<tam32> = hiç;
    değişken r: seçimlik<tam32> = harita_tam(o, iki_kat_lokal);
    ver ya_da_varsayilan(r, 999);
}

// --- filtre_tam ---
işlev pozitif_filtre(x: tam32) -> mantıksal { ver x > 0; }

işlev test_filtre_gec() -> tam32 {
    değişken o: seçimlik<tam32> = değer(5);
    değişken r: seçimlik<tam32> = filtre_tam(o, pozitif_filtre);
    ver ya_da_varsayilan(r, 0);
}

işlev test_filtre_kalmaz() -> tam32 {
    değişken o: seçimlik<tam32> = değer(0 - 5);
    değişken r: seçimlik<tam32> = filtre_tam(o, pozitif_filtre);
    ver ya_da_varsayilan(r, 999);
}

// --- bagla_tam (flatMap) ---
işlev guvenli_ters(x: tam32) -> seçimlik<tam32> {
    eğer x == 0 { ver hiç; }
    ver değer(1000 / x);
}

işlev test_bagla_var() -> tam32 {
    değişken o: seçimlik<tam32> = değer(10);
    değişken r: seçimlik<tam32> = bagla_tam(o, guvenli_ters);
    ver ya_da_varsayilan(r, 0);
}

işlev test_bagla_yok() -> tam32 {
    değişken o: seçimlik<tam32> = değer(0);
    değişken r: seçimlik<tam32> = bagla_tam(o, guvenli_ters);
    ver ya_da_varsayilan(r, 999);
}

// --- ya_da_cagir_tam ---
işlev varsayilan_uretici() -> tam32 { ver 42; }

işlev test_ya_da_cagir_var() -> tam32 {
    değişken o: seçimlik<tam32> = değer(7);
    ver ya_da_cagir_tam(o, varsayilan_uretici);
}

işlev test_ya_da_cagir_yok() -> tam32 {
    değişken o: seçimlik<tam32> = hiç;
    ver ya_da_cagir_tam(o, varsayilan_uretici);
}

// --- harita_metin / filtre_metin ---
işlev kimlik_metin(s: metin) -> metin { ver s; }

işlev test_harita_metin() -> mantıksal {
    değişken o: seçimlik<metin> = değer("merhaba");
    değişken r: seçimlik<metin> = harita_metin(o, kimlik_metin);
    ver var_mi(r);
}

işlev bos_degil(s: metin) -> mantıksal { ver s != ""; }

işlev test_filtre_metin() -> mantıksal {
    değişken o: seçimlik<metin> = değer("dolu");
    değişken r: seçimlik<metin> = filtre_metin(o, bos_degil);
    ver var_mi(r);
}

// --- harita_ya_da / say / diziye (yeni) ---
işlev iki_kat_opt(x: tam32) -> tam32 { ver x * 2; }

işlev test_harita_ya_da_deger() -> mantıksal {
    değişken o: seçimlik<tam32> = değer(21);
    ver harita_ya_da(o, 0, iki_kat_opt) == 42;
}

işlev test_harita_ya_da_hic() -> mantıksal {
    değişken o: seçimlik<tam32> = hiç;
    ver harita_ya_da(o, 99, iki_kat_opt) == 99;
}

işlev test_say_deger() -> mantıksal {
    değişken o: seçimlik<tam32> = değer(5);
    ver say(o) == 1;
}

işlev test_say_hic() -> mantıksal {
    değişken o: seçimlik<tam32> = hiç;
    ver say(o) == 0;
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    // --- mantıksal: beklenti ANLAMDAN türetildi, addan değil ---
    eğer değil test_var_deger()          { yazdir_metin("B: var_deger"); h = h + 1; }
    eğer      test_var_hic()             { yazdir_metin("B: var_hic"); h = h + 1; }
    eğer      test_yok_deger()           { yazdir_metin("B: yok_deger"); h = h + 1; }
    eğer değil test_yok_hic()            { yazdir_metin("B: yok_hic"); h = h + 1; }
    eğer değil test_bos_hic()            { yazdir_metin("B: bos_hic"); h = h + 1; }
    eğer değil test_her_iki_var()        { yazdir_metin("B: her_iki_var"); h = h + 1; }
    eğer değil test_esit_iki_deger()     { yazdir_metin("B: esit_iki_deger"); h = h + 1; }
    eğer değil test_esit_iki_hic()       { yazdir_metin("B: esit_iki_hic"); h = h + 1; }
    eğer      test_esit_farkli()         { yazdir_metin("B: esit_farkli"); h = h + 1; }
    eğer değil test_sarmala()            { yazdir_metin("B: sarmala"); h = h + 1; }
    eğer değil test_harita_metin()       { yazdir_metin("B: harita_metin"); h = h + 1; }
    eğer değil test_filtre_metin()       { yazdir_metin("B: filtre_metin"); h = h + 1; }
    eğer değil test_harita_ya_da_deger() { yazdir_metin("B: harita_ya_da_deger"); h = h + 1; }
    eğer değil test_harita_ya_da_hic()   { yazdir_metin("B: harita_ya_da_hic"); h = h + 1; }
    eğer değil test_say_deger()          { yazdir_metin("B: say_deger"); h = h + 1; }
    eğer değil test_say_hic()            { yazdir_metin("B: say_hic"); h = h + 1; }
    // --- tam32: değerler yardımcı işlevlerden OKUNDU (guvenli_ters(10)=1000/10) ---
    eğer test_ya_da_var()       != 7   { yazdir_metin("S: ya_da_var"); h = h + 1; }
    eğer test_ya_da_yok()       != 99  { yazdir_metin("S: ya_da_yok"); h = h + 1; }
    eğer test_ilk_var_a()       != 10  { yazdir_metin("S: ilk_var_a"); h = h + 1; }
    eğer test_ilk_var_b()       != 20  { yazdir_metin("S: ilk_var_b"); h = h + 1; }
    eğer test_harita_deger()    != 42  { yazdir_metin("S: harita_deger"); h = h + 1; }
    eğer test_harita_hic()      != 999 { yazdir_metin("S: harita_hic"); h = h + 1; }
    eğer test_filtre_gec()      != 5   { yazdir_metin("S: filtre_gec"); h = h + 1; }
    eğer test_filtre_kalmaz()   != 999 { yazdir_metin("S: filtre_kalmaz"); h = h + 1; }
    eğer test_bagla_var()       != 100 { yazdir_metin("S: bagla_var"); h = h + 1; }
    eğer test_bagla_yok()       != 999 { yazdir_metin("S: bagla_yok"); h = h + 1; }
    eğer test_ya_da_cagir_var() != 7   { yazdir_metin("S: ya_da_cagir_var"); h = h + 1; }
    eğer test_ya_da_cagir_yok() != 42  { yazdir_metin("S: ya_da_cagir_yok"); h = h + 1; }
    // --- metin ---
    eğer değil metin_esit(test_ya_da_metin(), "varsayilan") { yazdir_metin("M: ya_da_metin"); h = h + 1; }
    eğer h == 0 { yazdir_metin("opsiyonel: TUM TESTLER GECTI"); ver 0; }
    yazdir_metin("opsiyonel: BASARISIZ");
    ver 1;
}
