// KEMGU Stdlib Testi — Dosya
// =================================
//
// Bu dosya `stdlib/dosya.kem` ile birleştirilerek DERLENİR ve ÇALIŞTIRILIR.
//
// ⚠ D-443: Yukarıdaki cümle eskiden "tüm body'ler stub, gerçek I/O test
// edilmez (runtime primitif yok)" diyordu. Runtime primitifleri Madde G ile
// EKLENDİ ama yorum güncellenmedi ve `main` 27 testten YALNIZ BİRİNİ
// çağırmaya devam etti — yani gerçek I/O hiç doğrulanmadı. Artık `main`
// deterministik yolları koşar VE gerçek bir gidiş-dönüş yapar
// (yaz → oku → doğrula → sil), yarattığı dosyayı KENDİSİ temizler.
// Kapı depo kökünde koştuğu için temizlik zorunludur.

// --- handle yardımcıları ---
// [D-449] Sentinel artik NULL; `h == ""` ile sinanamaz (icerik karsilastirmasi
// NULL'i dizgi gibi okumaya calisir). Dogru sinama gecerlilik yuklemidir.
işlev test_gecersiz_handle() -> mantıksal {
    değişken h: metin = gecersiz_handle();
    ver değil handle_gecerli_mi(h);
}

işlev test_handle_gecerli_evet() -> mantıksal {
    ver handle_gecerli_mi("dosya.txt");
}

// [D-449] Gecersizlik artik NULL ile temsil edilir; bos dizgi GECERLI bir
// isaretcidir. Yuklem sentinel'e karsi sinanir.
işlev test_handle_gecerli_hayir() -> mantıksal {
    ver handle_gecerli_mi(gecersiz_handle());
}

// --- mod sabitleri ---
işlev test_mod_okuma() -> metin { ver mod_okuma(); }
işlev test_mod_yazma() -> metin { ver mod_yazma(); }
işlev test_mod_ekleme() -> metin { ver mod_ekleme(); }

// --- ac / kapat ---
// [D-452] `ac` artik `sonuç<Dosya, metin>` doner. Basarili kolda `Dosya`
// LINEERDIR: kapatilmazsa L001 (sizinti) alinir — yani test bile dosyayi
// kapatmak ZORUNDA. Tam da istenen budur.
işlev test_ac_iyi() -> metin {
    eşleş ac("dosya.txt", mod_okuma()) {
        tamam(d) => { kapat(d); ver ""; }
        hata(e)  => { ver e; }
    }
    ver "eslesme yok";
}

işlev test_ac_bos_yol() -> metin {
    eşleş ac("", mod_okuma()) {
        tamam(d) => { kapat(d); ver ""; }
        hata(e)  => { ver e; }
    }
    ver "eslesme yok";
}

// [D-452] `kapat` artik `Dosya` alir; rastgele bir `metin` gecirmek T001'dir
// (D-449'da acikca "kapatilabilir borc" diye kaydedilen sinir KAPANDI).
işlev test_kapat_iyi() -> metin {
    eşleş ac("dosya.txt", mod_okuma()) {
        tamam(d) => {
            eşleş kapat(d) { tamam(v) => { ver ""; } hata(e) => { ver e; } }
            ver "kapat eslesme yok";
        }
        hata(e) => { ver e; }
    }
    ver "eslesme yok";
}

// [D-452] `test_kapat_bos` KALDIRILDI: GECERSIZ bir `Dosya` ARTIK YOK.
// `ac` basarisizlikta `hata` doner, `tamam` kolunda handle her zaman
// gecerlidir. Gecersizlik TIP DUZEYINDE imkansiz hale geldi — sinanacak bir
// calisma-zamani durumu kalmadi. (D-449'da bu test sentinel sozlesmesini
// olcuyordu; o sozlesme ortadan kalkti.)

// --- oku_metin / oku_satirlar ---
işlev test_oku_metin() -> sonuç<metin, metin> {
    ver oku_metin("data.txt");
}

işlev test_oku_metin_bos_yol() -> sonuç<metin, metin> {
    ver oku_metin("");
}

işlev test_oku_satirlar() -> sonuç<Dizi<metin>, metin> {
    ver oku_satirlar("data.txt");
}

// --- yaz_metin / ekle / ekle_satir ---
işlev test_yaz_metin() -> sonuç<tam32, metin> {
    ver yaz_metin("out.txt", "merhaba");
}

işlev test_yaz_metin_bos_yol() -> sonuç<tam32, metin> {
    ver yaz_metin("", "merhaba");
}

işlev test_ekle() -> sonuç<tam32, metin> {
    ver ekle("log.txt", "yeni satir");
}

işlev test_ekle_satir() -> sonuç<tam32, metin> {
    ver ekle_satir("log.txt", "yeni satir");
}

// --- var_mi / sil / boyut ---
işlev test_var_mi_bos() -> mantıksal {
    ver var_mi("");
}

işlev test_var_mi_dolu() -> mantıksal {
    ver var_mi("a.txt");
}

işlev test_sil() -> sonuç<tam32, metin> {
    ver sil("kopya.txt");
}

işlev test_sil_bos() -> sonuç<tam32, metin> {
    ver sil("");
}

işlev test_boyut() -> sonuç<tam64, metin> {
    ver boyut("a.txt");
}

// --- yeniden_adlandir / kopyala ---
işlev test_yeniden_adlandir() -> sonuç<tam32, metin> {
    ver yeniden_adlandir("eski.txt", "yeni.txt");
}

işlev test_yeniden_adlandir_hata() -> sonuç<tam32, metin> {
    ver yeniden_adlandir("", "yeni.txt");
}

işlev test_kopyala() -> sonuç<tam32, metin> {
    ver kopyala("kaynak.txt", "hedef.txt");
}

işlev test_kopyala_hata() -> sonuç<tam32, metin> {
    ver kopyala("kaynak.txt", "");
}

// --- Bileşik kullanım ---
// [D-452] Iki dosya ayni kapsamda: HER IKISI de kapatilmali, yoksa L001.
işlev test_iki_ac_kapat() -> tam32 {
    değişken n: tam32 = 0;
    eşleş ac("a.txt", mod_okuma()) {
        tamam(d) => { kapat(d); n = n + 1; }
        hata(e)  => { }
    }
    eşleş ac("b.txt", mod_yazma()) {
        tamam(d) => { kapat(d); n = n + 1; }
        hata(e)  => { }
    }
    ver n;
}

// [D-443] Bu `main` ÖNCEDEN 27 test işlevinden YALNIZ BİRİNİ çağırıyordu.
// Dosyanın başlık yorumu da eskimişti ("runtime primitif yok" — oysa Madde G
// ile eklendi), yani hiçbir şey GERÇEK I/O'yu doğrulamıyordu.
//
// İki bölüm: (1) ortamdan BAĞIMSIZ deterministik yollar — var olmayan dosya
// ve boş yol; boş-yol korumaları D-440'ta onarıldı ve burada kapıya bağlanır.
// (2) GERÇEK gidiş-dönüş: yaz → oku → doğrula → sil. Yarattığı her dosyayı
// KENDİSİ temizler; kapı depo kökünde koştuğu için bu şart.

// D-443: mesaj DA denetlenir. İlk sürüm yalnız "hata mı" diye bakıyordu;
// sabotaj S30 (boş-yol koşulunu boz) SESSİZ kaldı çünkü çağrı yine hata
// döndü — ama BAŞKA bir hata ("silinemedi"). Hangi kuralın ateşlediğini
// ölçmeyen bir kapı, o kuralı ölçmüyor demektir.
// [D-452] `ac`/`kapat` artik `Dosya` ile calisiyor; testleri `sonuç`u DISARI
// TASIYAMAZ (lineer deger kacar, L001). Bu yuzden hata MESAJINI dondururler
// ve burada karsilastirilir. "" = basari.
işlev mesaj_bekle(ad: metin, bek: metin, gelen: metin) -> tam32 {
    eğer metin_esit(gelen, bek) { ver 0; }
    yazdir_metin(metin_birlestir(metin_birlestir(metin_birlestir(
        "BASARISIZ ", ad), metin_birlestir(": beklenen ", bek)),
        metin_birlestir(", gelen ", gelen)));
    ver 1;
}

işlev bekle_hata_m(ad: metin, bek: metin, r: sonuç<metin, metin>) -> tam32 {
    eşleş r {
        hata(e) => {
            eğer metin_esit(e, bek) { ver 0; }
            yazdir_metin(metin_birlestir(metin_birlestir(metin_birlestir(
                "BASARISIZ ", ad), metin_birlestir(": beklenen ", bek)),
                metin_birlestir(", gelen ", e)));
            ver 1;
        }
        tamam(v) => { yazdir_metin(metin_birlestir("BASARISIZ (hata bekleniyordu): ", ad)); ver 1; }
    }
    ver 1;
}

işlev bekle_hata_t(ad: metin, bek: metin, r: sonuç<tam32, metin>) -> tam32 {
    eşleş r {
        hata(e) => {
            eğer metin_esit(e, bek) { ver 0; }
            yazdir_metin(metin_birlestir(metin_birlestir(metin_birlestir(
                "BASARISIZ ", ad), metin_birlestir(": beklenen ", bek)),
                metin_birlestir(", gelen ", e)));
            ver 1;
        }
        tamam(v) => { yazdir_metin(metin_birlestir("BASARISIZ (hata bekleniyordu): ", ad)); ver 1; }
    }
    ver 1;
}

işlev bekle_hata_t64(ad: metin, bek: metin, r: sonuç<tam64, metin>) -> tam32 {
    eşleş r {
        hata(e) => {
            eğer metin_esit(e, bek) { ver 0; }
            yazdir_metin(metin_birlestir(metin_birlestir(metin_birlestir(
                "BASARISIZ ", ad), metin_birlestir(": beklenen ", bek)),
                metin_birlestir(", gelen ", e)));
            ver 1;
        }
        tamam(v) => { yazdir_metin(metin_birlestir("BASARISIZ (hata bekleniyordu): ", ad)); ver 1; }
    }
    ver 1;
}

işlev bekle_tamam_t(ad: metin, r: sonuç<tam32, metin>) -> tam32 {
    eşleş r {
        tamam(v) => { ver 0; }
        hata(e) => { yazdir_metin(metin_birlestir(metin_birlestir("BASARISIZ ", ad), metin_birlestir(": ", e))); ver 1; }
    }
    ver 1;
}

// GERÇEK gidiş-dönüş — runtime primitiflerini fiilen çalıştırır.
işlev gidis_donus() -> tam32 {
    değişken h: tam32 = 0;
    değişken yol: metin = "kemgu_test_gd.txt";
    değişken icerik: metin = "merhaba ölç";
    h = h + bekle_tamam_t("yaz_metin", yaz_metin(yol, icerik));
    eğer değil var_mi(yol) { yazdir_metin("BASARISIZ: yazilan dosya var_mi=yanlis"); h = h + 1; }
    eşleş oku_metin(yol) {
        tamam(v) => {
            // UTF-8 çok baytlı karakter aynen dönmeli
            eğer değil metin_esit(v, icerik) {
                yazdir_metin(metin_birlestir("BASARISIZ: okunan icerik farkli: ", v));
                h = h + 1;
            }
        }
        hata(e) => { yazdir_metin(metin_birlestir("BASARISIZ oku_metin: ", e)); h = h + 1; }
    }
    // TEMİZLİK — kapı depo kökünde koşar, artefakt bırakma
    h = h + bekle_tamam_t("sil", sil(yol));
    eğer var_mi(yol) { yazdir_metin("BASARISIZ: silinen dosya hala var"); h = h + 1; }
    ver h;
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    // (1) handle + mod sabitleri
    eğer değil test_gecersiz_handle()      { yazdir_metin("B: gecersiz_handle"); h = h + 1; }
    eğer değil test_handle_gecerli_evet()  { yazdir_metin("B: handle_gecerli_evet"); h = h + 1; }
    eğer      test_handle_gecerli_hayir()  { yazdir_metin("B: handle_gecerli_hayir"); h = h + 1; }
    eğer değil metin_esit(test_mod_okuma(),  "okuma")  { yazdir_metin("M: mod_okuma"); h = h + 1; }
    eğer değil metin_esit(test_mod_yazma(),  "yazma")  { yazdir_metin("M: mod_yazma"); h = h + 1; }
    eğer değil metin_esit(test_mod_ekleme(), "ekleme") { yazdir_metin("M: mod_ekleme"); h = h + 1; }
    // (2) BOŞ YOL korumalari — D-440'ta onarildi, burada kapiya baglanir
    h = h + mesaj_bekle("ac_bos_yol", "bos yol", test_ac_bos_yol());
    h = h + bekle_hata_m("oku_metin_bos_yol", "bos yol", test_oku_metin_bos_yol());
    h = h + bekle_hata_t("yaz_metin_bos_yol", "bos yol", test_yaz_metin_bos_yol());
    h = h + bekle_hata_t("sil_bos", "bos yol", test_sil_bos());
    h = h + bekle_hata_t("kopyala_hata", "bos hedef", test_kopyala_hata());
    h = h + bekle_hata_t("yeniden_adlandir_hata", "bos eski yol", test_yeniden_adlandir_hata());
    eğer test_var_mi_bos() { yazdir_metin("B: var_mi_bos"); h = h + 1; }
    // (3) VAR OLMAYAN dosya — deterministik hata
    // [D-449] ONCEDEN burada BILINEN-YANLIS bir sonuc sabitlenmisti:
    // `ac("dosya.txt")` var olmayan dosyada `tamam` donuyordu, cunku handle
    // `metin` tiplenip gecerlilik `h != ""` (ISARETCI kimligi) ile
    // sinaniyordu ve `dosya_ac`in NULL'i yakalanamiyordu. D-449 ile `==`
    // icerik karsilastirmasina dondu, sentinel NULL'a tasindi ve gecerlilik
    // runtime null-sorgusuna baglandi -> DAVRANIS ARTIK DOGRU. Sabitlenen
    // test tam da tasarlandigi gibi kirmiziya donup bunu bildirdi.
    h = h + mesaj_bekle("ac_iyi(yok)", "dosya acilamadi", test_ac_iyi());
    h = h + bekle_hata_m("oku_metin(yok)", "dosya yok", test_oku_metin());
    h = h + bekle_hata_t64("boyut(yok)", "dosya yok", test_boyut());
    h = h + bekle_hata_t("kopyala(yok)", "kaynak yok", test_kopyala());
    h = h + bekle_hata_t("yeniden_adlandir(yok)", "yeniden adlandirilamadi", test_yeniden_adlandir());
    eğer test_var_mi_dolu() { yazdir_metin("B: var_mi_dolu (yok olmali)"); h = h + 1; }
    // (4) GERÇEK I/O gidiş-dönüşü (kendi temizliğini yapar)
    h = h + gidis_donus();
    eğer h == 0 { yazdir_metin("dosya: TUM TESTLER GECTI"); ver 0; }
    yazdir_metin("dosya: BASARISIZ");
    ver 1;
}
