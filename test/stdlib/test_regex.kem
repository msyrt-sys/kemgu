// KEMGU Stdlib Testi — REGEX
// =============================================================================
// `stdlib/regex.kem` ile BİRLEŞTİRİLEREK derlenir ve ÇALIŞTIRILIR.
// Başarıda exit 0, aksi hâlde 1.
//
// ⚠ Bu testin EN ÖNEMLİ maddesi (h) ÜSTEL PATLAMA ölçümüdür: motor seçiminin
// (Thompson, geri izleme DEĞİL) gerçekten işe yaradığının kanıtı odur.
// Doğruluk testleri geri izlemeli bir motorda da geçerdi; asılmama garantisi
// GEÇMEZDİ.

işlev rx_dene(desen: metin, girdi: metin, beklenen: mantıksal, kod: tam32) -> tam32 {
    eşleş derle(desen) {
        hata(m) => {
            yazdir_metin("DERLEME HATASI (beklenmiyordu):");
            yazdir_metin(desen); yazdir_metin(m);
            ver kod;
        }
        tamam(r) => {
            eğer eslesir(&değişken r, girdi) == beklenen { ver 0; }
            yazdir_metin("YANLIS SONUC — desen / girdi:");
            yazdir_metin(desen); yazdir_metin(girdi);
            ver kod;
        }
    }
    ver kod;
}

// Bozuk desen HATA dondurmeli — panik DEGIL, sessiz kabul DEGIL.
işlev rx_bozuk(desen: metin, kod: tam32) -> tam32 {
    eşleş derle(desen) {
        tamam(r) => {
            yazdir_metin("BOZUK DESEN KABUL EDILDI:"); yazdir_metin(desen);
            ver kod;
        }
        hata(m) => { ver 0; }
    }
    ver kod;
}

işlev rx_tam(desen: metin, girdi: metin, beklenen: mantıksal, kod: tam32) -> tam32 {
    eşleş derle(desen) {
        hata(m) => { yazdir_metin("DERLEME HATASI:"); yazdir_metin(desen); ver kod; }
        tamam(r) => {
            eğer tam_eslesir(&değişken r, girdi) == beklenen { ver 0; }
            yazdir_metin("tam_eslesir YANLIS:"); yazdir_metin(desen); yazdir_metin(girdi);
            ver kod;
        }
    }
    ver kod;
}

// [D-463] YAKALAMA GRUBU ölçümü: k. grubun METNİ beklenenle aynı mı?
// `beklenen` özel değerleri: "<yok>" = eşleşme yok, "<yakalanmadi>" = grup
// eşleşmedi (yuva -1). Bu ikisini AYIRMAK şart: boş dizgi ile karıştırmak
// `(a)|b` gibi desenlerde sessiz yanlış cevap üretirdi.
işlev rx_grup(desen: metin, girdi: metin, k: tam32,
              beklenen: metin, kod: tam32) -> tam32 {
    değişken gercek: metin = "<derleme hatasi>";
    eşleş derle(desen) {
        hata(m) => { }
        tamam(r) => {
            eşleş ara_gruplar(&değişken r, girdi) {
                hiç => { gercek = "<yok>"; }
                değer(y) => {
                    eşleş grup_metin(girdi, y, k) {
                        hiç => { gercek = "<yakalanmadi>"; }
                        değer(t) => { gercek = t; }
                    }
                }
            }
        }
    }
    eğer metin_esit(gercek, beklenen) { ver 0; }
    yazdir_metin("GRUP YANLIS:");
    yazdir_metin(desen); yazdir_metin(girdi);
    yazdir_metin("beklenen:"); yazdir_metin(beklenen);
    yazdir_metin("gelen   :"); yazdir_metin(gercek);
    ver kod;
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;

    // (a) literal + arama
    h = h + rx_dene("abc", "xxabcyy", doğru, 1);
    h = h + rx_dene("abc", "xxabyy", yanlış, 2);

    // (b) niceleyiciler
    h = h + rx_dene("a*b", "aaab", doğru, 4);
    h = h + rx_dene("a*b", "b", doğru, 8);
    h = h + rx_dene("a+b", "b", yanlış, 16);
    h = h + rx_dene("a?b", "ab", doğru, 32);

    // (c) alternatif + grup
    h = h + rx_dene("a|b", "b", doğru, 64);
    h = h + rx_dene("(ab)+c", "ababc", doğru, 128);
    h = h + rx_dene("(a|b)+c", "abbac", doğru, 256);

    // (d) karakter sınıfları
    h = h + rx_dene("[a-c]+", "bbc", doğru, 512);
    h = h + rx_dene("[^a-c]", "d", doğru, 1024);
    h = h + rx_dene("[^a-c]", "b", yanlış, 2048);

    // (e) çapalar — `tam_eslesir` ile birlikte anlamlı
    h = h + rx_tam("a+", "aaa", doğru, 4096);
    h = h + rx_tam("a+", "aaab", yanlış, 8192);

    // (f) UTF-8: `.` bir KARAKTER eşler, BAYT değil.
    // "çığ" 6 BAYT ama 3 KARAKTERDİR; `...` tamamını eşlemeli.
    // Bayt düzeyinde çalışan bir motor burada DÜŞERDİ — Türkçe DNA gereği
    // bu satır bilerek Türkçe karakterlerle yazılmıştır.
    h = h + rx_tam("...", "çığ", doğru, 16384);
    h = h + rx_dene("ı", "çığ", doğru, 32768);
    h = h + rx_dene("ö", "çığ", yanlış, 65536);

    // (g) bozuk desenler: SESSİZ KABUL ETME
    h = h + rx_bozuk("(ab", 131072);
    h = h + rx_bozuk("[a-", 262144);
    h = h + rx_bozuk("*abc", 524288);
    h = h + rx_bozuk("a)", 1048576);

    // (h) 🎯 ÜSTEL PATLAMA — MOTOR SEÇİMİNİN KANITI.
    // `(a+)+b` geri izlemeli motorlarda (PCRE/Java/Python) klasik ReDoS
    // desenidir: 40 'a' + 'X' girdisinde adım sayısı 2^40 mertebesine çıkar,
    // yani pratikte ASILIR. Thompson simülasyonunda adım sayısı
    // girdi × desen ile SINIRLIDIR. Ölçüldü: girdi 20→160'a çıkarken
    // (8 kat) süre SABİT kaldı (~70-130 ms, geri kalanı süreç başlatma).
    // Bu satır asılırsa kapı zaman aşımıyla KIRMIZI olur — istenen budur.
    değişken kotu: metin = "";
    değişken i: tam32 = 0;
    iken i < 40 { kotu = metin_birlestir(kotu, "a"); i = i + 1; }
    kotu = metin_birlestir(kotu, "X");
    h = h + rx_dene("(a+)+b", kotu, yanlış, 2097152);

    // (i) tum_bul + degistir
    eşleş derle("[0-9]+") {
        hata(m) => { yazdir_metin("derleme hatasi: [0-9]+"); h = h + 1; }
        tamam(r) => {
            değişken es: Dizi<Eslesme> = tum_bul(&değişken r, "a12b345c");
            eğer dizi_boyut(es) != 2 { yazdir_metin("tum_bul sayisi yanlis"); h = h + 1; }
            değilse {
                değişken e0: Eslesme = dizi_al(es, 0);
                eğer e0.baslangic != 1 veya e0.uzunluk != 2 {
                    yazdir_metin("tum_bul[0] yanlis"); h = h + 1;
                }
                değişken e1: Eslesme = dizi_al(es, 1);
                eğer e1.baslangic != 4 veya e1.uzunluk != 3 {
                    yazdir_metin("tum_bul[1] yanlis"); h = h + 1;
                }
            }
            eğer metin_esit(degistir(&değişken r, "a12b345c", "#"), "a#b#c") == yanlış {
                yazdir_metin("degistir yanlis"); h = h + 1;
            }
        }
    }

    // (j) HAZIR SINIFLAR `\d \w \s`.
    // ⚠ Bunlar kodda vardı ve `--check`ten geçiyorlardı ama HİÇBİR ÖLÇÜM
    // ateşlemiyordu — D-458'de `\b`/`\f`nin "destekleniyor" yazılıp kolunun
    // hiç olmaması bu sınıfın ta kendisiydi. Kendi denetimimde yakalandı.
    // ⚠ KEMGU dizgi literalinde kaçış YOK: aşağıdaki `"\d+"` kaynakta ZATEN
    // ters bölü + `d` + `+` üç karakteridir — istenen tam olarak budur.
    h = h + rx_dene("\d+", "ab123cd", doğru, 4194304);
    h = h + rx_dene("\d+", "abcd", yanlış, 8388608);
    h = h + rx_tam("\w+", "abc_123", doğru, 16777216);
    h = h + rx_dene("\s+", "a  b", doğru, 33554432);
    h = h + rx_dene("\s", "ab", yanlış, 67108864);

    // (k) BOŞ EŞLEŞME davranışı — ÖLÇÜLDÜ, varsayılmadı.
    // `a*` "bbb" üzerinde 4 boş eşleşme verir ve `degistir` `-b-b-b-` üretir;
    // bu, Python `re.sub('a*','-','bbb')` ile BİREBİR aynıdır. Sabitlenmesinin
    // sebebi: boş eşleşmede ilerlememek SONSUZ DÖNGÜ olurdu, bir karakter
    // atlamak ise sessiz bir tasarım kararıdır — sessiz kalmasın.
    eşleş derle("a*") {
        hata(m) => { yazdir_metin("derleme hatasi: a*"); h = h + 1; }
        tamam(r) => {
            eğer dizi_boyut(tum_bul(&değişken r, "bbb")) != 4 {
                yazdir_metin("bos eslesme sayisi yanlis"); h = h + 1;
            }
            eğer metin_esit(degistir(&değişken r, "bbb", "-"), "-b-b-b-") == yanlış {
                yazdir_metin("bos eslesme degistir yanlis"); h = h + 1;
            }
        }
    }

    // ---- [D-463] YAKALAMA GRUPLARI ----------------------------------------
    h = h + rx_grup("(a+)b", "xaaab", 1, "aaa", 100);
    h = h + rx_grup("(a)(b)", "ab", 1, "a", 101);
    h = h + rx_grup("(a)(b)", "ab", 2, "b", 102);
    // İÇ İÇE: numara AÇILIŞ PARANTEZİ sırasına göre — dış grup 1'dir.
    // İçeriden numaralasaydık dış gruba 3 düşerdi; Perl/POSIX geleneği bu.
    h = h + rx_grup("((a)(b))", "ab", 1, "ab", 103);
    h = h + rx_grup("((a)(b))", "ab", 2, "a", 104);
    h = h + rx_grup("((a)(b))", "ab", 3, "b", 105);
    // YAKALANMAMIŞ grup boş dizgi DEĞİLDİR (yuva -1). Karıştırmak sessiz
    // yanlış cevap olurdu: `(a)|b` üzerinde `b` eşleşir, g1 yakalanmaz.
    h = h + rx_grup("(a)|b", "b", 1, "<yakalanmadi>", 106);
    h = h + rx_grup("(a)|b", "a", 1, "a", 107);
    h = h + rx_grup("(x)", "y", 1, "<yok>", 108);
    // Aralık dışı grup numarası → `hiç` (panik DEĞİL).
    h = h + rx_grup("(a)", "a", 5, "<yakalanmadi>", 109);
    h = h + rx_grup("(a)", "a", 0, "<yakalanmadi>", 110);
    // Sınıf + niceleyici birlikte
    h = h + rx_grup("([0-9]+)", "ab123cd", 1, "123", 111);
    // ⚠ UTF-8 KOD NOKTASI düzeyi: `(...)` ÜÇ KARAKTER yakalar, üç BAYT değil.
    // Bayt düzeyinde çalışan bir motor burada düşerdi (`çığ` 6 bayttır).
    h = h + rx_grup("(...)", "çığ", 1, "çığ", 112);
    // Gruplu YILDIZ: son yineleme kazanır (Perl/POSIX ortak davranışı)
    h = h + rx_grup("(ab)*", "abab", 1, "ab", 113);
    // ⚠⚠ İKİ KURAL AYRIDIR ve karıştırmak kolaydır — bu testi yazarken BEN
    // karıştırdım, ölçüm düzeltti:
    //   · GENEL EŞLEŞME uzunluğu: EN UZUN (leftmost-longest) kazanır.
    //   · YAKALAMA ayrımı: yalnız EŞİT UZUNLUKTAKİ eşleşmeler arasında,
    //     ÖNCELİK (alternatifin sol kolu) kazanır.
    // `(a)|(ab)` üzerinde "ab": sağ kol 2 karakter eşler, sol kol 1 —
    // uzunluk kuralı SAĞ kolu seçer, öncelik DEVREYE GİRMEZ. Dolayısıyla
    // g1 yakalanmaz, g2 = "ab". (Beklentimi "a" yazmıştım; yanlıştı.)
    h = h + rx_grup("(a)|(ab)", "ab", 1, "<yakalanmadi>", 114);
    h = h + rx_grup("(a)|(ab)", "ab", 2, "ab", 115);
    // ÖNCELİĞİN GERÇEKTEN ölçüldüğü vaka: iki kol AYNI uzunlukta eşler →
    // burada uzunluk ayırt edemez, SOL kol kazanmalıdır.
    h = h + rx_grup("(a)|(a)", "a", 1, "a", 116);
    h = h + rx_grup("(a)|(a)", "a", 2, "<yakalanmadi>", 117);

    eğer h == 0 { yazdir_metin("regex: TUM TESTLER GECTI"); ver 0; }
    yazdir_metin("regex: BASARISIZ");
    ver 1;
}
