// KEMGU Stdlib Testi — Sonuç
// =================================
//
// Bu dosya `stdlib/sonuc.kem` ile birleştirilerek --check edilir.
// İkili katman: built-in sonuç wrapper'ları + KSonuc yapı tabanlı API.

// --- Built-in sonuç construction wrapper'ları ---
işlev test_tamam_yap() -> sonuç<tam32, metin> {
    ver tamam_yap(42);
}

işlev test_hata_yap() -> sonuç<tam32, metin> {
    ver hata_yap("baz hata");
}

// --- KSonuc yapıcılar ---
işlev test_k_tamam() -> KSonuc<tam32, metin> {
    ver k_tamam(42);
}

işlev test_k_hata() -> KSonuc<tam32, metin> {
    ver k_hata("hata mesajı");
}

// --- k_basarili_mi / k_basarisiz_mi ---
işlev test_basarili_evet() -> mantıksal {
    değişken r: KSonuc<tam32, metin> = k_tamam(7);
    ver k_basarili_mi(r);
}

işlev test_basarili_hayir() -> mantıksal {
    değişken r: KSonuc<tam32, metin> = k_hata("x");
    ver k_basarili_mi(r);
}

işlev test_basarisiz_evet() -> mantıksal {
    değişken r: KSonuc<tam32, metin> = k_hata("x");
    ver k_basarisiz_mi(r);
}

işlev test_basarisiz_hayir() -> mantıksal {
    değişken r: KSonuc<tam32, metin> = k_tamam(7);
    ver k_basarisiz_mi(r);
}

// --- k_ya_da / k_hata_ya_da ---
işlev test_ya_da_basarili() -> tam32 {
    değişken r: KSonuc<tam32, metin> = k_tamam(42);
    ver k_ya_da(r, 0);
}

işlev test_ya_da_basarisiz() -> tam32 {
    değişken r: KSonuc<tam32, metin> = k_hata("x");
    ver k_ya_da(r, 99);
}

işlev test_hata_ya_da_var() -> metin {
    değişken r: KSonuc<tam32, metin> = k_hata("orijinal");
    ver k_hata_ya_da(r, "varsayilan");
}

işlev test_hata_ya_da_yok() -> metin {
    değişken r: KSonuc<tam32, metin> = k_tamam(1);
    ver k_hata_ya_da(r, "varsayilan");
}

// --- k_secimlik / k_hata_secimlik ---
işlev test_secimlik_var() -> mantıksal {
    değişken r: KSonuc<tam32, metin> = k_tamam(5);
    değişken s: seçimlik<tam32> = k_secimlik(r);
    eşleş s {
        değer(v) => { ver doğru; }
        hiç => { ver yanlış; }
    }
    ver yanlış;
}

işlev test_secimlik_yok() -> mantıksal {
    değişken r: KSonuc<tam32, metin> = k_hata("x");
    değişken s: seçimlik<tam32> = k_secimlik(r);
    eşleş s {
        değer(v) => { ver yanlış; }
        hiç => { ver doğru; }
    }
    ver yanlış;
}

// --- k_harita_tam ---
işlev iki_kat_lokal(x: tam32) -> tam32 { ver x * 2; }

işlev test_harita_basarili() -> tam32 {
    değişken r: KSonuc<tam32, metin> = k_tamam(21);
    değişken r2: KSonuc<tam32, metin> = k_harita_tam(r, iki_kat_lokal);
    ver k_ya_da(r2, 0);
}

işlev test_harita_basarisiz() -> tam32 {
    değişken r: KSonuc<tam32, metin> = k_hata("x");
    değişken r2: KSonuc<tam32, metin> = k_harita_tam(r, iki_kat_lokal);
    ver k_ya_da(r2, 999);
}

// --- k_harita_hata_tam ---
işlev hata_buyuk_yap(s: metin) -> metin { ver s; }

işlev test_harita_hata_var() -> metin {
    değişken r: KSonuc<tam32, metin> = k_hata("err");
    değişken r2: KSonuc<tam32, metin> = k_harita_hata_tam(r, hata_buyuk_yap);
    ver k_hata_ya_da(r2, "varsayilan");
}

işlev test_harita_hata_yok() -> mantıksal {
    değişken r: KSonuc<tam32, metin> = k_tamam(5);
    değişken r2: KSonuc<tam32, metin> = k_harita_hata_tam(r, hata_buyuk_yap);
    ver k_basarili_mi(r2);
}

// --- k_bagla_tam (flatMap) ---
işlev guvenli_bol_lokal(x: tam32) -> KSonuc<tam32, metin> {
    eğer x == 0 { ver k_hata("sifira bolme"); }
    ver k_tamam(100 / x);
}

işlev test_bagla_basarili() -> tam32 {
    değişken r: KSonuc<tam32, metin> = k_tamam(10);
    değişken r2: KSonuc<tam32, metin> = k_bagla_tam(r, guvenli_bol_lokal);
    ver k_ya_da(r2, 0);
}

işlev test_bagla_basarisiz_giris() -> tam32 {
    değişken r: KSonuc<tam32, metin> = k_hata("ilk hata");
    değişken r2: KSonuc<tam32, metin> = k_bagla_tam(r, guvenli_bol_lokal);
    ver k_ya_da(r2, 999);
}

işlev test_bagla_basarisiz_callback() -> tam32 {
    değişken r: KSonuc<tam32, metin> = k_tamam(0);
    değişken r2: KSonuc<tam32, metin> = k_bagla_tam(r, guvenli_bol_lokal);
    ver k_ya_da(r2, 999);
}

// --- k_alternatif ---
işlev test_alternatif_ilki() -> tam32 {
    değişken a: KSonuc<tam32, metin> = k_tamam(1);
    değişken b: KSonuc<tam32, metin> = k_tamam(2);
    değişken r: KSonuc<tam32, metin> = k_alternatif(a, b);
    ver k_ya_da(r, 0);
}

işlev test_alternatif_ikincisi() -> tam32 {
    değişken a: KSonuc<tam32, metin> = k_hata("ilk basarisiz");
    değişken b: KSonuc<tam32, metin> = k_tamam(2);
    değişken r: KSonuc<tam32, metin> = k_alternatif(a, b);
    ver k_ya_da(r, 0);
}

// --- k_dene_tam ---
işlev test_dene_zincirleme() -> tam32 {
    değişken r: KSonuc<tam32, metin> = k_tamam(10);
    değişken r2: KSonuc<tam32, metin> = k_dene_tam(r, guvenli_bol_lokal);
    ver k_ya_da(r2, 0);
}

// --- k_esit_mi ---
işlev test_esit_iki_tamam() -> mantıksal {
    değişken a: KSonuc<tam32, metin> = k_tamam(5);
    değişken b: KSonuc<tam32, metin> = k_tamam(5);
    ver k_esit_mi(a, b);
}

işlev test_esit_iki_hata() -> mantıksal {
    değişken a: KSonuc<tam32, metin> = k_hata("x");
    değişken b: KSonuc<tam32, metin> = k_hata("x");
    ver k_esit_mi(a, b);
}

işlev test_esit_farkli_tip() -> mantıksal {
    değişken a: KSonuc<tam32, metin> = k_tamam(5);
    değişken b: KSonuc<tam32, metin> = k_hata("x");
    ver k_esit_mi(a, b);
}

// --- Bileşik ---
işlev test_pipeline() -> tam32 {
    değişken r: KSonuc<tam32, metin> = k_tamam(10);
    değişken r1: KSonuc<tam32, metin> = k_harita_tam(r, iki_kat_lokal);
    değişken r2: KSonuc<tam32, metin> = k_bagla_tam(r1, guvenli_bol_lokal);
    ver k_ya_da(r2, 0);
}

// --- Dönüşümler: native seçimlik <-> sonuç ---

işlev test_sonuc_to_opsiyonel_tamam() -> tam32 {
    değişken r: sonuç<tam32, metin> = tamam(42);
    eşleş sonuc_to_opsiyonel(r) {
        değer(v) => { ver v; }       // 42
        hiç => { ver 0 - 1; }
    }
    ver 0 - 1;
}

işlev test_sonuc_to_opsiyonel_hata() -> mantıksal {
    değişken r: sonuç<tam32, metin> = hata("yok");
    eşleş sonuc_to_opsiyonel(r) {
        değer(v) => { ver yanlış; }
        hiç => { ver doğru; }
    }
    ver yanlış;
}

işlev test_sonuc_hata_opsiyonel_var() -> mantıksal {
    değişken r: sonuç<tam32, metin> = hata("bozuk");
    değişken h: seçimlik<metin> = sonuc_hata_opsiyonel(r);
    eşleş h {
        değer(v) => { ver doğru; }
        hiç => { ver yanlış; }
    }
    ver yanlış;
}

işlev test_sonuc_hata_opsiyonel_yok() -> mantıksal {
    değişken r: sonuç<tam32, metin> = tamam(5);
    değişken h: seçimlik<metin> = sonuc_hata_opsiyonel(r);
    eşleş h {
        değer(v) => { ver yanlış; }
        hiç => { ver doğru; }
    }
    ver yanlış;
}

işlev test_opsiyonel_to_sonuc_deger() -> tam32 {
    değişken o: seçimlik<tam32> = değer(42);
    ver ya_da(opsiyonel_to_sonuc(o, 0 - 1), 7);   // 42
}

// NOT: opsiyonel_to_sonuc `sonuç<T, E>` döndürdüğü için (modül başlığındaki
// CODEGEN KISITI) hata tipi tamsayı (E = tam32) ile test edilir — bu yol
// --llvm'de doğru derlenir ve çalışır.
işlev test_opsiyonel_to_sonuc_hic() -> mantıksal {
    değişken o: seçimlik<tam32> = hiç;
    değişken r: sonuç<tam32, tam32> = opsiyonel_to_sonuc(o, 0 - 1);
    ver basarisiz_mi(r);                            // hiç -> hata
}

// Round-trip: sonuç -> seçimlik -> sonuç (başarılı değer korunur).
işlev test_donusum_round_trip() -> tam32 {
    değişken r: sonuç<tam32, tam32> = tamam(42);
    değişken o: seçimlik<tam32> = sonuc_to_opsiyonel(r);
    değişken geri: sonuç<tam32, tam32> = opsiyonel_to_sonuc(o, 0 - 1);
    ver ya_da(geri, 0 - 1);                         // 42
}

işlev main() -> tam32 {
    eğer test_basarili_evet() { ver 0; }
    ver 1;
}
