// KEMGU Stdlib Testi — Kilit
// ==========================
//
// [D-455] `stdlib/kilit.kem` ile BİRLEŞTİRİLEREK derlenir ve ÇALIŞTIRILIR.
// Başarıda exit 0, aksi hâlde 1 (çıkış kodu 8 bite maskelenir — D-435).
//
// Sınanan: kapsamlı API'nin (a) değeri geçirmesi, (b) YENİDEN girilebilmesi
// (kilit lineer DEĞİL, defalarca kullanılır), (c) yan etkiyi görmesi,
// (d) GERÇEK çok-thread'li karşılıklı dışlama.
//
// ⚠ Küresel `Kilit` YAZILAMAZ: küresel init sabit-literal olmalıdır (E012),
// `olustur()` ise bir çağrıdır. Bu yüzden kilit `main`de yaratılır ve görev
// kapanışları onu YAKALAR (D-300: `görev_başlat` yakalamalı kapanış alır).

işlev sabit_kirkiki() -> tam32 { ver 42; }

küresel değişken sayac: tam32 = 0;

işlev main() -> tam32 {
    değişken h: tam32 = 0;

    // (a) kapanışın dönüş değeri çağırana geçmeli
    değişken k: Kilit = olustur();
    eğer kilitle(k, sabit_kirkiki) != 42 {
        yazdir_metin("BASARISIZ: kilitle deger gecirmedi"); h = h + 1;
    }

    // (b) YENİDEN GİRİLEBİLİR: aynı kilit ikinci kez kullanılabilmeli.
    // (Lineer olsaydı bu satır derlenmezdi — bilinçli tasarım kararı.)
    eğer kilitle(k, sabit_kirkiki) != 42 {
        yazdir_metin("BASARISIZ: kilit ikinci kez kullanilamadi"); h = h + 1;
    }

    // (c) kapanış gövdesi kilit altında çalışmalı — sonucu DÖNÜŞ DEĞERİYLE
    // ölçeriz.
    // ⚠ Yakalanan YEREL değişkene yazmak dışarıdan GÖRÜNMEZ: kapanış çevreyi
    // KOPYALAYARAK yakalar (heap env kopyası, D-309). İlk yazımda `n`i mutasyona
    // uğratıp dışarıdan okumaya çalıştım ve C'de "yan etki gorunmedi" aldım —
    // kilit kusuru DEĞİL, KEMGU'nun kapanış semantiği. Paylaşılan durum için
    // doğru yol küresel + `güvensiz`tir (aşağıdaki (d) tam bunu yapar).
    eğer kilitle(k, || { ver 20 + 22; }) != 42 {
        yazdir_metin("BASARISIZ: kapanis govdesi calismadi"); h = h + 1;
    }

    // (d) GERÇEK karşılıklı dışlama: iki görev aynı küresel sayacı kilit
    // altında artırır. Kilit çalışmazsa yarış sonucu 2'den KÜÇÜK olabilir.
    // ⚠ Küresel değişkene erişim KEMGU'da güvensiz-katmandır (E010) — çünkü
    // bölge sahipliği modelinde paylaşılan değişebilir durum thread-güvenli
    // DEĞİLDİR. Kilit tam da bunu sağlam kılan araçtır: `güvensiz` blok
    // "denetimi ben üstleniyorum" der, `kilitle` de o denetimi sağlar.
    değişken g1: sonuç<görev<tam32>, metin> =
        görev_başlat(|| { ver kilitle(k, || {
            güvensiz { sayac = sayac + 1; }
            ver 0;
        }); });
    değişken g2: sonuç<görev<tam32>, metin> =
        görev_başlat(|| { ver kilitle(k, || {
            güvensiz { sayac = sayac + 1; }
            ver 0;
        }); });
    eşleş g1 {
        tamam(t1) => { görev_birleştir(t1); }
        hata(e1)  => { yazdir_metin("BASARISIZ: gorev1 baslatilamadi"); h = h + 1; }
    }
    eşleş g2 {
        tamam(t2) => { görev_birleştir(t2); }
        hata(e2)  => { yazdir_metin("BASARISIZ: gorev2 baslatilamadi"); h = h + 1; }
    }
    değişken son: tam32 = 0;
    güvensiz { son = sayac; }
    eğer son != 2 { yazdir_metin("BASARISIZ: sayac 2 degil"); h = h + 1; }

    yok_et(k);

    eğer h == 0 { yazdir_metin("kilit: TUM TESTLER GECTI"); ver 0; }
    yazdir_metin("kilit: BASARISIZ");
    ver 1;
}
