// KEMGU Stdlib — Kripto BİLİNEN-CEVAP KOŞUM kapısı (D-338)
// =========================================================
//
// KAPI BOŞLUĞU (D-338'in gerçek kök nedeni): `calistir_kripto_check` YALNIZ
// `--check` (tip kontrolü) yapıyordu. test_kripto_vektor.kem'in içindeki resmi
// NIST/RFC vektörleri HİÇ ÇALIŞTIRILMIYORDU — dosyada `main` bile yoktu, dönen
// değerler hiçbir beklenen cevapla KARŞILAŞTIRILMIYORDU. Bu yüzden
// `sabitsüre<dtam32> >> n` -> ashr (işaret yayılımı) hatası SHA-256'nın
// Σ0/Σ1/σ0/σ1 fonksiyonlarının TAMAMINI ve ChaCha20 quarter-round'u sessizce
// bozduğu hâlde tüm kapılar YEŞİL kaldı.
//
// Bu dosya o boşluğu kapatır: gerçekten DERLENİR, ÇALIŞTIRILIR ve resmi
// vektörlerle karşılaştırılır. Her test 1 puan; main tüm puanları toplar.
// Beklenen exit = 11. Herhangi bir yanlış cevap exit'i düşürür.
// (exit 127 = çalışma-anı PANİK, örn. dizi sınır ihlali.)
//
// Beklenen değerler bağımsız bir referans implementasyonuyla üretildi; referans
// da RFC 8439 §2.4.2 şifreleme vektörüyle çapraz doğrulandı (ezberden yazılmadı —
// ilk denemede §2.3.2 için hatalı hatırlanan değerler oracle ile düzeltildi).
//
// KAPSAM DIŞI — bilerek: `hkdf_extract`/`hkdf_expand` (anahtar.kem) ve
// `poly1305_blok_birikim` (sifre.kem) kaynakta **V1 PLACEHOLDER** olarak
// işaretli ("KESİNLİKLE üretim için kullanma", "NOT a real Poly1305!") — gerçek
// HMAC-SHA256 / Barrett reduction V2'de. Bunlara RFC 5869 / RFC 8439 MAC
// bilinen-cevap kapısı YAZILMADI: geçmezdi, stub çıktısını "RFC" diye sabitlemek
// ise sahte bir uyum izlenimi verirdi — kapısız olmaktan daha kötü. V2'de gerçek
// implementasyon gelince RFC 5869 Test Case 1 (PRK/OKM) buraya eklenmeli.
//
// NOT: stdlib/kripto.kem + stdlib/kripto/*.kem bundle'ının ARKASINA eklenir
// (tek dosya derleme — import sistemi henüz yok).

// ---------------------------------------------------------------------------
// T1: ChaCha20 quarter-round — RFC 8439 §2.1.1
//   girdi : a=0x11111111 b=0x01020304 c=0x9B8D6F43 d=0x01234567
//   cikti : a=0xEA2A92F4 b=0xCB1CF8CE c=0x4581472E d=0x5881C4BB
// `_sifre_rotl_u32` (dolayisiyla `>>`) yolunu dogrudan olcer. ashr ile
// c ve d kelimeleri BOZULUR (yuksek bit set degerlerde 1 yayilimi).
// ---------------------------------------------------------------------------
işlev t1_chacha_qr() -> tam32 {
    değişken s: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_olustur((0x11111111 olarak dtam32)),
        sabitsüre_olustur((0x01020304 olarak dtam32)),
        sabitsüre_olustur((0x9B8D6F43 olarak dtam32)),
        sabitsüre_olustur((0x01234567 olarak dtam32))
    ];
    değişken _r: tam32 = chacha20_qr(s, 0, 1, 2, 3);
    değişken a: dtam32 = ifşa(s[0]);
    değişken b: dtam32 = ifşa(s[1]);
    değişken c: dtam32 = ifşa(s[2]);
    değişken d: dtam32 = ifşa(s[3]);
    eğer a == (0xEA2A92F4 olarak dtam32) ve b == (0xCB1CF8CE olarak dtam32)
      ve c == (0x4581472E olarak dtam32) ve d == (0x5881C4BB olarak dtam32) {
        ver 1;
    }
    ver 0;
}

// ---------------------------------------------------------------------------
// T2: ROTR — yuksek bitli girdi. ROTR(0x80000010, 4) = 0x08000001.
// ashr olsaydi 0xF8000001 cikardi.
// ---------------------------------------------------------------------------
işlev t2_rotr_yuksek_bit() -> tam32 {
    değişken x: sabitsüre<dtam32> = sabitsüre_olustur((0x80000010 olarak dtam32));
    eğer ifşa(rotr_u32(x, 4)) == (0x08000001 olarak dtam32) { ver 1; }
    ver 0;
}

// ---------------------------------------------------------------------------
// T3: ROTL — yuksek bitli girdi. ROTL(0x80000010, 4) = 0x00000108.
// ---------------------------------------------------------------------------
işlev t3_rotl_yuksek_bit() -> tam32 {
    değişken x: sabitsüre<dtam32> = sabitsüre_olustur((0x80000010 olarak dtam32));
    eğer ifşa(rotl_u32(x, 4)) == (0x00000108 olarak dtam32) { ver 1; }
    ver 0;
}

// ---------------------------------------------------------------------------
// T4: SHA-256 sigma0_low (σ0) — FIPS 180-4 §4.1.2.
//   σ0(x) = ROTR7(x) ^ ROTR18(x) ^ SHR3(x)
//   x = 0x80000000 icin:
//     ROTR7  = 0x01000000
//     ROTR18 = 0x00002000
//     SHR3   = 0x10000000      (LOGICAL shift — ashr olsaydi 0xF0000000)
//     XOR    = 0x11002000
// SHR3 dali `x >> 3` — bug'in dogrudan ustunde.
// ---------------------------------------------------------------------------
işlev t4_sha256_sigma0_low() -> tam32 {
    değişken x: sabitsüre<dtam32> = sabitsüre_olustur((0x80000000 olarak dtam32));
    eğer ifşa(_karma_sigma0_low(x)) == (0x11002000 olarak dtam32) { ver 1; }
    ver 0;
}

// ---------------------------------------------------------------------------
// T5: SHA-256 sigma1_low (σ1) — FIPS 180-4 §4.1.2.
//   σ1(x) = ROTR17(x) ^ ROTR19(x) ^ SHR10(x)
//   x = 0x80000000 icin:
//     ROTR17 = 0x00004000
//     ROTR19 = 0x00001000
//     SHR10  = 0x00200000
//     XOR    = 0x00205000
// ---------------------------------------------------------------------------
işlev t5_sha256_sigma1_low() -> tam32 {
    değişken x: sabitsüre<dtam32> = sabitsüre_olustur((0x80000000 olarak dtam32));
    eğer ifşa(_karma_sigma1_low(x)) == (0x00205000 olarak dtam32) { ver 1; }
    ver 0;
}

// ---------------------------------------------------------------------------
// T6: SHA-256 Sigma0 (Σ0) — ROTR2 ^ ROTR13 ^ ROTR22 (kaydirma yok, saf rotasyon).
//   x = 0x80000000: ROTR2=0x20000000, ROTR13=0x00040000, ROTR22=0x00000200
//   XOR = 0x20040200
// Rotasyonun ic `>>` dali yine isaretsiz olmali.
// ---------------------------------------------------------------------------
işlev t6_sha256_sigma0() -> tam32 {
    değişken x: sabitsüre<dtam32> = sabitsüre_olustur((0x80000000 olarak dtam32));
    eğer ifşa(_karma_sigma0(x)) == (0x20040200 olarak dtam32) { ver 1; }
    ver 0;
}

// ---------------------------------------------------------------------------
// T7: SHA-256("abc") TAM DIGEST — FIPS 180-4 Appendix B.1 (altin standart).
//   Blok: "abc" + 0x80 + sifir dolgu + uzunluk(24 bit) = tek 512-bit blok
//     W[0] = 0x61626380, W[1..14] = 0, W[15] = 24
//   Beklenen: BA7816BF 8F01CFEA 414140DE 5DAE2223
//             B00361A3 96177A9C B410FF61 F20015AD
// Sikistirmanin TAMAMI olculur: mesaj cizelgesi (sigma0_low/sigma1_low), 64 round
// (Sigma0/Sigma1/Ch/Maj), state toplama. Tek bir kaydirma hatasi digest'i bozar.
// ---------------------------------------------------------------------------
işlev t7_sha256_abc_digest() -> tam32 {
    değişken H: Dizi<dtam32> = sha256_H0();
    değişken st: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_olustur(H[0]), sabitsüre_olustur(H[1]),
        sabitsüre_olustur(H[2]), sabitsüre_olustur(H[3]),
        sabitsüre_olustur(H[4]), sabitsüre_olustur(H[5]),
        sabitsüre_olustur(H[6]), sabitsüre_olustur(H[7])
    ];
    değişken sifir: dtam32 = 0;
    değişken blok: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_olustur((0x61626380 olarak dtam32)),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur((24 olarak dtam32))
    ];
    değişken _r: tam32 = sha256_blok_sikistir(st, blok);
    değişken bek: Dizi<dtam32> = [
        0xBA7816BF, 0x8F01CFEA, 0x414140DE, 0x5DAE2223,
        0xB00361A3, 0x96177A9C, 0xB410FF61, 0xF20015AD
    ];
    değişken i: tam32 = 0;
    iken i < 8 {
        eğer ifşa(st[i]) != bek[i] { ver 0; }
        i = i + 1;
    }
    ver 1;
}

// ---------------------------------------------------------------------------
// T8: SHA-256("") TAM DIGEST — FIPS 180-4 (bos mesaj).
//   Blok: 0x80 + sifir dolgu + uzunluk(0)  →  W[0] = 0x80000000, gerisi 0
//   Beklenen: E3B0C442 98FC1C14 9AFBF4C8 996FB924
//             27AE41E4 649B934C A495991B 7852B855
// W[0] = 0x80000000 — YUKSEK BIT SET. sigma0_low/sigma1_low'daki `>>` ashr olsaydi
// mesaj cizelgesi ILK adimdan bozulurdu. Bu yuzden T7'ye ek deger tasir.
// ---------------------------------------------------------------------------
işlev t8_sha256_bos_digest() -> tam32 {
    değişken H: Dizi<dtam32> = sha256_H0();
    değişken st: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_olustur(H[0]), sabitsüre_olustur(H[1]),
        sabitsüre_olustur(H[2]), sabitsüre_olustur(H[3]),
        sabitsüre_olustur(H[4]), sabitsüre_olustur(H[5]),
        sabitsüre_olustur(H[6]), sabitsüre_olustur(H[7])
    ];
    değişken sifir: dtam32 = 0;
    değişken blok: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_olustur((0x80000000 olarak dtam32)),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir)
    ];
    değişken _r: tam32 = sha256_blok_sikistir(st, blok);
    değişken bek: Dizi<dtam32> = [
        0xE3B0C442, 0x98FC1C14, 0x9AFBF4C8, 0x996FB924,
        0x27AE41E4, 0x649B934C, 0xA495991B, 0x7852B855
    ];
    değişken i: tam32 = 0;
    iken i < 8 {
        eğer ifşa(st[i]) != bek[i] { ver 0; }
        i = i + 1;
    }
    ver 1;
}

// ---------------------------------------------------------------------------
// T9: ChaCha20 BLOK — RFC 8439 §2.3.2 (16 kelimenin tamami).
//   key   = 00 01 02 ... 1f  (little-endian kelimeler)
//   nonce = 00:00:00:09  00:00:00:4a  00:00:00:00
//   counter = 1
// 20 round (10 double round) + orijinal state toplama. Beklenen degerler bagimsiz
// bir referans implementasyonuyla uretildi ve RFC 8439 §2.4.2 sifreleme vektoruyle
// (ct[0:16] = 6e2e359a2568f98041ba0728dd0d6981) capraz dogrulandi.
// ---------------------------------------------------------------------------
işlev t9_chacha20_blok_rfc() -> tam32 {
    değişken key: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_olustur((0x03020100 olarak dtam32)),
        sabitsüre_olustur((0x07060504 olarak dtam32)),
        sabitsüre_olustur((0x0B0A0908 olarak dtam32)),
        sabitsüre_olustur((0x0F0E0D0C olarak dtam32)),
        sabitsüre_olustur((0x13121110 olarak dtam32)),
        sabitsüre_olustur((0x17161514 olarak dtam32)),
        sabitsüre_olustur((0x1B1A1918 olarak dtam32)),
        sabitsüre_olustur((0x1F1E1D1C olarak dtam32))
    ];
    değişken nonce: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_olustur((0x09000000 olarak dtam32)),
        sabitsüre_olustur((0x4A000000 olarak dtam32)),
        sabitsüre_olustur((0x00000000 olarak dtam32))
    ];
    değişken sifir: dtam32 = 0;
    değişken ks: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur(sifir), sabitsüre_olustur(sifir), sabitsüre_olustur(sifir),
        sabitsüre_olustur(sifir)
    ];
    değişken _r: tam32 = chacha20_blok(key, 1, nonce, ks);
    değişken bek: Dizi<dtam32> = [
        0xE4E7F110, 0x15593BD1, 0x1FDD0F50, 0xC47120A3,
        0xC7F4D1C7, 0x0368C033, 0x9AAA2204, 0x4E6CD4C3,
        0x466482D2, 0x09AA9F07, 0x05D7C214, 0xA2028BD9,
        0xD19C12B5, 0xB94E16DE, 0xE883D0CB, 0x4E3C50A2
    ];
    değişken i: tam32 = 0;
    iken i < 16 {
        eğer ifşa(ks[i]) != bek[i] { ver 0; }
        i = i + 1;
    }
    ver 1;
}

// ---------------------------------------------------------------------------
// T10: Poly1305 r-clamp — RFC 8439 §2.5.2 (16 baytin tamami).
//   r         = 85:d6:be:78:57:55:6d:33:7f:44:52:fe:42:d5:06:a8
//   clamp'li  = 85:d6:be:08:54:55:6d:03:7c:44:52:0e:40:d5:06:08
//   (little-endian tamsayi = 0x806d5400e52447c036d555408bed685 — RFC ile birebir)
//
// ⚠ NOT: test_kripto_vektor.kem'deki "clamp sonrasi" YORUMU YANLISTI
//   ("85:d6:be:78:57:55:6d:03:7f:44:52:0c:42:d5:06:08" — r[3]/r[4]/r[8]/r[12]
//   maskelenmemis, r[11] de yanlis). Hicbir sey o yorumu dogrulamadigi icin
//   fark edilmemisti. Buradaki degerler bagimsiz olarak hesaplandi ve RFC'nin
//   yayimladigi clamp'li tamsayiyla dogrulandi.
// ---------------------------------------------------------------------------
işlev t10_poly1305_r_clamp_rfc() -> tam32 {
    değişken r: Dizi<sabitsüre<dtam8>> = [
        sabitsüre_olustur((0x85 olarak dtam8)), sabitsüre_olustur((0xD6 olarak dtam8)),
        sabitsüre_olustur((0xBE olarak dtam8)), sabitsüre_olustur((0x78 olarak dtam8)),
        sabitsüre_olustur((0x57 olarak dtam8)), sabitsüre_olustur((0x55 olarak dtam8)),
        sabitsüre_olustur((0x6D olarak dtam8)), sabitsüre_olustur((0x33 olarak dtam8)),
        sabitsüre_olustur((0x7F olarak dtam8)), sabitsüre_olustur((0x44 olarak dtam8)),
        sabitsüre_olustur((0x52 olarak dtam8)), sabitsüre_olustur((0xFE olarak dtam8)),
        sabitsüre_olustur((0x42 olarak dtam8)), sabitsüre_olustur((0xD5 olarak dtam8)),
        sabitsüre_olustur((0x06 olarak dtam8)), sabitsüre_olustur((0xA8 olarak dtam8))
    ];
    değişken _r: tam32 = poly1305_r_clamp(r);
    değişken bek: Dizi<dtam8> = [
        0x85, 0xD6, 0xBE, 0x08, 0x54, 0x55, 0x6D, 0x03,
        0x7C, 0x44, 0x52, 0x0E, 0x40, 0xD5, 0x06, 0x08
    ];
    değişken i: tam32 = 0;
    iken i < 16 {
        eğer ifşa(r[i]) != bek[i] { ver 0; }
        i = i + 1;
    }
    ver 1;
}

// ---------------------------------------------------------------------------
// T11: SHA-256 sabitleri — FIPS 180-4 §4.2.2 / §5.3.3.
// H0[0]=0x6A09E667 (frac(sqrt(2))), K[0]=0x428A2F98, K[63]=0xC67178F2.
// Ucu de dtam32; sabit tablosunun bozulmadigini ucuza dogrular.
// ---------------------------------------------------------------------------
işlev t11_sha256_sabitler() -> tam32 {
    değişken H: Dizi<dtam32> = sha256_H0();
    değişken K: Dizi<dtam32> = sha256_K();
    eğer H[0] == (0x6A09E667 olarak dtam32) ve H[7] == (0x5BE0CD19 olarak dtam32)
      ve K[0] == (0x428A2F98 olarak dtam32) ve K[63] == (0xC67178F2 olarak dtam32) {
        ver 1;
    }
    ver 0;
}

işlev main() -> tam32 {
    ver t1_chacha_qr() + t2_rotr_yuksek_bit() + t3_rotl_yuksek_bit()
      + t4_sha256_sigma0_low() + t5_sha256_sigma1_low() + t6_sha256_sigma0()
      + t7_sha256_abc_digest() + t8_sha256_bos_digest()
      + t9_chacha20_blok_rfc() + t10_poly1305_r_clamp_rfc()
      + t11_sha256_sabitler();
}
