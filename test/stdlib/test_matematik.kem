// KEMGU Stdlib Testi — Matematik
// =================================
//
// Bu dosya `stdlib/temel/matematik.kem` ile birleştirilerek --check edilir.
// Her test bir kullanım senaryosunu doğrular; --check geçerse tip imzaları
// ve generic instantiation doğrudur.
//
// Makefile: `make calistir_stdlib_check`

// --- mutlak ---
işlev test_mutlak_pozitif() -> tam32 { ver mutlak(7); }
işlev test_mutlak_negatif() -> tam32 { ver mutlak(0 - 7); }
işlev test_mutlak_sifir() -> tam32 { ver mutlak(0); }

// --- en_kucuk / en_buyuk ---
işlev test_en_kucuk_a() -> tam32 { ver en_kucuk(3, 8); }
işlev test_en_kucuk_b() -> tam32 { ver en_kucuk(8, 3); }
işlev test_en_buyuk_a() -> tam32 { ver en_buyuk(3, 8); }
işlev test_en_buyuk_b() -> tam32 { ver en_buyuk(8, 3); }

// --- kare / kup ---
işlev test_kare() -> tam32 { ver kare(5); }
işlev test_kup() -> tam32 { ver kup(3); }

// --- sinirla ---
işlev test_sinirla_alt() -> tam32 { ver sinirla(0 - 5, 0, 10); }
işlev test_sinirla_ust() -> tam32 { ver sinirla(20, 0, 10); }
işlev test_sinirla_orta() -> tam32 { ver sinirla(5, 0, 10); }

// --- isaret ---
işlev test_isaret_pozitif() -> tam32 { ver isaret(42); }
işlev test_isaret_negatif() -> tam32 { ver isaret(0 - 42); }
işlev test_isaret_sifir() -> tam32 { ver isaret(0); }

// --- kuvvet ---
işlev test_kuvvet_2_10() -> tam32 { ver kuvvet(2, 10); }
işlev test_kuvvet_3_4() -> tam32 { ver kuvvet(3, 4); }
işlev test_kuvvet_5_0() -> tam32 { ver kuvvet(5, 0); }

// --- kok_tam ---
işlev test_kok_144() -> tam32 { ver kok_tam(144); }
işlev test_kok_2() -> tam32 { ver kok_tam(2); }
işlev test_kok_0() -> tam32 { ver kok_tam(0); }

// --- mod ---
işlev test_mod_17_5() -> tam32 { ver mod(17, 5); }
işlev test_mod_100_7() -> tam32 { ver mod(100, 7); }

// --- asal_mi ---
işlev test_asal_2() -> mantıksal { ver asal_mi(2); }
işlev test_asal_3() -> mantıksal { ver asal_mi(3); }
işlev test_asal_4() -> mantıksal { ver asal_mi(4); }
işlev test_asal_7() -> mantıksal { ver asal_mi(7); }
işlev test_asal_9() -> mantıksal { ver asal_mi(9); }
işlev test_asal_97() -> mantıksal { ver asal_mi(97); }

// --- fibonacci ---
işlev test_fibonacci_0() -> tam32 { ver fibonacci(0); }
işlev test_fibonacci_1() -> tam32 { ver fibonacci(1); }
işlev test_fibonacci_10() -> tam32 { ver fibonacci(10); }

// --- faktöriyel ---
işlev test_faktoriyel_0() -> tam32 { ver faktoriyel(0); }
işlev test_faktoriyel_1() -> tam32 { ver faktoriyel(1); }
işlev test_faktoriyel_5() -> tam32 { ver faktoriyel(5); }

// --- çift / tek ---
işlev test_cift_4() -> mantıksal { ver cift_mi(4); }
işlev test_cift_5() -> mantıksal { ver cift_mi(5); }
işlev test_tek_5() -> mantıksal { ver tek_mi(5); }
işlev test_tek_4() -> mantıksal { ver tek_mi(4); }

// --- negatif / pozitif / sifir ---
işlev test_negatif() -> mantıksal { ver negatif_mi(0 - 5); }
işlev test_pozitif() -> mantıksal { ver pozitif_mi(5); }
işlev test_sifir() -> mantıksal { ver sifir_mi(0); }

// --- iki_kat / yarisi ---
işlev test_iki_kat() -> tam32 { ver iki_kat(21); }
işlev test_yarisi() -> tam32 { ver yarisi(10); }

// --- Bileşik kullanım ---
işlev test_bilesik_a() -> tam32 {
    değişken x: tam32 = kare(kuvvet(2, 3));   // (2^3)^2 = 64
    ver x;
}

işlev test_bilesik_b() -> tam32 {
    değişken x: tam32 = mutlak(0 - kare(7));  // |-49| = 49
    ver sinirla(x, 0, 100);
}

işlev test_bilesik_c() -> mantıksal {
    ver asal_mi(faktoriyel(4) - 1);            // 24 - 1 = 23, asal
}

// =============================================================================
// Genişletme testleri — obeb_dizi/ekok_dizi/us_mod/kombinasyon/permutasyon/
// palindrom_mu. Hepsi skaler döner → bütün dosya --llvm | clang | run edilebilir.
// =============================================================================

// --- obeb_dizi / ekok_dizi ---
işlev test_obeb_dizi() -> tam32 {
    değişken d: Dizi<tam32> = [12, 18, 24];
    ver obeb_dizi(d);                  // 6
}
işlev test_obeb_dizi_tek() -> tam32 {
    değişken d: Dizi<tam32> = [7];
    ver obeb_dizi(d);                  // 7
}
işlev test_obeb_dizi_bos() -> tam32 {
    değişken d: Dizi<tam32> = [];
    ver obeb_dizi(d);                  // 0
}
işlev test_obeb_dizi_sifirli() -> tam32 {
    değişken d: Dizi<tam32> = [0, 5, 10];
    ver obeb_dizi(d);                  // 5
}
işlev test_ekok_dizi() -> tam32 {
    değişken d: Dizi<tam32> = [2, 3, 4];
    ver ekok_dizi(d);                  // 12
}
işlev test_ekok_dizi_bos() -> tam32 {
    değişken d: Dizi<tam32> = [];
    ver ekok_dizi(d);                  // 1
}
işlev test_ekok_dizi_sifirli() -> tam32 {
    değişken d: Dizi<tam32> = [5, 0, 3];
    ver ekok_dizi(d);                  // 0
}

// --- us_mod ---
işlev test_us_mod_2_10_1000() -> tam32 { ver us_mod(2, 10, 1000); }   // 1024 % 1000 = 24
işlev test_us_mod_3_4_5() -> tam32 { ver us_mod(3, 4, 5); }            // 81 % 5 = 1
işlev test_us_mod_7_2_10() -> tam32 { ver us_mod(7, 2, 10); }          // 49 % 10 = 9
işlev test_us_mod_sifir_us() -> tam32 { ver us_mod(5, 0, 7); }         // 1
işlev test_us_mod_mod1() -> tam32 { ver us_mod(2, 10, 1); }            // 0

// --- kombinasyon / permutasyon (tam64 -> tam32 cast) ---
işlev test_kombinasyon_10_3() -> tam32 { ver kombinasyon(10, 3) olarak tam32; }    // 120
işlev test_kombinasyon_5_2() -> tam32 { ver kombinasyon(5, 2) olarak tam32; }      // 10
işlev test_kombinasyon_n_0() -> tam32 { ver kombinasyon(6, 0) olarak tam32; }      // 1
işlev test_kombinasyon_n_n() -> tam32 { ver kombinasyon(5, 5) olarak tam32; }      // 1
işlev test_kombinasyon_k_buyuk() -> tam32 { ver kombinasyon(5, 6) olarak tam32; }  // 0
işlev test_permutasyon_5_2() -> tam32 { ver permutasyon(5, 2) olarak tam32; }      // 20
işlev test_permutasyon_6_3() -> tam32 { ver permutasyon(6, 3) olarak tam32; }      // 120
işlev test_permutasyon_n_0() -> tam32 { ver permutasyon(5, 0) olarak tam32; }      // 1

// --- palindrom_mu ---
işlev test_palindrom_121() -> mantıksal { ver palindrom_mu(121); }
işlev test_palindrom_123() -> mantıksal { ver palindrom_mu(123); }
işlev test_palindrom_0() -> mantıksal { ver palindrom_mu(0); }
işlev test_palindrom_1221() -> mantıksal { ver palindrom_mu(1221); }
işlev test_palindrom_negatif() -> mantıksal { ver palindrom_mu(0 - 5); }

// Sentinel sürücü: tüm genişletme kontrolleri geçerse 42, aksi halde ilk
// başarısız kontrolün indeksi (--llvm | clang | run ile execution-test).
işlev main() -> tam32 {
    eğer test_obeb_dizi() != 6 { ver 1; }
    eğer test_obeb_dizi_tek() != 7 { ver 2; }
    eğer test_obeb_dizi_bos() != 0 { ver 3; }
    eğer test_obeb_dizi_sifirli() != 5 { ver 4; }
    eğer test_ekok_dizi() != 12 { ver 5; }
    eğer test_ekok_dizi_bos() != 1 { ver 6; }
    eğer test_ekok_dizi_sifirli() != 0 { ver 7; }
    eğer test_us_mod_2_10_1000() != 24 { ver 8; }
    eğer test_us_mod_3_4_5() != 1 { ver 9; }
    eğer test_us_mod_7_2_10() != 9 { ver 10; }
    eğer test_us_mod_sifir_us() != 1 { ver 11; }
    eğer test_us_mod_mod1() != 0 { ver 12; }
    eğer test_kombinasyon_10_3() != 120 { ver 13; }
    eğer test_kombinasyon_5_2() != 10 { ver 14; }
    eğer test_kombinasyon_n_0() != 1 { ver 15; }
    eğer test_kombinasyon_n_n() != 1 { ver 16; }
    eğer test_kombinasyon_k_buyuk() != 0 { ver 17; }
    eğer test_permutasyon_5_2() != 20 { ver 18; }
    eğer test_permutasyon_6_3() != 120 { ver 19; }
    eğer test_permutasyon_n_0() != 1 { ver 20; }
    eğer değil test_palindrom_121() { ver 21; }
    eğer test_palindrom_123() { ver 22; }
    eğer değil test_palindrom_0() { ver 23; }
    eğer değil test_palindrom_1221() { ver 24; }
    eğer test_palindrom_negatif() { ver 25; }
    ver 42;
}
