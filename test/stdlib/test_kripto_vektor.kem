// KEMGU Stdlib Testi — Kripto NIST/RFC Test Vektörleri
// =======================================================
//
// Resmi test vektörlerinin KEMGU üzerinde derleme zamanı doğrulaması.
// `--check` çalışır; vektör değerleri sabit olarak gömülü, fonksiyon
// imzaları doğrulanır. Runtime karşılaştırma `kemgu --llvm` + native
// derleme sonrası mümkün (V2: bağımsız test_kripto_runtime.kem).
//
// Vektör kaynakları:
//   - SHA-256:    NIST FIPS 180-4, Appendix B (boş string, "abc")
//   - ChaCha20:   RFC 8439 §2.3.2 (test_vector_1)
//   - HKDF:       RFC 5869 Appendix A, Test Case 1
//   - Poly1305:   RFC 8439 §2.5.2
//
// Burada 8 ana vektör; her biri ayrı fonksiyon.

// ============================================================================
// V1: SHA-256 NIST Test Vektörleri
// ============================================================================

// V1.1: SHA-256("") = e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
//       Beklenen H0+padding sıkıştırma sonrası state[0] = 0xE3B0C442
işlev test_v1_sha256_bos_string_H0() -> dtam32 {
    değişken H: Dizi<dtam32> = sha256_H0();
    // İlk H0 değeri = 0x6A09E667
    ver H[0];
}

// V1.2: SHA-256 round constant K[0] = 0x428A2F98
işlev test_v1_sha256_K0() -> dtam32 {
    değişken K: Dizi<dtam32> = sha256_K();
    ver K[0];
}

// V1.3: SHA-256 K[63] = 0xC67178F2 (son round)
işlev test_v1_sha256_K63() -> dtam32 {
    değişken K: Dizi<dtam32> = sha256_K();
    ver K[63];
}

// V1.4: SHA-256 "abc" inputu — message block layout
//   M = "abc" || 0x80 || 0...0 || 0x00...0018 (24-bit length)
//   1-block compress sonrasi expected hash:
//   ba7816bf 8f01cfea 414140de 5dae2223 b00361a3 96177a9c b410ff61 f20015ad
işlev test_v1_sha256_abc_blok() -> tam32 {
    // 'a' = 0x61, 'b' = 0x62, 'c' = 0x63
    // Big-endian dtam32: 0x61626380 (abc + padding 0x80)
    değişken w0: dtam32 = 0x61626380;
    değişken sifir: dtam32 = 0;
    // L = 24 bit = 0x00000018 — 64-bit length BE'de son iki kelime
    değişken w15: dtam32 = 24;
    değişken blok: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_yarat(w0), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir),
        sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir),
        sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir),
        sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(w15)
    ];
    değişken H: Dizi<dtam32> = sha256_H0();
    değişken state: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_yarat(H[0]), sabitsüre_yarat(H[1]), sabitsüre_yarat(H[2]), sabitsüre_yarat(H[3]),
        sabitsüre_yarat(H[4]), sabitsüre_yarat(H[5]), sabitsüre_yarat(H[6]), sabitsüre_yarat(H[7])
    ];
    ver sha256_blok_sikistir(state, blok);
}

// ============================================================================
// V2: ChaCha20 RFC 8439 §2.3.2 Test Vector
// ============================================================================
//
// Key: 00:01:02:...:1f (32 byte 00..1F sequence)
// Nonce: 00:00:00:09:00:00:00:4a:00:00:00:00 (12 byte)
// Counter: 1
// Expected first block output: [10f1e7e4d13b5915500fdd1fa32071c4...]
//
// Burada init state oluştur; expected check runtime'da (V2).

// V2.1: ChaCha20 init constants — "expand 32-byte k" (LE encoded)
işlev test_v2_chacha20_constants() -> tam32 {
    // RFC 8439: state[0..3] = "expa" "nd 3" "2-by" "te k" LE
    değişken c0: dtam32 = 0x61707865;
    değişken c1: dtam32 = 0x3320646E;
    değişken c2: dtam32 = 0x79622D32;
    değişken c3: dtam32 = 0x6B206574;
    ver (c0 olarak tam32);  // tip kontrolü; runtime'da check
}

// V2.2: ChaCha20 — RFC 8439 anahtar yapısı
//   key[0..7] = 0x00010203 0x04050607 0x08090a0b ... 0x1c1d1e1f
işlev test_v2_chacha20_key_layout() -> tam32 {
    değişken k0: dtam32 = 0x03020100;  // LE: 0x00,0x01,0x02,0x03
    değişken k1: dtam32 = 0x07060504;
    değişken key: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_yarat(k0), sabitsüre_yarat(k1),
        sabitsüre_yarat((0x0B0A0908 olarak dtam32)),
        sabitsüre_yarat((0x0F0E0D0C olarak dtam32)),
        sabitsüre_yarat((0x13121110 olarak dtam32)),
        sabitsüre_yarat((0x17161514 olarak dtam32)),
        sabitsüre_yarat((0x1B1A1918 olarak dtam32)),
        sabitsüre_yarat((0x1F1E1D1C olarak dtam32))
    ];
    değişken nonce: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_yarat((0x00000000 olarak dtam32)),
        sabitsüre_yarat((0x4A000000 olarak dtam32)),
        sabitsüre_yarat((0x00000000 olarak dtam32))
    ];
    değişken sifir: dtam32 = 0;
    değişken ks: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir),
        sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir),
        sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir),
        sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir), sabitsüre_yarat(sifir)
    ];
    // counter=1 (RFC 8439 §2.3.2 önce bloku için)
    ver chacha20_blok(key, 1, nonce, ks);
}

// V2.3: ChaCha20 Quarter Round (RFC 8439 §2.1.1 vector)
//   Input: a=0x11111111, b=0x01020304, c=0x9b8d6f43, d=0x01234567
//   After QR: a=0xea2a92f4, b=0xcb1cf8ce, c=0x4581472e, d=0x5881c4bb
işlev test_v2_chacha_qr_rfc_vector() -> tam32 {
    değişken s: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_yarat((0x11111111 olarak dtam32)),
        sabitsüre_yarat((0x01020304 olarak dtam32)),
        sabitsüre_yarat((0x9B8D6F43 olarak dtam32)),
        sabitsüre_yarat((0x01234567 olarak dtam32))
    ];
    ver chacha20_qr(s, 0, 1, 2, 3);
    // Runtime'da: s[0] == 0xEA2A92F4 vb. (--llvm + clang + run)
}

// ============================================================================
// V3: HKDF RFC 5869 Appendix A, Test Case 1
// ============================================================================
//
// IKM:  0x0b 0x0b 0x0b ... (22 byte 0x0B)
// salt: 0x00 0x01 0x02 ... 0x0c (13 byte)
// info: 0xf0 0xf1 0xf2 ... 0xf9 (10 byte)
// L:    42
// Expected PRK: 0x077709362c2e32df0ddc3f0dc47bba63...
// Expected OKM: 0x3cb25f25faacd57a90434f64d0362f2a...

// V3.1: HKDF input layout — IKM 22 byte 0x0B
işlev test_v3_hkdf_ikm_layout() -> tam32 {
    değişken b: dtam8 = 0x0B;
    değişken ikm: Dizi<sabitsüre<dtam8>> = [
        sabitsüre_yarat(b), sabitsüre_yarat(b), sabitsüre_yarat(b), sabitsüre_yarat(b),
        sabitsüre_yarat(b), sabitsüre_yarat(b), sabitsüre_yarat(b), sabitsüre_yarat(b),
        sabitsüre_yarat(b), sabitsüre_yarat(b), sabitsüre_yarat(b), sabitsüre_yarat(b),
        sabitsüre_yarat(b), sabitsüre_yarat(b), sabitsüre_yarat(b), sabitsüre_yarat(b),
        sabitsüre_yarat(b), sabitsüre_yarat(b), sabitsüre_yarat(b), sabitsüre_yarat(b),
        sabitsüre_yarat(b), sabitsüre_yarat(b)
    ];
    değişken s: dtam8 = 0;
    değişken prk: Dizi<sabitsüre<dtam8>> = [
        sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s),
        sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s),
        sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s),
        sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s),
        sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s),
        sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s),
        sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s),
        sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s), sabitsüre_yarat(s)
    ];
    değişken salt: Dizi<sabitsüre<dtam8>> = [
        sabitsüre_yarat((0x00 olarak dtam8)),
        sabitsüre_yarat((0x01 olarak dtam8)),
        sabitsüre_yarat((0x02 olarak dtam8)),
        sabitsüre_yarat((0x03 olarak dtam8)),
        sabitsüre_yarat((0x04 olarak dtam8)),
        sabitsüre_yarat((0x05 olarak dtam8)),
        sabitsüre_yarat((0x06 olarak dtam8)),
        sabitsüre_yarat((0x07 olarak dtam8)),
        sabitsüre_yarat((0x08 olarak dtam8)),
        sabitsüre_yarat((0x09 olarak dtam8)),
        sabitsüre_yarat((0x0A olarak dtam8)),
        sabitsüre_yarat((0x0B olarak dtam8)),
        sabitsüre_yarat((0x0C olarak dtam8))
    ];
    ver hkdf_extract(salt, 13, ikm, 22, prk);
}

// V3.2: HKDF info — RFC 5869 Test Case 1 info layout
işlev test_v3_hkdf_info_layout() -> sabitsüre<dtam8> {
    değişken info: Dizi<sabitsüre<dtam8>> = [
        sabitsüre_yarat((0xF0 olarak dtam8)),
        sabitsüre_yarat((0xF1 olarak dtam8)),
        sabitsüre_yarat((0xF2 olarak dtam8)),
        sabitsüre_yarat((0xF3 olarak dtam8)),
        sabitsüre_yarat((0xF4 olarak dtam8)),
        sabitsüre_yarat((0xF5 olarak dtam8)),
        sabitsüre_yarat((0xF6 olarak dtam8)),
        sabitsüre_yarat((0xF7 olarak dtam8)),
        sabitsüre_yarat((0xF8 olarak dtam8)),
        sabitsüre_yarat((0xF9 olarak dtam8))
    ];
    ver info[0];  // 0xF0 beklenir
}

// ============================================================================
// V4: Poly1305 r-clamp test vector (RFC 8439 §2.5.2)
// ============================================================================
//
// r before clamp: 85:d6:be:78:57:55:6d:33:7f:44:52:fe:42:d5:06:a8
// r after clamp:  85:d6:be:78:57:55:6d:03:7f:44:52:0c:42:d5:06:08

işlev test_v4_poly1305_r_clamp() -> tam32 {
    değişken r: Dizi<sabitsüre<dtam8>> = [
        sabitsüre_yarat((0x85 olarak dtam8)),
        sabitsüre_yarat((0xD6 olarak dtam8)),
        sabitsüre_yarat((0xBE olarak dtam8)),
        sabitsüre_yarat((0x78 olarak dtam8)),  // -> 0x78 (& 0x0F = 0x08? hayır 0x78 & 0x0F = 0x08; 0x78 & 0xFC = 0x78)
        sabitsüre_yarat((0x57 olarak dtam8)),
        sabitsüre_yarat((0x55 olarak dtam8)),
        sabitsüre_yarat((0x6D olarak dtam8)),
        sabitsüre_yarat((0x33 olarak dtam8)),  // -> 0x33 & 0x0F = 0x03
        sabitsüre_yarat((0x7F olarak dtam8)),
        sabitsüre_yarat((0x44 olarak dtam8)),
        sabitsüre_yarat((0x52 olarak dtam8)),
        sabitsüre_yarat((0xFE olarak dtam8)),  // -> 0xFE & 0x0F = 0x0E (yanlış doc; aslında 0x0E olur)
        sabitsüre_yarat((0x42 olarak dtam8)),
        sabitsüre_yarat((0xD5 olarak dtam8)),
        sabitsüre_yarat((0x06 olarak dtam8)),
        sabitsüre_yarat((0xA8 olarak dtam8))
    ];
    ver poly1305_r_clamp(r);
}
