// KEMGU Stdlib Testi — Sayısal (istatistik)
// =================================================
//
// Bu dosya `stdlib/temel/sayisal.kem` ile birleştirilerek --check edilir.
// İstatistik fonksiyonları Dizi<tam32> üzerinde; seçimlik dönüşler eşleş ile
// açılır.

// seçimlik<tam32> -> tam32 (yardımcı; hiç ise varsayılan).
işlev coz(o: seçimlik<tam32>, varsayilan: tam32) -> tam32 {
    eşleş o {
        değer(v) => { ver v; }
        hiç => { ver varsayilan; }
    }
    ver varsayilan;
}

// --- mevcut generic ortalama/us/obe/ekok (regresyon) ---
işlev test_ortalama_iki() -> tam32 {
    ver ortalama(10, 20);   // 15
}

işlev test_obe() -> tam32 {
    ver obe(48, 36);        // 12
}

işlev test_ekok() -> tam32 {
    ver ekok(4, 6);         // 12
}

// --- dizi_toplam / dizi_say / dizi_ortalama ---
işlev test_dizi_toplam() -> tam32 {
    değişken d: Dizi<tam32> = [2, 4, 6, 8];
    ver dizi_toplam(d);     // 20
}

işlev test_dizi_say() -> tam32 {
    değişken d: Dizi<tam32> = [1, 2, 3];
    ver dizi_say(d);        // 3
}

işlev test_dizi_ortalama() -> tam32 {
    değişken d: Dizi<tam32> = [2, 4, 6];
    ver dizi_ortalama(d);   // 4
}

işlev test_dizi_ortalama_bos() -> tam32 {
    değişken d: Dizi<tam32> = [];
    ver dizi_ortalama(d);   // 0 (boş)
}

// --- dizi_min / dizi_maks ---
işlev test_dizi_min() -> tam32 {
    değişken d: Dizi<tam32> = [5, 3, 8, 1, 9];
    ver coz(dizi_min(d), 0 - 1);   // 1
}

işlev test_dizi_maks() -> tam32 {
    değişken d: Dizi<tam32> = [5, 3, 8, 1, 9];
    ver coz(dizi_maks(d), 0 - 1);  // 9
}

işlev test_dizi_min_bos() -> tam32 {
    değişken d: Dizi<tam32> = [];
    ver coz(dizi_min(d), 7);       // hiç -> 7
}

// --- varyans / std_sapma / karekok / dizi_aralik ---
işlev test_varyans() -> tam32 {
    değişken d: Dizi<tam32> = [2, 4, 6];
    ver varyans(d);                // 8/3 = 2
}

işlev test_std_sapma() -> tam32 {
    değişken d: Dizi<tam32> = [2, 4, 6];
    ver std_sapma(d);              // karekok(2) = 1
}

işlev test_karekok() -> tam32 {
    ver karekok(144);              // 12
}

işlev test_karekok_kucuk() -> tam32 {
    ver karekok(1);                // 1
}

işlev test_dizi_aralik() -> tam32 {
    değişken d: Dizi<tam32> = [5, 3, 8, 1, 9];
    ver dizi_aralik(d);            // 9 - 1 = 8
}

// --- medyan ---
işlev test_medyan_tek() -> tam32 {
    ver coz(medyan([3, 1, 2, 5, 4]), 0 - 1);   // 3
}

işlev test_medyan_cift() -> tam32 {
    ver coz(medyan([1, 2, 3, 4]), 0 - 1);       // (2+3)/2 = 2
}

işlev test_medyan_bos() -> tam32 {
    değişken d: Dizi<tam32> = [];
    ver coz(medyan(d), 7);                       // hiç -> 7
}

// --- en_sik (mod / tepe değer) ---
işlev test_en_sik() -> tam32 {
    ver coz(en_sik([1, 2, 2, 3, 2, 1]), 0 - 1); // 2
}

işlev test_en_sik_bos() -> tam32 {
    değişken d: Dizi<tam32> = [];
    ver coz(en_sik(d), 7);                       // hiç -> 7
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;
    // Beklentilerin TAMAMI kaynaktaki yorumlardan alındı — uydurulmadı.
    eğer test_ortalama_iki()      != 15 { yazdir_metin("S: ortalama_iki"); h = h + 1; }
    eğer test_obe()               != 12 { yazdir_metin("S: obe"); h = h + 1; }
    eğer test_ekok()              != 12 { yazdir_metin("S: ekok"); h = h + 1; }
    eğer test_dizi_toplam()       != 20 { yazdir_metin("S: dizi_toplam"); h = h + 1; }
    eğer test_dizi_say()          != 3  { yazdir_metin("S: dizi_say"); h = h + 1; }
    eğer test_dizi_ortalama()     != 4  { yazdir_metin("S: dizi_ortalama"); h = h + 1; }
    eğer test_dizi_ortalama_bos() != 0  { yazdir_metin("S: dizi_ortalama_bos"); h = h + 1; }
    eğer test_dizi_min()          != 1  { yazdir_metin("S: dizi_min"); h = h + 1; }
    eğer test_dizi_maks()         != 9  { yazdir_metin("S: dizi_maks"); h = h + 1; }
    eğer test_dizi_min_bos()      != 7  { yazdir_metin("S: dizi_min_bos"); h = h + 1; }
    eğer test_varyans()           != 2  { yazdir_metin("S: varyans"); h = h + 1; }
    eğer test_std_sapma()         != 1  { yazdir_metin("S: std_sapma"); h = h + 1; }
    eğer test_karekok()           != 12 { yazdir_metin("S: karekok"); h = h + 1; }
    eğer test_karekok_kucuk()     != 1  { yazdir_metin("S: karekok_kucuk"); h = h + 1; }
    eğer test_dizi_aralik()       != 8  { yazdir_metin("S: dizi_aralik"); h = h + 1; }
    eğer test_medyan_tek()        != 3  { yazdir_metin("S: medyan_tek"); h = h + 1; }
    eğer test_medyan_cift()       != 2  { yazdir_metin("S: medyan_cift"); h = h + 1; }
    eğer test_medyan_bos()        != 7  { yazdir_metin("S: medyan_bos"); h = h + 1; }
    eğer test_en_sik()            != 2  { yazdir_metin("S: en_sik"); h = h + 1; }
    eğer test_en_sik_bos()        != 7  { yazdir_metin("S: en_sik_bos"); h = h + 1; }
    eğer h == 0 { yazdir_metin("sayisal: TUM TESTLER GECTI"); ver 0; }
    yazdir_metin("sayisal: BASARISIZ");
    ver 1;
}
