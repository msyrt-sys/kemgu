// KEMGU Stdlib Testi — JSON yazıcı
// =============================================================================
// Bu dosya `stdlib/json.kem` ile BİRLEŞTİRİLEREK derlenir.
//
// ⚠ TİP KONTROLÜ YETMEZ — bu modülü yazarken iki kusur YALNIZ ÇALIŞTIRINCA
// çıktı ve `--check` ikisini de TEMİZ geçmişti:
//   1. `metin_kes` 0-TABANLI (1-tabanlı sanmıştım) → her dizginin İLK
//      KARAKTERİ düşüyordu: `"iki"` → `"ki"`, anahtar `ad` → `d`.
//   2. `metin_bayt` `tam8` döner, `tam32` değil (bunu --check yakaladı).
// Bu yüzden test exit koduyla DAVRANIŞ ölçer, yalnız derlenmeyi değil.
//
// Beklenen çıktı (satır satır):
//   null / true / -4207 / "a\\\"b" / [1,"iki"] / {"ad":"ölç"}
// `"a\"b"` KEMGU'da 4 karakterdir (kaçış YOK): a \ " b
// → JSON kaçışı: a + \\ + \" + b

işlev json_test_esit(beklenen: metin, gercek: metin, kod: tam32) -> tam32 {
    eğer metin_esit(beklenen, gercek) { ver 0; }
    yazdir_metin("BEKLENEN:");
    yazdir_metin(beklenen);
    yazdir_metin("GERCEK  :");
    yazdir_metin(gercek);
    ver kod;
}

işlev main() -> tam32 {
    değişken h: tam32 = 0;

    h = h + json_test_esit("null", yaz(JsonDeger::Bos), 1);
    h = h + json_test_esit("true", yaz(JsonDeger::Mantik(doğru)), 2);
    h = h + json_test_esit("false", yaz(JsonDeger::Mantik(yanlış)), 4);
    h = h + json_test_esit("0", yaz(JsonDeger::Sayi(0)), 8);
    h = h + json_test_esit("-4207", yaz(JsonDeger::Sayi(0 - 4207)), 16);

    // Kaçış: kaynak `a\"b` (4 karakter) → JSON `"a\\\"b"`
    değişken bekk: metin = metin_birlestir(tirnak(), "a");
    bekk = metin_birlestir(bekk, ters_bolu());
    bekk = metin_birlestir(bekk, ters_bolu());
    bekk = metin_birlestir(bekk, ters_bolu());
    bekk = metin_birlestir(bekk, tirnak());
    bekk = metin_birlestir(bekk, "b");
    bekk = metin_birlestir(bekk, tirnak());
    h = h + json_test_esit(bekk, yaz(JsonDeger::Metin("a\"b")), 32);

    // Dizi — ilk karakter düşme kusurunun ASIL yakalandığı yer
    değişken d: Dizi<JsonDeger> = [];
    dizi_ekle(d, JsonDeger::Sayi(1));
    dizi_ekle(d, JsonDeger::Metin("iki"));
    değişken bekd: metin = metin_birlestir("[1,", tirnak());
    bekd = metin_birlestir(bekd, "iki");
    bekd = metin_birlestir(bekd, tirnak());
    bekd = metin_birlestir(bekd, "]");
    h = h + json_test_esit(bekd, yaz(JsonDeger::Dizi(d)), 64);

    // Nesne + TÜRKÇE UTF-8 (çok baytlı karakter aynen geçmeli)
    değişken ks: Dizi<metin> = [];
    dizi_ekle(ks, "ad");
    değişken vs: Dizi<JsonDeger> = [];
    dizi_ekle(vs, JsonDeger::Metin("ölç"));
    değişken bekn: metin = metin_birlestir("{", tirnak());
    bekn = metin_birlestir(bekn, "ad");
    bekn = metin_birlestir(bekn, tirnak());
    bekn = metin_birlestir(bekn, ":");
    bekn = metin_birlestir(bekn, tirnak());
    bekn = metin_birlestir(bekn, "ölç");
    bekn = metin_birlestir(bekn, tirnak());
    bekn = metin_birlestir(bekn, "}");
    h = h + json_test_esit(bekn, yaz(JsonDeger::Nesne(ks, vs)), 128);

    // Boş dizi / boş nesne
    değişken bd: Dizi<JsonDeger> = [];
    h = h + json_test_esit("[]", yaz(JsonDeger::Dizi(bd)), 256);

    // ---------------------------------------------------------------------
    // AYRIŞTIRICI (D-436)
    // ⚠ Test GİRDİLERİ `tirnak()` ile kurulur: KEMGU dizgi literalinde kaçış
    // YOKTUR, yani `"{\"a\":1}"` kaynakta GERÇEK ters-bölü içerir ve ayrıştırıcı
    // haklı olarak reddeder. İlk denememde tam bu yüzden sahte bir başarısızlık
    // aldım — kusur testteydi, ayrıştırıcıda değil.
    // ---------------------------------------------------------------------
    h = h + json_ayristir_esit("null", 512);
    h = h + json_ayristir_esit("true", 1024);
    h = h + json_ayristir_esit("-4207", 2048);
    h = h + json_ayristir_esit("[1,2,[3]]", 4096);
    h = h + json_ayristir_esit("[]", 8192);
    h = h + json_ayristir_esit("{}", 16384);

    // Boşluk toleransı: girdi boşluklu, ÇIKTI sıkışık olmalı
    değişken t2: metin = tirnak();
    değişken bosluklu: metin = metin_birlestir("[ 1 , ", metin_birlestir(t2, "x"));
    bosluklu = metin_birlestir(bosluklu, t2);
    bosluklu = metin_birlestir(bosluklu, " ]");
    h = h + json_ayristir_beklenen(bosluklu,
            metin_birlestir("[1,", metin_birlestir(t2, metin_birlestir("x", metin_birlestir(t2, "]")))),
            32768);

    // Nesne + TÜRKÇE UTF-8 round-trip
    değişken nes: metin = metin_birlestir("{", t2);
    nes = metin_birlestir(nes, "ad"); nes = metin_birlestir(nes, t2);
    nes = metin_birlestir(nes, ":"); nes = metin_birlestir(nes, t2);
    nes = metin_birlestir(nes, "ölç"); nes = metin_birlestir(nes, t2);
    nes = metin_birlestir(nes, "}");
    h = h + json_ayristir_esit(nes, 65536);

    // HATA yollari — panik YOK, sonuç<> ile
    h = h + json_ayristir_hata_mi("[1,2", 131072);
    h = h + json_ayristir_hata_mi("1 2", 262144);
    h = h + json_ayristir_hata_mi("{1:2}", 524288);
    h = h + json_ayristir_hata_mi("", 1048576);

    // ---------------------------------------------------------------------
    // ERİŞİMCİLER (D-437) — bu blok bir DERLEYİCİ KUSURU açığa çıkarmıştı:
    // çeşit payload'ından gelen `Dizi<metin>`den eleman okumak SEGFAULT
    // veriyordu (yanlış erişimci soneki: `_tam` yerine `_ptr` olmalıydı).
    // Kusur hem `src/llvm.c` hem `selfhost/codegen.kem`de onarıldı.
    // ---------------------------------------------------------------------
    değişken t3: metin = tirnak();
    değişken og: metin = metin_birlestir("{", t3);
    og = metin_birlestir(og, "ad"); og = metin_birlestir(og, t3);
    og = metin_birlestir(og, ":"); og = metin_birlestir(og, t3);
    og = metin_birlestir(og, "ölç"); og = metin_birlestir(og, t3);
    og = metin_birlestir(og, ","); og = metin_birlestir(og, t3);
    og = metin_birlestir(og, "xs"); og = metin_birlestir(og, t3);
    og = metin_birlestir(og, ":[10,20]}");
    eşleş json_ayristir(og) {
        hata(m) => { yazdir_metin("erisimci: ayristirma HATASI"); h = h + 1; }
        tamam(v) => {
            // anahtar → metin (SEGFAULT veren yol)
            eşleş json_alan(v, "ad") {
                değer(a) => {
                    eşleş json_metin_al(a) {
                        değer(s) => { h = h + json_test_esit("ölç", s, 1); }
                        hiç => { yazdir_metin("ad: tip yanlis"); h = h + 1; }
                    }
                }
                hiç => { yazdir_metin("ad: alan YOK"); h = h + 1; }
            }
            // olmayan anahtar → hiç
            eşleş json_alan(v, "yokboyle") {
                değer(a) => { yazdir_metin("olmayan anahtar KABUL EDILDI"); h = h + 1; }
                hiç => { }
            }
            // dizi uzunluğu + ARALIK DIŞI indeks (panik ETMEMELİ)
            eşleş json_alan(v, "xs") {
                değer(xs) => {
                    eğer json_uzunluk(xs) != 2 { yazdir_metin("uzunluk yanlis"); h = h + 1; }
                    eşleş json_indeks(xs, 9) {
                        değer(e) => { yazdir_metin("aralik disi KABUL EDILDI"); h = h + 1; }
                        hiç => { }
                    }
                    eşleş json_indeks(xs, 1) {
                        değer(e) => {
                            eşleş json_sayi_al(e) {
                                değer(n) => { eğer n != 20 { yazdir_metin("idx1 yanlis"); h = h + 1; } }
                                hiç => { yazdir_metin("idx1 sayi degil"); h = h + 1; }
                            }
                        }
                        hiç => { yazdir_metin("idx1 YOK"); h = h + 1; }
                    }
                }
                hiç => { yazdir_metin("xs YOK"); h = h + 1; }
            }
        }
    }

    eğer h == 0 { yazdir_metin("json: TUM TESTLER GECTI"); ver 0; }
    // ⚠ ÇIKIŞ KODU 8 BİTE MASKELENİR. `h`'yi doğrudan döndürmek ölümcül bir
    // kapı zayıflığıydı: 262144 = 0x40000 → düşük bayt 0 → BAŞARISIZLIK
    // "geçti" gibi görünüyordu (sabotaj S19 bunu ortaya çıkardı: mesaj
    // basıldı ama kapı yeşil kaldı). Bayrak toplamı yalnız TEŞHİS içindir;
    // kapıya giden değer 1'e sıkıştırılır.
    yazdir_metin("json: BASARISIZ");
    ver 1;
}

// ROUND-TRIP: yaz(ayristir(x)) == x  (kanonik girdi icin)
işlev json_ayristir_esit(g: metin, kod: tam32) -> tam32 {
    ver json_ayristir_beklenen(g, g, kod);
}

işlev json_ayristir_beklenen(g: metin, beklenen: metin, kod: tam32) -> tam32 {
    eşleş json_ayristir(g) {
        tamam(v) => { ver json_test_esit(beklenen, yaz(v), kod); }
        hata(m) => {
            yazdir_metin(metin_birlestir("AYRISTIRMA HATASI: ", m));
            yazdir_metin(g);
            ver kod;
        }
    }
    ver kod;
}

// Gecersiz girdi HATA dondurmeli (panik DEGIL, sessiz kabul DEGIL).
işlev json_ayristir_hata_mi(g: metin, kod: tam32) -> tam32 {
    eşleş json_ayristir(g) {
        tamam(v) => {
            yazdir_metin("HATA BEKLENIYORDU ama kabul edildi:");
            yazdir_metin(g);
            ver kod;
        }
        hata(m) => { ver 0; }
    }
    ver kod;
}
