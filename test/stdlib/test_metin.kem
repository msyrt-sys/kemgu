// KEMGU Stdlib Testi — Metin
// =================================
//
// Bu dosya `stdlib/metin.kem` ile birleştirilerek --check edilir.
// Runtime primitifi olmayan ops için stub davranışı test edilir.

// --- esit_mi / farkli_mi (gerçek davranış) ---
işlev test_esit_evet() -> mantıksal {
    ver esit_mi("merhaba", "merhaba");
}

işlev test_esit_hayir() -> mantıksal {
    ver esit_mi("a", "b");
}

işlev test_farkli_evet() -> mantıksal {
    ver farkli_mi("a", "b");
}

işlev test_farkli_hayir() -> mantıksal {
    ver farkli_mi("a", "a");
}

// --- bos_mu / dolu_mu ---
işlev test_bos_evet() -> mantıksal {
    ver bos_mu("");
}

işlev test_bos_hayir() -> mantıksal {
    ver bos_mu("merhaba");
}

işlev test_dolu_evet() -> mantıksal {
    ver dolu_mu("x");
}

işlev test_dolu_hayir() -> mantıksal {
    ver dolu_mu("");
}

// --- sarmala ---
işlev test_sarmala_dolu() -> mantıksal {
    değişken o: seçimlik<metin> = sarmala("dolu");
    eşleş o {
        değer(v) => { ver doğru; }
        hiç => { ver yanlış; }
    }
    ver yanlış;
}

işlev test_sarmala_bos() -> mantıksal {
    değişken o: seçimlik<metin> = sarmala("");
    eşleş o {
        değer(v) => { ver yanlış; }
        hiç => { ver doğru; }
    }
    ver yanlış;
}

// --- uzunluk (stub — şu an her zaman 0) ---
işlev test_uzunluk_imza() -> tam32 {
    ver uzunluk("merhaba");   // STUB: 0
}

işlev test_uzunluk_bos() -> tam32 {
    ver uzunluk("");           // 0
}

// --- birlestir (stub) ---
işlev test_birlestir_imza() -> metin {
    ver birlestir("merhaba", " dünya");
}

işlev test_birlestir_bos_solda() -> mantıksal {
    değişken s: metin = birlestir("", "b");
    ver esit_mi(s, "b");
}

işlev test_birlestir_bos_sagda() -> mantıksal {
    değişken s: metin = birlestir("a", "");
    ver esit_mi(s, "a");
}

işlev test_birlestir_uc() -> metin {
    ver birlestir_uc("a", "b", "c");
}

// --- kes (stub) ---
işlev test_kes_imza() -> metin {
    ver kes("merhaba", 0, 4);
}

işlev test_kes_bos() -> mantıksal {
    ver esit_mi(kes("", 0, 5), "");
}

// ⚠ D-440: bu test YANLIŞ bir zihinsel modele dayanıyordu. `kes`in üçüncü
// argümanı UZUNLUK'tur, aralık SONU değil — yani `kes("merhaba", 5, 2)`
// "ters aralık" DEĞİL, 5. bayttan 2 baytlık geçerli bir dilimdir → "ba".
// Test hiç koşmadığı için yanlışlığı görünmüyordu.
işlev test_kes_uzunluk_semantigi() -> mantıksal {
    ver esit_mi(kes("merhaba", 5, 2), "ba");
}

// Sondan taşan uzunluk: mevcut olan kadarını verir, panik ETMEZ.
işlev test_kes_uzunluk_tasan() -> mantıksal {
    ver esit_mi(kes("merhaba", 5, 99), "ba");
}

// --- bol (stub) ---
işlev test_bol_imza() -> tam32 {
    değişken parcalar: Dizi<metin> = bol("merhaba", ',');
    değişken n: tam32 = 0;
    için p: parcalar { n = n + 1; }
    ver n;
}

işlev test_bol_bos() -> tam32 {
    değişken parcalar: Dizi<metin> = bol("", ',');
    değişken n: tam32 = 0;
    için p: parcalar { n = n + 1; }
    ver n;
}

// --- kucukharf / buyukharf (stub) ---
işlev test_kucukharf_imza() -> metin {
    ver kucukharf("MERHABA");
}

işlev test_buyukharf_imza() -> metin {
    ver buyukharf("merhaba");
}

// --- icerir (stub) ---
işlev test_icerir_kendisi() -> mantıksal {
    ver icerir("merhaba", "merhaba");
}

işlev test_icerir_bos_alt() -> mantıksal {
    ver icerir("merhaba", "");
}

// --- baslar_ile / biter_ile (stub) ---
işlev test_baslar_ile_kendisi() -> mantıksal {
    ver baslar_ile("merhaba", "merhaba");
}

işlev test_baslar_ile_bos() -> mantıksal {
    ver baslar_ile("merhaba", "");
}

işlev test_biter_ile_kendisi() -> mantıksal {
    ver biter_ile("merhaba", "merhaba");
}

işlev test_biter_ile_bos() -> mantıksal {
    ver biter_ile("merhaba", "");
}

// --- kirp / tekrarla / yansit / yer_degistir / karakter_sayisi (stub) ---
işlev test_kirp_imza() -> metin {
    ver kirp("  merhaba  ");
}

işlev test_tekrarla_imza() -> metin {
    ver tekrarla("ab", 3);
}

işlev test_tekrarla_sifir() -> mantıksal {
    ver esit_mi(tekrarla("ab", 0), "");
}

işlev test_yansit_imza() -> metin {
    ver yansit("merhaba");
}

işlev test_yer_degistir_imza() -> metin {
    ver yer_degistir("merhaba dünya", "dünya", "evren");
}

işlev test_yer_degistir_tam_esit() -> mantıksal {
    ver esit_mi(yer_degistir("ab", "ab", "cd"), "cd");
}

işlev test_karakter_sayisi() -> tam32 {
    ver karakter_sayisi("merhaba");
}

// --- Bileşik kullanım (stub davranışı boyunca tip akışı doğru) ---
işlev test_bilesik() -> mantıksal {
    değişken s: metin = birlestir("mer", "haba");
    ver dolu_mu(s);
}

// =============================================================================
// Genişletme testleri — gerçek bol_metin/yansit/karakter_sayisi + arama/dolgu
// =============================================================================
//
// Runtime ile hesaplanan metinler `metin_esit` (byte karşılaştırma) ile
// doğrulanır — `==`/`esit_mi` literal/pointer eşitliği olduğundan hesaplanan
// metinlerde güvenilmez. Dizi<metin> elemanları sayılır (modülün `uzunluk`'u
// metin byte uzunluğudur, dizi uzunluğu değil).

işlev metin_es(a: metin, b: metin) -> mantıksal { ver metin_esit(a, b); }

işlev dizi_metin_say(xs: Dizi<metin>) -> tam32 {
    değişken n: tam32 = 0;
    için p: xs {
        n = n + 1;
    }
    ver n;
}

// --- yansit (codepoint-aware reverse) ---
işlev test_yansit_ascii() -> mantıksal {
    ver metin_es(yansit("abc"), "cba");
}

işlev test_yansit_utf8() -> mantıksal {
    ver metin_es(yansit("açb"), "bça");   // UTF-8 codepoint güvenli
}

işlev test_yansit_bos() -> mantıksal {
    ver metin_es(yansit(""), "");
}

// --- karakter_sayisi (codepoint count) ---
işlev test_karakter_sayisi_ascii() -> tam32 {
    ver karakter_sayisi("merhaba");        // 7
}

işlev test_karakter_sayisi_utf8() -> tam32 {
    ver karakter_sayisi("çığ");            // 6 byte ama 3 karakter
}

işlev test_cp_bayt_sayisi_ascii() -> tam32 {
    ver cp_bayt_sayisi(65);                // 1
}

işlev test_cp_bayt_sayisi_iki() -> tam32 {
    ver cp_bayt_sayisi(195);               // 0xC3 -> 2
}

// --- bol_metin (split) + birlestir_liste (join) ---
işlev test_bol_metin_uc() -> tam32 {
    ver dizi_metin_say(bol_metin("a,b,c", ","));      // 3
}

işlev test_bol_metin_bos_parca() -> tam32 {
    ver dizi_metin_say(bol_metin("a,,b", ","));       // 3 (orta boş)
}

işlev test_bol_metin_ayrac_yok() -> tam32 {
    ver dizi_metin_say(bol_metin("xyz", ","));        // 1
}

işlev test_bol_metin_bos_kaynak() -> tam32 {
    ver dizi_metin_say(bol_metin("", ","));           // 0
}

işlev test_bol_join_round_trip() -> mantıksal {
    ver metin_es(birlestir_liste(bol_metin("a,b,c", ","), "-"), "a-b-c");
}

işlev test_birlestir_liste_bos() -> mantıksal {
    değişken bos: Dizi<metin> = dizi_olustur(0);
    ver metin_es(birlestir_liste(bos, ","), "");
}

// --- indeks (substring konumu, seçimlik) ---
işlev test_indeks_var() -> tam32 {
    eşleş indeks("merhaba", "hab") {
        değer(v) => { ver v; }            // 3
        hiç => { ver 0 - 1; }
    }
    ver 0 - 1;
}

işlev test_indeks_yok() -> mantıksal {
    eşleş indeks("merhaba", "xyz") {
        değer(v) => { ver yanlış; }
        hiç => { ver doğru; }
    }
    ver yanlış;
}

işlev test_indeks_bos_alt() -> tam32 {
    eşleş indeks("merhaba", "") {
        değer(v) => { ver v; }            // 0
        hiç => { ver 0 - 1; }
    }
    ver 0 - 1;
}

// --- say (geçiş sayısı) ---
işlev test_say_uc() -> tam32 {
    ver say("aXbXcX", "X");               // 3
}

işlev test_say_ortusmeyen() -> tam32 {
    ver say("aaaa", "aa");                // 2 (örtüşmeyen)
}

işlev test_say_yok() -> tam32 {
    ver say("abc", "z");                  // 0
}

// --- on_ek_kaldir / son_ek_kaldir ---
işlev test_on_ek_kaldir() -> mantıksal {
    ver metin_es(on_ek_kaldir("merhaba", "mer"), "haba");
}

işlev test_on_ek_yok() -> mantıksal {
    ver metin_es(on_ek_kaldir("merhaba", "xyz"), "merhaba");
}

işlev test_son_ek_kaldir() -> mantıksal {
    ver metin_es(son_ek_kaldir("merhaba", "aba"), "merh");
}

işlev test_son_ek_yok() -> mantıksal {
    ver metin_es(son_ek_kaldir("merhaba", "xyz"), "merhaba");
}

// --- doldur_sol / doldur_sag ---
işlev test_doldur_sol() -> mantıksal {
    ver metin_es(doldur_sol("42", 5, "0"), "00042");
}

işlev test_doldur_sol_kisa() -> mantıksal {
    ver metin_es(doldur_sol("12345", 3, "0"), "12345");   // zaten uzun
}

işlev test_doldur_sag() -> mantıksal {
    ver metin_es(doldur_sag("ab", 5, "."), "ab...");
}

// --- basharf_buyut ---
işlev test_basharf_buyut() -> mantıksal {
    ver metin_es(basharf_buyut("merhaba"), "Merhaba");
}

işlev test_basharf_buyut_bos() -> mantıksal {
    ver metin_es(basharf_buyut(""), "");
}

// =============================================================================
// Genişletme 2 testleri — bul_tum / degistir_ilk / kes_arasi / sınıflama
// =============================================================================
//
// bul_tum (Dizi<tam32>) sonucu parametre-üzerinden indirgenir (F4-güvenli).

işlev dizi_tam_toplam(xs: Dizi<tam32>) -> tam32 {
    değişken s: tam32 = 0;
    için x: xs { s = s + x; }
    ver s;
}

işlev dizi_tam_say(xs: Dizi<tam32>) -> tam32 {
    değişken n: tam32 = 0;
    için x: xs { n = n + 1; }
    ver n;
}

// --- bul_tum ---
işlev test_bul_tum_toplam() -> tam32 {
    ver dizi_tam_toplam(bul_tum("aXbXcX", "X"));   // indeks 1+3+5 = 9
}
işlev test_bul_tum_say() -> tam32 {
    ver dizi_tam_say(bul_tum("aXbXcX", "X"));       // 3
}
işlev test_bul_tum_ortusmeyen() -> tam32 {
    ver dizi_tam_say(bul_tum("aaaa", "aa"));        // 2 (örtüşmeyen: 0,2)
}
işlev test_bul_tum_yok() -> tam32 {
    ver dizi_tam_say(bul_tum("abc", "z"));          // 0
}

// --- degistir_ilk ---
// NOT: hesaplanan metinleri runtime `metin_esit` (byte karşılaştırma) ile
// doğrula — `metin_es` gibi `metin_`-önekli kullanıcı işlevi codegen'de
// `kdl_metin_*` built-in olarak yönlendirilir (--llvm shadow); `metin_esit`
// gerçek primitiftir.
işlev test_degistir_ilk_var() -> mantıksal {
    ver metin_esit(degistir_ilk("aXbXc", "X", "-"), "a-bXc");   // yalnız ilk
}
işlev test_degistir_ilk_yok() -> mantıksal {
    ver metin_esit(degistir_ilk("abc", "X", "-"), "abc");
}
işlev test_degistir_ilk_genis() -> mantıksal {
    ver metin_esit(degistir_ilk("merhaba dünya", "dünya", "evren"), "merhaba evren");
}

// --- kes_arasi ---
işlev test_kes_arasi_var() -> mantıksal {
    eşleş kes_arasi("[ad]Ali[/ad]", "[ad]", "[/ad]") {
        değer(v) => { ver metin_esit(v, "Ali"); }
        hiç => { ver yanlış; }
    }
    ver yanlış;
}
işlev test_kes_arasi_son_yok() -> mantıksal {
    eşleş kes_arasi("(merhaba", "(", ")") {
        değer(v) => { ver yanlış; }
        hiç => { ver doğru; }
    }
    ver yanlış;
}
işlev test_kes_arasi_bas_yok() -> mantıksal {
    eşleş kes_arasi("merhaba", "<", ">") {
        değer(v) => { ver yanlış; }
        hiç => { ver doğru; }
    }
    ver yanlış;
}

// --- sadece_rakam_mi ---
işlev test_rakam_evet() -> mantıksal { ver sadece_rakam_mi("12345"); }
işlev test_rakam_hayir() -> mantıksal { ver sadece_rakam_mi("12a45"); }
işlev test_rakam_bos() -> mantıksal { ver sadece_rakam_mi(""); }

// --- sadece_harf_mi (ASCII + Türkçe) ---
işlev test_harf_ascii() -> mantıksal { ver sadece_harf_mi("merhaba"); }
işlev test_harf_turkce() -> mantıksal { ver sadece_harf_mi("çığşöü"); }
işlev test_harf_karisik() -> mantıksal { ver sadece_harf_mi("abc123"); }
işlev test_harf_bos() -> mantıksal { ver sadece_harf_mi(""); }
işlev test_harf_bosluk() -> mantıksal { ver sadece_harf_mi("ab cd"); }

// --- Kenar-durumlar: boş kaynak / boş ayraç / tek karakter / boş içerik ---
işlev test_bul_tum_bos_kaynak() -> tam32 {
    ver dizi_tam_say(bul_tum("", "x"));            // 0
}
işlev test_bul_tum_bos_alt() -> tam32 {
    ver dizi_tam_say(bul_tum("abc", ""));          // 0 (boş alt -> boş)
}
işlev test_degistir_ilk_bos_hedef() -> mantıksal {
    ver metin_esit(degistir_ilk("abc", "", "-"), "abc");   // boş hedef -> değişmez
}
işlev test_sadece_rakam_tek() -> mantıksal { ver sadece_rakam_mi("5"); }       // doğru
işlev test_sadece_harf_tek_turkce() -> mantıksal { ver sadece_harf_mi("ş"); }  // doğru
işlev test_kes_arasi_bos_icerik() -> mantıksal {
    eşleş kes_arasi("<>", "<", ">") {
        değer(v) => { ver metin_esit(v, ""); }      // boş içerik -> değer("")
        hiç => { ver yanlış; }
    }
    ver yanlış;
}

// NOT (execution): bu dosya `metin_es` (metin_-önekli kullanıcı işlevi)
// kullanan eski testler içerdiği için bütün olarak `--llvm` ile çalıştırılamaz
// (codegen `metin_*` çağrılarını `kdl_metin_*` built-in'e yönlendirir). Bu
// dosya gerçek gate olan `--check`'ten geçer; yeni işlevlerin runtime
// doğrulaması `metin_esit` (gerçek primitif) ile bağımsız sürücü üzerinden
// yapılır (PASS exit=42). Yukarıdaki yeni testler bu yüzden `metin_esit`
// kullanır.
// D-440: ÖNCEDEN bu main YALNIZ BİR test çağırıyordu (89 test işlevinden 1).
// Kalan 88'i derleniyor ama HİÇ KOŞMUYORDU — `--check` yalnız tip denetler.
// Tam bu kör nokta gerçek bir kusuru saklıyordu: `esit_mi` içerik değil
// İŞARETÇİ karşılaştırıyordu (bkz. stdlib/metin.kem D-440 notu).
//
// Beklentiler MEKANİK TÜRETİLEMEZ — bir kural yazıp uyguladım ve 9
// "başarısızlığın" 4'ü KURALIN kendi hatasıydı (ad beklentiyi değil GİRDİYİ
// tarif ediyor: `test_harf_karisik` = `sadece_harf_mi("abc123")` → yanlış
// dönmeli). Aşağıdaki `yanlış` beklentileri tek tek gövdeden doğrulandı.
işlev main() -> tam32 {
    değişken h: tam32 = 0;
    eğer değil test_esit_evet() { yazdir_metin("BASARISIZ (yanlış döndü): test_esit_evet"); h = h + 1; }
    eğer test_esit_hayir() { yazdir_metin("BASARISIZ (doğru döndü): test_esit_hayir"); h = h + 1; }
    eğer değil test_farkli_evet() { yazdir_metin("BASARISIZ (yanlış döndü): test_farkli_evet"); h = h + 1; }
    eğer test_farkli_hayir() { yazdir_metin("BASARISIZ (doğru döndü): test_farkli_hayir"); h = h + 1; }
    eğer değil test_bos_evet() { yazdir_metin("BASARISIZ (yanlış döndü): test_bos_evet"); h = h + 1; }
    eğer test_bos_hayir() { yazdir_metin("BASARISIZ (doğru döndü): test_bos_hayir"); h = h + 1; }
    eğer değil test_dolu_evet() { yazdir_metin("BASARISIZ (yanlış döndü): test_dolu_evet"); h = h + 1; }
    eğer test_dolu_hayir() { yazdir_metin("BASARISIZ (doğru döndü): test_dolu_hayir"); h = h + 1; }
    eğer değil test_sarmala_dolu() { yazdir_metin("BASARISIZ (yanlış döndü): test_sarmala_dolu"); h = h + 1; }
    eğer değil test_sarmala_bos() { yazdir_metin("BASARISIZ (yanlış döndü): test_sarmala_bos"); h = h + 1; }
    eğer değil test_birlestir_bos_solda() { yazdir_metin("BASARISIZ (yanlış döndü): test_birlestir_bos_solda"); h = h + 1; }
    eğer değil test_birlestir_bos_sagda() { yazdir_metin("BASARISIZ (yanlış döndü): test_birlestir_bos_sagda"); h = h + 1; }
    eğer değil test_kes_bos() { yazdir_metin("BASARISIZ (yanlış döndü): test_kes_bos"); h = h + 1; }
    eğer değil test_kes_uzunluk_semantigi() { yazdir_metin("BASARISIZ (yanlış döndü): test_kes_uzunluk_semantigi"); h = h + 1; }
    eğer değil test_kes_uzunluk_tasan() { yazdir_metin("BASARISIZ (yanlış döndü): test_kes_uzunluk_tasan"); h = h + 1; }
    eğer değil test_icerir_kendisi() { yazdir_metin("BASARISIZ (yanlış döndü): test_icerir_kendisi"); h = h + 1; }
    eğer değil test_icerir_bos_alt() { yazdir_metin("BASARISIZ (yanlış döndü): test_icerir_bos_alt"); h = h + 1; }
    eğer değil test_baslar_ile_kendisi() { yazdir_metin("BASARISIZ (yanlış döndü): test_baslar_ile_kendisi"); h = h + 1; }
    eğer değil test_baslar_ile_bos() { yazdir_metin("BASARISIZ (yanlış döndü): test_baslar_ile_bos"); h = h + 1; }
    eğer değil test_biter_ile_kendisi() { yazdir_metin("BASARISIZ (yanlış döndü): test_biter_ile_kendisi"); h = h + 1; }
    eğer değil test_biter_ile_bos() { yazdir_metin("BASARISIZ (yanlış döndü): test_biter_ile_bos"); h = h + 1; }
    eğer değil test_tekrarla_sifir() { yazdir_metin("BASARISIZ (yanlış döndü): test_tekrarla_sifir"); h = h + 1; }
    eğer değil test_yer_degistir_tam_esit() { yazdir_metin("BASARISIZ (yanlış döndü): test_yer_degistir_tam_esit"); h = h + 1; }
    eğer değil test_bilesik() { yazdir_metin("BASARISIZ (yanlış döndü): test_bilesik"); h = h + 1; }
    eğer değil test_yansit_ascii() { yazdir_metin("BASARISIZ (yanlış döndü): test_yansit_ascii"); h = h + 1; }
    eğer değil test_yansit_utf8() { yazdir_metin("BASARISIZ (yanlış döndü): test_yansit_utf8"); h = h + 1; }
    eğer değil test_yansit_bos() { yazdir_metin("BASARISIZ (yanlış döndü): test_yansit_bos"); h = h + 1; }
    eğer değil test_bol_join_round_trip() { yazdir_metin("BASARISIZ (yanlış döndü): test_bol_join_round_trip"); h = h + 1; }
    eğer değil test_birlestir_liste_bos() { yazdir_metin("BASARISIZ (yanlış döndü): test_birlestir_liste_bos"); h = h + 1; }
    eğer değil test_indeks_yok() { yazdir_metin("BASARISIZ (yanlış döndü): test_indeks_yok"); h = h + 1; }
