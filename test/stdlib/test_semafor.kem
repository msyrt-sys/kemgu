// KEMGU Stdlib Testi — Semafor
// ============================
//
// [D-456] `stdlib/semafor.kem` ile BİRLEŞTİRİLEREK derlenir ve ÇALIŞTIRILIR.
// Başarıda exit 0, aksi hâlde 1.
//
// Sınanan: (a) değer geçirme, (b) yeniden girilebilirlik (lineer DEĞİL),
// (c) izin TÜKENDİĞİNDE bloklama + geri verilince devam, (d) GERÇEK
// çok-thread'li sayılı erişim.
//
// ⚠ Küresel `Semafor` YAZILAMAZ (E012: küresel init sabit-literal olmalı),
// bu yüzden `main`de yaratılır ve görev kapanışları onu YAKALAR (D-300).

işlev sabit_kirkiki() -> tam32 { ver 42; }

küresel değişken sayac: tam32 = 0;

işlev main() -> tam32 {
    değişken h: tam32 = 0;

    // (a) kapanışın dönüş değeri çağırana geçmeli
    değişken s: Semafor = olustur(1);
    eğer semaforda(s, sabit_kirkiki) != 42 {
        yazdir_metin("BASARISIZ: semaforda deger gecirmedi"); h = h + 1;
    }

    // (b) YENİDEN GİRİLEBİLİR — izin bırakıldığı için ikinci çağrı asılmamalı.
    // Bu aynı zamanda `bırak`ın gerçekten çağrıldığının KANITIDIR: `semaforda`
    // izni geri vermeseydi bu satır SONSUZA DEK BLOKLARDI (testi asardı).
    eğer semaforda(s, sabit_kirkiki) != 42 {
        yazdir_metin("BASARISIZ: semafor ikinci kez kullanilamadi"); h = h + 1;
    }

    // (c) kapanış gövdesi çalışmalı
    eğer semaforda(s, || { ver 20 + 22; }) != 42 {
        yazdir_metin("BASARISIZ: kapanis govdesi calismadi"); h = h + 1;
    }

    // (d) GERÇEK eşzamanlılık: iki görev tek izinli semafor altında aynı
    // küresel sayacı artırır. Karşılıklı dışlama bozuksa sonuç 2'den küçük
    // olabilir. Ayrıca izin TEK olduğu için görevler GERÇEKTEN sıraya girer.
    // ⚠ Küresel erişim güvensiz-katmandır (E010) — semafor o denetimi sağlar.
    değişken g1: sonuç<görev<tam32>, metin> =
        görev_başlat(|| { ver semaforda(s, || {
            güvensiz { sayac = sayac + 1; }
            ver 0;
        }); });
    değişken g2: sonuç<görev<tam32>, metin> =
        görev_başlat(|| { ver semaforda(s, || {
            güvensiz { sayac = sayac + 1; }
            ver 0;
        }); });
    eşleş g1 {
        tamam(t1) => { görev_birleştir(t1); }
        hata(e1)  => { yazdir_metin("BASARISIZ: gorev1 baslatilamadi"); h = h + 1; }
    }
    eşleş g2 {
        tamam(t2) => { görev_birleştir(t2); }
        hata(e2)  => { yazdir_metin("BASARISIZ: gorev2 baslatilamadi"); h = h + 1; }
    }
    değişken son: tam32 = 0;
    güvensiz { son = sayac; }
    eğer son != 2 { yazdir_metin("BASARISIZ: sayac 2 degil"); h = h + 1; }

    yok_et(s);

    eğer h == 0 { yazdir_metin("semafor: TUM TESTLER GECTI"); ver 0; }
    yazdir_metin("semafor: BASARISIZ");
    ver 1;
}
