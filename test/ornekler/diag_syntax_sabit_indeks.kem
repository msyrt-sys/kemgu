// Ek sozdizim teshisi: sabit indeks-yazma alan[1] = v.

işlev main() -> tam32 {
    değişken alan = [100, 200, 300];
    değişken yazilan: tam32 = 9001;

    alan[1] = yazilan;
    değişken okunan: tam32 = alan[1];

    eğer okunan == yazilan {
        yazdir_metin("DIAG syntax_sabit_indeks EVET / yaz=9001 / oku=9001");
        ver 0;
    }

    yazdir_metin("DIAG syntax_sabit_indeks HAYIR / yaz=9001 / oku:");
    yazdir_tam(okunan);
    ver 1;
}
