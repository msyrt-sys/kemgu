// ============================================================================
// 14_oncelikli_ayristirici.kem — ÖZYİNELEMELİ-İNİŞ (recursive-descent) ifade
// AYRIŞTIRICISI: operatör ÖNCELİĞİ + PARANTEZ. Self-hosting'in parser yarısı.
//
// D-024 token akışını (iki paralel Dizi<tam32>) gerçek bir gramerle değerlendirir:
//
//     ifade  = terim  ( ('+'|'-') terim  )*
//     terim  = faktör ( ('*'|'/') faktör )*       // daha yüksek öncelik
//     faktör = SAYI | '(' ifade ')'
//
// Özyinelemeli iniş, paylaşılan MUTABLE bir KONUM İMLECİ gerektirir (her çağrı
// imleci ilerletir). İmleç, TEK elemanlı bir Dizi<tam32> (ptr → referansla
// paylaşılır) + `dizi_yaz` ile yerinde güncellenir. faktör→ifade→terim→faktör
// karşılıklı özyineleme (forward referans; iki-geçişli pre-populate).
//
// Token türleri:  0=SAYI 1=ARTI 2=EKSI 3=CARPI 4=BOLU 5=LPAREN 6=RPAREN
// ASCII:  +=43 -=45 *=42 /=47 (=40 )=41 ; '0'..'9'=48..57
//
// Değerlendirilen:  "2+4*10"  →  öncelik:  2 + (4*10)  =  42   (soldan-sağa 60).
// ============================================================================

işlev rakam_mi(b: tam8) -> mantıksal {
    değişken k: tam32 = b olarak tam32;
    ver k >= 48 ve k <= 57;
}

// LEXER — metni token akışına (kindler + degerler) çevir; token sayısını döndür.
işlev lexle(ifade: metin, kindler: Dizi<tam32>, degerler: Dizi<tam32>) -> tam32 {
    değişken uz: tam32 = metin_uzunluk(ifade);
    değişken i: tam32 = 0;
    değişken sayi: tam32 = 0;
    değişken sayi_var: mantıksal = yanlış;
    değişken adet: tam32 = 0;

    iken i < uz {
        değişken b: tam8 = metin_bayt(ifade, i);
        eğer rakam_mi(b) {
            sayi = sayi * 10 + (b olarak tam32) - 48;
            sayi_var = doğru;
        } değilse {
            eğer sayi_var {
                dizi_ekle(kindler, 0); dizi_ekle(degerler, sayi);
                adet = adet + 1; sayi = 0; sayi_var = yanlış;
            }
            değişken tur: tam32 = 0;        // 0 = tanınmadı (atla)
            eğer b == 43 { tur = 1; }
            değilse eğer b == 45 { tur = 2; }
            değilse eğer b == 42 { tur = 3; }
            değilse eğer b == 47 { tur = 4; }
            değilse eğer b == 40 { tur = 5; }
            değilse eğer b == 41 { tur = 6; }
            eğer tur != 0 {
                dizi_ekle(kindler, tur); dizi_ekle(degerler, 0);
                adet = adet + 1;
            }
        }
        i = i + 1;
    }
    eğer sayi_var {
        dizi_ekle(kindler, 0); dizi_ekle(degerler, sayi); adet = adet + 1;
    }
    ver adet;
}

// faktör = SAYI | '(' ifade ')'
işlev faktor(kindler: Dizi<tam32>, degerler: Dizi<tam32>, imlec: Dizi<tam32>) -> tam32 {
    değişken p: tam32 = dizi_al(imlec, 0);
    değişken k: tam32 = dizi_al(kindler, p);
    eğer k == 5 {                                   // '('
        dizi_yaz(imlec, 0, p + 1);                  // '(' tüket
        değişken v: tam32 = ifade(kindler, degerler, imlec);
        dizi_yaz(imlec, 0, dizi_al(imlec, 0) + 1);  // ')' tüket
        ver v;
    }
    dizi_yaz(imlec, 0, p + 1);                       // SAYI tüket
    ver dizi_al(degerler, p);
}

// terim = faktör ( ('*'|'/') faktör )*
işlev terim(kindler: Dizi<tam32>, degerler: Dizi<tam32>, imlec: Dizi<tam32>) -> tam32 {
    değişken sol: tam32 = faktor(kindler, degerler, imlec);
    iken doğru {
        değişken p: tam32 = dizi_al(imlec, 0);
        eğer p >= dizi_boyut(kindler) { ver sol; }
        değişken op: tam32 = dizi_al(kindler, p);
        eğer op == 3 {                              // '*'
            dizi_yaz(imlec, 0, p + 1);
            sol = sol * faktor(kindler, degerler, imlec);
        } değilse eğer op == 4 {                     // '/'
            dizi_yaz(imlec, 0, p + 1);
            sol = sol / faktor(kindler, degerler, imlec);
        } değilse {
            ver sol;
        }
    }
    ver sol;
}

// ifade = terim ( ('+'|'-') terim )*
işlev ifade(kindler: Dizi<tam32>, degerler: Dizi<tam32>, imlec: Dizi<tam32>) -> tam32 {
    değişken sol: tam32 = terim(kindler, degerler, imlec);
    iken doğru {
        değişken p: tam32 = dizi_al(imlec, 0);
        eğer p >= dizi_boyut(kindler) { ver sol; }
        değişken op: tam32 = dizi_al(kindler, p);
        eğer op == 1 {                              // '+'
            dizi_yaz(imlec, 0, p + 1);
            sol = sol + terim(kindler, degerler, imlec);
        } değilse eğer op == 2 {                     // '-'
            dizi_yaz(imlec, 0, p + 1);
            sol = sol - terim(kindler, degerler, imlec);
        } değilse {
            ver sol;
        }
    }
    ver sol;
}

işlev degerlendir(metin_ifade: metin) -> tam32 {
    değişken kindler: Dizi<tam32> = dizi_olustur(32);
    değişken degerler: Dizi<tam32> = dizi_olustur(32);
    lexle(metin_ifade, kindler, degerler);

    değişken imlec: Dizi<tam32> = dizi_olustur(1);
    dizi_ekle(imlec, 0);                            // konum 0'dan başla
    ver ifade(kindler, degerler, imlec);
}

işlev main() -> tam32 {
    ver degerlendir("2+4*10") olarak tam32;         // öncelik: 2+(4*10) = 42
}
