// kem_os_x86_nvme.kem — [D-745] BARE-METAL: sans-IO NVMe sürücüsü (drivers/nvme/
// cekirdek.kem) gerçek x86 çekirdeğinde, QEMU q35 + NVMe. qtest yürütücüsünün
// (tests/qemu/qtest.kem) yerini GERÇEK port G/Ç + MMIO + fiziksel bellek alır
// (runtime/mimari/x86_64/kem_pci_hw.kem). Sürücü kodu qtest kapısıyla BİREBİR aynı.
// Firmware (SeaBIOS) BAR'ları atar; çekirdek okur. Çıktı COM1; sonuç QEMU
// isa-debug-exit ile (başarı kodu 16 → QEMU çıkışı 33).
// Disk deseni (harness yazar): sektör s, bayt j = (s*7 + j*13 + 5) & 255.
// Yazma deseni (çekirdek yazar, harness imajdan doğrular): LBA 200.., j*31+11.
kullan drivers::nvme::cekirdek::{ NvmeDurum, nvme_yeni, nvme_adim, nvme_oku, nvme_yaz, nvme_flush };
kullan drivers::ortak::gc::{ GcIstek, GcYanit, gc_bos };
kullan drivers::pci::yapilandirma::{ PciAygit, pci_coz };

sabit BM_DMA_TABANI: tam64 = 134217728;   // 128 MiB — RAM (-m 256M), çekirdek+heap'in (~18 MiB) üstü
sabit BM_YAZMA_LBA: tam64 = 200;
sabit BM_YAZMA_SEKTOR: tam32 = 9;

işlev bm_yaz(m: metin) {
    değişken i: tam32 = 0;
    değişken n: tam32 = metin_uzunluk(m) olarak tam32;
    iken i < n { kem_uart_bayt((metin_bayt(m, i) olarak tam32) & 255); i = i + 1; }
    kem_uart_bayt(10);
}

// [D-745] Aygıttan gelen veriyi YIRTILMADAN oku. Aygıt (QEMU'da ayrı iş parçacığı,
// gerçek donanımda PCIe) girdiyi artan adreste 8 baytlık parçalarla yazar; bayt bayt
// okumak NVMe tamamlama girdisinde komut kimliğini (bayt 12-13) ESKİ, faz bitini
// (bayt 14) YENİ görebilir (ölçüldü: "nvme tamamlanma kimligi", gecikmeyle kayboluyor).
// Hizalı 8 baytlık okuma + AZALAN sıra: üst parça yeniyse altı da (TSO, artan yazım) yenidir.
işlev bm_bellek_oku(a: tam64, n: tam32) -> Dizi<dtam8> {
    değişken b: Dizi<dtam8> = [];
    eğer a % 8 == 0 ve n % 8 == 0 {
        değişken kelimeler: Dizi<tam64> = [];
        değişken k: tam32 = 0;
        iken k < n / 8 { dizi_ekle(kelimeler, 0); k = k + 1; }
        k = n / 8 - 1;
        iken k >= 0 { dizi_yaz(kelimeler, k, kem_mmio_oku64(a + (k olarak tam64) * 8)); k = k - 1; }
        k = 0;
        iken k < n / 8 {
            değişken w: tam64 = dizi_al(kelimeler, k);
            değişken j: tam32 = 0;
            iken j < 8 { dizi_ekle(b, (((w >> (j * 8)) & 255) olarak tam32) olarak dtam8); j = j + 1; }
            k = k + 1;
        }
        ver b;
    }
    değişken i: tam32 = 0;
    iken i < n { dizi_ekle(b, kem_fiz_oku8(a + (i olarak tam64)) olarak dtam8); i = i + 1; }
    ver b;
}

// GcIstek → gerçek donanım (qt_yurut'un bare-metal ikizi).
işlev bm_yurut(bar: tam64, i: GcIstek) -> GcYanit {
    değişken y: GcYanit = gc_bos();
    eşleş i {
        GcIstek::Oku32(a) => { y.deger = kem_mmio_oku32(bar + a); }
        GcIstek::Oku64(a) => { y.deger = kem_mmio_oku64(bar + a); }
        GcIstek::Yaz32(a, v) => { kem_mmio_yaz32(bar + a, v); }
        GcIstek::Yaz64(a, v) => { kem_mmio_yaz64(bar + a, v); }
        GcIstek::BellekOku(a, n) => { y.baytlar = bm_bellek_oku(a, n); }
        GcIstek::BellekYaz(a, b) => {
            değişken k: tam32 = 0;
            iken k < dizi_boyut(b) { kem_fiz_yaz8(a + (k olarak tam64), dizi_al(b, k) olarak tam32); k = k + 1; }
        }
        GcIstek::Bekle(us) => { kem_bekle_us(us); }
        _ => { }
    }
    ver y;
}

işlev bm_sur(bar: tam64, s: &değişken NvmeDurum) -> sonuç<mantıksal, metin> {
    değişken y: GcYanit = gc_bos();
    değişken i: tam32 = 0;
    iken i < 2000000 {
        değişken istek: GcIstek = nvme_adim(s, y);
        eşleş istek {
            GcIstek::Bitti => { ver tamam(doğru); }
            GcIstek::Hata(m) => { ver hata(m); }
            _ => { y = bm_yurut(bar, istek); }
        }
        i = i + 1;
    }
    ver hata("adim siniri");
}

// Veriyolu 0'da NVMe (01/08/02): bdf döner. Çok işlevli aygıtlar da taranır.
işlev bm_nvme_bul() -> sonuç<tam32, metin> {
    değişken a: tam32 = 0;
    iken a < 256 {
        değişken v: tam64 = kem_pci_oku32(a, 0);
        eğer (v & 65535) != 65535 {
            değişken b: Dizi<dtam8> = [];
            değişken ofs: tam32 = 0;
            iken ofs < 256 {
                değişken w: tam64 = kem_pci_oku32(a, ofs);
                değişken k: tam32 = 0;
                iken k < 4 { dizi_ekle(b, (((w >> (k * 8)) & 255) olarak tam32) olarak dtam8); k = k + 1; }
                ofs = ofs + 4;
            }
            eşleş pci_coz(b) {
                hiç => { }
                değer(p) => { eğer p.sinif == 1 ve p.alt_sinif == 8 ve p.prog_if == 2 { ver tamam(a); } }
            }
        }
        a = a + 1;
    }
    ver hata("NVMe aygiti bulunamadi");
}

işlev bm_desen(s: tam64, j: tam32) -> tam32 {
    ver (((s * 7) olarak tam32) + j * 13 + 5) & 255;
}

işlev bm_akis(bar: tam64, s: &değişken NvmeDurum) -> sonuç<metin, metin> {
    eşleş bm_sur(bar, s) { hata(e) => { ver hata(metin_birlestir("baslatma: ", e)); } tamam(x) => { } }
    eşleş nvme_oku(s, 0, 8) { hata(e) => { ver hata(e); } tamam(x) => { } }
    eşleş bm_sur(bar, s) { hata(e) => { ver hata(metin_birlestir("okuma: ", e)); } tamam(x) => { } }
    değişken i: tam32 = 0;
    iken i < 8 * 512 {
        eğer (dizi_al(s.sonuc, i) olarak tam32) != bm_desen((i / 512) olarak tam64, i % 512) { ver hata("okuma deseni bozuk"); }
        i = i + 1;
    }
    değişken veri: Dizi<dtam8> = [];
    i = 0;
    iken i < BM_YAZMA_SEKTOR * 512 { dizi_ekle(veri, ((i * 31 + 11) & 255) olarak dtam8); i = i + 1; }
    eşleş nvme_yaz(s, BM_YAZMA_LBA, veri) { hata(e) => { ver hata(e); } tamam(x) => { } }
    eşleş bm_sur(bar, s) { hata(e) => { ver hata(metin_birlestir("yazma: ", e)); } tamam(x) => { } }
    eşleş nvme_flush(s) { hata(e) => { ver hata(e); } tamam(x) => { } }
    eşleş bm_sur(bar, s) { hata(e) => { ver hata(metin_birlestir("flush: ", e)); } tamam(x) => { } }
    eşleş nvme_oku(s, BM_YAZMA_LBA, BM_YAZMA_SEKTOR) { hata(e) => { ver hata(e); } tamam(x) => { } }
    eşleş bm_sur(bar, s) { hata(e) => { ver hata(metin_birlestir("geri okuma: ", e)); } tamam(x) => { } }
    i = 0;
    iken i < BM_YAZMA_SEKTOR * 512 {
        eğer (dizi_al(s.sonuc, i) olarak tam32) != ((i * 31 + 11) & 255) { ver hata("geri okuma deseni bozuk"); }
        i = i + 1;
    }
    ver tamam(metin_birlestir("kapasite=", tam_metin(s.kapasite)));
}

işlev bm_calis() -> sonuç<metin, metin> {
    değişken bdf: tam32 = 0;
    eşleş bm_nvme_bul() { hata(e) => { ver hata(e); } tamam(a) => { bdf = a; } }
    // Firmware'in atadığı 64-bit BAR0. Komut yazmacı: bellek alanı + veriyolu yöneticisi.
    değişken bar: tam64 = (kem_pci_oku32(bdf, 16) & 4294967280) | (kem_pci_oku32(bdf, 20) << 32);
    eğer bar < 3221225472 veya bar > 4294967295 { ver hata("BAR0 UC MMIO penceresi disinda"); }
    kem_pci_yaz32(bdf, 4, kem_pci_oku32(bdf, 4) | 6);
    eşleş nvme_yeni(BM_DMA_TABANI, 16) {
        hata(e) => { ver hata(e); }
        tamam(d) => { değişken s: NvmeDurum = d; ver bm_akis(bar, &değişken s); }
    }
}

işlev main() -> tam32 {
    bm_yaz("KEMGU-OS x86 bare-metal NVMe");
    eşleş bm_calis() {
        hata(e) => { bm_yaz(metin_birlestir("BM_NVME HATA ", e)); kem_qemu_cik(1); }
        tamam(m) => { bm_yaz(metin_birlestir("BM_NVME OK ", m)); kem_qemu_cik(16); }
    }
    ver 0;
}
