// D-194 regresyon: INT64_MAX ustu tamsayi literalleri tam 64-bit
// bit-desenini korumali (strtoull) — INT64_MAX'a CLAMP OLMAMALI.
//
// Onceki hata: lexer/parser strtoll ile cozerdi; 0xFFFFFFFFFFFFFFFF gibi
// yuksek-bit-set degerler 0x7FFFFFFFFFFFFFFF (INT64_MAX) olur, boylece
// dtam64 (isaretsiz 64-bit) sabitleri yuksek bit set halde yazilamazdi.
//
// Beklenen stdout:
//   18446744073709551615
//   9223372036854775808
//   18446744073709551615
//   0xffffffffffffffff
//   0x8000000000000000

işlev main() -> tam32 {
    değişken hepsi_bir: dtam64 = 0xFFFFFFFFFFFFFFFF;   // 2^64 - 1
    değişken yuksek_bit: dtam64 = 0x8000000000000000;  // 2^63
    değişken ondalik: dtam64 = 18446744073709551615;   // ayni deger, ondalik

    yazdir_isaretsiz_tam64(hepsi_bir);
    yazdir_isaretsiz_tam64(yuksek_bit);
    yazdir_isaretsiz_tam64(ondalik);

    yazdir_onaltilik(hepsi_bir);
    yazdir_onaltilik(yuksek_bit);

    ver 0;
}
