// =====================================================================
// kem_surucu.kem — KEMGU-OS Faz-2 adım 2: .kem-NATIVE PL011 UART SÜRÜCÜSÜ
// ---------------------------------------------------------------------
// Konsol çıktısı artık C runtime (kdl_yazdir_metin) DEĞİL — TAMAMEN .kem'de,
// doğrudan MMIO ile PL011 UART. Bu, "kendi dilinde OS" DNA'sının ilk gerçek
// sürücü katmanı: yazma yolu (byte→register) KEMGU dilinde.
//
// PL011 (QEMU virt @ 0x09000000):
//   DR (0x00) — veri register (yazılan bayt seri porta gider)
//   FR (0x18) — flag register; bit5 (0x20) = TXFF (TX FIFO dolu)
// Yazma protokolü: FR.TXFF temizlenene kadar bekle (QEMU'da hep 0), sonra DR'ye yaz.
//
// yetki<MMIO> LİNEAR: her uart_bayt kendi yetkisini üretir+tüketir (döngüde
// threading gerekmez; mmio_oku32/yaz32 ÖDÜNÇ alır, geri_al tüketir).
// metin_bayt/metin_uzunluk bare-metal: runtime/kdl_metin_bare.c (bm_a64_metin.o).
//
// Beklenen QEMU seri çıktı (HEPSİ .kem sürücüsünden):
//   === KEMGU .kem-native UART surucu (Faz-2 adim 2) ===
//   [surucu] PL011 .kem'de: MMIO poll(FR.TXFF) + yaz(DR), C yazdir_metin YOK
//   [test] sayi = 42
//   [test] sayi = 1953655158
//   [test] sayi = 0
//   KEM SURUCU OK
// =====================================================================

sabit UART_TABAN: tam64 = 150994944;   // 0x09000000 PL011 (QEMU virt)
sabit UART_DR: tam64    = 0;           // 0x00 veri register
sabit UART_FR: tam64    = 24;          // 0x18 flag register
sabit UART_TXFF: tam32  = 32;          // bit5 = TX FIFO dolu
sabit MMIO_YETKI: tam32 = 3;           // izin OKU|YAZ (kaynak tipi 6 = MMIO)

// --- Tek bayt yaz: FR.TXFF temizlenene kadar bekle → DR'ye yaz. ---
// yetki lineer: üret → oku(ödünç, döngüde) → yaz(ödünç) → geri_al(tüket).
işlev uart_bayt(b: tam32) {
    değişken y: yetki<MMIO> = yetki_olustur(6, MMIO_YETKI);
    // TX FIFO dolu iken bekle (QEMU'da TXFF hep 0 → beklemez; gerçek HW'de korur).
    // (& = bitwise-AND; != 0 önce bağlamasın diye parantez ZORUNLU.)
    iken (mmio_oku32(y, UART_TABAN + UART_FR) & UART_TXFF) != 0 {
    }
    mmio_yaz32(y, UART_TABAN + UART_DR, b);
    geri_al(y);
}

// --- Metni bayt-bayt yaz (metin_bayt bare-metal, kdl_metin_bare.c). ---
işlev uart_metin(s: metin) {
    değişken n: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 0;
    iken i < n {
        uart_bayt(metin_bayt(s, i) olarak tam32);
        i = i + 1;
    }
}

// --- Satır: metin + newline. ---
işlev uart_satir(s: metin) {
    uart_metin(s);
    uart_bayt(10);   // '\n'
}

// --- Sayı yaz (decimal, özyinelemeli basamak çıkarımı). Negatif yok (kernel +). ---
işlev uart_tam_yardim(n: tam32) {
    eğer n > 0 {
        uart_tam_yardim(n / 10);
        uart_bayt((n % 10) + 48);   // '0' = 48
    }
}
işlev uart_tam_satir(n: tam32) {
    eğer n == 0 {
        uart_bayt(48);              // "0"
    } değilse {
        uart_tam_yardim(n);
    }
    uart_bayt(10);
}

işlev main() -> tam32 {
    // TÜM çıktı .kem UART sürücüsünden — C kdl_yazdir_metin ÇAĞRISI YOK.
    uart_satir("=== KEMGU .kem-native UART surucu (Faz-2 adim 2) ===");
    uart_satir("[surucu] PL011 .kem'de: MMIO poll(FR.TXFF) + yaz(DR), C yazdir_metin YOK");

    uart_metin("[test] sayi = ");
    uart_tam_satir(42);

    uart_metin("[test] sayi = ");
    uart_tam_satir(1953655158);   // 0x74726976 — büyük tam32 basamak çıkarımı

    uart_metin("[test] sayi = ");
    uart_tam_satir(0);            // sıfır özel-durum

    uart_satir("KEM SURUCU OK");
    ver 0;
}
