}
işlev ag_tcp_paket(b: Dizi<dtam8>,n: tam32,ip: tam64,es: tam64) -> tam32 {
    güvensiz {
        eth_yaz(b,ag_mac,ag_mac,2048); ip4_yaz(b,ip,es,6,n,ag_sonraki_kim); ag_sonraki_kim=(ag_sonraki_kim+1)&65535;
        eğer (es>>24)==127 {
