    }
çıplak işlev ag_link() -> tam64 {
    eğer ag_model==4 { ver (vblk_o16(ag_vcihaz+6) olarak tam64)&1; }
    ver (kem_mmio_oku32(ag_bar+8)>>1)&1;
}

// Kuyruk sıfır ve bağlantı bildirimleri aynı MSI-X tablo girişine yönelir.
işlev ag_msix(bdf: tam32) -> tam32 {
    güvensiz {
        eğer kesme_tablo==0 veya kap_lapic==0 { ver -1; }
        değişken k: tam32 = bd_pci_yetenek(bdf,17);
        eğer k==0 veya k>244 { ver -1; }
        değişken ctl: tam32 = kem_pci_oku16(bdf,k+2);
        değişken t: tam64 = kem_pci_oku32(bdf,k+4);
        değişken a: tam64 = ag_pci_pencere(bdf,(t&7) olarak tam32,t&4294967288,16);
        eğer a==0 { ver -1; }
        değişken v: tam32 = kesme_ayir();
        eğer v<0 { ver -1; }
        eğer değil kesme_kaydet(v,7) { kesme_birak(v); ver -1; }
        değişken kayit: tam64 = kesme_tablo+32*(v olarak tam64);
        kem_mmio_yaz64(kayit+16,ag_bar+192);
        kem_pci_yaz16(bdf,k+2,ctl|49152);
        kem_mmio_yaz32(a+12,1);
        kem_mmio_yaz32(a,4276092928|(((kem_mmio_oku32(kap_lapic+32)>>24)&255)<<12));
        kem_mmio_yaz32(a+4,0); kem_mmio_yaz32(a+8,v olarak tam64); kem_mmio_yaz32(a+12,0);
        kem_pci_yaz16(bdf,k+2,(ctl|32768)&49151);
        eğer ag_model==2 {
            kem_mmio_yaz32(ag_bar+228,2148009992);
            // IAME açık ve IAM sıfırken EIAC nedeni temizler, MSI-X maskesi açık kalır.
            kem_mmio_yaz32(ag_bar+224,0);
            kem_mmio_yaz32(ag_bar+24,kem_mmio_oku32(ag_bar+24)|134217728);
            kem_mmio_yaz32(ag_bar+220,22020096);
            kem_mmio_yaz32(ag_bar+208,22020100);
            kem_mmio_yaz32(ag_bar+200,1048576);
        } değilse {
            kem_mmio_yaz32(ag_bar+5396,16);
            kem_mmio_yaz32(ag_bar+5888,32896);
            kem_mmio_yaz32(ag_bar+5952,32768);
            kem_mmio_yaz32(ag_bar+5420,1);
            kem_mmio_yaz32(ag_bar+5412,1);
            kem_mmio_yaz32(ag_bar+208,4);
            kem_mmio_yaz32(ag_bar+5408,1);
        }
        değişken i: tam32 = 0;
        iken i<100 ve kem_mmio_oku64(kayit+8)==0 { kem_bekle_us(100); i=i+1; }
        eğer kem_mmio_oku64(kayit+8)>0 { ver v; }
        kem_mmio_yaz32(ag_bar+216,4294967295);
        eğer ag_model==3 { kem_mmio_yaz32(ag_bar+5416,4294967295); kem_mmio_yaz32(ag_bar+5396,0); }
        kem_mmio_yaz32(a+12,1); kem_pci_yaz16(bdf,k+2,ctl&32767);
        kesme_birak(v); ver -1;
    }
}

işlev ag_intx(bdf: tam32) -> tam32 {
    güvensiz {
        // QEMU Q35'in harici kök yuvaları PIRQ E..H üzerinden GSI 20..23'e gider.
        // Diğer platformlarda _PRT çözülene kadar yoklama yolunu kullan.
        eğer bdf/256 != 0 veya bdf/8 >= 25 veya kem_pci_oku32(0,0) != 700481670 veya kap_io1 == 0 { ver -1; }
