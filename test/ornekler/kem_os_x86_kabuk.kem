kullan drivers::ortak::utf8::{ utf8_coz, utf8_kodla };
// Bare-metal xHCI + BOT: FAT32 metadata'sı ve dosya sektörleri ayrı okunur.
// Python kâhini: tests/qemu/fat_yazici.py; 1300 bayt, üç küme.
kullan drivers::usb::xhci_cekirdek::{ XhciDurum, XhciAygit, xhci_yeni, xhci_adim, xhci_depo_hazir, xhci_kontrol, xhci_giris, xhci_depo_giris };
kullan drivers::usb::xhci_kayit::{ XhciYetenek };
kullan drivers::usb::xhci_trb::{ XhciHalka, XhciOlayHalkasi };
kullan drivers::usb::tanim::{ UsbAygit, UsbArayuz, UsbUc, UsbHid, UsbHidEk, UsbYapilandirma, usb_hid_set_protocol, usb_hid_set_idle };
kullan drivers::usb::depo::{ UsbDepo, usb_depo_yeni, usb_depo_adim, usb_depo_oku, usb_depo_yaz, usb_depo_flush };
kullan drivers::ortak::bayt::{ oku_u8, oku_le32, yaz_u8 };
kullan drivers::fs::fat32_bpb::{ Fat32Bpb, BpbHatasi, bpb_coz, kume_sektoru };
kullan drivers::fs::fat32_dizin::{ DizinGirdisi, dizin_coz };
kullan drivers::ekran::psf::{ PsfFont, psf_coz };
kullan drivers::ekran::konsol::{ Konsol, konsol_yeni };
kullan drivers::ekran::font_tr16::{ font_tr16 } olarak ft;

// Bare-metal metin runtime'ında metin_esit yok; baytları mevcut ilkellerle karşılaştır.
işlev bm_esit(a: metin, b: metin) -> mantıksal {
    eğer metin_uzunluk(a) != metin_uzunluk(b) { ver yanlış; }
    değişken i: tam32 = 0;
    iken i < metin_uzunluk(a) { eğer metin_bayt(a,i) != metin_bayt(b,i) { ver yanlış; } i=i+1; }
    ver doğru;
}
// DMA: PVH varsayılanı veya UEFI fiziksel çerçeve tahsisi.
// [D-749] H4e ÇİFT ÇIKTI: her kabuk çıktısı seriye VE ekrana (runtime/mimari/x86_64/
// kem_ekran_bga.kem). Ekran açılamazsa kabuk yalnız seriyle sürer (var = yanlış).
sabit KE_ON: tam32 = 16777215;       // 0xFFFFFF
sabit KE_ARKA: tam64 = 1056832;      // 0x102040
yapı KabukEkran { var: mantıksal; e: Ekran; f: PsfFont; k: Konsol; }
işlev ke_ciz(ke: &değişken KabukEkran) {
    eğer değil ke.var { ver; }
    ekran_ayna_bosalt(&değişken ke.k);
    ekran_konsol_ciz(ke.e, ke.f, &değişken ke.k, 8, 8);
}
// Girdi yalnız ekrana çizilir: seri ve konsol geçmişi Enter'a kadar değişmez.
işlev ke_girdi(ke: &değişken KabukEkran, satir: SatirDuzenleyici) {
    eğer değil ke.var { ver; }
    değişken bas: tam32 = girdi_bas(satir.imlec,ke.k.sutunlar);
    değişken x: tam32 = 0;
    iken x < ke.k.sutunlar {
        değişken on: tam64 = KE_ON olarak tam64; değişken arka: tam64 = KE_ARKA;
        eğer x == 2 + satir.imlec - bas { on=KE_ARKA; arka=KE_ON olarak tam64; }
        ekran_kod(ke.e,ke.f,8+x*ke.f.genislik,8+ke.k.y*ke.f.yukseklik,
            girdi_kod(satir.kodlar,bas,x),on,arka);
        x=x+1;
    }
}
işlev bm_xsur(bar: tam64, s: &değişken XhciDurum) -> sonuç<mantıksal,metin> {
    değişken y: GcYanit = gc_bos(); değişken i: tam32 = 0;
    iken i < 100000 { değişken r: GcIstek = xhci_adim(s,y);
        eşleş r { GcIstek::Bitti => { ver tamam(doğru); } GcIstek::Hata(e) => { ver hata(e); } _ => { y=bm_yurut(bar,r); } } i=i+1;
    } ver hata("xhci adim siniri");
}
// [D-747] Olay beklerken sürücüyü ADIMLAMA. Her yoklama `BellekOku` ile yeni bir dizi
// üretir; sürücü durumu main'e ait olduğu için bu diziler küresel bölgede kalır ve hiç
// geri alınmaz (ölçüldü: tuş başına ~200 KB, 16 MB heap birkaç komutta biter). Ayrıca
// sürücünün yoklama sınırı (4000 × Bekle) boşta duran kabuğu saniyeler içinde
// "xhci olay zaman asimi" ile düşürüyordu. Çekirdek DW3 döngü bitini AYIRMA YAPMADAN
// okur ve süresiz bekler; olay gelince sürücü normal (yırtılmayan, D-745) yoldan sürer.
çıplak işlev bm_olay_bekle(adr: tam64, dongu: tam64) -> mantıksal {
    iken (kem_mmio_oku32(adr) & 1) != dongu {
        eğer ps2_kesme_fare_var() { ver yanlış; } kem_bekle_us(50);
    } ver doğru;
}
işlev bm_xsur_bekle(bar: tam64, s: &değişken XhciDurum) -> sonuç<mantıksal,metin> {
    değişken y: GcYanit = gc_bos(); değişken i: tam32 = 0;
    iken i < 100000 { değişken r: GcIstek = xhci_adim(s,y);
        eşleş r { GcIstek::Bitti => { ver tamam(doğru); } GcIstek::Hata(e) => { ver hata(e); }
            GcIstek::Bekle(us) => {
                eğer s.evre == 900 {
                    değişken dg: tam64 = 0; eğer s.olay.dongu { dg = 1; }
                    eğer değil bm_olay_bekle(s.olay.taban + (s.olay.bas olarak tam64) * 16 + 12, dg) {
                        s.bekleme=0;ver tamam(yanlış);
                    }
                    s.bekleme = 0; y = gc_bos();
                } değilse { y=bm_yurut(bar,r); }
            }
            _ => { y=bm_yurut(bar,r); } } i=i+1;
    } ver hata("xhci adim siniri");
}
işlev bm_usur(bar: tam64, s: &değişken UsbDepo) -> sonuç<mantıksal,metin> {
    değişken y: GcYanit = gc_bos(); değişken i: tam32 = 0;
    iken i < 100000 { değişken r: GcIstek = usb_depo_adim(s,y);
        eşleş r { GcIstek::Bitti => { ver tamam(doğru); } GcIstek::Hata(e) => { ver hata(e); } _ => { y=bm_yurut(bar,r); } } i=i+1;
    } ver hata("usb adim siniri");
}
işlev bm_uoku(bar: tam64, s: &değişken UsbDepo, lba: tam64, n: tam32) -> sonuç<Dizi<dtam8>,metin> {
    eşleş usb_depo_oku(s,lba,n) { hata(e) => { ver hata(e); } tamam(v) => { } }
    eşleş bm_usur(bar,s) { hata(e) => { ver hata(e); } tamam(v) => { ver tamam(s.sonuc); } }
}
işlev bm_nvme_sur(bar: tam64, s: &değişken NvmeDurum) -> sonuç<mantıksal, metin> {
    değişken y: GcYanit = gc_bos();
    değişken i: tam32 = 0;
    iken i < 2000000 {
        değişken istek: GcIstek = nvme_adim(s, y);
        eşleş istek {
            GcIstek::Bitti => { ver tamam(doğru); }
            GcIstek::Hata(m) => { ver hata(m); }
            _ => { y = bm_yurut(bar, istek); }
        }
        i = i + 1;
    }
    ver hata("adim siniri");
}

işlev bm_ahci_sur(bar: tam64, s: &değişken AhciDurum) -> sonuç<mantıksal, metin> {
    değişken y: GcYanit = gc_bos();
    değişken i: tam32 = 0;
    iken i < 2000000 {
        değişken istek: GcIstek = ahci_adim(s, y);
        eşleş istek {
            GcIstek::Bitti => { ver tamam(doğru); }
            GcIstek::Hata(m) => { ver hata(m); }
            _ => { y = bm_yurut(bar, istek); }
        }
        i = i + 1;
    }
    ver hata("adim siniri");
}

yapı KabukDisk { tur: tam32; bar: tam64; bolum: tam64; nv: NvmeDurum; ah: AhciDurum; usb: UsbDepo; }
işlev kd_yeni() -> sonuç<KabukDisk,metin> {
    eşleş nvme_yeni(bm_disk_dma_al(),16) { hata(e) => { ver hata(e); } tamam(n) => {
    eşleş ahci_yeni(bm_disk_dma_al(),-1) { hata(e) => { ver hata(e); } tamam(a) => {
    eşleş usb_depo_yeni(65536,8196,4152,1,2,129,0) { hata(e) => { ver hata(e); } tamam(u) => {
        ver tamam(KabukDisk { tur: 0, bar: 0, bolum: 0, nv: n, ah: a, usb: u });
    } } } } } }
}
işlev kd_bul(d: &değişken KabukDisk, x: &değişken XhciDurum, xb: tam64) -> sonuç<mantıksal,metin> {
    eşleş bm_pci_bul(1,8,2) { hata(e) => { } tamam(bdf) => {
        d.bar=(kem_pci_oku32(bdf,16)&4294967280)|(kem_pci_oku32(bdf,20)<<32); kem_pci_yaz32(bdf,4,kem_pci_oku32(bdf,4)|6);
        eşleş bm_nvme_sur(d.bar,&değişken d.nv) { hata(e) => { ver hata(e); } tamam(v) => { d.tur=1; ekran_cift_yaz("DISK NVMe"); ver tamam(doğru); } }
    } }
    eşleş bm_pci_bul(1,6,1) { hata(e) => { } tamam(bdf) => {
        d.bar=kem_pci_oku32(bdf,36)&4294967280; kem_pci_yaz32(bdf,4,kem_pci_oku32(bdf,4)|6);
        eşleş bm_ahci_sur(d.bar,&değişken d.ah) { hata(e) => { } tamam(v) => { d.tur=2; ekran_cift_yaz("DISK AHCI"); ver tamam(doğru); } }
    } }
    değişken i: tam32 = 0;
    iken i < dizi_boyut(x.aygitlar) {
        değişken a: XhciAygit = dizi_al(x.aygitlar,i); değişken ar: UsbArayuz = dizi_al(a.yapi.arayuzlar,0);
        eğer ar.sinif == 8 {
            değişken out: tam32 = 0; değişken gir: tam32 = 0;
            için u: a.yapi.uclar { eğer u.tur == 2 { eğer (u.adres&128) != 0 { gir=u.adres; } değilse { out=u.adres; } } }
            eşleş xhci_depo_hazir(x,i) { hata(e) => { ver hata(e); } tamam(v) => { } }
            eşleş bm_xsur(xb,x) { hata(e) => { ver hata(e); } tamam(v) => { } }
            eşleş usb_depo_yeni(a.dma,x.c.dboff+(a.yuva olarak tam64)*4,x.c.rtsoff+56,a.yuva,out,gir,ar.no) { hata(e) => { ver hata(e); } tamam(u) => { d.usb=u; } }
            d.bar=xb;
            eşleş bm_usur(xb,&değişken d.usb) { hata(e) => { ver hata(e); } tamam(v) => { d.tur=3; ekran_cift_yaz("DISK USB"); ver tamam(doğru); } }
        } i=i+1;
    } ver hata("disk bulunamadi");
}
işlev kd_oku(d: &değişken KabukDisk, lba: tam64, n: tam32) -> sonuç<Dizi<dtam8>,metin> {
    eğer d.tur == 1 {
        eşleş nvme_oku(&değişken d.nv,lba,n) { hata(e) => { ver hata(e); } tamam(v) => { } }
        eşleş bm_nvme_sur(d.bar,&değişken d.nv) { hata(e) => { ver hata(e); } tamam(v) => { ver tamam(d.nv.sonuc); } }
    }
    eğer d.tur == 2 {
        eşleş ahci_oku(&değişken d.ah,lba,n) { hata(e) => { ver hata(e); } tamam(v) => { } }
        eşleş bm_ahci_sur(d.bar,&değişken d.ah) { hata(e) => { ver hata(e); } tamam(v) => { ver tamam(d.ah.sonuc); } }
    }
    ver bm_uoku(d.bar,&değişken d.usb,lba,n);
}
işlev kd_bagla(d: &değişken KabukDisk) -> sonuç<FatSektor,metin> {
    // Yalnız GPT başlığı ve 128 girdilik tablo: 34 sektör; tüm disk yüklenmez.
    eşleş kd_oku(d,0,34) { hata(e) => { ver hata(e); } tamam(b) => {
        eşleş gpt_coz(b,512) { hata(e) => { ver hata("GPT gecersiz"); } tamam(xs) => {
            eğer dizi_boyut(xs) != 1 { ver hata("GPT bolum sayisi"); }
            değişken bol: Bolum = dizi_al(xs,0); d.bolum=bol.baslangic_lba;
        } }
    } }
    eşleş kd_oku(d,d.bolum,1) { hata(e) => { ver hata(e); } tamam(b) => {
        eşleş bpb_coz(b) { hata(e) => { ver hata("BPB gecersiz"); } tamam(bp) => { ver fat_sektor_yeni(bp); } }
    } }
}
işlev doldur(d: &değişken KabukDisk, f: &değişken FatSektor) -> sonuç<mantıksal,metin> {
    eşleş kd_oku(d,d.bolum+f.gerekli,1) { hata(e) => { ver hata(e); } tamam(b) => { ver fat_sektor_koy(f,f.gerekli,b); } }
}
işlev komut(d: &değişken KabukDisk, f: &değişken FatSektor, satir: metin) -> sonuç<mantıksal,metin> {
    değişken ad: Dizi<tam32> = []; değişken arg: Dizi<tam32> = []; değişken bosluk: mantıksal = yanlış;
    değişken kodlar: Dizi<tam32> = utf8_coz(satir);
    için k: kodlar { eğer değil bosluk ve k == 32 { bosluk=doğru; } değilse eğer bosluk { dizi_ekle(arg,k); } değilse { dizi_ekle(ad,k); } }
    değişken cmd: metin = utf8_kodla(ad); değişken yol: metin = utf8_kodla(arg);
    eğer bm_esit(cmd,"echo") { ekran_cift_yaz(yol); ver tamam(doğru); }
    eğer değil bm_esit(cmd,"cat") ve değil bm_esit(cmd,"ls") { ver hata("bilinmeyen komut"); }
    değişken i: tam32 = 0;
    iken i < 257 {
        eğer bm_esit(cmd,"ls") {
            eşleş fat_sektor_listele(f,yol) { hata(e) => { eğer f.gerekli == 0 { ver hata(e); } } tamam(xs) => {
                için k: xs { eğer değil bm_esit(k.ad,".") ve değil bm_esit(k.ad,"..") { eğer k.dizin_mi { ekran_cift_yaz(metin_birlestir(k.ad,"/")); } değilse { ekran_cift_yaz(k.ad); } } }
                ver tamam(doğru);
            } }
        } değilse {
            eşleş fat_sektor_oku(f,yol) { hata(e) => { eğer f.gerekli == 0 { ver hata(e); } } tamam(b) => {
                değişken j: tam32 = 0; iken j < dizi_boyut(b) { ekran_cift_bayt(oku_u8(b,j)&255); j=j+1; }
                eğer j == 0 { ekran_cift_bayt(10); } değilse eğer oku_u8(b,j-1) != 10 { ekran_cift_bayt(10); }
                ver tamam(doğru);
            } }
        }
        eşleş doldur(d,f) { hata(e) => { ver hata(e); } tamam(v) => { } } i=i+1;
    } ver hata("sektor tekrar siniri");
}
// ISR yalnız bayt üretir; paket, metin ve imleç tüketici bağlamındadır.
işlev kabuk_fare(ke: &değişken KabukEkran, fd: &değişken FareDurumu, im: &değişken EkranFare) {
 değişken b: tam32 = ps2_kesme_fare_oku();
 iken b >= 0 {
  eşleş fare_bayt(fd,b) { hiç => { } değer(o) => {
   değişken dugme: tam32 = 0;eğer o.sol { dugme=dugme|1; }eğer o.sag { dugme=dugme|2; }eğer o.orta { dugme=dugme|4; }
   değişken mesaj: metin = metin_birlestir("FARE dx=",tam_metin(o.dx olarak tam64));
   mesaj=metin_birlestir(mesaj," dy=");mesaj=metin_birlestir(mesaj,tam_metin(o.dy olarak tam64));
   mesaj=metin_birlestir(mesaj," dugme=");bm_yaz(metin_birlestir(mesaj,tam_metin(dugme olarak tam64)));
   eğer ke.var { ekran_fare_hareket(ke.e,im,o.dx,o.dy); }
  } }
  b=ps2_kesme_fare_oku();
 }
}
işlev kabuk(d: &değişken KabukDisk, f: &değişken FatSektor, x: &değişken XhciDurum, xb: tam64, indeks: tam32, ke: &değişken KabukEkran) -> sonuç<mantıksal,metin> {
    değişken h: HidKlavye = hid_klavye_yeni(); değişken tr: KlavyeDurumu = klavye_yeni(); değişken satir: SatirDuzenleyici = satir_yeni();
    değişken fd: FareDurumu = fare_yeni(yanlış);değişken im: EkranFare = ekran_fare_yeni();
    değişken bekleyen: mantıksal = yanlış;
    değişken kayip1: tam64 = 0;değişken kayip12: tam64 = 0;değişken irqhata: tam64 = 0;
    ekran_cift_yaz("KABUK_HAZIR");ke_ciz(ke);ke_girdi(ke,satir);
    iken doğru {
        eğer indeks < 0 ve ps2_kesme_etkin() { ps2_kesme_bekle(); }
        kabuk_fare(ke,&değişken fd,&değişken im);
        değişken k1: tam64 = ps2_kesme_kayip(yanlış);değişken k12: tam64 = ps2_kesme_kayip(doğru);değişken kh: tam64 = ps2_kesme_hata_oku();
        eğer k1 != kayip1 veya k12 != kayip12 veya kh != irqhata {
            kap_dok("PS2_KAYIP",k1,k12,kh);kayip1=k1;kayip12=k12;irqhata=kh;
        }
        değişken xs: Dizi<TusOlayi> = [];
        eğer indeks < 0 {
            değişken b: tam32 = -1;
            eğer ps2_kesme_etkin() { b=ps2_kesme_klavye_oku(); } değilse { b=ps2_bekle(); }
            eğer b >= 0 { dizi_ekle(xs,klavye_bayt(&değişken tr,b)); }
        } değilse {
            eğer değil bekleyen {
                değişken r: sonuç<mantıksal,metin> = hata("girdi");
                eğer d.tur == 3 { r=xhci_depo_giris(x,indeks,8,d.usb.olay_bas,d.usb.olay_dongu); }
                değilse { r=xhci_giris(x,indeks,8); }
                eşleş r { hata(e) => { ver hata(e); } tamam(v) => { } }bekleyen=doğru;
            }
            eşleş bm_xsur_bekle(xb,x) { hata(e) => { ver hata(e); } tamam(v) => {
                eğer v {
                    bekleyen=yanlış;
                    eğer d.tur == 3 { d.usb.olay_bas=x.olay.bas; d.usb.olay_dongu=x.olay.dongu; }
                    eşleş hid_klavye_rapor(&değişken h,&değişken tr,x.sonuc) { hata(e) => { ver hata(e); } tamam(olaylar) => { xs=olaylar; } }
                }
            } }
        }
        ekran_fare_sil(ke.e,&değişken im);
        için o: xs { eşleş satir_olay(&değişken satir,o) { hiç => { ke_girdi(ke,satir); } değer(s) => {
            ekran_ayna_yaz(metin_birlestir("> ", s));
            eşleş komut(d,f,s) { hata(e) => { ekran_cift_yaz(metin_birlestir("HATA ",e)); } tamam(v) => { } }
            ekran_cift_yaz("KABUK_HAZIR");ke_ciz(ke);ke_girdi(ke,satir);
        } } }
        ekran_fare_ciz(ke.e,&değişken im);
    } ver tamam(doğru);
}
işlev hazir(xb: tam64, x: &değişken XhciDurum, ke: &değişken KabukEkran) -> sonuç<mantıksal,metin> {
    eğer xb != 0 { eşleş bm_xsur(xb,x) { hata(e) => { ver hata(e); } tamam(v) => { } } }
    değişken indeks: tam32 = -1; değişken arno: tam32 = 0; değişken i: tam32 = 0;
    için a: x.aygitlar { değişken ar: UsbArayuz = dizi_al(a.yapi.arayuzlar,0); eğer ar.sinif == 3 ve ar.protokol == 1 { indeks=i; arno=ar.no; } i=i+1; }
    eğer indeks < 0 {
        eğer değil ps2_kesme_etkin() { eğer ps2_kur() < 0 { ver hata("PS2 baslatilamadi"); } }
    } değilse {
    eşleş usb_hid_set_protocol(arno,doğru) { hata(e) => { ver hata(e); } tamam(p) => { eşleş xhci_kontrol(x,indeks,p) { hata(e) => { ver hata(e); } tamam(v) => { } } } }
    eşleş bm_xsur(xb,x) { hata(e) => { ver hata(e); } tamam(v) => { } }
    eşleş usb_hid_set_idle(arno,0,0) { hata(e) => { ver hata(e); } tamam(p) => { eşleş xhci_kontrol(x,indeks,p) { hata(e) => { ver hata(e); } tamam(v) => { } } } }
    eşleş bm_xsur(xb,x) { hata(e) => { ver hata(e); } tamam(v) => { } }
    }
    eşleş kd_yeni() { hata(e) => { ver hata(e); } tamam(v) => { değişken d: KabukDisk = v;
        eşleş kd_bul(&değişken d,x,xb) { hata(e) => { ver hata(e); } tamam(v) => { } }
        eşleş kd_bagla(&değişken d) { hata(e) => { ver hata(e); } tamam(v) => { değişken f: FatSektor = v; ver kabuk(&değişken d,&değişken f,x,xb,indeks,ke); } }
    } }
}
işlev ke_kur() -> sonuç<KabukEkran, metin> {
    eşleş psf_coz(font_tr16()) { hata(m) => { ver hata(metin_birlestir("psf ", m)); } tamam(f) => {
        değişken e: Ekran = Ekran { fb:0, mmio:0, adim:0, gen:640, yuk:480, kimlik:0 };
        değişken var: mantıksal = yanlış;
        eğer uefi_mi() {
            eşleş uefi_bilgi() { hata(m) => { ver hata(m); } tamam(b) => {
                eşleş ekran_gop_ac(b,KE_ARKA) { hata(m) => { ver hata(m); } tamam(v) => { e=v; var=doğru; } }
            } }
        } değilse {
            eşleş ekran_bga_ac(640,480,KE_ARKA) { hata(m) => { } tamam(v) => { e=v; var=doğru; } }
        }
        eşleş konsol_yeni((e.gen-16)/f.genislik,(e.yuk-16)/f.yukseklik,KE_ON,KE_ARKA olarak tam32) {
            hata(m) => { ver hata(metin_birlestir("konsol ",m)); }
            tamam(k) => {
                değişken ke: KabukEkran = KabukEkran { var:var, e:e, f:f, k:k };
                eğer var { ekran_panik_kur(e,f); ekran_ayna_ac(); }
                ver tamam(ke);
            }
        }
    } }
}
işlev main() -> tam32 {
    eğer uefi_mi() {
        eşleş uefi_bilgi() { hata(e) => { bm_yaz(e); kem_qemu_cik(1); } tamam(b) => {
            uefi_dok(b);
            eşleş uefi_bellek_kur(b) { hata(e) => { bm_yaz(e); kem_qemu_cik(1); } tamam(v) => { } }
   eşleş uefi_acpi_dok(b) { hata(e) => { bm_yaz(e); kem_qemu_cik(1); } tamam(v) => { } }
   değişken fare_kimlik: tam32 = ps2_kesme_kur();
   eğer fare_kimlik < 0 { bm_yaz(metin_birlestir("PS2 IRQ KUR HATA ",tam_metin(fare_kimlik olarak tam64)));kem_qemu_cik(1); }
   kap_ps2_ac();bm_yaz("GIRDI PS2 IRQ1 IRQ12");bm_yaz("PS2_FARE 0 3");
        } }
    }
    eşleş ke_kur() { hata(e) => { bm_yaz(e); kem_qemu_cik(1); } tamam(v) => { değişken ke: KabukEkran = v;
    ekran_cift_yaz("KEMGU-OS kabuk v0");
    değişken bar: tam64 = 0;
    eşleş bm_pci_bul(12,3,48) { hata(e) => { } tamam(bdf) => {
        bar=(kem_pci_oku32(bdf,16)&4294967280)|(kem_pci_oku32(bdf,20)<<32);
        kem_pci_yaz32(bdf,4,kem_pci_oku32(bdf,4)|6);
    } }
    eşleş xhci_yeni(bm_dma_al(),16384) { hata(e) => { ekran_cift_yaz(e); kem_qemu_cik(1); } tamam(v) => {
        değişken x: XhciDurum = v;
        eşleş hazir(bar,&değişken x,&değişken ke) { hata(e) => { ekran_cift_yaz(metin_birlestir("KABUK HATA ",e)); kem_qemu_cik(1); } tamam(v) => { } }
    } }
    } } ver 0;
}
