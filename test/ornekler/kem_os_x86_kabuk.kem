// Bare-metal metin runtime'ında metin_esit yok; baytları mevcut ilkellerle karşılaştır.
işlev bm_esit(a: metin, b: metin) -> mantıksal {
    eğer metin_uzunluk(a) != metin_uzunluk(b) { ver yanlış; }
    değişken i: tam32 = 0;
    iken i < metin_uzunluk(a) { eğer metin_bayt(a,i) != metin_bayt(b,i) { ver yanlış; } i=i+1; }
    ver doğru;
}
// DMA: PVH varsayılanı veya UEFI fiziksel çerçeve tahsisi.
// [D-749] H4e ÇİFT ÇIKTI: her kabuk çıktısı seriye VE ekrana (runtime/mimari/x86_64/
// kem_ekran_bga.kem). Ekran açılamazsa kabuk yalnız seriyle sürer (var = yanlış).
sabit KE_ON: tam32 = 16777215;       // 0xFFFFFF
sabit KE_ARKA: tam64 = 1056832;      // 0x102040
yapı KabukEkran { var: mantıksal; e: Ekran; f: PsfFont; k: Konsol; }
işlev ke_ciz(ke: &değişken KabukEkran) {
    eğer değil ke.var { ver; }
    ekran_ayna_bosalt(&değişken ke.k);
    ekran_konsol_ciz(ke.e, ke.f, &değişken ke.k, 8, 8);
}
// Girdi yalnız ekrana çizilir: seri ve konsol geçmişi Enter'a kadar değişmez.
işlev ke_girdi(ke: &değişken KabukEkran, satir: SatirDuzenleyici) {
    eğer değil ke.var { ver; }
    değişken bas: tam32 = girdi_bas(satir.imlec,ke.k.sutunlar);
    değişken x: tam32 = 0;
    iken x < ke.k.sutunlar {
        değişken on: tam64 = KE_ON olarak tam64; değişken arka: tam64 = KE_ARKA;
        eğer x == 2 + satir.imlec - bas { on=KE_ARKA; arka=KE_ON olarak tam64; }
        ekran_kod(ke.e,ke.f,8+x*ke.f.genislik,8+ke.k.y*ke.f.yukseklik,
            girdi_kod(satir.kodlar,bas,x),on,arka);
        x=x+1;
    }
}
küresel değişken kl_arayuz: tam32 = 0;
küresel değişken kl_hid_indeksi: tam32 = 0;
çıplak işlev kl_indeks() -> tam32 { ver kl_hid_indeksi; }
işlev kl_usb_cagrisi(x: &değişken XhciDurum,bar: tam64,i: tam32,p: Dizi<dtam8>,veri: Dizi<dtam8>) -> sonuç<mantıksal,metin> {
    bh_yonet_bas(x);
    değişken devir: mantıksal = x.devredildi;
    x.devredildi=yanlış;
    değişken r: sonuç<mantıksal,metin> = xhci_kontrol_yaz(x,i,p,veri);
    x.devredildi=devir;
    eşleş r { hata(e) => { ver hata(e); } tamam(v) => { ver bd_xsur(bar,x); } }
}
işlev kl_usb_led(x: &değişken XhciDurum,bar: tam64,indeks: tam32,maske: tam32) -> sonuç<mantıksal,metin> {
    değişken arno: tam32 = 0; güvensiz { arno=kl_arayuz; }
    değişken veri: Dizi<dtam8> = bayt_sifir(1); yaz_u8(veri,0,maske olarak tam64);
    eşleş usb_setup(33,9,512,arno,1) { hata(e) => { ver hata(e); } tamam(p) => {
        ver kl_usb_cagrisi(x,bar,indeks,p,veri);
    } }
}
işlev kl_hidleri_sec(x: &değişken XhciDurum,bar: tam64) -> sonuç<mantıksal,metin> {
    değişken bos: Dizi<dtam8> = [];
    değişken kl: tam32 = -1; değişken fa: tam32 = -1; değişken arno: tam32 = 0;
    değişken i: tam32 = 0;
    iken i < dizi_boyut(x.aygitlar) {
        değişken a: XhciAygit = dizi_al(x.aygitlar,i);
        eğer a.yuva != 0 {
            için ar: a.yapi.arayuzlar {
                eğer ar.alternatif == 0 ve ar.sinif == 3 ve (ar.protokol == 1 veya ar.protokol == 2) {
                    eğer değil a.hid_hazir {
                        eşleş usb_hid_set_protocol(ar.no,doğru) { hata(e) => { ver hata(e); } tamam(p) => {
                            eşleş kl_usb_cagrisi(x,bar,i,p,bos) { hata(e) => { ver hata(e); } tamam(v) => { } }
                        } }
                        eğer ar.protokol == 1 {
                            eşleş usb_hid_set_idle(ar.no,0,0) { hata(e) => { ver hata(e); } tamam(p) => {
                                eşleş kl_usb_cagrisi(x,bar,i,p,bos) { hata(e) => { ver hata(e); } tamam(v) => { } }
                            } }
                        }
                    }
                    eğer ar.protokol == 1 ve (kl < 0 veya i == kl_indeks()) { kl=i; arno=ar.no; }
                    eğer ar.protokol == 2 ve (fa < 0 veya i == bh_fare()) { fa=i; }
                }
            }
            a=dizi_al(x.aygitlar,i); a.hid_hazir=doğru; dizi_yaz(x.aygitlar,i,a);
        }
        i=i+1;
    }
    güvensiz { kl_arayuz=arno; kl_hid_indeksi=kl; bh_fare_indeks=fa; }
    ver tamam(doğru);
}
işlev kl_led_degisti(x: &değişken XhciDurum,bar: tam64,indeks: tam32,tr: &değişken KlavyeDurumu,eski: tam32) {
    değişken yeni: tam32 = klavye_led(tr,indeks >= 0);
    eğer yeni == eski { ver; }
    eğer indeks < 0 {
        eğer değil ps2_led_yaz(yeni) { ekran_cift_yaz("KABUK HATA PS2 LED ACK"); ver; }
        kap_dok("PS2_LED",237,yeni olarak tam64,250);
    } değilse {
        eşleş kl_usb_led(x,bar,indeks,yeni) { hata(e) => { ekran_cift_yaz(metin_birlestir("KABUK HATA USB LED ",e)); }
            tamam(v) => { kap_dok("USB_LED",9,yeni olarak tam64,0); } }
    }
}
çıplak işlev ks_etkin_mi() -> mantıksal { ver kxs_havuz_dolu != 0; }
yapı KabukBag { indeks: tam32; bolum: DiskBolumu; kayit: BagKaydi; bpb: Fat32Bpb; yazilabilir: mantıksal; kirli: mantıksal; kesik: mantıksal; }
yapı KabukDisk { ram: RamDosyalar; ram_bag: tam32; aygitlar: Dizi<BlokDonanim>; baglar: Dizi<KabukBag>; kok: tam32; cwd: metin; uyari: metin; }
işlev kd_yeni() -> sonuç<KabukDisk,metin> { ver tamam(KabukDisk { ram:ramfs_yeni(0,0),ram_bag:-1,aygitlar:[],baglar:[],kok:-1,cwd:"/",uyari:"" }); }
işlev kd_oku(d: &değişken KabukDisk,indeks: tam32,lba: tam64,n: tam32) -> sonuç<Dizi<dtam8>,metin> {
    değişken a: BlokDonanim = dizi_al(d.aygitlar,indeks);
    değişken r: sonuç<Dizi<dtam8>,metin> = bd_ham_oku(&değişken a,lba,n);
    dizi_yaz(d.aygitlar,indeks,a);
    ver r;
}
işlev kd_giris(x: &değişken XhciDurum,indeks: tam32) -> sonuç<mantıksal,metin> {
    eğer bd_usb_olay_al() != 0 {
        ver xhci_depo_giris(x,indeks,8,bd_usb_bas_al(),bd_usb_dongu_al());
    }
    ver xhci_giris(x,indeks,8);
}
işlev kd_giris_son(x: &değişken XhciDurum) {
    eğer bd_usb_olay_al() != 0 { bd_usb_konum_koy(x.olay.taban,x.olay.bas,x.olay.dongu); }
}
işlev kd_bolumler(d: &değişken KabukDisk,indeks: tam32) -> sonuç<Dizi<DiskBolumu>,metin> {
    değişken a: BlokDonanim = dizi_al(d.aygitlar,indeks);
    değişken kapasite: tam64 = blok_kapasite(a.aygit);
    eşleş kd_oku(d,indeks,0,1) { hata(e) => { ver hata(e); } tamam(sifir) => {
        eğer değil gpt_mi(sifir) { ver mbr_kimlikli(sifir,kapasite); }
    } }
    eşleş kd_oku(d,indeks,1,1) { hata(e) => { ver hata(e); } tamam(baslik) => {
        eşleş gpt_konum(baslik,kapasite) { hata(e) => { ver hata(e); } tamam(k) => {
            eşleş kd_oku(d,indeks,k.lba,k.sektor) {
                hata(e) => { ver hata(e); } tamam(girdiler) => { ver gpt_kimlikli(k,girdiler); }
            }
        } }
    } }
}
işlev kd_bolum_ekle(d: &değişken KabukDisk,indeks: tam32,p: DiskBolumu,tur: metin,no: tam32) -> sonuç<mantıksal,metin> {
    eşleş kd_oku(d,indeks,p.bas,1) { hata(e) => { ver hata(e); } tamam(b) => {
        eşleş bpb_coz(b) {
            hata(e) => { ver tamam(yanlış); }
            tamam(bp) => {
                eğer bp.sektor_bayt != 512 veya bp.toplam_sektor > p.adet { ver hata("FAT32 bolum siniri"); }
                eşleş bag_bolum(tur,no,p.no,p.bas,b,p.tur,p.mbr_tur) { hata(e) => { ver hata(e); } tamam(bol) => {
                    değişken k: BagKaydi = BagKaydi { ad:bag_ad(bol),bolum:bol,kok:yanlış };
                    eğer (oku_u8(b,65)&1) != 0 { bm_yaz(metin_birlestir("UYARI kirli FAT32 ",k.ad)); }
                    değişken yeni: KabukBag = KabukBag { indeks:indeks,bolum:p,kayit:k,bpb:bp,yazilabilir:yanlış,kirli:yanlış,kesik:yanlış };
                    dizi_ekle(d.baglar,yeni);
                    ver tamam(doğru);
                } }
            }
        }
    } }
}
işlev kd_tur(a: BlokDonanim) -> metin {
    eşleş a.aygit.durum {
        BlokCesidi::Nvme(v) => { ver "nvme"; }
        BlokCesidi::Ahci(v) => { ver "sata"; }
        BlokCesidi::Usb(v) => { ver "usb"; }
        BlokCesidi::Ram(v) => { ver "ram"; }
    }
}
// Dosya zinciri boyunca bitişik LBA'ları tek DMA dizisine dönüştür.
işlev kd_gecici_kur(d: &değişken KabukDisk) -> sonuç<mantıksal,metin> {
    değişken say: tam32 = 8; değişken cer: CerceveAyirici = uefi_ayirici_al();
    eşleş ayir_ardisik(&değişken cer,say) { hiç => { ver hata("/ram icin sekiz cerceve yok"); } değer(taban) => {
        değişken adet: tam64 = (say olarak tam64)*8;
        eşleş ram_blok_yeni(taban,adet*512) { hata(e) => { serbest_ardisik(&değişken cer,taban,say); ver hata(e); } tamam(ram) => {
            değişken blok: BlokAygiti = BlokAygiti { durum:BlokCesidi::Ram(ram) };
            eşleş bd_yeni("/ram",0,blok) { hata(e) => { serbest_ardisik(&değişken cer,taban,say); ver hata(e); } tamam(ay) => {
                değişken i: tam32 = dizi_boyut(d.aygitlar); dizi_ekle(d.aygitlar,ay);
                // Ortak VFS okuma planı sektörleri çerçevelere eşler. Düğüm tablosu RAM'e aittir.
                değişken p: DiskBolumu = DiskBolumu {no:0,bas:0,adet:adet,tur:[],mbr_tur:0,kimlik:[]};
                değişken bol: BagBolum = BagBolum {aygit:"gecici",aygit_no:0,bolum_no:0,lba:0,seri:0,esp:yanlış};
                değişken kayit: BagKaydi = BagKaydi {ad:"/ram",bolum:bol,kok:yanlış};
                değişken geo: Fat32Bpb = Fat32Bpb {sektor_bayt:512,kume_sektor:8,ayrilmis:0,fat_sayisi:0,toplam_sektor:adet,fat_sektor:0,kok_kume:0,fsinfo:0,ilk_veri_sektoru:0,kume_sayisi:say olarak tam64};
                d.ram_bag=dizi_boyut(d.baglar); d.ram=ramfs_yeni(taban,say);
                dizi_ekle(d.baglar,KabukBag {indeks:i,bolum:p,kayit:kayit,bpb:geo,yazilabilir:doğru,kirli:yanlış,kesik:yanlış});
                ver tamam(doğru);
            } }
        } }
    } }
}
işlev kd_ram_yaz(d: &değişken KabukDisk,yol: metin,islem: FatYazIslem) -> sonuç<mantıksal,metin> {
    eşleş ramfs_yer(&d.ram,yol) { hata(e) => { ver hata(e); } tamam(y) => {
        değişken b: Dizi<dtam8> = []; değişken dizin: mantıksal = yanlış; değişken eski: mantıksal = yanlış;
        eşleş islem {
            FatYazIslem::DosyaSil => { ver ramfs_sil(&değişken d.ram,y,yanlış); }
            FatYazIslem::DizinSil => { ver ramfs_sil(&değişken d.ram,y,doğru); }
            FatYazIslem::DizinOlustur => { dizin=doğru; }
            FatYazIslem::Yaz(v) => { b=v; }
            FatYazIslem::Degistir(v) => { b=v; eski=doğru; }
        }
        eşleş ramfs_yaz(&değişken d.ram,y,dizi_boyut(b),dizin,eski) { hata(e) => { ver hata(e); } tamam(n) => {
            değişken i: tam32 = 0;
            için p: n.sayfalar {
                değişken a: tam64 = d.ram.taban+(p olarak tam64)*4096; değişken j: tam32 = 0;
                iken j < 4096 ve i < dizi_boyut(b) { kem_fiz_yaz8(a+(j olarak tam64),oku_u8(b,i)); i=i+1; j=j+1; }
            }
            ver tamam(doğru);
        } }
    } }
}
işlev kd_ram_aktar(a: &değişken BlokDonanim,lba: tam64,adet: tam64,adres: tam64) -> sonuç<mantıksal,metin> {
    değişken kalan: tam64 = adet; değişken hedef: tam64 = adres; değişken sektor: tam64 = lba;
    iken kalan > 0 {
        değişken n: tam64 = (65536-hedef%65536)/512; eğer n > kalan { n=kalan; }
        eşleş blok_cerceve_oku(&değişken a.aygit,sektor,n olarak tam32,hedef) { hata(e) => { ver hata(e); } tamam(v) => { } }
        eşleş bd_sur(a) { hata(e) => { ver hata(e); } tamam(v) => { } }
        hedef=hedef+n*512; kalan=kalan-n; sektor=sektor+n;
    }
    ver tamam(doğru);
}
işlev kd_ram_zincir(a: &değişken BlokDonanim,k: KabukBag,g: DizinGirdisi,adres: tam64,fat: tam64) -> sonuç<mantıksal,metin> {
    değişken sektor: tam64 = (k.bpb.kume_sayisi+129)/128;
    eğer sektor > k.bpb.fat_sektor { ver hata("ramdisk FAT boyu"); }
    eşleş kd_ram_aktar(a,k.bolum.bas+(k.bpb.ayrilmis olarak tam64),sektor,fat) { hata(e) => { ver hata(e); } tamam(v) => { } }
    değişken c: tam64 = g.ilk_kume; değişken kalan: tam64 = g.boyut/512;
    değişken hedef: tam64 = adres; değişken ks: tam64 = k.bpb.kume_sektor olarak tam64;
    iken kalan > 0 {
        değişken ilk: tam64 = c; değişken adet: tam64 = 0; değişken sirali: mantıksal = doğru;
        iken sirali ve kalan > 0 {
            eğer c < 2 veya c-2 >= k.bpb.kume_sayisi { ver hata("ramdisk FAT zinciri"); }
            değişken n: tam64 = ks; eğer n > kalan { n=kalan; }
            adet=adet+n; kalan=kalan-n;
            değişken son: tam64 = kem_mmio_oku32(fat+c*4)&268435455;
            sirali=son == c+1; c=son;
        }
        değişken bas: tam64 = kume_sektoru(k.bpb,ilk);
        eğer bas < 0 veya adet > k.bolum.adet-bas { ver hata("ramdisk bolum araligi"); }
        eşleş kd_ram_aktar(a,k.bolum.bas+bas,adet,hedef) { hata(e) => { ver hata(e); } tamam(v) => { } }
        hedef=hedef+adet*512;
    }
    eğer c < 268435448 { ver hata("ramdisk FAT zincir sonu"); }
    ver tamam(doğru);
}
işlev kd_ramdisk_bagla(d: &değişken KabukDisk,disk: BlokDonanim) -> sonuç<mantıksal,metin> {
    // Önce tüm bölüm tablosunu doğrula. Hatalı imaj bağlama tablosunu değiştiremez.
    eşleş kd_yeni() { hata(e) => { ver hata(e); } tamam(gecici) => {
        değişken aday: KabukDisk = gecici; dizi_ekle(aday.aygitlar,disk);
        eşleş kd_bolumler(&değişken aday,0) { hata(e) => { ver hata(e); } tamam(xs) => {
            için p: xs { eşleş kd_bolum_ekle(&değişken aday,0,p,"ram",0) { hata(e) => { ver hata(e); } tamam(v) => { } } }
        } }
        eğer dizi_boyut(aday.baglar) == 0 { ver hata("ramdisk FAT32 bolumu yok"); }
        değişken no: tam32 = dizi_boyut(d.aygitlar);
        dizi_ekle(d.aygitlar,dizi_al(aday.aygitlar,0));
        için k: aday.baglar { değişken bag: KabukBag = k; bag.indeks=no; dizi_ekle(d.baglar,bag); }
        ver tamam(doğru);
    } }
}
işlev kd_ramdisk_dosya(d: &değişken KabukDisk,k: KabukBag,g: DizinGirdisi) -> sonuç<mantıksal,metin> {
    eğer g.dizin_mi veya g.boyut < 1024 veya g.boyut%512 != 0 veya g.boyut > 134217728 { ver hata("ramdisk.img boyu 1 KiB..128 MiB ve sektor hizali olmali"); }
    değişken cer: CerceveAyirici = uefi_ayirici_al();
    değişken say: tam32 = ((g.boyut+4095)/4096) olarak tam32;
    değişken fs: tam32 = ((k.bpb.kume_sayisi+1025)/1024) olarak tam32;
    değişken adres: tam64 = 0; değişken fat: tam64 = 0;
    eşleş ayir_ardisik(&değişken cer,say) { hiç => { ver hata("ramdisk icin bitisik cerceve yok"); } değer(a) => { adres=a; } }
    eşleş ayir_ardisik(&değişken cer,fs) {
        hiç => { serbest_ardisik(&değişken cer,adres,say); ver hata("ramdisk FAT icin cerceve yok"); }
        değer(a) => { fat=a; }
    }
    değişken ay: BlokDonanim = dizi_al(d.aygitlar,k.indeks);
    değişken r: sonuç<mantıksal,metin> = kd_ram_zincir(&değişken ay,k,g,adres,fat);
    dizi_yaz(d.aygitlar,k.indeks,ay); serbest_ardisik(&değişken cer,fat,fs);
    eşleş r { hata(e) => { serbest_ardisik(&değişken cer,adres,say); ver hata(e); } tamam(v) => { } }
    eşleş ram_blok_yeni(adres,g.boyut) { hata(e) => { serbest_ardisik(&değişken cer,adres,say); ver hata(e); } tamam(ram) => {
        değişken blok: BlokAygiti = BlokAygiti { durum:BlokCesidi::Ram(ram) };
        eşleş bd_yeni("ram0",0,blok) { hata(e) => { serbest_ardisik(&değişken cer,adres,say); ver hata(e); } tamam(v) => {
            eşleş kd_ramdisk_bagla(d,v) {
                hata(e) => { serbest_ardisik(&değişken cer,adres,say); ver hata(e); } tamam(w) => { }
            }
        } }
    } }
    bm_yaz(kd_tamsayi(kd_tamsayi("RAMDISK fiziksel bayt",adres),g.boyut));
    ver tamam(doğru);
}
işlev kd_ramdisk_kur(d: &değişken KabukDisk) -> sonuç<mantıksal,metin> {
    eğer d.kok >= 0 {
        değişken kok: KabukBag = dizi_al(d.baglar,d.kok); değişken i: tam32 = 0;
        iken i < dizi_boyut(d.baglar) {
            değişken k: KabukBag = dizi_al(d.baglar,i);
            eğer k.indeks == kok.indeks {
                değişken y: KabukYol = KabukYol { indeks:i,yol:"/ramdisk.img" };
                eşleş kd_fat(d,y) { hata(e) => { ver hata(e); } tamam(dosya) => {
                    değişken f: FatSektor = dosya;
                    eşleş kv_bilgi(d,y,&değişken f) {
                        hata(e) => { eğer değil bm_esit(e,"bulunamadi") { ver hata(e); } }
                        tamam(g) => { ver kd_ramdisk_dosya(d,k,g); }
                    }
                } }
            }
            i=i+1;
        }
    }
    bm_yaz("ramdisk yok"); ver tamam(yanlış);
}
işlev kd_hub_diskleri(d: &değişken KabukDisk,x: &değişken XhciDurum,xb: tam64) -> sonuç<mantıksal,metin> {
    değişken i: tam32 = dizi_boyut(d.aygitlar);
    değişken no: tam32 = 0;
    için a: d.aygitlar { eğer bm_esit(kd_tur(a),"usb") { no=no+1; } }
    eşleş bd_usb_diskleri(x,xb,d.aygitlar) { hata(e) => { ver hata(e); } tamam(v) => { } }
    iken i < dizi_boyut(d.aygitlar) {
        eşleş kd_bolumler(d,i) { hata(e) => { ver hata(e); } tamam(xs) => {
            için p: xs { eşleş kd_bolum_ekle(d,i,p,"usb",no) { hata(e) => { ver hata(e); } tamam(v) => { } } }
        } }
        i=i+1; no=no+1;
    }
    ver tamam(doğru);
}
işlev kd_hub_bagli(d: &değişken KabukDisk,i: tam32) -> mantıksal {
    değişken a: BlokDonanim = dizi_al(d.aygitlar,i);
    ver a.nesil_adres == 0 veya kem_mmio_oku64(a.nesil_adres) == a.nesil;
}
işlev kd_bagla(d: &değişken KabukDisk) -> sonuç<mantıksal,metin> {
    değişken acilis: seçimlik<AcilisBolumu> = hiç;
    eşleş uefi_acilis_bolumu() {
        hata(e) => { bm_yaz(metin_birlestir("UYARI ",e)); }
        tamam(v) => { acilis=v; }
    }
    değişken nvno: tam32 = 0; değişken sano: tam32 = 0; değişken usno: tam32 = 0;
    değişken i: tam32 = 0;
    iken i < dizi_boyut(d.aygitlar) {
        değişken ay: BlokDonanim = dizi_al(d.aygitlar,i);
        değişken tur: metin = kd_tur(ay);
        değişken no: tam32 = usno;
        eğer bm_esit(tur,"nvme") { no=nvno; nvno=nvno+1; }
        değilse eğer bm_esit(tur,"sata") { no=sano; sano=sano+1; }
        değilse { usno=usno+1; }
        eşleş kd_bolumler(d,i) {
            hata(e) => { bm_yaz(metin_birlestir("UYARI ",metin_birlestir(ay.ad,metin_birlestir(" ",e)))); }
            tamam(xs) => {
                için p: xs {
                    eşleş kd_bolum_ekle(d,i,p,tur,no) { hata(e) => { bm_yaz(metin_birlestir("UYARI ",e)); } tamam(v) => { } }
                }
            }
        }
        i=i+1;
    }
    değişken eslesme: tam32 = 0;
    eşleş acilis {
        hiç => { }
        değer(a) => {
            i=0;
            iken i < dizi_boyut(d.baglar) {
                değişken k: KabukBag = dizi_al(d.baglar,i);
                eğer bolum_eslesir(a,k.bolum) { d.kok=i; eslesme=eslesme+1; }
                i=i+1;
            }
        }
    }
    eğer eslesme == 1 {
        değişken k: KabukBag = dizi_al(d.baglar,d.kok);
        k.kayit.kok=doğru;
        dizi_yaz(d.baglar,d.kok,k);
        bm_yaz(metin_birlestir("ACILIS_BOLUMU ",k.kayit.ad));
    } değilse {
        d.kok=-1;
        eğer dizi_boyut(d.baglar) == 1 ve eslesme == 0 {
            d.kok=0;
            d.uyari="UYARI acilis bolumu bilinmiyor; tek FAT32 salt okunur kok";
            // Eski PVH kabuğunun seri giriş protokolü sabittir. diskler ve yazma
            // reddi nedeni açıkça gösterir; tek bölüm asla yazılabilir varsayılmaz.
            eğer uefi_mi() { bm_yaz(d.uyari); }
        } değilse {
            d.uyari="UYARI acilis bolumu belirsiz; tum bolumler salt okunur";
            bm_yaz(d.uyari);
        }
    }
    ver tamam(doğru);
}
işlev kd_doldur(d: &değişken KabukDisk,k: KabukBag,f: &değişken FatSektor) -> sonuç<mantıksal,metin> {
    eğer f.gerekli < 0 veya f.gerekli >= k.bpb.toplam_sektor { ver hata("bolum disi okuma"); }
    değişken a: BlokDonanim = dizi_al(d.aygitlar,k.indeks);
    değişken r: sonuç<Dizi<dtam8>,metin> = bd_oku(&değişken a,k.bolum.bas+f.gerekli);
    dizi_yaz(d.aygitlar,k.indeks,a);
    eşleş r { hata(e) => { ver hata(e); } tamam(b) => { ver fat_sektor_koy(f,f.gerekli,b); } }
}
yapı KabukYol { indeks: tam32; yol: metin; }
işlev kd_yol(d: &değişken KabukDisk,yol: metin) -> sonuç<KabukYol,metin> {
    eşleş yol_bol(yol) { hata(e) => { ver hata(e); } tamam(xs) => {
        eğer d.ram_bag >= 0 ve dizi_boyut(xs) >= 1 ve bm_esit(dizi_al(xs,0),"ram") {
            değişken alt: Dizi<metin> = []; değişken n: tam32 = 1;
            iken n < dizi_boyut(xs) { dizi_ekle(alt,dizi_al(xs,n)); n=n+1; }
            ver tamam(KabukYol {indeks:d.ram_bag,yol:yol_birlestir(alt)});
        }
        eğer dizi_boyut(xs) >= 2 ve bm_esit(dizi_al(xs,0),"diskler") {
            değişken ad: metin = metin_birlestir("/diskler/",dizi_al(xs,1));
            değişken i: tam32 = 0;
            iken i < dizi_boyut(d.baglar) {
                değişken k: KabukBag = dizi_al(d.baglar,i);
                eğer bm_esit(k.kayit.ad,ad) {
                    değişken kalan: Dizi<metin> = []; değişken j: tam32 = 2;
                    iken j < dizi_boyut(xs) { dizi_ekle(kalan,dizi_al(xs,j)); j=j+1; }
                    ver tamam(KabukYol { indeks:i,yol:yol_birlestir(kalan) });
                }
                i=i+1;
            }
            ver hata("baglama bulunamadi");
        }
        eğer d.kok < 0 { ver hata("kok bulunamadi; /diskler kullanin"); }
        ver tamam(KabukYol { indeks:d.kok,yol:yol_birlestir(xs) });
    } }
}
işlev kd_diskler(d: &değişken KabukDisk) {
    eğer metin_uzunluk(d.uyari) > 0 { ekran_cift_yaz(d.uyari); }
    için k: d.baglar { eğer değil bm_esit(k.kayit.ad,"/ram") ve kd_hub_bagli(d,k.indeks) {
        değişken kip: metin = " salt okunur";
        eşleş yazma_izni(k.kayit,k.yazilabilir) { hata(e) => { } tamam(v) => { kip=" yazilabilir"; } }
        eğer k.kayit.bolum.esp { kip=" ESP salt okunur"; }
        eğer k.kayit.kok { kip=metin_birlestir(kip," kok"); }
        ekran_cift_yaz(metin_birlestir(k.kayit.ad,kip)); }
    }
}
işlev kd_yazilabilir(d: &değişken KabukDisk,ad: metin) -> sonuç<mantıksal,metin> {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(d.baglar) {
        değişken k: KabukBag = dizi_al(d.baglar,i);
        eğer bm_esit(k.kayit.ad,ad) veya bm_esit(k.kayit.ad,metin_birlestir("/diskler/",ad)) {
            eşleş yazma_izni(k.kayit,doğru) {
                hata(e) => { ver hata(e); }
                tamam(v) => {
                    eşleş kd_durum(d,&değişken k,doğru) { hata(e) => { ver hata(e); } tamam(w) => { } }
                    k.yazilabilir=doğru;
                    dizi_yaz(d.baglar,i,k);
                    ver tamam(doğru);
                }
            }
        }
        i=i+1;
    }
    ver hata("baglama bulunamadi");
}
// BPB state bit0 (Linux msdos_fs.h): fsck.fat 4.2 ana ve yedek imajda ölçüldü.
işlev kd_durum_aygit(a: &değişken BlokDonanim,k: &değişken KabukBag,kirli: mantıksal) -> sonuç<mantıksal,metin> {
    eşleş yazma_izni(k.kayit,doğru) { hata(e) => { ver hata(e); } tamam(v) => { } }
    eşleş bd_oku(a,k.bolum.bas) { hata(e) => { ver hata(e); } tamam(b) => {
        değişken bayrak: tam32 = oku_u8(b,65);
        değişken yedek: tam32 = oku_le16(b,50);
        eğer yedek > 0 ve yedek < k.bpb.ayrilmis {
            eşleş bd_oku(a,k.bolum.bas+(yedek olarak tam64)) { hata(e) => { ver hata(e); } tamam(y) => {
                eşleş bpb_coz(y) { hata(e) => { ver hata("yedek BPB gecersiz"); } tamam(v) => { } }
                değişken f: tam32 = oku_u8(y,65)&254;
                eğer kirli { f=f|1; }
                yaz_u8(y,65,f olarak tam64);
                eşleş bd_koy(a,k.bolum.bas+(yedek olarak tam64),y,doğru) { hata(e) => { ver hata(e); } tamam(v) => { } }
            } }
        }
        bayrak=bayrak&254;
        eğer kirli { bayrak=bayrak|1; }
        yaz_u8(b,65,bayrak olarak tam64);
        eşleş bd_koy(a,k.bolum.bas,b,doğru) { hata(e) => { ver hata(e); } tamam(v) => { } }
        eşleş bd_bosalt(a) { hata(e) => { ver hata(e); } tamam(v) => { k.kirli=kirli; ver tamam(doğru); } }
    } }
}
işlev kd_durum(d: &değişken KabukDisk,k: &değişken KabukBag,kirli: mantıksal) -> sonuç<mantıksal,metin> {
    değişken ay: BlokDonanim = dizi_al(d.aygitlar,k.indeks);
    değişken r: sonuç<mantıksal,metin> = kd_durum_aygit(&değişken ay,k,kirli);
    dizi_yaz(d.aygitlar,k.indeks,ay);
    ver r;
}
işlev kd_kok_durum(d: &değişken KabukDisk) -> sonuç<mantıksal,metin> {
    eğer d.kok < 0 { ver tamam(doğru); }
    değişken k: KabukBag = dizi_al(d.baglar,d.kok);
    eşleş yazma_izni(k.kayit,k.yazilabilir) { hata(e) => { ver tamam(doğru); } tamam(v) => { } }
    eşleş kd_durum(d,&değişken k,doğru) { hata(e) => { ver hata(e); } tamam(v) => { } }
    dizi_yaz(d.baglar,d.kok,k);
    ver tamam(doğru);
}
işlev kd_sync(d: &değişken KabukDisk) -> sonuç<mantıksal,metin> {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(d.baglar) {
        değişken k: KabukBag = dizi_al(d.baglar,i);
        eğer k.kesik { ver hata("FAT32 kesik yazma; kirli bayrak korundu"); }
        eğer k.kirli {
            eşleş kd_durum(d,&değişken k,yanlış) { hata(e) => { ver hata(e); } tamam(v) => { } }
            dizi_yaz(d.baglar,i,k);
        }
        i=i+1;
    }
    ver tamam(doğru);
}
işlev kd_yaz_uygula(a: &değişken BlokDonanim,k: &değişken KabukBag,p: Dizi<FatDegisiklik>) -> sonuç<mantıksal,metin> {
    eğer değil k.kirli {
        eşleş kd_durum_aygit(a,k,doğru) { hata(e) => { ver hata(e); } tamam(v) => { } }
    }
    değişken asama: tam32 = 0;
    iken asama < 4 {
        değişken yazildi: mantıksal = yanlış;
        için s: p {
            eğer s.asama == asama {
                eğer s.lba < 1 veya s.lba >= k.bpb.toplam_sektor { ver hata("bolum disi yazma"); }
                eşleş bd_koy(a,k.bolum.bas+s.lba,s.veri,doğru) { hata(e) => { ver hata(e); } tamam(v) => { } }
                yazildi=doğru;
            }
        }
        eğer yazildi {
            eşleş bd_bosalt(a) { hata(e) => { ver hata(e); } tamam(v) => { } }
        }
        asama=asama+1;
    }
    ver tamam(doğru);
}
küresel değişken kd_icerik_surumu: tam64 = 0;
işlev kd_yazma_izni(d: &değişken KabukDisk,y: KabukYol) -> sonuç<mantıksal,metin> {
    değişken k: KabukBag = dizi_al(d.baglar,y.indeks);
    eğer k.kesik { ver hata("FAT32 kesik yazma; kirli bayrak korundu"); }
    eğer y.indeks == d.kok ve değil k.kayit.kok ve değil k.yazilabilir {
        ver hata("acilis bolumu bilinmiyor; kok salt okunur");
    }
    ver yazma_izni(k.kayit,k.yazilabilir);
}
işlev kd_yaz(d: &değişken KabukDisk,y: KabukYol,f: &değişken FatSektor,islem: FatYazIslem) -> sonuç<mantıksal,metin> {
    eşleş kd_yazma_izni(d,y) { hata(e) => { ver hata(e); } tamam(v) => { } }
    eğer y.indeks == d.ram_bag {
        eşleş kd_ram_yaz(d,y.yol,islem) { hata(e) => { ver hata(e); } tamam(v) => { güvensiz { kd_icerik_surumu=kd_icerik_surumu+1; } ver tamam(v); } }
    }
    değişken k: KabukBag = dizi_al(d.baglar,y.indeks);
    değişken saat: FatZaman = fat_zaman_varsayilan();
    eşleş islem {
        FatYazIslem::DosyaSil => { } FatYazIslem::DizinSil => { }
        _ => { eşleş rtc_oku() { hata(e) => { } tamam(rtc_an) => {
            saat.tarih=((rtc_an.yil-1980)<<9)|(rtc_an.ay<<5)|rtc_an.gun;
            saat.saat=(rtc_an.saat<<11)|(rtc_an.dakika<<5)|(rtc_an.saniye/2);
            saat.salise=(rtc_an.saniye%2)*100;
        } } }
    }
    değişken i: tam32 = 0;
    iken i < 257 {
        eşleş fat_yaz_plan_saat(f,y.yol,islem,saat) {
            hata(e) => { eğer f.gerekli < 0 { ver hata(e); } }
            tamam(p) => {
                güvensiz { kd_icerik_surumu=kd_icerik_surumu+1; }
                değişken a: BlokDonanim = dizi_al(d.aygitlar,k.indeks);
                değişken r: sonuç<mantıksal,metin> = kd_yaz_uygula(&değişken a,&değişken k,p);
                dizi_yaz(d.aygitlar,k.indeks,a);
                eşleş r { hata(e) => { k.kesik=doğru; } tamam(v) => { } }
                dizi_yaz(d.baglar,y.indeks,k);
                ver r;
            }
        }
        eşleş kd_doldur(d,k,f) { hata(e) => { ver hata(e); } tamam(v) => { } }
        i=i+1;
    }
    ver hata("sektor tekrar siniri");
}
işlev kd_liste(d: &değişken KabukDisk,y: KabukYol,f: &değişken FatSektor) -> sonuç<Dizi<DizinGirdisi>,metin> {
    eğer y.indeks == d.ram_bag { ver ramfs_liste(&d.ram,y.yol); }
    değişken k: KabukBag = dizi_al(d.baglar,y.indeks);
    değişken i: tam32 = 0;
    iken i < 257 {
        eşleş fat_sektor_listele(f,y.yol) {
            tamam(xs) => { ver tamam(xs); }
            hata(e) => { eğer f.gerekli == 0 { ver hata(e); } }
        }
        eşleş kd_doldur(d,k,f) { hata(e) => { ver hata(e); } tamam(v) => { } }
        i=i+1;
    }
    ver hata("sektor tekrar siniri");
}
işlev kd_fat(d: &değişken KabukDisk,y: KabukYol) -> sonuç<FatSektor,metin> {
    değişken k: KabukBag = dizi_al(d.baglar,y.indeks);
    ver fat_sektor_yeni(k.bpb);
}
işlev kd_mutasyon(d: &değişken KabukDisk,y: KabukYol,islem: FatYazIslem) -> sonuç<mantıksal,metin> {
    eşleş kd_fat(d,y) { hata(e) => { ver hata(e); } tamam(v) => {
        değişken f: FatSektor = v;
        ver kd_yaz(d,y,&değişken f,islem);
    } }
}
işlev kd_icerik(d: &değişken KabukDisk,y: KabukYol) -> sonuç<Dizi<dtam8>,metin> {
    ver kv_tum(d,y,65536);
}
işlev kd_kopyala(d: &değişken KabukDisk,src: KabukYol,dst: KabukYol,tasi: mantıksal) -> sonuç<mantıksal,metin> {
    eğer src.indeks == dst.indeks ve yol_bilesen_esit(src.yol,dst.yol) { ver hata("kaynak ve hedef ayni"); }
    eğer tasi ve src.indeks == d.ram_bag ve dst.indeks == d.ram_bag {
        eşleş ramfs_yer(&d.ram,src.yol) { hata(e) => { ver hata(e); } tamam(a) => {
            eşleş ramfs_yer(&d.ram,dst.yol) { hata(e) => { ver hata(e); } tamam(b) => {
                eşleş ramfs_tasi(&değişken d.ram,a,b) { hata(e) => { ver hata(e); } tamam(v) => { güvensiz { kd_icerik_surumu=kd_icerik_surumu+1; } ver tamam(v); } }
            } }
        } }
    }
    eğer tasi {
        değişken k: KabukBag = dizi_al(d.baglar,src.indeks);
        eşleş yazma_izni(k.kayit,k.yazilabilir) { hata(e) => { ver hata(e); } tamam(v) => { } }
    }
    değişken hedef: KabukBag = dizi_al(d.baglar,dst.indeks);
    eşleş yazma_izni(hedef.kayit,hedef.yazilabilir) { hata(e) => { ver hata(e); } tamam(v) => { } }
    eşleş kd_icerik(d,src) { hata(e) => { ver hata(e); } tamam(b) => {
        eşleş kd_mutasyon(d,dst,FatYazIslem::Yaz(b)) { hata(e) => { ver hata(e); } tamam(v) => { } }
    } }
    // Önce hedef kalıcı. Silme başarısızsa kaynak ve kopya birlikte kalabilir.
    eğer tasi { ver kd_mutasyon(d,src,FatYazIslem::DosyaSil); }
    ver tamam(doğru);
}
işlev kd_bosluk(s: metin) -> tam32 {
    değişken i: tam32 = 0;
    iken i < metin_uzunluk(s) ve metin_bayt(s,i) != (32 olarak tam8) { i=i+1; }
    ver i;
}
işlev kd_bas(s: metin,i: tam32) -> metin { ver metin_kes(s,0,i); }
işlev kd_kalan(s: metin,i: tam32) -> metin {
    değişken n: tam32 = metin_uzunluk(s) olarak tam32;
    eğer i >= n { ver ""; }
    ver metin_kes(s,i+1,n-i-1);
}
işlev kd_mutlak(cwd: metin,yol: metin) -> sonuç<metin,metin> {
    değişken mutlak: metin = yol;
    eğer metin_uzunluk(yol) == 0 { mutlak=cwd; }
    değilse eğer metin_bayt(yol,0) != (47 olarak tam8) {
        mutlak=metin_birlestir(metin_birlestir(cwd,"/"),yol);
    }
    eşleş yol_bol(mutlak) {
        hata(e) => { ver hata(e); } tamam(v) => { ver tamam(yol_birlestir(v)); }
    }
}
işlev kd_komut_yol(d: &değişken KabukDisk,cmd: metin,yol: metin,son: metin) -> sonuç<mantıksal,metin> {
    eğer (bm_esit(cmd,"ls") veya bm_esit(cmd,"cd")) ve (bm_esit(yol,"/diskler") veya (bm_esit(yol,"/") ve d.kok < 0)) {
        eğer bm_esit(cmd,"cd") { d.cwd=yol; }
        değilse eğer bm_esit(yol,"/") { ekran_cift_yaz("diskler/"); eğer d.ram_bag >= 0 { ekran_cift_yaz("ram/"); } }
        değilse { kd_diskler(d); }
        ver tamam(doğru);
    }
    eşleş kd_yol(d,yol) { hata(e) => { ver hata(e); } tamam(ky) => {
        eğer bm_esit(cmd,"yaz") {
            değişken b: Dizi<dtam8> = bayt_sifir(metin_uzunluk(son) olarak tam32);
            değişken i: tam32 = 0;
            iken i < dizi_boyut(b) { yaz_u8(b,i,((metin_bayt(son,i) olarak tam32)&255) olarak tam64); i=i+1; }
            ver kd_mutasyon(d,ky,FatYazIslem::Yaz(b));
        }
        eğer bm_esit(cmd,"sil") { ver kd_mutasyon(d,ky,FatYazIslem::DosyaSil); }
        eğer bm_esit(cmd,"mkdir") { ver kd_mutasyon(d,ky,FatYazIslem::DizinOlustur); }
        eğer bm_esit(cmd,"rmdir") {
            eşleş kd_yol(d,d.cwd) { hata(e) => { } tamam(cur) => {
                eğer cur.indeks == ky.indeks ve yol_bilesen_esit(cur.yol,ky.yol) { ver hata("gecerli dizin"); }
            } }
            ver kd_mutasyon(d,ky,FatYazIslem::DizinSil);
        }
        eğer bm_esit(cmd,"mv") veya bm_esit(cmd,"cp") {
            eşleş kd_mutlak(d.cwd,son) { hata(e) => { ver hata(e); } tamam(h) => {
                eşleş kd_yol(d,h) { hata(e) => { ver hata(e); } tamam(dst) => { ver kd_kopyala(d,ky,dst,bm_esit(cmd,"mv")); } }
            } }
        }
        eğer bm_esit(cmd,"cat") {
            eşleş kd_icerik(d,ky) { hata(e) => { ver hata(e); } tamam(b) => {
                değişken i: tam32 = 0;
                iken i < dizi_boyut(b) { ekran_cift_bayt(oku_u8(b,i)&255); i=i+1; }
                eğer i == 0 { ekran_cift_bayt(10); }
                değilse eğer oku_u8(b,i-1) != 10 { ekran_cift_bayt(10); }
                ver tamam(doğru);
            } }
        }
        eşleş kd_fat(d,ky) { hata(e) => { ver hata(e); } tamam(v) => {
            değişken f: FatSektor = v;
            eşleş kd_liste(d,ky,&değişken f) { hata(e) => { ver hata(e); } tamam(xs) => {
                eğer bm_esit(cmd,"cd") { d.cwd=yol; ver tamam(doğru); }
                eğer d.ram_bag >= 0 ve bm_esit(yol,"/") { ekran_cift_yaz("ram/"); }
                için g: xs {
                    eğer değil bm_esit(g.ad,".") ve değil bm_esit(g.ad,"..") {
                        eğer g.dizin_mi { ekran_cift_yaz(metin_birlestir(g.ad,"/")); }
                        değilse { ekran_cift_yaz(g.ad); }
                    }
                }
                ver tamam(doğru);
            } }
        } }
    } }
}
işlev ks_vektor_ad(v: tam64) -> metin {
    eğer v == 15 { ver "sonlandir"; } eğer v == 0 { ver "#DE"; } eğer v == 6 { ver "#UD"; }
    eğer v == 7 { ver "#NM"; } eğer v == 13 { ver "#GP"; }
    eğer v == 14 { ver "#PF"; }
    ver metin_birlestir("vektor=",tam_metin(v));
}
işlev ks_hex(adr: tam64) -> metin {
    değişken s: metin = "";
    değişken d: tam32 = 0;
    değişken n: tam64 = adr;
    iken n != 0 veya d == 0 {
        s=metin_birlestir(metin_kes("0123456789abcdef",(n&15) olarak tam32,1),s);
        n=(n>>4)&1152921504606846975;
        d=d+1;
    }
    ver metin_birlestir("0x",s);
}
işlev ks_sonuc(ad: metin,s: &KxsSonuc) {
    değişken m: metin = metin_birlestir(metin_birlestir("[",ad)," pid=");
    m=metin_birlestir(m,tam_metin(s.pid));
    eğer s.bitti {
        ekran_cift_yaz(metin_birlestir(metin_birlestir(metin_birlestir(m," cikis="),tam_metin(s.kod)),"]"));
    } değilse {
        m=metin_birlestir(metin_birlestir(m," SONLANDIRILDI: "),ks_vektor_ad(s.vektor));
        eğer s.vektor == 14 { m=metin_birlestir(metin_birlestir(m," adr="),ks_hex(s.cr2)); }
        ekran_cift_yaz(metin_birlestir(m," (kullanici)]"));
    }
}
// Önbellek ELF'in segmentlerini ve bu segmentlerin disk konumlarını tutar.
// FAT32 nesli değiştiğinde eski okuma planı yeniden kullanılmaz.
yapı KsElfParca { lba: tam64; sektor: tam32; bas: tam32; boy: tam32; sanal: tam64; }
yapı KsProgram { onbellek: tam64; sicak: mantıksal; var: mantıksal; surum: tam64; yol: metin; cwd: metin; ad: metin; aygit: tam32; parcalar: Dizi<KsElfParca>; plan: Elf64; }
işlev ks_elf_plan(d: &değişken KabukDisk,y: KabukYol,f: &değişken FatSektor,g: DizinGirdisi,p: &değişken KsProgram) -> sonuç<mantıksal,metin> {
    eğer g.dizin_mi veya g.boyut < 64 { ver hata("ELF basligi eksik"); }
    eşleş kv_aralik(d,y,f,g,0,64) { hata(e) => { ver hata(e); } tamam(b) => {
        değişken ofset: tam64 = oku_le64(b,32);
        değişken n: tam32 = oku_le16(b,56);
        eğer n < 1 veya n > 256 veya ofset < 64 veya ofset > g.boyut veya (n olarak tam64)*56 > g.boyut-ofset { ver hata("ELF program basligi siniri"); }
        eşleş kv_aralik(d,y,f,g,ofset,n*56) { hata(e) => { ver hata(e); } tamam(t) => {
            eşleş elf64_plan(b,t,0,g.boyut) { hata(e) => { ver hata(metin_birlestir("ELF ",e)); } tamam(plan) => {
                eğer değil kxs_segmentler(plan,kxs_yer(plan.giris)) { ver hata("ELF surec penceresi veya izinleri"); }
                p.plan=plan;
            } }
        } }
    } }
    değişken k: KabukBag = dizi_al(d.baglar,y.indeks);
    p.parcalar=[]; p.aygit=k.indeks;
    için s: p.plan.yuklemeler {
        değişken atla: tam64 = 0;
        iken atla < s.dosya_boyu {
            değişken n: tam64 = s.dosya_boyu-atla;
            eğer n > 16384 { n=16384; }
            eşleş kv_parcalar(d,k,f,g,s.dosya_ofseti+atla,n olarak tam32) { hata(e) => { ver hata(e); } tamam(ps) => {
                değişken alinan: tam64 = 0;
                için q: ps {
                    eğer q.lba < 0 veya q.sektor <= 0 veya (q.sektor olarak tam64) > k.bpb.toplam_sektor-q.lba
                        veya q.bas < 0 veya q.bayt < 1 veya (q.bayt olarak tam64) > n-alinan { ver hata("ELF okuma plani"); }
                    dizi_ekle(p.parcalar,KsElfParca {lba:k.bolum.bas+q.lba,sektor:q.sektor,
                        bas:q.bas,boy:q.bayt,sanal:s.sanal_adres+atla+alinan});
                    alinan=alinan+(q.bayt olarak tam64);
                }
                eğer alinan != n { ver hata("ELF eksik parca"); }
            } }
            atla=atla+n;
        }
    }
    ver tamam(doğru);
}
işlev ks_program_hazirla(d: &değişken KabukDisk,p: &değişken KsProgram,girdi: metin) -> sonuç<mantıksal,metin> {
    değişken surum: tam64 = 0;
    güvensiz { surum=kd_icerik_surumu; }
    eğer p.var ve p.surum == surum ve bm_esit(p.yol,girdi) ve bm_esit(p.cwd,d.cwd) { ver tamam(doğru); }
    p.var=yanlış; p.sicak=yanlış;
    eşleş kd_mutlak(d.cwd,girdi) { hata(e) => { ver hata(e); } tamam(yol) => {
    eşleş kd_yol(d,yol) { hata(e) => { ver hata(e); } tamam(y) => {
    eşleş kd_fat(d,y) { hata(e) => { ver hata(e); } tamam(fat) => {
        değişken f: FatSektor = fat;
        eşleş kv_bilgi(d,y,&değişken f) { hata(e) => { ver hata(e); } tamam(g) => {
            eşleş ks_elf_plan(d,y,&değişken f,g,p) { hata(e) => { ver hata(e); } tamam(v) => { } }
        } }
    } }
    eşleş yol_bol(yol) { hata(e) => { ver hata(e); } tamam(adlar) => {
        eğer dizi_boyut(adlar) == 0 { ver hata("ELF dosya adi"); }
        p.ad=dizi_al(adlar,dizi_boyut(adlar)-1); p.var=doğru; p.surum=surum; p.yol=girdi; p.cwd=d.cwd;
        ver tamam(doğru);
    } } } } } }
}
çıplak işlev ks_parca_kopyala(b: Dizi<dtam8>,bas: tam32,boy: tam32,hedef: tam64) -> mantıksal {
    eğer bas < 0 veya boy > dizi_boyut(b)-bas { ver yanlış; }
    değişken i: tam32 = 0;
    iken i < boy { kxr_y8(hedef+(i olarak tam64),dizi_al(b,bas+i)); i=i+1; }
    ver doğru;
}
// Son programın yüklenebilir verisi bir okuma parçasına sığıyorsa, aynı
// 16 KiB alanı yeniden kullan. FAT nesli değiştiğinde görünüm geçersizleşir.
çıplak işlev ks_on_kopyala(p: &değişken KsProgram,y: tam64,doldur: mantıksal) {
    güvensiz {
        değişken yer: KxsYer = kxs_yer(p.plan.giris);
        değişken fizik: tam64 = kxm_o64(kxs_baglam(y)+KXS_CR3_OFS)+(yer.tablo olarak tam64)*4096;
        değişken n: tam64 = 0;
        için q: p.parcalar { n=n+(q.boy olarak tam64); }
        eğer n > 16384 { ver; }
        eğer p.onbellek == 0 { p.onbellek=malloc(16384) olarak tam64; }
        eğer p.onbellek == 0 { ver; }
        değişken i: tam64 = 0;
        için q: p.parcalar {
            değişken f: tam64 = fizik+q.sanal-yer.alt;
            değişken h: tam64 = p.onbellek+i;
            eğer doldur { memcpy(h olarak *tam8,f olarak *tam8,q.boy olarak tam64); }
            değilse { memcpy(f olarak *tam8,h olarak *tam8,q.boy olarak tam64); }
            i=i+(q.boy olarak tam64);
        }
        p.sicak=doğru;
    }
}
işlev ks_elf_aktar(d: &değişken KabukDisk,p: &KsProgram,y: tam64) -> sonuç<mantıksal,metin> {
    değişken yer: KxsYer = kxs_yer(p.plan.giris);
    değişken fizik: tam64 = kxm_o64(kxs_baglam(y)+KXS_CR3_OFS)+(yer.tablo olarak tam64)*4096;
    değişken a: BlokDonanim = dizi_al(d.aygitlar,p.aygit);
    için q: p.parcalar {
        değişken hedef: tam64 = fizik+(q.sanal-yer.alt);
        // Küçük segmentlerde mevcut 64 sektörlük blok önbelleğini paylaş.
        // Büyük aktarımlarda tek okuma en fazla 16 KiB segment verisi taşır.
        eğer q.sektor <= 8 {
            değişken i: tam32 = 0;
            değişken kalan: tam32 = q.boy;
            değişken bas: tam32 = q.bas;
            iken i < q.sektor {
                değişken n: tam32 = 512-bas; eğer n > kalan { n=kalan; }
                eşleş bd_oku(&değişken a,q.lba+(i olarak tam64)) {
                    hata(e) => { dizi_yaz(d.aygitlar,p.aygit,a); ver hata(e); }
                    tamam(b) => { eğer değil ks_parca_kopyala(b,bas,n,hedef) { ver hata("ELF kisa sektor"); } }
                }
                bas=0; kalan=kalan-n; hedef=hedef+(n olarak tam64); i=i+1;
            }
        } değilse {
            eşleş bd_ham_oku(&değişken a,q.lba,q.sektor) {
                hata(e) => { dizi_yaz(d.aygitlar,p.aygit,a); ver hata(e); }
                tamam(b) => { eğer değil ks_parca_kopyala(b,q.bas,q.boy,hedef) { ver hata("ELF kisa okuma"); } }
            }
        }
    }
    dizi_yaz(d.aygitlar,p.aygit,a);
    ver tamam(doğru);
}
küresel değişken ks_yonetim: tam64 = 0;
yapı KsKabukSureci {
    son_program: KsProgram; baglamlar: Dizi<KsvBaglam>; adlar: Dizi<metin>;
    sonraki: tam64; son_kod: tam64; beklenen: tam64;
}

işlev ks_baslat(p: &değişken KsKabukSureci,b: &değişken KsvBaglam,argv: Dizi<metin>,ebeveyn: tam64) -> sonuç<tam64,metin> {
    değişken yol: metin = dizi_al(argv,0);
    eşleş ks_program_hazirla(&değişken b.disk,&değişken p.son_program,yol) { hata(e) => { ver hata(e); } tamam(v) => { } }
    güvensiz {
        eğer ebeveyn == 0 { kxs_heap_iz(0); }
        eşleş kxs_hazirla(uefi_surec_ayirici,p.son_program.plan,argv,ebeveyn) {
            hata(e) => { ver hata(e); }
            tamam(yuva) => {
                eğer p.son_program.sicak { ks_on_kopyala(&değişken p.son_program,yuva,yanlış); }
                değilse {
                eşleş ks_elf_aktar(&değişken b.disk,&p.son_program,yuva) {
                    hata(e) => {
                        değişken r: tam64 = kxs_baglam(yuva);
                        uefi_surec_iade(kxm_o64(r+KXS_CR3_OFS),kxs_cerceve_sayisi(kxs_yer(p.son_program.plan.giris)));
                        kxs_yuva_serbest(yuva); memset(r olarak *tam8,0,KXS_KAYIT_BOYU);
                        ver hata(e);
                    }
                    tamam(v) => { ks_on_kopyala(&değişken p.son_program,yuva,doğru); }
                }
                }
                değişken i: tam32 = yuva olarak tam32;
                değişken yeni: KsvBaglam = dizi_al(p.baglamlar,i);
                yeni.disk=b.disk; yeni.x=b.x; yeni.h=b.h; yeni.tr=b.tr;
                yeni.olay_konum=dizi_boyut(yeni.olaylar); yeni.ilk_tus=doğru; yeni.dilim_calisti=yanlış; yeni.bekleme_kurulu=yanlış; yeni.fare_durum=fare_yeni(ps2_teker_var());
                yeni.degisti=yanlış;
                dizi_yaz(p.baglamlar,i,yeni);
                dizi_yaz(p.adlar,i,p.son_program.ad);
                ver tamam(yuva);
            }
        }
    }
}
çıplak işlev ks_bitti(durum: tam64) -> mantıksal {
    ver durum == KXS_BITTI veya durum == KXS_OLDURULDU;
}
çıplak işlev ks_durum(yuva: tam64) -> tam64 { ver kxm_o64(kxs_baglam(yuva)+KXS_DURUM_OFS); }
çıplak işlev ks_pid(yuva: tam64) -> tam64 { ver kxm_o64(kxs_baglam(yuva)+KXS_PID_OFS); }
işlev ks_durum_adi(durum: tam64) -> metin {
    eğer durum == KXS_HAZIR { ver "hazir"; }
    eğer durum == KXS_UYUYOR { ver "uyuyor"; }
    eğer durum == KXS_COCUK_BEKLIYOR { ver "bekle"; }
    eğer durum == KXS_TUS_BEKLIYOR { ver "girdi"; }
    eğer durum == KXS_BORU_BEKLIYOR { ver "boru"; }
    eğer durum == KXS_BITTI { ver "bitti"; }
    ver "sonlandi";
}
çıplak işlev ks_uyandir(yuva: tam64,b: &KsvBaglam) {
    değişken r: tam64 = kxs_baglam(yuva);
    değişken durum: tam64 = ks_durum(yuva);
    değişken olay: tam64 = kxm_o64(r+KXS_OLAY_OFS);
    değişken hazir: mantıksal = yanlış;
    eğer durum == KXS_BORU_BEKLIYOR { hazir=kb_hazir(b,olay); }
    eğer durum == KXS_UYUYOR { hazir=kem_tik_oku() >= olay; }
    eğer durum == KXS_COCUK_BEKLIYOR { hazir=ks_bitti(ks_durum(olay)); }
    eğer durum == KXS_TUS_BEKLIYOR {
        eğer (b.olay_maskesi&1) != 0 {
            eğer b.klavye_indeksi < 0 { hazir=ps2_halka_var(ps2_irq_klavye); }
            değilse { hazir=bh_durum(0) != 1; }
            hazir=hazir veya kt_hazir() veya b.olay_konum < dizi_boyut(b.olaylar);
        }
        eğer (b.olay_maskesi&2) != 0 {
            hazir=hazir veya ps2_kesme_fare_var() veya (bh_fare() >= 0 ve bh_durum(1) != 1);
        }
        hazir=hazir veya (b.son_tik >= 0 ve kem_tik_oku() >= b.son_tik);
    }
    eğer hazir { kxm_y64(r+KXS_DURUM_OFS,KXS_HAZIR); }
}
işlev ks_birak(y: tam64,b: &değişken KsvBaglam) -> tam64 {
    değişken r: tam64 = kxs_baglam(y);
    değişken fizik: tam64 = kxm_o64(r+KXS_CR3_OFS);
    değişken yer: KxsYer = kxs_yer(kxm_o64(r+256));
    güvensiz { memset(fizik olarak *tam8,0,(yer.tablo olarak tam64)*4096); }
    değişken ayirici: CerceveAyirici = uefi_ayirici_al();
    eşleş serbest_ardisik(&değişken ayirici,fizik,kxs_cerceve_sayisi(yer)) {
        hata(e) => { bm_yaz(e); kem_qemu_cik(1); }
        tamam(v) => { }
    }
    kxs_yuva_serbest(y);
    kxs_satir_bosalt(y);
    değişken i: tam64 = 0;
    iken i < KXS_YUVA_ADEDI {
        değişken cocuk: tam64 = kxs_baglam(i);
        eğer ks_durum(i) != KXS_BOS ve kxm_o64(cocuk+KXS_EBEVEYN_OFS) == ks_pid(y) {
            kxm_y64(cocuk+KXS_EBEVEYN_OFS,0);
        }
        i=i+1;
    }
    ksv_fdleri_birak(b);
    eğer b.degisti { ver ksv_esitle(b); }
    ver 0;
}
işlev ks_sonlandir(y: tam64,b: &değişken KsvBaglam) -> tam64 {
    değişken r: tam64 = kxs_baglam(y);
    kxm_y64(r+KXS_DURUM_OFS,KXS_OLDURULDU); kxm_y64(r+KXS_VEKTOR_OFS,15);
    ver ks_birak(y,b);
}
işlev kd_hub_olayi(d: &değişken KabukDisk,x: &değişken XhciDurum,xb: tam64) -> sonuç<mantıksal,metin> {
    eşleş bh_hub_isle(x,xb) { hata(e) => { ver hata(e); } tamam(v) => { } }
    eşleş kl_hidleri_sec(x,xb) { hata(e) => { ver hata(e); } tamam(v) => { } }
    ver kd_hub_diskleri(d,x,xb);
}
işlev ks_adim(p: &değişken KsKabukSureci,x: &değişken XhciDurum,h: &değişken HidKlavye,tr: &değişken KlavyeDurumu) -> mantıksal {
    güvensiz {
        ag_al();
        bh_olaylar();
        değişken n: tam64 = 0;
        iken n < KXS_YUVA_ADEDI {
            değişken y: tam64 = (p.sonraki+n)%KXS_YUVA_ADEDI;
            eğer ks_durum(y) != KXS_BOS ve değil ks_bitti(ks_durum(y)) {
                değişken i: tam32 = y olarak tam32;
                değişken b: KsvBaglam = dizi_al(p.baglamlar,i);
                eğer bh_hub_olayi() {
                    eşleş kd_hub_olayi(&değişken b.disk,x,b.xb) { hata(e) => { bm_yaz(metin_birlestir("KABUK HATA ",e)); } tamam(v) => { } }
                }
                b.klavye_indeksi=kl_indeks();
                // İlk kullanıcı dilimini hemen başlat. Süren veya girdi bekleyen
                // süreçler sonraki planlama adımında klavyeyi devralır.
                eğer b.dilim_calisti ve kxs_on_pid == ks_pid(y) {
                    b.x=*x; b.h=*h; b.tr=*tr;
                    değişken girdi: tam64 = ksv_tus_doldur(&değişken b);
                    *x=b.x; *h=b.h; *tr=b.tr;
                    eğer girdi == 2 {
                        ekran_cift_yaz("^C");
                        eğer ks_sonlandir(y,&değişken b) < 0 { ekran_cift_yaz("HATA surec dosya esitleme hatasi"); }
                        dizi_yaz(p.baglamlar,i,b); ver doğru;
                    }
                    eğer girdi < 0 { ekran_cift_yaz(kd_tamsayi("KABUK HATA klavye",girdi)); }
                    dizi_yaz(p.baglamlar,i,b);
                }
                ks_uyandir(y,&b);
                eğer ks_durum(y) == KXS_HAZIR {
                    b.x=*x; b.h=*h; b.tr=*tr;
                    değişken isaret: *KsvBaglam = (&b) olarak *KsvBaglam;
                    ksv_baglam_adresi=isaret olarak tam64;
                    değişken yonetim: *KsKabukSureci = p olarak *KsKabukSureci;
                    ks_yonetim=yonetim olarak tam64;
                    kxs_ek_vekil=ksv_vekil_adresi();
                    kxs_cikis_eslendi=dizi_al(b.fds,1).acik;
                    kxs_bir_dilim(y); b.dilim_calisti=doğru;
                    kxs_cikis_eslendi=yanlış;
                    ks_yonetim=0; ksv_baglam_adresi=0; kxs_ek_vekil=0;
                    *x=b.x; *h=b.h; *tr=b.tr;
                    eğer ks_bitti(ks_durum(y)) {
                        eğer ks_birak(y,&değişken b) < 0 { ekran_cift_yaz("HATA surec dosya esitleme hatasi"); }
                    }
                    dizi_yaz(p.baglamlar,i,b);
                    p.sonraki=(y+1)%KXS_YUVA_ADEDI;
                    ver doğru;
                }
            }
            n=n+1;
        }
    }
    ver yanlış;
}
çıplak işlev ps2_tus_var() -> mantıksal { ver ps2_halka_var(ps2_irq_klavye); }
çıplak işlev ks_hlt() { güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"sti
hlt"# bozulan("~{memory}") } } }
işlev ks_bekle(p: &değişken KsKabukSureci,y: tam64,x: &değişken XhciDurum,h: &değişken HidKlavye,tr: &değişken KlavyeDurumu) {
    iken değil ks_bitti(ks_durum(y)) {
        eğer değil ks_adim(p,x,h,tr) { güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"sti
hlt"# bozulan("~{memory}") } } }
    }
    değişken s: KxsSonuc = KxsSonuc {pid:0,ebeveyn:0,bitti:yanlış,kod:0,vektor:0,hata_kodu:0,rip:0,cr2:0};
    kxs_sonuc_al(y,&değişken s);
    kxs_heap_iz(8);
    ks_sonuc(dizi_al(p.adlar,y olarak tam32),&s);
    p.son_kod=s.kod;
    eğer değil s.bitti { p.son_kod=128+s.vektor; }
}
işlev kd_sayi_arg(m: metin) -> tam64 {
    değişken i: tam32 = 0;
    değişken n: tam64 = 0;
    iken i < metin_uzunluk(m) {
        değişken b: tam64 = metin_bayt(m,i) olarak tam64;
        eğer b < 48 veya b > 57 veya n > (9223372036854775807-(b-48))/10 { ver -1; }
        n=n*10+b-48; i=i+1;
    }
    ver n;
}
işlev ks_pid_arg(m: metin) -> tam64 { ver kxs_pid_yuva(kd_sayi_arg(m)); }
işlev kd_adaylar(d: &değişken KabukDisk,yol: metin) -> sonuç<Dizi<DizinGirdisi>,metin> {
    eşleş kd_yol(d,yol) { hata(e) => { ver hata(e); } tamam(y) => {
        eşleş kd_fat(d,y) { hata(e) => { ver hata(e); } tamam(fat) => {
            değişken f: FatSektor = fat; ver kd_liste(d,y,&değişken f);
        } }
    } }
}
işlev ks_program_adi(d: &değişken KabukDisk,ad: metin) -> sonuç<metin,metin> {
    değişken i: tam32 = 0;
    iken i < metin_uzunluk(ad) { eğer metin_bayt(ad,i) == 47 { ver tamam(ad); } i=i+1; }
    değişken dosya: metin = ad;
    değişken n: tam32 = metin_uzunluk(ad);
    eğer n < 4 veya değil bm_esit(metin_kes(ad,n-4,4),".elf") { dosya=metin_birlestir(ad,".elf"); }
    değişken yollar: Dizi<metin> = ["/bin"];
    eğer d.kok >= 0 {
        değişken kok: KabukBag = dizi_al(d.baglar,d.kok);
        için k: d.baglar { eğer k.indeks == kok.indeks ve değil k.kayit.kok {
            dizi_ekle(yollar,metin_birlestir(k.kayit.ad,"/bin"));
        } }
    }
    için yol: yollar {
        eşleş kd_adaylar(d,yol) { hata(e) => { eğer değil bm_esit(e,"bulunamadi") { ver hata(e); } }
            tamam(xs) => { için g: xs { eğer değil g.dizin_mi ve yol_bilesen_esit(g.ad,dosya) {
                ver tamam(metin_birlestir(metin_birlestir(yol,"/"),g.ad));
            } } }
        }
    }
    ver hata("bilinmeyen komut");
}
işlev kd_tab(d: &değişken KabukDisk,s: &değişken SatirDuzenleyici) -> sonuç<mantıksal,metin> {
    değişken bas: tam32 = s.imlec;
    iken bas > 0 ve dizi_al(s.kodlar,bas-1) != 32 { bas=bas-1; }
    değişken ayr: tam32 = s.imlec;
    iken ayr > bas ve dizi_al(s.kodlar,ayr-1) != 47 { ayr=ayr-1; }
    değişken diz: Dizi<tam32> = []; değişken i: tam32 = bas;
    iken i < ayr { dizi_ekle(diz,dizi_al(s.kodlar,i)); i=i+1; }
    değişken dir: metin = d.cwd;
    eğer dizi_boyut(diz) > 0 { eşleş kd_mutlak(d.cwd,utf8_kodla(diz)) { hata(e) => { ver hata(e); } tamam(y) => { dir=y; } } }
    değişken adlar: Dizi<metin> = [];
    eğer bm_esit(dir,"/diskler") {
        için k: d.baglar { eğer değil bm_esit(k.kayit.ad,"/ram") ve kd_hub_bagli(d,k.indeks) { dizi_ekle(adlar,metin_birlestir(metin_kes(k.kayit.ad,9,metin_uzunluk(k.kayit.ad)-9),"/")); } }
    } değilse {
        eşleş kd_adaylar(d,dir) { hata(e) => { ver hata(e); } tamam(xs) => {
            için g: xs { eğer değil bm_esit(g.ad,".") ve değil bm_esit(g.ad,"..") {
                değişken ad: metin = g.ad; eğer g.dizin_mi { ad=metin_birlestir(ad,"/"); } dizi_ekle(adlar,ad);
            } }
        } }
        eğer bm_esit(dir,"/") { dizi_ekle(adlar,"diskler/"); }
    }
    değişken bulunan: Dizi<metin> = []; değişken ilk: Dizi<tam32> = [];
    değişken ortak: tam32 = 0; değişken on: tam32 = s.imlec-ayr;
    için ad: adlar {
        değişken kod: Dizi<tam32> = utf8_coz(ad); i=0;
        iken i < on ve i < dizi_boyut(kod) ve dizi_al(s.kodlar,ayr+i) == dizi_al(kod,i) { i=i+1; }
        eğer i == on {
            eğer dizi_boyut(bulunan) == 0 { ilk=kod; ortak=dizi_boyut(kod); }
            değilse { i=on; iken i < ortak ve i < dizi_boyut(kod) ve dizi_al(kod,i) == dizi_al(ilk,i) { i=i+1; } ortak=i; }
            dizi_ekle(bulunan,ad);
        }
    }
    eğer dizi_boyut(bulunan) == 0 { ver tamam(yanlış); }
    eğer dizi_boyut(bulunan) > 1 { için ad: bulunan { ekran_cift_yaz(ad); } }
    eğer dizi_boyut(s.kodlar)+ortak-on > 256 { ver hata("komut uzun"); }
    değişken yeni: Dizi<tam32> = []; i=0;
    iken i < s.imlec { dizi_ekle(yeni,dizi_al(s.kodlar,i)); i=i+1; }
    değişken j: tam32 = on; iken j < ortak { dizi_ekle(yeni,dizi_al(ilk,j)); j=j+1; }
    iken i < dizi_boyut(s.kodlar) { dizi_ekle(yeni,dizi_al(s.kodlar,i)); i=i+1; }
    s.kodlar=yeni; s.imlec=s.imlec+ortak-on; ver tamam(doğru);
}
işlev kd_tab_mi(o: TusOlayi) -> mantıksal {
    eşleş o { TusOlayi::Ozel(k,bas) => { ver k == 3 ve bas; } _ => { ver yanlış; } }
}
işlev kd_temizle() {
    güvensiz {
        eğer ksv_ekran_adr == 0 { ver; }
        değişken ptr: *KabukEkran = ksv_ekran_adr olarak *KabukEkran;
        değişken ke: KabukEkran = *ptr;
        eğer ke.var {
            ekran_ayna_sifirla(); konsol_alan_sil(&değişken ke.k,0,ke.k.satirlar*ke.k.sutunlar);
            konsol_imlec(&değişken ke.k,0,0); *ptr=ke;
        }
    }
}
işlev ks_komut(d: &değişken KabukDisk,p: &değişken KsKabukSureci,arg: metin,x: &değişken XhciDurum,xb: tam64,indeks: tam32,
              h: &değişken HidKlavye,tr: &değişken KlavyeDurumu,arka: mantıksal,ara: mantıksal) -> sonuç<mantıksal,metin> {
    eğer değil uefi_mi() { ver hata("calistir UEFI gerektirir"); }
    değişken argv: Dizi<metin> = [];
    değişken i: tam32 = 0;
    değişken n: tam32 = metin_uzunluk(arg);
    iken i < n {
        eğer metin_bayt(arg,i) == (32 olarak tam8) { i=i+1; }
        değilse {
            değişken bas: tam32 = i;
            iken i < n ve metin_bayt(arg,i) != (32 olarak tam8) { i=i+1; }
            eğer değil (arka ve i == n ve bm_esit(metin_kes(arg,bas,i-bas),"&")) {
                eğer dizi_boyut(argv) >= 32 { ver hata("cok arguman"); }
                dizi_ekle(argv,metin_kes(arg,bas,i-bas));
            }
        }
    }
    eğer dizi_boyut(argv) == 0 { ver hata("calistir <yol> [arg...]"); }
    değişken ad: metin = dizi_al(argv,0);
    eğer ara ve metin_bayt(ad,0) != 47 { eşleş ks_program_adi(d,ad) { hata(e) => { ver hata(e); } tamam(yol) => { dizi_yaz(argv,0,yol); } } }
    değişken b: KsvBaglam = dizi_al(p.baglamlar,0);
    güvensiz { b.disk=*d; b.x=*x; b.h=*h; b.tr=*tr; }
    eşleş ks_baslat(p,&değişken b,argv,0) { hata(e) => { ver hata(e); } tamam(y) => {
        eğer arka { ekran_cift_yaz(metin_birlestir("pid=",tam_metin(ks_pid(y)))); }
        değilse {
            güvensiz { kxs_on_pid=ks_pid(y); } p.beklenen=y;
        }
        ver tamam(doğru);
    } }
}
// Bir CPUID yaprağının dört sözcüğünü birlikte oku.
yapı KdCpuid { a: dtam32; b: dtam32; c: dtam32; d: dtam32; }
çıplak işlev kd_cpuid(sayfa: dtam32) -> KdCpuid {
    değişken a: dtam32 = 0; değişken b: dtam32 = 0;
    değişken c: dtam32 = 0; değişken d: dtam32 = 0;
    güvensiz { satıriçi_asm { mimari:x86_64 şablon:r#"movl %edi, %eax
xorl %ecx, %ecx
cpuid"#
        çıktı("={ax}",&a) çıktı("={bx}",&b) çıktı("={cx}",&c) çıktı("={dx}",&d)
        girdi("{di}",sayfa) bozulan("~{flags}") } }
    ver KdCpuid {a:a,b:b,c:c,d:d};
}
işlev kd_ascii(w: dtam32) -> metin {
    değişken s: metin = ""; değişken i: tam32 = 0;
    iken i < 4 {
        değişken b: tam32 = (((w olarak tam64)>>(i*8))&255) olarak tam32;
        eğer b == 0 { ver s; }
        eğer b < 32 veya b > 126 { b=63; }
        s=metin_birlestir(s,kod_metin(b)); i=i+1;
    }
    ver s;
}
işlev kd_cpu() -> metin {
    değişken v: KdCpuid = kd_cpuid(0 olarak dtam32);
    değişken s: metin = metin_birlestir("CPU ",kd_ascii(v.b));
    s=metin_birlestir(s,kd_ascii(v.d));s=metin_birlestir(s,kd_ascii(v.c));
    s=metin_birlestir(s," ");
    değişken ust: KdCpuid = kd_cpuid(2147483648 olarak dtam32);
    eğer (ust.a olarak tam64) < 2147483652 { ver metin_birlestir(s,"ad bildirilmedi"); }
    değişken yaprak: tam64 = 2147483650;
    iken yaprak <= 2147483652 {
        v=kd_cpuid(yaprak olarak dtam32);
        s=metin_birlestir(s,metin_birlestir(kd_ascii(v.a),kd_ascii(v.b)));
        s=metin_birlestir(s,metin_birlestir(kd_ascii(v.c),kd_ascii(v.d)));
        yaprak=yaprak+1;
    }
    ver s;
}
işlev kd_hex_n(v: tam64,n: tam32) -> metin {
    değişken s: metin = "";
    iken n > 0 { n=n-1; değişken k: tam32 = ((v>>(4*n))&15) olarak tam32;
        eğer k < 10 { k=k+48; } değilse { k=k+87; }
        s=metin_birlestir(s,kod_metin(k));
    } ver s;
}
işlev kd_tamsayi(s: metin,v: tam64) -> metin { ver metin_birlestir(metin_birlestir(s," "),tam_metin(v)); }
işlev kd_pci_rapor(satirlar: Dizi<metin>) {
    için bdf: kem_pci_islevler() {
            değişken bus: tam32 = bdf/256; değişken devfn: tam32 = bdf%256;
            değişken kim: tam64 = kem_pci_oku32(bdf,0);
            eğer (kim&65535) != 65535 {
                değişken sinif: tam64 = (kem_pci_oku32(bdf,8)>>8)&16777215;
                değişken s: metin = metin_birlestir("PCI ",kd_hex_n(bus olarak tam64,2));
                s=metin_birlestir(s,metin_birlestir(":",kd_hex_n((devfn/8) olarak tam64,2)));
                s=metin_birlestir(s,metin_birlestir(".",kd_hex_n((devfn%8) olarak tam64,1)));
                s=metin_birlestir(s,metin_birlestir(" ",kd_hex_n(kim&65535,4)));
                s=metin_birlestir(s,metin_birlestir(":",kd_hex_n(kim>>16,4)));
                dizi_ekle(satirlar,metin_birlestir(s,metin_birlestir(" ",kd_hex_n(sinif,6))));
                eğer (sinif>>16)==2 ve ag_pci_model(kim)==0 {
                    değişken ad: metin = "PCI ag aygiti";
                    eğer (kim&65535)==4332 { ad="Realtek"; }
                    eğer kim==2168000748 { ad="Realtek rtl8139"; }
                    dizi_ekle(satirlar,metin_birlestir(metin_birlestir(s,metin_birlestir(" ",ad))," desteklenmiyor"));
                }
            }
    }
}
işlev kd_pci_genis(bdf: tam32) {
    değişken ofs: tam32 = 256; değişken goruldu: Dizi<dtam8> = bayt_sifir(128);
    iken ofs >= 256 ve ofs <= 4092 {
        değişken maske: tam32 = 1<<((ofs/4)&7);
        değişken once: tam32 = oku_u8(goruldu,ofs/32);
        eğer (once&maske) != 0 { ekran_cift_yaz("KABUK HATA PCI genis yetenek dongusu"); ver; }
        yaz_u8(goruldu,ofs/32,(once|maske) olarak tam64);
        değişken v: tam64 = kem_pci_oku32(bdf,ofs);
        eğer v == 0 veya v == 4294967295 { ofs=0; }
        değilse {
            ekran_cift_yaz(kd_tamsayi(kd_tamsayi(kd_tamsayi("GENIS",bdf olarak tam64),ofs olarak tam64),v));
            değişken yeni: tam32 = ((v>>20)&4095) olarak tam32;
            eğer yeni != 0 ve (yeni < 256 veya (yeni&3) != 0) { ekran_cift_yaz("KABUK HATA PCI genis yetenek zinciri"); ofs=0; }
            değilse { ofs=yeni; }
        }
    }
}
işlev kd_pci_tani() {
    değişken aygitlar: Dizi<metin> = [];
    kd_pci_rapor(aygitlar); için satir: aygitlar { ekran_cift_yaz(satir); }
    için bdf: kem_pci_islevler() {
        değişken a: tam64 = kem_ecam_adres(bdf,0);
        eğer (kem_pci_oku32(bdf,8)>>16) == 1540 {
            ekran_cift_yaz(kd_tamsayi(kd_tamsayi("KOPRU",bdf olarak tam64),kem_pci_oku32(bdf,24)&16777215));
        }
        eğer a != 0 { kd_pci_genis(bdf); }
    }
    güvensiz {
        değişken i: tam64 = 0;
        iken i < pci_bar_sayi {
            değişken p: tam64 = pci_bar_tablo+i*40; değişken adr: tam64 = kem_mmio_oku64(p+24);
            değişken tur: tam64 = kem_mmio_oku64(p+16);
            değişken g: tam64 = 0; eğer (tur&1) == 0 ve adr != 0 { g=uefi_yaprak(adr); }
            değişken m: metin = kd_tamsayi(kd_tamsayi(kd_tamsayi("BAR",kem_mmio_oku64(p)),kem_mmio_oku64(p+8)),tur);
            ekran_cift_yaz(kd_tamsayi(kd_tamsayi(kd_tamsayi(m,adr),kem_mmio_oku64(p+32)),g));
            i=i+1;
        }
        // Kök aygıtın vendor/command yazmaçlarına doğal genişlikte port erişimi.
        kem_port_yaz32(3320 olarak dtam16,kem_pci_adres(0,4));
        değişken cmd: dtam16 = kem_port_oku16(3324 olarak dtam16);
        kem_port_yaz16(3324 olarak dtam16,cmd);
        kem_port_yaz32(3320 olarak dtam16,kem_pci_adres(0,0));
        değişken vendor: dtam16 = kem_port_oku16(3324 olarak dtam16);
        ekran_cift_yaz(kd_tamsayi(kd_tamsayi("PORT16",(vendor olarak tam64)&65535),(cmd olarak tam64)&65535));
    }
    değişken taban: tam64 = kem_ecam_adres(0,0);
    ekran_cift_yaz(kd_tamsayi("ECAM0",taban));
    değişken ofs: tam32 = 0;
    iken ofs < 256 {
        değişken p: tam64 = kem_cf8_oku32(0,ofs);
        değişken e: tam64 = kem_pci_oku32(0,ofs);
        ekran_cift_yaz(kd_tamsayi(kd_tamsayi(kd_tamsayi("CFG",ofs olarak tam64),p),e)); ofs=ofs+4;
    }
}
işlev kd_kesme_rapor(satirlar: Dizi<metin>) {
    güvensiz {
        eğer kesme_tablo == 0 { ver; }
        değişken v: tam32 = 32;
        iken v < 80 {
            değişken p: tam64 = kesme_tablo+(v olarak tam64)*32;
            değişken kim: tam64 = kem_mmio_oku64(p);
            eğer kim > 0 {
                dizi_ekle(satirlar,kd_tamsayi(kd_tamsayi(kd_tamsayi("KESME",v olarak tam64),kim),kem_mmio_oku64(p+8)));
            }
            v=v+1;
        }
    }
}
// FSInfo sayacı bilinmiyorsa tek bir DMA tamponunu bütün FAT boyunca yeniden kullan.
işlev kd_fat_bos_kume(ay: &değişken BlokDonanim,k: KabukBag,hedef: tam64) -> sonuç<tam64,metin> {
    değişken son: tam64 = k.bpb.kume_sayisi+2;
    eğer k.bpb.sektor_bayt != 512 veya son > k.bpb.fat_sektor*128 { ver hata("FAT32 sayim geometrisi"); }
    değişken bas: tam64 = k.bolum.bas+(k.bpb.ayrilmis olarak tam64);
    değişken sektor: tam64 = 0; değişken bos: tam64 = 0;
    iken sektor*128 < son {
        değişken adet: tam64 = (son+127)/128-sektor; eğer adet > 128 { adet=128; }
        değişken veri: tam64 = hedef;
        eşleş ay.aygit.durum {
            BlokCesidi::Ram(r) => {
                eğer bas < 0 veya bas+sektor > r.sektor-adet { ver hata("ramdisk FAT araligi"); }
                veri=r.taban+(bas+sektor)*512;
            }
            _ => {
                eşleş kd_ram_aktar(ay,bas+sektor,adet,hedef) { hata(e) => { ver hata(e); } tamam(v) => { } }
            }
        }
        değişken i: tam64 = 0;
        iken i < adet*128 ve sektor*128+i < son {
            eğer sektor*128+i >= 2 ve (kem_mmio_oku32(veri+i*4)&268435455) == 0 { bos=bos+1; }
            i=i+1;
        }
        sektor=sektor+adet;
    }
    ver tamam(bos);
}
işlev kd_bos_bayt(d: &değişken KabukDisk,k: KabukBag) -> sonuç<tam64,metin> {
    eğer bm_esit(k.kayit.ad,"/ram") {
        değişken bos: tam64 = 0; için sayfa: d.ram.dolu { eğer sayfa == 0 { bos=bos+4096; } }
        ver tamam(bos);
    }
    değişken birim: tam64 = (k.bpb.kume_sektor olarak tam64)*(k.bpb.sektor_bayt olarak tam64);
    eğer k.bpb.fsinfo > 0 ve k.bpb.fsinfo < k.bpb.ayrilmis {
        eşleş kd_oku(d,k.indeks,k.bolum.bas+(k.bpb.fsinfo olarak tam64),1) {
            hata(e) => { ver hata(e); } tamam(b) => {
                değişken say: tam64 = oku_le32(b,488);
                eğer oku_le32(b,0) == 1096897106 ve oku_le32(b,484) == 1631679090 ve oku_le32(b,508) == 2857697280 ve say <= k.bpb.kume_sayisi { ver tamam(say*birim); }
            }
        }
    }
    değişken ay: BlokDonanim = dizi_al(d.aygitlar,k.indeks);
    güvensiz {
        değişken tampon: *tam8 = malloc(131072); eğer (tampon olarak tam64) == 0 { ver hata("FAT sayimi icin bellek yok"); }
        değişken hedef: tam64 = (((tampon olarak tam64)+65535)/65536)*65536;
        değişken r: sonuç<tam64,metin> = kd_fat_bos_kume(&değişken ay,k,hedef);
        free(tampon); dizi_yaz(d.aygitlar,k.indeks,ay);
        eşleş r { hata(e) => { ver hata(e); } tamam(n) => { ver tamam(n*birim); } }
    }
}
işlev kd_bilgi(d: &değişken KabukDisk,indeks: tam32,us: mantıksal) -> sonuç<mantıksal,metin> {
    değişken sure: tam64 = kem_tik_oku()*10;
    güvensiz { eğer kap_tsc_ms > 0 ve kap_tsc_bas > 0 { sure=(bm_tsc_oku()-kap_tsc_bas)/kap_tsc_ms; } }
    ekran_cift_yaz(kd_tamsayi("CALISMA ms",sure));
    eğer uefi_mi() {
        değişken c: CerceveAyirici = uefi_ayirici_al();
        ekran_cift_yaz(kd_tamsayi(kd_tamsayi("CERCEVE bos toplam",cerceve_bos(&c) olarak tam64),c.toplam olarak tam64));
    } değilse { ekran_cift_yaz("CERCEVE PVH haritasi yok"); }
    ekran_cift_yaz(kd_tamsayi("HEAP bayt",kem_heap_kullanimi()));
    değişken say: tam64 = 0; değişken i: tam64 = 0;
    iken i < KXS_YUVA_ADEDI { değişken durum: tam64 = ks_durum(i); eğer durum != KXS_BOS ve değil ks_bitti(durum) { say=say+1; } i=i+1; }
    ekran_cift_yaz(kd_tamsayi("SUREC etkin",say));
    değişken kl: metin = "PS2"; değişken fa: metin = "PS2"; değişken duz: metin = "tr";
    eğer indeks >= 0 { kl="USB"; } eğer bh_fare() >= 0 { fa="USB"; } eğer us { duz="us"; }
    ekran_cift_yaz(metin_birlestir(metin_birlestir(metin_birlestir("GIRDI ",kl),metin_birlestir(" ",fa)),metin_birlestir(" ",duz)));
    değişken satirlar: Dizi<metin> = []; kd_kesme_rapor(satirlar); için s: satirlar { ekran_cift_yaz(s); }
    için k: d.baglar {
        eğer bm_esit(k.kayit.ad,"/ram") veya kd_hub_bagli(d,k.indeks) {
            eşleş kd_bos_bayt(d,k) {
                hata(e) => { ver hata(metin_birlestir(metin_birlestir(k.kayit.ad," "),e)); }
                tamam(bos) => { ekran_cift_yaz(kd_tamsayi(metin_birlestir("BOS_BAYT ",k.kayit.ad),bos)); }
            }
        }
    }
    ver tamam(doğru);
}
işlev kd_kesme_sina() -> sonuç<mantıksal,metin> {
    değişken v: tam32 = kesme_ayir();
    eğer v < 0 { ver hata("kesme sinamasi icin bos vektor yok"); }
    değişken ilk: mantıksal = kesme_kaydet(v,5);
    değişken ikinci: mantıksal = kesme_kaydet(v,6);
    değişken bos: mantıksal = kesme_birak(v);
    eğer değil ilk veya ikinci veya değil bos { ver hata("kesme vektoru cakismasi"); }
    ekran_cift_yaz("KESME CAKISMA RED"); ver tamam(doğru);
}
// Tek etkin arayüzün halkaları ve çerçeveleri UEFI fiziksel ayırıcısına aittir.
