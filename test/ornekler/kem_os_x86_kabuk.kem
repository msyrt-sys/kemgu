}
işlev ag_kur() -> sonuç<mantıksal,metin> {
    güvensiz {
        değişken n: tam64 = 0;
        iken n < pci_bar_sayi {
            değişken p: tam64 = pci_bar_tablo+40*n; n=n+1;
            değişken bdf: tam32 = kem_mmio_oku64(p) olarak tam32;
            değişken model: tam32 = ag_pci_model(kem_pci_oku32(bdf,0));
            eğer model==4 { ver ag_virtio_kur(bdf); }
            eğer kem_mmio_oku64(p+8)==0 ve model>=1 ve model<=3 {
                değişken bar: tam64 = kem_mmio_oku64(p+24);
                eğer bar==0 veya (kem_mmio_oku64(p+16)&1)!=0 veya kem_mmio_oku64(p+32)<21512 { ver hata("e1000 BAR0"); }
                değişken dma: tam64 = vnet_dma;
                eğer model==2 { eşleş uefi_nic_ust_dma() { hata(e) => { ver hata(e); } tamam(a) => { eğer a!=0 { dma=a; } } } }
                eğer dma==0 { ver hata("e1000 icin cerceve yok"); }
                değişken eski: tam32 = kem_pci_oku16(bdf,4);
                kem_pci_yaz16(bdf,4,eski|1030);
                ag_kuyruk_hazirla(dma);
                değişken s: E1kKurulum = e1k_yeni(dma);
                s.model=model;
                değişken y: GcYanit = gc_bos();
                iken doğru {
                    değişken istek: GcIstek = e1k_adim(&değişken s,y);
                    eşleş istek {
                        GcIstek::Bitti => {
                            ag_model=model; ag_dma=dma; ag_bar=bar; ag_mac=s.mac; ag_vektor=-1;
                            eğer model>1 { ag_vektor=ag_msix(bdf); }
                            eğer ag_vektor<0 { ag_vektor=ag_intx(bdf); }
                            ver tamam(doğru);
                        }
                        GcIstek::Hata(m) => {
                            kem_mmio_yaz32(bar+256,0); kem_mmio_yaz32(bar+1024,0);
                            kem_pci_yaz16(bdf,4,eski&65531); ver hata(m);
                        }
                        _ => { y=bm_yurut(bar,istek); }
                    }
                }
            }
        }
        ver tamam(yanlış);
    }
}
işlev ag_gonder(adres: tam64,boy: tam32) -> tam32 {
    güvensiz {
    eğer ag_bar==0 veya ag_link()==0 { ver -100; }
    eğer boy<14 veya boy>1518 { ver -90; }
    eğer ag_model==4 { değişken r: tam32 = ag_vtx(adres,boy); eğer r==0 { ag_tx_sayi=ag_tx_sayi+1; ag_tx_bayt=ag_tx_bayt+(boy olarak tam64); } ver r; }
    değişken t: tam64 = ag_dma+4096+(ag_tx olarak tam64)*16;
    eğer (kem_fiz_oku8(t+12)&1)==0 { ver -11; }
    değişken a: tam64 = kem_mmio_oku64(t);
    değişken i: tam32 = 0;
    iken i<boy { kem_fiz_yaz8(a+(i olarak tam64),kem_fiz_oku8(adres+(i olarak tam64))); i=i+1; }
    eğer ag_model==3 { kem_mmio_yaz64(t+8,igb_tx_sozcugu(boy)); }
    değilse { kem_mmio_yaz64(t+8,e1k_tx_sozcugu(boy)); }
