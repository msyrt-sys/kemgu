    ag_tx_sayi=ag_tx_sayi+1; ag_tx_bayt=ag_tx_bayt+(boy olarak tam64); ver 0;
    }
}
işlev ag_al() {
    güvensiz {
    eğer ag_bar==0 { ver; }
    eğer ag_parca_aktif>0 { ag_parca_sure(ag_us()/1000); }
    ag_bekleyenleri_isle(); ag_dhcp_adim(); ag_tcp_adim();
    eğer ag_model==4 { ag_vrx(); ver; }
    değişken i: tam32 = 0;
    iken i<E1K_ADET {
        değişken t: tam64 = ag_dma+(ag_rx olarak tam64)*16;
        değişken bilgi: tam64 = kem_mmio_oku64(t+8);
        değişken n: tam32 = e1k_rx_boyu(bilgi);
        eğer ag_model==3 { n=igb_rx_boyu(bilgi); }
        eğer n==0 { ver; }
        eğer n>0 {
            değişken a: tam64 = ag_dma+8192+(ag_rx olarak tam64)*2048;
            değişken j: tam32 = 0;
            iken j<n { kem_fiz_yaz8(ag_dma+40960+(j olarak tam64),kem_fiz_oku8(a+(j olarak tam64))); j=j+1; }
            ag_son_boy=n; ag_rx_sayi=ag_rx_sayi+1; ag_rx_bayt=ag_rx_bayt+(n olarak tam64); ag_l3_girdi();
        } değilse { ag_atilan=ag_atilan+1; }
