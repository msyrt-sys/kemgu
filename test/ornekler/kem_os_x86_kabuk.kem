işlev ag_ip_metin(ip: tam64) -> metin {
    değişken m: metin = tam_metin((ip>>24)&255); değişken kay: tam32 = 16;
    iken kay>=0 { m=metin_birlestir(metin_birlestir(m,"."),tam_metin((ip>>kay)&255)); kay=kay-8; } ver m;
}
işlev ag_cozumle(ad: metin) -> sonuç<mantıksal,metin> {
    güvensiz {
        eğer ag_l5==0 veya ag_bar==0 { ver hata("ag yok"); }
        değişken p: *DhcpKirasi = ag_l5 olarak *DhcpKirasi; değişken s: DhcpKirasi = *p;
        değişken l: *AgL3 = ag_l3_alan olarak *AgL3;
        eğer (*l).ip==0 veya s.dns==0 { ver hata("DNS sunucusu yok"); }
        değişken isim: Dizi<dtam8> = ag_dizi8(ag_l5+288); değişken on: Dizi<dtam8> = ag_dizi8(ag_l5+352);
        değişken boy: tam32 = dns_ad_yaz(ad,isim,0); eğer boy<0 { ver hata("DNS adi gecersiz"); }
        eğer ag_dns_on_son>ag_us()/1000 ve dns_ad_esit(isim,0,on,0) { ekran_cift_yaz(ag_ip_metin(ag_dns_ip)); ver tamam(doğru); }
        değişken tx: Dizi<dtam8> = ag_dizi8(ag_l3_alan+288); değişken dene: tam32 = 0;
        ag_dns_on_son=0;
        iken dene<3 {
            ag_dns_sunucu=s.dns; eğer dene>0 ve s.dns2!=0 { ag_dns_sunucu=s.dns2; }
            ag_dns_id=((ag_us()^ag_mac)&65535) olarak tam32;
            ag_dns_port=49152+(ag_dns_id&16383); ag_dns_sonuc= -11;
            değişken n: tam32 = dns_sorgu(tx,42,ag_dns_id,isim,boy);
            n=ag_udp_cerceve(tx,(*l).ip,ag_dns_sunucu,ag_dns_port,53,n,0);
            değişken hop: tam64 = ip4_sonraki((*l).ip,(*l).onek,(*l).gecit,ag_dns_sunucu);
            eğer hop>0 ve n>0 ve ag_ip_cik(tx,n,hop,600)==0 {
                değişken son: tam64 = ag_us()+650000;
                iken ag_dns_sonuc== -11 ve ag_us()<son { ag_al(); }
            }
            eğer ag_dns_sonuc==0 {
                ag_kopyala(on,0,isim,0,boy); ag_dns_on_son=ag_us()/1000+ag_dns_ttl*1000; ag_dns_port=0;
                ekran_cift_yaz(ag_ip_metin(ag_dns_ip)); ver tamam(doğru);
            }
            eğer ag_dns_sonuc== -2 { ag_dns_port=0; ver hata("DNS kaydi bulunamadi"); }
            dene=dene+1;
        }
        ag_dns_port=0; ver hata("DNS zaman asimi");
    }
}

// Sekiz bağlantının halkaları ve iki ayrı çalışma tamponu fiziksel sayfalardadır.
