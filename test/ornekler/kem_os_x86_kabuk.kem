çıplak işlev ag_kuyruk_hazirla(dma: tam64) {
    memset(dma olarak *tam8,0,(E1K_SAYFA olarak tam64)*4096);
    değişken i: tam64 = 0;
    iken i < (E1K_ADET olarak tam64) {
        kem_mmio_yaz64(dma+i*16,dma+8192+i*2048);
        kem_mmio_yaz64(dma+4096+i*16,dma+24576+i*2048);
        kem_fiz_yaz8(dma+4096+i*16+12,1);
        i=i+1;
