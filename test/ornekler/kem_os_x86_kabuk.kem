}
işlev ag_vrx() {
    güvensiz {
    değişken a: tam64 = ag_dma;
    değişken tur: tam32 = 0;
    iken tur<8 ve (vblk_o16(a+162) olarak tam32)!=ag_vrx_gorulen {
        kem_dma_bariyeri();
