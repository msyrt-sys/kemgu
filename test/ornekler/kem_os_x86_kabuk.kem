// Kullanılacak her yetenek bildirilen MMIO BAR'ın içinde kalmalıdır.
işlev ag_pci_pencere(bdf: tam32, bir: tam32, ofs: tam64, boy: tam64) -> tam64 {
    güvensiz {
        değişken i: tam64 = 0;
        iken i<pci_bar_sayi {
            değişken p: tam64 = pci_bar_tablo+i*40; i=i+1;
            eğer kem_mmio_oku64(p)==(bdf olarak tam64) ve kem_mmio_oku64(p+8)==(bir olarak tam64) ve (kem_mmio_oku64(p+16)&1)==0 {
                değişken bas: tam64 = kem_mmio_oku64(p+24);
                eğer bas>0 ve ofs>=0 ve boy>0 ve ofs<=kem_mmio_oku64(p+32)-boy { ver bas+ofs; }
            }
        }
        ver 0;
    }
}
işlev ag_virtio_kur(bdf: tam32) -> sonuç<mantıksal,metin> {
    güvensiz {
        değişken k: tam32 = kem_pci_oku16(bdf,52)&255;
        değişken c: tam64 = 0; değişken bildir: tam64 = 0; değişken carpan: tam64 = 0; değişken uzun: tam64 = 0;
        değişken cihaz: tam64 = 0; değişken tur: tam32 = 0;
        iken k!=0 {
            eğer k<64 veya k>252 veya (k&3)!=0 veya tur>=48 { ver hata("virtio PCI yetenek zinciri"); }
            tur=tur+1;
            değişken v: tam64 = kem_pci_oku32(bdf,k);
            eğer (v&255)==9 {
                değişken tip: tam64 = (v>>24)&255;
                eğer tip>=1 ve tip<=4 {
                    değişken n: tam32 = ((v>>16)&255) olarak tam32;
                    eğer n<16 veya n>256-k { ver hata("virtio PCI yetenek boyu"); }
                    değişken boy: tam64 = kem_pci_oku32(bdf,k+12);
                    değişken a: tam64 = ag_pci_pencere(bdf,kem_pci_oku16(bdf,k+4)&255,kem_pci_oku32(bdf,k+8),boy);
                    eğer tip==1 ve boy>=56 { c=a; }
                    eğer tip==2 ve n>=20 { bildir=a; carpan=kem_pci_oku32(bdf,k+16); uzun=boy; }
                    eğer tip==4 ve boy>=8 { cihaz=a; }
                }
            }
            k=((v>>8)&255) olarak tam32;
        }
        eğer c==0 veya cihaz==0 veya bildir==0 { ver hata("virtio modern alan eksik"); }
        değişken once: tam32 = kem_pci_oku16(bdf,4);
        kem_pci_yaz16(bdf,4,once|1030);
        kem_fiz_yaz8(c+20,0);
        tur=0; iken kem_fiz_oku8(c+20)!=0 ve tur<100 { kem_bekle_us(1000); tur=tur+1; }
        eğer kem_fiz_oku8(c+20)!=0 { ver hata("virtio sifirlama zaman asimi"); }
        kem_fiz_yaz8(c+20,1); kem_fiz_yaz8(c+20,3);
        kem_mmio_yaz32(c,0); değişken alt: tam64 = kem_mmio_oku32(c+4);
        kem_mmio_yaz32(c,1); değişken oz: tam64 = vnic_ozellik(alt,kem_mmio_oku32(c+4));
        eğer oz<0 { kem_fiz_yaz8(c+20,131); ver hata("virtio MAC/STATUS/VERSION_1"); }
        kem_mmio_yaz32(c+8,0); kem_mmio_yaz32(c+12,oz); kem_mmio_yaz32(c+8,1); kem_mmio_yaz32(c+12,1);
        kem_fiz_yaz8(c+20,11);
        eğer (kem_fiz_oku8(c+20)&8)==0 { kem_fiz_yaz8(c+20,139); ver hata("virtio ozellik reddedildi"); }
        değişken dma: tam64 = vnet_dma;
        memset(dma olarak *tam8,0,65536);
        değişken q: tam32 = 0;
        iken q<2 {
            vblk_y16(c+22,q olarak dtam16);
            eğer vblk_o16(c+24)<8 veya vblk_o16(c+28)!=0 { kem_fiz_yaz8(c+20,139); ver hata("virtio kuyruk boyu"); }
            vblk_y16(c+24,8 olarak dtam16);
            değişken a: tam64 = dma+(q olarak tam64)*4096;
            kem_mmio_yaz64(c+32,a); kem_mmio_yaz64(c+40,a+128); kem_mmio_yaz64(c+48,a+160);
            değişken kapi: tam64 = vnic_bildirim(vblk_o16(c+30) olarak tam64,carpan,uzun);
            eğer kapi<0 { kem_fiz_yaz8(c+20,139); ver hata("virtio kuyruk bildirim ofseti"); }
            vblk_y16(a+128,1 olarak dtam16);
