        kem_dma_bariyeri(); vblk_y16(a+130,((ag_vrx_gorulen+8)&65535) olarak dtam16);
    }
    eğer tur>0 { kem_dma_bariyeri(); vblk_y16(ag_vrx_bildir,0 olarak dtam16); }
