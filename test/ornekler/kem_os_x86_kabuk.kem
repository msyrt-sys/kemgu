// Farklı bir kaynak adrese geçerken önceki adresle yazılmış çerçeveler gönderilemez.
işlev ag_adres_kuyrugunu_bosalt() {
    güvensiz {
        eğer ag_bekleyen>0 {
            değişken t: Dizi<tam64> = ag_dizi64(ag_l3_alan+352);
            değişken i: tam32 = 0;
            iken i<4 { dizi_yaz(t,i*4+1,0 olarak tam64); i=i+1; }
            ag_atilan=ag_atilan+(ag_bekleyen olarak tam64); ag_bekleyen=0;
        }
        eğer ag_parca_aktif>0 { ag_parca_sure(9223372036854775807); }
        ag_dns_on_son=0;
    }
}
işlev ag_ip_sil() {
    güvensiz {
        değişken p: *AgL3 = ag_l3_alan olarak *AgL3; değişken s: AgL3 = *p;
        s.ip=0; s.gecit=0; s.onek=0; *p=s;
        değişken t: Dizi<tam64> = s.arp; değişken i: tam32 = 0;
        iken i<dizi_boyut(t) { dizi_yaz(t,i,0 olarak tam64); i=i+1; }
