    }
}
işlev ag_dhcp_girdi(b: Dizi<dtam8>,ofs: tam32,boy: tam32,smac: tam64) {
    güvensiz {
        değişken p: *DhcpKirasi = ag_l5 olarak *DhcpKirasi; değişken s: DhcpKirasi = *p;
        eğer s.durum==0 { ver; }
        değişken ms: tam64 = ag_us()/1000;
        değişken olay: tam32 = dhcp_al(&değişken s,b,ofs,boy,ag_mac,ms);
        eğer olay<=0 { ver; } *p=s;
        eğer olay==5 {
            değişken lp: *AgL3 = ag_l3_alan olarak *AgL3;
            eğer (*lp).ip!=s.adres veya (*lp).onek!=dhcp_onek(s.maske) veya (*lp).gecit!=s.gecit { ag_ip_ayarla(s.adres,dhcp_onek(s.maske),s.gecit); }
            arp_kaydet((*lp).arp,s.sunucu,smac,ms,30000);
        }
        eğer olay==6 { ag_ip_sil(); }
    }
}
işlev ag_udp_girdi(rx: Dizi<dtam8>,n: tam32) -> mantıksal {
    güvensiz {
        eğer ag_l5==0 veya n<34 veya ag_b8(rx,23)!=17 veya eth_tur(rx,n,ag_mac)!=2048 { ver yanlış; }
        değişken h: tam32 = ip4_baslik(rx,n); eğer h<0 veya (ag_be16(rx,20)&16383)!=0 { ver yanlış; }
        değişken src: tam64 = ag_be32(rx,26); değişken dst: tam64 = ag_be32(rx,30);
        değişken l: *AgL3 = ag_l3_alan olarak *AgL3;
        değişken u: tam32 = udp_oku(rx,h,ag_be16(rx,16)+14-h,src,dst);
        eğer u<0 {
            değişken ss: AgL3 = *l; eğer u== -2 { ss.saglama_hatasi=ss.saglama_hatasi+1; } değilse { ss.kisa=ss.kisa+1; } *l=ss; ver doğru;
        }
        değişken sp: tam32 = ag_be16(rx,h); değişken dp: tam32 = ag_be16(rx,h+2);
        değişken mac: tam64 = eth_mac(rx,6); değişken tx: Dizi<dtam8> = ag_dizi8(ag_l3_alan+288);
        eğer sp==67 ve dp==68 { ag_dhcp_girdi(rx,h+8,u,mac); ver doğru; }
