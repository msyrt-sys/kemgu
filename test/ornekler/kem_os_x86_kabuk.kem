        değişken id: tam64 = kem_mmio_oku32(p);
        değişken boy: tam64 = kem_mmio_oku32(p+4);
        eğer id>=8 { ag_atilan=ag_atilan+1; kem_fiz_yaz8(ag_bar+20,143); ver; }
        eğer boy>=26 ve boy<=1530 {
            ag_son_boy=(boy-12) olarak tam32;
            memcpy((a+40960) olarak *tam8,(a+8192+2048*id+12) olarak *tam8,boy-12);
            ag_rx_sayi=ag_rx_sayi+1; ag_rx_bayt=ag_rx_bayt+boy-12; ag_l3_girdi();
        } değilse { ag_atilan=ag_atilan+1; }
        vblk_y16(a+132+((ag_vrx_gorulen&7) olarak tam64)*2,(id olarak tam32) olarak dtam16);
