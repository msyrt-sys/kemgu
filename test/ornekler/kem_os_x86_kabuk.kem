// Bare-metal xHCI + BOT: FAT32 metadata'sı ve dosya sektörleri ayrı okunur.
// Python kâhini: tests/qemu/fat_yazici.py; 1300 bayt, üç küme.
kullan drivers::usb::xhci_cekirdek::{ XhciDurum, XhciAygit, xhci_yeni, xhci_adim, xhci_depo_hazir, xhci_kontrol, xhci_kontrol_yaz, xhci_giris, xhci_depo_giris };
kullan drivers::usb::xhci_kayit::{ XhciYetenek };
kullan drivers::usb::xhci_trb::{ XhciHalka, XhciOlayHalkasi };
kullan drivers::usb::tanim::{ UsbAygit, UsbArayuz, UsbUc, UsbHid, UsbHidEk, UsbYapilandirma, usb_setup, usb_hid_set_protocol, usb_hid_set_idle };
kullan drivers::ortak::bayt::{ bayt_sifir, oku_u8, oku_le16, oku_le32, oku_le64, yaz_u8 };
kullan drivers::fs::fat32_bpb::{ Fat32Bpb, BpbHatasi, bpb_coz, kume_sektoru };
kullan drivers::fs::fat32_dizin::{ DizinGirdisi, dizin_coz };
