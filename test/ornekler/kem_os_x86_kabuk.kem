işlev ag_tcp_ac(ip: tam64,es: tam64,port: tam32,ep: tam32,uyg: tam32,aktif: mantıksal) -> tam64 {
    güvensiz {
        eğer ag_tcp_alan==0 { ver 0; } değişken i: tam32 = 0;
