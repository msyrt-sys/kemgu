işlev ag_dhcp_adim() {
    güvensiz {
        eğer ag_l5==0 veya ag_bar==0 { ver; }
        değişken p: *DhcpKirasi = ag_l5 olarak *DhcpKirasi;
        değişken s: DhcpKirasi = *p;
        eğer s.durum==0 { ver; }
        değişken ms: tam64 = ag_us()/1000;
        eğer s.durum==3 ve ms<s.t1 { ver; }
