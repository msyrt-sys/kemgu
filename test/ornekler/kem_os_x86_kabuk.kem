işlev ag_tcp_girdi(b: Dizi<dtam8>,n: tam32,lo: mantıksal) -> mantıksal {
    güvensiz {
        eğer n<34 veya ag_b8(b,23)!=6 veya ag_tcp_alan==0 { ver yanlış; }
        değişken h: tam32 = ip4_baslik(b,n); eğer h<0 veya (ag_be16(b,20)&16383)!=0 { ver yanlış; }
        değişken l: *AgL3 = ag_l3_alan olarak *AgL3; değişken ip: tam64 = ag_be32(b,30); değişken es: tam64 = ag_be32(b,26);
        eğer lo { eğer ip>>24!=127 veya es>>24!=127 { ver doğru; } }
        değilse eğer eth_tur(b,n,ag_mac)!=2048 veya (*l).ip==0 veya ip!=(*l).ip veya es>>24==127 { ver doğru; }
        değişken v: TcpBaslik = tcp_baslik(b,h,ag_be16(b,16)+14-h,es,ip);
        eğer v.h<0 {
            değişken y: AgL3 = *l; eğer v.h== -2 { y.saglama_hatasi=y.saglama_hatasi+1; } değilse { y.kisa=y.kisa+1; } *l=y; ver doğru;
        }
        değişken k: tam64 = 0; değişken i: tam32 = 0;
        iken i<8 ve k==0 {
            değişken a: tam64 = ag_tcp_alan+266240*(i olarak tam64); i=i+1;
            eğer kem_mmio_oku32(a+320)>0 {
                değişken p: *TcpBag = a olarak *TcpBag;
                eğer (*p).ip==ip ve (*p).es==es ve (*p).port==v.dp ve (*p).es_port==v.sp { k=a; }
            }
        }
        eğer k==0 ve v.dp==ag_tcp_dinle ve (v.bayrak&23)==2 { k=ag_tcp_ac(ip,es,v.dp,v.sp,1,yanlış); }
        eğer k==0 {
            değişken tx: Dizi<dtam8> = ag_dizi8(ag_tcp_alan+2129920);
            değişken boy: tam32 = tcp_red(tx,34,ip,es,&v);
            eğer boy>0 { ag_tcp_red=ag_tcp_red+1; ag_tcp_paket(tx,boy,ip,es); } ver doğru;
        }
        değişken p: *TcpBag = k olarak *TcpBag; değişken s: TcpBag = *p;
        tcp_al(&değişken s,&v,b,h,ag_us()/1000); *p=s; ver doğru;
    }
}
// Soket ABI'sinden önceki yankı ve aktarım sınaması aynı gönder/al halkalarını kullanır.
işlev ag_tcp_uygulama(s: &değişken TcpBag,uyg: tam32,buf: Dizi<dtam8>) {
    güvensiz {
    eğer s.durum!=TCP_BAGLI ve s.durum!=TCP_KAPAT_BEKLE { ver; }
    değişken n: tam32 = s.rx_boy; eğer n>1460 { n=1460; }
    eğer uyg==1 {
        değişken yer: tam32 = dizi_boyut(s.tx)-s.tx_boy; eğer n>yer { n=yer; }
        eğer n>0 { n=tcp_oku(s,buf,0,n); tcp_yaz(s,buf,0,n); }
        eğer s.durum==TCP_KAPAT_BEKLE ve s.rx_boy==0 { tcp_kapat_iste(s); }
    } değilse eğer uyg==2 {
        eğer n>0 {
            n=tcp_oku(s,buf,0,n); değişken i: tam32 = 0;
            iken i<n {
                değişken j: tam64 = ag_tcp_okunan+(i olarak tam64);
                eğer (ag_b8(buf,i) olarak tam64)!=((j*37+j/251)&255) { ag_tcp_veri_hatasi=ag_tcp_veri_hatasi+1; }
                i=i+1;
            } ag_tcp_okunan=ag_tcp_okunan+(n olarak tam64);
        }
        değişken kalan: tam64 = ag_tcp_hedef_boy-ag_tcp_yazilan;
        eğer kalan>0 {
            değişken adet: tam32 = 1460; eğer kalan<1460 { adet=kalan olarak tam32; }
            değişken i: tam32 = 0; iken i<adet { değişken j: tam64 = ag_tcp_yazilan+(i olarak tam64); ag_y8(buf,i,j*37+j/251); i=i+1; }
            adet=tcp_yaz(s,buf,0,adet); eğer adet>0 { ag_tcp_yazilan=ag_tcp_yazilan+(adet olarak tam64); }
        }
        eğer ag_tcp_okunan==ag_tcp_hedef_boy ve ag_tcp_yazilan==ag_tcp_hedef_boy { tcp_kapat_iste(s); }
    }
    }
}
işlev ag_tcp_adim() {
    güvensiz {
        eğer ag_tcp_etkin==0 { ver; }
        değişken ms: tam64 = ag_us()/1000;
        değişken buf: Dizi<dtam8> = ag_dizi8(ag_tcp_alan+2129952); değişken tx: Dizi<dtam8> = ag_dizi8(ag_tcp_alan+2129920);
        değişken i: tam32 = 0;
        iken i<8 {
            değişken k: tam64 = ag_tcp_alan+266240*(i olarak tam64); i=i+1;
            değişken uyg: tam32 = kem_mmio_oku32(k+320) olarak tam32;
            eğer uyg>0 {
                değişken p: *TcpBag = k olarak *TcpBag; değişken s: TcpBag = *p;
                ag_tcp_uygulama(&değişken s,uyg,buf); değişken once: TcpBag = s;
                değişken n: tam32 = tcp_cikar(&değişken s,tx,34,ms); *p=s;
                eğer n>0 {
                    değişken aktarim: tam32 = ag_tcp_paket(tx,n,s.ip,s.es);
                    eğer aktarim<0 { *p=once; }
                }
                eğer s.durum==TCP_KAPALI {
                    eğer s.hata_kodu!=0 { ag_tcp_rst=ag_tcp_rst+1; } değilse { ag_tcp_bitti=ag_tcp_bitti+1; }
                    kem_mmio_yaz32(k+320,0); ag_tcp_etkin=ag_tcp_etkin-1;
                }
            }
        }
    }
}
işlev ag_tcp_komut(arg: metin) -> sonuç<mantıksal,metin> {
    güvensiz {
        eğer bm_esit(arg,"tcp dinle") { ag_tcp_dinle=9001; ekran_cift_yaz("TCP dinle 9001"); ver tamam(doğru); }
        eğer bm_esit(arg,"tcp durum") {
            ekran_cift_yaz(kd_tamsayi(kd_tamsayi(kd_tamsayi(kd_tamsayi("TCP yazilan okunan hata kapanan",ag_tcp_yazilan),ag_tcp_okunan),ag_tcp_veri_hatasi),ag_tcp_bitti));
            ver tamam(doğru);
        }
        eğer bm_esit(kd_bas(arg,9),"tcp bagla") {
            değişken ip: tam64 = ag_ip_oku(kd_kalan(arg,9)); değişken l: *AgL3 = ag_l3_alan olarak *AgL3; değişken yer: tam64 = (*l).ip;
            eğer ip<=0 { ver hata("TCP hedef adresi"); }
            eğer ip>>24==127 { yer=2130706433; } eğer yer==0 { ver hata("TCP yerel adres yok"); }
            değişken i: tam32 = 0; iken i<8 {
                eğer kem_mmio_oku32(ag_tcp_alan+266240*(i olarak tam64)+320)==2 { ver hata("TCP aktarimi suruyor"); } i=i+1;
            }
            ag_tcp_yazilan=0; ag_tcp_okunan=0; ag_tcp_veri_hatasi=0;
            eğer ag_tcp_ac(yer,ip,49152+(ag_tcp_kim%16384) olarak tam32,9001,2,doğru)==0 { ver hata("TCP tablosu dolu"); }
            ekran_cift_yaz("TCP baglanti basladi"); ver tamam(doğru);
        }
        ver hata("ag tcp dinle/bagla/durum");
    }
}

// Dört adet 64 KiB yuva ve bir adet büyük gönderim alanı.
küresel değişken ag_parca_alan: tam64 = 0;
küresel değişken ag_parca_birlesen: tam64 = 0;
küresel değişken ag_parca_atilan: tam64 = 0;
küresel değişken ag_parca_giden: tam64 = 0;
küresel değişken ag_parca_aktif: tam32 = 0;
işlev ag_parca_kur() -> mantıksal {
    güvensiz {
        eğer ag_bar==0 { ver doğru; }
        değişken a: tam64 = uefi_surec_ayir(77);
        eğer a==0 { ver yanlış; }
        memset(a olarak *tam8,0,315392);
        değişken i: tam32 = 0;
        iken i<4 {
            değişken k: tam64 = a+65536*(i olarak tam64);
            ag_dizi_baslik(k+128,k+512,74+PARCA_SINIR,4); ag_dizi_baslik(k+160,k+50176,PARCA_SINIR/8,4); i=i+1;
        }
        ag_dizi_baslik(a+262144,a+262272,74+PARCA_SINIR,4); ag_parca_alan=a; ver ag_tcp_kur();
    }
}
işlev ag_parca_sure(ms: tam64) {
    güvensiz {
        eğer ag_parca_aktif==0 { ver; }
        değişken i: tam32 = 0;
        iken i<4 {
            değişken p: *ParcaYuvasi = (ag_parca_alan+65536*(i olarak tam64)) olarak *ParcaYuvasi;
            değişken yuva: ParcaYuvasi = *p;
            eğer parca_yaslandir(&değişken yuva,ms) { *p=yuva; ag_parca_atilan=ag_parca_atilan+1; ag_parca_aktif=ag_parca_aktif-1; }
            i=i+1;
        }
    }
}
işlev ag_ip_buyuk_gonder(b: Dizi<dtam8>,n: tam32) -> tam32 {
    güvensiz {
        eğer n<=1514 { ver ag_dizi_gonder(b,n); }
        değişken kucuk: Dizi<dtam8> = ag_dizi8(ag_l3_alan+288);
        değişken bas: tam32 = 0;
        iken bas<n-34 {
            değişken boy: tam32 = parca_giden(b,n,bas,1500,kucuk);
            eğer boy<0 { ver boy; }
            değişken r: tam32 = ag_dizi_gonder(kucuk,boy);
            eğer r<0 { ver r; }
            bas=bas+boy-34; ag_parca_giden=ag_parca_giden+1;
        }
        ver 0;
    }
}
işlev ag_parca_girdi(b: Dizi<dtam8>,n: tam32,ms: tam64) {
    güvensiz {
        değişken l: *AgL3 = ag_l3_alan olarak *AgL3;
        eğer ag_parca_alan==0 veya (*l).ip==0 veya ag_be32(b,30)!=(*l).ip veya eth_tur(b,n,ag_mac)!=2048 { ver; }
        ag_parca_sure(ms);
        değişken sec: tam64 = 0; değişken i: tam32 = 0;
        iken i<4 {
            değişken k: tam64 = ag_parca_alan+65536*(i olarak tam64);
            değişken p: *ParcaYuvasi = k olarak *ParcaYuvasi; değişken y: ParcaYuvasi = *p;
            eğer parca_es(&değişken y,b) { sec=k; }
            eğer y.bitis_ms==0 ve sec==0 { sec=k; } i=i+1;
        }
        eğer sec==0 { ag_parca_atilan=ag_parca_atilan+1; ver; }
        değişken p: *ParcaYuvasi = sec olarak *ParcaYuvasi; değişken y: ParcaYuvasi = *p; değişken once: tam64 = y.bitis_ms;
        değişken buf: Dizi<dtam8> = ag_dizi8(sec+128);
        değişken boy: tam32 = parca_al(&değişken y,b,n,buf,ag_dizi8(sec+160),ms); *p=y;
        eğer once==0 ve y.bitis_ms!=0 { ag_parca_aktif=ag_parca_aktif+1; }
        eğer once!=0 ve y.bitis_ms==0 { ag_parca_aktif=ag_parca_aktif-1; }
        eğer boy<0 { ag_parca_atilan=ag_parca_atilan+1; ver; }
        eğer boy==0 { ver; }
        ag_parca_birlesen=ag_parca_birlesen+1;
        eğer ag_udp_girdi(buf,boy) veya ag_tcp_girdi(buf,boy,yanlış) { ver; }
        değişken tx: Dizi<dtam8> = ag_dizi8(ag_parca_alan+262144);
        boy=ag_l3_isle(buf,boy,tx,ms,yanlış);
        eğer boy>0 ve ag_ip_buyuk_gonder(tx,boy)<0 { ag_atilan=ag_atilan+1; }
    }
}
işlev ag_l3_kur() -> mantıksal {
    güvensiz {
        eğer ag_l3_alan!=0 { ver doğru; }
        eğer bm_cevrim_us<=0 { bm_cevrim_us=bm_pit_olc(); }
        eğer bm_cevrim_us<=0 { ver yanlış; }
        değişken a: tam64 = uefi_surec_ayir(7);
        eğer a==0 { ver yanlış; }
        memset(a olarak *tam8,0,28672);
        ag_dizi_baslik(a+256,a+4096,1536,4); ag_dizi_baslik(a+288,a+12288,1536,4);
        ag_dizi_baslik(a+320,a+512,48,8); ag_dizi_baslik(a+352,a+1024,16,8);
        değişken s: *AgL3 = a olarak *AgL3;
        *s=l3_yeni(ag_mac,ag_dizi64(a+320)); ag_l3_alan=a;
        eğer değil ag_l5_kur() { ver yanlış; } ver ag_parca_kur();
    }
}
işlev ag_dizi_gonder(b: Dizi<dtam8>,n: tam32) -> tam32 {
    güvensiz {
        eğer ag_l3_alan==0 veya n<14 veya n>dizi_boyut(b) veya n>1518 { ver -90; }
        değişken a: tam64 = ag_l3_alan+20480;
        değişken i: tam32 = 0;
        iken i<n { kem_fiz_yaz8(a+(i olarak tam64),ag_b8(b,i)); i=i+1; }
        // Kısa Ethernet çerçevesinin dolgusu daha önceki paketin baytlarını taşımamalı.
        iken i<60 { kem_fiz_yaz8(a+(i olarak tam64),0); i=i+1; }
        ver ag_gonder(a,i);
    }
}
işlev ag_l3_isle(rx: Dizi<dtam8>,n: tam32,tx: Dizi<dtam8>,ms: tam64,lo: mantıksal) -> tam32 {
    güvensiz {
        değişken p: *AgL3 = ag_l3_alan olarak *AgL3;
        değişken s: AgL3 = *p;
        değişken sonuc: tam32 = l3_al(&değişken s,rx,n,tx,ms,lo);
        *p=s; ver sonuc;
    }
}
işlev ag_l3_ping(tx: Dizi<dtam8>,ip: tam64,mac: tam64,hedef: tam64,kim: tam32,sira: tam32) -> tam32 {
    güvensiz {
        değişken p: *AgL3 = ag_l3_alan olarak *AgL3;
        değişken s: AgL3 = *p;
        değişken n: tam32 = l3_ping(&değişken s,tx,ip,mac,hedef,kim,sira);
        *p=s; ver n;
    }
}
işlev ag_l3_girdi() {
    güvensiz {
        eğer ag_l3_alan==0 veya ag_son_boy<14 veya ag_son_boy>1518 { ver; }
        değişken t: tam32 = (kem_fiz_oku8(ag_dma+40972)<<8)|kem_fiz_oku8(ag_dma+40973);
        değişken s: *AgL3 = ag_l3_alan olarak *AgL3;
        eğer t!=2048 ve t!=2054 { değişken yeni: AgL3 = *s; yeni.bilinmeyen=yeni.bilinmeyen+1; *s=yeni; ver; }
        değişken rx: Dizi<dtam8> = ag_dizi8(ag_l3_alan+256); değişken tx: Dizi<dtam8> = ag_dizi8(ag_l3_alan+288);
        değişken i: tam32 = 0;
        iken i<ag_son_boy { ag_y8(rx,i,kem_fiz_oku8(ag_dma+40960+(i olarak tam64)) olarak tam64); i=i+1; }
        eğer t==2048 ve (ag_be16(rx,20)&16383)!=0 ve ip4_baslik(rx,ag_son_boy)>=0 { ag_parca_girdi(rx,ag_son_boy,ag_us()/1000); ver; }
        eğer t==2048 ve (ag_udp_girdi(rx,ag_son_boy) veya ag_tcp_girdi(rx,ag_son_boy,yanlış)) { ver; }
        değişken once: tam64 = (*s).cakisma;
        değişken n: tam32 = ag_l3_isle(rx,ag_son_boy,tx,ag_us()/1000,yanlış);
        eğer once!=(*s).cakisma { bm_yaz("AG UYARI IPv4 adres cakismasi"); }
        eğer n>0 { eğer ag_dizi_gonder(tx,n)<0 { ag_atilan=ag_atilan+1; } }
    }
}
işlev ag_ip_ayarla(adres: tam64,onek: tam32,gecit: tam64) -> tam32 {
    güvensiz {
        eğer ag_bar==0 veya ag_l3_alan==0 { ver -19; }
        eğer adres<=0 veya (adres>>24)==127 veya (adres>>24)>=224 veya onek<0 veya onek>32 veya gecit<0 { ver -22; }
        değişken s: *AgL3 = ag_l3_alan olarak *AgL3;
        değişken t: Dizi<tam64> = (*s).arp;
        değişken i: tam32 = 0; iken i<dizi_boyut(t) { dizi_yaz(t,i,0 olarak tam64); i=i+1; }
        ag_adres_kuyrugunu_bosalt();
        değişken yeni: AgL3 = *s; yeni.ip=adres; yeni.gecit=gecit; yeni.onek=onek; *s=yeni;
        değişken b: Dizi<dtam8> = ag_dizi8(ag_l3_alan+288);
        değişken n: tam32 = arp_yaz(b,1,ag_mac,adres,0,adres);
        ver ag_dizi_gonder(b,n);
    }
}
küresel değişken ag_bekleyen: tam32 = 0;
işlev ag_bekleyenleri_isle() {
    güvensiz {
        eğer ag_bekleyen<=0 { ver; }
        değişken s: *AgL3 = ag_l3_alan olarak *AgL3;
        değişken t: Dizi<tam64> = ag_dizi64(ag_l3_alan+352); değişken ms: tam64 = ag_us()/1000;
        değişken i: tam32 = 0;
        iken i<4 {
            değişken k: tam32 = i*4; değişken n: tam32 = dizi_al(t,k+1) olarak tam32;
            eğer n>0 {
                değişken ip: tam64 = dizi_al(t,k);
                değişken m: tam64 = arp_bul((*s).arp,ip,ms);
                değişken adim: tam32 = arp_bekleme_adimi(t,i,ms,m);
                eğer adim==1 {
                    değişken tx: Dizi<dtam8> = ag_dizi8(ag_l3_alan+288);
                    değişken boy: tam32 = arp_yaz(tx,1,(*s).mac,(*s).ip,0,ip);
                    ag_dizi_gonder(tx,boy);
                }
                eğer adim==2 {
                    değişken a: tam64 = ag_l3_alan+22528+(i olarak tam64)*1536;
                    değişken j: tam32 = 0;
                    iken j<6 { kem_fiz_yaz8(a+(j olarak tam64),((m>>(8*j))&255) olarak tam32); j=j+1; }
                    değişken r: tam32 = ag_gonder(a,n);
                    eğer r== -11 { adim=0; } değilse eğer r<0 { adim=r; }
                }
                eğer adim<0 veya adim==2 {
                    dizi_yaz(t,k+1,0 olarak tam64); ag_bekleyen=ag_bekleyen-1;
                    eğer adim<0 { ag_atilan=ag_atilan+1; }
                }
            }
            i=i+1;
        }
    }
}
işlev ag_ip_cik(b: Dizi<dtam8>,n: tam32,hop: tam64,ms: tam64) -> tam32 {
    güvensiz {
        değişken s: *AgL3 = ag_l3_alan olarak *AgL3;
        değişken m: tam64 = arp_bul((*s).arp,hop,ag_us()/1000);
        eğer m>0 { eth_mac_yaz(b,0,m); ver ag_dizi_gonder(b,n); }
        değişken t: Dizi<tam64> = ag_dizi64(ag_l3_alan+352);
        değişken yuva: tam32 = arp_beklet(t,hop,n,ag_us()/1000,ms);
        eğer yuva<0 { ag_atilan=ag_atilan+1; ver yuva; }
        değişken a: tam64 = ag_l3_alan+22528+(yuva olarak tam64)*1536;
        değişken j: tam32 = 0; iken j<n { kem_fiz_yaz8(a+(j olarak tam64),ag_b8(b,j)); j=j+1; }
        ag_bekleyen=ag_bekleyen+1; ag_bekleyenleri_isle(); ver 0;
    }
}

işlev ag_ping_iste(hedef: tam64,sira: tam64,ms: tam64) -> tam64 {
    güvensiz {
        eğer ag_l3_alan==0 { ver -19; }
        eğer hedef<=0 veya hedef>4294967295 veya sira<0 veya sira>65535 veya ms<1 veya ms>5000 { ver -22; }
        değişken s: *AgL3 = ag_l3_alan olarak *AgL3;
        değişken tx: Dizi<dtam8> = ag_dizi8(ag_l3_alan+288);
        değişken rx: Dizi<dtam8> = ag_dizi8(ag_l3_alan+256);
        değişken kim: tam32 = ag_sonraki_kim; ag_sonraki_kim=(kim+1)&65535;
        değişken bas: tam64 = ag_us(); değişken son: tam64 = bas+ms*1000;
        eğer (hedef>>24)==127 {
            değişken n: tam32 = ag_l3_ping(tx,2130706433,(*s).mac,hedef,kim,sira olarak tam32);
            n=ag_l3_isle(tx,n,rx,bas/1000,doğru); ag_lo_tx=ag_lo_tx+1; ag_lo_rx=ag_lo_rx+1; ag_lo_bayt=ag_lo_bayt+74;
            eğer n>0 { ag_l3_isle(rx,n,tx,ag_us()/1000,doğru); ag_lo_tx=ag_lo_tx+1; ag_lo_rx=ag_lo_rx+1; ag_lo_bayt=ag_lo_bayt+74; }
        } değilse {
            eğer ag_bar==0 veya ag_link()==0 { ver -100; }
            eğer (*s).ip==0 { ver -99; }
            değişken hop: tam64 = ip4_sonraki((*s).ip,(*s).onek,(*s).gecit,hedef);
            eğer hop<=0 { ver -101; }
            değişken n: tam32 = ag_l3_ping(tx,(*s).ip,0,hedef,kim,sira olarak tam32);
            değişken g: tam32 = ag_ip_cik(tx,n,hop,ms); eğer g<0 { ver g olarak tam64; }
            iken (*s).ping_sonuc==0 ve ag_us()<son { ag_al(); }
        }
        eğer (*s).ping_sonuc==0 { ver -110; } eğer (*s).ping_sonuc<0 { ver (*s).ping_sonuc olarak tam64; }
        ver ag_us()-bas;
    }
}

işlev ag_mac_metin(mac: tam64) -> metin {
    değişken m: metin = ""; değişken i: tam32 = 0;
    iken i<6 {
        eğer i>0 { m=metin_birlestir(m,":"); }
        m=metin_birlestir(m,kd_hex_n((mac>>(8*i))&255,2)); i=i+1;
    }
    ver m;
}
çıplak işlev ag_durumu(lo: mantıksal) -> AgArayuz {
    eğer lo { ver AgArayuz {model:5,mac:0,bagli:doğru,rx:ag_lo_rx,tx:ag_lo_tx,rx_bayt:ag_lo_bayt,tx_bayt:ag_lo_bayt,atilan:0}; }
    ver AgArayuz {model:ag_model,mac:ag_mac,bagli:ag_link()!=0,rx:ag_rx_sayi,tx:ag_tx_sayi,rx_bayt:ag_rx_bayt,tx_bayt:ag_tx_bayt,atilan:ag_atilan};
}
işlev ag_satir() -> metin {
    güvensiz {
        değişken ar: AgArayuz = ag_durumu(yanlış);
        değişken link: tam64 = 0; eğer ar.bagli { link=1; }
        değişken s: metin = metin_birlestir(metin_birlestir("NIC ",ag_model_adi(ar.model)),metin_birlestir(" ",ag_mac_metin(ar.mac)));
        s=kd_tamsayi(metin_birlestir(s," link"),link);
        s=kd_tamsayi(metin_birlestir(s," rx"),ar.rx);
        s=kd_tamsayi(metin_birlestir(s," tx"),ar.tx);
        s=kd_tamsayi(metin_birlestir(s," rx_bayt"),ar.rx_bayt);
        s=kd_tamsayi(metin_birlestir(s," tx_bayt"),ar.tx_bayt);
        s=kd_tamsayi(metin_birlestir(s," atilan"),ar.atilan);
        ver kd_tamsayi(metin_birlestir(s," vektor"),ag_vektor olarak tam64);
    }
}
işlev ag_parca_satir() -> metin {
    güvensiz { ver kd_tamsayi(kd_tamsayi(kd_tamsayi("PARCA birlesen atilan giden",ag_parca_birlesen),ag_parca_atilan),ag_parca_giden); }
}
işlev ag_komut(arg: metin) -> sonuç<mantıksal,metin> {
    güvensiz {
        eğer bm_esit(arg,"lo") {
            değişken ar: AgArayuz = ag_durumu(doğru);
            ekran_cift_yaz(kd_tamsayi(kd_tamsayi("lo 127.0.0.1/8 rx tx",ar.rx),ar.tx)); ver tamam(doğru);
        }
        eğer ag_bar==0 { ver hata("ag arayuzu yok"); }
        ag_al();
        eğer bm_esit(kd_bas(arg,kd_bosluk(arg)),"tcp") { ver ag_tcp_komut(arg); }
        eğer bm_esit(arg,"parca") {
            ekran_cift_yaz(ag_parca_satir()); ver tamam(doğru);
        }
        eğer bm_esit(arg,"sayac") {
            eğer ag_l3_alan==0 { ver hata("L3 tablosu yok"); }
            değişken s: *AgL3 = ag_l3_alan olarak *AgL3;
            değişken m: metin = kd_tamsayi(kd_tamsayi("kisa saglama",(*s).kisa),(*s).saglama_hatasi);
            m=kd_tamsayi(kd_tamsayi(metin_birlestir(m," bilinmeyen arp_dolu"),(*s).bilinmeyen),(*s).arp_dolu);
            ekran_cift_yaz(kd_tamsayi(kd_tamsayi(kd_tamsayi(metin_birlestir(m," cakisma ttl icmp_hata"),(*s).cakisma),(*s).ttl),(*s).icmp_hata));
            ekran_cift_yaz(ag_parca_satir());
            ver tamam(doğru);
        }
        eğer bm_esit(arg,"dhcp") veya bm_esit(arg,"dhcp kapat") {
            eğer ag_l5==0 { ver hata("DHCP tablosu yok"); }
            değişken p: *DhcpKirasi = ag_l5 olarak *DhcpKirasi; değişken v: DhcpKirasi = dhcp_yeni((ag_us()^ag_mac)&4294967295);
            ag_ip_sil(); eğer bm_esit(arg,"dhcp kapat") { v.durum=0; }
            *p=v; ag_dhcp_adim(); ekran_cift_yaz("DHCP OK"); ver tamam(doğru);
        }
        eğer bm_esit(arg,"durum") {
            değişken p: *DhcpKirasi = ag_l5 olarak *DhcpKirasi; değişken l: *AgL3 = ag_l3_alan olarak *AgL3;
            değişken m: metin = kd_tamsayi("DHCP",(*p).durum olarak tam64);
            m=metin_birlestir(metin_birlestir(m," ip "),ag_ip_metin((*l).ip));
            m=metin_birlestir(metin_birlestir(m," dns "),ag_ip_metin((*p).dns));
            ekran_cift_yaz(metin_birlestir(metin_birlestir(m," ntp "),ag_ip_metin((*p).ntp))); ver tamam(doğru);
        }
        eğer bm_esit(arg,"yanki") {
            değişken t: Dizi<tam64> = ag_dizi64(ag_l5+256);
            eğer ag_udp_port!=9000 ve udp_bagla(t,9000)<0 { ver hata("UDP port tablosu dolu"); }
            ag_udp_port=9000; ekran_cift_yaz("UDP yanki 9000"); ver tamam(doğru);
        }
        değişken ilk: tam32 = kd_bosluk(arg);
        eğer bm_esit(kd_bas(arg,ilk),"ayarla") {
            değişken kal: metin = kd_kalan(arg,ilk);
            değişken bos: tam32 = kd_bosluk(kal);
            değişken sol: metin = kd_bas(kal,bos); değişken k: tam32 = 0;
            iken k<metin_uzunluk(sol) ve (metin_bayt(sol,k) olarak tam32)!=47 { k=k+1; }
            eğer k==metin_uzunluk(sol) { ver hata("ag ayarla adres/onek gecit"); }
            değişken onek: tam32 = 0; değişken i: tam32 = k+1;
            eğer i==metin_uzunluk(sol) { ver hata("ag onek"); }
            iken i<metin_uzunluk(sol) {
                değişken d: tam32 = metin_bayt(sol,i) olarak tam32; eğer d<48 veya d>57 { ver hata("ag onek"); }
                onek=onek*10+d-48; eğer onek>32 { ver hata("ag onek"); } i=i+1;
            }
            eğer ag_ip_ayarla(ag_ip_oku(kd_bas(sol,k)),onek,ag_ip_oku(kd_kalan(kal,bos)))<0 { ver hata("ag adresi uygulanamadi"); }
            eğer ag_l5!=0 { değişken p: *DhcpKirasi = ag_l5 olarak *DhcpKirasi; değişken v: DhcpKirasi = *p; v.durum=0; *p=v; }
            ekran_cift_yaz("AG AYAR OK"); ver tamam(doğru);
        }
        eğer bm_esit(arg,"") { ekran_cift_yaz(ag_satir()); ver tamam(doğru); }
        eğer bm_esit(arg,"dene") {
            değişken a: tam64 = ag_dma+43008;
            değişken i: tam32 = 0;
            iken i<60 {
                değişken x: tam32 = i;
                eğer i<6 { x=255; } değilse eğer i<12 { x=((ag_mac>>((i-6)*8))&255) olarak tam32; }
                eğer i==12 { x=136; } eğer i==13 { x=181; }
                kem_fiz_yaz8(a+(i olarak tam64),x); i=i+1;
            }
            eğer ag_gonder(a,60)<0 { ver hata("ag gonderilemedi"); }
            ver tamam(doğru);
        }
        eğer bm_esit(arg,"son") {
            değişken s: metin = "CERCEVE "; değişken i: tam32 = 0;
            iken i<ag_son_boy { s=metin_birlestir(s,kd_hex_n(kem_fiz_oku8(ag_dma+40960+(i olarak tam64)) olarak tam64,2)); i=i+1; }
            ekran_cift_yaz(s); ver tamam(doğru);
        }
        ver hata("ag [ayarla|lo|sayac|dene|son]");
    }
}

işlev kd_donanim(d: &değişken KabukDisk,x: &değişken XhciDurum,indeks: tam32,usb_fare: mantıksal,yol: metin) -> sonuç<mantıksal,metin> {
    değişken satirlar: Dizi<metin> = []; dizi_ekle(satirlar,kd_cpu());
    eğer uefi_mi() {
        eşleş uefi_bilgi() { hata(e) => { ver hata(e); } tamam(b) => {
            değişken harita: tam64 = dizi_al(b.alan,9);
            değişken n: tam64 = dizi_al(b.alan,10);
            değişken adim: tam64 = dizi_al(b.alan,11);
            değişken ofs: tam64 = 0; değişken sayfa: tam64 = 0;
            iken ofs < n { eğer kem_mmio_oku32(harita+ofs) == 7 { sayfa=sayfa+kem_mmio_oku64(harita+ofs+24); } ofs=ofs+adim; }
            dizi_ekle(satirlar,kd_tamsayi(kd_tamsayi("BELLEK bolge sayfa",n/adim),sayfa));
            değişken g: metin = kd_tamsayi("GOP",dizi_al(b.alan,5));
            g=kd_tamsayi(g,dizi_al(b.alan,6));g=kd_tamsayi(g,dizi_al(b.alan,7));dizi_ekle(satirlar,kd_tamsayi(g,dizi_al(b.alan,8)));
            eşleş uefi_tablo_raporu(b,satirlar,yanlış) { hata(e) => { dizi_ekle(satirlar,metin_birlestir("ACPI HATA ",e)); } tamam(v) => {} }
            eşleş uefi_madt(b) { hata(e) => { dizi_ekle(satirlar,metin_birlestir("MADT HATA ",e)); } tamam(m) => {
                dizi_ekle(satirlar,kd_tamsayi(kd_tamsayi("MADT lapic girdiler",m.lapic_adresi),dizi_boyut(m.girdiler) olarak tam64));
            } }
        } }
    } değilse { dizi_ekle(satirlar,"PVH: UEFI bilgisi yok"); }
    güvensiz { dizi_ekle(satirlar,kd_tamsayi(kd_tamsayi(kd_tamsayi("8042 oztest port1 port2",ps2_oztest olarak tam64),ps2_port1 olarak tam64),ps2_port2 olarak tam64)); }
    kd_pci_rapor(satirlar); kd_kesme_rapor(satirlar);
    güvensiz { eğer ag_bar!=0 { dizi_ekle(satirlar,ag_satir()); dizi_ekle(satirlar,ag_parca_satir()); } }
    için a: x.aygitlar { eğer a.yuva != 0 {
        değişken s: metin = kd_tamsayi("USB",a.yuva olarak tam64);
        s=metin_birlestir(s,metin_birlestir(" ",kd_hex_n(a.kimlik.vid olarak tam64,4)));
        s=metin_birlestir(s,metin_birlestir(":",kd_hex_n(a.kimlik.pid olarak tam64,4)));
        için ar: a.yapi.arayuzlar { s=kd_tamsayi(s,ar.sinif olarak tam64); }
        dizi_ekle(satirlar,s);
        eğer a.derinlik > 0 veya a.hub.portlar > 0 {
            değişken yol: metin = kd_tamsayi("USB_YOL",a.yuva olarak tam64);
            yol=kd_tamsayi(yol,a.port olarak tam64); yol=kd_tamsayi(yol,a.rota olarak tam64);
            yol=kd_tamsayi(yol,a.ust olarak tam64); yol=kd_tamsayi(yol,a.alt olarak tam64);
            dizi_ekle(satirlar,kd_tamsayi(yol,a.hub.portlar olarak tam64));
        } }
    }
    için ay: d.aygitlar { eğer değil bm_esit(ay.ad,"/ram") ve (ay.nesil_adres == 0 veya kem_mmio_oku64(ay.nesil_adres) == ay.nesil) { dizi_ekle(satirlar,metin_birlestir("DISK ",ay.ad)); } }
    için k: d.baglar { eğer değil bm_esit(k.kayit.ad,"/ram") ve kd_hub_bagli(d,k.indeks) { dizi_ekle(satirlar,kd_tamsayi(kd_tamsayi(metin_birlestir("BOLUM ",k.kayit.ad),k.bolum.bas),k.bolum.adet)); } }
    değişken klavye: metin = "KLAVYE PS/2"; eğer indeks >= 0 { klavye="KLAVYE USB"; }
    dizi_ekle(satirlar,klavye);
    değişken fare: metin = "FARE yok"; eğer ps2_kesme_etkin() { fare="FARE PS/2"; }
    eğer usb_fare { fare="FARE USB"; } dizi_ekle(satirlar,fare);
    eğer metin_uzunluk(yol) == 0 { için s: satirlar { ekran_cift_yaz(s); } ver tamam(doğru); }
    değişken b: Dizi<dtam8> = [];
    için s: satirlar {
        değişken n: tam32 = metin_uzunluk(s) olarak tam32;
        eğer n+1 > 65536-dizi_boyut(b) { ver hata("donanim raporu 64 KiB siniri"); }
        değişken i: tam32 = 0;
        iken i < n { dizi_ekle(b,metin_bayt(s,i) olarak dtam8);i=i+1; }
        dizi_ekle(b,10 olarak dtam8);
    }
    eşleş kd_yol(d,yol) { hata(e) => { ver hata(e); } tamam(k) => { eşleş kd_mutasyon(d,k,FatYazIslem::Yaz(b)) { hata(e) => { ver hata(e); } tamam(v) => { ver kd_sync(d); } } } }
}
işlev kd_log(d: &değişken KabukDisk,arg: metin) -> sonuç<mantıksal,metin> {
    değişken veri: Dizi<dtam8> = [];
    değişken n: tam64 = 0; değişken dusen: tam64 = 0;
    güvensiz { n=kgun_adet; dusen=kgun_dusen; }
    değişken baslik: metin = kd_tamsayi("LOG dusen_satir",dusen);
    değişken j: tam32 = 0;
    iken j < metin_uzunluk(baslik) { dizi_ekle(veri,metin_bayt(baslik,j) olarak dtam8);j=j+1; }
    dizi_ekle(veri,10 olarak dtam8);
    // Yazdırmadan önce kopya al, log çıktısı bir sonraki anlık görüntüye girer.
    değişken i: tam64 = 0;
    iken i < n { dizi_ekle(veri,kgun_oku(i) olarak dtam8);i=i+1; }
    değişken pos: tam32 = kd_bosluk(arg);
    eğer bm_esit(kd_bas(arg,pos),"kaydet") {
        değişken ad: metin = kd_kalan(arg,pos);
        eğer metin_uzunluk(ad) == 0 { ver hata("log kaydet <yol>"); }
        eşleş kd_mutlak(d.cwd,ad) { hata(e) => { ver hata(e); } tamam(y) => {
            eşleş kd_yol(d,y) { hata(e) => { ver hata(e); } tamam(k) => {
                eşleş kd_mutasyon(d,k,FatYazIslem::Yaz(veri)) { hata(e) => { ver hata(e); } tamam(v) => { ver kd_sync(d); } }
            } }
        } }
    }
    değişken sayfa: tam64 = 1;
    eğer metin_uzunluk(arg) > 0 { sayfa=kd_sayi_arg(arg); }
    eğer sayfa < 1 veya sayfa > KGUN_BOY { ver hata("log sayfa siniri"); }
    değişken satir: tam64 = 0; j=0;
    iken j < dizi_boyut(veri) {
        değişken c: tam32 = oku_u8(veri,j);
        eğer satir/20+1 == sayfa { ekran_cift_bayt(c); }
        eğer c == 10 { satir=satir+1; } j=j+1;
    }
    eğer (sayfa-1)*20 >= satir { ver hata("log sayfa yok"); }
    eğer sayfa*20 < satir { ekran_cift_yaz(metin_birlestir("Devami: log ",tam_metin(sayfa+1))); }
    ver tamam(doğru);
}
// Sözcükleri ve <, >, >>, | işleçlerini boşluk olmasa da ayrı tanı.
yapı KbAsama { argv: Dizi<metin>; gir: metin; cik: metin; ekle: mantıksal; }
işlev kb_islec(c: tam32) -> mantıksal { ver c == 124 veya c == 60 veya c == 62; }
işlev kb_hat_mi(s: metin) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < metin_uzunluk(s) { eğer kb_islec(metin_bayt(s,i) olarak tam32) { ver doğru; } i=i+1; }
    ver yanlış;
}
işlev kb_bol(s: metin) -> sonuç<Dizi<KbAsama>,metin> {
    değişken asamalar: Dizi<KbAsama> = [];
    değişken a: KbAsama = KbAsama {argv:[],gir:"",cik:"",ekle:yanlış};
    değişken i: tam32 = 0; değişken kip: tam32 = 0;
    iken i < metin_uzunluk(s) {
        değişken c: tam32 = metin_bayt(s,i) olarak tam32;
        eğer c == 32 { i=i+1; }
        değilse eğer kb_islec(c) {
            eğer kip != 0 { ver hata("yonlendirme yolu eksik"); }
            i=i+1;
            eğer c == 124 {
                eğer dizi_boyut(a.argv) == 0 veya metin_uzunluk(a.cik) > 0 { ver hata("boru asamasi"); }
                eğer dizi_boyut(asamalar) >= 2 { ver hata("boru 3 asama siniri"); }
                dizi_ekle(asamalar,a); a=KbAsama {argv:[],gir:"",cik:"",ekle:yanlış};
            } değilse {
                kip=c;
                eğer c == 62 ve i < metin_uzunluk(s) ve metin_bayt(s,i) == 62 { a.ekle=doğru; i=i+1; }
            }
        } değilse {
            değişken bas: tam32 = i;
            iken i < metin_uzunluk(s) ve metin_bayt(s,i) != 32 ve değil kb_islec(metin_bayt(s,i) olarak tam32) { i=i+1; }
            değişken m: metin = metin_kes(s,bas,i-bas);
            eğer kip == 60 {
                eğer metin_uzunluk(a.gir) != 0 veya dizi_boyut(asamalar) != 0 { ver hata("birden cok giris"); } a.gir=m;
            } değilse eğer kip == 62 {
                eğer metin_uzunluk(a.cik) != 0 { ver hata("birden cok cikis"); } a.cik=m;
            } değilse {
                eğer dizi_boyut(a.argv) >= 32 { ver hata("cok arguman"); } dizi_ekle(a.argv,m);
            }
            kip=0;
        }
    }
    eğer kip != 0 veya dizi_boyut(a.argv) == 0 { ver hata("eksik boru komutu"); }
    dizi_ekle(asamalar,a); ver tamam(asamalar);
}
işlev kb_dosya(b: &değişken KsvBaglam,fd: tam32,ad: metin,kip: tam64) -> sonuç<mantıksal,metin> {
    eşleş kd_mutlak(b.disk.cwd,ad) { hata(e) => { ver hata(e); } tamam(m) => {
        eşleş kd_yol(&değişken b.disk,m) { hata(e) => { ver hata(e); } tamam(y) => {
            değişken r: tam64 = ksv_dosya_ac(b,fd,y,kip);
            eğer r < 0 { ver hata(metin_birlestir("yonlendirme ",tam_metin(r))); } ver tamam(doğru);
        } }
    } }
}
işlev kb_hazirla(p: &değişken KsKabukSureci,b: &değişken KsvBaglam,adimlar: Dizi<KbAsama>,yuvalar: Dizi<tam64>) -> sonuç<mantıksal,metin> {
    için a: adimlar {
        değişken ad: metin = dizi_al(a.argv,0);
        eşleş ks_program_adi(&değişken b.disk,ad) { hata(e) => { ver hata(e); } tamam(yol) => { dizi_yaz(a.argv,0,yol); } }
        eşleş ks_baslat(p,b,a.argv,0) { hata(e) => { ver hata(e); } tamam(y) => { dizi_ekle(yuvalar,y); } }
    }
    değişken i: tam32 = 0;
    iken i < dizi_boyut(yuvalar) {
        değişken y: tam32 = dizi_al(yuvalar,i) olarak tam32;
        değişken cocuk: KsvBaglam = dizi_al(p.baglamlar,y);
        değişken a: KbAsama = dizi_al(adimlar,i);
        eğer metin_uzunluk(a.gir) > 0 { eşleş kb_dosya(&değişken cocuk,0,a.gir,0) { hata(e) => { ver hata(e); } tamam(v) => { } } }
        eğer metin_uzunluk(a.cik) > 0 {
            değişken kip: tam64 = 11; eğer a.ekle { kip=7; }
            eşleş kb_dosya(&değişken cocuk,1,a.cik,kip) { hata(e) => { ver hata(e); } tamam(v) => { } }
        }
        eğer i+1 < dizi_boyut(yuvalar) {
            değişken halka: tam64 = kb_yeni(); eğer halka == 0 { ver hata("boru havuzu dolu"); }
            değişken sonraki: KsvBaglam = dizi_al(p.baglamlar,dizi_al(yuvalar,i+1) olarak tam32);
            dizi_yaz(cocuk.fds,1,kb_uc(halka,doğru)); dizi_yaz(sonraki.fds,0,kb_uc(halka,yanlış));
        }
        dizi_yaz(p.baglamlar,y,cocuk); i=i+1;
    } ver tamam(doğru);
}
işlev kb_calistir(d: &değişken KabukDisk,p: &değişken KsKabukSureci,s: metin,x: &değişken XhciDurum,h: &değişken HidKlavye,tr: &değişken KlavyeDurumu) -> sonuç<mantıksal,metin> {
    eğer değil uefi_mi() { ver hata("boru UEFI gerektirir"); }
    eşleş kb_bol(s) { hata(e) => { ver hata(e); } tamam(adimlar) => {
        değişken b: KsvBaglam = dizi_al(p.baglamlar,0);
        güvensiz { b.disk=*d; b.x=*x; b.h=*h; b.tr=*tr; }
        değişken ys: Dizi<tam64> = [];
        eşleş kb_hazirla(p,&değişken b,adimlar,ys) { hata(e) => {
            // Planlayıcı henüz çalışmadı. Oluşturulan uç ve adres alanlarını geri ver.
            için y: ys {
                değişken c: KsvBaglam = dizi_al(p.baglamlar,y olarak tam32);
                kxm_y64(kxs_baglam(y)+KXS_DURUM_OFS,KXS_OLDURULDU); ks_birak(y,&değişken c);
                güvensiz { memset(kxs_baglam(y) olarak *tam8,0,KXS_KAYIT_BOYU); }
            }
            ver hata(e);
        } tamam(v) => { } }
        değişken son: tam64 = dizi_al(ys,dizi_boyut(ys)-1);
        güvensiz { kxs_on_pid=ks_pid(son); }
        için y: ys {
            iken değil ks_bitti(ks_durum(y)) { eğer değil ks_adim(p,x,h,tr) { ks_hlt(); } }
            değişken c: KxsSonuc = KxsSonuc {pid:0,ebeveyn:0,bitti:yanlış,kod:0,vektor:0,hata_kodu:0,rip:0,cr2:0};
            kxs_sonuc_al(y,&değişken c); p.son_kod=c.kod;
            eğer değil c.bitti { p.son_kod=128+c.vektor; }
        }
        güvensiz { kxs_on_pid=0; } ver tamam(doğru);
    } }
}

işlev kd_yardim(ad: metin) -> sonuç<mantıksal,metin> {
    eğer bm_esit(ad,"bilgi") { ekran_cift_yaz("bilgi süreyi, boş belleği, süreçleri, diskleri, kesmeleri ve giriş durumunu gösterir."); ver tamam(doğru); }
    eğer bm_esit(ad,"kopyala") { ekran_cift_yaz("kopyala <kaynak> <hedef> dosyayı aynı veya farklı bağlama noktasına kopyalar."); ver tamam(doğru); }
    eğer bm_esit(ad,"tasi") { ekran_cift_yaz("tasi <kaynak> <hedef> dosyayı taşır veya adını değiştirir."); ver tamam(doğru); }
    eğer bm_esit(ad,"kesme") { ekran_cift_yaz("kesme sina vektör kayıt çakışmasını sınar."); ver tamam(doğru); }
    eğer bm_esit(ad,"pci") { ekran_cift_yaz("pci yapılandırma alanını ve BAR eşlemelerini gösterir."); ver tamam(doğru); }
    eğer bm_esit(ad,"ls") { ekran_cift_yaz("ls [yol] dizindeki adları gösterir."); ver tamam(doğru); }
    eğer bm_esit(ad,"cd") { ekran_cift_yaz("cd [yol] çalışma dizinini değiştirir."); ver tamam(doğru); }
    eğer bm_esit(ad,"pwd") { ekran_cift_yaz("pwd çalışma dizinini gösterir."); ver tamam(doğru); }
    eğer bm_esit(ad,"cat") { ekran_cift_yaz("cat <dosya> içeriği ekrana yazar."); ver tamam(doğru); }
    eğer bm_esit(ad,"echo") { ekran_cift_yaz("echo <metin> satırı yazar."); ver tamam(doğru); }
    eğer bm_esit(ad,"yaz") { ekran_cift_yaz("yaz <dosya> <metin> dosya içeriğini değiştirir."); ver tamam(doğru); }
    eğer bm_esit(ad,"cp") { ekran_cift_yaz("cp <kaynak> <hedef> dosyayı kopyalar."); ver tamam(doğru); }
    eğer bm_esit(ad,"mv") { ekran_cift_yaz("mv <kaynak> <hedef> dosyayı taşır."); ver tamam(doğru); }
    eğer bm_esit(ad,"sil") { ekran_cift_yaz("sil <dosya> dosyayı siler."); ver tamam(doğru); }
    eğer bm_esit(ad,"mkdir") { ekran_cift_yaz("mkdir <yol> dizin oluşturur."); ver tamam(doğru); }
    eğer bm_esit(ad,"rmdir") { ekran_cift_yaz("rmdir <yol> boş dizini kaldırır."); ver tamam(doğru); }
    eğer bm_esit(ad,"diskler") { ekran_cift_yaz("diskler aygıtları ve bölümleri listeler."); ver tamam(doğru); }
    eğer bm_esit(ad,"bagla") { ekran_cift_yaz("bagla --yazilabilir <bölüm> veri bölümünü yazmaya açar."); ver tamam(doğru); }
    eğer bm_esit(ad,"sync") { ekran_cift_yaz("sync bekleyen disk yazılarını tamamlar."); ver tamam(doğru); }
    eğer bm_esit(ad,"saat") { ekran_cift_yaz("saat tarih ve saati yazar. baslat saat canlı saati açar."); ver tamam(doğru); }
    eğer bm_esit(ad,"calistir") { ekran_cift_yaz("calistir <yol> [argüman] ELF dosyasını çalıştırır."); ver tamam(doğru); }
    eğer bm_esit(ad,"baslat") { ekran_cift_yaz("baslat <ad> [argüman] program arar. Sona & eklenirse arka planda çalışır."); ver tamam(doğru); }
    eğer bm_esit(ad,"bekle") { ekran_cift_yaz("bekle <pid> süreç sonlanınca çıkış kodunu toplar."); ver tamam(doğru); }
    eğer bm_esit(ad,"ps") { ekran_cift_yaz("ps süreç durumlarını listeler."); ver tamam(doğru); }
    eğer bm_esit(ad,"duzen") { ekran_cift_yaz("duzen tr|us düzeni seçer. Ctrl+Boşluk düzeni değiştirir."); ver tamam(doğru); }
    eğer bm_esit(ad,"girdisay") { ekran_cift_yaz("girdisay 1..20 PS/2 baytlarını sayar. Bu sürede yazılan giriş tüketilir."); ver tamam(doğru); }
    eğer bm_esit(ad,"sonlandir") { ekran_cift_yaz("sonlandir <pid> süreci durdurur."); ver tamam(doğru); }
    eğer bm_esit(ad,"sonuc") { ekran_cift_yaz("sonuc en son toplanan çıkış kodunu gösterir."); ver tamam(doğru); }
    eğer bm_esit(ad,"temizle") { ekran_cift_yaz("temizle konsol ekranını siler."); ver tamam(doğru); }
    eğer bm_esit(ad,"yardim") { ekran_cift_yaz("yardim <komut> komutun kullanımını gösterir."); ver tamam(doğru); }
    eğer bm_esit(ad,"kapat") { ekran_cift_yaz("kapat diskleri eşitler ve sistemi kapatır."); ver tamam(doğru); }
    eğer bm_esit(ad,"yenidenbaslat") { ekran_cift_yaz("yenidenbaslat diskleri eşitler ve sistemi yeniden başlatır."); ver tamam(doğru); }
    eğer bm_esit(ad,"donanim") { ekran_cift_yaz("donanim aygıtları listeler. donanim kaydet <yol> raporu yazar."); ver tamam(doğru); }
    eğer bm_esit(ad,"log") { ekran_cift_yaz("log [sayfa] günlük halkasını gösterir. log kaydet <yol> dosyaya yazar."); ver tamam(doğru); }
    eğer bm_esit(ad,"hassasiyet") { ekran_cift_yaz("hassasiyet <1..4> fare hızını ayarlar."); ver tamam(doğru); }
    eğer bm_esit(ad,"goster") { ekran_cift_yaz("baslat goster <BMP> resmi gösterir. Oklarla kaydırın, Q ile çıkın."); ver tamam(doğru); }
    eğer bm_esit(ad,"bul") { ekran_cift_yaz("baslat bul [-i] <metin> [dosya...] eşleşen satırları numaralandırır."); ver tamam(doğru); }
    eğer bm_esit(ad,"hesapla") { ekran_cift_yaz("baslat hesapla <ifade> parantez ve işlem önceliğiyle tam sayı hesaplar."); ver tamam(doğru); }
    eğer bm_esit(ad,"duzenle") { ekran_cift_yaz("duzenle: Ctrl+F/B ara, Ctrl+I harf duyarlılığı, Ctrl+H değiştir, Ctrl+G satır, Ctrl+Z/Y geri al/yinele, Ctrl+S kaydet, Ctrl+Q çık."); ver tamam(doğru); }
    eğer bm_esit(ad,"dosyalar") { ekran_cift_yaz("dosyalar: F5 kopyala, F6 taşı, F7 dizin oluştur, Delete sil, Q çık."); ver tamam(doğru); }
    ver hata("yardim konusu bulunamadi");
}
işlev komut(d: &değişken KabukDisk,p: &değişken KsKabukSureci,satir: metin,x: &değişken XhciDurum,xb: tam64,indeks: tam32,
            h: &değişken HidKlavye,tr: &değişken KlavyeDurumu) -> sonuç<mantıksal,metin> {
    eğer kb_hat_mi(satir) { ver kb_calistir(d,p,satir,x,h,tr); }
    değişken pos: tam32 = kd_bosluk(satir);
    değişken cmd: metin = kd_bas(satir,pos);
    değişken arg: metin = kd_kalan(satir,pos);
    eğer bm_esit(cmd,"hassasiyet") {
        değişken seviye: tam64 = kd_sayi_arg(arg);
        eğer seviye < 1 veya seviye > 4 { ver hata("hassasiyet 1..4"); }
        güvensiz { ksv_hassasiyet=seviye olarak tam32; } ver tamam(doğru);
    }
    eğer bm_esit(cmd,"cozumle") { ver ag_cozumle(arg); }
    eğer bm_esit(cmd,"ag") { ver ag_komut(arg); }
    eğer bm_esit(cmd,"bilgi") { ver kd_bilgi(d,indeks,tr.us); }
    eğer bm_esit(cmd,"log") { ver kd_log(d,arg); }
    eğer bm_esit(cmd,"donanim") {
        eğer metin_uzunluk(arg) == 0 { ver kd_donanim(d,x,indeks,bh_fare() >= 0,""); }
        değişken bos: tam32 = kd_bosluk(arg);
        eğer değil bm_esit(kd_bas(arg,bos),"kaydet") { ver hata("donanim kaydet <yol>"); }
        eşleş kd_mutlak(d.cwd,kd_kalan(arg,bos)) { hata(e) => { ver hata(e); } tamam(y) => { ver kd_donanim(d,x,indeks,bh_fare() >= 0,y); } }
    }
    eğer bm_esit(cmd,"calistir") veya bm_esit(cmd,"baslat") {
        değişken arama: mantıksal = bm_esit(cmd,"baslat");
        değişken n: tam32 = metin_uzunluk(arg);
        değişken arka: mantıksal = arama ve n >= 2 ve metin_bayt(arg,n-1) == 38 ve metin_bayt(arg,n-2) == 32;
        ver ks_komut(d,p,arg,x,xb,indeks,h,tr,arka,arama);
    }
    eğer bm_esit(cmd,"temizle") { kd_temizle(); ver tamam(doğru); }
    eğer bm_esit(cmd,"sonuc") { ekran_cift_yaz(tam_metin(p.son_kod)); ver tamam(doğru); }
    eğer bm_esit(cmd,"yardim") {
        eğer metin_uzunluk(arg) > 0 { ver kd_yardim(arg); }
        ekran_cift_yaz("ls cd pwd cat echo yaz cp mv sil mkdir rmdir diskler bagla sync saat");
        ekran_cift_yaz("calistir baslat bekle ps sonlandir sonuc temizle yardim kapat yenidenbaslat");
        ekran_cift_yaz("donanim log hassasiyet goster bul hesapla duzenle dosyalar");
        ekran_cift_yaz("bilgi duzen kopyala tasi girdisay kesme pci");
        ver tamam(doğru);
    }
    eğer bm_esit(cmd,"ps") {
        değişken y: tam64 = 0;
        iken y < KXS_YUVA_ADEDI {
            eğer ks_durum(y) != KXS_BOS {
                değişken m: metin = metin_birlestir(tam_metin(ks_pid(y))," ");
                m=metin_birlestir(m,ks_durum_adi(ks_durum(y)));
                m=metin_birlestir(metin_birlestir(m," "),dizi_al(p.adlar,y olarak tam32));
                ekran_cift_yaz(metin_birlestir(metin_birlestir(m," "),tam_metin(kxm_o64(kxs_baglam(y)+KXS_DILIM_OFS))));
            }
            y=y+1;
        }
        ver tamam(doğru);
    }
    eğer bm_esit(cmd,"bekle") veya bm_esit(cmd,"sonlandir") {
        değişken y: tam64 = ks_pid_arg(arg);
        eğer y < 0 { ver hata("pid bulunamadi"); }
        eğer kxm_o64(kxs_baglam(y)+KXS_EBEVEYN_OFS) != 0 { ver hata("kabuk cocugu degil"); }
        eğer bm_esit(cmd,"bekle") { p.beklenen=y; }
        değilse eğer değil ks_bitti(ks_durum(y)) {
            değişken b: KsvBaglam = dizi_al(p.baglamlar,y olarak tam32);
            eğer ks_sonlandir(y,&değişken b) < 0 { ver hata("surec dosya esitleme hatasi"); }
            dizi_yaz(p.baglamlar,y olarak tam32,b);
        }
        ver tamam(doğru);
    }
    eğer bm_esit(cmd,"girdisay") {
        değişken saniye: tam64 = kd_sayi_arg(arg);
        eğer saniye < 1 veya saniye > 20 veya indeks >= 0 veya değil ps2_kesme_etkin() { ver hata("girdisay 1..20 PS2 IRQ gerektirir"); }
        // Kesme üreticisi çalışırken tüketiciyi belirtilen süre durdur.
        değişken ilk: tam64 = ps2_kesme_kayip(yanlış);
        bm_yaz("PS2_SAY BASLA");
        değişken son: tam64 = kem_tik_oku()+saniye*100;
        iken kem_tik_oku() < son { ks_hlt(); }
        değişken bas: tam64 = 0; değişken birak: tam64 = 0;
        değişken b: tam32 = ps2_kesme_klavye_oku();
        iken b >= 0 {
            // Komutu başlatan Enter bırakması ölçüm girdisine dahil değildir.
            eğer b == 156 { klavye_ham_bayt(tr,b); } değilse { eğer b < 128 { bas=bas+1; } değilse { birak=birak+1; } }
            b=ps2_kesme_klavye_oku();
        }
        kap_dok("PS2_SAY",bas,birak,ps2_kesme_kayip(yanlış)-ilk);
        ver tamam(doğru);
    }
    eğer bm_esit(cmd,"duzen") {
        eğer değil bm_esit(arg,"us") ve değil bm_esit(arg,"tr") { ver hata("duzen tr|us"); }
        tr.us=bm_esit(arg,"us"); ver tamam(doğru);
    }
    eğer bm_esit(cmd,"echo") { ekran_cift_yaz(arg); ver tamam(doğru); }
    eğer bm_esit(cmd,"kesme") ve bm_esit(arg,"sina") { ver kd_kesme_sina(); }
    eğer bm_esit(cmd,"pci") { kd_pci_tani(); ver tamam(doğru); }
    eğer bm_esit(cmd,"diskler") { kd_diskler(d); ver tamam(doğru); }
    eğer bm_esit(cmd,"saat") {
        eşleş rtc_oku() { hata(e) => { ver hata(e); } tamam(a) => {
            ekran_cift_yaz(rtc_metin(a)); ver tamam(doğru);
        } }
    }
    eğer bm_esit(cmd,"pwd") { ekran_cift_yaz(d.cwd); ver tamam(doğru); }
    eğer bm_esit(cmd,"sync") { ver kd_sync(d); }
    eğer bm_esit(cmd,"bagla") {
        değişken n: tam32 = kd_bosluk(arg);
        eğer değil bm_esit(kd_bas(arg,n),"--yazilabilir") veya n+1 >= metin_uzunluk(arg) { ver hata("bagla --yazilabilir <ad>"); }
        ver kd_yazilabilir(d,kd_kalan(arg,n));
    }
    eğer bm_esit(cmd,"kopyala") { cmd="cp"; }
    eğer bm_esit(cmd,"tasi") { cmd="mv"; }
    değişken iki: mantıksal = bm_esit(cmd,"yaz") veya bm_esit(cmd,"mv") veya bm_esit(cmd,"cp");
    değişken son: metin = "";
    eğer iki {
        değişken n: tam32 = kd_bosluk(arg);
        eğer n == 0 veya n >= metin_uzunluk(arg) { ver hata("iki arguman gerekli"); }
        son=kd_kalan(arg,n);
        arg=kd_bas(arg,n);
    } değilse eğer değil bm_esit(cmd,"ls") ve değil bm_esit(cmd,"cd") ve değil bm_esit(cmd,"cat") ve değil bm_esit(cmd,"sil") ve değil bm_esit(cmd,"mkdir") ve değil bm_esit(cmd,"rmdir") {
        eğer değil uefi_mi() veya metin_uzunluk(cmd) == 0 { ver hata("bilinmeyen komut"); }
        ver ks_komut(d,p,satir,x,xb,indeks,h,tr,yanlış,doğru);
    }
    eğer metin_uzunluk(arg) == 0 ve değil bm_esit(cmd,"ls") ve değil bm_esit(cmd,"cd") { ver hata("yol gerekli"); }
    eşleş kd_mutlak(d.cwd,arg) { hata(e) => { ver hata(e); } tamam(y) => { ver kd_komut_yol(d,cmd,y,son); } }
}
// ISR yalnız bayt üretir; paket, metin ve imleç tüketici bağlamındadır.
işlev kabuk_hata(m: metin) {
    eğer metin_uzunluk(m) >= 11 ve bm_esit(metin_kes(m,0,11),"KABUK HATA ") { ekran_cift_yaz(m); ver; }
    eğer bm_esit(m,"usb bellek cikarildi") { ekran_cift_yaz("KABUK HATA usb bellek cikarildi"); }
    değilse { ekran_cift_yaz(metin_birlestir("HATA ",m)); }
}
işlev kabuk_fare(ke: &değişken KabukEkran, fd: &değişken FareDurumu, im: &değişken EkranFare) {
 değişken b: tam32 = ps2_kesme_fare_oku();
 iken b >= 0 {
  eşleş fare_bayt(fd,b) { hiç => { } değer(o) => {
   değişken dugme: tam32 = 0;eğer o.sol { dugme=dugme|1; }eğer o.sag { dugme=dugme|2; }eğer o.orta { dugme=dugme|4; }
   değişken mesaj: metin = metin_birlestir("FARE dx=",tam_metin(o.dx olarak tam64));
   mesaj=metin_birlestir(mesaj," dy=");mesaj=metin_birlestir(mesaj,tam_metin(o.dy olarak tam64));
   mesaj=metin_birlestir(mesaj," dugme=");bm_yaz(metin_birlestir(mesaj,tam_metin(dugme olarak tam64)));
   eğer ke.var { ekran_fare_hareket(ke.e,im,ksv_hareket(o.dx),ksv_hareket(o.dy)); }
  } }
  b=ps2_kesme_fare_oku();
 }
}
işlev kt_satir(o: TusHamOlay) -> TusOlayi {
    değişken k: tam32 = o.kod; değişken oz: tam32 = 0;
    eğer k == 28 veya k == 284 { oz=1; }
    eğer k == 14 { oz=2; } eğer k == 15 { oz=3; } eğer k == 1 { oz=4; }
    eğer k == 328 { oz=5; } eğer k == 336 { oz=6; } eğer k == 331 { oz=7; }
    eğer k == 333 { oz=8; } eğer k == 339 { oz=9; }
    eğer oz != 0 { ver TusOlayi::Ozel(oz,o.bas != 0); }
    eğer o.bas != 0 ve o.unicode != 0 { ver TusOlayi::Karakter(o.unicode); }
    ver TusOlayi::Yok;
}
işlev kabuk(d: &değişken KabukDisk, x: &değişken XhciDurum, xb: tam64, indeks: tam32, ke: &değişken KabukEkran) -> sonuç<mantıksal,metin> {
    değişken h: HidKlavye = hid_klavye_yeni(); değişken tr: KlavyeDurumu = klavye_yeni(); değişken satir: SatirDuzenleyici = satir_yeni(); satir.sinir=32;
    güvensiz { değişken gp: *KabukEkran = ke olarak *KabukEkran; ksv_ekran_adr=gp olarak tam64; }
    değişken fd: FareDurumu = fare_yeni(ps2_teker_var());değişken im: EkranFare = ekran_fare_yeni();
    değişken bos_program: KsProgram = KsProgram {onbellek:0,sicak:yanlış,var:yanlış,surum:0,yol:"",cwd:"",ad:"",aygit:0,parcalar:[],
        plan:Elf64 {tur:0,makine:0,giris:0,yuklemeler:[]}};
    değişken p: KsKabukSureci = KsKabukSureci {son_program:bos_program,baglamlar:[],adlar:[],sonraki:0,son_kod:0,beklenen:-1};
    // Kabuk ve ön plan süreci fiziksel klavyeyi sırayla okur.
    değişken hid_tampon: Dizi<TusHamOlay> = hid_ham_tampon();
    değişken y: tam64 = 0;
    iken y < KXS_YUVA_ADEDI {
        güvensiz {
            dizi_ekle(p.baglamlar,KsvBaglam {disk:*d,fds:ksv_fd_tablo(),kabuk_cwd:d.cwd,degisti:yanlış,
                x:*x,xb:xb,klavye_indeksi:indeks,h:h,tr:tr,hid_tampon:hid_tampon,olaylar:[],olay_konum:0,ilk_tus:doğru,dilim_calisti:yanlış,fare_durum:fare_yeni(ps2_teker_var()),olay_maskesi:0,son_tik:-1,bekleme_kurulu:yanlış});
        }
        dizi_ekle(p.adlar,""); y=y+1;
    }

    değişken kayip1: tam64 = 0;değişken kayip12: tam64 = 0;değişken irqhata: tam64 = 0;
    güvensiz { eğer kap_tsc_bas != 0 { bm_yaz(metin_birlestir("ACILIS_CEVRIM_MS ",tam_metin(kap_tsc_ms))); } }
    kap_damga("kabuk");
        ekran_cift_yaz("KEMGU-OS kabuk v0");
        eğer d.kok >= 0 {
            değişken k: KabukBag = dizi_al(d.baglar,d.kok);
            değişken kok_aygit: BlokDonanim = dizi_al(d.aygitlar,k.indeks);
            değişken tur: metin = kd_tur(kok_aygit);
            eğer bm_esit(tur,"nvme") { ekran_cift_yaz("DISK NVMe"); }
            değilse eğer bm_esit(tur,"sata") { ekran_cift_yaz("DISK AHCI"); }
            değilse { ekran_cift_yaz("DISK USB"); }
        }
    ekran_cift_yaz("KABUK_HAZIR");ke_ciz(ke);ke_girdi(ke,satir);
    eşleş bh_hub_dinle(x,xb) { hata(e) => { ver hata(e); } tamam(v) => { } }
    iken doğru {
        ag_al();
        eğer bh_hub_olayi() {
            eşleş kd_hub_olayi(d,x,xb) { hata(e) => { bm_yaz(metin_birlestir("KABUK HATA ",e)); } tamam(v) => { } }
        }
        eğer indeks != kl_indeks() {
            indeks=kl_indeks(); h=hid_klavye_yeni(); güvensiz { kt_kod=0; }
        }
        eğer indeks >= 0 {
            eğer bh_gonder(x,xb,indeks,0) < 0 { ver hata("USB klavye aktarimi"); }
            bh_olaylar();
            iken bh_durum(0) == 1 ve değil kt_hazir() ve değil ps2_kesme_fare_var() ve değil bh_hub_olayi() {
                değişken kos: mantıksal = yanlış;
                eğer ks_etkin_mi() { kos=ks_adim(&değişken p,x,&değişken h,&değişken tr); }
                eğer değil kos { güvensiz { eğer kap_lapic != 0 { ks_hlt(); } değilse { kem_bekle_us(50); } } }
                ag_al(); bh_olaylar();
            }
        } değilse eğer ps2_kesme_etkin() {
            bh_olaylar();
            iken ks_etkin_mi() ve değil kt_hazir() ve değil ps2_tus_var() ve değil ps2_kesme_fare_var() ve değil bh_hub_olayi() {
                eğer değil ks_adim(&değişken p,x,&değişken h,&değişken tr) { ks_hlt(); }
            }
            eğer değil ks_etkin_mi() {
                iken değil kt_hazir() ve değil ps2_tus_var() ve değil ps2_kesme_fare_var() ve değil bh_hub_olayi() { ks_hlt(); ag_al(); bh_olaylar(); }
            }
        }
        kabuk_fare(ke,&değişken fd,&değişken im);
        değişken k1: tam64 = ps2_kesme_kayip(yanlış);değişken k12: tam64 = ps2_kesme_kayip(doğru);değişken kh: tam64 = ps2_kesme_hata_oku();
        eğer k1 != kayip1 veya k12 != kayip12 veya kh != irqhata {
            kap_dok("PS2_KAYIP",k1,k12,kh);kayip1=k1;kayip12=k12;irqhata=kh;
        }
        // Eski yoklamalı kabukta kullanıcı gelene kadar heap ayırma.
        değişken yoklanan: tam32 = -1;
        eğer indeks < 0 ve guc_ps2_izin() ve değil ps2_kesme_etkin() {
            iken yoklanan < 0 { yoklanan=ps2_bekle(); }
        }
        değişken xs: Dizi<TusOlayi> = [];
        değişken adet: tam32 = 0;
        değişken eski_led: tam32 = klavye_led(&değişken tr,indeks >= 0);
        eğer indeks < 0 {
            değişken b: tam32 = -1;
            eğer ps2_kesme_etkin() { b=ps2_kesme_klavye_oku(); } değilse { b=yoklanan; }
            eğer b >= 0 { eşleş klavye_ham_bayt(&değişken tr,b) { hiç => { } değer(o) => { dizi_yaz(hid_tampon,0,o); adet=1; } } }
        } değilse {
            eğer bh_durum(0) == 2 {
                adet=ksv_hid_oku(&değişken h,&değişken tr,hid_tampon);
                eğer adet < 0 { ver hata("hid klavye rapor boyu"); }
            }
        }
        kl_led_degisti(x,xb,indeks,&değişken tr,eski_led);
        değişken hi: tam32 = 0;
        iken hi < adet {
            değişken o: TusHamOlay = dizi_al(hid_tampon,hi);
            eğer kt_izle(o) { dizi_ekle(xs,kt_satir(o)); }
            hi=hi+1;
        }
        eğer kt_hazir() { dizi_ekle(xs,kt_satir(kt_yinele())); }
        ekran_fare_sil(ke.e,&değişken im);
        için o: xs {
            eğer kd_tab_mi(o) {
                eşleş kd_tab(d,&değişken satir) { hata(e) => { ekran_cift_yaz(e); } tamam(v) => { } }
                ke_ciz(ke); ke_girdi(ke,satir);
            } değilse { eşleş satir_olay(&değişken satir,o) { hiç => { ke_girdi(ke,satir); } değer(s) => {
            ekran_ayna_yaz(metin_birlestir("> ", s));
            eğer bm_esit(s,"kapat") veya bm_esit(s,"yenidenbaslat") {
                eşleş kd_sync(d) {
                    hata(e) => { kabuk_hata(e); }
                    tamam(v) => {
                        eğer bm_esit(s,"yenidenbaslat") { guc_yeniden_asama(0); }
                        ekran_cift_yaz("Sistem kapatılıyor.");ke_ciz(ke);guc_kapat();
                    }
                }
            } değilse { eşleş komut(d,&değişken p,s,x,xb,indeks,&değişken h,&değişken tr) { hata(e) => { kabuk_hata(e); } tamam(v) => { } } }
            eğer p.beklenen >= 0 {
                ks_bekle(&değişken p,p.beklenen,x,&değişken h,&değişken tr);
                p.beklenen=-1; güvensiz { kxs_on_pid=0; }
                ksv_kabugu_ciz();
            }
            ekran_cift_yaz("KABUK_HAZIR");ke_ciz(ke);ke_girdi(ke,satir);
        } } } }
        ekran_fare_ciz(ke.e,&değişken im);
    } ver tamam(doğru);
}
küresel değişken kh_bdf: tam32 = 0;
küresel değişken kh_iman: tam64 = 0;
küresel değişken kh_durum: tam64 = 0;
// ISR yalnız kaynağı ve LAPIC'i onaylar. HID/BOT halkası tek tüketicide kalır.
gerçekzamanlı çıplak işlev kdl_xhci_irq() {
    eğer değil kesme_geldi(65,4) { ver; }
    güvensiz { satıriçi_asm {
        mimari:x86_64 çevrim:2048
        şablon:r#"movl $$8, ($0)
movl $$3, ($1)
movl $$0, 176($2)"#
        girdi("r",kh_durum) girdi("r",kh_iman) girdi("r",kap_lapic) bozulan("~{memory}")
    } }
    bh_bildirim=bh_bildirim+1;
}
işlev kh_kur(bar: tam64,x: &değişken XhciDurum) {
    güvensiz {
        eğer bar == 0 veya kap_lapic == 0 veya (kem_pci_oku32(kh_bdf,4)&1048576) == 0 { ver; }
        değişken o: tam32 = (kem_pci_oku32(kh_bdf,52)&252) olarak tam32;
        değişken n: tam32 = 0;
        iken o >= 64 ve o <= 252 ve n < 48 {
            değişken v: tam64 = kem_pci_oku32(kh_bdf,o);
            eğer (v&255) == 17 ve o <= 244 {
                değişken t: tam64 = kem_pci_oku32(kh_bdf,o+4);
                değişken bir: tam32 = (t&7) olarak tam32; eğer bir > 5 { ver; }
                değişken b: tam64 = kem_pci_oku32(kh_bdf,16+bir*4);
                eğer (b&1) != 0 { ver; }
                değişken taban: tam64 = b&4294967280;
                eğer (b&6) == 4 {
                    eğer bir == 5 { ver; }
                    taban=taban|(kem_pci_oku32(kh_bdf,20+bir*4)<<32);
                }
                değişken tablo: tam64 = taban+(t&4294967288);
                eğer taban != bar veya tablo < taban veya tablo > 9223372036854775791 { ver; }
                eğer değil kesme_kaydet(65,4) { bm_yaz("KABUK HATA xHCI kesme vektoru dolu"); ver; }
                kem_pci_yaz32(kh_bdf,o,v|3221225472);
                kem_mmio_yaz32(tablo+12,1);
                değişken hedef: tam64 = (kem_mmio_oku32(kap_lapic+32)>>24)&255;
                kem_mmio_yaz32(tablo,4276092928|(hedef<<12)); kem_mmio_yaz32(tablo+4,0);
                kem_mmio_yaz32(tablo+8,65);
                kh_iman=bar+x.c.rtsoff+32; kh_durum=bar+(x.c.caplength olarak tam64)+4;
                kem_mmio_yaz32(tablo+12,0); kem_pci_yaz32(kh_bdf,o,(v|2147483648)&3221225471);
                bh_kesmeli=1; kem_mmio_yaz32(kh_durum,8); kem_mmio_yaz32(kh_iman,3);
                kem_mmio_yaz32(kh_durum-4,kem_mmio_oku32(kh_durum-4)|4);
                ver;
            }
            o=((v>>8)&252) olarak tam32; n=n+1;
        }
    }
}
işlev hazir(xb: tam64, x: &değişken XhciDurum, ke: &değişken KabukEkran) -> sonuç<mantıksal,metin> {
    eğer xb != 0 { eşleş bd_xsur(xb,x) { hata(e) => { ver hata(e); } tamam(v) => { } }
        eşleş bh_hublari_kur(x,xb) { hata(e) => { ver hata(e); } tamam(v) => { } }
    }
    eşleş kl_hidleri_sec(x,xb) { hata(e) => { ver hata(e); } tamam(v) => { } }
    değişken indeks: tam32 = kl_indeks(); değişken fare_indeksi: tam32 = bh_fare();
    eğer indeks < 0 {
        eğer değil guc_ps2_izin() { ver hata("8042 yok; USB klavye gerekli"); }
        eğer değil ps2_kesme_etkin() { eğer ps2_kur() < 0 { ver hata("PS2 baslatilamadi"); } }
    }
    kap_damga("usb");
    eşleş kd_yeni() { hata(e) => { ver hata(e); } tamam(v) => { değişken d: KabukDisk = v;
        eşleş bd_bul(x,xb,uefi_mi()) { hata(e) => { ver hata(e); } tamam(xs) => { d.aygitlar=xs; } }
        eşleş kd_bagla(&değişken d) { hata(e) => { ver hata(e); } tamam(v) => { } }
        eğer uefi_mi() { eşleş kd_ramdisk_kur(&değişken d) { hata(e) => { bm_yaz(metin_birlestir("KABUK HATA ramdisk ",e)); } tamam(v) => { } } }
        eğer uefi_mi() { eşleş kd_gecici_kur(&değişken d) { hata(e) => { bm_yaz(metin_birlestir("KABUK HATA ",e)); } tamam(v) => { } } }
        eşleş kd_kok_durum(&değişken d) { hata(e) => { ver hata(e); } tamam(v) => { } }
        eğer uefi_mi() { eşleş ag_kur() { hata(e) => { bm_yaz(metin_birlestir("KABUK HATA ag ",e)); } tamam(v) => { } } eğer değil ag_l3_kur() { bm_yaz("KABUK HATA ag L3 belleği veya zaman kaynağı"); } }
        eğer uefi_mi() ve d.kok >= 0 {
            değişken k: KabukBag = dizi_al(d.baglar,d.kok);
            eğer k.kayit.kok ve değil k.kayit.bolum.esp {
                eşleş kd_donanim(&değişken d,x,indeks,fare_indeksi >= 0,"/donanim.txt") {
                    hata(e) => { bm_yaz(metin_birlestir("KABUK HATA donanim.txt ",e)); } tamam(v) => { bm_yaz("DONANIM_KAYDI /donanim.txt"); }
                }
            }
        }
        kap_damga("diskler");
        bh_kur(x,xb,fare_indeksi); kh_kur(xb,x);
        ver kabuk(&değişken d,x,xb,indeks,ke);
    } }
}
işlev ke_kur() -> sonuç<KabukEkran, metin> {
    eşleş psf_coz(font_tr16()) { hata(m) => { ver hata(metin_birlestir("psf ", m)); } tamam(f) => {
        değişken e: Ekran = Ekran { fb:0, mmio:0, adim:0, gen:640, yuk:480, kimlik:0 };
        değişken var: mantıksal = yanlış;
        eğer uefi_mi() {
            eşleş uefi_bilgi() { hata(m) => { ver hata(m); } tamam(b) => {
                eşleş ekran_gop_ac(b,KE_ARKA) { hata(m) => { ver hata(m); } tamam(v) => { e=v; var=doğru; } }
            } }
        } değilse {
            eşleş ekran_bga_ac(640,480,KE_ARKA) { hata(m) => { } tamam(v) => { e=v; var=doğru; } }
        }
        eşleş konsol_yeni((e.gen-16)/f.genislik,(e.yuk-16)/f.yukseklik,KE_ON,KE_ARKA olarak tam32) {
            hata(m) => { ver hata(metin_birlestir("konsol ",m)); }
            tamam(k) => {
                değişken ke: KabukEkran = KabukEkran { var:var, e:e, f:f, k:k };
                eğer var { ekran_panik_kur(e,f); ekran_ayna_ac(); }
                ver tamam(ke);
            }
        }
    } }
}
işlev main() -> tam32 {
    güvensiz { eğer uefi_mi() { kap_tsc_bas=bm_tsc_oku(); } kgun_kur(malloc(KGUN_BOY) olarak tam64); }
    eğer uefi_mi() {
        eşleş uefi_bilgi() { hata(e) => { bm_yaz(e); kem_qemu_cik(1); } tamam(b) => {
            uefi_dok(b); bm_yaz("ACILIS_TSC devir 0");
            eşleş uefi_bellek_kur_surec(b) { hata(e) => { bm_yaz(e); kem_qemu_cik(1); } tamam(v) => { } }
   kap_damga("bellek");
   eşleş uefi_acpi_dok(b) { hata(e) => { bm_yaz(e); kem_qemu_cik(1); } tamam(v) => { } }
   kap_damga("acpi");
   eğer guc_ps2_izin() {
   değişken fare_kimlik: tam32 = ps2_kesme_kur();
   eğer fare_kimlik < 0 { bm_yaz(metin_birlestir("KABUK HATA ps2 baslatma ",tam_metin(fare_kimlik olarak tam64))); }
   değilse { kap_ps2_ac();bm_yaz("GIRDI PS2 IRQ1 IRQ12");eğer fare_kimlik == 3 { bm_yaz("PS2_FARE 3 4"); } değilse { bm_yaz("PS2_FARE 0 3"); } }
   } değilse { bm_yaz("GIRDI USB; PS2 FADT YOK (8042 yok)"); }
        } }
    }
    eşleş ke_kur() { hata(e) => { bm_yaz(e); kem_qemu_cik(1); } tamam(v) => { değişken ke: KabukEkran = v;
    değişken bar: tam64 = 0;
    eşleş bm_pci_bul(12,3,48) { hata(e) => { eğer uefi_mi() { bm_yaz("KABUK HATA xhci denetleyici yok"); } } tamam(bdf) => {
        güvensiz { kh_bdf=bdf; }
        bar=(kem_pci_oku32(bdf,16)&4294967280)|(kem_pci_oku32(bdf,20)<<32);
        kem_pci_yaz32(bdf,4,kem_pci_oku32(bdf,4)|6);
    } }
    kap_damga("pci");
    eşleş xhci_yeni(bm_dma_al(),16384) { hata(e) => { ekran_cift_yaz(e); kem_qemu_cik(1); } tamam(v) => {
        değişken x: XhciDurum = v;
        eşleş hazir(bar,&değişken x,&değişken ke) { hata(e) => { ekran_cift_yaz(metin_birlestir("KABUK HATA ",e)); kem_qemu_cik(1); } tamam(v) => { } }
    } }
    } } ver 0;
}
