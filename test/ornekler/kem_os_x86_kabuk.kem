        }
        değişken mac: tam64 = 0; değişken j: tam32 = 0;
        iken j<6 { mac=mac|((kem_fiz_oku8(cihaz+(j olarak tam64)) olarak tam64)<<(j*8)); j=j+1; }
        eğer mac==0 veya (mac&1)!=0 { kem_fiz_yaz8(c+20,139); ver hata("virtio gecersiz MAC"); }
        ag_dma=dma; ag_bar=c; ag_vcihaz=cihaz; ag_mac=mac; ag_model=4; ag_vektor=-1;
        ag_vrx_gorulen=0; ag_vtx_uretilen=0;
        kem_dma_bariyeri(); kem_fiz_yaz8(c+20,15); vblk_y16(ag_vrx_bildir,0 olarak dtam16);
        ver tamam(doğru);
    }
}
çıplak işlev ag_vtx(adres: tam64,n: tam32) -> tam32 {
    değişken a: tam64 = ag_dma+4096;
    değişken used: tam32 = vblk_o16(a+162) olarak tam32;
    eğer ((ag_vtx_uretilen-used)&65535)>=8 { ver -11; }
    değişken slot: tam64 = (ag_vtx_uretilen&7) olarak tam64;
    değişken buf: tam64 = ag_dma+24576+2048*slot;
    memcpy((buf+12) olarak *tam8,adres olarak *tam8,n olarak tam64);
    kem_mmio_yaz64(a+16*slot,buf); kem_mmio_yaz32(a+16*slot+8,(n+12) olarak tam64);
    vblk_y16(a+132+2*slot,(slot olarak tam32) olarak dtam16);
    ag_vtx_uretilen=(ag_vtx_uretilen+1)&65535;
    kem_dma_bariyeri(); vblk_y16(a+130,ag_vtx_uretilen olarak dtam16); kem_dma_bariyeri(); vblk_y16(ag_vtx_bildir,1 olarak dtam16);
