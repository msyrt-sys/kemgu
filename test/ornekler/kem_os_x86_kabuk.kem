            eşleş uefi_tablo_bul(b,"APIC") { hata(e) => { ver -1; } tamam(t) => {
                eğer dizi_boyut(t)<44 veya değil imza_esit(t,10,"BOCHS ") { ver -1; }
            } }
        } }
        değişken pin: tam32 = (kem_pci_oku16(bdf,60)>>8)&255;
        eğer pin < 1 veya pin > 4 { ver -1; }
        değişken gsi: tam32 = 20+((bdf/8+pin-1)%4);
        eğer ((kap_io_oku(kap_io1,1)>>16)&255) < (gsi olarak tam64) { ver -1; }
        değişken reg: tam32 = 16+2*gsi;
        değişken alt: tam64 = kap_io_oku(kap_io1,reg); değişken ust: tam64 = kap_io_oku(kap_io1,reg+1);
        eğer (alt&65536) == 0 { ver -1; }
        değişken v: tam32 = kesme_ayir();
        eğer v < 0 { ver -1; }
        eğer değil kesme_kaydet(v,7) { kesme_birak(v); ver -1; }
        değişken k: tam64 = kesme_tablo+(v olarak tam64)*32;
        kem_mmio_yaz64(k+16,ag_bar+192);
        kap_io_yaz(kap_io1,reg+1,kem_mmio_oku32(kap_lapic+32)&4278190080);
        kap_io_yaz(kap_io1,reg,(v olarak tam64)|40960);
        kem_pci_yaz16(bdf,4,kem_pci_oku16(bdf,4)&64511);
        kem_mmio_yaz32(ag_bar+208,197);
        kem_mmio_yaz32(ag_bar+200,4);
        değişken i: tam32 = 0;
        iken i<100 ve kem_mmio_oku64(k+8)==0 { kem_bekle_us(100); i=i+1; }
        eğer kem_mmio_oku64(k+8)>0 { ver v; }
        kem_mmio_yaz32(ag_bar+216,4294967295);
