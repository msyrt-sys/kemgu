// Sozdizim teshisi: dogrudan indeks-yazma alan[i] = v.

işlev main() -> tam32 {
    değişken alan = [100, 200, 300];
    değişken i: tam32 = 1;
    değişken yazilan: tam32 = 9001;

    alan[i] = yazilan;
    değişken okunan: tam32 = alan[i];

    eğer okunan == yazilan {
        yazdir_metin("DIAG syntax_indeks EVET / yaz=9001 / oku=9001");
        ver 0;
    }

    yazdir_metin("DIAG syntax_indeks HAYIR / yaz=9001 / oku:");
    yazdir_tam(okunan);
    ver 1;
}
