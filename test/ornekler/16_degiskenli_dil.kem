// ============================================================================
// 16_degiskenli_dil.kem — DEĞİŞKENLİ mini dil: atama + STRING-ANAHTARLI sembol
// tablosu. Self-hosting'in ad çözümü çekirdeği.
//
// Dil:  ( DEĞİŞKEN '=' ifade ';' )*  ifade
//   atamalar bir sembol tablosuna yazılır; son ifade değişken aramasıyla hesaplanır.
//
// Token tablosu ve sembol tablosu İKİ `yapı` olarak paketlenir (Tokenler +
// Semboller), &referansla aktarılır — gerçek bir derleyicinin durum-paketi
// deseni. HER İKİSİ DE `ad` alanı taşır (Tokenler.ad = token adı, Semboller.ad =
// sembol adı): D-029'da düzeltilen alan-adı-çakışması codegen bug'ının canlı
// kanıtı — `t.ad` artık doğru yapıya (Tokenler) çözülüyor (eski codegen Semboller'e
// çözüp t.kind'i bozuyordu).
//
// Token türleri: 0=SAYI 1=+ 2=- 3=* 4=/ 5=( 6=) 7=DEĞİŞKEN 8== 9=;
//
// Çalıştırılan:  "x=6;y=7;x*y"  →  x=6, y=7,  x*y = 42
// ============================================================================

yapı Tokenler {
    kind: Dizi<tam32>;
    deger: Dizi<tam32>;
    ad: Dizi<metin>;        // DEĞİŞKEN token'ının adı (diğerlerinde "")
    imlec: Dizi<tam32>;     // tek elemanlı: konum
}

yapı Semboller {
    ad: Dizi<metin>;        // <- Tokenler.ad ile AYNI alan adı (D-029 kanıtı)
    deger: Dizi<tam32>;
}

işlev rakam_mi(b: tam8) -> mantıksal {
    değişken k: tam32 = b olarak tam32;
    ver k >= 48 ve k <= 57;
}

işlev harf_mi(b: tam8) -> mantıksal {
    değişken k: tam32 = b olarak tam32;
    ver (k >= 97 ve k <= 122) veya (k >= 65 ve k <= 90);
}

işlev token_ekle(t: &Tokenler, kind: tam32, deger: tam32, ad: metin) -> tam32 {
    dizi_ekle(t.kind, kind);
    dizi_ekle(t.deger, deger);
    dizi_ekle(t.ad, ad);            // <- önceki bug: t.kind'e yazıyordu
    ver 0;
}

// LEXER — metni token akışına çevir (tek-harf değişkenler).
işlev lexle(kaynak: metin, t: &Tokenler) -> tam32 {
    değişken uz: tam32 = metin_uzunluk(kaynak);
    değişken i: tam32 = 0;
    değişken sayi: tam32 = 0;
    değişken sayi_var: mantıksal = yanlış;
    iken i < uz {
        değişken b: tam8 = metin_bayt(kaynak, i);
        eğer rakam_mi(b) {
            sayi = sayi * 10 + (b olarak tam32) - 48;
            sayi_var = doğru;
        } değilse {
            eğer sayi_var { token_ekle(t, 0, sayi, ""); sayi = 0; sayi_var = yanlış; }
            eğer harf_mi(b) {
                token_ekle(t, 7, 0, metin_kes(kaynak, i, 1));   // DEĞİŞKEN
            } değilse {
                değişken tur: tam32 = 0;
                eğer b == 43 { tur = 1; }
                değilse eğer b == 45 { tur = 2; }
                değilse eğer b == 42 { tur = 3; }
                değilse eğer b == 47 { tur = 4; }
                değilse eğer b == 40 { tur = 5; }
                değilse eğer b == 41 { tur = 6; }
                değilse eğer b == 61 { tur = 8; }   // '='
                değilse eğer b == 59 { tur = 9; }   // ';'
                eğer tur != 0 { token_ekle(t, tur, 0, ""); }
            }
        }
        i = i + 1;
    }
    eğer sayi_var { token_ekle(t, 0, sayi, ""); }
    ver 0;
}

// Sembol tablosuna yaz (varsa güncelle, yoksa ekle).
işlev sembol_koy(s: &Semboller, ad: metin, deger: tam32) -> tam32 {
    değişken i: tam32 = 0;
    değişken n: tam32 = dizi_boyut(s.ad);
    iken i < n {
        eğer metin_esit(dizi_al(s.ad, i), ad) { dizi_yaz(s.deger, i, deger); ver 0; }
        i = i + 1;
    }
    dizi_ekle(s.ad, ad); dizi_ekle(s.deger, deger);
    ver 0;
}

// Sembol tablosunda ara (tanımsız → 0).
işlev sembol_ara(s: &Semboller, ad: metin) -> tam32 {
    değişken i: tam32 = 0;
    değişken n: tam32 = dizi_boyut(s.ad);
    iken i < n {
        eğer metin_esit(dizi_al(s.ad, i), ad) { ver dizi_al(s.deger, i); }
        i = i + 1;
    }
    ver 0;
}

// faktör = SAYI | DEĞİŞKEN | '(' ifade ')'
işlev faktor(t: &Tokenler, s: &Semboller) -> tam32 {
    değişken p: tam32 = dizi_al(t.imlec, 0);
    değişken k: tam32 = dizi_al(t.kind, p);
    eğer k == 5 {                                   // '('
        dizi_yaz(t.imlec, 0, p + 1);
        değişken v: tam32 = ifade(t, s);
        dizi_yaz(t.imlec, 0, dizi_al(t.imlec, 0) + 1);
        ver v;
    }
    eğer k == 7 {                                   // DEĞİŞKEN
        dizi_yaz(t.imlec, 0, p + 1);
        ver sembol_ara(s, dizi_al(t.ad, p));
    }
    dizi_yaz(t.imlec, 0, p + 1);                     // SAYI
    ver dizi_al(t.deger, p);
}

// terim = faktör ( ('*'|'/') faktör )*
işlev terim(t: &Tokenler, s: &Semboller) -> tam32 {
    değişken sol: tam32 = faktor(t, s);
    iken doğru {
        değişken p: tam32 = dizi_al(t.imlec, 0);
        eğer p >= dizi_boyut(t.kind) { ver sol; }
        değişken op: tam32 = dizi_al(t.kind, p);
        eğer op == 3 { dizi_yaz(t.imlec, 0, p + 1); sol = sol * faktor(t, s); }
        değilse eğer op == 4 { dizi_yaz(t.imlec, 0, p + 1); sol = sol / faktor(t, s); }
        değilse { ver sol; }
    }
    ver sol;
}

// ifade = terim ( ('+'|'-') terim )*
işlev ifade(t: &Tokenler, s: &Semboller) -> tam32 {
    değişken sol: tam32 = terim(t, s);
    iken doğru {
        değişken p: tam32 = dizi_al(t.imlec, 0);
        eğer p >= dizi_boyut(t.kind) { ver sol; }
        değişken op: tam32 = dizi_al(t.kind, p);
        eğer op == 1 { dizi_yaz(t.imlec, 0, p + 1); sol = sol + terim(t, s); }
        değilse eğer op == 2 { dizi_yaz(t.imlec, 0, p + 1); sol = sol - terim(t, s); }
        değilse { ver sol; }
    }
    ver sol;
}

// Tam yorumlayıcı: lex → atamaları işle (sembol tablosu) → son ifade.
işlev calistir(kaynak: metin) -> tam32 {
    değişken t: Tokenler = Tokenler {
        kind: dizi_olustur(32), deger: dizi_olustur(32),
        ad: dizi_olustur(32), imlec: dizi_olustur(1)
    };
    lexle(kaynak, &t);
    dizi_ekle(t.imlec, 0);

    değişken s: Semboller = Semboller {
        ad: dizi_olustur(8), deger: dizi_olustur(8)
    };

    iken doğru {
        değişken p: tam32 = dizi_al(t.imlec, 0);
        // DEĞİŞKEN '=' ... ';'  ataması mı?
        eğer dizi_al(t.kind, p) == 7 ve dizi_al(t.kind, p + 1) == 8 {
            değişken ad: metin = dizi_al(t.ad, p);
            dizi_yaz(t.imlec, 0, p + 2);                  // DEĞİŞKEN ve '=' tüket
            değişken v: tam32 = ifade(&t, &s);
            sembol_koy(&s, ad, v);
            değişken q: tam32 = dizi_al(t.imlec, 0);       // ';' tüket
            eğer q < dizi_boyut(t.kind) ve dizi_al(t.kind, q) == 9 {
                dizi_yaz(t.imlec, 0, q + 1);
            }
        } değilse {
            ver ifade(&t, &s);                           // sonuç
        }
    }
    ver 0;
}

işlev main() -> tam32 {
    ver calistir("x=6;y=7;x*y") olarak tam32;       // x=6, y=7 → x*y = 42
}
