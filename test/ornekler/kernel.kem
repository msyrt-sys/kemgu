// ARM64 cross-compile dogrulama — bare-metal kernel snippet
// Linear Types + escape + bit op kombinasyonu, libc-bagimsiz aritmetik.
//
// Sayfa tablosu girisi olustur: ust 52 bit adres | alt 12 bit izinler
// (ARMv8-A LPAE benzeri sahte format — bit op'lari + tam64 page table).

işlev sayfa_giris(adres: tam64, izinler: tam64) -> tam64 {
    ver (adres << 12) | (izinler & 4095);
}

işlev sayfa_adresi(giris: tam64) -> tam64 {
    ver giris >> 12;
}

işlev sayfa_izin(giris: tam64) -> tam64 {
    ver giris & 4095;
}

işlev main() -> tam32 {
    // tam64 page table — bit op'lari tam64 uzerinde dogrular
    değişken sayfa = sayfa_giris(1, 7);
    // sayfa = (1<<12) | (7 & 4095) = 4096 | 7 = 4103
    // sayfa_adresi(sayfa) = 4103 >> 12 = 1
    // sayfa_izin(sayfa) = 4103 & 4095 = 7

    // ARM64 exit code (tam32): bit op kompozisyonu ile 42 olustur
    değişken kontrol = (1 << 5) | (1 << 3) | 2;  // 32 | 8 | 2 = 42 (tam32)
    eğer kontrol == 42 {
        ver 42;
    }
    ver 1;
}
