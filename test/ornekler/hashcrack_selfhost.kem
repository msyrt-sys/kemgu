// =========================================================================
işlev k_dizisi() -> Dizi<dtam32> {
    ver [
        1116352408, 1899447441, 3049323471, 3921009573,  961987163,
        1508970993, 2453635748, 2870763221, 3624381080,  310598401,
         607225278, 1426881987, 1925078388, 2162078206, 2614888103,
