// KEMGU SELF-HOST SHA-256 PAROLA KIRICI — LAB-KAPSAMLI pentest aracı (cihazsız).
// =========================================================================
// Bu örnek, KEMGU dilinin gerçek bir OFANSİF-GÜVENLİK aracı — Kali/Pentest-OS
// tarzı (john the ripper / hashcat) SÖZLÜK SALDIRISI (dictionary attack) ile
// SHA-256 parola kırıcı — kaldırdığını kanıtlar. Saf KEMGU dilinde, cihazsız
// (MMIO / yetki<MMIO> yok): yalnızca aritmetik + bit işlemleri + dizi.
//
// LAB-KAPSAM (etik): Bu araç KENDİ ürettiği bir hedef hash'i kırar — dışarıdan
// gelen gerçek bir parola-hash HEDEFİ YOKTUR. Test, sözlükteki BİLİNEN bir
// parolanın ("kemgu") SHA-256'sını kendisi hesaplar, sonra bu hash'i bilmiyormuş
// gibi tüm sözlük adaylarını tarayarak geri bulur. Klasik güvenlik-eğitimi /
// CTF laboratuvar senaryosu. Hiçbir dış sisteme dokunulmaz (cihazsız QEMU).
//
// SÖZLÜK SALDIRISI: Küçük gömülü sözlük (8 aday parola). Kırıcı her adayın
// SHA-256'sını hesaplar, hedef hash'in 8 word'ü ile karşılaştırır. Eşleşen
// aday = kırılan parola. Eşleşmeyen adaylar atlanır (hash farklı → devam).
//
// KRİTİK dil gözlemleri (codegen doğrulaması — D-173 SHA-256 dersleri):
//   (1) `dtam32` (işaretsiz 32-bit) toplama LLVM `add i32` → mod-2^32 WRAP.
//       SHA-256 mod-2^32 toplama gerektirir; KEMGU dtam32 bunu SAĞLAR.
//   (2) `dtam32` sağa-kaydırma → LLVM `lshr` (MANTIKSAL). rotr doğru çalışır.
//   (3) KRİTİK: bir DİZİ elemanının doğrudan `>>` operandı olması `ashr`
//       (İŞARETLİ) üretir → işaretsizliği KAYBEDER. ÇÖZÜM (D-173): tüm
//       bit-karıştırma SKALER `dtam32` PARAMETRELİ yardımcılara taşındı;
//       dizi elemanı bunlara ARGÜMAN geçer → işlev içinde skaler kaydırma →
//       `lshr` (doğru). (runtime/codegen DEĞİŞMEDİ; dil-seviyesi desen.)
//   (4) `karakter` sayısal değil (D-175) → parola byte'ları tam32/dtam32
//       dizisi olarak tutulur, karakter tipi HİÇ kullanılmaz.
//   (5) `olarak` cast (D-200) → tam32 <-> dtam32 sınırlarında explicit dönüşüm.
//
// Beklenen çıktı: "KEM CRACK BASLA" + hedef digest + aday tarama + "KEM CRACK OK".

// --- SHA-256 başlangıç durumu H[0..7] (ilk 8 asalın karekökü kesirleri) ---
sabit H0_ILK: dtam32 = 1779033703;  // 0x6a09e667
sabit H1_ILK: dtam32 = 3144134277;  // 0xbb67ae85
sabit H2_ILK: dtam32 = 1013904242;  // 0x3c6ef372
sabit H3_ILK: dtam32 = 2773480762;  // 0xa54ff53a
sabit H4_ILK: dtam32 = 1359893119;  // 0x510e527f
sabit H5_ILK: dtam32 = 2600822924;  // 0x9b05688c
sabit H6_ILK: dtam32 = 528734635;   // 0x1f83d9ab
sabit H7_ILK: dtam32 = 1541459225;  // 0x5be0cd19

// =========================================================================
// Bit-karıştırma yardımcıları — HEPSİ SKALER dtam32 PARAMETRELİ (D-173 deseni).
// Dizi elemanları bunlara ARGÜMAN geçilir → kaydırmalar skaler üstünde → `lshr`.
// =========================================================================

// Rotate-right: (x >> n) | (x << (32 - n)). x/n skaler dtam32.
işlev rotr(x: dtam32, n: dtam32) -> dtam32 {
    ver (x >> n) | (x << (32 - n));
}

// Mesaj çizelgesi küçük-sigma0: rotr(x,7) ^ rotr(x,18) ^ (x >> 3)
işlev kucuk_sigma0(x: dtam32) -> dtam32 {
    ver rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3);
}

// Mesaj çizelgesi küçük-sigma1: rotr(x,17) ^ rotr(x,19) ^ (x >> 10)
işlev kucuk_sigma1(x: dtam32) -> dtam32 {
    ver rotr(x, 17) ^ rotr(x, 19) ^ (x >> 10);
}

// Sıkıştırma büyük-sigma0: rotr(x,2) ^ rotr(x,13) ^ rotr(x,22)
işlev buyuk_sigma0(x: dtam32) -> dtam32 {
    ver rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22);
}

// Sıkıştırma büyük-sigma1: rotr(x,6) ^ rotr(x,11) ^ rotr(x,25)
işlev buyuk_sigma1(x: dtam32) -> dtam32 {
    ver rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25);
}

// Ch (choose): (x & y) ^ ((^x) & z). KEMGU'da bit-NOT = x ^ 0xFFFFFFFF.
işlev ch(x: dtam32, y: dtam32, z: dtam32) -> dtam32 {
    değişken x_ters: dtam32 = x ^ 4294967295;   // ~x  (0xFFFFFFFF)
    ver (x & y) ^ (x_ters & z);
}

// Maj (majority): (x & y) ^ (x & z) ^ (y & z).
işlev maj(x: dtam32, y: dtam32, z: dtam32) -> dtam32 {
    ver (x & y) ^ (x & z) ^ (y & z);
}

// =========================================================================
