// kem_os_x86_ekran.kem — [D-748] BARE-METAL EKRAN v0 kâhin çekirdeği: QEMU std VGA (PCI
// 1234:1111) Bochs DISPI ile 640x480x32 doğrusal çerçeve tamponu + PSF Türkçe metin.
// Ekran kodu runtime/mimari/x86_64/kem_ekran_bga.kem'de (kabukla ORTAK). Bu çekirdek DISPI
// geri okumalarını seriye basar; test/bm_x86_ekran_harness.sh QMP screendump'ı bağımsız
// Python çizimiyle (tests/qemu/bm_ekran.py) piksel piksel karşılaştırır.
kullan drivers::ekran::psf::{ PsfFont, psf_coz };
kullan tests::drivers::ekran::veri::psf_gercek::{ gercek_font };

sabit EK_ARKA: tam64 = 1056832;      // 0x102040
sabit EK_ON: tam64 = 16777215;       // 0xFFFFFF
sabit EK_SARI: tam64 = 16766976;     // 0xFFD800

işlev ek_calis() -> sonuç<metin, metin> {
    eşleş ekran_bga_ac(640, 480, EK_ARKA) {
        hata(e) => { ver hata(e); }
        tamam(e) => {
            değişken r: metin = metin_birlestir("DISPI id=", tam_metin(e.kimlik olarak tam64));
            r = metin_birlestir(metin_birlestir(r, " x="), tam_metin(dispi_oku(e.mmio, 1) olarak tam64));
            r = metin_birlestir(metin_birlestir(r, " y="), tam_metin(dispi_oku(e.mmio, 2) olarak tam64));
            r = metin_birlestir(metin_birlestir(r, " bpp="), tam_metin(dispi_oku(e.mmio, 3) olarak tam64));
            r = metin_birlestir(metin_birlestir(r, " vw="), tam_metin(dispi_oku(e.mmio, 6) olarak tam64));
            bm_yaz(r);
            eşleş psf_coz(gercek_font()) {
                hata(m) => { ver hata(metin_birlestir("psf ", m)); }
                tamam(f) => {
                    değişken sy: tam32 = f.yukseklik + 4;
                    ekran_metin(e, f, 8, 8, "KEMGU-OS ekran v0", EK_SARI, EK_ARKA);
                    ekran_metin(e, f, 8, 8 + sy, "Merhaba Dünya — ğüşıöç İ", EK_ON, EK_ARKA);
                    ekran_metin(e, f, 8, 8 + 2 * sy, "ĞÜŞİÖÇ ğüşıöç 0123456789", EK_ON, EK_ARKA);
                    ver tamam(metin_birlestir("font=", tam_metin(f.genislik olarak tam64)));
                }
            }
        }
    }
}

işlev main() -> tam32 {
    bm_yaz("KEMGU-OS x86 ekran v0");
    eşleş ek_calis() {
        hata(e) => { bm_yaz(metin_birlestir("EKRAN HATA ", e)); kem_qemu_cik(1); }
        tamam(m) => { bm_yaz(metin_birlestir("EKRAN_HAZIR ", m)); }
    }
    iken doğru { kem_bekle_us(1000); }
    ver 0;
}
