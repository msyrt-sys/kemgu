// KEMGU Katman 2 (Concurrency / DRF V1) — görev temel örneği
//
// görev_başlat(c: işlev() -> T) -> sonuç<görev<T>, metin>
//     Yeni bir görev başlatır. c PARAMETRESİZ bir kapanış olmalı (DRF001).
//     Görev kendi bölgesini (ρ_sahip) sahiplenir — R-GÖREV / S2.
//
//     Karar 1 (D-30x): DÖNÜŞ artık sonuç<görev<T>, metin>. Görev başlatmak
//     BAŞARISIZ olabilir (kaynak tükenmesi ~10^5 thread; ya da thread'siz
//     platform). KEMGU çökmez (exception/panik yok) → başarısızlık çağırana bir
//     DEĞER olarak sunulur: tamam(görev<T>) veya hata(metin). Çağıran `eşleş`
//     ile açar. Bu, dilin "çökmezlik" DNA'sının doğal sonucudur.
//
// görev_birleştir(g: görev<T>) -> T
//     Görevin bitmesini bekler, sonucunu çağırana taşır — R-BİRLEŞTİR.
//     g bu noktada TÜKETİLİR: görev<T> lineerdir, iki kez birleştirilemez
//     (L002) ve hiç birleştirilmezse sızıntı olarak raporlanır (L001).
//
// Veri yarışı neden imkânsız (KEMGU_Bellek_Modeli.md Katman 2):
//     S1 (tekil sahiplik) — bir bölgenin her an TEK sahibi vardır.
//     S2 (başlangıç sahipliği) — görev yaratıldığında kendi ρ_sahip'ini alır;
//     çağıranın bölgesi PAYLAŞILMAZ. İki thread aynı bölgeye erişemediği için
//     yarış, çalışma-zamanı kilidiyle değil, TİP+BÖLGE seviyesinde elenir.
//
// T'nin kapsamı (D-294): T ∈ {≤64-bit tamsayı, işaretçi-benzeri (metin/&T/Dizi<T>), boş}.
// KESİRLİ T DESTEKLENMEZ (DRF001): runtime görev sonucunu tamsayı yazmacından
// (x0/rax) okur, kesirli dönüş v0/xmm0'dadır → sessizce çöp olurdu. Sessiz
// bozulma yerine derleme-zamanı red tercih edildi.
//
// ERGONOMİ NOTU: Bugün her görev_başlat bir `eşleş` ister → iç içe girer.
// İleride sonuç için bir yayılım operatörü (`?`-benzeri) bu deseni düzleştirecek.
//
// Beklenen çıkış kodu: 42

işlev main() -> tam32 {
    // (c) İşaretçi taşıyan T (D-294): görev bir `metin` döndürebilir.
    //     Runtime i64 taşır; birleştir yeri bildirilen görev<metin>'den T=ptr
    //     öğrenip inttoptr eder. i32 taşımada bu işaretçi kırpılırdı.
    eşleş görev_başlat(|| "selam") {
        tamam(c) => {
            değişken s: metin = görev_birleştir(c);
            eğer metin_uzunluk(s) != 5 { ver 1; }   // "selam" -> 5 doğrulanır

            // (a) Yakalamasız görev — kapanış hiçbir şey yakalamaz.
            eşleş görev_başlat(|| 20) {
                tamam(a) => {
                    // (b) Yakalamalı görev — `temel` kapanışa değer olarak
                    //     yakalanır ve görevin bölgesine taşınır (YD(c) transferi).
                    değişken temel: tam32 = 20;
                    eşleş görev_başlat(|| temel + 2) {
                        // 20 + 22 = 42.
                        tamam(b) => { ver görev_birleştir(a) + görev_birleştir(b); }
                        // D-336: HATA dalında da `a` birleştirilmeli. Aksi halde bu
                        // yolda görev tanıtıcısı hiç birleştirilmeden düşer = SIZINTI
                        // (L005 bunu bildiriyordu; örnek dosya kuralı ihlal ediyordu
                        // ve hiçbir kapı korpus üzerinde --check koşturmadığı için
                        // fark edilmemişti).
                        hata(eb) => { değişken yut: tam32 = görev_birleştir(a); ver 1; }
                    }
                }
                hata(ea) => { ver 1; }
            }
        }
        hata(ec) => { ver 1; }
    }
    ver 99;   // ulaşılmaz (her dal ver ile döner)
}
