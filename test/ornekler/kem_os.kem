// =====================================================================
// kem_os.kem — KEMGU-OS Faz-2: TEK .kem-native bare-metal OS iskeleti
// ---------------------------------------------------------------------
// Faz-1 keşif kernel'leri A⊕B⊕C⊕E'nin SERİ ENTEGRASYONU: dört alt-sistem
// TEK boot'ta, TEK .kem imajında canlı. Bu, C-yazılı entegre çekirdeğin
// (test/bare_metal/kemgu_os_arm.c) .kem-native ikizinin İSKELETİdir.
//
//   [1] BOOT     — .kem bare-metal boot + UART (A: kem_cekirdek_min)
//   [2] HEAP     — region-runtime heap Dizi<tam32> (B: kem_dizi_kernel)
//   [3] MMIO     — yetki<MMIO> capability + donanım register (C: kem_mmio_kernel)
//   [4] HESAP    — özyineleme + iken + eşleş + eğer/değilse (E: kem_hesap_kernel)
//   [5] SİSTEM   — .kem panik + exc-handler-mantığı (D-247, Faz-2c; 2b keşif entegre)
//
// Entegrasyon kanıtı: dört alt-sistem de doğru sonucu verirse (5/5 kontrol)
// TEK marker "KEMGU KEM-OS OK" basılır. Herhangi biri bozuksa "... HATA".
//
// D-245 (Faz-2a): KONSOL ÇIKTI YOLU C runtime DEĞİL — .kem-native UART sürücüsü
// (uart_satir/uart_tam_satir, aşağıda) ENTEGRE edildi + C kdl_yazdir yolu SİLİNDİ.
// Kanıt: bu dosyanın derlenmiş IR'ında `call @kdl_yazdir*` = 0 (yalnız declare).
//
// Derleme (MMIO+metin nedeniyle +bm_a64_mmio.o +bm_a64_yetki.o +bm_a64_metin.o):
//   ./build/kemgu --llvm test/ornekler/kem_os.kem > build/kem_os.ll
//   clang -target aarch64-unknown-none -ffreestanding -nostdlib -O2 \
//         -Wno-override-module -x ir build/kem_os.ll -c -o build/kem_os.o
//   ld.lld -m aarch64linux -T linker/bare-metal-aarch64.ld -o build/kem_os.elf \
//         build/kem_os.o build/bm_a64_mmio.o build/bm_a64_yetki.o \
//         build/bm_a64_metin.o $(BM_A64_OBJS)
//   qemu-system-aarch64 -M virt -cpu cortex-a72 -display none -kernel build/kem_os.elf
// =====================================================================

// ---- Alt-sistem 3 sabitleri: MMIO (VirtIO-MMIO slot 0, QEMU virt) ----
sabit VIRTIO_TABAN: tam64     = 167772160;   // 0x0A000000 (slot 0 taban)
sabit VIRTIO_MAGIC_OFF: tam64 = 0;           // 0x000 MagicValue register offset
sabit MAGIC_BEKLENEN: tam32   = 1953655158;  // 0x74726976 = "virt" (LE)
sabit MMIO_OKU_YAZ: tam32     = 3;           // izin: OKU|YAZ

// ==================== [0] .kem-native PL011 UART SÜRÜCÜSÜ ====================
// D-244'te ayrı kem_surucu.kem'de kanıtlandı → D-245'te BU çekirdeğe ENTEGRE +
// C kdl_yazdir yolu SİLİNDİ (Faz-2a, YASA-2: mevcut kernel kullanır, eski yol yok).
// Konsol çıktısı artık TAMAMEN .kem: MMIO ile PL011 (0x09000000). uart_satir =
// yazdir_metin'in, uart_tam_satir = yazdir_tam'ın .kem-native karşılığı.
sabit UART_TABAN: tam64 = 150994944;   // 0x09000000 PL011 (QEMU virt)
sabit UART_DR: tam64    = 0;           // 0x00 veri register
sabit UART_FR: tam64    = 24;          // 0x18 flag register
sabit UART_TXFF: tam32  = 32;          // bit5 = TX FIFO dolu

// Tek bayt yaz: FR.TXFF temizlenene kadar bekle → DR'ye yaz. yetki<MMIO> linear
// (üret/oku-ödünç/yaz-ödünç/geri_al; & bitwise, != öncelik için parantez ZORUNLU).
işlev uart_bayt(b: tam32) {
    değişken y: yetki<MMIO> = yetki_olustur(6, MMIO_OKU_YAZ);
    iken (mmio_oku32(y, UART_TABAN + UART_FR) & UART_TXFF) != 0 {
    }
    mmio_yaz32(y, UART_TABAN + UART_DR, b);
    geri_al(y);
}

// Metni bayt-bayt yaz (metin_bayt bare-metal, kdl_metin_bare.c/bm_a64_metin.o).
işlev uart_metin(s: metin) {
    değişken n: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 0;
    iken i < n {
        uart_bayt(metin_bayt(s, i) olarak tam32);
        i = i + 1;
    }
}

// Satır (metin + newline) — yazdir_metin yerine.
işlev uart_satir(s: metin) {
    uart_metin(s);
    uart_bayt(10);
}

// Sayı (decimal, özyinelemeli basamak) — yazdir_tam yerine.
işlev uart_tam_yardim(n: tam32) {
    eğer n > 0 {
        uart_tam_yardim(n / 10);
        uart_bayt((n % 10) + 48);
    }
}
işlev uart_tam_satir(n: tam32) {
    eğer n == 0 {
        uart_bayt(48);
    } değilse {
        uart_tam_yardim(n);
    }
    uart_bayt(10);
}

// Onaltılık (hex) yaz — SATIRSIZ (mid-line; register değerleri için). dtam64 işaretsiz
// (donanım register), >> tip-duyarlı lshr. 10-15 → 'a'-'f' (kod 87+r).
işlev uart_hex_basamak(d: dtam64) {
    eğer d > 0 {
        uart_hex_basamak(d / 16);
        değişken r: tam32 = (d - (d / 16) * 16) olarak tam32;   // d mod 16
        eğer r < 10 {
            uart_bayt(r + 48);        // '0'
        } değilse {
            uart_bayt(r + 87);        // 10 → 'a'
        }
    }
}
işlev uart_onaltilik(d: dtam64) {
    eğer d == 0 {
        uart_bayt(48);
    } değilse {
        uart_hex_basamak(d);
    }
}

// ========================= [2] HEAP alt-sistemi =========================
// Heap Dizi<tam32>: 1..10 ekle (kapasite 4→8→16 aşımı → region realloc +
// memcpy) → sınır-kontrollü topla. Beklenen: 55.
işlev heap_dizi_topla() -> tam32 {
    değişken d: Dizi<tam32> = dizi_olustur(4);
    değişken i: tam32 = 0;
    iken i < 10 {
        dizi_ekle(d, i + 1);
        i = i + 1;
    }
    değişken toplam: tam32 = 0;
    i = 0;
    iken i < dizi_boyut(d) {
        toplam = toplam + dizi_al(d, i);
        i = i + 1;
    }
    ver toplam;
}

// ========================= [3] MMIO alt-sistemi =========================
// yetki<MMIO> capability üret → VirtIO MagicValue register'ı GERÇEKTEN oku
// → linear geri_al ile tüket. Beklenen: 0x74726976.
işlev mmio_magic_oku() -> tam32 {
    değişken y: yetki<MMIO> = yetki_olustur(6, MMIO_OKU_YAZ);
    değişken magic: tam32 = mmio_oku32(y, VIRTIO_TABAN + VIRTIO_MAGIC_OFF);
    geri_al(y);
    ver magic;
}

// ========================= [4] HESAP alt-sistemi ========================
// (a) özyinelemeli faktoriyel
işlev faktoriyel(n: tam32) -> tam32 {
    eğer n < 2 {
        ver 1;
    }
    ver n * faktoriyel(n - 1);
}

// (b) özyinelemeli fibonacci (çift özyineleme + if)
işlev fib(n: tam32) -> tam32 {
    eğer n < 2 {
        ver n;
    }
    ver fib(n - 1) + fib(n - 2);
}

// (c) iken döngüsü
işlev dongu_toplam(n: tam32) -> tam32 {
    değişken toplam: tam32 = 0;
    değişken i: tam32 = 1;
    iken i <= n {
        toplam = toplam + i;
        i = i + 1;
    }
    ver toplam;
}

// (d) eşleş pattern-match — literal desen + joker
işlev basamak_adi(d: tam32) -> tam32 {
    eşleş d {
        0 => { ver 100; }
        1 => { ver 200; }
        2 => { ver 300; }
        _ => { ver 999; }
    }
    ver 0;
}

// (e) eğer/değilse zinciri — büyüklük kategorisi
işlev kategori(n: tam32) -> tam32 {
    eğer n < 0 {
        ver 0;
    } değilse eğer n < 10 {
        ver 1;
    } değilse eğer n < 100 {
        ver 2;
    } değilse {
        ver 3;
    }
}

// ==================== [5] SİSTEM alt-sistemi: PANİK + EXCEPTION ====================
// D-247 (Faz-2c): Faz-2b keşif prototipleri (kem_panik.kem + kem_exc.kem) BU çekirdeğe
// ENTEGRE edildi + standalone'lar SİLİNDİ (YASA-2). Konsol .kem-UART olduğundan panik/exc
// çıktısı da uart_* kullanır (C yazdir DEĞİL — 2a'nın 0-kdl_yazdir kanıtı korunur).

// --- .kem PANİK (kdl_panik.c yerine): mesaj bas + sonsuz halt (dönmez). ---
işlev panik(mesaj: metin) {
    uart_satir("");
    uart_metin("PANIK: ");
    uart_satir(mesaj);
    iken doğru {            // HALT — spin (wfe/wfi inline-asm C8'de; spin fonksiyonel yeter)
    }
}

// --- .kem EXCEPTION HANDLER MANTIĞI (kdl_kesme.c handler yerine; vektör asm HARİÇ). ---
// ESR_EL1 EC alanı (ESR[31:26]) sabitleri (ARMv8 D17.2.37).
sabit EC_INSTR_ABORT_EL0: dtam64 = 32;   // 0x20
sabit EC_INSTR_ABORT_EL1: dtam64 = 33;   // 0x21
sabit EC_DATA_ABORT_EL0: dtam64  = 36;   // 0x24
sabit EC_DATA_ABORT_EL1: dtam64  = 37;   // 0x25
sabit EC_SVC64: dtam64           = 21;   // 0x15

işlev esr_ec(esr: dtam64) -> dtam64 {
    ver esr / 67108864;                  // >> 26
}
işlev esr_dfsc(esr: dtam64) -> dtam64 {
    ver esr - ((esr / 64) * 64);         // esr mod 64 (alt 6 bit)
}
işlev fault_sinifi(esr: dtam64) -> tam32 {
    değişken ec: dtam64 = esr_ec(esr);
    eğer ec == EC_SVC64 {
        ver 0;
    } değilse eğer (ec == EC_INSTR_ABORT_EL0) veya (ec == EC_INSTR_ABORT_EL1) {
        ver 1;                           // instruction abort
    } değilse eğer (ec == EC_DATA_ABORT_EL0) veya (ec == EC_DATA_ABORT_EL1) {
        ver 2;                           // data abort
    } değilse {
        ver 9;
    }
}
işlev abort_alt_tur(esr: dtam64) -> tam32 {
    değişken s: tam32 = fault_sinifi(esr);
    eğer (s != 1) ve (s != 2) {
        ver 0;
    }
    değişken dfsc: dtam64 = esr_dfsc(esr);
    eğer (dfsc >= 4) ve (dfsc <= 7) {
        ver 1;                           // translation fault
    } değilse eğer (dfsc >= 13) ve (dfsc <= 15) {
        ver 2;                           // permission fault
    } değilse {
        ver 3;
    }
}
// Handler kararı: 1=KURTAR (data-abort+translation → demand-page), 2=OLDUR
// (permission → izolasyon), 3=HALT (kurtarılamaz).
işlev handler_karari(esr: dtam64) -> tam32 {
    değişken s: tam32 = fault_sinifi(esr);
    değişken alt: tam32 = abort_alt_tur(esr);
    eğer (s == 2) ve (alt == 1) {
        ver 1;
    } değilse eğer alt == 2 {
        ver 2;
    } değilse {
        ver 3;
    }
}
// Asm-stub'un çağıracağı handler (C kdl_istisna_isle yerine). FAR/ESR alır (2c'de
// sentetik self-test; gerçek fault-yönlendirmesi=asm-hook, sonraki adım). Kararı döner.
işlev kem_istisna_isle(far: dtam64, esr: dtam64) -> tam32 {
    değişken karar: tam32 = handler_karari(esr);
    uart_metin("  EXC FAR=0x");
    uart_onaltilik(far);
    uart_metin(" ESR=0x");
    uart_onaltilik(esr);
    uart_metin(" karar=");
    eğer karar == 1 {
        uart_satir("KURTAR");
    } değilse eğer karar == 2 {
        uart_satir("OLDUR");
    } değilse {
        uart_satir("HALT");
    }
    ver karar;
}

// A2 (D-278): GERÇEK trap → .kem KARAR handler. D-276 [5b] .S recovery'ye EK: gerçek
// data-abort'tan SONRA ESR/FAR'ı mrs ile OKU + kem_istisna_isle'a ver → .kem handler
// GERÇEK syndrome üzerinde karar veriyor (sentetik hardcoded DEĞİL). 0x80000000 haritasız
// → EC=0x25 (data-abort EL1) + DFSC translation → handler KURTAR(1) döner + FAR==VA.
işlev trap_gercek_testi() -> tam32 {
    kmmu_bekle_yaz(1);                                          // .S recovery iste (yoksa halt)
    değişken cop: tam64 = kmmu_oku_faulting(2147483648);       // GERÇEK data-abort (0x80000000)
    değişken resr: dtam64 = (kmmu_esr_oku()) olarak dtam64;    // GERÇEK ESR (mrs, post-trap)
    değişken rfar: tam64 = kmmu_far_mrs();                     // GERÇEK FAR (mrs, post-trap)
    değişken karar: tam32 = kem_istisna_isle(rfar olarak dtam64, resr);  // .kem handler GERÇEK syndrome
    eğer (karar == 1) ve (rfar == 2147483648) {                // KURTAR + gerçek FAR
        ver 1;
    }
    ver 0;
}

// ============================== ÇEKİRDEK ===============================
// [6] DISK — saf-.kem virtio-blk GERÇEK sektör yaz→oku→byte-eşleşme (D-271, FAZ B1).
// vblk_* sürücüsü kem_virtio_blk.kem'den gelir (build'de kem_os ile CAT edilir → tek birim,
// çıplak→çıplak çözülür, T002 yok). Sektör 7'ye değişken pattern yaz → data'yı temizle →
// geri oku → byte-byte karşılaştır. GERÇEK disk I/O (magic-probe DEĞİL); disk yoksa 0 döner.
işlev disk_rw_testi() -> tam32 {
    değişken base: tam64 = vblk_bul();
    eğer base == 0 { ver 0; }                       // virtio-blk cihazı yok
    eğer vblk_kur(base) != 0 { ver 0; }             // kurulum hatası
    değişken i: tam32 = 0;
    iken i < 512 {                                   // pattern: (i%251)+3 (sabit değil → gerçek round-trip)
        vblk_data_yaz(i, ((i % 251) + 3) olarak dtam8);
        i = i + 1;
    }
    eğer vblk_yaz(base, 7) != 0 { ver 0; }
    i = 0;
    iken i < 512 { vblk_data_yaz(i, 0 olarak dtam8); i = i + 1; }   // temizle (okuma diskten gelmeli)
    eğer vblk_oku(base, 7) != 0 { ver 0; }
    değişken eslesme: tam32 = 1;
    i = 0;
    iken i < 512 {
        eğer vblk_data_oku(i) != ((i % 251) + 3) olarak dtam8 { eslesme = 0; }
        i = i + 1;
    }
    ver eslesme;
}

// [7] FS — saf-.kem minifs (kem_minifs.kem, FAZ-B2) virtio-blk üstünde GERÇEK dosya I/O.
// format → dosya "veri" oluştur+RASTGELE-pattern YAZ → vq_data BOZ → dosya OKU (inode
// indirection: superblock magic + isim eşleşme + boyut + veri_blok pointer) → içerik+boyut
// EŞLEŞME. Sentetik değil: içerik disk blok'larından fs-katmanı üzerinden geri okunur.
işlev fs_rw_testi() -> tam32 {
    değişken base: tam64 = vblk_bul();
    eğer base == 0 { ver 0; }
    eğer vblk_kur(base) != 0 { ver 0; }
    eğer mfs_format(base) != 0 { ver 0; }
    değişken boyut: tam32 = 200;
    değişken i: tam32 = 0;
    iken i < 512 { vblk_data_yaz(i, 0 olarak dtam8); i = i + 1; }        // vq_data temizle
    i = 0;
    iken i < boyut { vblk_data_yaz(i, ((i * 7 + 11) % 256) olarak dtam8); i = i + 1; }   // rastgele pattern
    eğer mfs_dosya_yaz(base, 118, 101, 114, 105, boyut) != 0 { ver 0; } // "veri" (v,e,r,i)
    i = 0; iken i < 512 { vblk_data_yaz(i, 255 olarak dtam8); i = i + 1; }   // vq_data BOZ (okuma diskten)
    değişken okunan: tam32 = mfs_dosya_oku(base, 118, 101, 114, 105);
    eğer okunan != boyut { ver 0; }                                    // boyut eşleşme
    değişken eslesme: tam32 = 1;
    i = 0;
    iken i < boyut {
        eğer vblk_data_oku(i) != ((i * 7 + 11) % 256) olarak dtam8 { eslesme = 0; }
        i = i + 1;
    }
    ver eslesme;
}

// [8] NET DEV — saf-.kem virtio-net (kem_virtio_net.kem, FAZ-C) cihaz bringup.
// bul(DeviceID=1) + kur(feature-negotiate + RX/TX queue + DRIVER_OK) + device-provided
// MAC config oku (cihaz canlı kanıtı). Gerçek: FEAT_OK device onayı + MAC nonzero.
işlev net_dev_testi() -> tam32 {
    değişken base: tam64 = vnet_bul();
    eğer base == 0 { ver 0; }                          // net cihazı yok
    eğer vnet_kur(base) != 0 { ver 0; }                // negotiate/queue hatası (FEAT_OK device onayı içinde)
    eğer (vblk_o32(base + VM_STATUS) & 4) == 0 { ver 0; }   // DRIVER_OK bit
    değişken mac0: tam32 = vnet_mac_w0(base);
    eğer mac0 == 0 { ver 0; }                          // MAC device-provided nonzero → cihaz canlı
    ver 1;
}

// [9] NET ARP — saf-.kem GERÇEK ağ round-trip. Gateway (10.0.2.2) için ARP request GÖNDER →
// QEMU SLIRP'ten ARP reply AL → oper=2 + spa=gateway + gateway MAC nonzero DOĞRULA. 2-yönlü ağ
// (TX+RX). Sentetik değil: gerçek paket gönderilir + SLIRP'ten gerçek yanıt alınır+parse edilir.
işlev net_arp_testi() -> tam32 {
    değişken base: tam64 = vnet_bul();
    eğer base == 0 { ver 0; }
    eğer vnet_kur(base) != 0 { ver 0; }
    değişken m0: dtam8 = vnet_mac_bayt(base, 0);       // bizim MAC (config'ten)
    değişken m1: dtam8 = vnet_mac_bayt(base, 1);
    değişken m2: dtam8 = vnet_mac_bayt(base, 2);
    değişken m3: dtam8 = vnet_mac_bayt(base, 3);
    değişken m4: dtam8 = vnet_mac_bayt(base, 4);
    değişken m5: dtam8 = vnet_mac_bayt(base, 5);
    // ARP request çerçevesi (60 bayt), önce sıfırla
    değişken i: tam32 = 0;
    iken i < 60 { vnet_tx_yaz(i, 0 olarak dtam8); i = i + 1; }
    i = 0; iken i < 6 { vnet_tx_yaz(i, 255 olarak dtam8); i = i + 1; }   // eth dst broadcast @0..5
    vnet_tx_yaz(6, m0); vnet_tx_yaz(7, m1); vnet_tx_yaz(8, m2);         // eth src @6..11
    vnet_tx_yaz(9, m3); vnet_tx_yaz(10, m4); vnet_tx_yaz(11, m5);
    vnet_tx_yaz(12, 8 olarak dtam8); vnet_tx_yaz(13, 6 olarak dtam8);   // ethertype 0x0806 ARP
    vnet_tx_yaz(14, 0 olarak dtam8); vnet_tx_yaz(15, 1 olarak dtam8);   // htype ethernet
    vnet_tx_yaz(16, 8 olarak dtam8); vnet_tx_yaz(17, 0 olarak dtam8);   // ptype IPv4
    vnet_tx_yaz(18, 6 olarak dtam8); vnet_tx_yaz(19, 4 olarak dtam8);   // hlen, plen
    vnet_tx_yaz(20, 0 olarak dtam8); vnet_tx_yaz(21, 1 olarak dtam8);   // oper request
    vnet_tx_yaz(22, m0); vnet_tx_yaz(23, m1); vnet_tx_yaz(24, m2);      // sha @22..27
    vnet_tx_yaz(25, m3); vnet_tx_yaz(26, m4); vnet_tx_yaz(27, m5);
    vnet_tx_yaz(28, 10 olarak dtam8); vnet_tx_yaz(29, 0 olarak dtam8);  // spa 10.0.2.15
    vnet_tx_yaz(30, 2 olarak dtam8); vnet_tx_yaz(31, 15 olarak dtam8);
    vnet_tx_yaz(38, 10 olarak dtam8); vnet_tx_yaz(39, 0 olarak dtam8);  // tpa 10.0.2.2 (gateway)
    vnet_tx_yaz(40, 2 olarak dtam8); vnet_tx_yaz(41, 2 olarak dtam8);
    eğer vnet_gonder(base, 60) != 0 { ver 0; }
    // Yanıtı AL (birkaç paket dinle): ARP reply (oper=2) + spa=gateway.
    değişken deneme: tam32 = 0;
    iken deneme < 20 {
        değişken n: tam32 = vnet_al(base, 8000000);
        eğer n >= 42 {
            eğer (vnet_rx_oku(12) == (8 olarak dtam8)) ve (vnet_rx_oku(13) == (6 olarak dtam8))
                ve (vnet_rx_oku(20) == (0 olarak dtam8)) ve (vnet_rx_oku(21) == (2 olarak dtam8))
                ve (vnet_rx_oku(28) == (10 olarak dtam8)) ve (vnet_rx_oku(30) == (2 olarak dtam8))
                ve (vnet_rx_oku(31) == (2 olarak dtam8)) {
                // gateway MAC (sha @22..27) nonzero mu?
                değişken gw: tam32 = (vnet_rx_oku(22) olarak tam32) + (vnet_rx_oku(23) olarak tam32)
                    + (vnet_rx_oku(24) olarak tam32) + (vnet_rx_oku(27) olarak tam32);
                eğer gw != 0 { ver 1; }
            }
        }
        deneme = deneme + 1;
    }
    ver 0;
}

// [10] PING — saf-.kem GERÇEK ICMP echo round-trip ("OS ping atıyor"). ARP ile gateway MAC çöz →
// IPv4+ICMP Echo Request (RFC1071 checksum) GÖNDER → SLIRP echo reply AL → proto=1 + type=0 +
// payload "KEMGU" geri döndü DOĞRULA. Tüm ağ yığını (ARP+IPv4+ICMP+checksum) saf-.kem, gerçek.
işlev net_icmp_testi() -> tam32 {
    değişken base: tam64 = vnet_bul();
    eğer base == 0 { ver 0; }
    eğer vnet_kur(base) != 0 { ver 0; }
    değişken m0: dtam8 = vnet_mac_bayt(base, 0); değişken m1: dtam8 = vnet_mac_bayt(base, 1);
    değişken m2: dtam8 = vnet_mac_bayt(base, 2); değişken m3: dtam8 = vnet_mac_bayt(base, 3);
    değişken m4: dtam8 = vnet_mac_bayt(base, 4); değişken m5: dtam8 = vnet_mac_bayt(base, 5);
    // --- 1) ARP: gateway (10.0.2.2) MAC çöz ---
    değişken i: tam32 = 0;
    iken i < 60 { vnet_tx_yaz(i, 0 olarak dtam8); i = i + 1; }
    i = 0; iken i < 6 { vnet_tx_yaz(i, 255 olarak dtam8); i = i + 1; }
    vnet_tx_yaz(6, m0); vnet_tx_yaz(7, m1); vnet_tx_yaz(8, m2); vnet_tx_yaz(9, m3); vnet_tx_yaz(10, m4); vnet_tx_yaz(11, m5);
    vnet_tx_yaz(12, 8 olarak dtam8); vnet_tx_yaz(13, 6 olarak dtam8);
    vnet_tx_yaz(14, 0 olarak dtam8); vnet_tx_yaz(15, 1 olarak dtam8);
    vnet_tx_yaz(16, 8 olarak dtam8); vnet_tx_yaz(17, 0 olarak dtam8);
    vnet_tx_yaz(18, 6 olarak dtam8); vnet_tx_yaz(19, 4 olarak dtam8);
    vnet_tx_yaz(20, 0 olarak dtam8); vnet_tx_yaz(21, 1 olarak dtam8);
    vnet_tx_yaz(22, m0); vnet_tx_yaz(23, m1); vnet_tx_yaz(24, m2); vnet_tx_yaz(25, m3); vnet_tx_yaz(26, m4); vnet_tx_yaz(27, m5);
    vnet_tx_yaz(28, 10 olarak dtam8); vnet_tx_yaz(29, 0 olarak dtam8); vnet_tx_yaz(30, 2 olarak dtam8); vnet_tx_yaz(31, 15 olarak dtam8);
    vnet_tx_yaz(38, 10 olarak dtam8); vnet_tx_yaz(39, 0 olarak dtam8); vnet_tx_yaz(40, 2 olarak dtam8); vnet_tx_yaz(41, 2 olarak dtam8);
    eğer vnet_gonder(base, 60) != 0 { ver 0; }
    değişken g0: dtam8 = 0 olarak dtam8; değişken g1: dtam8 = 0 olarak dtam8; değişken g2: dtam8 = 0 olarak dtam8;
    değişken g3: dtam8 = 0 olarak dtam8; değişken g4: dtam8 = 0 olarak dtam8; değişken g5: dtam8 = 0 olarak dtam8;
    değişken arp_ok: tam32 = 0;
    değişken deneme: tam32 = 0;
    iken deneme < 20 {
        değişken n: tam32 = vnet_al(base, 8000000);
        eğer n >= 42 {
            eğer (vnet_rx_oku(12) == (8 olarak dtam8)) ve (vnet_rx_oku(13) == (6 olarak dtam8))
                ve (vnet_rx_oku(20) == (0 olarak dtam8)) ve (vnet_rx_oku(21) == (2 olarak dtam8)) {
                g0 = vnet_rx_oku(22); g1 = vnet_rx_oku(23); g2 = vnet_rx_oku(24);
                g3 = vnet_rx_oku(25); g4 = vnet_rx_oku(26); g5 = vnet_rx_oku(27);
                arp_ok = 1; deneme = 20;
            }
        }
        deneme = deneme + 1;
    }
    eğer arp_ok == 0 { ver 0; }
    // --- 2) IPv4 + ICMP Echo Request kur ---
    i = 0; iken i < 60 { vnet_tx_yaz(i, 0 olarak dtam8); i = i + 1; }
    vnet_tx_yaz(0, g0); vnet_tx_yaz(1, g1); vnet_tx_yaz(2, g2); vnet_tx_yaz(3, g3); vnet_tx_yaz(4, g4); vnet_tx_yaz(5, g5);   // dst=gw
    vnet_tx_yaz(6, m0); vnet_tx_yaz(7, m1); vnet_tx_yaz(8, m2); vnet_tx_yaz(9, m3); vnet_tx_yaz(10, m4); vnet_tx_yaz(11, m5); // src
    vnet_tx_yaz(12, 8 olarak dtam8); vnet_tx_yaz(13, 0 olarak dtam8);   // ethertype IPv4 0x0800
    vnet_tx_yaz(14, 69 olarak dtam8);                                  // 0x45 ver4/IHL5
    vnet_tx_yaz(16, 0 olarak dtam8); vnet_tx_yaz(17, 33 olarak dtam8); // total_len = 20+13
    vnet_tx_yaz(20, 64 olarak dtam8);                                  // 0x40 flags DF
    vnet_tx_yaz(22, 64 olarak dtam8);                                  // TTL
    vnet_tx_yaz(23, 1 olarak dtam8);                                   // proto ICMP
    vnet_tx_yaz(26, 10 olarak dtam8); vnet_tx_yaz(27, 0 olarak dtam8); vnet_tx_yaz(28, 2 olarak dtam8); vnet_tx_yaz(29, 15 olarak dtam8); // src IP
    vnet_tx_yaz(30, 10 olarak dtam8); vnet_tx_yaz(31, 0 olarak dtam8); vnet_tx_yaz(32, 2 olarak dtam8); vnet_tx_yaz(33, 2 olarak dtam8);  // dst IP
    değişken ihs: tam32 = vnet_tx_checksum(14, 20);   // IP başlık checksum
    vnet_tx_yaz(24, ((ihs >> 8) & 255) olarak dtam8); vnet_tx_yaz(25, (ihs & 255) olarak dtam8);
    vnet_tx_yaz(34, 8 olarak dtam8);                                   // ICMP type echo
    vnet_tx_yaz(35, 0 olarak dtam8);                                   // code
    vnet_tx_yaz(38, 190 olarak dtam8); vnet_tx_yaz(39, 239 olarak dtam8);   // id 0xBEEF
    vnet_tx_yaz(40, 0 olarak dtam8); vnet_tx_yaz(41, 1 olarak dtam8);       // seq 1
    vnet_tx_yaz(42, 75 olarak dtam8); vnet_tx_yaz(43, 69 olarak dtam8); vnet_tx_yaz(44, 77 olarak dtam8);   // "KEM"
    vnet_tx_yaz(45, 71 olarak dtam8); vnet_tx_yaz(46, 85 olarak dtam8);                                     // "GU"
    değişken ics: tam32 = vnet_tx_checksum(34, 13);   // ICMP checksum
    vnet_tx_yaz(36, ((ics >> 8) & 255) olarak dtam8); vnet_tx_yaz(37, (ics & 255) olarak dtam8);
    eğer vnet_gonder(base, 47) != 0 { ver 0; }                        // 14 eth + 20 ip + 13 icmp
    // --- 3) ICMP Echo Reply AL: proto=1 + type=0 + payload "KEMGU" ---
    deneme = 0;
    iken deneme < 24 {
        değişken n: tam32 = vnet_al(base, 8000000);
        eğer n >= 34 {
            eğer (vnet_rx_oku(12) == (8 olarak dtam8)) ve (vnet_rx_oku(13) == (0 olarak dtam8))
                ve (vnet_rx_oku(23) == (1 olarak dtam8)) ve (vnet_rx_oku(34) == (0 olarak dtam8)) {
                eğer (vnet_rx_oku(42) == (75 olarak dtam8)) ve (vnet_rx_oku(43) == (69 olarak dtam8))
                    ve (vnet_rx_oku(44) == (77 olarak dtam8)) ve (vnet_rx_oku(45) == (71 olarak dtam8))
                    ve (vnet_rx_oku(46) == (85 olarak dtam8)) {
                    ver 1;
                }
            }
        }
        deneme = deneme + 1;
    }
    ver 0;
}

işlev main() -> tam32 {
    // TÜM konsol çıktısı .kem-native UART sürücüsünden (uart_satir/uart_tam_satir) —
    // C kdl_yazdir_metin/tam ÇAĞRISI YOK (D-245, Faz-2a: eski yol silindi).
    uart_satir("=== KEMGU .kem-OS (Faz-2a: konsol cikti .kem-native UART) ===");

    // [1] BOOT — buraya ulaştıysak .kem bare-metal boot etti.
    uart_satir("[1] BOOT OK");

    // [2] HEAP — region-runtime dizi.
    değişken dt: tam32 = heap_dizi_topla();
    uart_satir("[2] HEAP DIZI OK");
    uart_tam_satir(dt);

    // [3] MMIO — donanım register.
    değişken magic: tam32 = mmio_magic_oku();
    eğer magic == MAGIC_BEKLENEN {
        uart_satir("[3] MMIO OK");
    } değilse {
        uart_satir("[3] MMIO HATA");
    }
    uart_tam_satir(magic);

    // [4] HESAP — kontrol-akışı + fonksiyon + pattern-match.
    değişken h: tam32 = faktoriyel(5) + fib(10) + dongu_toplam(10);   // 230
    değişken kat: tam32 = kategori(h);                                // 3
    değişken pm: tam32 = basamak_adi(2);                              // 300
    uart_satir("[4] HESAP OK");
    uart_tam_satir(h);
    uart_tam_satir(kat);

    // [5] SİSTEM — .kem panik + exc-handler-mantığı (D-247, Faz-2c entegrasyon).
    // exc handler'ı 3 sentetik fault ile SELF-TEST: ESR→EC decode + fault-türü + karar
    // mantığı .kem'de çalışır. Gerçek fault-yönlendirmesi (asm-vektör → .kem hook) SONRAKİ
    // adım; burada handler MANTIĞININ kem_os içinde çalıştığı kanıtlanır.
    uart_satir("[5] SISTEM: exc-handler self-test (3 sentetik fault)");
    değişken k1: tam32 = kem_istisna_isle(1073741824, 2516582404);  // data-abort+translation → KURTAR(1)
    değişken k2: tam32 = kem_istisna_isle(4096, 2449473549);        // data-abort+permission → OLDUR(2)
    değişken k3: tam32 = kem_istisna_isle(2147483648, 2214592512);  // instr-abort → HALT(3)
    değişken exc_ok: tam32 = 0;
    eğer (k1 == 1) ve (k2 == 2) ve (k3 == 3) {
        uart_satir("[5] EXC OK kararlar=1,2,3");
        exc_ok = 1;
    } değilse {
        uart_satir("[5] EXC HATA");
    }
    // [5b] GERÇEK FAULT (FAZ-A1 alt-hedef A, D-276): sentetik self-test'e EK olarak
    // GERÇEK vektör-bağlı data-abort. Haritasız 0x80000000 oku → .S kdl_exc_ortak
    // recovery (FAR→kdl_fault_yakalanan, ELR+=4, eret) → OS DEVAM. FAR==VA + kurtarıldı
    // doğrulanır. Taklit edilemez: MMU zorlamıyorsa okuma sessizce geçer → gate kırmızı.
    // kmmu_* fonksiyonları kem_mmu.kem'den gelir (build'de CAT → tek birim, çıplak→çıplak).
    değişken fault_ok: tam32 = kmmu_fault_testi();
    eğer fault_ok == 1 {
        uart_satir("[5] MMU FAULT OK");
    } değilse {
        uart_satir("[5] MMU FAULT HATA");
    }
    // [5c] MMU ÇEVİRİ (FAZ-A1 alt-hedef B, D-277): kdl_mmu_kur artık SAF-.kem (kem_mmu.kem,
    // .S boot çağırır; C guard'lı). Non-identity çeviri VA 0x50000000 → PA 0x46000000 alias
    // doğrula (çift-yönlü). MMU zaten .kem-kurulu boot etti (bu satıra ulaşmak = .kem MMU
    // çalışıyor); bu test çeviri-DOĞRULUĞUNU kanıtlar (identity olsaydı alias olmazdı).
    değişken ceviri_ok: tam32 = kmmu_ceviri_testi();
    eğer ceviri_ok == 1 {
        uart_satir("[5] MMU CEVIRI OK");
    } değilse {
        uart_satir("[5] MMU CEVIRI HATA");
    }
    // [5d] GERÇEK TRAP → .kem KARAR (FAZ-A2, D-278): gerçek data-abort'un ESR/FAR'ını mrs ile
    // oku + .kem kem_istisna_isle'a ver → handler GERÇEK syndrome'da karar veriyor (sentetik
    // self-test'e EK; "gerçek fault-yönlendirmesi" [5] notundaki "sonraki adım" kapanıyor).
    değişken trap_ok: tam32 = trap_gercek_testi();
    eğer trap_ok == 1 {
        uart_satir("[5] TRAP KARAR OK");
    } değilse {
        uart_satir("[5] TRAP KARAR HATA");
    }
    // [5e] TIMER-IRQ (FAZ-A3, D-279): GERÇEK periyodik timer IRQ. GIC + CNTV kur → IRQ aç →
    // tik yalnız .S kdl_irq_ortak→.kem kdl_irq_isle handler'ında artar. tik>=3 = gerçek IRQ
    // tetiklendi (guard'lı: timer bozuksa sonsuz-döngü yok). kem_zaman.kem sağlar (CAT).
    değişken timer_ok: tam32 = kem_timer_testi();
    eğer timer_ok == 1 {
        uart_satir("[5] TIMER TIK OK");
    } değilse {
        uart_satir("[5] TIMER TIK HATA");
    }
    // [5f] PREEMPTIVE görev (FAZ-A4, D-280): 2 görev kur + preemption aç → timer-IRQ
    // round-robin context-switch → her iki görev sayacı ilerler (interleave). .kem
    // kem_preempt scheduler + sentetik trap-frame; .S kdl_irq_ortak SP-swap (değişmez).
    // Sonra preemption kapatılır → main [6..10]'a devam. kem_gorev.kem sağlar (CAT).
    değişken preempt_ok: tam32 = kem_preempt_testi();
    eğer preempt_ok == 1 {
        uart_satir("[5] PREEMPT OK");
    } değilse {
        uart_satir("[5] PREEMPT HATA");
    }
    // [5g] EL0 SYSCALL (FAZ-A5, D-281): EL0 (unprivileged) görev → SVC → .kem kdl_syscall_isle.
    // Runtime-yazılan EL0 stub (AP=01 sayfa) preemptive görev olarak koşar, svc num=7 →
    // .S kdl_exc_ortak (EC=0x15) → .kem handler sayaç++. Sayaç ilerliyorsa GERÇEK EL0'dan
    // syscall (privilege sınırı geçildi + saf-.kem handler). kem_gorev.kem sağlar (CAT).
    değişken el0_ok: tam32 = kem_el0_testi();
    eğer el0_ok == 1 {
        uart_satir("[5] EL0 SYSCALL OK");
    } değilse {
        uart_satir("[5] EL0 SYSCALL HATA");
    }

    // [6] DISK — saf-.kem virtio-blk GERÇEK blok I/O (D-271, FAZ B1). Additive: çekirdek
    // [1..5] gate'ini (gecti==6) ETKİLEMEZ → disksiz boot hâlâ KEM-OS OK verir. Diskli
    // gate ayrıca "DISK RW OK" bekler (gerçek sektör yaz→oku→eşleşme, sentetik değil).
    değişken disk_ok: tam32 = disk_rw_testi();
    eğer disk_ok == 1 {
        uart_satir("[6] DISK RW OK");
    } değilse {
        uart_satir("[6] DISK YOK/HATA (disksiz boot normal)");
    }

    // [7] FS — saf-.kem minifs virtio-blk üstünde (FAZ-B2). Additive: çekirdek gate'i ETKİLEMEZ.
    değişken fs_ok: tam32 = fs_rw_testi();
    eğer fs_ok == 1 {
        uart_satir("[7] FS RW OK");
    } değilse {
        uart_satir("[7] FS YOK/HATA (disksiz boot normal)");
    }

    // [8] NET DEV — saf-.kem virtio-net cihaz bringup (FAZ-C). Additive.
    değişken net_ok: tam32 = net_dev_testi();
    eğer net_ok == 1 {
        uart_satir("[8] NET DEV OK");
    } değilse {
        uart_satir("[8] NET YOK/HATA (netsiz boot normal)");
    }

    // [9] NET ARP — saf-.kem GERÇEK ağ round-trip (ARP request→SLIRP reply). Additive.
    değişken arp_ok: tam32 = net_arp_testi();
    eğer arp_ok == 1 {
        uart_satir("[9] NET ARP OK");
    } değilse {
        uart_satir("[9] NET ARP YOK (netsiz/yanıtsız boot normal)");
    }

    // [10] PING — saf-.kem GERÇEK ICMP echo round-trip (ARP+IPv4+ICMP+checksum). Additive.
    değişken ping_ok: tam32 = net_icmp_testi();
    eğer ping_ok == 1 {
        uart_satir("[10] PING CANLI");
    } değilse {
        uart_satir("[10] PING YOK (netsiz/yanıtsız boot normal)");
    }

    // Entegrasyon doğrulaması — BEŞ alt-sistem de doğru mu (6 kontrol: heap+mmio+hesap×3+exc)?
    değişken gecti: tam32 = 0;
    eğer dt == 55 {
        gecti = gecti + 1;
    }
    eğer magic == MAGIC_BEKLENEN {
        gecti = gecti + 1;
    }
    eğer h == 230 {
        gecti = gecti + 1;
    }
    eğer kat == 3 {
        gecti = gecti + 1;
    }
    eğer pm == 300 {
        gecti = gecti + 1;
    }
    eğer exc_ok == 1 {
        gecti = gecti + 1;
    }

    // Başarı → KEM-OS OK; herhangi bir alt-sistem arızası → .kem PANİK (halt).
    // (Happy-path'te gecti==6 → panik TETİKLENMEZ; panik gerçek arıza-yolu handler'ı.)
    eğer gecti == 6 {
        uart_satir("KEMGU KEM-OS OK");
    } değilse {
        panik("KEM-OS ALT-SISTEM ARIZASI");
    }
    ver 0;
}
