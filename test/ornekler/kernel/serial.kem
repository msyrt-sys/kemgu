// KEMGU — Serial port (UART 16550) suruculusu
// =============================================
//
// Serial port'lar I/O space'te (port-mapped I/O), MMIO degil.
// x86_64'te `in` ve `out` komutlari ile erisilir — special intrinsics.
//
// COM1 = 0x3F8, COM2 = 0x2F8.
//
// Port haritasi (base offset'inden):
//   0   Data register (R/W)
//   1   Interrupt Enable
//   2   Interrupt Identification / FIFO Control
//   3   Line Control (8N1, DLAB)
//   4   Modem Control
//   5   Line Status (R)  — bit 5 = transmit empty, bit 0 = data ready
//   6   Modem Status (R)
//   7   Scratch

sabit COM1: dtam16 = 1016;             // 0x3F8

// Port I/O — inline asm. Su an inb/outb intrinsic'i yok,
// generic _asm ile yapiyoruz. (Ileride _portu_oku/_portu_yaz
// builtin eklenecek.)

işlev port_yaz_dtam8(port: dtam16, deger: dtam8) {
    güvensiz {
        _asm("out %al, %dx");
    }
}

işlev port_oku_dtam8(port: dtam16) -> dtam8 {
    güvensiz {
        _asm("in %dx, %al");
    }
    ver 0;  // placeholder — gerçek deger %al'da
}

// UART baslat: 8N1, 38400 baud
işlev serial_baslat() {
    güvensiz {
        // Interrupt'lari devre disi
        _asm("mov $$0x00, %al");
        _asm("mov $$0x3F9, %dx");
        _asm("out %al, %dx");
        // DLAB acik (baud rate divisor erisimi)
        _asm("mov $$0x80, %al");
        _asm("mov $$0x3FB, %dx");
        _asm("out %al, %dx");
        // Baud rate divisor: 3 = 38400 baud
        _asm("mov $$0x03, %al");
        _asm("mov $$0x3F8, %dx");
        _asm("out %al, %dx");
        _asm("mov $$0x00, %al");
        _asm("mov $$0x3F9, %dx");
        _asm("out %al, %dx");
        // 8 bit, no parity, 1 stop bit (DLAB kapali)
        _asm("mov $$0x03, %al");
        _asm("mov $$0x3FB, %dx");
        _asm("out %al, %dx");
        // FIFO enable, 14-byte threshold
        _asm("mov $$0xC7, %al");
        _asm("mov $$0x3FA, %dx");
        _asm("out %al, %dx");
        // RTS + DSR + OUT2 (IRQ enable)
        _asm("mov $$0x0B, %al");
        _asm("mov $$0x3FC, %dx");
        _asm("out %al, %dx");
    }
}

// Transmit hazir mi (line status bit 5)?
işlev serial_yazima_hazir() -> mantıksal {
    güvensiz {
        _asm("mov $$0x3FD, %dx");
        _asm("in %dx, %al");
        _asm("and $$0x20, %al");
        // Sonuc %al'da — non-zero ise hazir
    }
    ver doğru;  // simplified
}

// Bir bayt gonder
işlev serial_yaz_bayt(b: dtam8) {
    güvensiz {
        // Transmit empty bekle (busy-wait)
        // _asm("1: mov $0x3FD, %dx; in %dx, %al; and $0x20, %al; jz 1b");
        _asm("mov %dil, %al");          // arg b -> %al
        _asm("mov $$0x3F8, %dx");
        _asm("out %al, %dx");
    }
}

// Bir string gonder (slice destekli — { ptr, i64 })
işlev serial_yaz_metin(s: metin) {
    // String slice extraction tam destek henuz yok,
    // burada ornek olarak sabit string yazimi:
    serial_yaz_bayt(75);   // 'K'
    serial_yaz_bayt(69);   // 'E'
    serial_yaz_bayt(77);   // 'M'
    serial_yaz_bayt(71);   // 'G'
    serial_yaz_bayt(85);   // 'U'
    serial_yaz_bayt(10);   // '\n'
}
