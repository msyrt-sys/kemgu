// Kabuk ve C1 süreçlerinin ortak bağlama, yol, FAT32 ve blok sınırı.
kullan drivers::fs::fat32_sektor::{ FatOkumaParcasi, fat_sektor_bilgi, fat_sektor_okuma_plani };

işlev kv_bilgi(d: &değişken KabukDisk,y: KabukYol,f: &değişken FatSektor) -> sonuç<DizinGirdisi,metin> {
    değişken k: KabukBag = dizi_al(d.baglar,y.indeks);
    değişken i: tam32 = 0;
    iken i < 257 {
        eşleş fat_sektor_bilgi(f,y.yol) {
            tamam(v) => { ver tamam(v); }
            hata(e) => { eğer f.gerekli == 0 { ver hata(e); } }
        }
        eşleş kd_doldur(d,k,f) { hata(e) => { ver hata(e); } tamam(v) => { } }
        i=i+1;
    }
    ver hata("sektor tekrar siniri");
}
işlev kv_parcalar(d: &değişken KabukDisk,k: KabukBag,f: &değişken FatSektor,g: DizinGirdisi,ofs: tam64,n: tam32) -> sonuç<Dizi<FatOkumaParcasi>,metin> {
    değişken i: tam32 = 0;
    iken i < 257 {
        eşleş fat_sektor_okuma_plani(f,g,ofs,n) {
            tamam(v) => { ver tamam(v); }
            hata(e) => { eğer f.gerekli == 0 { ver hata(e); } }
        }
        eşleş kd_doldur(d,k,f) { hata(e) => { ver hata(e); } tamam(v) => { } }
        i=i+1;
    }
    ver hata("fat plan tekrar siniri");
}
işlev kv_aralik(d: &değişken KabukDisk,y: KabukYol,f: &değişken FatSektor,g: DizinGirdisi,ofs: tam64,n: tam32) -> sonuç<Dizi<dtam8>,metin> {
    değişken k: KabukBag = dizi_al(d.baglar,y.indeks);
    eğer k.kesik { ver hata("FAT32 kesik yazma; kirli bayrak korundu"); }
    eşleş kv_parcalar(d,k,f,g,ofs,n) { hata(e) => { ver hata(e); } tamam(ps) => {
        değişken out: Dizi<dtam8> = [];
        için p: ps {
            eğer p.lba < 0 veya p.lba >= k.bpb.toplam_sektor veya (p.sektor olarak tam64) > k.bpb.toplam_sektor-p.lba {
                ver hata("bolum disi okuma");
            }
            eşleş kd_oku(d,k.indeks,k.bolum.bas+p.lba,p.sektor) { hata(e) => { ver hata(e); } tamam(b) => {
                değişken i: tam32 = 0;
                iken i < p.bayt {
                    dizi_ekle(out,(oku_u8(b,p.bas+i)&255) olarak dtam8);
                    i=i+1;
                }
            } }
        }
        ver tamam(out);
    } }
}
işlev kv_tum(d: &değişken KabukDisk,y: KabukYol,azami: tam32) -> sonuç<Dizi<dtam8>,metin> {
    eşleş kd_fat(d,y) { hata(e) => { ver hata(e); } tamam(fat) => {
        değişken f: FatSektor = fat;
        eşleş kv_bilgi(d,y,&değişken f) { hata(e) => { ver hata(e); } tamam(g) => {
            eğer g.dizin_mi { ver hata("dosya degil"); }
            eğer g.boyut > (azami olarak tam64) { ver hata("dosya siniri"); }
            ver kv_aralik(d,y,&değişken f,g,0,g.boyut olarak tam32);
        } }
    } }
}

// Yalnız kullanıcı komutu süresince canlıdır. Kabuk disk tablosunu paylaşır,
// konum ve çalışma dizini süreç kopyasındadır.
sabit KX_SIS_BORU: tam64 = 69;
sabit KX_SIS_BASLAT_ESLEMELI: tam64 = 70;
sabit KX_SIS_AC: tam64 = 41;
sabit KX_SIS_KAPAT: tam64 = 42;
sabit KX_SIS_OKU: tam64 = 43;
sabit KX_SIS_KONUMLA: tam64 = 45;
sabit KX_SIS_BILGI: tam64 = 46;
sabit KX_SIS_DIZIN_OKU: tam64 = 47;
sabit KX_SIS_OLUSTUR_DIZIN: tam64 = 48;
sabit KX_SIS_SIL: tam64 = 49;
sabit KX_SIS_SIL_DIZIN: tam64 = 50;
sabit KX_SIS_YENIDEN_ADLANDIR: tam64 = 51;
sabit KX_SIS_CALISMA_DIZINI_AL: tam64 = 52;
sabit KX_SIS_CALISMA_DIZINI_DEGISTIR: tam64 = 53;
sabit KX_SIS_ESITLE: tam64 = 54;
sabit KX_SIS_TUS_BEKLE: tam64 = 55;
sabit KX_SIS_SAAT: tam64 = 56;
sabit KX_SIS_UYU: tam64 = 57;
sabit KX_SIS_BASLAT: tam64 = 58;
sabit KX_SIS_BEKLE: tam64 = 59;
sabit KX_SIS_SUREC_LISTESI: tam64 = 60;
sabit KX_SIS_EKRAN_BILGI: tam64 = 61;
sabit KX_SIS_EKRAN_YAZ: tam64 = 62;
sabit KX_SIS_EKRAN_TEMIZLE: tam64 = 63;
sabit KX_SIS_IMLEC: tam64 = 64;
sabit KX_SIS_PIKSEL_SATIRI: tam64 = 68;
sabit KX_SIS_ONPLAN_BASLAT: tam64 = 67;
sabit KX_SIS_FARE_BEKLE: tam64 = 65;
sabit KX_SIS_OLAY_BEKLE: tam64 = 66;
sabit KX_HATA_IO: tam64 = 5;
sabit KX_HATA_NOENT: tam64 = 2;
sabit KX_HATA_ISDIR: tam64 = 21;
sabit KX_HATA_MFILE: tam64 = 24;
sabit KX_HATA_EXIST: tam64 = 17;
sabit KX_HATA_XDEV: tam64 = 18;
sabit KX_HATA_NOTDIR: tam64 = 20;
sabit KX_HATA_FBIG: tam64 = 27;
sabit KX_HATA_NOSPC: tam64 = 28;
sabit KX_HATA_ROFS: tam64 = 30;
sabit KX_HATA_RANGE: tam64 = 34;
sabit KX_HATA_NOTEMPTY: tam64 = 39;
sabit KSV_YAZ: tam64 = 1;
sabit KSV_OLUSTUR: tam64 = 2;
sabit KSV_SONA: tam64 = 4;
sabit KSV_KES: tam64 = 8;
sabit KSV_DIZIN: tam64 = 16;
sabit KSV_FD_AZAMI: tam32 = 16;

yapı KsvFd { acik: mantıksal; yol: KabukYol; kip: tam64; konum: tam64; }
yapı KsvBaglam {
    disk: KabukDisk; fds: Dizi<KsvFd>; kabuk_cwd: metin; degisti: mantıksal;
    x: XhciDurum; xb: tam64; klavye_indeksi: tam32; h: HidKlavye; tr: KlavyeDurumu;
    olaylar: Dizi<TusHamOlay>; olay_konum: tam32; ilk_tus: mantıksal; fare_durum: FareDurumu; olay_maskesi: tam64; son_tik: tam64; bekleme_kurulu: mantıksal;
}
küresel değişken ksv_baglam_adresi: tam64 = 0;

çıplak işlev ksv_fd_bos() -> KsvFd {
    ver KsvFd {acik:yanlış,yol:KabukYol {indeks:0,yol:""},kip:0,konum:0};
}
işlev ksv_fd_tablo() -> Dizi<KsvFd> {
    değişken fds: Dizi<KsvFd> = [];
    değişken i: tam32 = 0;
    iken i < KSV_FD_AZAMI { dizi_ekle(fds,ksv_fd_bos()); i=i+1; }
    ver fds;
}
işlev ksv_fd_gecerli(b: &değişken KsvBaglam, fd: tam64) -> mantıksal {
    eğer fd < 0 veya fd >= (KSV_FD_AZAMI olarak tam64) { ver yanlış; }
    değişken k: KsvFd = dizi_al(b.fds,fd olarak tam32);
    ver k.acik;
}
işlev ksv_fd_yuva(b: &değişken KsvBaglam) -> tam32 {
    değişken i: tam32 = 3;
    iken i < KSV_FD_AZAMI {
        değişken k: KsvFd = dizi_al(b.fds,i);
        eğer değil k.acik { ver i; }
        i=i+1;
    }
    ver -1;
}
çıplak işlev ksv_metin(p: tam64) -> metin {
    değişken a: *metin = (&p) olarak *metin;
    ver *a;
}
işlev ksv_hata(e: metin) -> tam64 {
    eğer bm_esit(e,"bulunamadi") veya bm_esit(e,"baglama bulunamadi") { ver 0-KX_HATA_NOENT; }
    eğer bm_esit(e,"dosya degil") { ver 0-KX_HATA_ISDIR; }
    eğer bm_esit(e,"uzun bilesen") { ver 0-36; }
    eğer bm_esit(e,"dizin degil") { ver 0-KX_HATA_NOTDIR; }
    eğer bm_esit(e,"var") { ver 0-KX_HATA_EXIST; }
    eğer bm_esit(e,"disk dolu") { ver 0-KX_HATA_NOSPC; }
    eğer bm_esit(e,"dizin bos degil") { ver 0-KX_HATA_NOTEMPTY; }
    eğer bm_esit(e,"dosya siniri") { ver 0-KX_HATA_FBIG; }
    eğer bm_esit(e,"bolum salt okunur") veya bm_esit(e,"ESP salt okunur")
            veya bm_esit(e,"acilis bolumu bilinmiyor; kok salt okunur") { ver 0-KX_HATA_ROFS; }
    ver 0-KX_HATA_IO;
}
işlev ksv_mutlak(b: &değişken KsvBaglam,p: tam64,son: &değişken metin) -> tam64 {
    değişken boy: tam64 = kxs_dize_boyu(p,4096);
    eğer boy < 0 { ver boy; }
    eğer boy == 0 { ver 0-KX_HATA_NOENT; }
    eşleş kd_mutlak(b.disk.cwd,ksv_metin(p)) {
        hata(e) => { ver ksv_hata(e); }
        tamam(v) => {
            eğer metin_uzunluk(v) >= 4096 { ver 0-36; }
            güvensiz { *son=v; } ver 0;
        }
    }
}
işlev ksv_yol(b: &değişken KsvBaglam,p: tam64,y: &değişken KabukYol) -> tam64 {
    değişken m: metin = "";
    değişken r: tam64 = ksv_mutlak(b,p,&değişken m);
    eğer r < 0 { ver r; }
    eşleş kd_yol(&değişken b.disk,m) {
        hata(e) => { ver ksv_hata(e); }
        tamam(v) => { güvensiz { *y=v; } ver 0; }
    }
}
// Bağlama dizini VFS'de üretilir. Negatif indeks FAT sürücüsüne geçmez.
işlev ksv_sanal_girdi(ad: metin) -> DizinGirdisi {
    ver DizinGirdisi {ad:ad,ozellik:16,ilk_kume:0,boyut:0,dizin_mi:doğru,tarih:0,saat:0};
}
işlev ksv_yoldan_bilgi(b: &değişken KsvBaglam,y: KabukYol) -> sonuç<DizinGirdisi,metin> {
    eşleş kd_fat(&değişken b.disk,y) { hata(e) => { ver hata(e); } tamam(fat) => {
        değişken f: FatSektor = fat;
        ver kv_bilgi(&değişken b.disk,y,&değişken f);
    } }
}
işlev ksv_mutasyon(b: &değişken KsvBaglam,y: KabukYol,islem: FatYazIslem) -> tam64 {
    // Hata halinde de kirli/kesik durumunu kapatma yoluna taşı.
    b.degisti=doğru;
    eşleş kd_mutasyon(&değişken b.disk,y,islem) {
        hata(e) => { ver ksv_hata(e); }
        tamam(v) => { ver 0; }
    }
}
işlev ksv_ac(b: &değişken KsvBaglam,p: tam64,kip: tam64) -> tam64 {
    eğer kip < 0 veya kip > 31 veya ((kip&14) != 0 ve (kip&KSV_YAZ) == 0)
         veya ((kip&KSV_DIZIN) != 0 ve kip != KSV_DIZIN) { ver 0-KX_HATA_INVAL; }
    değişken fd: tam32 = ksv_fd_yuva(b);
    eğer fd < 0 { ver 0-KX_HATA_MFILE; }
    değişken mutlak: metin = "";
    eğer kip == KSV_DIZIN {
        değişken rr: tam64 = ksv_mutlak(b,p,&değişken mutlak); eğer rr < 0 { ver rr; }
        eğer bm_esit(mutlak,"/diskler") veya (bm_esit(mutlak,"/") ve b.disk.kok < 0) {
            dizi_yaz(b.fds,fd,KsvFd {acik:doğru,yol:KabukYol {indeks:-2,yol:mutlak},kip:kip,konum:0}); ver fd olarak tam64;
        }
    }
    değişken y: KabukYol = KabukYol {indeks:0,yol:""};
    değişken r: tam64 = ksv_yol(b,p,&değişken y);
    eğer r < 0 { ver r; }
    ver ksv_dosya_ac(b,fd,y,kip);
}
işlev ksv_dosya_ac(b: &değişken KsvBaglam,fd: tam32,y: KabukYol,kip: tam64) -> tam64 {
    değişken r: tam64 = 0;
    eğer (kip&KSV_YAZ) != 0 {
        eşleş kd_yazma_izni(&değişken b.disk,y) { hata(e) => { ver ksv_hata(e); } tamam(v) => { } }
    }
    değişken boy: tam64 = 0;
    eşleş ksv_yoldan_bilgi(b,y) {
        hata(e) => {
            eğer (kip&KSV_OLUSTUR) == 0 veya değil bm_esit(e,"bulunamadi") { ver ksv_hata(e); }
            değişken bos: Dizi<dtam8> = [];
            r=ksv_mutasyon(b,y,FatYazIslem::Yaz(bos));
            eğer r < 0 { ver r; }
        }
        tamam(g) => {
            eğer g.dizin_mi ve kip != KSV_DIZIN { ver 0-KX_HATA_ISDIR; }
            eğer değil g.dizin_mi ve kip == KSV_DIZIN { ver 0-KX_HATA_NOTDIR; }
            boy=g.boyut;
            eğer (kip&KSV_KES) != 0 {
                değişken bos: Dizi<dtam8> = [];
                r=ksv_mutasyon(b,y,FatYazIslem::Degistir(bos));
                eğer r < 0 { ver r; }
                boy=0;
            }
        }
    }
    eğer (kip&KSV_SONA) == 0 { boy=0; }
    dizi_yaz(b.fds,fd,KsvFd {acik:doğru,yol:y,kip:kip,konum:boy});
    ver fd olarak tam64;
}
// Her yuvada baş, doluluk, okur ve yazar sayıları ile 4096 bayt vardır.
// Tek çekirdekte syscall ve planlayıcı aynı anda bir yuvayı güncellemez.
sabit KB_BOY: tam64 = 4096;
küresel değişken kb_havuz: tam64 = 0;
çıplak işlev kb_yeni() -> tam64 {
    eğer kb_havuz == 0 {
        kb_havuz=malloc(8*4128) olarak tam64;
        eğer kb_havuz == 0 { ver 0; }
        memset(kb_havuz olarak *tam8,0,8*4128);
    }
    değişken i: tam64 = 0;
    iken i < 8 {
        değişken p: tam64 = kb_havuz+i*4128;
        eğer kxm_o64(p+16) == 0 ve kxm_o64(p+24) == 0 {
            kxm_y64(p,0); kxm_y64(p+8,0); ver p;
        } i=i+1;
    } ver 0;
}
çıplak işlev kb_uc(p: tam64,yaz: mantıksal) -> KsvFd {
    değişken indeks: tam32 = -3; değişken kip: tam64 = 0;
    eğer yaz { indeks=-4; kip=1; }
    değişken sayac: tam64 = p+16+kip*8;
    kxm_y64(sayac,kxm_o64(sayac)+1);
    ver KsvFd {acik:doğru,yol:KabukYol {indeks:indeks,yol:""},kip:kip,konum:p};
}
çıplak işlev kb_birak(f: KsvFd) {
    eğer f.acik ve (f.yol.indeks == -3 veya f.yol.indeks == -4) {
        değişken sayac: tam64 = f.konum+16+8*f.kip;
        kxm_y64(sayac,kxm_o64(sayac)-1);
    }
}
işlev kb_aktar(f: KsvFd,fd: tam64,adres: tam64,n: tam64,yaz: mantıksal) -> tam64 {
    eğer n < 0 veya n > 16384 veya (yaz ve n > KB_BOY) { ver -22; }
    eğer n == 0 { ver 0; }
    eğer değil kxs_aralik(adres,n,değil yaz) { ver -14; }
    değişken p: tam64 = f.konum; değişken bas: tam64 = kxm_o64(p); değişken dolu: tam64 = kxm_o64(p+8);
    değişken adet: tam64 = n;
    eğer yaz {
        eğer f.yol.indeks != -4 { ver -9; }
        eğer kxm_o64(p+16) == 0 { ver -32; }
        eğer n > KB_BOY-dolu { ver kxs_beklet(KXS_BORU_BEKLIYOR,fd+16*n,44); }
    } değilse {
        eğer f.yol.indeks != -3 { ver -9; }
        eğer dolu == 0 {
            eğer kxm_o64(p+24) == 0 { ver 0; }
            ver kxs_beklet(KXS_BORU_BEKLIYOR,fd,43);
        }
        eğer adet > dolu { adet=dolu; }
    }
    değişken i: tam64 = 0;
    iken i < adet {
        eğer yaz { kis_buf_yaz8(p+32,((bas+dolu+i)%KB_BOY) olarak tam32,kis_buf_oku8(adres,i olarak tam32)); }
        değilse { kis_buf_yaz8(adres,i olarak tam32,kis_buf_oku8(p+32,((bas+i)%KB_BOY) olarak tam32)); }
        i=i+1;
    }
    eğer yaz { kxm_y64(p+8,dolu+adet); }
    değilse { kxm_y64(p,(bas+adet)%KB_BOY); kxm_y64(p+8,dolu-adet); }
    ver adet;
}
çıplak işlev kb_hazir(b: &KsvBaglam,olay: tam64) -> mantıksal {
    değişken fd: KsvFd = dizi_al(b.fds,(olay%16) olarak tam32);
    eğer değil fd.acik { ver doğru; }
    değişken p: tam64 = fd.konum;
    eğer fd.yol.indeks == -3 { ver kxm_o64(p+8) != 0 veya kxm_o64(p+24) == 0; }
    eğer fd.yol.indeks == -4 { ver KB_BOY-kxm_o64(p+8) >= olay/16 veya kxm_o64(p+16) == 0; }
    ver doğru;
}
işlev kb_ac(b: &değişken KsvBaglam,adres: tam64) -> tam64 {
    eğer değil kxs_aralik(adres,16,doğru) { ver -14; }
    değişken i: tam32 = ksv_fd_yuva(b); eğer i < 0 { ver -24; }
    değişken j: tam32 = i+1;
    iken j < KSV_FD_AZAMI ve dizi_al(b.fds,j).acik { j=j+1; }
    eğer j == KSV_FD_AZAMI { ver -24; }
    değişken p: tam64 = kb_yeni(); eğer p == 0 { ver -23; }
    dizi_yaz(b.fds,i,kb_uc(p,yanlış)); dizi_yaz(b.fds,j,kb_uc(p,doğru));
    kxm_y64(adres,i olarak tam64); kxm_y64(adres+8,j olarak tam64); ver 0;
}

işlev ksv_oku(b: &değişken KsvBaglam,fd: tam64,p: tam64,n: tam64) -> tam64 {
    eğer fd >= 0 ve fd < (KSV_FD_AZAMI olarak tam64) {
        değişken f: KsvFd = dizi_al(b.fds,fd olarak tam32);
        eğer f.acik ve (f.yol.indeks == -3 veya f.yol.indeks == -4) { ver kb_aktar(f,fd,p,n,yanlış); }
    }
    eğer değil ksv_fd_gecerli(b,fd) { ver 0-KX_HATA_BADF; }
    eğer n < 0 veya n > 16384 { ver 0-KX_HATA_INVAL; }
    eğer n == 0 { ver 0; }
    eğer değil kxs_aralik(p,n,doğru) { ver 0-KX_HATA_FAULT; }
    değişken i: tam32 = fd olarak tam32;
    değişken a: KsvFd = dizi_al(b.fds,i);
    eğer a.kip == KSV_DIZIN { ver 0-KX_HATA_ISDIR; }
    eşleş kd_fat(&değişken b.disk,a.yol) { hata(e) => { ver ksv_hata(e); } tamam(fat) => {
        değişken f: FatSektor = fat;
        eşleş kv_bilgi(&değişken b.disk,a.yol,&değişken f) { hata(e) => { ver ksv_hata(e); } tamam(g) => {
        eşleş kv_aralik(&değişken b.disk,a.yol,&değişken f,g,a.konum,n olarak tam32) {
            hata(e) => { ver ksv_hata(e); }
            tamam(v) => {
                değişken j: tam32 = 0;
                iken j < dizi_boyut(v) { kis_buf_yaz8(p,j,oku_u8(v,j)); j=j+1; }
                a.konum=a.konum+(j olarak tam64);
                dizi_yaz(b.fds,i,a);
                ver j olarak tam64;
            }
        }
        } }
    } }
}
işlev ksv_yaz(b: &değişken KsvBaglam,fd: tam64,p: tam64,n: tam64) -> tam64 {
    eğer fd >= 0 ve fd < (KSV_FD_AZAMI olarak tam64) {
        değişken f: KsvFd = dizi_al(b.fds,fd olarak tam32);
        eğer f.acik ve (f.yol.indeks == -3 veya f.yol.indeks == -4) { ver kb_aktar(f,fd,p,n,doğru); }
        eğer değil f.acik ve (fd == 1 veya fd == 2) { ver kxs_konsol_yaz(fd,p,n); }
    }
    eğer değil ksv_fd_gecerli(b,fd) { ver 0-KX_HATA_BADF; }
    eğer n < 0 veya n > 4096 { ver 0-KX_HATA_INVAL; }
    değişken i: tam32 = fd olarak tam32;
    değişken a: KsvFd = dizi_al(b.fds,i);
    eğer (a.kip&KSV_YAZ) == 0 { ver 0-KX_HATA_BADF; }
    eğer n == 0 { ver 0; }
    eğer değil kxs_aralik(p,n,yanlış) { ver 0-KX_HATA_FAULT; }
    eşleş kd_yazma_izni(&değişken b.disk,a.yol) { hata(e) => { ver ksv_hata(e); } tamam(v) => { } }
    eşleş kv_tum(&değişken b.disk,a.yol,65536) { hata(e) => { ver ksv_hata(e); } tamam(eski) => {
        değişken konum: tam64 = a.konum;
        eğer (a.kip&KSV_SONA) != 0 { konum=dizi_boyut(eski) olarak tam64; }
        eğer konum > 65536-n { ver 0-KX_HATA_FBIG; }
        değişken son: tam32 = (konum+n) olarak tam32;
        değişken elde: tam32 = dizi_boyut(eski);
        eğer elde > son { son=elde; }
        değişken veri: Dizi<dtam8> = bayt_sifir(son);
        değişken j: tam32 = 0;
        iken j < elde { yaz_u8(veri,j,oku_u8(eski,j) olarak tam64); j=j+1; }
        j=0;
        iken (j olarak tam64) < n {
            yaz_u8(veri,(konum olarak tam32)+j,kis_buf_oku8(p,j) olarak tam64); j=j+1;
        }
        değişken r: tam64 = ksv_mutasyon(b,a.yol,FatYazIslem::Degistir(veri));
        eğer r < 0 { ver r; }
        a.konum=konum+n;
        dizi_yaz(b.fds,i,a);
        ver n;
    } }
}
işlev ksv_konumla(b: &değişken KsvBaglam,fd: tam64,ofset: tam64,nereden: tam64) -> tam64 {
    eğer değil ksv_fd_gecerli(b,fd) { ver 0-KX_HATA_BADF; }
    değişken i: tam32 = fd olarak tam32;
    değişken a: KsvFd = dizi_al(b.fds,i);
    eğer a.yol.indeks < -2 { ver -29; }
    eğer a.kip == KSV_DIZIN veya nereden < 0 veya nereden > 2 { ver 0-KX_HATA_INVAL; }
    değişken bas: tam64 = 0;
    eğer nereden == 1 { bas=a.konum; }
    eğer nereden == 2 {
        eşleş ksv_yoldan_bilgi(b,a.yol) { hata(e) => { ver ksv_hata(e); } tamam(g) => { bas=g.boyut; } }
    }
    eğer ofset < 0-bas veya ofset > 4294967295-bas { ver 0-KX_HATA_INVAL; }
    a.konum=bas+ofset;
    dizi_yaz(b.fds,i,a);
    ver a.konum;
}
işlev ksv_bilgi(b: &değişken KsvBaglam,p: tam64,out: tam64) -> tam64 {
    eğer değil kxs_aralik(out,32,doğru) { ver 0-KX_HATA_FAULT; }
    değişken m: metin = ""; değişken rr: tam64 = ksv_mutlak(b,p,&değişken m);
    eğer rr < 0 { ver rr; }
    eğer bm_esit(m,"/diskler") veya bm_esit(m,"/") {
        kxm_y64(out,0); kxm_y64(out+8,1); kxm_y64(out+16,0); kxm_y64(out+24,0); ver 0;
    }
    değişken y: KabukYol = KabukYol {indeks:0,yol:""};
    değişken r: tam64 = ksv_yol(b,p,&değişken y);
    eğer r < 0 { ver r; }
    eşleş ksv_yoldan_bilgi(b,y) { hata(e) => { ver ksv_hata(e); } tamam(g) => {
        değişken tur: tam64 = 0;
        eğer g.dizin_mi { tur=1; }
        kxm_y64(out,g.boyut); kxm_y64(out+8,tur);
        kxm_y64(out+16,g.tarih olarak tam64); kxm_y64(out+24,g.saat olarak tam64);
        ver 0;
    } }
}
işlev ksv_dizin_kopyala(b: &değişken KsvBaglam,fd: tam32,p: tam64,n: tam32,xs: Dizi<DizinGirdisi>) -> tam64 {
    değişken a: KsvFd = dizi_al(b.fds,fd);
    değişken i: tam32 = a.konum olarak tam32;
    değişken yazilan: tam32 = 0;
    iken i < dizi_boyut(xs) {
        değişken g: DizinGirdisi = dizi_al(xs,i);
        eğer değil bm_esit(g.ad,".") ve değil bm_esit(g.ad,"..") {
            değişken boy: tam32 = metin_uzunluk(g.ad);
            değişken ek: tam32 = 1;
            eğer g.dizin_mi { ek=2; }
            eğer boy+ek > n-yazilan {
                eğer yazilan == 0 { ver 0-KX_HATA_RANGE; }
                a.konum=i olarak tam64; dizi_yaz(b.fds,fd,a);
                ver yazilan olarak tam64;
            }
            değişken j: tam32 = 0;
            iken j < boy { kis_buf_yaz8(p,yazilan+j,metin_bayt(g.ad,j) olarak tam32); j=j+1; }
            yazilan=yazilan+boy;
            eğer g.dizin_mi { kis_buf_yaz8(p,yazilan,47); yazilan=yazilan+1; }
            kis_buf_yaz8(p,yazilan,10); yazilan=yazilan+1;
        }
        i=i+1;
    }
    a.konum=i olarak tam64; dizi_yaz(b.fds,fd,a);
    ver yazilan olarak tam64;
}
işlev ksv_dizin_oku(b: &değişken KsvBaglam,fd: tam64,p: tam64,n: tam64) -> tam64 {
    eğer değil ksv_fd_gecerli(b,fd) { ver 0-KX_HATA_BADF; }
    eğer n < 1 veya n > 4096 { ver 0-KX_HATA_INVAL; }
    eğer değil kxs_aralik(p,n,doğru) { ver 0-KX_HATA_FAULT; }
    değişken a: KsvFd = dizi_al(b.fds,fd olarak tam32);
    eğer a.kip != KSV_DIZIN { ver 0-KX_HATA_NOTDIR; }
    eğer a.yol.indeks == -2 {
        değişken xs: Dizi<DizinGirdisi> = [];
        eğer bm_esit(a.yol.yol,"/") { dizi_ekle(xs,ksv_sanal_girdi("diskler")); }
        değilse { için k: b.disk.baglar { eğer kd_hub_bagli(&değişken b.disk,k.indeks) {
            değişken ad: metin = k.kayit.ad;
            dizi_ekle(xs,ksv_sanal_girdi(metin_kes(ad,9,metin_uzunluk(ad)-9)));
        } } }
        ver ksv_dizin_kopyala(b,fd olarak tam32,p,n olarak tam32,xs);
    }
    eşleş kd_fat(&değişken b.disk,a.yol) { hata(e) => { ver ksv_hata(e); } tamam(fat) => {
        değişken f: FatSektor = fat;
        eşleş kd_liste(&değişken b.disk,a.yol,&değişken f) {
            hata(e) => { ver ksv_hata(e); }
            tamam(xs) => {
                eğer a.yol.indeks == b.disk.kok ve bm_esit(a.yol.yol,"/") { dizi_ekle(xs,ksv_sanal_girdi("diskler")); }
                ver ksv_dizin_kopyala(b,fd olarak tam32,p,n olarak tam32,xs); }
        }
    } }
}
işlev ksv_cwd_al(b: &değişken KsvBaglam,p: tam64,n: tam64) -> tam64 {
    değişken boy: tam32 = metin_uzunluk(b.disk.cwd);
    eğer n <= (boy olarak tam64) { ver 0-KX_HATA_RANGE; }
    eğer değil kxs_aralik(p,n,doğru) { ver 0-KX_HATA_FAULT; }
    değişken i: tam32 = 0;
    iken i < boy { kis_buf_yaz8(p,i,metin_bayt(b.disk.cwd,i) olarak tam32); i=i+1; }
    kis_buf_yaz8(p,i,0);
    ver boy olarak tam64;
}
işlev ksv_cwd_degistir(b: &değişken KsvBaglam,p: tam64) -> tam64 {
    değişken y: metin = "";
    değişken r: tam64 = ksv_mutlak(b,p,&değişken y);
    eğer r < 0 { ver r; }
    eğer bm_esit(y,"/diskler") veya bm_esit(y,"/") { b.disk.cwd=y; ver 0; }
    eşleş kd_yol(&değişken b.disk,y) { hata(e) => { ver ksv_hata(e); } tamam(ky) => {
        eşleş ksv_yoldan_bilgi(b,ky) { hata(e) => { ver ksv_hata(e); } tamam(g) => {
            eğer değil g.dizin_mi { ver 0-KX_HATA_NOTDIR; }
            b.disk.cwd=y;
            ver 0;
        } }
    } }
}
işlev ksv_yol_isle(b: &değişken KsvBaglam,num: tam64,p: tam64) -> tam64 {
    değişken m: metin = "";
    değişken r: tam64 = ksv_mutlak(b,p,&değişken m);
    eğer r < 0 { ver r; }
    eşleş kd_yol(&değişken b.disk,m) { hata(e) => { ver ksv_hata(e); } tamam(y) => {
        eğer num == KX_SIS_OLUSTUR_DIZIN { ver ksv_mutasyon(b,y,FatYazIslem::DizinOlustur); }
        eğer num == KX_SIS_SIL { ver ksv_mutasyon(b,y,FatYazIslem::DosyaSil); }
        eğer yol_bilesen_esit(m,b.disk.cwd) veya yol_bilesen_esit(m,b.kabuk_cwd) { ver 0-KX_HATA_INVAL; }
        ver ksv_mutasyon(b,y,FatYazIslem::DizinSil);
    } }
}
işlev ksv_adlandir(b: &değişken KsvBaglam,p: tam64,q: tam64) -> tam64 {
    değişken eski: KabukYol = KabukYol {indeks:0,yol:""};
    değişken yeni: KabukYol = KabukYol {indeks:0,yol:""};
    değişken r: tam64 = ksv_yol(b,p,&değişken eski);
    eğer r < 0 { ver r; }
    r=ksv_yol(b,q,&değişken yeni);
    eğer r < 0 { ver r; }
    eğer eski.indeks != yeni.indeks { ver 0-KX_HATA_XDEV; }
    b.degisti=doğru;
    eşleş kd_kopyala(&değişken b.disk,eski,yeni,doğru) {
        hata(e) => { ver ksv_hata(e); }
        tamam(v) => { ver 0; }
    }
}
işlev ksv_esitle(b: &değişken KsvBaglam) -> tam64 {
    eşleş kd_sync(&değişken b.disk) {
        hata(e) => { ver ksv_hata(e); }
        tamam(v) => { b.degisti=yanlış; ver 0; }
    }
}
çıplak işlev ksv_fdleri_birak(b: &değişken KsvBaglam) {
    değişken i: tam32 = 0;
    iken i < KSV_FD_AZAMI {
        değişken fd: KsvFd = dizi_al(b.fds,i);
        eğer fd.acik { kb_birak(fd); dizi_yaz(b.fds,i,ksv_fd_bos()); }
        i=i+1;
    }
}
küresel değişken kt_kod: tam32 = 0;
küresel değişken kt_unicode: tam32 = 0;
küresel değişken kt_mod: tam32 = 0;
küresel değişken kt_sonraki: tam64 = 0;
çıplak işlev kt_hazir() -> mantıksal { ver kt_kod != 0 ve kem_tik_oku() >= kt_sonraki; }
çıplak işlev kt_izle(o: TusHamOlay) -> mantıksal {
    eğer o.bas == 0 {
        eğer kt_kod == o.kod { kt_kod=0; } ver doğru;
    }
    eğer o.kod == kt_kod { ver yanlış; }
    eğer o.unicode > 0 veya o.kod == 14 veya (o.kod >= 327 ve o.kod <= 339) {
        kt_kod=o.kod; kt_unicode=o.unicode; kt_mod=o.degistirici; kt_sonraki=kem_tik_oku()+50;
    } değilse { kt_kod=0; }
    ver doğru;
}
çıplak işlev kt_yinele() -> TusHamOlay {
    kt_sonraki=kem_tik_oku()+5;
    ver TusHamOlay {kod:kt_kod,unicode:kt_unicode,bas:1,degistirici:kt_mod};
}
// Planlayıcı her dilimden önce donanımı bir kez yoklar. CPU kullanan veya
// uyuyan ön plan sürecinin Ctrl+C alabilmesi bir okuma çağrısına bağlı değildir.
işlev ksv_tus_kuyruk(b: &değişken KsvBaglam,o: TusHamOlay) -> tam64 {
    eğer o.bas == 1 ve o.kod == 46 ve (o.degistirici&2) != 0 {
        güvensiz { kt_kod=0; } ver 2;
    }
    eğer değil kt_izle(o) { ver 0; }
    eğer b.ilk_tus ve o.kod == 28 ve o.bas == 0 { ver 0; }
    b.ilk_tus=yanlış;
    eğer b.olay_konum == dizi_boyut(b.olaylar) { b.olaylar=[]; b.olay_konum=0; }
    eğer dizi_boyut(b.olaylar) >= 256 {
        eğer b.olay_konum == 0 { ver -105; }
        değişken kalan: Dizi<TusHamOlay> = [];
        iken b.olay_konum < dizi_boyut(b.olaylar) {
            dizi_ekle(kalan,dizi_al(b.olaylar,b.olay_konum)); b.olay_konum=b.olay_konum+1;
        }
        b.olaylar=kalan; b.olay_konum=0;
    }
    dizi_ekle(b.olaylar,o); ver 0;
}
işlev ksv_tus_doldur(b: &değişken KsvBaglam) -> tam64 {
    değişken led: tam32 = klavye_led(&değişken b.tr,b.klavye_indeksi >= 0);
    eğer b.klavye_indeksi < 0 {
        değişken ham: tam32 = -1;
        eğer ps2_kesme_etkin() { ham=ps2_kesme_klavye_oku(); } değilse { ham=ps2_oku(); }
        eğer ham < 0 { ver 0; }
        eşleş klavye_ham_bayt(&değişken b.tr,ham) {
            hiç => { } değer(v) => {
                kl_led_degisti(&değişken b.x,b.xb,-1,&değişken b.tr,led);
                ver ksv_tus_kuyruk(b,v);
            }
        }
        ver 0;
    }
    eğer bh_gonder(&değişken b.x,b.xb,b.klavye_indeksi,0) < 0 { ver -5; }
    bh_olaylar();
    eğer bh_durum(0) != 2 { ver 0; }
    eşleş hid_klavye_ham_rapor(&değişken b.h,&değişken b.tr,bh_rapor(0)) {
        hata(e) => { ver 0-KX_HATA_IO; }
        tamam(xs) => {
            kl_led_degisti(&değişken b.x,b.xb,b.klavye_indeksi,&değişken b.tr,led);
            için o: xs { değişken r: tam64 = ksv_tus_kuyruk(b,o); eğer r != 0 { ver r; } }
            ver 0;
        }
    }
}
işlev ksv_tus_al(b: &değişken KsvBaglam,p: tam64) -> tam64 {
    güvensiz { eğer kxs_on_pid != kxs_pid { ver -13; } }
    eğer değil kxs_aralik(p,32,doğru) { ver 0-KX_HATA_FAULT; }
    değişken o: TusHamOlay = TusHamOlay {kod:0,unicode:0,bas:0,degistirici:0};
    eğer b.olay_konum < dizi_boyut(b.olaylar) {
        o=dizi_al(b.olaylar,b.olay_konum); b.olay_konum=b.olay_konum+1;
    } değilse eğer kt_hazir() { o=kt_yinele(); } değilse { ver 1; }
    kxm_y64(p,o.kod olarak tam64); kxm_y64(p+8,o.unicode olarak tam64);
    kxm_y64(p+16,o.bas olarak tam64); kxm_y64(p+24,o.degistirici olarak tam64); ver 0;
}
işlev ksv_saat(p: tam64) -> tam64 {
    eğer değil kxs_aralik(p,48,doğru) { ver 0-KX_HATA_FAULT; }
    eşleş rtc_oku() {
        hata(e) => { ver 0-KX_HATA_IO; }
        tamam(a) => {
            kxm_y64(p,a.yil olarak tam64); kxm_y64(p+8,a.ay olarak tam64); kxm_y64(p+16,a.gun olarak tam64);
            kxm_y64(p+24,a.saat olarak tam64); kxm_y64(p+32,a.dakika olarak tam64); kxm_y64(p+40,a.saniye olarak tam64);
            ver 0;
        }
    }
}
işlev ksv_uyu(ms: tam64) -> tam64 {
    eğer ms < 0 veya ms > 60000 { ver 0-KX_HATA_INVAL; }
    eğer ms == 0 { ver 0; }
    ver kxs_beklet(KXS_UYUYOR,kem_tik_oku()+(ms+9)/10,-1);
}
işlev ksv_baslat(b: &değişken KsvBaglam,yol: tam64,adresler: tam64,onplan: mantıksal,esleme: tam64) -> tam64 {
    güvensiz { eğer onplan ve kxs_pid != kxs_on_pid { ver -13; } }
    değişken gir: KsvFd = ksv_fd_bos(); değişken cik: KsvFd = ksv_fd_bos();
    eğer esleme != 0 {
        eğer değil kxs_aralik(esleme,16,yanlış) { ver -14; }
        değişken i: tam32 = 0;
        iken i < 2 {
            değişken fd: tam64 = kxm_o64(esleme+(i olarak tam64)*8);
            eğer fd != -1 {
                eğer değil ksv_fd_gecerli(b,fd) { ver -9; }
                değişken f: KsvFd = dizi_al(b.fds,fd olarak tam32);
                eğer i == 0 { eğer f.yol.indeks != -3 { ver -9; } gir=f; }
                değilse { eğer f.yol.indeks != -4 { ver -9; } cik=f; }
            } i=i+1;
        }
    }
    değişken uzun: tam64 = kxs_dize_boyu(yol,4096);
    eğer uzun <= 0 { eğer uzun == 0 { ver -2; } ver uzun; }
    değişken argv: Dizi<metin> = [];
    dizi_ekle(argv,metin_kes(ksv_metin(yol),0,uzun olarak tam32));
    değişken n: tam64 = 0;
    eğer adresler != 0 {
        değişken devam: mantıksal = doğru;
        iken devam {
            eğer değil kxs_aralik(adresler,8*(n+1),yanlış) { ver -14; }
            değişken v: tam64 = kxm_o64(adresler+n*8);
            eğer v == 0 { devam=yanlış; } değilse {
            eğer n >= 31 { ver -7; }
            uzun=kxs_dize_boyu(v,4096);
            eğer uzun < 0 { ver uzun; }
            dizi_ekle(argv,metin_kes(ksv_metin(v),0,uzun olarak tam32));
            n=n+1;
            }
        }
    }
    güvensiz {
        değişken ptr: *KsKabukSureci = ks_yonetim olarak *KsKabukSureci;
        değişken p: KsKabukSureci = *ptr;
        eşleş ks_baslat(&değişken p,b,argv,kxs_pid) {
            hata(e) => {
                eğer bm_esit(e,"surec icin RAM yetmedi") { ver -12; }
                eğer bm_esit(e,"surec tablosu dolu") { ver -11; }
                eğer bm_esit(e,"argv surec yigini siniri") { ver -7; }
                ver ksv_hata(e);
            }
            tamam(y) => {
                değişken cocuk: KsvBaglam = dizi_al(p.baglamlar,y olarak tam32);
                eğer gir.acik { dizi_yaz(cocuk.fds,0,kb_uc(gir.konum,yanlış)); }
                eğer cik.acik { dizi_yaz(cocuk.fds,1,kb_uc(cik.konum,doğru)); }
                *ptr=p; eğer onplan { kxs_on_pid=ks_pid(y); } ver ks_pid(y); }
        }
    }
}
işlev ksv_bekle(pid: tam64,out: tam64) -> tam64 {
    eğer değil kxs_aralik(out,16,doğru) { ver -14; }
    değişken y: tam64 = kxs_pid_yuva(pid);
    eğer y < 0 { ver -10; }
    değişken r: tam64 = kxs_baglam(y);
    güvensiz {
        eğer kxm_o64(r+KXS_EBEVEYN_OFS) != kxs_pid { ver -10; }
        eğer değil ks_bitti(ks_durum(y)) {
            eğer kxs_on_pid == kxs_pid { kxs_on_pid=pid; }
            ver kxs_beklet(KXS_COCUK_BEKLIYOR,y,59);
        }
        eğer kxs_on_pid == pid { kxs_on_pid=kxs_pid; }
        değişken s: KxsSonuc = KxsSonuc {pid:0,ebeveyn:0,bitti:yanlış,kod:0,vektor:0,hata_kodu:0,rip:0,cr2:0};
        kxs_sonuc_al(y,&değişken s);
        eğer s.bitti { kxm_y64(out,0); kxm_y64(out+8,s.kod); }
        değilse { kxm_y64(out,1); kxm_y64(out+8,s.vektor); }
        ver 0;
    }
}
işlev ksv_surec_listesi(out: tam64,n: tam64) -> tam64 {
    eğer n < 0 veya n > 8 { ver -22; }
    eğer değil kxs_aralik(out,n*96,doğru) { ver -14; }
    değişken adet: tam64 = 0;
    değişken y: tam64 = 0;
    iken y < KXS_YUVA_ADEDI { eğer ks_durum(y) != KXS_BOS { adet=adet+1; } y=y+1; }
    eğer adet > n { ver -34; }
    güvensiz {
        değişken ptr: *KsKabukSureci = ks_yonetim olarak *KsKabukSureci;
        değişken p: KsKabukSureci = *ptr;
        y=0;
        iken y < KXS_YUVA_ADEDI {
            eğer ks_durum(y) != KXS_BOS {
                değişken ad: metin = dizi_al(p.adlar,y olarak tam32);
                eğer metin_uzunluk(ad) >= 72 { ver -36; }
                memset(out olarak *tam8,0,96);
                kxm_y64(out,ks_pid(y)); kxm_y64(out+8,ks_durum(y));
                kxm_y64(out+16,kxm_o64(kxs_baglam(y)+KXS_DILIM_OFS));
                değişken i: tam32 = 0;
                iken i < metin_uzunluk(ad) { kxr_y8(out+24+(i olarak tam64),metin_bayt(ad,i) olarak dtam8); i=i+1; }
                out=out+96;
            }
            y=y+1;
        }
    }
    ver adet;
}
// Görünür imleç hücrenin son iki tarama satırını tersler.
küresel değişken ksv_ekran_adr: tam64 = 0;
küresel değişken ksv_ekran_sahibi: tam64 = 0;
küresel değişken ksv_imlec_x: tam32 = 0;
küresel değişken ksv_imlec_y: tam32 = 0;
küresel değişken ksv_imlec_acik: tam64 = 0;
çıplak işlev ksv_imlec_cevir(e: Ekran) {
    eğer ksv_imlec_acik == 0 { ver; }
    değişken i: tam32 = 0;
    iken i < 16 {
        değişken adr: tam64 = e.fb+((ksv_imlec_y*16+14+i/8) olarak tam64)*e.adim+((ksv_imlec_x*8+i%8) olarak tam64)*4;
        kem_mmio_yaz32(adr,kem_mmio_oku32(adr)^16777215);
        i=i+1;
    }
}
işlev ksv_ekran_isle(num: tam64,a: tam64,c: tam64,d: tam64) -> tam64 {
    güvensiz {
        eğer kxs_pid != kxs_on_pid { ver -13; }
        eğer ksv_ekran_adr == 0 { ver -19; }
        değişken ptr: *KabukEkran = ksv_ekran_adr olarak *KabukEkran;
        değişken ke: KabukEkran = *ptr;
        eğer değil ke.var { ver -19; }
        değişken sut: tam64 = (ke.e.gen/8) olarak tam64;
        değişken sat: tam64 = (ke.e.yuk/16) olarak tam64;
        eğer num == 61 {
            eğer değil kxs_aralik(a,32,doğru) { ver -14; }
            kxm_y64(a,sut); kxm_y64(a+8,sat);
            kxm_y64(a+16,ke.e.gen olarak tam64); kxm_y64(a+24,ke.e.yuk olarak tam64);
            ver 0;
        }
        eğer num == 68 {
            eğer a < 0 veya a >= (ke.e.yuk olarak tam64) veya d < 1 veya d > (ke.e.gen olarak tam64) { ver -22; }
            eğer değil kxs_aralik(c,d*4,yanlış) { ver -14; }
            değişken i: tam64 = 0;
            iken i < d {
                değişken renk: *dtam32 = (c+i*4) olarak *dtam32;
                kem_mmio_yaz32(ke.e.fb+a*ke.e.adim+i*4,((*renk) olarak tam64)&16777215);
                i=i+1;
            }
            ksv_ekran_sahibi=kxs_pid; ver 0;
        }
        eğer num == 63 {
            eğer a < 0 veya a > 16777215 { ver -22; }
            ksv_ekran_sahibi=kxs_pid; ksv_imlec_acik=0;
            lfb_doldur(ke.e.fb,(ke.e.adim/4)*(ke.e.yuk olarak tam64),a);
            ver 0;
        }
        eğer a < 0 veya a >= sat veya c < 0 veya c >= sut { ver -22; }
        eğer num == 64 {
            eğer d < 0 veya d > 1 { ver -22; }
            ksv_ekran_sahibi=kxs_pid;
            ksv_imlec_cevir(ke.e); ksv_imlec_x=c olarak tam32; ksv_imlec_y=a olarak tam32;
            ksv_imlec_acik=d; ksv_imlec_cevir(ke.e); ver 0;
        }
        eğer değil kxs_aralik(d,24,yanlış) { ver -14; }
        değişken p: tam64 = kxm_o64(d);
        değişken on: tam64 = kxm_o64(d+8);
        değişken arka: tam64 = kxm_o64(d+16);
        eğer on < 0 veya on > 16777215 veya arka < 0 veya arka > 16777215 { ver -22; }
        değişken n: tam64 = kxs_dize_boyu(p,4096);
        eğer n < 0 { ver n; }
        değişken xs: Dizi<tam32> = utf8_coz(ksv_metin(p));
        eğer (dizi_boyut(xs) olarak tam64) > sut-c { ver -34; }
        ksv_ekran_sahibi=kxs_pid;
        ksv_imlec_cevir(ke.e);
        değişken i: tam32 = 0;
        için kod: xs { ekran_kod(ke.e,ke.f,((c olarak tam32)+i)*8,(a olarak tam32)*16,kod,on,arka); i=i+1; }
        ksv_imlec_cevir(ke.e); ver 0;
    }
}
işlev ksv_kabugu_ciz() {
    güvensiz {
        eğer ksv_ekran_sahibi == 0 veya ksv_ekran_adr == 0 { ver; }
        değişken ptr: *KabukEkran = ksv_ekran_adr olarak *KabukEkran;
        değişken ke: KabukEkran = *ptr;
        ksv_imlec_acik=0; ksv_ekran_sahibi=0;
        lfb_doldur(ke.e.fb,(ke.e.adim/4)*(ke.e.yuk olarak tam64),KE_ARKA);
        değişken i: tam32 = 0;
        iken i < ke.k.satirlar { dizi_yaz(ke.k.kirli,i,1); i=i+1; }
        ke_ciz(&değişken ke); *ptr=ke;
    }
}
küresel değişken ksv_hassasiyet: tam32 = 1;
çıplak işlev ksv_hareket(v: tam32) -> tam32 {
    değişken carpan: tam32 = ksv_hassasiyet;
    eğer carpan > 1 ve (v < -8 veya v > 8) { carpan=carpan+1; }
    ver v*carpan;
}
küresel değişken ksv_fare_x: tam64 = 0;
küresel değişken ksv_fare_y: tam64 = 0;
işlev ksv_fare_koy(p: tam64,o: FareOlayi) -> tam64 {
    güvensiz {
        değişken gp: *KabukEkran = ksv_ekran_adr olarak *KabukEkran;
        değişken ke: KabukEkran = *gp;
        eğer değil ke.var { ver -19; }
        değişken dx: tam64 = ksv_hareket(o.dx) olarak tam64;
        değişken dy: tam64 = 0-(ksv_hareket(o.dy) olarak tam64);
        ksv_fare_x=ksv_fare_x+dx; ksv_fare_y=ksv_fare_y+dy;
        eğer ksv_fare_x < 0 { ksv_fare_x=0; } eğer ksv_fare_y < 0 { ksv_fare_y=0; }
        eğer ksv_fare_x >= (ke.e.gen olarak tam64) { ksv_fare_x=(ke.e.gen olarak tam64)-1; }
        eğer ksv_fare_y >= (ke.e.yuk olarak tam64) { ksv_fare_y=(ke.e.yuk olarak tam64)-1; }
        değişken dugme: tam64 = 0;
        eğer o.sol { dugme=dugme|1; } eğer o.sag { dugme=dugme|2; } eğer o.orta { dugme=dugme|4; }
        kxm_y64(p,dx); kxm_y64(p+8,dy); kxm_y64(p+16,ksv_fare_x); kxm_y64(p+24,ksv_fare_y);
        kxm_y64(p+32,dugme); kxm_y64(p+40,o.dz olarak tam64);
        ver 0;
    }
}
işlev ksv_fare_al(b: &değişken KsvBaglam,p: tam64) -> tam64 {
    eğer bh_fare() >= 0 {
        eğer bh_gonder(&değişken b.x,b.xb,bh_fare(),1) < 0 { ver -5; }
        bh_olaylar();
        eğer bh_durum(1) == 2 {
            eşleş hid_fare_rapor(bh_rapor(1)) { hata(e) => { ver -5; } tamam(o) => {
                // HID tekerleğinde yukarı pozitif, ABI tekerleğinde aşağı pozitiftir.
                değişken olay: FareOlayi = o; olay.dz=0-o.dz; ver ksv_fare_koy(p,olay);
            } }
        }
    }
    değişken ham: tam32 = ps2_kesme_fare_oku();
    iken ham >= 0 {
        eşleş fare_bayt(&değişken b.fare_durum,ham) { hiç => { } değer(o) => { ver ksv_fare_koy(p,o); } }
        ham=ps2_kesme_fare_oku();
    }
    ver 1;
}
işlev ksv_olay(b: &değişken KsvBaglam,p: tam64,maske: tam64,ms: tam64,num: tam64) -> tam64 {
    güvensiz { eğer kxs_pid != kxs_on_pid { ver -13; } }
    eğer maske < 1 veya maske > 3 veya ms < -1 veya ms > 60000 { ver -22; }
    değişken boy: tam64 = 56; değişken veri: tam64 = p+8;
    eğer num == 55 { boy=32; veri=p; } eğer num == 65 { boy=48; veri=p; }
    eğer değil kxs_aralik(p,boy,doğru) { ver -14; }
    eğer değil b.bekleme_kurulu {
        b.olay_maskesi=maske; b.son_tik=-1;
        eğer ms >= 0 { b.son_tik=kem_tik_oku()+(ms+9)/10; }
        b.bekleme_kurulu=doğru;
    }
    değişken tur: tam64 = 0;
    değişken r: tam64 = 1;
    eğer (maske&1) != 0 { tur=1; r=ksv_tus_al(b,veri); }
    eğer r == 1 ve (maske&2) != 0 { tur=2; r=ksv_fare_al(b,veri); }
    eğer r == 1 ve b.son_tik >= 0 ve kem_tik_oku() >= b.son_tik { tur=0; r=0; }
    eğer r == 1 { ver kxs_beklet(KXS_TUS_BEKLIYOR,0,num); }
    b.bekleme_kurulu=yanlış;
    eğer r == 0 ve num == 66 {
        kxm_y64(p,tur);
        eğer tur == 1 { kxm_y64(p+40,0); kxm_y64(p+48,0); }
        eğer tur == 0 { güvensiz { memset(veri olarak *tam8,0,48); } }
    }
    ver r;
}
işlev ksv_dagit(b: &değişken KsvBaglam, num: tam64,a: tam64,c: tam64,d: tam64) -> tam64 {
    eğer num == KX_SIS_BORU { ver kb_ac(b,a); }
    eğer num == KX_SIS_BASLAT_ESLEMELI { ver ksv_baslat(b,a,c,yanlış,d); }
    eğer num == KX_SIS_BASLAT { ver ksv_baslat(b,a,c,yanlış,0); }
    eğer num == KX_SIS_ONPLAN_BASLAT { ver ksv_baslat(b,a,c,doğru,0); }
    eğer num == KX_SIS_BEKLE { ver ksv_bekle(a,c); }
    eğer num == KX_SIS_SUREC_LISTESI { ver ksv_surec_listesi(a,c); }
    eğer num == KX_SIS_EKRAN_BILGI { ver ksv_ekran_isle(num,a,0,0); }
    eğer num == KX_SIS_EKRAN_YAZ { ver ksv_ekran_isle(num,a,c,d); }
    eğer num == KX_SIS_EKRAN_TEMIZLE { ver ksv_ekran_isle(num,a,0,0); }
    eğer num == KX_SIS_PIKSEL_SATIRI { ver ksv_ekran_isle(num,a,c,d); }
    eğer num == KX_SIS_IMLEC { ver ksv_ekran_isle(num,a,c,d); }
    eğer num == KX_SIS_FARE_BEKLE { ver ksv_olay(b,a,2,-1,65); }
    eğer num == KX_SIS_OLAY_BEKLE { ver ksv_olay(b,a,c,d,66); }
    eğer num == KX_SIS_AC { ver ksv_ac(b,a,c); }
    eğer num == KX_SIS_OKU { ver ksv_oku(b,a,c,d); }
    eğer num == KX_SIS_YAZ { ver ksv_yaz(b,a,c,d); }
    eğer num == KX_SIS_KONUMLA { ver ksv_konumla(b,a,c,d); }
    eğer num == KX_SIS_BILGI { ver ksv_bilgi(b,a,c); }
    eğer num == KX_SIS_DIZIN_OKU { ver ksv_dizin_oku(b,a,c,d); }
    eğer num == KX_SIS_OLUSTUR_DIZIN veya num == KX_SIS_SIL veya num == KX_SIS_SIL_DIZIN { ver ksv_yol_isle(b,num,a); }
    eğer num == KX_SIS_YENIDEN_ADLANDIR { ver ksv_adlandir(b,a,c); }
    eğer num == KX_SIS_CALISMA_DIZINI_AL { ver ksv_cwd_al(b,a,c); }
    eğer num == KX_SIS_CALISMA_DIZINI_DEGISTIR { ver ksv_cwd_degistir(b,a); }
    eğer num == KX_SIS_ESITLE { ver ksv_esitle(b); }
    eğer num == KX_SIS_TUS_BEKLE { ver ksv_olay(b,a,1,-1,55); }
    eğer num == KX_SIS_SAAT { ver ksv_saat(a); }
    eğer num == KX_SIS_UYU { ver ksv_uyu(a); }
    eğer num == KX_SIS_KAPAT {
        eğer değil ksv_fd_gecerli(b,a) { ver 0-KX_HATA_BADF; }
        kb_birak(dizi_al(b.fds,a olarak tam32)); dizi_yaz(b.fds,a olarak tam32,ksv_fd_bos());
        ver 0;
    }
    ver 0-KX_HATA_NOSYS;
}
çıplak işlev ksv_vekil(num: tam64,a: tam64,b: tam64,c: tam64) -> tam64 {
    değişken sonuc: tam64 = 0;
    değişken rho: *tam8 = kdl_global_bolge_al();
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"movq $1, %rdi
movq $2, %rsi
movq $3, %rdx
movq $4, %rcx
movq $5, %r8
movq $6, %r9
movq %rsp, %r11
andq $$-16, %rsp
subq $$16, %rsp
movq %r11, (%rsp)
call ksv_dagit
movq (%rsp), %rsp"#
            çıktı("={rax}", &sonuc)
            girdi("r", rho) girdi("r", ksv_baglam_adresi)
            girdi("r", num) girdi("r", a) girdi("r", b) girdi("r", c)
            bozulan("~{rdi}") bozulan("~{rsi}") bozulan("~{rdx}") bozulan("~{rcx}")
            bozulan("~{r8}") bozulan("~{r9}") bozulan("~{r10}") bozulan("~{r11}")
            bozulan("~{memory}") bozulan("~{cc}")
        }
    }
    ver sonuc;
}
çıplak işlev ksv_vekil_adresi() -> tam64 {
    değişken adr: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"leaq ksv_vekil(%rip), $0"# çıktı("=r", &adr) } }
    ver adr;
}
