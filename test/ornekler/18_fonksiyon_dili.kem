// ============================================================================
// 18_fonksiyon_dili.kem — Mini dil V3: FONKSİYONLAR (tanım + çağrı + ÖZYİNELEME).
//
// D-033 (kontrol akışı) üstüne fonksiyon soyutlaması → toy-dil Turing-tam:
//   islev ad(p1, p2) { ... don ifade; }    (tanım)
//   ad(arg1, arg2)                          (çağrı, ifade içinde)
//   özyineleme + karşılıklı çağrı.
//
// Tasarım (flat-token yürütücü + KEMGU'nun kendi özyinelemesi):
//   - Fonksiyon tablosu: ön-geçişte islev tanımları kaydedilir (ad → param
//     adları + gövde '{' konumu); tanım gövdeleri normal yürütmede atlanır.
//   - Çağrı: argümanlar ÇAĞIRANIN kapsamında değerlendirilir; YENİ kapsam
//     itilir (params bağlanır); gövde yürütülür; dönüş değeri yayılır.
//   - Kapsam yığını: Semboller.ust = mantıksal tepe (dizi_pop yok → slot'lar
//     yeniden kullanılır; ust kaydet/sıfırla ile push/pop). Arama tepeden tabana
//     (en yakın bağlama kazanır → özyinelemede her çağrının param'ı izole).
//   - don: dondu bayrağı + donus değeri; blok/döngü dondu'da erken çıkar.
//   - İMLEÇ özyineleme-güvenli: cagri_yap çağrı sonrası konumu YEREL'de saklar →
//     KEMGU'nun çağrı yığını her seviyeyi korur (paylaşılan imleç doğru yönetilir).
//
// Çalıştırılan:  islev fakt(n) { eger (n<2) { don 1; } don n*fakt(n-1); }
//                fakt(5)-78        →  120 - 78 = 42
//
// Token: 0=SAYI 1=+ 2=- 3=* 4=/ 5=( 6=) 7=IDENT 8== 9=; 10={ 11=} 12=< 13=>
//        14=== 15=eger 16=degilse 17=iken 18=, 19=don 20=islev
// ============================================================================

yapı Tokenler {
    kind: Dizi<tam32>; deger: Dizi<tam32>; ad: Dizi<metin>; imlec: Dizi<tam32>;
}
yapı Semboller {
    ad: Dizi<metin>; deger: Dizi<tam32>;
    ust: Dizi<tam32>; dondu: Dizi<tam32>; donus: Dizi<tam32>;
}
yapı Fonksiyonlar {
    ad: Dizi<metin>; p1: Dizi<metin>; p2: Dizi<metin>;
    np: Dizi<tam32>; govde: Dizi<tam32>;
}

işlev rakam_mi(b: tam8) -> mantıksal {
    değişken k: tam32 = b olarak tam32; ver k >= 48 ve k <= 57;
}
işlev harf_mi(b: tam8) -> mantıksal {
    değişken k: tam32 = b olarak tam32;
    ver (k >= 97 ve k <= 122) veya (k >= 65 ve k <= 90);
}
işlev token_ekle(t: &Tokenler, kind: tam32, deger: tam32, ad: metin) -> tam32 {
    dizi_ekle(t.kind, kind); dizi_ekle(t.deger, deger); dizi_ekle(t.ad, ad); ver 0;
}
işlev kelime_token(t: &Tokenler, w: metin) -> tam32 {
    eğer metin_esit(w, "eger") { token_ekle(t, 15, 0, ""); }
    değilse eğer metin_esit(w, "degilse") { token_ekle(t, 16, 0, ""); }
    değilse eğer metin_esit(w, "iken") { token_ekle(t, 17, 0, ""); }
    değilse eğer metin_esit(w, "don") { token_ekle(t, 19, 0, ""); }
    değilse eğer metin_esit(w, "islev") { token_ekle(t, 20, 0, ""); }
    değilse { token_ekle(t, 7, 0, w); }
    ver 0;
}
işlev lexle(kaynak: metin, t: &Tokenler) -> tam32 {
    değişken uz: tam32 = metin_uzunluk(kaynak);
    değişken i: tam32 = 0; değişken sayi: tam32 = 0; değişken sayi_var: mantıksal = yanlış;
    değişken ad_basla: tam32 = 0; değişken ad_var: mantıksal = yanlış;
    iken i < uz {
        değişken b: tam8 = metin_bayt(kaynak, i);
        eğer rakam_mi(b) {
            sayi = sayi * 10 + (b olarak tam32) - 48; sayi_var = doğru;
        } değilse eğer harf_mi(b) {
            eğer sayi_var { token_ekle(t, 0, sayi, ""); sayi = 0; sayi_var = yanlış; }
            eğer değil ad_var { ad_basla = i; ad_var = doğru; }
        } değilse {
            eğer sayi_var { token_ekle(t, 0, sayi, ""); sayi = 0; sayi_var = yanlış; }
            eğer ad_var { kelime_token(t, metin_kes(kaynak, ad_basla, i - ad_basla)); ad_var = yanlış; }
            değişken tur: tam32 = 0;
            eğer b == 43 { tur = 1; }
            değilse eğer b == 45 { tur = 2; }
            değilse eğer b == 42 { tur = 3; }
            değilse eğer b == 47 { tur = 4; }
            değilse eğer b == 40 { tur = 5; }
            değilse eğer b == 41 { tur = 6; }
            değilse eğer b == 59 { tur = 9; }
            değilse eğer b == 123 { tur = 10; }
            değilse eğer b == 125 { tur = 11; }
            değilse eğer b == 60 { tur = 12; }
            değilse eğer b == 62 { tur = 13; }
            değilse eğer b == 44 { tur = 18; }       // ,
            değilse eğer b == 61 {
                eğer (i + 1 < uz) ve (metin_bayt(kaynak, i + 1) == 61) { tur = 14; i = i + 1; }
                değilse { tur = 8; }
            }
            eğer tur != 0 { token_ekle(t, tur, 0, ""); }
        }
        i = i + 1;
    }
    eğer sayi_var { token_ekle(t, 0, sayi, ""); }
    eğer ad_var { kelime_token(t, metin_kes(kaynak, ad_basla, uz - ad_basla)); }
    ver 0;
}

// === Kapsam yığını ===
işlev kapsam_it(s: &Semboller, ad: metin, deger: tam32) -> tam32 {
    değişken u: tam32 = dizi_al(s.ust, 0);
    eğer u < dizi_boyut(s.ad) { dizi_yaz(s.ad, u, ad); dizi_yaz(s.deger, u, deger); }
    değilse { dizi_ekle(s.ad, ad); dizi_ekle(s.deger, deger); }
    dizi_yaz(s.ust, 0, u + 1); ver 0;
}
işlev kapsam_ara(s: &Semboller, ad: metin) -> tam32 {
    değişken i: tam32 = dizi_al(s.ust, 0) - 1;
    iken i >= 0 {
        eğer metin_esit(dizi_al(s.ad, i), ad) { ver dizi_al(s.deger, i); }
        i = i - 1;
    }
    ver 0;
}
işlev kapsam_yaz(s: &Semboller, ad: metin, deger: tam32) -> tam32 {
    değişken i: tam32 = dizi_al(s.ust, 0) - 1;
    iken i >= 0 {
        eğer metin_esit(dizi_al(s.ad, i), ad) { dizi_yaz(s.deger, i, deger); ver 0; }
        i = i - 1;
    }
    kapsam_it(s, ad, deger); ver 0;
}
işlev fn_bul(f: &Fonksiyonlar, ad: metin) -> tam32 {
    değişken i: tam32 = 0; değişken n: tam32 = dizi_boyut(f.ad);
    iken i < n { eğer metin_esit(dizi_al(f.ad, i), ad) { ver i; } i = i + 1; }
    ver 0 - 1;
}

// === İfade (öncelik + karşılaştırma + fonksiyon çağrısı) ===
işlev faktor(t: &Tokenler, s: &Semboller, f: &Fonksiyonlar) -> tam32 {
    değişken p: tam32 = dizi_al(t.imlec, 0);
    değişken k: tam32 = dizi_al(t.kind, p);
    eğer k == 5 {
        dizi_yaz(t.imlec, 0, p + 1);
        değişken v: tam32 = ifade(t, s, f);
        dizi_yaz(t.imlec, 0, dizi_al(t.imlec, 0) + 1); ver v;
    }
    eğer k == 7 {
        eğer dizi_al(t.kind, p + 1) == 5 { ver cagri_yap(t, s, f, dizi_al(t.ad, p)); }
        dizi_yaz(t.imlec, 0, p + 1); ver kapsam_ara(s, dizi_al(t.ad, p));
    }
    dizi_yaz(t.imlec, 0, p + 1); ver dizi_al(t.deger, p);
}
işlev terim(t: &Tokenler, s: &Semboller, f: &Fonksiyonlar) -> tam32 {
    değişken sol: tam32 = faktor(t, s, f);
    iken doğru {
        değişken p: tam32 = dizi_al(t.imlec, 0);
        eğer p >= dizi_boyut(t.kind) { ver sol; }
        değişken op: tam32 = dizi_al(t.kind, p);
        eğer op == 3 { dizi_yaz(t.imlec, 0, p + 1); sol = sol * faktor(t, s, f); }
        değilse eğer op == 4 { dizi_yaz(t.imlec, 0, p + 1); sol = sol / faktor(t, s, f); }
        değilse { ver sol; }
    }
    ver sol;
}
işlev toplama(t: &Tokenler, s: &Semboller, f: &Fonksiyonlar) -> tam32 {
    değişken sol: tam32 = terim(t, s, f);
    iken doğru {
        değişken p: tam32 = dizi_al(t.imlec, 0);
        eğer p >= dizi_boyut(t.kind) { ver sol; }
        değişken op: tam32 = dizi_al(t.kind, p);
        eğer op == 1 { dizi_yaz(t.imlec, 0, p + 1); sol = sol + terim(t, s, f); }
        değilse eğer op == 2 { dizi_yaz(t.imlec, 0, p + 1); sol = sol - terim(t, s, f); }
        değilse { ver sol; }
    }
    ver sol;
}
işlev ifade(t: &Tokenler, s: &Semboller, f: &Fonksiyonlar) -> tam32 {
    değişken sol: tam32 = toplama(t, s, f);
    değişken p: tam32 = dizi_al(t.imlec, 0);
    eğer p >= dizi_boyut(t.kind) { ver sol; }
    değişken op: tam32 = dizi_al(t.kind, p);
    eğer op == 12 { dizi_yaz(t.imlec, 0, p + 1); değişken s1: tam32 = toplama(t, s, f); eğer sol < s1 { ver 1; } ver 0; }
    eğer op == 13 { dizi_yaz(t.imlec, 0, p + 1); değişken s2: tam32 = toplama(t, s, f); eğer sol > s2 { ver 1; } ver 0; }
    eğer op == 14 { dizi_yaz(t.imlec, 0, p + 1); değişken s3: tam32 = toplama(t, s, f); eğer sol == s3 { ver 1; } ver 0; }
    ver sol;
}

// Fonksiyon çağrısı: argümanları değerlendir, kapsam it/bağla, gövdeyi yürüt.
işlev cagri_yap(t: &Tokenler, s: &Semboller, f: &Fonksiyonlar, ad: metin) -> tam32 {
    değişken p: tam32 = dizi_al(t.imlec, 0);
    dizi_yaz(t.imlec, 0, p + 2);                        // IDENT '(' tüket
    değişken a1: tam32 = 0; değişken a2: tam32 = 0;
    değişken q: tam32 = dizi_al(t.imlec, 0);
    eğer dizi_al(t.kind, q) != 6 {                      // argüman var
        a1 = ifade(t, s, f);
        eğer dizi_al(t.kind, dizi_al(t.imlec, 0)) == 18 {
            dizi_yaz(t.imlec, 0, dizi_al(t.imlec, 0) + 1);
            a2 = ifade(t, s, f);
        }
    }
    dizi_yaz(t.imlec, 0, dizi_al(t.imlec, 0) + 1);      // ')' tüket
    değişken resume: tam32 = dizi_al(t.imlec, 0);       // çağrı sonrası konum (YEREL)
    değişken fi: tam32 = fn_bul(f, ad);
    eğer fi < 0 { ver 0; }
    değişken marker: tam32 = dizi_al(s.ust, 0);         // kapsam tabanı
    değişken np: tam32 = dizi_al(f.np, fi);
    eğer np >= 1 { kapsam_it(s, dizi_al(f.p1, fi), a1); }
    eğer np >= 2 { kapsam_it(s, dizi_al(f.p2, fi), a2); }
    dizi_yaz(t.imlec, 0, dizi_al(f.govde, fi));         // gövde '{'e atla
    dizi_yaz(s.dondu, 0, 0);
    blok_calistir(t, s, f);                             // gövdeyi yürüt
    değişken rv: tam32 = dizi_al(s.donus, 0);
    dizi_yaz(s.dondu, 0, 0);                            // çağıran için sıfırla
    dizi_yaz(s.ust, 0, marker);                         // kapsamı pop et
    dizi_yaz(t.imlec, 0, resume);                       // imleci geri yükle
    ver rv;
}

// === Yürütücü ===
işlev blok_atla(t: &Tokenler) -> tam32 {
    değişken d: tam32 = 0;
    iken doğru {
        değişken p: tam32 = dizi_al(t.imlec, 0);
        eğer p >= dizi_boyut(t.kind) { ver 0; }
        değişken k: tam32 = dizi_al(t.kind, p);
        dizi_yaz(t.imlec, 0, p + 1);
        eğer k == 10 { d = d + 1; }
        eğer k == 11 { d = d - 1; eğer d == 0 { ver 0; } }
    }
    ver 0;
}
işlev islev_atla(t: &Tokenler) -> tam32 {
    iken doğru {
        değişken p: tam32 = dizi_al(t.imlec, 0);
        eğer p >= dizi_boyut(t.kind) { ver 0; }
        eğer dizi_al(t.kind, p) == 10 { ver blok_atla(t); }
        dizi_yaz(t.imlec, 0, p + 1);
    }
    ver 0;
}
işlev blok_calistir(t: &Tokenler, s: &Semboller, f: &Fonksiyonlar) -> tam32 {
    değişken p: tam32 = dizi_al(t.imlec, 0);
    dizi_yaz(t.imlec, 0, p + 1);                        // '{'
    iken doğru {
        eğer dizi_al(s.dondu, 0) == 1 { ver 0; }        // erken dönüş — unwind
        değişken q: tam32 = dizi_al(t.imlec, 0);
        eğer q >= dizi_boyut(t.kind) { ver 0; }
        eğer dizi_al(t.kind, q) == 11 { dizi_yaz(t.imlec, 0, q + 1); ver 0; }
        deyim_calistir(t, s, f);
    }
    ver 0;
}
işlev eger_calistir(t: &Tokenler, s: &Semboller, f: &Fonksiyonlar) -> tam32 {
    değişken p: tam32 = dizi_al(t.imlec, 0);
    dizi_yaz(t.imlec, 0, p + 2);
    değişken c: tam32 = ifade(t, s, f);
    dizi_yaz(t.imlec, 0, dizi_al(t.imlec, 0) + 1);
    eğer c != 0 { blok_calistir(t, s, f); } değilse { blok_atla(t); }
    eğer dizi_al(s.dondu, 0) == 1 { ver 0; }
    değişken q: tam32 = dizi_al(t.imlec, 0);
    eğer (q < dizi_boyut(t.kind)) ve (dizi_al(t.kind, q) == 16) {
        dizi_yaz(t.imlec, 0, q + 1);
        eğer c != 0 { blok_atla(t); } değilse { blok_calistir(t, s, f); }
    }
    ver 0;
}
işlev iken_calistir(t: &Tokenler, s: &Semboller, f: &Fonksiyonlar) -> tam32 {
    değişken p: tam32 = dizi_al(t.imlec, 0);
    dizi_yaz(t.imlec, 0, p + 2);
    değişken kosul_pos: tam32 = dizi_al(t.imlec, 0);
    iken doğru {
        eğer dizi_al(s.dondu, 0) == 1 { ver 0; }
        dizi_yaz(t.imlec, 0, kosul_pos);
        değişken c: tam32 = ifade(t, s, f);
        dizi_yaz(t.imlec, 0, dizi_al(t.imlec, 0) + 1);
        eğer c == 0 { blok_atla(t); ver 0; }
        blok_calistir(t, s, f);
    }
    ver 0;
}
işlev deyim_calistir(t: &Tokenler, s: &Semboller, f: &Fonksiyonlar) -> tam32 {
    değişken p: tam32 = dizi_al(t.imlec, 0);
    değişken k: tam32 = dizi_al(t.kind, p);
    eğer k == 15 { ver eger_calistir(t, s, f); }
    eğer k == 17 { ver iken_calistir(t, s, f); }
    eğer k == 19 {                                      // don ifade ;
        dizi_yaz(t.imlec, 0, p + 1);
        değişken v: tam32 = ifade(t, s, f);
        dizi_yaz(s.donus, 0, v); dizi_yaz(s.dondu, 0, 1);
        değişken q: tam32 = dizi_al(t.imlec, 0);
        eğer (q < dizi_boyut(t.kind)) ve (dizi_al(t.kind, q) == 9) { dizi_yaz(t.imlec, 0, q + 1); }
        ver 0;
    }
    eğer (k == 7) ve (dizi_al(t.kind, p + 1) == 8) {     // atama
        değişken ad: metin = dizi_al(t.ad, p);
        dizi_yaz(t.imlec, 0, p + 2);
        değişken v2: tam32 = ifade(t, s, f);
        kapsam_yaz(s, ad, v2);
        değişken q2: tam32 = dizi_al(t.imlec, 0);
        eğer (q2 < dizi_boyut(t.kind)) ve (dizi_al(t.kind, q2) == 9) { dizi_yaz(t.imlec, 0, q2 + 1); }
        ver 0;
    }
    ifade(t, s, f);                                     // ifade-deyimi (çağrı vb.)
    değişken q3: tam32 = dizi_al(t.imlec, 0);
    eğer (q3 < dizi_boyut(t.kind)) ve (dizi_al(t.kind, q3) == 9) { dizi_yaz(t.imlec, 0, q3 + 1); }
    ver 0;
}

işlev fonksiyonlari_kaydet(t: &Tokenler, f: &Fonksiyonlar) -> tam32 {
    dizi_yaz(t.imlec, 0, 0);
    iken doğru {
        değişken p: tam32 = dizi_al(t.imlec, 0);
        eğer p >= dizi_boyut(t.kind) { ver 0; }
        eğer dizi_al(t.kind, p) == 20 {                 // islev
            değişken ad: metin = dizi_al(t.ad, p + 1);
            dizi_yaz(t.imlec, 0, p + 3);                // islev, ad, '(' tüket
            değişken pp1: metin = ""; değişken pp2: metin = ""; değişken np: tam32 = 0;
            değişken q: tam32 = dizi_al(t.imlec, 0);
            eğer dizi_al(t.kind, q) == 7 {
                pp1 = dizi_al(t.ad, q); np = 1; dizi_yaz(t.imlec, 0, q + 1);
                eğer dizi_al(t.kind, dizi_al(t.imlec, 0)) == 18 {
                    dizi_yaz(t.imlec, 0, dizi_al(t.imlec, 0) + 1);
                    değişken q2: tam32 = dizi_al(t.imlec, 0);
                    pp2 = dizi_al(t.ad, q2); np = 2; dizi_yaz(t.imlec, 0, q2 + 1);
                }
            }
            dizi_yaz(t.imlec, 0, dizi_al(t.imlec, 0) + 1);   // ')' tüket
            değişken govde: tam32 = dizi_al(t.imlec, 0);
            dizi_ekle(f.ad, ad); dizi_ekle(f.p1, pp1); dizi_ekle(f.p2, pp2);
            dizi_ekle(f.np, np); dizi_ekle(f.govde, govde);
            blok_atla(t);
        } değilse {
            dizi_yaz(t.imlec, 0, p + 1);
        }
    }
    ver 0;
}

işlev calistir(kaynak: metin) -> tam32 {
    değişken t: Tokenler = Tokenler {
        kind: dizi_olustur(128), deger: dizi_olustur(128),
        ad: dizi_olustur(128), imlec: dizi_olustur(1)
    };
    lexle(kaynak, &t);
    dizi_ekle(t.imlec, 0);                              // imleç slot'u oluştur

    değişken f: Fonksiyonlar = Fonksiyonlar {
        ad: dizi_olustur(8), p1: dizi_olustur(8), p2: dizi_olustur(8),
        np: dizi_olustur(8), govde: dizi_olustur(8)
    };
    fonksiyonlari_kaydet(&t, &f);

    değişken s: Semboller = Semboller {
        ad: dizi_olustur(32), deger: dizi_olustur(32),
        ust: dizi_olustur(1), dondu: dizi_olustur(1), donus: dizi_olustur(1)
    };
    dizi_ekle(s.ust, 0); dizi_ekle(s.dondu, 0); dizi_ekle(s.donus, 0);

    dizi_yaz(t.imlec, 0, 0);                            // ana yürütme: imleç 0
    iken doğru {
        değişken p: tam32 = dizi_al(t.imlec, 0);
        eğer p >= dizi_boyut(t.kind) { ver 0; }
        değişken k: tam32 = dizi_al(t.kind, p);
        eğer k == 20 { islev_atla(&t); }               // fonksiyon tanımını atla
        değilse {
            değişken deyim_mi: mantıksal = yanlış;
            eğer (k == 7) ve (dizi_al(t.kind, p + 1) == 8) { deyim_mi = doğru; }
            eğer k == 15 { deyim_mi = doğru; }
            eğer k == 17 { deyim_mi = doğru; }
            eğer k == 19 { deyim_mi = doğru; }
            eğer deyim_mi { deyim_calistir(&t, &s, &f); }
            değilse { ver ifade(&t, &s, &f); }          // son ifade = sonuç
        }
    }
    ver 0;
}

işlev main() -> tam32 {
    ver calistir("islev fakt(n) { eger (n<2) { don 1; } don n*fakt(n-1); } fakt(5)-78") olarak tam32;
}
