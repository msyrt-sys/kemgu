// ============================================================================
// 15_agac_insa.kem — TAM DERLEYİCİ HATTI: lex → parse(AST İNŞA) → eval(AST gez).
//
// Self-hosting'in eksik orta parçası: parser artık değeri DOĞRUDAN hesaplamıyor;
// önce bir SOYUT SÖZDİZİM AĞACI (AST) İNŞA ediyor, sonra AYRI bir geçiş ağacı
// geziyor. Bu, gerçek bir derleyicinin yapısı (parse → AST → sonraki fazlar).
//
// AST temsili: İNDEKS-TABANLI ARENA — düğümler paralel Dizi<tam32>'lerde tutulur,
// çocuklar İNDEKS ile gösterilir (pointer değil). Bu, KEMGU'nun KENDİ derleyicisinin
// arena+AST modelinin birebir KEMGU'daki karşılığıdır (self-hosting'e en yakın).
//   tur[i]   düğüm türü   0=SAYI 1=ARTI 2=EKSI 3=CARPI 4=BOLU
//   deger[i] SAYI değeri
//   sol[i]   sol çocuğun indeksi   (yaprakta kullanılmaz)
//   sag[i]   sağ çocuğun indeksi
//
// Diziler `yapı` içinde paketlenip REFERANSLA aktarılır (struct + koleksiyon
// kompozisyonu). Konum imleci tek-elemanlı Dizi (dizi_yaz ile ilerletilir).
//
// Gramer (öncelik + parantez):
//   ifade=terim(('+'|'-')terim)* ; terim=faktör(('*'|'/')faktör)* ; faktör=SAYI|'('ifade')'
//
// Değerlendirilen:  "2+4*10"  →  AST: (+ 2 (* 4 10))  →  gez: 2+(4*10) = 42
// ============================================================================

yapı Agac {
    tur: Dizi<tam32>;
    deger: Dizi<tam32>;
    sol: Dizi<tam32>;
    sag: Dizi<tam32>;
}

yapı Tokenler {
    kind: Dizi<tam32>;
    deger: Dizi<tam32>;
    imlec: Dizi<tam32>;     // tek elemanlı: geçerli token konumu
}

işlev rakam_mi(b: tam8) -> mantıksal {
    değişken k: tam32 = b olarak tam32;
    ver k >= 48 ve k <= 57;
}

// LEXER — metni token akışına çevir (kind + deger paralel dizileri).
işlev lexle(ifade: metin, kindler: Dizi<tam32>, degerler: Dizi<tam32>) -> tam32 {
    değişken uz: tam32 = metin_uzunluk(ifade);
    değişken i: tam32 = 0;
    değişken sayi: tam32 = 0;
    değişken sayi_var: mantıksal = yanlış;
    değişken adet: tam32 = 0;
    iken i < uz {
        değişken b: tam8 = metin_bayt(ifade, i);
        eğer rakam_mi(b) {
            sayi = sayi * 10 + (b olarak tam32) - 48;
            sayi_var = doğru;
        } değilse {
            eğer sayi_var {
                dizi_ekle(kindler, 0); dizi_ekle(degerler, sayi);
                adet = adet + 1; sayi = 0; sayi_var = yanlış;
            }
            değişken tur: tam32 = 0;
            eğer b == 43 { tur = 1; }
            değilse eğer b == 45 { tur = 2; }
            değilse eğer b == 42 { tur = 3; }
            değilse eğer b == 47 { tur = 4; }
            değilse eğer b == 40 { tur = 5; }
            değilse eğer b == 41 { tur = 6; }
            eğer tur != 0 {
                dizi_ekle(kindler, tur); dizi_ekle(degerler, 0); adet = adet + 1;
            }
        }
        i = i + 1;
    }
    eğer sayi_var {
        dizi_ekle(kindler, 0); dizi_ekle(degerler, sayi); adet = adet + 1;
    }
    ver adet;
}

// AST'ye yeni düğüm ekle; YENİ düğümün indeksini döndür (arena = append-only).
işlev dugum_ekle(a: &Agac, tur: tam32, deger: tam32, sol: tam32, sag: tam32) -> tam32 {
    dizi_ekle(a.tur, tur);
    dizi_ekle(a.deger, deger);
    dizi_ekle(a.sol, sol);
    dizi_ekle(a.sag, sag);
    ver dizi_boyut(a.tur) - 1;
}

// faktör = SAYI | '(' ifade ')'   → AST düğüm indeksi döndürür
işlev faktor(a: &Agac, t: &Tokenler) -> tam32 {
    değişken p: tam32 = dizi_al(t.imlec, 0);
    değişken k: tam32 = dizi_al(t.kind, p);
    eğer k == 5 {                               // '('
        dizi_yaz(t.imlec, 0, p + 1);
        değişken v: tam32 = ifade(a, t);
        dizi_yaz(t.imlec, 0, dizi_al(t.imlec, 0) + 1);   // ')' tüket
        ver v;
    }
    dizi_yaz(t.imlec, 0, p + 1);                 // SAYI tüket
    ver dugum_ekle(a, 0, dizi_al(t.deger, p), -1, -1);   // SAYI yaprağı
}

// terim = faktör ( ('*'|'/') faktör )*   → AST düğüm indeksi
işlev terim(a: &Agac, t: &Tokenler) -> tam32 {
    değişken sol: tam32 = faktor(a, t);
    iken doğru {
        değişken p: tam32 = dizi_al(t.imlec, 0);
        eğer p >= dizi_boyut(t.kind) { ver sol; }
        değişken op: tam32 = dizi_al(t.kind, p);
        eğer op == 3 {                          // '*'
            dizi_yaz(t.imlec, 0, p + 1);
            sol = dugum_ekle(a, 3, 0, sol, faktor(a, t));
        } değilse eğer op == 4 {                 // '/'
            dizi_yaz(t.imlec, 0, p + 1);
            sol = dugum_ekle(a, 4, 0, sol, faktor(a, t));
        } değilse {
            ver sol;
        }
    }
    ver sol;
}

// ifade = terim ( ('+'|'-') terim )*   → AST düğüm indeksi (kök)
işlev ifade(a: &Agac, t: &Tokenler) -> tam32 {
    değişken sol: tam32 = terim(a, t);
    iken doğru {
        değişken p: tam32 = dizi_al(t.imlec, 0);
        eğer p >= dizi_boyut(t.kind) { ver sol; }
        değişken op: tam32 = dizi_al(t.kind, p);
        eğer op == 1 {                          // '+'
            dizi_yaz(t.imlec, 0, p + 1);
            sol = dugum_ekle(a, 1, 0, sol, terim(a, t));
        } değilse eğer op == 2 {                 // '-'
            dizi_yaz(t.imlec, 0, p + 1);
            sol = dugum_ekle(a, 2, 0, sol, terim(a, t));
        } değilse {
            ver sol;
        }
    }
    ver sol;
}

// EVALUATOR — AST'yi indeksten kök alarak ÖZYİNELEMELİ gez (ayrı faz).
işlev degerlendir_dugum(a: &Agac, idx: tam32) -> tam32 {
    değişken t: tam32 = dizi_al(a.tur, idx);
    eğer t == 0 { ver dizi_al(a.deger, idx); }          // SAYI yaprağı
    değişken sol: tam32 = degerlendir_dugum(a, dizi_al(a.sol, idx));
    değişken sag: tam32 = degerlendir_dugum(a, dizi_al(a.sag, idx));
    eğer t == 1 { ver sol + sag; }
    eğer t == 2 { ver sol - sag; }
    eğer t == 3 { ver sol * sag; }
    eğer t == 4 { ver sol / sag; }
    ver 0;
}

// Tam hat: lex → parse(AST inşa) → eval(AST gez).
işlev coz(metin_ifade: metin) -> tam32 {
    değişken t: Tokenler = Tokenler {
        kind: dizi_olustur(32),
        deger: dizi_olustur(32),
        imlec: dizi_olustur(1)
    };
    lexle(metin_ifade, t.kind, t.deger);
    dizi_ekle(t.imlec, 0);                       // imleç konumu 0

    değişken a: Agac = Agac {
        tur: dizi_olustur(32),
        deger: dizi_olustur(32),
        sol: dizi_olustur(32),
        sag: dizi_olustur(32)
    };
    değişken kok: tam32 = ifade(&a, &t);         // parse → AST kökü
    ver degerlendir_dugum(&a, kok);              // AST gez → değer
}

işlev main() -> tam32 {
    ver coz("2+4*10") olarak tam32;              // (+ 2 (* 4 10)) = 42
}
