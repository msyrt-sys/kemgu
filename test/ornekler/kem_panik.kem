// =====================================================================
// kem_panik.kem — KEMGU-OS Faz-2b KEŞİF: .kem-native PANİK katmanı prototipi
// ---------------------------------------------------------------------
// SORU: .kem bir panik-handler ifade edebilir mi — mesaj bas + sistemi
//       güvenli DURDUR (halt)?
//
// C karşılığı: runtime/kdl_runtime_panik.c → kdl_panik_dur(mesaj):
//   1) UART'a "PANIK: <mesaj>" yaz
//   2) sonsuz halt loop (aarch64: wfe / x86: hlt)
//
// Bu prototip AYNI davranışı SAF .kem'de ifade eder:
//   1) yazdir_metin ile panik mesajını bas
//   2) `iken doğru { }` sonsuz spin-halt (inline-asm wfe/wfi GEREKMEZ)
//
// KEŞİF SONUCU (language_gap): mesaj-bas + spin-halt tamamen .kem'de
// ifade edilebilir. TEK gap: `wfe`/`wfi` düşük-güç bekleme inline-asm
// ister (C8 arch-gap) — spin-halt fonksiyonel olarak yeterli (CPU dur),
// yalnız güç-tasarrufu için wfe daha iyi. integ_ready = true.
//
// Bu faz ENTEGRASYON DEĞİL — kem_os.kem'e DOKUNULMADI. Ayrı prototip.
//
// Derleme (RECIPE, NAME=kem_panik):
//   ./build/kemgu.exe --llvm test/ornekler/kem_panik.kem > build/kem_panik.ll
//   clang -target aarch64-unknown-none -ffreestanding -nostdlib -O2 \
//         -Wno-override-module -x ir build/kem_panik.ll -c -o build/kem_panik.o
//   ld.lld -m aarch64linux -T linker/bare-metal-aarch64.ld -o build/kem_panik.elf \
//         build/kem_panik.o build/bm_a64_*.o
//   timeout 10 qemu-system-aarch64 -M virt -cpu cortex-a72 -display none \
//         -serial file:build/kem_panik.out -kernel build/kem_panik.elf
// =====================================================================

// ==================== .kem-native PANİK HANDLER ====================
// kdl_panik_dur(mesaj)'ın SAF .kem ikizi: mesaj bas + sonsuz spin-halt.
// `iken doğru { }` — dönmeyen (NORETURN-eşdeğeri) sonsuz döngü. CPU burada
// takılır → QEMU timeout yapar (BEKLENEN: halt yakalandı).
işlev panik(mesaj: metin) {
    yazdir_metin("");                    // önceki satırı ayır (C kdl_panik '\n')
    yazdir_metin("PANIK: ");
    yazdir_metin(mesaj);
    // ---- HALT: sonsuz spin. Buradan ASLA dönülmez (C: wfe/hlt loop). ----
    iken doğru {
    }
}

// ==================== ÇEKİRDEK ====================
işlev main() -> tam32 {
    // Normal iş: panik'ten önce çekirdek çalışıyor olduğunu göster.
    yazdir_metin("=== KEMGU .kem-OS PANIK katmani prototipi ===");
    yazdir_metin("[1] BOOT OK");

    // Biraz gerçek hesap yap (çekirdek canlı — sahte-ilerleme değil).
    değişken toplam: tam32 = 0;
    değişken i: tam32 = 1;
    iken i <= 10 {
        toplam = toplam + i;
        i = i + 1;
    }
    yazdir_metin("[2] HESAP OK");
    yazdir_tam(toplam);                  // 55

    // Panik'e girmeden HEMEN ÖNCE kanıt-marker (halt'tan önce basılan son ok).
    yazdir_metin("KEM PANIK OK");

    // BİLEREK panik tetikle — kurtarılamaz hata simülasyonu.
    panik("bilerek tetiklendi");

    // ---- ULAŞILAMAZ: panik() dönmez (sonsuz halt). ----
    ver 0;
}
