// =====================================================================
// kem_exc.kem — KEMGU-OS Faz-2b KEŞİF: exception-HANDLER MANTIĞI .kem-de
// ---------------------------------------------------------------------
// ASIL SORU: Bir CPU fault olduğunda çalışan HANDLER MANTIĞI — yani
// ESR/FAR alıp fault TÜRÜNÜ çıkaran + teşhis basan + karar veren kısım —
// saf .kem-de yazılabilir mi?  (C runtime karşılığı: kdl_kesme.c
// kdl_istisna_isle handler-i; vektör-tablosu + bağlam-kaydetme HARİÇ.)
//
// SINIR (mimari, .kem-de OLAMAZ): exception VEKTÖR TABLOSU + bağlam
// kaydetme boot/start_aarch64.S asm-dedir (VBAR giriş noktaları + trap
// frame stp/ldp inline-asm gerektirir). Bu prototip: o asm-stub'un
// ÇAĞIRACAĞI handler MANTIĞInı .kem-de yazar. Fault-bilgisi (ESR/FAR)
// asm-stub'dan argüman olarak gelir → burada SENTETİK değerlerle test.
//
// C referans (kdl_kesme.c:72-100 kdl_istisna_isle):
//   - tip = EC (ESR[31:26]); a/b = ESR/ELR; adr = FAR_EL1 mrs ile okunur
//   - "ISTISNA tip=0x.. a=0x.. b=0x.. adr=0x.." bas → sonsuz halt
// Bu .kem versiyonu AYNI decode'u yapar AMA fault SINIFINI de ayırır
// (data-abort / instr-abort / diğer + translation vs permission alt-tür)
// → daha zengin teşhis, yine saf .kem aritmetik/maske/dallanma.
//
// FAR/ESR tipi dtam64 (unsigned 64-bit) — donanım register'ları işaretsiz;
// >> maske aritmetiği işaretsiz olmalı + yazdir_onaltilik(dtam64) imzası.
//
// Marker: "KEM EXC OK" + çözümlenen fault türü + FAR adresi.
// Çıktı yolu: C runtime yazdir_metin/yazdir_onaltilik (görev izni;
// bu keşifte prototiplenen şey HANDLER MANTIĞI, çıktı-yolu değil).
// =====================================================================

// ---- ESR_EL1 kod sabitleri (ARMv8 D17.2.37) ----
// EC = ESR[31:26] alanı (exception class).
sabit EC_INSTR_ABORT_EL0: dtam64 = 32;   // 0x20 instr abort, lower EL
sabit EC_INSTR_ABORT_EL1: dtam64 = 33;   // 0x21 instr abort, same EL
sabit EC_DATA_ABORT_EL0: dtam64  = 36;   // 0x24 data abort, lower EL
sabit EC_DATA_ABORT_EL1: dtam64  = 37;   // 0x25 data abort, same EL
sabit EC_SVC64: dtam64           = 21;   // 0x15 SVC (sistem çağrısı)

// DFSC = ISS[5:0] fault status code (data/instr abort için).
// 0x04-0x07 = translation fault (haritasız sayfa — demand-paging)
// 0x0D-0x0F = permission fault (izolasyon ihlali — EL0 kernel erişimi)

// ---- Alan çıkarıcılar (saf .kem bit-aritmetiği, işaretsiz) ----
// EC = ESR >> 26   (üst 6 bit)
işlev esr_ec(esr: dtam64) -> dtam64 {
    ver esr / 67108864;         // >> 26  (2^26 = 67108864)
}

// DFSC = ESR & 0x3F   (alt 6 bit) — abort fault-status alt-türü
işlev esr_dfsc(esr: dtam64) -> dtam64 {
    ver esr - ((esr / 64) * 64); // esr mod 64  = alt 6 bit
}

// Fault SINIFI kararı (handler'ın asıl "karar verme" mantığı):
//   0 = SVC (sistem çağrısı — fault değil)
//   1 = instruction abort  (kod-getirme hatası)
//   2 = data abort         (veri erişim hatası)
//   9 = diğer/bilinmeyen istisna
işlev fault_sinifi(esr: dtam64) -> tam32 {
    değişken ec: dtam64 = esr_ec(esr);
    eğer ec == EC_SVC64 {
        ver 0;
    } değilse eğer (ec == EC_INSTR_ABORT_EL0) veya (ec == EC_INSTR_ABORT_EL1) {
        ver 1;
    } değilse eğer (ec == EC_DATA_ABORT_EL0) veya (ec == EC_DATA_ABORT_EL1) {
        ver 2;
    } değilse {
        ver 9;
    }
}

// Fault ALT-türü (abort'lar için translation mi permission mi):
//   0 = alt-tür yok / uygulanmaz
//   1 = translation fault (haritasız — demand-paging adayı)
//   2 = permission fault  (izolasyon ihlali — süreç öldür adayı)
//   3 = diğer abort alt-türü
işlev abort_alt_tur(esr: dtam64) -> tam32 {
    değişken s: tam32 = fault_sinifi(esr);
    eğer (s != 1) ve (s != 2) {
        ver 0;                  // abort değil → alt-tür yok
    }
    değişken dfsc: dtam64 = esr_dfsc(esr);
    eğer (dfsc >= 4) ve (dfsc <= 7) {
        ver 1;                  // translation fault
    } değilse eğer (dfsc >= 13) ve (dfsc <= 15) {
        ver 2;                  // permission fault
    } değilse {
        ver 3;
    }
}

// Handler KARARI (kurtar / öldür / halt) — gerçek OS semantiği:
//   1 = KURTAR   (data-abort + translation → demand-paging map + devam)
//   2 = OLDUR    (permission fault → izolasyon ihlali, süreci öldür)
//   3 = HALT     (kurtarılamaz — kernel-fault teşhis + dur)
işlev handler_karari(esr: dtam64) -> tam32 {
    değişken s: tam32 = fault_sinifi(esr);
    değişken alt: tam32 = abort_alt_tur(esr);
    eğer (s == 2) ve (alt == 1) {
        ver 1;                  // data-abort + translation → KURTAR
    } değilse eğer alt == 2 {
        ver 2;                  // permission → OLDUR
    } değilse {
        ver 3;                  // diğer → HALT
    }
}

// ==== HANDLER MANTIĞI (asm-stub'un çağıracağı .kem işlevi) ====
// C kdl_istisna_isle karşılığı: FAR + ESR alıp teşhis basar + kararı döner.
// (C'de FAR mrs ile okunur; burada asm-stub argüman olarak geçirir → 2b'de
// sentetik.) Dönüş = handler_karari (asm-stub buna göre eret/halt yapar).
işlev kem_istisna_isle(far: dtam64, esr: dtam64) -> tam32 {
    yazdir_metin("ISTISNA ESR=0x");
    yazdir_onaltilik(esr);
    yazdir_metin(" FAR=0x");
    yazdir_onaltilik(far);
    yazdir_satir();

    değişken sinif: tam32 = fault_sinifi(esr);
    eğer sinif == 1 {
        yazdir_metin("  sinif: INSTR-ABORT");
    } değilse eğer sinif == 2 {
        yazdir_metin("  sinif: DATA-ABORT");
    } değilse eğer sinif == 0 {
        yazdir_metin("  sinif: SVC");
    } değilse {
        yazdir_metin("  sinif: DIGER");
    }
    yazdir_satir();

    değişken alt: tam32 = abort_alt_tur(esr);
    eğer alt == 1 {
        yazdir_metin("  alt-tur: TRANSLATION (haritasiz)");
    } değilse eğer alt == 2 {
        yazdir_metin("  alt-tur: PERMISSION (izolasyon)");
    } değilse eğer alt == 3 {
        yazdir_metin("  alt-tur: DIGER-ABORT");
    } değilse {
        yazdir_metin("  alt-tur: -");
    }
    yazdir_satir();

    değişken karar: tam32 = handler_karari(esr);
    eğer karar == 1 {
        yazdir_metin("  karar: KURTAR (demand-page)");
    } değilse eğer karar == 2 {
        yazdir_metin("  karar: OLDUR (surec-izolasyon)");
    } değilse {
        yazdir_metin("  karar: HALT (kernel-fault)");
    }
    yazdir_satir();

    ver karar;
}

işlev main() -> tam32 {
    yazdir_metin("=== KEM EXC (handler mantigi .kem-de) ===");
    yazdir_satir();

    // Sentetik fault #1: data-abort + translation fault (haritasız sayfa).
    // ESR: EC=0x25 (data abort same-EL) << 26 | DFSC=0x04 (level-0 translation)
    //   = 0x25 * 2^26 + 0x04 = 0x96000004 = 2516582404
    // FAR = 0x40000000 = 1073741824 (erişilen haritasız adres). → KURTAR beklenir.
    değişken k1: tam32 = kem_istisna_isle(1073741824, 2516582404);

    // Sentetik fault #2: data-abort + permission fault (EL0 kernel erişimi).
    // ESR: EC=0x24 (data abort lower-EL) << 26 | DFSC=0x0D (level-1 permission)
    //   = 0x24 * 2^26 + 0x0D = 0x9200000D = 2449473549
    // FAR = 0x1000 = 4096 (kernel sayfası). → OLDUR beklenir.
    değişken k2: tam32 = kem_istisna_isle(4096, 2449473549);

    // Sentetik fault #3: instruction abort (kurtarılamaz kod-getirme). → HALT.
    // ESR: EC=0x21 (instr abort same-EL) << 26 | DFSC=0x00
    //   = 0x21 * 2^26 = 0x84000000 = 2214592512
    // FAR = 0x80000000 = 2147483648
    değişken k3: tam32 = kem_istisna_isle(2147483648, 2214592512);

    // Doğrulama: kararlar sırasıyla KURTAR(1), OLDUR(2), HALT(3) olmalı.
    eğer (k1 == 1) ve (k2 == 2) ve (k3 == 3) {
        yazdir_metin("KEM EXC OK kararlar=1,2,3 son-FAR=0x");
        yazdir_onaltilik(2147483648);   // fault #3 FAR = 0x80000000
        yazdir_satir();
    } değilse {
        yazdir_metin("KEM EXC HATA");
        yazdir_satir();
    }

    ver 0;
}
