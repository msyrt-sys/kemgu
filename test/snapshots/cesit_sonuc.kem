// C2.7 fikstürü — D6 deseni: sonuç<bos, çeşit> (isimli hata tipi).
// hata(BaslatHatasi::Variant) inşa + eşleş'te tag==hata AND disc==idx
// (bir-seviye nesting). tamam(bos) + tüm hata varyantları kapsanır
// (exhaustive). opt -passes=verify temiz.

çeşit BaslatHatasi { ModernDegil, BlokDegil, FeatureYok }

işlev blk_baslat(ok: tam32) -> sonuç<bos, BaslatHatasi> {
    eğer ok == 1 { ver tamam(boş); }
    eğer ok == 2 { ver hata(BaslatHatasi::ModernDegil); }
    eğer ok == 3 { ver hata(BaslatHatasi::BlokDegil); }
    ver hata(BaslatHatasi::FeatureYok);
}

işlev sonucu_yorumla(ok: tam32) -> tam32 {
    eşleş blk_baslat(ok) {
        tamam(v)                       => { ver 100; }
        hata(BaslatHatasi::ModernDegil) => { ver 200; }
        hata(BaslatHatasi::BlokDegil)   => { ver 210; }
        hata(BaslatHatasi::FeatureYok)  => { ver 220; }
    }
    ver 0;
}

işlev main() -> tam32 {
    eğer sonucu_yorumla(1) != 100 { ver 1; }
    eğer sonucu_yorumla(2) != 200 { ver 2; }
    eğer sonucu_yorumla(3) != 210 { ver 3; }
    eğer sonucu_yorumla(4) != 220 { ver 4; }
    ver 42;
}
