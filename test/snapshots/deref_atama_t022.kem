// Matris B (D-248 GAP-2): *p = v — GÜVENSİZ blokta ARTIK İZİNLİ (deref-write).
// Ham pointer üzerinden yazma yalnız güvensiz (MMIO/heap); güvensiz DIŞINDA hâlâ
// T022-red (bkz deref_atama_disi.kem). Bu dosya --check GEÇMELİ.
işlev kur(p: *tam32) -> tam32 {
    güvensiz { *p = 42; }
    ver 0;
}

işlev main() -> tam32 {
    değişken v: tam32 = 0;
    ver 0;
}
