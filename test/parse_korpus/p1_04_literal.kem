işlev a() -> tam32 { ver 42 + 0xFF + 0b1010 + 0o755 + 1_000_000; }
işlev b() -> tam32 { ver doğru + yanlış + boş; }
işlev c() -> tam32 { ver "merhaba dünya" + "türkçe çğıöşü"; }
işlev d() -> tam32 { ver 'a' + 'Z' + 'ç' + '0'; }
işlev e() -> tam32 { ver hiç + değer + tamam + hata + kendin; }
işlev f() -> tam32 { ver 0xDEAD_BEEF + 0XABCDEF; }
