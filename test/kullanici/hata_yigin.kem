// Her özyineleme bir sayfalık yığın çerçevesi açar; koruma sayfasında #PF.
işlev kullanici_main(argc: tam64,argv: tam64) -> tam64 {
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"movq $$0x541ff000, %rsp
1: subq $$4088, %rsp
call 1b
ud2"#
            bozulan("~{cc}") bozulan("~{memory}")
        }
        ver 91;
    }
}
