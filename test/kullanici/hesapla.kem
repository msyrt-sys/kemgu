kullan drivers::uygulama::hesapla::{ ifade_hesapla };
işlev kullanici_main(argc: tam64,argv: tam64) -> tam64 {
    değişken m: metin = ""; değişken i: tam64 = 1;
    iken i < argc { m=metin_birlestir(metin_birlestir(m," "),sis_argv(argv,i)); i=i+1; }
    eşleş ifade_hesapla(m) {
        hata(e) => { sis_metin(metin_birlestir("HATA ",e)); sis_bayt_yaz(1,10); ver 2; }
        tamam(n) => { sis_metin(tam_metin(n)); sis_bayt_yaz(1,10); ver 0; }
    }
}
