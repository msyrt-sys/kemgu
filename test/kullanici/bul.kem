kullan drivers::uygulama::bul::{ satirda_bul };
işlev bul_oku(fd: tam64,yol: metin,aranan: metin,katla: mantıksal,adli: mantıksal,p: tam64,satir: tam64) -> tam64 {
    değişken sira: tam64 = 1; değişken boy: tam64 = 0; değişken adet: tam64 = 0;
    iken doğru {
        değişken n: tam64 = sis_oku(fd,p,1024);
        eğer n < 0 { ver -1; }
        değişken i: tam64 = 0;
        iken i < n veya (n == 0 ve boy > 0) {
            değişken b: tam32 = 10; eğer i < n { b=sis_bayt_al(p+i); }
            eğer b == 10 {
                sis_bayt_koy(satir+boy,0);
                eğer satirda_bul(sis_dize(satir),aranan,katla) {
                    eğer adli { eğer sis_metin(yol) < 0 veya sis_bayt_yaz(1,58) != 1 { ver -1; } }
                    eğer sis_metin(tam_metin(sira)) < 0 veya sis_bayt_yaz(1,58) != 1 veya sis_yaz(1,satir,boy) != boy veya sis_bayt_yaz(1,10) != 1 { ver -1; }
                    adet=adet+1;
                }
                boy=0; sira=sira+1;
            } değilse {
                eğer boy >= 4096 veya b == 0 { ver -2; } sis_bayt_koy(satir+boy,b); boy=boy+1;
            }
            i=i+1;
        }
        eğer n == 0 { ver adet; }
    } ver -1;
}
işlev kullanici_main(argc: tam64,argv: tam64) -> tam64 { güvensiz {
    değişken a: tam64 = 1; değişken katla: mantıksal = yanlış;
    eğer argc > 1 { değişken secenek: metin = sis_argv(argv,1);
        eğer metin_uzunluk(secenek) == 2 ve metin_bayt(secenek,0) == 45 ve metin_bayt(secenek,1) == 105 { katla=doğru; a=2; }
    }
    eğer a >= argc { sis_metin("bul [-i] metin [dosya...]"); sis_bayt_yaz(1,10); ver 2; }
    değişken aranan: metin = sis_argv(argv,a); a=a+1;
    değişken p: tam64 = malloc(5121) olarak tam64; eğer p == 0 { ver 3; }
    değişken adli: mantıksal = argc-a > 1; değişken toplam: tam64 = 0;
    iken doğru {
        değişken yol: metin = ""; değişken fd: tam64 = 0;
        eğer a < argc { yol=sis_argv(argv,a); fd=sis_ac(yol,0); }
        eğer fd < 0 { sis_metin(metin_birlestir("HATA dosya ",yol)); sis_bayt_yaz(1,10); ver 2; }
        değişken n: tam64 = bul_oku(fd,yol,aranan,katla,adli,p,p+1024);
        eğer a < argc { sis_kapat(fd); }
        eğer n < 0 { sis_metin("HATA metin okuma veya 4096 bayt satir siniri"); sis_bayt_yaz(1,10); ver 2; }
        toplam=toplam+n; a=a+1; eğer a >= argc { eğer toplam == 0 { ver 1; } ver 0; }
    } ver 2;
} }
