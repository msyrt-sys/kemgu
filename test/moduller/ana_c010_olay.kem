kullan c010_olay::{TusOlayi, Secim};
işlev main() -> tam32 {
    değişken a: TusOlayi = TusOlayi::Karakter(65);
    değişken b: TusOlayi = TusOlayi::Karakter(203);
    değişken c: TusOlayi = TusOlayi::Karakter(8589934592);
    eğer c010_olay::oku(a) != 65 { ver 1; }
    eğer c010_olay::oku(b) != 203 { ver 2; }
    eğer c010_olay::oku(c) != 8589934592 { ver 3; }
    // Pozitif: yüksüz ilk ve farklı yüklü son varyant da doğru çözülmeli.
    değişken bos: TusOlayi = TusOlayi::Bos;
    değişken kod: TusOlayi = TusOlayi::Kod(41);
    eğer c010_olay::oku(bos) != 0 { ver 4; }
    eğer c010_olay::oku(kod) != 42 { ver 5; }
    değişken s: Secim<tam64> = Secim::Var(8589934592);
    eşleş s {
        Secim::Yok => { ver 6; }
        Secim::Var(n) => { eğer n != 8589934592 { ver 7; } }
    }
    ver 42;
}
