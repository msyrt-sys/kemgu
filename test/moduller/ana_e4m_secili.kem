// [D-756] E4m: (1) seçili ithal edilen GENERIC yapı İŞLEV İMZASINDA (C eskiden T011+T001;
// self doğruydu) · (2) modülle aynı adlı üye (`e4m_kap::{ e4m_kap }`) eskiden iki
// derleyicide T024 — artık ad ÜYEYE aittir. tam64 + 2^33: genişlik kaybı exit'te görünür.
kullan e4m_kap::{ Kap, e4m_kap, kap_yap };
işlev yap(x: tam64) -> Kap<tam64> { ver Kap { v: x }; }
işlev al(k: Kap<tam64>) -> tam64 { ver k.v; }
işlev main() -> tam32 {
    eğer e4m_kap(41) != 42 { ver 1; }
    eğer al(yap(8589934592)) != 8589934592 { ver 2; }
    eğer al(kap_yap(8589934593)) != 8589934593 { ver 3; }
    ver 42;
}
