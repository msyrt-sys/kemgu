// D dilim-1 HEADLINE: nitelikli tip annotation çapraz-dosya generic'i T'siz
// ÜRETİM imzasıyla kullanılabilir yapar. `değişken l: dizi::Liste<tam64>`
// annotation'ı T=tam64'ü RHS cross-module çağrıya (dizi::oluştur) besler —
// oluştur(böl: yetki<Bellek>) -> Liste<T> paramlarında T YOK (witness YOK).
//
// Akış: oluştur → ekle×5 (kapasite 0→4→8, büyü transitif + eleman-kopyalı
//   grow). ekle 10,1,1,1 (cap 0→4); ekle 32 → büyü cap 4→8 ([10,1,1,1] kopya),
//   idx4=32. boy=5 (annotation yan-kanalı → @dizi.boy$i64), al(0)=10, al(4)=32.
//   al(9)=sınır-dışı→sifir. 10+32 = 42.
kullan dizi;

işlev main() -> tam32 {
    değişken sifir: tam64 = 0;
    değişken l: dizi::Liste<tam64> = dizi::oluştur(yetki_olustur(3, 3));
    dizi::ekle(&l, yetki_olustur(3, 3), 10 olarak tam64);
    dizi::ekle(&l, yetki_olustur(3, 3), 1 olarak tam64);
    dizi::ekle(&l, yetki_olustur(3, 3), 1 olarak tam64);
    dizi::ekle(&l, yetki_olustur(3, 3), 1 olarak tam64);
    dizi::ekle(&l, yetki_olustur(3, 3), 32 olarak tam64);
    eğer dizi::boy(&l) != (5 olarak tam64) { ver 50; }
    eğer dizi::al(&l, 9, sifir) != sifir { ver 51; }   // sınır-dışı çökmezlik
    değişken s: tam64 = dizi::al(&l, 0, sifir) + dizi::al(&l, 4, sifir);
    ver s olarak tam32;
}
