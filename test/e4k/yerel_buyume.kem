// [D-770] E4k-A: yardımcının YEREL dizisinin büyütme tamponları çağıranın bölgesine
// (zincir boyunca main'in = ana bölgeye) sızıyordu: çağrı başına ~496 bayt (16+32+64+128+256).
// Tampon artık dizinin KENDİ bölgesinden ayrılır → 4000 çağrıda ana bölge büyümez.
işlev f(n: tam32) -> tam32 {
    değişken d: Dizi<tam32> = [];
    değişken j: tam32 = 0;
    iken j < 64 { dizi_ekle(d, n + j); j = j + 1; }
    ver dizi_al(d, 63);
}
işlev main() -> tam32 {
    değişken t: tam64 = 0;
    değişken i: tam32 = 0;
    iken i < 4000 {
        t = t + (f(i) olarak tam64);
        i = i + 1;
    }
    eğer t < 0 { ver 1; }
    ver 0;
}
