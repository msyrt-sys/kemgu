// RHO_BEKLE: 0
// [D-807] P5, yön ucu PARAMETRESİ: ana iş parçacığı diziyi kanaldan GÖNDERİP elinde tutar;
// görevin çağırdığı yardımcı onu `alan<Dizi<T>>` ucundan alıp büyütür (yeni tampon
// ρ_sahip'te, D-770) ve SKALER döner. Kanıt bölgeyi serbest bırakırsa `d` serbest belleği
// gösterir → bayrak 0 OLMALI. r07'nin `kanal<T>` yerine `alan<T>` sürümü: self'in yön ucu
// yükünü denetlemeden kabul etmesi burada UAF olur (ASan kapının parçası).
// Self `alan<T>` iç tipini bilmeden önce bu dosya self'te LINK-RED'di (`store ptr %<i64>`).
işlev buyut(u: alan<Dizi<tam32>>) -> tam32 {
    değişken x: Dizi<tam32> = kanal_al(u);
    değişken j: tam32 = 0;
    iken j < 1000 { dizi_ekle(x, j); j = j + 1; }
    ver 0;
}
işlev main() -> tam32 {
    değişken k: kanal<Dizi<tam32>> = kanal_oluştur(1);
    değişken d: Dizi<tam32> = [1];
    kanal_gönder(k, d);
    eşleş görev_başlat(|| buyut(alan(k))) {
        tamam(g) => {
            değişken z: tam32 = görev_birleştir(g);
            eğer dizi_boyut(d) != 1001 { ver 3; }
            ver dizi_al(d, 1000) + z - 957;
        }
        hata(e) => { ver 1; }
    }
    ver 99;
}
