// [D-807] P5 — aynı açık, `kanal_al` doğrudan görev gövdesinde. Eski C: bayrak 1, normal koşum exit 42,
// ASan heap-use-after-free (SESSİZ UAF). Yalnız YAPISAL ölçülür (self bağlanamıyor — G21).
// RHO_BEKLE: 0
// KOSUM: yok (G21: self lambda içinde yakalanan kanalın iç tipini bilmiyor → i64→ptr daraltması yok, bağlanamıyor)
işlev main() -> tam32 {
    değişken k: kanal<Dizi<tam32>> = kanal_oluştur(1);
    değişken d: Dizi<tam32> = [1];
    kanal_gönder(k, d);
    eşleş görev_başlat(|| {
        değişken a: Dizi<tam32> = kanal_al(k);
        değişken j: tam32 = 0;
        iken j < 1000 { dizi_ekle(a, j); j = j + 1; }
        ver 0;
    }) {
        tamam(g) => {
            değişken z: tam32 = görev_birleştir(g);
            eğer dizi_boyut(d) != 1001 { ver 3; }
            ver dizi_al(d, 1000) + z - 957;
        }
        hata(e) => { ver 1; }
    }
    ver 99;
}
