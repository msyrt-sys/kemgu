// RHO_BEKLE: 0
// [D-809] P4 (self) — görev, YAKALANAN bir kapanışı ADIYLA çağırıyor ve sonucu bir değişkene
// alıyor (P1 `ver z` ile geçer). Kapanışın gövdesi görevin bölgesinde (ρ_sahip) bir dizi kurup
// kanala gönderir; ana iş parçacığı onu join'den sonra okur. Çağrı DOLAYLIDIR, gövde bilinmez →
// kanıt düşmeli. Eski self hedefin yalnız düğüm türüne bakıyordu (tanımlayıcı = doğrudan) ve
// kapanışın gövdesini hiç taramıyordu: bayrak 1, ASan heap-use-after-free; C 0.
işlev main() -> tam32 {
    değişken k: kanal<Dizi<tam32>> = kanal_oluştur(1);
    değişken f: işlev() -> tam32 = || {
        değişken d: Dizi<tam32> = [40, 2];
        kanal_gönder(k, d);
        ver 0;
    };
    eşleş görev_başlat(|| { değişken z: tam32 = f(); ver z; }) {
        tamam(g) => {
            değişken z: tam32 = görev_birleştir(g);
            değişken x: Dizi<tam32> = kanal_al(k);
            ver dizi_al(x, 0) + dizi_al(x, 1) + z;
        }
        hata(h) => { ver 1; }
    }
    ver 99;
}
