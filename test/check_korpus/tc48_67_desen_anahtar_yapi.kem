// [D-799] Yapı deseni YALNIZ düz tanımlayıcı adla açılır (C parser.c:1400). `hiç { a }` C'de tanımlayıcı
// desen + `=>` beklentisi (P220) + blok gövdesidir. Öncesinde self bunu yapı deseni sayıp SESSİZCE
// kabul ediyordu (`OK`) — C reddederken self'in kabul ettiği bir şekil.
işlev main() -> tam32 {
    değişken s: seçimlik<tam32> = hiç;
    eşleş s { hiç { a } => 1; _ => 2; }
    ver 0;
}
