// [D-466] DOĞRU kullanım — tanı ÜRETMEMELİ.
// ⚠ POZİTİF ŞEKİL ŞART: yalnız negatif fikstür koysaydım, kuralı toptan
// sıkılaştıran bir sabotaj (her şeyi reddet) kapıdan GEÇERDİ — D-425'in dersi.
yapı tekkez Baglanti { h: metin; }

işlev kapat(b: Baglanti) -> tam32 {
    değişken hh: metin = b.h;
    imha(b);
    ver soket_kapat(hh);
}

işlev main() -> tam32 {
    değişken y: yetki<Soket> = yetki_olustur(2, 3);
    değişken h: metin = soket_baglan(y, "127.0.0.1", 9);
    geri_al(y);
    değişken b: Baglanti = Baglanti { h: h };
    kapat(b);      // TAM BİR KEZ
    ver 42;
}
