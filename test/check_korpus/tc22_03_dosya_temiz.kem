// [D-452] DOGRU kullanim: her kolda tam bir kez tuketilir. Tani BEKLENMEZ.
// Negatif fiksturlerin yaninda POZITIF sekil sart — yoksa "her seyi reddet"
// gibi toptan bir sikilastirma kapiyi GECERDI (D-425'in dersi).
yapı tekkez Dosya { h: metin; }

işlev ac(yol: metin) -> sonuç<Dosya, metin> {
    değişken h: metin = dosya_ac(yol, "okuma");
    eğer değil dosya_gecerli(h) { ver hata("acilamadi"); }
    ver tamam(Dosya { h: h });
}
işlev kapat(d: Dosya) -> tam32 { değişken hh: metin = d.h; imha(d); dosya_kapat(hh); ver 0; }

işlev main() -> tam32 {
    eşleş ac("a.txt") {
        tamam(d) => { kapat(d); ver 0; }
        hata(e)  => { ver 1; }
    }
    ver 2;
}
