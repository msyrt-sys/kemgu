// D-365 / CP005: `yetki<R>` LİNEERDİR — yetenek çoğaltılamaz, unutulamaz.
// CP005 yeni bir kural DEĞİL: L001/L002/L004'ün yetki karşılığı. Aynı lineer
// makine çalışır, yalnız raporlanan KOD değişir. Üç şekil de burada:
işlev cift_tuketim() -> tam32 {
    değişken y: yetki<Dosya> = yetki_olustur(1, 3);
    geri_al(y);
    geri_al(y);          // CP005 (L002 karşılığı): iki kez tüketim
    ver 0;
}
işlev tuketilmedi() -> tam32 {
    değişken y: yetki<Dosya> = yetki_olustur(1, 3);
    ver 0;               // CP005 (L001 karşılığı): yetenek sızdırıldı
}
işlev referans() -> tam32 {
    değişken y: yetki<Dosya> = yetki_olustur(1, 3);
    değişken r = &y;     // CP005 (L004 karşılığı): lineer bağlamaya referans
    geri_al(y);
    ver 0;
}
işlev main() -> tam32 {
    ver 0;
}
