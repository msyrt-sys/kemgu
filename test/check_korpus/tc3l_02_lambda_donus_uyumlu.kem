// D-326 karşıt örnek: bildirilen işlev tipi ile lambda UYUMLU → temiz (OK).
işlev m() -> tam32 {
    değişken f: işlev() -> tam32 = || 42;
    değişken g: işlev(tam32) -> tam32 = |x: tam32| x + 1;
    değişken h: işlev() -> tam32 = || { ver 7; };
    değişken k: işlev() -> boş = || { };
    ver 0;
}
