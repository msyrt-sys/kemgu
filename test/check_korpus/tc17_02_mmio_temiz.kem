// D-364: geçerli MMIO/yetki kullanımları — yanlış-pozitif kapısı.
// Farklı kaynak tipleri (Dosya/Soket/Bellek) ve 16/32/64 genişlikleri dâhil.
işlev oku_yaz() -> tam32 {
    değişken y: yetki<MMIO> = yetki_olustur(6, 4096);
    değişken a: tam32 = mmio_oku32(y, 0);
    mmio_yaz32(y, 4, 7);
    değişken b: tam32 = mmio_oku16(y, 8) olarak tam32;
    mmio_yaz64(y, 16, 9);
    geri_al(y);
    ver a + b;
}
işlev diger_kaynaklar() -> tam32 {
    değişken d: yetki<Dosya> = yetki_olustur(1, 3);
    değişken s: yetki<Soket> = yetki_olustur(2, 1);
    değişken b: yetki<Bellek> = yetki_olustur(3, 3);
    geri_al(d);
    geri_al(s);
    geri_al(b);
    ver 0;
}
işlev main() -> tam32 {
    ver 0;
}
