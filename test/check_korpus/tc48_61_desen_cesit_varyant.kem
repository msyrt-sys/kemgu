// [D-799] P212 — `Çeşit::` deseninde varyant adı yerine sayı (C parser.c:1367). Kol `5`i gövde olarak
// tüketir; izleyen `=>` desende P211 alır (C parser.c:1485, ilerlemeden döner) ve `=>` beklentisi onu tüketir.
çeşit K { A, B }
işlev main() -> tam32 {
    değişken x: K = K::A;
    eşleş x { K::5 => 1; _ => 2; }
    ver 0;
}
