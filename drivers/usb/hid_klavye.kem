// HID boot klavye rapor farkı. Türkçe düzen mevcut PS/2 dönüştürücüye aittir.
kullan drivers::usb::hid_tus_tablosu::{ hid_set1 };
kullan drivers::ps2::klavye_tr::{ KlavyeDurumu, TusOlayi, TusHamOlay, klavye_bayt, klavye_degistiriciler, klavye_ham_bayt };
kullan drivers::ortak::bayt::{ oku_le64 };
// Boot raporu sekiz bayttır. Değer olarak saklanan geçmiş, bağlamla birlikte kopyalanır.
genel yapı HidKlavye { onceki: tam64; }
genel çıplak işlev hid_klavye_yeni() -> HidKlavye { ver HidKlavye { onceki: 0 }; }
çıplak işlev hid_bayt(rapor: tam64, i: tam32) -> tam32 {
    ver ((rapor>>(i*8))&255) olarak tam32;
}
çıplak işlev var_mi(rapor: tam64, k: tam32, son: tam32) -> mantıksal {
    değişken i: tam32 = 2;
    iken i < son { eğer hid_bayt(rapor,i) == k { ver doğru; } i=i+1; }
    ver yanlış;
}
// Yinelemeyi yalnız ilk yuvada işle. Diğer raporda kalan tuş durum değiştirmedi.
çıplak işlev hid_degisen(rapor: tam64, diger: tam64, i: tam32) -> tam32 {
    değişken k: tam32 = hid_bayt(rapor,i);
    eğer k == 0 veya var_mi(rapor,k,i) veya var_mi(diger,k,8) { ver 0; }
    ver k;
}
işlev olay(d: &değişken KlavyeDurumu, k: tam32, bas: mantıksal) -> TusOlayi {
    değişken o: tam32 = 0;
    eğer k == 79 { o=8; } eğer k == 80 { o=7; } eğer k == 81 { o=6; } eğer k == 82 { o=5; } eğer k == 76 { o=9; }
    eğer k == 70 { o=11; }
    eğer k == 72 { eğer bas { o=10; } değilse { ver TusOlayi::Yok; } }
    eğer o != 0 { ver TusOlayi::Ozel(o,bas); }
    değişken s: tam32 = hid_set1(k); eğer s == 0 { ver TusOlayi::Yok; } eğer değil bas { s=s|128; } ver klavye_bayt(d,s);
}
işlev ekle(xs: Dizi<TusOlayi>, o: TusOlayi) { eşleş o { TusOlayi::Yok => { } _ => { dizi_ekle(xs,o); } } }
çıplak işlev hid_rapor_hata(rapor: tam64) -> mantıksal {
    değişken i: tam32 = 2;
    iken i < 8 {
        değişken k: tam32 = hid_bayt(rapor,i);
        eğer k >= 1 ve k <= 3 { ver doğru; }
        i=i+1;
    }
    ver yanlış;
}
çıplak işlev hid_degistiriciler(d: &değişken KlavyeDurumu,m: tam32) {
    d.sol_shift=(m&2) != 0; d.sag_shift=(m&32) != 0; d.ctrl=(m&17) != 0;
    d.alt=(m&4) != 0; d.altgr=(m&64) != 0; d.e0=yanlış;
}
genel işlev hid_klavye_rapor(h: &değişken HidKlavye,d: &değişken KlavyeDurumu,b: Dizi<dtam8>) -> sonuç<Dizi<TusOlayi>,metin> {
    eğer dizi_boyut(b) != 8 { ver hata("hid klavye rapor boyu"); }
    değişken xs: Dizi<TusOlayi> = [];
    değişken yeni: tam64 = oku_le64(b,0);
    eğer hid_rapor_hata(yeni) { ver tamam(xs); }
    hid_degistiriciler(d,hid_bayt(yeni,0));
    değişken i: tam32 = 2;
    iken i < 8 {
        değişken k: tam32 = hid_degisen(h.onceki,yeni,i);
        eğer k != 0 { ekle(xs,olay(d,k,yanlış)); }
        i=i+1;
    }
    i=2;
    iken i < 8 {
        değişken k: tam32 = hid_degisen(yeni,h.onceki,i);
        eğer k != 0 { ekle(xs,olay(d,k,doğru)); }
        i=i+1;
    }
    h.onceki=yeni;
    ver tamam(xs);
}
çıplak işlev hid_ham_ozel(k: tam32) -> tam32 {
    // HID F1..F12 kullanımları, PS/2 küme 1 ile aynı fiziksel olay kodlarını üretir.
    eğer k >= 58 ve k <= 67 { ver k+1; }
    eğer k == 68 { ver 87; } eğer k == 69 { ver 88; }
    eğer k == 70 { ver 311; } eğer k == 72 { ver 581; }
    eğer k == 84 { ver 309; } eğer k == 88 { ver 284; }
    eğer k == 73 { ver 338; }
    eğer k == 74 { ver 327; } eğer k == 77 { ver 335; }
    eğer k == 75 { ver 329; } eğer k == 78 { ver 337; }
    eğer k == 79 { ver 333; } eğer k == 80 { ver 331; }
    eğer k == 81 { ver 336; } eğer k == 82 { ver 328; }
    eğer k == 76 { ver 339; }
    ver 0;
}
çıplak işlev hid_mod_kodu(i: tam32) -> tam32 {
    eşleş i { 0 => { ver 29; } 1 => { ver 42; } 2 => { ver 56; } 3 => { ver 347; }
        4 => { ver 285; } 5 => { ver 54; } 6 => { ver 312; } _ => { ver 348; } }
}
// Sekiz değiştirici ile altı bırakma ve altı basma tek raporda birleşebilir.
genel işlev hid_ham_tampon() -> Dizi<TusHamOlay> {
    değişken xs: Dizi<TusHamOlay> = [];
    iken dizi_boyut(xs) < 20 { dizi_ekle(xs,TusHamOlay {kod:0,unicode:0,bas:0,degistirici:0}); }
    ver xs;
}
çıplak işlev hid_ham_tus(d: &değişken KlavyeDurumu,k: tam32,bas: mantıksal) -> seçimlik<TusHamOlay> {
    değişken o: tam32 = hid_ham_ozel(k);
    eğer o != 0 {
        eğer o == 581 ve değil bas { ver hiç; }
        değişken un: tam32 = 0; eğer o == 309 { un=47; }
        değişken gecis: tam32 = 0; eğer bas { gecis=1; }
        ver değer(TusHamOlay {kod:o,unicode:un,bas:gecis,degistirici:klavye_degistiriciler(d)});
    }
    değişken s: tam32 = hid_set1(k);
    eğer s == 0 { ver hiç; }
    eğer değil bas { s=s|128; }
    ver klavye_ham_bayt(d,s);
}
// Çıktı alanı çağırana aittir. Yalnız dönen sayı kadar olay geçerlidir.
genel çıplak işlev hid_klavye_ham_doldur(h: &değişken HidKlavye,d: &değişken KlavyeDurumu,
    yeni: tam64,xs: Dizi<TusHamOlay>) -> tam32 {
    eğer dizi_boyut(xs) < 20 { ver -1; }
    eğer hid_rapor_hata(yeni) { ver 0; }
    değişken m: tam32 = hid_bayt(yeni,0);
    değişken fark: tam32 = m^hid_bayt(h.onceki,0);
    hid_degistiriciler(d,m);
    değişken n: tam32 = 0;
    değişken i: tam32 = 0;
    iken i < 8 {
        eğer (fark&(1<<i)) != 0 {
            dizi_yaz(xs,n,TusHamOlay {kod:hid_mod_kodu(i),unicode:0,bas:(m>>i)&1,
                degistirici:klavye_degistiriciler(d)});
            n=n+1;
        }
        i=i+1;
    }
    değişken eski: tam64 = h.onceki;
    değişken rapor: tam64 = eski;
    değişken diger: tam64 = yeni;
    değişken tur: tam32 = 0;
    iken tur < 2 {
        i=2;
        iken i < 8 {
            değişken k: tam32 = hid_degisen(rapor,diger,i);
            eğer k != 0 {
                eşleş hid_ham_tus(d,k,tur == 1) {
                    hiç => { }
                    değer(v) => { dizi_yaz(xs,n,v); n=n+1; }
                }
            }
            i=i+1;
        }
        rapor=yeni; diger=eski; tur=tur+1;
    }
    h.onceki=yeni;
    ver n;
}
genel işlev hid_klavye_ham_rapor(h: &değişken HidKlavye,d: &değişken KlavyeDurumu,b: Dizi<dtam8>) -> sonuç<Dizi<TusHamOlay>,metin> {
    eğer dizi_boyut(b) != 8 { ver hata("hid klavye rapor boyu"); }
    değişken gecici: Dizi<TusHamOlay> = hid_ham_tampon();
    değişken n: tam32 = hid_klavye_ham_doldur(h,d,oku_le64(b,0),gecici);
    değişken xs: Dizi<TusHamOlay> = [];
    değişken i: tam32 = 0;
    iken i < n { dizi_ekle(xs,dizi_al(gecici,i)); i=i+1; }
    ver tamam(xs);
}
