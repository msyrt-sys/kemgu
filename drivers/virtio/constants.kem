// VirtIO status register bitleri: bu dosya donanim erisimi icermez.

genel sabit VIRTIO_STATUS_RESET: tam32 = 0;
genel sabit VIRTIO_STATUS_ACKNOWLEDGE: tam32 = 1;
genel sabit VIRTIO_STATUS_DRIVER: tam32 = 2;
genel sabit VIRTIO_STATUS_DRIVER_OK: tam32 = 4;
genel sabit VIRTIO_STATUS_FEATURES_OK: tam32 = 8;
genel sabit VIRTIO_STATUS_FAILED: tam32 = 128;

// VirtIO MMIO v2 register offsetleri; taban adresi transport dosyasinda tutulur.
genel sabit VIRTIO_MMIO_MAGIC_VALUE: tam64 = 0;
genel sabit VIRTIO_MMIO_VERSION: tam64 = 4;
genel sabit VIRTIO_MMIO_DEVICE_ID: tam64 = 8;
genel sabit VIRTIO_MMIO_VENDOR_ID: tam64 = 12;
genel sabit VIRTIO_MMIO_DEVICE_FEATURES: tam64 = 16;
genel sabit VIRTIO_MMIO_DEVICE_FEATURES_SEL: tam64 = 20;
genel sabit VIRTIO_MMIO_DRIVER_FEATURES: tam64 = 32;
genel sabit VIRTIO_MMIO_DRIVER_FEATURES_SEL: tam64 = 36;
genel sabit VIRTIO_MMIO_QUEUE_SEL: tam64 = 48;
genel sabit VIRTIO_MMIO_QUEUE_NUM_MAX: tam64 = 52;
genel sabit VIRTIO_MMIO_QUEUE_NUM: tam64 = 56;
genel sabit VIRTIO_MMIO_QUEUE_READY: tam64 = 68;
genel sabit VIRTIO_MMIO_STATUS: tam64 = 112;
genel sabit VIRTIO_MMIO_QUEUE_DESC_LOW: tam64 = 128;
genel sabit VIRTIO_MMIO_QUEUE_DESC_HIGH: tam64 = 132;
genel sabit VIRTIO_MMIO_QUEUE_DRIVER_LOW: tam64 = 144;
genel sabit VIRTIO_MMIO_QUEUE_DRIVER_HIGH: tam64 = 148;
genel sabit VIRTIO_MMIO_QUEUE_DEVICE_LOW: tam64 = 160;
genel sabit VIRTIO_MMIO_QUEUE_DEVICE_HIGH: tam64 = 164;
genel sabit VIRTIO_MMIO_CONFIG_GENERATION: tam64 = 252;

// VirtIO block device config-space offsetleri; config tabani MMIO 0x100 adresindedir.
genel sabit VIRTIO_BLK_CFG_TABAN: tam64 = 256;
genel sabit VIRTIO_BLK_CFG_CAPACITY: tam64 = 0;
genel sabit VIRTIO_BLK_CFG_CAPACITY_HIGH: tam64 = 4;
genel sabit VIRTIO_BLK_CFG_SIZE_MAX: tam64 = 8;
genel sabit VIRTIO_BLK_CFG_SEG_MAX: tam64 = 12;
genel sabit VIRTIO_BLK_CFG_BLK_SIZE: tam64 = 20;
