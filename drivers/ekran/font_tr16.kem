// 10804 bayt; SHA256 d9025175dcf18f8b7442009a1870837f6ae974fa9561e9d8dae5eb145566fee7
işlev nibble(c: tam32) -> tam32 { eğer c <= 57 { ver c - 48; } ver c - 87; }
işlev font_parca(b: Dizi<dtam8>, hex: metin) {
    değişken i: tam32 = 0;
    değişken n: tam32 = metin_uzunluk(hex);
    iken i < n {
        değişken v: tam32 = nibble(metin_bayt(hex,i) olarak tam32) * 16 + nibble(metin_bayt(hex,i+1) olarak tam32);
        dizi_ekle(b,v olarak dtam8); i=i+2;
    }
}
