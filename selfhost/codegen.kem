        değişken callee_rho: tam32 = kullanici;
        eğer kullanici == 1 { eğer fn_ciplak_ad_mi(p, fad) == 1 { callee_rho = 0; } }
        // void çağrı: %r = atanmaz.
        eğer metin_esit(rt, "void") {
            yaz_str("  call void @"); ir_ad_yaz(fname); yaz_str("(");
            eğer callee_rho == 1 { yaz_str("ptr "); yaz_str(p.rho_ref); }   // V2-F4.2a: ρ
            değişken jv: tam32 = 0;
            iken jv < dizi_boyut(args) {
                eğer jv > 0 veya callee_rho == 1 { yaz_str(", "); }
                yaz_str(dizi_al(argt, jv)); yaz_str(" "); yaz_str(dizi_al(args, jv));
                jv = jv + 1;
            }
            yaz_str(")"); yb(10);
            p.son_tip = "void";
            ver "0";
        }
        değişken r: tam32 = yeni_reg(p);
        değişken rs: metin = reg_str(r);
        yaz_str("  "); yaz_str(rs); yaz_str(" = call "); yaz_str(rt); yaz_str(" @"); ir_ad_yaz(fname); yaz_str("(");
        eğer callee_rho == 1 { yaz_str("ptr "); yaz_str(p.rho_ref); }   // V2-F4.2a: ρ
        değişken j: tam32 = 0;
        iken j < dizi_boyut(args) {
            eğer j > 0 veya callee_rho == 1 { yaz_str(", "); }
            yaz_str(dizi_al(argt, j)); yaz_str(" "); yaz_str(dizi_al(args, j));
            j = j + 1;
        }
        yaz_str(")"); yb(10);
        // Built-in i1 dönüşü → mantıksal=i32 invaryantına normalize et (zext).
        eğer metin_esit(rt, "i1") { değişken z: metin = zext_i1(p, rs); p.son_tip = "i32"; ver z; }
