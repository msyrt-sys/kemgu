        // invaryantı: C i1-slot + ver'de dönüştürür; biz İ32-slot + sonuç i32 tutarız
        // (self-host VER tip dönüşümü YAPMAZ). phi yerine bellek-slot (predecessor yok).
        eğer metin_esit(op, "ve") veya metin_esit(op, "veya") {
            değişken ve_mi: mantıksal = metin_esit(op, "ve");
            // B4: slot ENTRY'de hoist edildi (p.sc_slot) — döngü-içi alloca YOK.
            değişken slot: metin = p.sc_slot;
            değişken soli1: metin = kosul_i1(p, ifade_uret(p, dizi_al(p.cocuk, cb)));
            değişken Lsag: metin = yeni_label(p);
            değişken Lkisa: metin = yeni_label(p);
            değişken Lson: metin = yeni_label(p);
            yaz_str("  br i1 "); yaz_str(soli1); yaz_str(", label %");
            eğer ve_mi { yaz_str(Lsag); yaz_str(", label %"); yaz_str(Lkisa); }
            değilse { yaz_str(Lkisa); yaz_str(", label %"); yaz_str(Lsag); }
            yb(10); p.bb_term = 1;
