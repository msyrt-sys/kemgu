        // ===== D-299: Katman 2 (Concurrency / DRF V1) intrinsic emisyonu =====
        // C llvm.c'deki erken-dönüş bloklarının aynası. Bunlar aşağıdaki generic
        // built-in/kullanıcı-fn yoluna SIĞMAZ: ρ ALMAZLAR ve taşıyıcı i64 ↔ T
        // dönüşümü isterler. Bu blok olmadan self-host bunları KULLANICI işlevi
        // sanıp `call i32 @"görev_başlat"(ptr %rho, ...)` üretiyordu → tanımsız
        // sembol (C derleyicinin D-291 öncesi hâli).
        // D-300: görev_başlat(c: işlev() -> T) -> görev<T>. c = LAMBDA. C llvm.c
        // görev_başlat + DUGUM_LAMBDA fat-value aynası: env-null (capture yok) ya da
        // heap-env (capture var); lifted @lambda_N gövde-SONRASI emit (kuyruk).
        eğer metin_esit(fad, "görev_başlat") {
            değişken lam: tam32 = dizi_al(p.cocuk, cb + 1);
            // Mangled ad
            değişken mad: metin = metin_birlestir("lambda_", tam64_str(p.lam_sayac olarak tam64));
            p.lam_sayac = p.lam_sayac + 1;
            // Capture analizi (çevre scope canlıyken). Lambda gövdesi = SON çocuk.
            değişken lcb: tam32 = dizi_al(p.a_cb, lam);
            değişken lcs: tam32 = dizi_al(p.a_cs, lam);
            değişken govde: tam32 = dizi_al(p.cocuk, lcb + lcs - 1);
            değişken capbase: tam32 = dizi_boyut(p.lam_capisim);
            lam_cap_tara(p, govde, lam, capbase);
            değişken capcnt: tam32 = dizi_boyut(p.lam_capisim) - capbase;
            // Env: capture yoksa null; varsa HEAP struct (C V2-F2 aynası).
            değişken envreg: metin = "null";
            eğer capcnt > 0 {
                değişken et: metin = lam_envtip(p, capbase, capcnt);
                değişken er: tam32 = yeni_reg(p);
                envreg = reg_str(er);
                yaz_str("  "); yaz_str(envreg);
                yaz_str(" = call ptr @malloc(i64 ptrtoint (ptr getelementptr (");
                yaz_str(et); yaz_str(", ptr null, i32 1) to i64))"); yb(10);
                değişken ci: tam32 = 0;
                iken ci < capcnt {
                    değişken cad: metin = dizi_al(p.lam_capisim, capbase + ci);
                    değişken cir: metin = dizi_al(p.lam_capir, capbase + ci);
                    değişken calloca: metin = cg_var_bul(p, cad);   // çevre alloca
                    değişken lv: tam32 = yeni_reg(p);
                    yaz_str("  "); yaz_str(reg_str(lv)); yaz_str(" = load "); yaz_str(cir);
                    yaz_str(", ptr "); yaz_str(calloca); yb(10);
                    değişken gp: tam32 = yeni_reg(p);
                    yaz_str("  "); yaz_str(reg_str(gp)); yaz_str(" = getelementptr ");
                    yaz_str(et); yaz_str(", ptr "); yaz_str(envreg);
                    yaz_str(", i32 0, i32 "); yaz_str(tam64_str(ci olarak tam64)); yb(10);
                    yaz_str("  store "); yaz_str(cir); yaz_str(" "); yaz_str(reg_str(lv));
                    yaz_str(", ptr "); yaz_str(reg_str(gp)); yb(10);
                    ci = ci + 1;
                }
            }
            // Runtime çağrısı: fn AYNI ptr iki kez (bare/kapanış), env üçüncü.
            değişken gr: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(gr));
            yaz_str(" = call ptr @kdl_gorev_basla_kapanis(ptr @"); yaz_str(mad);
            yaz_str(", ptr @"); yaz_str(mad); yaz_str(", ptr "); yaz_str(envreg); yaz_str(")"); yb(10);
            // Karar 1 (D-30x): görev_başlat → sonuç<görev<T>, metin>. görev<T> ve
            // metin ikisi de IR'de ptr → aggregate DAİMA { i8, ptr, ptr } (T'den
            // bağımsız). DALLANMASIZ sarma: tag = (handle==null)?1:0; 3 alan da
            // koşulsuz dolu — okuyucu tag'e göre alan1 (handle) ya da alan2 (hata
            // metni) okur. Runtime spawn başarısızsa NULL döner (panik YOK). C
            // llvm.c görev_başlat sonuç-sarma aynası.
            değişken isn: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(isn));
            yaz_str(" = icmp eq ptr "); yaz_str(reg_str(gr)); yaz_str(", null"); yb(10);
            değişken tg: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(tg));
            yaz_str(" = zext i1 "); yaz_str(reg_str(isn)); yaz_str(" to i8"); yb(10);
            değişken slot: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(slot));
            yaz_str(" = alloca { i8, ptr, ptr }"); yb(10);
            değişken f0: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(f0));
            yaz_str(" = getelementptr { i8, ptr, ptr }, ptr "); yaz_str(reg_str(slot));
            yaz_str(", i32 0, i32 0"); yb(10);
            yaz_str("  store i8 "); yaz_str(reg_str(tg)); yaz_str(", ptr "); yaz_str(reg_str(f0)); yb(10);
            değişken f1: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(f1));
            yaz_str(" = getelementptr { i8, ptr, ptr }, ptr "); yaz_str(reg_str(slot));
            yaz_str(", i32 0, i32 1"); yb(10);
            yaz_str("  store ptr "); yaz_str(reg_str(gr)); yaz_str(", ptr "); yaz_str(reg_str(f1)); yb(10);
            değişken em: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(em));
            yaz_str(" = getelementptr [20 x i8], ptr @.gorev_hata_str, i32 0, i32 0"); yb(10);
            değişken f2: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(f2));
            yaz_str(" = getelementptr { i8, ptr, ptr }, ptr "); yaz_str(reg_str(slot));
            yaz_str(", i32 0, i32 2"); yb(10);
            yaz_str("  store ptr "); yaz_str(reg_str(em)); yaz_str(", ptr "); yaz_str(reg_str(f2)); yb(10);
            değişken ld: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(ld));
            yaz_str(" = load { i8, ptr, ptr }, ptr "); yaz_str(reg_str(slot)); yb(10);
