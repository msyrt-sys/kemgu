            değişken e: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 2));
            değişken et: metin = p.son_tip;
            yaz_str("  call void @kdl_dizi_ekle_"); yaz_str(dizi_ekle_sonek(et)); yaz_str("(ptr ");
            yaz_str(p.rho_ref); yaz_str(", ptr ");   // V2-F4.2a: ρ
            yaz_str(d2); yaz_str(", "); yaz_str(dizi_arg_tip(et)); yaz_str(" "); yaz_str(e); yaz_str(")"); yb(10);
            p.son_tip = "void"; p.son_elem = ""; p.son_ref = "";
            ver "0";
