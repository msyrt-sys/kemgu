        eğer metin_esit(fad, "dizi_boyut") {
            değişken d: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            değişken r: tam32 = yeni_reg(p);
            değişken rs: metin = reg_str(r);
            yaz_str("  "); yaz_str(rs); yaz_str(" = call i32 @kdl_dizi_boyut(ptr "); yaz_str(d); yaz_str(")"); yb(10);
