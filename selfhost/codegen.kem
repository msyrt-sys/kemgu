// ============================================================================
// selfhost/parser.kem — KEMGU parser'ı KEMGU'da (SELF-HOST bootstrap, Aşama 1).
//
// HEDEF: C parser'ının (src/parser.c + ifade.c) TAM İKAMESİ. Doğruluk: C
// `--ast` düz-dump oracle'ına karşı SIFIR-DİFF (D-043).
//   Format: <derinlik>\t<TIP_ADI>\t<deger>\t<satır>\t<sütün>
//
// MİMARİ (D-043): indeks-tabanlı DÜZ düğüm tablosu (paralel Dizi). Lexer scanning
// REUSE edilir → token tablosu (emit sink'i print yerine dizi_ekle). State =
// `Ayr` struct, &değişken ile geçirilir (D-044 fix'i Dizi-alanlı struct'ı sağlar).
//
// İLERLEME: P1a (token tablo + re-emit doğrulama) → P1b (Pratt ifade) → ...
// ============================================================================

yapı Ayr {
    kaynak: metin;
    // Token tablosu (lex çıktısı)
    t_ad: Dizi<metin>;
    t_sat: Dizi<tam32>;
    t_sut: Dizi<tam32>;
    t_off: Dizi<tam32>;
    t_uz: Dizi<tam32>;
    // Parser imleci
    imlec: tam32;
    // AST düğüm tablosu (paralel)
    a_ad: Dizi<metin>;
    a_deg: Dizi<metin>;
    a_sat: Dizi<tam32>;
    a_sut: Dizi<tam32>;
    a_cb: Dizi<tam32>;    // çocuk listesi başlangıç indeksi
    a_cs: Dizi<tam32>;    // çocuk sayısı
    cocuk: Dizi<tam32>;   // düz çocuk indeks listesi
    hata_say: tam32;     // parser hata sayısı
    yapi_izni: tam32;    // 1=Tip{..} yapı-oluştur izinli; 0=koşul bağlamı (blok başı)
    sk_pending: tam32;   // >> (SAGA_KAYDIR) yarı-tüketildi (generic kapanış böl)
    reg: tam32;          // CG (D-072): işlev-içi sıralı SSA sayacı (%0, %1, ...)
    cg_ad: Dizi<metin>;  // CG3: değişken adları (yalnız APPEND; işlev-bazı slice = cg_base..)
    cg_areg: Dizi<metin>;// CG3: karşılık gelen alloca operandı ("%2")
    cg_atip: Dizi<metin>;// CG6: karşılık gelen LLVM tip ("i32"/"i64"/...)
    cg_aref: Dizi<metin>;// CG7c: ptr ise işaret ettiği yapı adı ("Ayr"); değilse ""
    son_ref: metin;      // CG7c: son ifade sonucu ptr ise işaret ettiği yapı adı
    cg_aelem: Dizi<metin>;// CG8: Dizi değişkeni ise eleman LLVM tipi; değilse ""
    cg_apointee: Dizi<metin>;// D-267: *tamN pointer değişkeni ise skaler pointee LLVM tipi
    cg_aic: Dizi<metin>;  // D-299: görev<T>/kanal<T> değişkeni ise T'nin LLVM tipi; değilse ""
                             // ("i8"/"i16"/"i32"/"i64"); değilse "". deref-read yük-tipi (C pointee_llvm_tip aynası).
    beklenen_elem: metin;// CG8: sonraki [] literali için beklenen eleman tipi
    beklenen_ll: metin;  // D3: beklenen tagged-union LLVM tipi ({i8,..}) — yapıcı bağlamı
    son_elem: metin;     // CG8: son ifade Dizi ise eleman tipi
    cg_base: tam32;      // CG3: mevcut işlevin değişken-slice başlangıcı (reset yerine)
    lbl: tam32;          // CG4: temel-blok etiket sayacı (bb0, bb1, ...)
    bb_term: tam32;      // CG4: mevcut blok terminatör (ret/br) ile bitti mi (1=evet)
    fn_ad: Dizi<metin>;  // CG6: işlev adı (ön-pass imza tablosu — CAGRI dönüş tipi)
    fn_ret: Dizi<metin>; // CG6: işlev dönüş LLVM tipi
    pa_node: Dizi<tam32>;// CG9: hoist-edilen DEGISKEN düğüm idx'i (alloca entry'de)
    pa_reg: Dizi<metin>; // CG9: o DEGISKEN'in entry-alloca reg'i
    pa_base: tam32;      // CG9: mevcut işlevin pa_* slice başlangıcı
    son_tip: metin;      // CG6: son ifade_uret sonucunun LLVM tipi
    cur_ret: metin;      // CG6: mevcut işlevin dönüş LLVM tipi (ver için)
    rho_ref: metin;      // V2-F4.2a: aktif fonksiyonun bölge (ρ) IR ref ("%rho" / main seed)
    // V2-F4.2b: confinement (ρ_yerel gerçek-serbest) — C-tarafı escape.c/llvm.c AYNASI.
    // POZİTİF kanıt: bir dizi-değişken literali ρ_yerel'e SADECE govdedeki HER kullanımı
    // confined (var[i] oku/yaz + retain-etmeyen dizi-builtin ilk-arg) ise yönlenir.
    ky_node: Dizi<tam32>;  // kesin-yerel kanıtlanmış DIZI_OLUSTUR düğüm idx'leri (confined dizi-değişken literali)
    ky_base: tam32;        // aktif işlevin ky_node dilim başı (fn-bazlı izolasyon)
    ky_iter_node: Dizi<tam32>;  // F4.3: iterasyon-confined DIZI_OLUSTUR idx'leri (ky_confined ∧ bildirim-döngü-gövdesinde)
    ky_iter_base: tam32;        // aktif işlevin ky_iter_node dilim başı
    ky_lambda: tam32;      // aktif işlev gövdesinde LAMBDA var mı (1 → routing GUARD: ρ_yerel kapalı)
    rho_yerel: metin;      // V2-F4.2b: scope-yerel bölge IR reg (fn girişinde aç, her ret öncesi serbest; ""=yok)
    uygula_hedef: metin;   // B2: aktif uygula bloğunun hedef yapı LLVM tipi ("%Sayac"); kendin param tipi; ""=yok
    sc_slot: metin;        // B4: ve/veya kısa-devre i32 slot reg'i — fn girişinde (entry) BİR KEZ alloca, tüm ve/veya tekrar kullanır (döngü-içi alloca yığın taşmasını önler)
    rho_iter: metin;       // F4.3: en-dış döngü ρ_iter IR reg ("%N") — gövde-girişinde yarat, her gövde-çıkışında serbest; ""=döngü-dışı
    dongu_d: tam32;        // F4.3: emisyon döngü-derinliği (0=döngü-dışı; 1=en-dış → ρ_iter sahibi; >1=iç, ρ_iter'a dokunmaz)
    ciplak_aktif: tam32;   // D-256: aktif fn çıplak mı (1) → ρ_iter (döngü region-prologue) DA bastırılır (C paritesi)
    // D-300: lifted-lambda kuyruğu (görev_başlat closure emisyonu). Lambda düğümü
    // görev_başlat argümanında görüldüğünde: (a) mangled ad atanır + fat value/env
    // görev_başlat yerinde emit edilir, (b) düğüm buraya kuyruklanır → emit_tanimlar
    // SONRASI top-level `define @lambda_N(...)` üretilir (LLVM'de fn sırası önemsiz).
    // Capture bilgisi call-site'ta (çevre scope canlıyken) çözülüp "|"-ayraçlı
    // saklanır — lifted emit'te çevre cg_var artık yok. C llvm.c BekleyenLambda aynası.
    lam_node: Dizi<tam32>;   // kuyruğa alınan LAMBDA AST düğüm idx'i
    lam_ad: Dizi<metin>;     // mangled ad ("lambda_0")
    lam_capbase: Dizi<tam32>;// bu lambda'nın lam_capisim/ir dilim başı
    lam_capcount: Dizi<tam32>;// yakalama sayısı
    lam_capisim: Dizi<metin>;// DÜZ yakalama adları (tüm lambdalar)
    lam_capir: Dizi<metin>;  // DÜZ yakalama LLVM tipleri (tüm lambdalar)
    lam_sayac: tam32;        // lambda_N mangled sayacı
    str_deg: Dizi<metin>;// CG7: benzersiz metin literalleri (indeks = @.str.N id)
    yapi_ad: Dizi<metin>;    // CG7b: yapı adları
    yapi_abase: Dizi<tam32>; // CG7b: alan_*'a slice başlangıcı
    yapi_acount: Dizi<tam32>;// CG7b: alan sayısı
    alan_ad: Dizi<metin>;    // CG7b: alan adları (düz, yapı-bazlı gruplu)
    alan_tip: Dizi<metin>;   // CG7b: alan LLVM tipleri (düz; --check modunda KEMGU tipleri)
    alan_elem: Dizi<metin>;  // CG8: Dizi alanı ise eleman tipi; değilse ""
    // D3 çeşit yan-kanal (parse_cesit'te doldurulur; --ast dump'a DOKUNMAZ — düğüm/a_deg
    // değişmez → parite korunur). varyant disc sırası = cv_* içindeki çeşit-bazlı pozisyon.
    cv_cesit: Dizi<metin>;   // sahip çeşit adı (her varyant için)
    cv_ad: Dizi<metin>;      // varyant adı
    cv_pc: Dizi<tam32>;      // varyant payload alan sayısı (enum=0)
    cc_ad: Dizi<metin>;      // çeşit adı (her çeşit için bir kez) — payload struct için
    cc_node: Dizi<tam32>;    // CESIT düğüm idx (payload tipleri = düğümün kids'i)
    // ---- AŞAMA 4 (driver): tip denetleyici durumu (checker.kem'den; D-086) ----
    // NOT: yapi_ad/yapi_abase/yapi_acount/alan_ad/alan_tip/fn_ad ZATEN yukarıda (paylaşılan;
    //      --check geçişi KEMGU tipiyle, --llvm geçişi LLVM tipiyle doldurur — ayrı invocation).
    g_isim: Dizi<metin>;     // global isimler (builtin + üst-düzey tanım)
    g_kuresel_ad: Dizi<metin>;   // D-253: küresel değişken adları (@ad load/store)
    g_kuresel_tip: Dizi<metin>;  // paralel: küresel LLVM ir tipi
    g_ciplak: Dizi<tam32>;       // D-255: çıplak işlev düğüm idx'leri (region-prologue SKIP)
    yerel: Dizi<metin>;      // append-only kapsam yığını (param + lokal)
    yerel_tip: Dizi<metin>;  // yerel ile paralel: tip-string ("?"=bilinmiyor)
    yerel_basla: tam32;      // aktif işlevin yerel diliminin başlangıcı (slice)
    aktif_donus: metin;      // aktif işlevin dönüş tipi ("boş"=void, "?"=bilinmiyor)
    fn_donus: Dizi<metin>;   // fn_ad ile paralel: dönüş tipi (bilinen skaler; aksi "?")
    fn_psay: Dizi<tam32>;    // fn_ad ile paralel: parametre sayısı
    fn_pbase: Dizi<tam32>;   // fn_ad ile paralel: fn_ptip'te param tiplerinin başı
    fn_ptip: Dizi<metin>;    // düz param tip listesi (bilinen skaler; aksi "?")
    fn_plin: Dizi<tam32>;    // fn_ptip ile paralel: param lineer mi (1/0)
    giris_dizin: metin;      // giriş dosyasının dizini (import arama yolu)
    kullan_gorulen: Dizi<metin>;  // yüklenen modül adları (döngü/elmas dedup)
    lin_ad: Dizi<metin>;     // lineer bağlama adları (param + tekkez değişken)
    lin_sat: Dizi<tam32>;    // bildirim konumu (L001 için)
    lin_sut: Dizi<tam32>;
    lin_tuk: Dizi<tam32>;    // tüketim sayacı (0=tüketilmedi; >=1 sonrası L002)
    lin_basla: tam32;        // aktif işlevin lineer bağlama diliminin başı
    th_kod: Dizi<metin>;     // tip-hata kodları (traversal sırası)
    th_sat: Dizi<tam32>;
    th_sut: Dizi<tam32>;
}

// ---- Çıktı yardımcıları ----
// HAM bayt yaz (yaz_karakter UTF-8 encode eder → Türkçe bayt mojibake;
// yaz_bayt ham byte yazar — METIN değer dump'ında UTF-8 korunur).
işlev yb(c: tam32) -> tam32 { yaz_bayt(c); ver 0; }
işlev yaz_str(s: metin) -> tam32 {
    değişken n: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 0;
    iken i < n { yb(metin_bayt(s, i) olarak tam32); i = i + 1; }
    ver 0;
}
// B5: LLVM sembol-adı yaz — ASCII-güvenli ([a-zA-Z0-9_.$-]) ise ham; aksi (Türkçe
// karakter vb.) çift-tırnakla sar → @"böl" (LLVM gereği). C llvm.c yerel_ad_yaz aynası.
// Tırnak yb(34) HAM bayt ile yazılır (codegen.kem'e \" string literali sokmaz →
// self-host \" lexing'i tetiklenmez → fixpoint güvenli).
işlev ir_ad_yaz(s: metin) -> tam32 {
    değişken n: tam32 = metin_uzunluk(s);
    değişken guvenli: mantıksal = doğru;
    değişken i: tam32 = 0;
    iken i < n {
        değişken c: tam32 = metin_bayt(s, i) olarak tam32;
        eğer c < 0 { c = c + 256; }
        değişken ok: mantıksal = yanlış;
        eğer c >= 97 ve c <= 122 { ok = doğru; }   // a-z
        eğer c >= 65 ve c <= 90 { ok = doğru; }    // A-Z
        eğer c >= 48 ve c <= 57 { ok = doğru; }    // 0-9
        eğer c == 95 veya c == 46 veya c == 36 veya c == 45 { ok = doğru; }  // _ . $ -
        eğer ok == yanlış { guvenli = yanlış; }
        i = i + 1;
    }
    eğer guvenli { yaz_str(s); }
    değilse { yb(34); yaz_str(s); yb(34); }   // 34 = '"'
    ver 0;
}
// --ast deger alanı: \t \n \r \\ kaçışlı (C duz_kacis_yaz ile birebir).
işlev yaz_kacis(s: metin) -> tam32 {
    değişken n: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 0;
    iken i < n {
        değişken c: tam32 = metin_bayt(s, i) olarak tam32;
        eğer c < 0 { c = c + 256; }
        eğer c == 9 { yb(92); yb(116); }
        değilse { eğer c == 10 { yb(92); yb(110); }
        değilse { eğer c == 13 { yb(92); yb(114); }
        değilse { eğer c == 92 { yb(92); yb(92); }
        değilse { yb(c); } } } }
        i = i + 1;
    }
    ver 0;
}

// ---- Token tablosuna ekle (lexer emit sink) ----
işlev tok_ekle(p: &değişken Ayr, ad: metin, satir: tam32, sutun: tam32, offset: tam32, uzunluk: tam32) -> tam32 {
    dizi_ekle(p.t_ad, ad);
    dizi_ekle(p.t_sat, satir);
    dizi_ekle(p.t_sut, sutun);
    dizi_ekle(p.t_off, offset);
    dizi_ekle(p.t_uz, uzunluk);
    ver 0;
}

// ---- Lexer çekirdeği (selfhost/lexer.kem ile BİREBİR; emit→tok_ekle) ----
işlev bayt(s: metin, i: tam32) -> tam32 {
    değişken b: tam32 = metin_bayt(s, i) olarak tam32;
    eğer b < 0 { ver b + 256; }
    ver b;
}
işlev rakam_mi(b: tam32) -> mantıksal { ver b >= 48 ve b <= 57; }
işlev harf_mi(b: tam32) -> mantıksal {
    ver (b >= 97 ve b <= 122) veya (b >= 65 ve b <= 90);
}
işlev bosluk_mu(b: tam32) -> mantıksal {
    ver (b == 32) veya (b == 9) veya (b == 13) veya (b == 10);
}
işlev turkce_2byte_mi(b0: tam32, b1: tam32) -> mantıksal {
    eğer b0 == 195 {
        ver (b1 == 167) veya (b1 == 135) veya (b1 == 182)
          veya (b1 == 150) veya (b1 == 188) veya (b1 == 156);
    }
    eğer b0 == 196 {
        ver (b1 == 159) veya (b1 == 158) veya (b1 == 177) veya (b1 == 176);
    }
    eğer b0 == 197 { ver (b1 == 159) veya (b1 == 158); }
    ver yanlış;
}
işlev kimlik_basi_uz(kaynak: metin, pos: tam32, uz: tam32) -> tam32 {
    eğer pos >= uz { ver 0; }
    değişken b0: tam32 = bayt(kaynak, pos);
    eğer harf_mi(b0) veya (b0 == 95) { ver 1; }
    eğer pos + 1 < uz {
        eğer turkce_2byte_mi(b0, bayt(kaynak, pos + 1)) { ver 2; }
    }
    ver 0;
}
işlev kimlik_devam_uz(kaynak: metin, pos: tam32, uz: tam32) -> tam32 {
    eğer pos >= uz { ver 0; }
    değişken b0: tam32 = bayt(kaynak, pos);
    eğer harf_mi(b0) veya rakam_mi(b0) veya (b0 == 95) { ver 1; }
    eğer pos + 1 < uz {
        eğer turkce_2byte_mi(b0, bayt(kaynak, pos + 1)) { ver 2; }
    }
    ver 0;
}
işlev anahtar_tip(w: metin) -> metin {
    eğer metin_esit(w, "iken") { ver "IKEN"; }
    eğer metin_esit(w, "ve") { ver "VE"; }
    eğer metin_esit(w, "veya") { ver "VEYA"; }
    eğer metin_esit(w, "ver") { ver "VER"; }
    eğer metin_esit(w, "delege") { ver "DELEGE"; }
    eğer metin_esit(w, "hata") { ver "HATA"; }
    eğer metin_esit(w, "imha") { ver "IMHA"; }
    eğer metin_esit(w, "kendin") { ver "KENDIN"; }
    eğer metin_esit(w, "kullan") { ver "KULLAN"; }
    eğer metin_esit(w, "olarak") { ver "OLARAK"; }
    eğer metin_esit(w, "sabit") { ver "SABIT"; }
    eğer metin_esit(w, "tamam") { ver "TAMAM"; }
    eğer metin_esit(w, "tekkez") { ver "TEKKEZ"; }
    eğer metin_esit(w, "yetki") { ver "YETKI"; }
    eğer metin_esit(w, "genel") { ver "GENEL"; }
    eğer metin_esit(w, "geri_al") { ver "GERI_AL"; }
    eğer metin_esit(w, "uygula") { ver "UYGULA"; }
    eğer metin_esit(w, "kanal") { ver "KANAL"; }
    eğer metin_esit(w, "eğer") { ver "EGER"; }
    eğer metin_esit(w, "değilse") { ver "DEGILSE"; }
    eğer metin_esit(w, "için") { ver "ICIN"; }
    eğer metin_esit(w, "eşleş") { ver "ESLES"; }
    eğer metin_esit(w, "işlev") { ver "ISLEV"; }
    eğer metin_esit(w, "yapı") { ver "YAPI"; }
    eğer metin_esit(w, "çeşit") { ver "CESIT"; }
    eğer metin_esit(w, "özellik") { ver "OZELLIK"; }
    eğer metin_esit(w, "modül") { ver "MODUL"; }
    eğer metin_esit(w, "değişken") { ver "DEGISKEN"; }
    eğer metin_esit(w, "küresel") { ver "KURESEL"; }   // D-253: modül-mutable global
    eğer metin_esit(w, "çıplak") { ver "CIPLAK"; }     // D-255: no-region-prologue işlev
    eğer metin_esit(w, "doğru") { ver "DOGRU"; }
    eğer metin_esit(w, "yanlış") { ver "YANLIS"; }
    eğer metin_esit(w, "boş") { ver "BOS"; }
    eğer metin_esit(w, "değil") { ver "DEGIL"; }
    eğer metin_esit(w, "dışa") { ver "DISA"; }
    eğer metin_esit(w, "bölge") { ver "BOLGE"; }
    eğer metin_esit(w, "seçimlik") { ver "SECIMLIK"; }
    eğer metin_esit(w, "sonuç") { ver "SONUC"; }
    eğer metin_esit(w, "değer") { ver "DEGER"; }
    eğer metin_esit(w, "hiç") { ver "HIC"; }
    eğer metin_esit(w, "güvensiz") { ver "GUVENSIZ"; }
    eğer metin_esit(w, "sabitsüre") { ver "SABITSURE"; }
    eğer metin_esit(w, "gerçekzamanlı") { ver "GERCEKZAMANLI"; }
    eğer metin_esit(w, "vektör") { ver "VEKTOR"; }
    eğer metin_esit(w, "görev") { ver "GOREV"; }
    eğer metin_esit(w, "satıriçi_asm") { ver "SATIRICI_ASM"; }
    ver "TANIMLAYICI";
}
işlev ikinci_bayt(kaynak: metin, pos: tam32, uz: tam32) -> tam32 {
    eğer pos < uz { ver bayt(kaynak, pos); }
    ver 0;
}
işlev hex_rakam_mi(b: tam32) -> mantıksal {
    ver rakam_mi(b) veya (b >= 97 ve b <= 102) veya (b >= 65 ve b <= 70);
}
işlev utf8_uz(b: tam32) -> tam32 {
    eğer b < 128 { ver 1; }
    eğer (b >= 192) ve (b <= 223) { ver 2; }
    eğer (b >= 224) ve (b <= 239) { ver 3; }
    eğer (b >= 240) ve (b <= 247) { ver 4; }
    ver 0;
}
işlev ham_basi_mi(kaynak: metin, pos: tam32, uz: tam32) -> mantıksal {
    değişken s: tam32 = ikinci_bayt(kaynak, pos + 1, uz);
    eğer s == 34 { ver doğru; }
    eğer s == 35 {
        değişken b: tam32 = pos + 1;
        iken (b < uz) ve (bayt(kaynak, b) == 35) { b = b + 1; }
        eğer (b < uz) ve (bayt(kaynak, b) == 34) { ver doğru; }
    }
    ver yanlış;
}

// Operatör (maximal munch) — tüketilen bayt; tok_ekle ile tabloya yazar.
işlev op_emit(p: &değişken Ayr, kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken b0: tam32 = bayt(kaynak, pos);
    değişken b1: tam32 = ikinci_bayt(kaynak, pos + 1, uz);
    değişken b2: tam32 = ikinci_bayt(kaynak, pos + 2, uz);
    eğer b0 == 43 {
        eğer b1 == 61 { tok_ekle(p, "ARTI_ESIT", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "ARTI", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 45 {
        eğer b1 == 61 { tok_ekle(p, "EKSI_ESIT", satir, sutun, pos, 2); ver 2; }
        eğer b1 == 62 { tok_ekle(p, "OK", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "EKSI", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 42 {
        eğer b1 == 61 { tok_ekle(p, "YILDIZ_ESIT", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "YILDIZ", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 47 {
        eğer b1 == 61 { tok_ekle(p, "BOLU_ESIT", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "BOLU", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 37 {
        eğer b1 == 61 { tok_ekle(p, "MOD_ESIT", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "MOD", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 61 {
        eğer b1 == 61 { tok_ekle(p, "ESIT_ESIT", satir, sutun, pos, 2); ver 2; }
        eğer b1 == 62 { tok_ekle(p, "KALIN_OK", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "ESIT", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 33 {
        eğer b1 == 61 { tok_ekle(p, "ESIT_DEGIL", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "HATALI", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 60 {
        eğer b1 == 61 { tok_ekle(p, "KUCUK_ESIT", satir, sutun, pos, 2); ver 2; }
        eğer b1 == 60 { tok_ekle(p, "SOLA_KAYDIR", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "KUCUK", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 62 {
        eğer b1 == 61 { tok_ekle(p, "BUYUK_ESIT", satir, sutun, pos, 2); ver 2; }
        eğer b1 == 62 { tok_ekle(p, "SAGA_KAYDIR", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "BUYUK", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 38 { tok_ekle(p, "VE_BIT", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 124 { tok_ekle(p, "VEYA_BIT", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 94 { tok_ekle(p, "OZVEYA_BIT", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 126 { tok_ekle(p, "DEGIL_BIT", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 46 {
        eğer b1 == 46 {
            eğer b2 == 46 { tok_ekle(p, "UC_NOKTA", satir, sutun, pos, 3); ver 3; }
            tok_ekle(p, "ARALIK", satir, sutun, pos, 2); ver 2;
        }
        tok_ekle(p, "NOKTA", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 58 {
        eğer b1 == 58 { tok_ekle(p, "CIFT_IKI_NOKTA", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "IKI_NOKTA", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 40 { tok_ekle(p, "SOL_PAREN", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 41 { tok_ekle(p, "SAG_PAREN", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 123 { tok_ekle(p, "SOL_SUSLU", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 125 { tok_ekle(p, "SAG_SUSLU", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 91 { tok_ekle(p, "SOL_KOSELI", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 93 { tok_ekle(p, "SAG_KOSELI", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 44 { tok_ekle(p, "VIRGUL", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 59 { tok_ekle(p, "NOKTALI_VIRGUL", satir, sutun, pos, 1); ver 1; }
    tok_ekle(p, "HATALI", satir, sutun, pos, 1); ver 1;
}
işlev sayi_emit(p: &değişken Ayr, kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken pp: tam32 = pos;
    değişken ondalik: tam32 = 0;
    eğer bayt(kaynak, pp) == 48 {
        değişken s: tam32 = ikinci_bayt(kaynak, pp + 1, uz);
        eğer (s == 120) veya (s == 88) {
            pp = pp + 2;
            iken (pp < uz) ve (hex_rakam_mi(bayt(kaynak, pp)) veya (bayt(kaynak, pp) == 95)) { pp = pp + 1; }
            tok_ekle(p, "TAMSAYI", satir, sutun, pos, pp - pos); ver pp - pos;
        }
        eğer (s == 98) veya (s == 66) {
            pp = pp + 2;
            iken (pp < uz) ve ((bayt(kaynak, pp) == 48) veya (bayt(kaynak, pp) == 49) veya (bayt(kaynak, pp) == 95)) { pp = pp + 1; }
            tok_ekle(p, "TAMSAYI", satir, sutun, pos, pp - pos); ver pp - pos;
        }
        eğer (s == 111) veya (s == 79) {
            pp = pp + 2;
            iken (pp < uz) ve (((bayt(kaynak, pp) >= 48) ve (bayt(kaynak, pp) <= 55)) veya (bayt(kaynak, pp) == 95)) { pp = pp + 1; }
            tok_ekle(p, "TAMSAYI", satir, sutun, pos, pp - pos); ver pp - pos;
        }
    }
    iken (pp < uz) ve (rakam_mi(bayt(kaynak, pp)) veya (bayt(kaynak, pp) == 95)) { pp = pp + 1; }
    eğer (pp < uz) ve (bayt(kaynak, pp) == 46) {
        eğer ikinci_bayt(kaynak, pp + 1, uz) != 46 {
            ondalik = 1;
            pp = pp + 1;
            iken (pp < uz) ve (rakam_mi(bayt(kaynak, pp)) veya (bayt(kaynak, pp) == 95)) { pp = pp + 1; }
        }
    }
    eğer (pp < uz) ve ((bayt(kaynak, pp) == 101) veya (bayt(kaynak, pp) == 69)) {
        ondalik = 1;
        pp = pp + 1;
        eğer (pp < uz) ve ((bayt(kaynak, pp) == 43) veya (bayt(kaynak, pp) == 45)) { pp = pp + 1; }
        iken (pp < uz) ve (rakam_mi(bayt(kaynak, pp)) veya (bayt(kaynak, pp) == 95)) { pp = pp + 1; }
    }
    eğer ondalik == 1 { tok_ekle(p, "ONDALIK", satir, sutun, pos, pp - pos); }
    değilse { tok_ekle(p, "TAMSAYI", satir, sutun, pos, pp - pos); }
    ver pp - pos;
}
işlev dize_emit(p: &değişken Ayr, kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken pp: tam32 = pos + 1;
    değişken durum: tam32 = 0;
    iken (pp < uz) ve (durum == 0) {
        değişken c: tam32 = bayt(kaynak, pp);
        eğer c == 34 { durum = 1; }
        değilse {
            eğer c == 92 { pp = pp + 1; eğer pp < uz { pp = pp + 1; } }
            değilse {
                eğer c == 10 { durum = 2; }
                değilse { pp = pp + 1; }
            }
        }
    }
    eğer durum == 1 { pp = pp + 1; tok_ekle(p, "METIN", satir, sutun, pos, pp - pos); ver pp - pos; }
    tok_ekle(p, "HATALI", satir, sutun, pos, pp - pos); ver pp - pos;
}
işlev karakter_emit(p: &değişken Ayr, kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken pp: tam32 = pos + 1;
    eğer (pp >= uz) veya (bayt(kaynak, pp) == 39) {
        eğer pp < uz { pp = pp + 1; }
        tok_ekle(p, "HATALI", satir, sutun, pos, pp - pos); ver pp - pos;
    }
    eğer bayt(kaynak, pp) == 92 {
        pp = pp + 1;
        eğer pp < uz { pp = pp + 1; }
    } değilse {
        değişken cl: tam32 = utf8_uz(bayt(kaynak, pp));
        eğer cl == 0 { cl = 1; }
        değişken i: tam32 = 0;
        iken i < cl { eğer pp < uz { pp = pp + 1; } i = i + 1; }
    }
    eğer (pp >= uz) veya (bayt(kaynak, pp) != 39) {
        iken (pp < uz) ve (bayt(kaynak, pp) != 39) ve (bayt(kaynak, pp) != 10) { pp = pp + 1; }
        eğer (pp < uz) ve (bayt(kaynak, pp) == 39) { pp = pp + 1; }
        tok_ekle(p, "HATALI", satir, sutun, pos, pp - pos); ver pp - pos;
    }
    pp = pp + 1;
    tok_ekle(p, "KARAKTER", satir, sutun, pos, pp - pos); ver pp - pos;
}
işlev ham_emit(p: &değişken Ayr, kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken pp: tam32 = pos + 1;
    değişken hash_sayisi: tam32 = 0;
    iken (pp < uz) ve (bayt(kaynak, pp) == 35) { hash_sayisi = hash_sayisi + 1; pp = pp + 1; }
    eğer (pp >= uz) veya (bayt(kaynak, pp) != 34) {
        tok_ekle(p, "HATALI", satir, sutun, pos, pp - pos); ver pp - pos;
    }
    pp = pp + 1;
    değişken bitti: tam32 = 0;
    iken (pp < uz) ve (bitti == 0) {
        eğer bayt(kaynak, pp) == 34 {
            pp = pp + 1;
            değişken kapanan: tam32 = 0;
            iken (pp < uz) ve (bayt(kaynak, pp) == 35) ve (kapanan < hash_sayisi) {
                kapanan = kapanan + 1; pp = pp + 1;
            }
            eğer kapanan == hash_sayisi { bitti = 1; }
        } değilse {
            pp = pp + 1;
        }
    }
    eğer bitti == 1 { tok_ekle(p, "HAM_METIN", satir, sutun, pos, pp - pos); ver pp - pos; }
    tok_ekle(p, "HATALI", satir, sutun, pos, pp - pos); ver pp - pos;
}

// Kaynağı token tablosuna lex et (C lexer ile birebir; DOSYA_SONU dahil).
işlev lex_et(p: &değişken Ayr) -> tam32 {
    değişken kaynak: metin = p.kaynak;
    değişken uz: tam32 = metin_uzunluk(kaynak);
    değişken pos: tam32 = 0;
    değişken satir: tam32 = 1;
    değişken sutun: tam32 = 1;
    iken doğru {
        değişken trivia: mantıksal = doğru;
        iken trivia {
            eğer (pos < uz) ve bosluk_mu(bayt(kaynak, pos)) {
                eğer bayt(kaynak, pos) == 10 { satir = satir + 1; sutun = 1; }
                değilse { sutun = sutun + 1; }
                pos = pos + 1;
            } değilse {
                eğer (pos < uz) ve (bayt(kaynak, pos) == 47) ve (ikinci_bayt(kaynak, pos + 1, uz) == 47) {
                    pos = pos + 2; sutun = sutun + 2;
                    iken (pos < uz) ve (bayt(kaynak, pos) != 10) { pos = pos + 1; sutun = sutun + 1; }
                } değilse {
                    eğer (pos < uz) ve (bayt(kaynak, pos) == 47) ve (ikinci_bayt(kaynak, pos + 1, uz) == 42) {
                        pos = pos + 2; sutun = sutun + 2;
                        değişken derinlik: tam32 = 1;
                        iken (pos < uz) ve (derinlik > 0) {
                            eğer (bayt(kaynak, pos) == 47) ve (ikinci_bayt(kaynak, pos + 1, uz) == 42) {
                                pos = pos + 2; sutun = sutun + 2; derinlik = derinlik + 1;
                            } değilse {
                                eğer (bayt(kaynak, pos) == 42) ve (ikinci_bayt(kaynak, pos + 1, uz) == 47) {
                                    pos = pos + 2; sutun = sutun + 2; derinlik = derinlik - 1;
                                } değilse {
                                    eğer bayt(kaynak, pos) == 10 { satir = satir + 1; sutun = 1; }
                                    değilse { sutun = sutun + 1; }
                                    pos = pos + 1;
                                }
                            }
                        }
                    } değilse {
                        trivia = yanlış;
                    }
                }
            }
        }
        eğer pos >= uz { tok_ekle(p, "DOSYA_SONU", satir, sutun, pos, 0); ver 0; }

        değişken tb: tam32 = bayt(kaynak, pos);
        değişken t_off: tam32 = pos;
        değişken t_sat: tam32 = satir;
        değişken t_sut: tam32 = sutun;

        eğer rakam_mi(tb) {
            değişken slen: tam32 = sayi_emit(p, kaynak, pos, uz, t_sat, t_sut);
            pos = pos + slen; sutun = sutun + slen;
        } değilse {
            değişken bu: tam32 = kimlik_basi_uz(kaynak, pos, uz);
            eğer bu > 0 {
                eğer (tb == 114) ve ham_basi_mi(kaynak, pos, uz) {
                    değişken hlen: tam32 = ham_emit(p, kaynak, pos, uz, t_sat, t_sut);
                    değişken k: tam32 = 0;
                    iken k < hlen {
                        eğer bayt(kaynak, pos + k) == 10 { satir = satir + 1; sutun = 1; }
                        değilse { sutun = sutun + 1; }
                        k = k + 1;
                    }
                    pos = pos + hlen;
                } değilse {
                    pos = pos + bu; sutun = sutun + bu;
                    değişken devam: mantıksal = doğru;
                    iken devam {
                        değişken du: tam32 = kimlik_devam_uz(kaynak, pos, uz);
                        eğer du == 0 { devam = yanlış; }
                        değilse { pos = pos + du; sutun = sutun + du; }
                    }
                    değişken w: metin = metin_kes(kaynak, t_off, pos - t_off);
                    tok_ekle(p, anahtar_tip(w), t_sat, t_sut, t_off, pos - t_off);
                }
            } değilse {
                eğer tb == 34 {
                    değişken mlen: tam32 = dize_emit(p, kaynak, pos, uz, t_sat, t_sut);
                    pos = pos + mlen; sutun = sutun + mlen;
                } değilse {
                    eğer tb == 39 {
                        değişken klen: tam32 = karakter_emit(p, kaynak, pos, uz, t_sat, t_sut);
                        pos = pos + klen; sutun = sutun + klen;
                    } değilse {
                        değişken olen: tam32 = op_emit(p, kaynak, pos, uz, t_sat, t_sut);
                        pos = pos + olen; sutun = sutun + olen;
                    }
                }
            }
        }
    }
    ver 0;
}

// ===========================================================================
// P1b: AST düğüm tablosu + Pratt ifade parser + düz --ast dumper.
// ===========================================================================

// ---- AST düğüm oluşturucular (append-on-create; düz çocuk listesi) ----
işlev dugum0(p: &değişken Ayr, ad: metin, deger: metin, satir: tam32, sutun: tam32) -> tam32 {
    değişken idx: tam32 = dizi_boyut(p.a_ad);
    dizi_ekle(p.a_ad, ad);  dizi_ekle(p.a_deg, deger);
    dizi_ekle(p.a_sat, satir);  dizi_ekle(p.a_sut, sutun);
    dizi_ekle(p.a_cb, 0);  dizi_ekle(p.a_cs, 0);
    ver idx;
}
işlev dugum1(p: &değişken Ayr, ad: metin, deger: metin, satir: tam32, sutun: tam32, c1: tam32) -> tam32 {
    değişken idx: tam32 = dizi_boyut(p.a_ad);
    dizi_ekle(p.a_ad, ad);  dizi_ekle(p.a_deg, deger);
    dizi_ekle(p.a_sat, satir);  dizi_ekle(p.a_sut, sutun);
    dizi_ekle(p.a_cb, dizi_boyut(p.cocuk));  dizi_ekle(p.a_cs, 1);
    dizi_ekle(p.cocuk, c1);
    ver idx;
}
işlev dugum2(p: &değişken Ayr, ad: metin, deger: metin, satir: tam32, sutun: tam32, c1: tam32, c2: tam32) -> tam32 {
    değişken idx: tam32 = dizi_boyut(p.a_ad);
    dizi_ekle(p.a_ad, ad);  dizi_ekle(p.a_deg, deger);
    dizi_ekle(p.a_sat, satir);  dizi_ekle(p.a_sut, sutun);
    dizi_ekle(p.a_cb, dizi_boyut(p.cocuk));  dizi_ekle(p.a_cs, 2);
    dizi_ekle(p.cocuk, c1);  dizi_ekle(p.cocuk, c2);
    ver idx;
}
işlev dugum3(p: &değişken Ayr, ad: metin, deger: metin, satir: tam32, sutun: tam32, c1: tam32, c2: tam32, c3: tam32) -> tam32 {
    değişken idx: tam32 = dizi_boyut(p.a_ad);
    dizi_ekle(p.a_ad, ad);  dizi_ekle(p.a_deg, deger);
    dizi_ekle(p.a_sat, satir);  dizi_ekle(p.a_sut, sutun);
    dizi_ekle(p.a_cb, dizi_boyut(p.cocuk));  dizi_ekle(p.a_cs, 3);
    dizi_ekle(p.cocuk, c1);  dizi_ekle(p.cocuk, c2);  dizi_ekle(p.cocuk, c3);
    ver idx;
}
// Çocuk listesi (Dizi<tam32>) ile düğüm — değişken arite (blok/çağrı/program).
işlev dugum_n(p: &değişken Ayr, ad: metin, deger: metin, satir: tam32, sutun: tam32, kids: Dizi<tam32>) -> tam32 {
    değişken idx: tam32 = dizi_boyut(p.a_ad);
    dizi_ekle(p.a_ad, ad);  dizi_ekle(p.a_deg, deger);
    dizi_ekle(p.a_sat, satir);  dizi_ekle(p.a_sut, sutun);
    dizi_ekle(p.a_cb, dizi_boyut(p.cocuk));  dizi_ekle(p.a_cs, dizi_boyut(kids));
    değişken i: tam32 = 0;
    iken i < dizi_boyut(kids) { dizi_ekle(p.cocuk, dizi_al(kids, i)); i = i + 1; }
    ver idx;
}

// ---- Sayı değeri (C parse: '_' temizle + 0x/0b/0o taban) ----
işlev hane_deger(c: tam32) -> tam32 {
    eğer c >= 48 ve c <= 57 { ver c - 48; }       // 0-9
    eğer c >= 97 ve c <= 102 { ver c - 97 + 10; }  // a-f
    eğer c >= 65 ve c <= 70 { ver c - 65 + 10; }   // A-F
    ver 0;
}
işlev tamsayi_deger(lex: metin) -> tam64 {
    değişken n: tam32 = metin_uzunluk(lex);
    değişken taban: tam64 = 10;
    değişken i: tam32 = 0;
    // 0x / 0b / 0o prefix
    eğer n >= 2 ve bayt(lex, 0) == 48 {
        değişken c1: tam32 = bayt(lex, 1);
        eğer (c1 == 120) veya (c1 == 88) { taban = 16; i = 2; }
        eğer (c1 == 98) veya (c1 == 66) { taban = 2; i = 2; }
        eğer (c1 == 111) veya (c1 == 79) { taban = 8; i = 2; }
    }
    değişken sonuc: tam64 = 0;
    değişken maks: tam64 = 9223372036854775807;   // int64 max (strtoll clamp)
    değişken tasti: mantıksal = yanlış;
    iken i < n {
        değişken c: tam32 = bayt(lex, i);
        eğer c != 95 {                              // '_' atla
            değişken h: tam64 = hane_deger(c) olarak tam64;
            eğer sonuc > (maks - h) / taban { tasti = doğru; }  // taşma → LLONG_MAX
            eğer tasti { sonuc = maks; }
            değilse { sonuc = sonuc * taban + h; }
        }
        i = i + 1;
    }
    ver sonuc;
}
işlev hane_str(d: tam32) -> metin {
    eğer d == 0 { ver "0"; }   eğer d == 1 { ver "1"; }
    eğer d == 2 { ver "2"; }   eğer d == 3 { ver "3"; }
    eğer d == 4 { ver "4"; }   eğer d == 5 { ver "5"; }
    eğer d == 6 { ver "6"; }   eğer d == 7 { ver "7"; }
    eğer d == 8 { ver "8"; }   ver "9";
}
işlev tam64_str(v: tam64) -> metin {
    eğer v == 0 { ver "0"; }
    eğer v < 0 { ver metin_birlestir("-", tam64_str(0 - v)); }
    eğer v < 10 { ver hane_str(v olarak tam32); }
    ver metin_birlestir(tam64_str(v / 10), hane_str((v % 10) olarak tam32));
}
// Hex hane string'i (KARAKTER U+XXXX için).
işlev hex_str(d: tam32) -> metin {
    eğer d == 0 { ver "0"; }   eğer d == 1 { ver "1"; }
    eğer d == 2 { ver "2"; }   eğer d == 3 { ver "3"; }
    eğer d == 4 { ver "4"; }   eğer d == 5 { ver "5"; }
    eğer d == 6 { ver "6"; }   eğer d == 7 { ver "7"; }
    eğer d == 8 { ver "8"; }   eğer d == 9 { ver "9"; }
    eğer d == 10 { ver "A"; }  eğer d == 11 { ver "B"; }
    eğer d == 12 { ver "C"; }  eğer d == 13 { ver "D"; }
    eğer d == 14 { ver "E"; }  ver "F";
}
// KARAKTER deger = "U+%04X" (C ast_duz_yaz ile birebir).
işlev karakter_deger(b: tam32) -> metin {
    değişken r: metin = metin_birlestir("U+", hex_str((b / 4096) % 16));
    r = metin_birlestir(r, hex_str((b / 256) % 16));
    r = metin_birlestir(r, hex_str((b / 16) % 16));
    ver metin_birlestir(r, hex_str(b % 16));
}

// ---- Token erişim (sınır-güvenli: bozuk girdide imleç DOSYA_SONU'yu aşabilir;
//      sınır-dışı erişim → DOSYA_SONU/"" → parse döngüleri sonlanır, çökme yok) ----
işlev tip_i(p: &değişken Ayr, i: tam32) -> metin {
    eğer i >= dizi_boyut(p.t_ad) { ver "DOSYA_SONU"; }
    ver dizi_al(p.t_ad, i);
}
işlev lex_i(p: &değişken Ayr, i: tam32) -> metin {
    eğer i >= dizi_boyut(p.t_ad) { ver ""; }
    ver metin_kes(p.kaynak, dizi_al(p.t_off, i), dizi_al(p.t_uz, i));
}
işlev simdiki(p: &değişken Ayr) -> metin {
    değişken t: metin = tip_i(p, p.imlec);
    eğer (p.sk_pending == 1) ve metin_esit(t, "SAGA_KAYDIR") { ver "BUYUK"; }
    ver t;
}
// Generic kapanışı `>` bekle; `>>` (SAGA_KAYDIR) iki `>`'a böl (parser_buyuk_ayir).
işlev bekle_buyuk(p: &değişken Ayr) -> tam32 {
    değişken t: metin = tip_i(p, p.imlec);  // RAW (sk_pending atla)
    eğer metin_esit(t, "BUYUK") { ilerle(p); ver 1; }
    eğer metin_esit(t, "SAGA_KAYDIR") {
        eğer p.sk_pending == 1 { p.sk_pending = 0; p.imlec = p.imlec + 1; ver 1; }
        p.sk_pending = 1;  // ilk > tüketildi (ilerleme yok)
        ver 1;
    }
    p.hata_say = p.hata_say + 1;
    ver 0;
}
işlev simdiki_buyuk_mu(p: &değişken Ayr) -> mantıksal { ver metin_esit(simdiki(p), "BUYUK"); }
işlev sim_mi(p: &değişken Ayr, t: metin) -> mantıksal { ver metin_esit(simdiki(p), t); }
işlev sim_lex(p: &değişken Ayr) -> metin { ver lex_i(p, p.imlec); }
işlev sim_sat(p: &değişken Ayr) -> tam32 { ver dizi_al(p.t_sat, p.imlec); }
işlev sim_sut(p: &değişken Ayr) -> tam32 { ver dizi_al(p.t_sut, p.imlec); }
işlev ilerle(p: &değişken Ayr) -> tam32 { p.imlec = p.imlec + 1; ver 0; }
// Beklenen token'ı tüket; değilse hata say + ilerleme yok.
işlev bekle(p: &değişken Ayr, t: metin) -> tam32 {
    eğer sim_mi(p, t) { ilerle(p); ver 1; }
    p.hata_say = p.hata_say + 1;
    ver 0;
}

// ---- Öncelik tabloları (ifade.c ile birebir) ----
işlev ikili_onc(t: metin) -> tam32 {
    eğer metin_esit(t, "VEYA") { ver 1; }
    eğer metin_esit(t, "VE") { ver 2; }
    eğer metin_esit(t, "VEYA_BIT") { ver 3; }
    eğer metin_esit(t, "OZVEYA_BIT") { ver 4; }
    eğer metin_esit(t, "VE_BIT") { ver 5; }
    eğer metin_esit(t, "ESIT_ESIT") veya metin_esit(t, "ESIT_DEGIL") { ver 6; }
    eğer metin_esit(t, "KUCUK") veya metin_esit(t, "BUYUK")
      veya metin_esit(t, "KUCUK_ESIT") veya metin_esit(t, "BUYUK_ESIT") { ver 7; }
    eğer metin_esit(t, "SOLA_KAYDIR") veya metin_esit(t, "SAGA_KAYDIR") { ver 8; }
    eğer metin_esit(t, "ARTI") veya metin_esit(t, "EKSI") { ver 9; }
    eğer metin_esit(t, "YILDIZ") veya metin_esit(t, "BOLU") veya metin_esit(t, "MOD") { ver 10; }
    ver 0;
}
işlev sonek_onc(t: metin) -> tam32 {
    eğer metin_esit(t, "NOKTA") veya metin_esit(t, "SOL_KOSELI")
      veya metin_esit(t, "SOL_PAREN") veya metin_esit(t, "CIFT_IKI_NOKTA")
      veya metin_esit(t, "OLARAK") { ver 12; }
    ver 0;
}
işlev ikili_op_ad(t: metin) -> metin {
    eğer metin_esit(t, "VEYA") { ver "veya"; }
    eğer metin_esit(t, "VE") { ver "ve"; }
    eğer metin_esit(t, "VEYA_BIT") { ver "|"; }
    eğer metin_esit(t, "OZVEYA_BIT") { ver "^"; }
    eğer metin_esit(t, "VE_BIT") { ver "&"; }
    eğer metin_esit(t, "ESIT_ESIT") { ver "=="; }
    eğer metin_esit(t, "ESIT_DEGIL") { ver "!="; }
    eğer metin_esit(t, "KUCUK") { ver "<"; }
    eğer metin_esit(t, "BUYUK") { ver ">"; }
    eğer metin_esit(t, "KUCUK_ESIT") { ver "<="; }
    eğer metin_esit(t, "BUYUK_ESIT") { ver ">="; }
    eğer metin_esit(t, "SOLA_KAYDIR") { ver "<<"; }
    eğer metin_esit(t, "SAGA_KAYDIR") { ver ">>"; }
    eğer metin_esit(t, "ARTI") { ver "+"; }
    eğer metin_esit(t, "EKSI") { ver "-"; }
    eğer metin_esit(t, "YILDIZ") { ver "*"; }
    eğer metin_esit(t, "BOLU") { ver "/"; }
    ver "%";
}

// ---- İleri bildirimler (özyineleme) parser'da gerek yok; KEMGU tek-geçiş
//      değil ama çağrı sırası: parse_oncelik <-> parse_onek <-> parse_birincil
//      <-> parse_sonek hepsi aşağıda; KEMGU forward-ref destekler. ----

// Generic argüman listesi `< T1, T2, ... >` → çocuk Dizi (>> kapanış böl).
işlev parse_generic_args(p: &değişken Ayr) -> Dizi<tam32> {
    bekle(p, "KUCUK");
    değişken args: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    eğer simdiki_buyuk_mu(p) { devam = yanlış; }
    iken devam {
        dizi_ekle(args, parse_tip(p));
        eğer sim_mi(p, "VIRGUL") { ilerle(p); }
        değilse { devam = yanlış; }
    }
    bekle_buyuk(p);
    ver args;
}
// Tek-argümanlı generic tip (seçimlik/tekkez/sabitsüre/görev/kanal/yetki).
işlev parse_tek_arg(p: &değişken Ayr, dad: metin, s: tam32, u: tam32) -> tam32 {
    bekle(p, "KUCUK");
    değişken ic: tam32 = parse_tip(p);
    bekle_buyuk(p);
    ver dugum1(p, dad, "", s, u, ic);
}

// Tam tip sözdizimi (ifade.c parse_tip ile birebir) — P4.
işlev parse_tip(p: &değişken Ayr) -> tam32 {
    değişken t: metin = simdiki(p);
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    // &T / &değişken T
    eğer metin_esit(t, "VE_BIT") {
        ilerle(p);
        değişken dv: metin = "";
        eğer sim_mi(p, "DEGISKEN") { ilerle(p); dv = "degisken"; }
        ver dugum1(p, "TIP_REFERANS", dv, s, u, parse_tip(p));
    }
    // *T
    eğer metin_esit(t, "YILDIZ") {
        ilerle(p);
        ver dugum1(p, "TIP_POINTER", "", s, u, parse_tip(p));
    }
    eğer metin_esit(t, "TEKKEZ") { ilerle(p); ver parse_tek_arg(p, "TIP_TEKKEZ", s, u); }
    eğer metin_esit(t, "SABITSURE") { ilerle(p); ver parse_tek_arg(p, "TIP_SABITSURE", s, u); }
    eğer metin_esit(t, "GOREV") { ilerle(p); ver parse_tek_arg(p, "TIP_GOREV", s, u); }
    eğer metin_esit(t, "KANAL") { ilerle(p); ver parse_tek_arg(p, "TIP_KANAL", s, u); }
    eğer metin_esit(t, "YETKI") { ilerle(p); ver parse_tek_arg(p, "TIP_YETKI", s, u); }
    eğer metin_esit(t, "SECIMLIK") { ilerle(p); ver parse_tek_arg(p, "TIP_SECIMLIK", s, u); }
    // sonuç<T,H>
    eğer metin_esit(t, "SONUC") {
        ilerle(p);
        bekle(p, "KUCUK");
        değişken dt: tam32 = parse_tip(p);
        bekle(p, "VIRGUL");
        değişken ht: tam32 = parse_tip(p);
        bekle_buyuk(p);
        ver dugum2(p, "TIP_SONUC", "", s, u, dt, ht);
    }
    // vektör<T, N> (N = compile-time tamsayı)
    eğer metin_esit(t, "VEKTOR") {
        ilerle(p);
        bekle(p, "KUCUK");
        değişken et: tam32 = parse_tip(p);
        bekle(p, "VIRGUL");
        değişken lane: metin = sim_lex(p);
        bekle(p, "TAMSAYI");
        bekle_buyuk(p);
        ver dugum1(p, "TIP_VEKTOR", lane, s, u, et);
    }
    // işlev(T1, ...) -> T
    eğer metin_esit(t, "ISLEV") {
        ilerle(p);
        bekle(p, "SOL_PAREN");
        değişken kids: Dizi<tam32> = [];
        eğer sim_mi(p, "SAG_PAREN") == yanlış {
            değişken devam: mantıksal = doğru;
            iken devam {
                eğer sim_mi(p, "SAG_PAREN") { devam = yanlış; }
                değilse {
                    dizi_ekle(kids, parse_tip(p));
                    eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                    değilse { devam = yanlış; }
                }
            }
        }
        bekle(p, "SAG_PAREN");
        bekle(p, "OK");
        dizi_ekle(kids, parse_tip(p));   // dönüş tipi (çocukların SONU)
        ver dugum_n(p, "TIP_ISLEV", "", s, u, kids);
    }
    // boş → birim tip (TIP_BASIT "boş")
    eğer metin_esit(t, "BOS") {
        değişken ad: metin = sim_lex(p);
        ilerle(p);
        ver dugum0(p, "TIP_BASIT", ad, s, u);
    }
    // Tanımlayıcı: basit / kullanıcı / Dizi / nitelikli yol / generic
    eğer metin_esit(t, "TANIMLAYICI") {
        değişken ad: metin = sim_lex(p);
        ilerle(p);
        // nitelikli yol: modül::Tip[::Tip...]
        değişken yol: tam32 = 0;
        değişken nitelikli: mantıksal = yanlış;
        eğer sim_mi(p, "CIFT_IKI_NOKTA") {
            yol = dugum0(p, "TANIMLAYICI", ad, s, u);
            iken sim_mi(p, "CIFT_IKI_NOKTA") {
                ilerle(p);
                değişken sag: metin = sim_lex(p);
                bekle(p, "TANIMLAYICI");
                yol = dugum1(p, "YOL", sag, s, u, yol);
            }
            nitelikli = doğru;
        }
        // generic argümanlar?
        eğer sim_mi(p, "KUCUK") {
            değişken args: Dizi<tam32> = parse_generic_args(p);
            // Dizi<T> özel (yalnız niteliksiz)
            eğer (nitelikli == yanlış) ve metin_esit(ad, "Dizi") ve (dizi_boyut(args) == 1) {
                ver dugum1(p, "TIP_DIZI", "", s, u, dizi_al(args, 0));
            }
            değişken yk: tam32 = yol;
            eğer nitelikli == yanlış { yk = dugum0(p, "TANIMLAYICI", ad, s, u); }
            değişken kids: Dizi<tam32> = [];
            dizi_ekle(kids, yk);
            değişken i: tam32 = 0;
            iken i < dizi_boyut(args) { dizi_ekle(kids, dizi_al(args, i)); i = i + 1; }
            ver dugum_n(p, "TIP_KULLANICI", "", s, u, kids);
        }
        // niteliksiz generic-siz: nitelikli yol → KULLANICI, değilse BASIT
        eğer nitelikli {
            ver dugum1(p, "TIP_KULLANICI", "", s, u, yol);
        }
        ver dugum0(p, "TIP_BASIT", ad, s, u);
    }
    p.hata_say = p.hata_say + 1;
    ilerle(p);
    ver dugum0(p, "HATA", "", s, u);
}

// Yapı oluşturma: Tip { alan: ifade, ... } (poz = tip_id).
işlev parse_yapi_olustur(p: &değişken Ayr, tip_ad: metin, s: tam32, u: tam32) -> tam32 {
    ilerle(p);  // '{'
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse {
            değişken as: tam32 = sim_sat(p);  değişken au: tam32 = sim_sut(p);
            değişken alan: metin = sim_lex(p);
            bekle(p, "TANIMLAYICI");
            bekle(p, "IKI_NOKTA");
            değişken dg: tam32 = parse_ifade(p);
            dizi_ekle(kids, dugum1(p, "ALAN_ATAMA", alan, as, au, dg));
            eğer sim_mi(p, "VIRGUL") { ilerle(p); }
            değilse { devam = yanlış; }
        }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "YAPI_OLUSTUR", tip_ad, s, u, kids);
}
// Dizi oluşturma: [e1, e2, ...] (poz = '[').
işlev parse_dizi_olustur(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // '['
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_KOSELI") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse {
            dizi_ekle(kids, parse_ifade(p));
            eğer sim_mi(p, "VIRGUL") { ilerle(p); }
            değilse { devam = yanlış; }
        }
    }
    bekle(p, "SAG_KOSELI");
    ver dugum_n(p, "DIZI_OLUSTUR", "", s, u, kids);
}
// Parametre: ad ":" tip  |  kendin  |  &kendin  |  &değişken kendin.
işlev parse_parametre(p: &değişken Ayr) -> tam32 {
    // & ile başlayan kendin: &kendin / &değişken kendin
    eğer sim_mi(p, "VE_BIT") {
        değişken nxt: metin = tip_i(p, p.imlec + 1);
        eğer metin_esit(nxt, "KENDIN") veya metin_esit(nxt, "DEGISKEN") {
            ilerle(p);  // &
            eğer sim_mi(p, "DEGISKEN") { ilerle(p); }
            değişken ks: tam32 = sim_sat(p);  değişken ku: tam32 = sim_sut(p);
            eğer sim_mi(p, "KENDIN") {
                ilerle(p);
                ver dugum0(p, "PARAMETRE", "kendin", ks, ku);
            }
            p.hata_say = p.hata_say + 1;
            ver dugum0(p, "HATA", "", ks, ku);
        }
    }
    eğer sim_mi(p, "KENDIN") {
        değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
        ilerle(p);
        ver dugum0(p, "PARAMETRE", "kendin", s, u);
    }
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    bekle(p, "IKI_NOKTA");
    ver dugum1(p, "PARAMETRE", ad, s, u, parse_tip(p));
}
// Generic tip parametre listesi `<T, U: B1 + B2, ...>` — PARSE + DISCARD (dump'ta
// yok; bound tip düğümleri orphan kalır, kök'ten erişilmez). `>>` kapanış böl.
işlev atla_tip_paramlar(p: &değişken Ayr) -> tam32 {
    eğer sim_mi(p, "KUCUK") == yanlış { ver 0; }
    bekle(p, "KUCUK");
    değişken devam: mantıksal = doğru;
    eğer simdiki_buyuk_mu(p) { devam = yanlış; }
    iken devam {
        bekle(p, "TANIMLAYICI");          // param adı
        eğer sim_mi(p, "IKI_NOKTA") {     // bound listesi
            ilerle(p);
            parse_tip(p);                 // ilk bound (orphan düğüm)
            iken sim_mi(p, "ARTI") { ilerle(p); parse_tip(p); }
        }
        eğer sim_mi(p, "VIRGUL") { ilerle(p); }
        değilse { devam = yanlış; }
    }
    bekle_buyuk(p);
    ver 0;
}
// Lambda: |p: t, ...| ifade  veya  |...| { blok } (poz = ilk '|').
işlev parse_lambda(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // ilk '|' (VEYA_BIT)
    değişken kids: Dizi<tam32> = [];
    eğer sim_mi(p, "VEYA_BIT") == yanlış {
        değişken devam: mantıksal = doğru;
        iken devam {
            dizi_ekle(kids, parse_parametre(p));
            eğer sim_mi(p, "VIRGUL") { ilerle(p); }
            değilse { devam = yanlış; }
        }
    }
    bekle(p, "VEYA_BIT");  // kapanış '|'
    eğer sim_mi(p, "SOL_SUSLU") { dizi_ekle(kids, parse_blok(p)); }
    değilse { dizi_ekle(kids, parse_ifade(p)); }
    ver dugum_n(p, "LAMBDA", "", s, u, kids);
}

// Birincil ifade.
işlev parse_birincil(p: &değişken Ayr) -> tam32 {
    değişken t: metin = simdiki(p);
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    eğer metin_esit(t, "TAMSAYI") {
        değişken v: tam64 = tamsayi_deger(sim_lex(p));
        ilerle(p);
        ver dugum0(p, "TAM", tam64_str(v), s, u);
    }
    eğer metin_esit(t, "ONDALIK") {
        değişken lx: metin = sim_lex(p);
        ilerle(p);
        ver dugum0(p, "KESIRLI", ondalik_bicimle(lx), s, u);
    }
    eğer metin_esit(t, "DOGRU") { ilerle(p); ver dugum0(p, "MANTIKSAL", "1", s, u); }
    eğer metin_esit(t, "YANLIS") { ilerle(p); ver dugum0(p, "MANTIKSAL", "0", s, u); }
    eğer metin_esit(t, "BOS") { ilerle(p); ver dugum0(p, "BOS", "", s, u); }
    eğer metin_esit(t, "TANIMLAYICI") veya metin_esit(t, "KENDIN")
      veya metin_esit(t, "HIC") veya metin_esit(t, "DEGER")
      veya metin_esit(t, "TAMAM") veya metin_esit(t, "HATA") {
        değişken ad: metin = sim_lex(p);
        ilerle(p);
        eğer (p.yapi_izni == 1) ve sim_mi(p, "SOL_SUSLU") { ver parse_yapi_olustur(p, ad, s, u); }
        ver dugum0(p, "TANIMLAYICI", ad, s, u);
    }
    eğer metin_esit(t, "METIN") {
        değişken off: tam32 = dizi_al(p.t_off, p.imlec);
        değişken ln: tam32 = dizi_al(p.t_uz, p.imlec);
        değişken icuz: tam32 = ln - 2;
        eğer icuz < 0 { icuz = 0; }
        değişken ic: metin = metin_kes(p.kaynak, off + 1, icuz);
        ilerle(p);
        ver dugum0(p, "METIN", ic, s, u);
    }
    eğer metin_esit(t, "KARAKTER") {
        değişken off: tam32 = dizi_al(p.t_off, p.imlec);
        değişken ln: tam32 = dizi_al(p.t_uz, p.imlec);
        değişken kp: tam32 = 0;
        eğer ln >= 3 { kp = bayt(p.kaynak, off + 1); }
        ilerle(p);
        ver dugum0(p, "KARAKTER", karakter_deger(kp), s, u);
    }
    eğer metin_esit(t, "SOL_KOSELI") { ver parse_dizi_olustur(p); }
    eğer metin_esit(t, "VEYA_BIT") { ver parse_lambda(p); }
    eğer metin_esit(t, "KULLAN") {
        ilerle(p);
        bekle(p, "SOL_PAREN");
        değişken e: tam32 = parse_ifade(p);
        bekle(p, "SAG_PAREN");
        ver dugum1(p, "KULLAN_IFADE", "", s, u, e);
    }
    eğer metin_esit(t, "IMHA") {
        ilerle(p);
        bekle(p, "SOL_PAREN");
        değişken e: tam32 = parse_ifade(p);
        bekle(p, "SAG_PAREN");
        ver dugum1(p, "IMHA_IFADE", "", s, u, e);
    }
    // delege(y, izin) / geri_al(y) → DUGUM_CAGRI (hedef = TANIMLAYICI "delege"/"geri_al")
    eğer metin_esit(t, "DELEGE") veya metin_esit(t, "GERI_AL") {
        değişken ad: metin = sim_lex(p);
        ilerle(p);
        bekle(p, "SOL_PAREN");
        değişken kids: Dizi<tam32> = [];
        dizi_ekle(kids, dugum0(p, "TANIMLAYICI", ad, s, u));  // hedef
        eğer sim_mi(p, "SAG_PAREN") == yanlış {
            değişken devam: mantıksal = doğru;
            iken devam {
                dizi_ekle(kids, parse_ifade(p));
                eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                değilse { devam = yanlış; }
            }
        }
        bekle(p, "SAG_PAREN");
        ver dugum_n(p, "CAGRI", "", s, u, kids);
    }
    eğer metin_esit(t, "SOL_PAREN") {
        ilerle(p);
        değişken ic: tam32 = parse_ifade(p);
        bekle(p, "SAG_PAREN");
        ver ic;
    }
    // P1 dışı (KESIRLI float → sonraki adım): hata düğümü
    p.hata_say = p.hata_say + 1;
    ilerle(p);
    ver dugum0(p, "HATA", "", s, u);
}

// Önek operatörler (operand = parse_oncelik(ONC_ONEK=11)).
işlev parse_onek(p: &değişken Ayr) -> tam32 {
    değişken t: metin = simdiki(p);
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    eğer metin_esit(t, "EKSI") {
        ilerle(p);
        ver dugum1(p, "TEKLI", "neg", s, u, parse_oncelik(p, 11));
    }
    eğer metin_esit(t, "DEGIL") {
        ilerle(p);
        ver dugum1(p, "TEKLI", "degil", s, u, parse_oncelik(p, 11));
    }
    eğer metin_esit(t, "DEGIL_BIT") {
        ilerle(p);
        ver dugum1(p, "TEKLI", "~", s, u, parse_oncelik(p, 11));
    }
    eğer metin_esit(t, "YILDIZ") {
        ilerle(p);
        ver dugum1(p, "TEKLI", "deref*", s, u, parse_oncelik(p, 11));
    }
    eğer metin_esit(t, "VE_BIT") {
        ilerle(p);
        değişken opad: metin = "&";
        eğer sim_mi(p, "DEGISKEN") { ilerle(p); opad = "&degisken"; }
        ver dugum1(p, "TEKLI", opad, s, u, parse_oncelik(p, 11));
    }
    ver parse_birincil(p);
}

// Sonek operatör (. [] () :: olarak). Pozisyon = sonek token'ı.
işlev parse_sonek(p: &değişken Ayr, sol: tam32) -> tam32 {
    değişken t: metin = simdiki(p);
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    eğer metin_esit(t, "NOKTA") {
        ilerle(p);
        değişken alan: metin = sim_lex(p);
        bekle(p, "TANIMLAYICI");
        ver dugum1(p, "ERISIM", alan, s, u, sol);
    }
    eğer metin_esit(t, "SOL_KOSELI") {
        ilerle(p);
        değişken idx: tam32 = parse_ifade(p);
        bekle(p, "SAG_KOSELI");
        ver dugum2(p, "INDEKS", "", s, u, sol, idx);
    }
    eğer metin_esit(t, "SOL_PAREN") {
        ilerle(p);
        değişken kids: Dizi<tam32> = [];
        dizi_ekle(kids, sol);  // çocuk[0] = hedef
        eğer sim_mi(p, "SAG_PAREN") == yanlış {
            değişken devam: mantıksal = doğru;
            iken devam {
                eğer sim_mi(p, "SAG_PAREN") { devam = yanlış; }
                değilse {
                    dizi_ekle(kids, parse_ifade(p));
                    eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                    değilse { devam = yanlış; }
                }
            }
        }
        bekle(p, "SAG_PAREN");
        ver dugum_n(p, "CAGRI", "", s, u, kids);
    }
    eğer metin_esit(t, "CIFT_IKI_NOKTA") {
        ilerle(p);
        değişken sag: metin = sim_lex(p);
        bekle(p, "TANIMLAYICI");
        ver dugum1(p, "YOL", sag, s, u, sol);
    }
    eğer metin_esit(t, "OLARAK") {
        ilerle(p);
        değişken ht: tam32 = parse_tip(p);
        ver dugum2(p, "TIP_DONUSTUR", "", s, u, sol, ht);
    }
    ver sol;
}

// Pratt ana döngüsü (ifade.c parse_oncelik ile birebir).
işlev parse_oncelik(p: &değişken Ayr, min_onc: tam32) -> tam32 {
    değişken sol: tam32 = parse_onek(p);
    değişken devam: mantıksal = doğru;
    iken devam {
        değişken t: metin = simdiki(p);
        eğer sonek_onc(t) > min_onc {
            sol = parse_sonek(p, sol);
        } değilse {
            değişken oo: tam32 = ikili_onc(t);
            eğer oo <= min_onc { devam = yanlış; }
            değilse {
                değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
                değişken opad: metin = ikili_op_ad(t);
                ilerle(p);
                değişken sag: tam32 = parse_oncelik(p, oo);
                sol = dugum2(p, "IKILI", opad, s, u, sol, sag);
            }
        }
    }
    ver sol;
}
işlev parse_ifade(p: &değişken Ayr) -> tam32 { ver parse_oncelik(p, 0); }

// ---- P2: Deyimler / kontrol akışı ----
// Koşul ifadesi (yapı-oluştur izni KAPALI → `eğer x {` → '{' blok başı).
işlev parse_kosul(p: &değişken Ayr) -> tam32 {
    değişken eski: tam32 = p.yapi_izni;
    p.yapi_izni = 0;
    değişken d: tam32 = parse_ifade(p);
    p.yapi_izni = eski;
    ver d;
}
işlev parse_ver(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // ver
    değişken kids: Dizi<tam32> = [];
    eğer sim_mi(p, "NOKTALI_VIRGUL") == yanlış { dizi_ekle(kids, parse_ifade(p)); }
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum_n(p, "VER", "", s, u, kids);
}
işlev parse_degisken(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // değişken
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    değişken kids: Dizi<tam32> = [];
    eğer sim_mi(p, "IKI_NOKTA") { ilerle(p); dizi_ekle(kids, parse_tip(p)); }
    bekle(p, "ESIT");
    dizi_ekle(kids, parse_ifade(p));
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum_n(p, "DEGISKEN", ad, s, u, kids);
}
işlev parse_ifade_veya_atama(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    değişken e: tam32 = parse_ifade(p);
    eğer sim_mi(p, "ESIT") {
        ilerle(p);
        değişken dg: tam32 = parse_ifade(p);
        bekle(p, "NOKTALI_VIRGUL");
        ver dugum2(p, "ATAMA", "", s, u, e, dg);
    }
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum1(p, "IFADE_DEYIMI", "", s, u, e);
}
işlev parse_eger(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // eğer
    değişken kids: Dizi<tam32> = [];
    dizi_ekle(kids, parse_kosul(p));   // koşul
    dizi_ekle(kids, parse_blok(p));    // eğer dalı
    eğer sim_mi(p, "DEGILSE") {
        ilerle(p);
        eğer sim_mi(p, "EGER") { dizi_ekle(kids, parse_eger(p)); }  // else-if zinciri
        değilse { dizi_ekle(kids, parse_blok(p)); }
    }
    ver dugum_n(p, "EGER", "", s, u, kids);
}
işlev parse_iken(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // iken
    değişken kosul: tam32 = parse_kosul(p);
    değişken govde: tam32 = parse_blok(p);
    ver dugum2(p, "IKEN", "", s, u, kosul, govde);
}
işlev parse_icin(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // için
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    bekle(p, "IKI_NOKTA");
    değişken kol: tam32 = parse_kosul(p);
    değişken govde: tam32 = parse_blok(p);
    ver dugum2(p, "ICIN", ad, s, u, kol, govde);
}
işlev parse_guvensiz(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // güvensiz
    eğer sim_mi(p, "SOL_KOSELI") {     // [etiket: "..."] (dump'ta yok, tüket)
        ilerle(p);
        bekle(p, "TANIMLAYICI");
        bekle(p, "IKI_NOKTA");
        bekle(p, "METIN");
        bekle(p, "SAG_KOSELI");
    }
    ver dugum1(p, "GUVENSIZ", "", s, u, parse_blok(p));
}
// Desen (eşleş kolları için).
işlev parse_desen(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    eğer sim_mi(p, "TANIMLAYICI") ve metin_esit(sim_lex(p), "_") {
        ilerle(p);
        ver dugum0(p, "DESEN_JOKER", "", s, u);
    }
    eğer sim_mi(p, "TANIMLAYICI") veya sim_mi(p, "HIC") veya sim_mi(p, "DEGER")
      veya sim_mi(p, "TAMAM") veya sim_mi(p, "HATA") {
        değişken ad: metin = sim_lex(p);
        ilerle(p);
        eğer sim_mi(p, "CIFT_IKI_NOKTA") {        // Çeşit::Varyant [(payload)]
            ilerle(p);
            değişken vad: metin = sim_lex(p);
            bekle(p, "TANIMLAYICI");
            değişken kids: Dizi<tam32> = [];
            eğer sim_mi(p, "SOL_PAREN") {
                ilerle(p);
                değişken devam: mantıksal = doğru;
                iken devam {
                    eğer sim_mi(p, "SAG_PAREN") { devam = yanlış; }
                    değilse {
                        dizi_ekle(kids, parse_desen(p));
                        eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                        değilse { devam = yanlış; }
                    }
                }
                bekle(p, "SAG_PAREN");
            }
            ver dugum_n(p, "DESEN_YOL", metin_birlestir(metin_birlestir(ad, "::"), vad), s, u, kids);
        }
        eğer sim_mi(p, "SOL_PAREN") {             // Yapıcı(alt, ...)
            ilerle(p);
            değişken kids: Dizi<tam32> = [];
            değişken devam: mantıksal = doğru;
            iken devam {
                eğer sim_mi(p, "SAG_PAREN") { devam = yanlış; }
                değilse {
                    dizi_ekle(kids, parse_desen(p));
                    eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                    değilse { devam = yanlış; }
                }
            }
            bekle(p, "SAG_PAREN");
            ver dugum_n(p, "DESEN_YAPICI", ad, s, u, kids);
        }
        ver dugum0(p, "DESEN_TANIMLAYICI", ad, s, u);
    }
    eğer sim_mi(p, "TAMSAYI") veya sim_mi(p, "ONDALIK") veya sim_mi(p, "METIN")
      veya sim_mi(p, "KARAKTER") veya sim_mi(p, "DOGRU") veya sim_mi(p, "YANLIS")
      veya sim_mi(p, "BOS") {
        ver dugum1(p, "DESEN_LITERAL", "", s, u, parse_ifade(p));
    }
    p.hata_say = p.hata_say + 1;
    ilerle(p);
    ver dugum0(p, "HATA", "", s, u);
}
işlev parse_esles_kolu(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    değişken desen: tam32 = parse_desen(p);
    bekle(p, "KALIN_OK");
    değişken govde: tam32 = 0;
    eğer sim_mi(p, "SOL_SUSLU") { govde = parse_blok(p); }
    değilse { govde = parse_ifade(p); bekle(p, "NOKTALI_VIRGUL"); }
    ver dugum2(p, "ESLES_KOLU", "", s, u, desen, govde);
}
işlev parse_esles(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // eşleş
    değişken kids: Dizi<tam32> = [];
    dizi_ekle(kids, parse_kosul(p));   // eşleşen değer
    bekle(p, "SOL_SUSLU");
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse { dizi_ekle(kids, parse_esles_kolu(p)); }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "ESLES", "", s, u, kids);
}
// satıriçi_asm { mimari: X  şablon: r#".."#  çıktı("k",&v) girdi("k",e) bozulan("k") çevrim: N }
// Yalnız `girdi` ifadeleri AST çocuğu (C ast_duz_yaz); gerisi tüketilir.
işlev asm_kisit_atla(p: &değişken Ayr) -> tam32 {
    eğer sim_mi(p, "METIN") veya sim_mi(p, "HAM_METIN") { ilerle(p); ver 1; }
    p.hata_say = p.hata_say + 1; ver 0;
}
işlev parse_satirici_asm(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // satıriçi_asm
    bekle(p, "SOL_SUSLU");
    değişken kids: Dizi<tam32> = [];   // girdi ifadeleri
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse {
            değişken lx: metin = sim_lex(p);
            eğer metin_esit(lx, "mimari") {
                ilerle(p); bekle(p, "IKI_NOKTA"); bekle(p, "TANIMLAYICI");
            } değilse {
            eğer metin_esit(lx, "şablon") {
                ilerle(p); bekle(p, "IKI_NOKTA"); asm_kisit_atla(p);
            } değilse {
            eğer metin_esit(lx, "çevrim") {
                ilerle(p); bekle(p, "IKI_NOKTA"); parse_ifade(p);
            } değilse {
            eğer metin_esit(lx, "çıktı") {
                ilerle(p); bekle(p, "SOL_PAREN"); asm_kisit_atla(p);
                bekle(p, "VIRGUL"); bekle(p, "VE_BIT");
                eğer sim_mi(p, "DEGISKEN") { ilerle(p); }
                bekle(p, "TANIMLAYICI"); bekle(p, "SAG_PAREN");
            } değilse {
            eğer metin_esit(lx, "girdi") {
                ilerle(p); bekle(p, "SOL_PAREN"); asm_kisit_atla(p);
                bekle(p, "VIRGUL"); dizi_ekle(kids, parse_ifade(p)); bekle(p, "SAG_PAREN");
            } değilse {
            eğer metin_esit(lx, "bozulan") {
                ilerle(p); bekle(p, "SOL_PAREN"); asm_kisit_atla(p); bekle(p, "SAG_PAREN");
            } değilse {
                p.hata_say = p.hata_say + 1; ilerle(p);   // bilinmeyen clause
            } } } } } }
        }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "SATIRICI_ASM", "", s, u, kids);
}
işlev parse_deyim(p: &değişken Ayr) -> tam32 {
    eğer sim_mi(p, "DEGISKEN") { ver parse_degisken(p); }
    eğer sim_mi(p, "VER") { ver parse_ver(p); }
    eğer sim_mi(p, "SOL_SUSLU") { ver parse_blok(p); }
    eğer sim_mi(p, "EGER") { ver parse_eger(p); }
    eğer sim_mi(p, "IKEN") { ver parse_iken(p); }
    eğer sim_mi(p, "ICIN") { ver parse_icin(p); }
    eğer sim_mi(p, "ESLES") { ver parse_esles(p); }
    eğer sim_mi(p, "GUVENSIZ") { ver parse_guvensiz(p); }
    eğer sim_mi(p, "SATIRICI_ASM") { ver parse_satirici_asm(p); }
    ver parse_ifade_veya_atama(p);
}
işlev parse_blok(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    bekle(p, "SOL_SUSLU");
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse { dizi_ekle(kids, parse_deyim(p)); }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "BLOK", "", s, u, kids);
}
// ---- P3: Bildirimler (işlev/yapı/çeşit/özellik/uygula/sabit) ----
// İşlev (gerçekzamanlı? + generic + param + dönüş + gövde). imza_yeterli=1 →
// gövde yerine ';' (özellik imzası). Generic params PARSE+DISCARD (dump'ta yok).
işlev parse_islev_genel(p: &değişken Ayr, imza_yeterli: tam32) -> tam32 {
    // D-255: çıplak / gerçekzamanlı işlev-modifier (herhangi sıra). C parser.c aynası.
    değişken ciplak: tam32 = 0;
    değişken devam_mod: mantıksal = doğru;
    iken devam_mod {
        eğer sim_mi(p, "GERCEKZAMANLI") { ilerle(p); }
        değilse {
            eğer sim_mi(p, "CIPLAK") { ciplak = 1; ilerle(p); }
            değilse { devam_mod = yanlış; }
        }
    }
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    bekle(p, "ISLEV");
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    atla_tip_paramlar(p);
    bekle(p, "SOL_PAREN");
    değişken kids: Dizi<tam32> = [];
    eğer sim_mi(p, "SAG_PAREN") == yanlış {
        değişken devam: mantıksal = doğru;
        iken devam {
            dizi_ekle(kids, parse_parametre(p));
            eğer sim_mi(p, "VIRGUL") { ilerle(p); }
            değilse { devam = yanlış; }
        }
    }
    bekle(p, "SAG_PAREN");
    eğer sim_mi(p, "OK") { ilerle(p); dizi_ekle(kids, parse_tip(p)); }
    eğer sim_mi(p, "SOL_SUSLU") { dizi_ekle(kids, parse_blok(p)); }
    değilse {
        eğer (imza_yeterli == 1) ve sim_mi(p, "NOKTALI_VIRGUL") { ilerle(p); }
        değilse { p.hata_say = p.hata_say + 1; }
    }
    değişken ni: tam32 = dugum_n(p, "ISLEV", ad, s, u, kids);
    eğer ciplak == 1 { dizi_ekle(p.g_ciplak, ni); }   // D-255: region-prologue SKIP işareti
    ver ni;
}
işlev parse_islev(p: &değişken Ayr) -> tam32 { ver parse_islev_genel(p, 0); }

işlev parse_alan(p: &değişken Ayr) -> tam32 {
    eğer sim_mi(p, "GENEL") { ilerle(p); }   // genel öneki (dump'ta yok)
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    bekle(p, "IKI_NOKTA");
    değişken tip: tam32 = parse_tip(p);
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum1(p, "ALAN", ad, s, u, tip);
}
işlev parse_yapi(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // yapı
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    atla_tip_paramlar(p);
    bekle(p, "SOL_SUSLU");
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse { dizi_ekle(kids, parse_alan(p)); }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "YAPI", ad, s, u, kids);
}
işlev parse_cesit(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // çeşit
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    eğer sim_mi(p, "KUCUK") {           // çeşit generic v1'de YOK → atla (C birebir)
        p.hata_say = p.hata_say + 1;
        iken (sim_mi(p, "BUYUK") == yanlış) ve (sim_mi(p, "SOL_SUSLU") == yanlış)
          ve (sim_mi(p, "DOSYA_SONU") == yanlış) { ilerle(p); }
        eğer sim_mi(p, "BUYUK") { ilerle(p); }
    }
    bekle(p, "SOL_SUSLU");
    değişken kids: Dizi<tam32> = [];   // payload tip düğümleri (varyant-sırası düz)
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse {
            eğer sim_mi(p, "TANIMLAYICI") == yanlış {  // anti-hang (C panik_sync+break)
                p.hata_say = p.hata_say + 1; ilerle(p); devam = yanlış;
            } değilse {
            değişken vad: metin = sim_lex(p);   // varyant adı (dump'a girmez)
            ilerle(p);
            değişken pc: tam32 = 0;
            eğer sim_mi(p, "SOL_PAREN") {
                ilerle(p);
                değişken d2: mantıksal = doğru;
                iken d2 {
                    eğer sim_mi(p, "SAG_PAREN") { d2 = yanlış; }
                    değilse {
                        dizi_ekle(kids, parse_tip(p));
                        pc = pc + 1;
                        eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                        değilse { d2 = yanlış; }
                    }
                }
                bekle(p, "SAG_PAREN");
            }
            // D3 yan-kanal: varyant disc=cv_* pozisyonu; çeşit-bazlı sıra korunur.
            dizi_ekle(p.cv_cesit, ad);
            dizi_ekle(p.cv_ad, vad);
            dizi_ekle(p.cv_pc, pc);
            eğer sim_mi(p, "VIRGUL") { ilerle(p); }   // virgül opsiyonel
            }
        }
    }
    bekle(p, "SAG_SUSLU");
    değişken cn: tam32 = dugum_n(p, "CESIT", ad, s, u, kids);
    dizi_ekle(p.cc_ad, ad);       // D3: çeşit-node registry (payload struct için)
    dizi_ekle(p.cc_node, cn);
    ver cn;
}

// D3 çeşit yan-kanal sorguları (cv_* üzerinde).
işlev cesit_enum_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken bulundu: mantıksal = yanlış;
    değişken i: tam32 = 0;
    değişken n: tam32 = dizi_boyut(p.cv_cesit);
    iken i < n {
        eğer metin_esit(dizi_al(p.cv_cesit, i), ad) {
            bulundu = doğru;
            eğer dizi_al(p.cv_pc, i) > 0 { ver yanlış; }   // payload var → enum değil
        }
        i = i + 1;
    }
    ver bulundu;
}
// (çeşit, varyant) → disc indeksi (çeşit içindeki bildirim sırası). Bulunmazsa 0.
işlev cesit_disc(p: &değişken Ayr, cad: metin, vad: metin) -> tam32 {
    değişken d: tam32 = 0;
    değişken i: tam32 = 0;
    değişken n: tam32 = dizi_boyut(p.cv_cesit);
    iken i < n {
        eğer metin_esit(dizi_al(p.cv_cesit, i), cad) {
            eğer metin_esit(dizi_al(p.cv_ad, i), vad) { ver d; }
            d = d + 1;
        }
        i = i + 1;
    }
    ver 0;
}
// "Çeşit::Varyant" yolunu "::" üzerinde bölüp disc döndür (DESEN_YOL deseni için).
işlev yol_disc(p: &değişken Ayr, s: metin) -> tam32 {
    değişken n: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 0;
    iken i + 1 < n {
        eğer bayt(s, i) == 58 ve bayt(s, i + 1) == 58 {   // "::"
            değişken cad: metin = metin_kes(s, 0, i);
            değişken vad: metin = metin_kes(s, i + 2, n - i - 2);
            ver cesit_disc(p, cad, vad);
        }
        i = i + 1;
    }
    ver 0;
}
// "Çeşit::Varyant" yolundan çeşit adını (sol) çıkar.
işlev yol_cesit(s: metin) -> metin {
    değişken n: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 0;
    iken i + 1 < n {
        eğer bayt(s, i) == 58 ve bayt(s, i + 1) == 58 { ver metin_kes(s, 0, i); }
        i = i + 1;
    }
    ver s;
}
// D3 payload çeşit: ad çeşit mi (cc_ registry)?
işlev cesit_var_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = 0;
    değişken n: tam32 = dizi_boyut(p.cc_ad);
    iken i < n {
        eğer metin_esit(dizi_al(p.cc_ad, i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// ad → CESIT düğüm idx (yok → -1).
işlev cesit_node_bul(p: &değişken Ayr, ad: metin) -> tam32 {
    değişken i: tam32 = 0;
    değişken n: tam32 = dizi_boyut(p.cc_ad);
    iken i < n {
        eğer metin_esit(dizi_al(p.cc_ad, i), ad) { ver dizi_al(p.cc_node, i); }
        i = i + 1;
    }
    ver 0 - 1;
}
// payload çeşit struct: {i8, <tüm varyant payload tipleri düz>} (kids = payloadlar).
işlev cesit_struct_ir(p: &değişken Ayr, ad: metin) -> metin {
    değişken cn: tam32 = cesit_node_bul(p, ad);
    eğer cn < 0 { ver "{i8}"; }
    değişken cb: tam32 = dizi_al(p.a_cb, cn);
    değişken cs: tam32 = dizi_al(p.a_cs, cn);
    değişken r: metin = "{i8";
    değişken i: tam32 = 0;
    iken i < cs {
        r = metin_birlestir(r, ", ");
        r = metin_birlestir(r, ll_tip(p, dizi_al(p.cocuk, cb + i)));
        i = i + 1;
    }
    ver metin_birlestir(r, "}");
}
// disc varyantının ilk payload alanının struct ofseti (1 + önceki payload sayıları).
işlev cesit_var_ofset(p: &değişken Ayr, cad: metin, disc: tam32) -> tam32 {
    değişken ofs: tam32 = 1;
    değişken vd: tam32 = 0;
    değişken i: tam32 = 0;
    değişken n: tam32 = dizi_boyut(p.cv_cesit);
    iken i < n {
        eğer metin_esit(dizi_al(p.cv_cesit, i), cad) {
            eğer vd >= disc { ver ofs; }
            ofs = ofs + dizi_al(p.cv_pc, i);
            vd = vd + 1;
        }
        i = i + 1;
    }
    ver ofs;
}
işlev parse_ozellik(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // özellik
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    atla_tip_paramlar(p);
    bekle(p, "SOL_SUSLU");
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "ISLEV") veya sim_mi(p, "GERCEKZAMANLI") veya sim_mi(p, "CIPLAK") {
            dizi_ekle(kids, parse_islev_genel(p, 1));
        } değilse { devam = yanlış; }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "OZELLIK", ad, s, u, kids);
}
işlev parse_uygula(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // uygula
    atla_tip_paramlar(p);
    değişken birinci: tam32 = parse_tip(p);
    değişken kids: Dizi<tam32> = [];
    eğer sim_mi(p, "ICIN") {           // trait impl: tip için hedef
        ilerle(p);
        dizi_ekle(kids, parse_tip(p));  // hedef tip (UYGULA.tip)
        dizi_ekle(kids, birinci);       // özellik (UYGULA.ozellikler[0])
    } değilse {
        dizi_ekle(kids, birinci);       // inherent: hedef = birinci
    }
    bekle(p, "SOL_SUSLU");
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "ISLEV") veya sim_mi(p, "GERCEKZAMANLI") veya sim_mi(p, "CIPLAK") {
            dizi_ekle(kids, parse_islev(p));
        } değilse { devam = yanlış; }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "UYGULA", "", s, u, kids);
}
işlev parse_sabit(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // sabit
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    bekle(p, "IKI_NOKTA");
    değişken tip: tam32 = parse_tip(p);
    bekle(p, "ESIT");
    değişken dg: tam32 = parse_ifade(p);
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum2(p, "SABIT", ad, s, u, tip, dg);
}
// D-253: küresel değişken ad: tip = init;  → "KURESEL" düğüm (C parser.c parite).
işlev parse_kuresel(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // küresel
    bekle(p, "DEGISKEN");
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    bekle(p, "IKI_NOKTA");
    değişken tip: tam32 = parse_tip(p);
    bekle(p, "ESIT");
    değişken dg: tam32 = parse_ifade(p);
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum2(p, "KURESEL", ad, s, u, tip, dg);
}
// ---- P5: modül / kullan / dışa / genel ----
// kullan m[::seg...][::{a,b}][olarak d];  → KULLAN (deger=yol; seçili/alias dump'ta yok).
işlev parse_kullan(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // kullan
    değişken yol: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    değişken devam: mantıksal = doğru;
    iken devam ve sim_mi(p, "CIFT_IKI_NOKTA") {
        ilerle(p);
        eğer sim_mi(p, "SOL_SUSLU") {      // ::{a, b} seçili import
            ilerle(p);
            değişken d2: mantıksal = doğru;
            iken d2 {
                bekle(p, "TANIMLAYICI");
                eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                değilse { d2 = yanlış; }
            }
            bekle(p, "SAG_SUSLU");
            devam = yanlış;
        } değilse {
            değişken seg: metin = sim_lex(p);
            bekle(p, "TANIMLAYICI");
            yol = metin_birlestir(metin_birlestir(yol, "::"), seg);
        }
    }
    eğer sim_mi(p, "OLARAK") { ilerle(p); bekle(p, "TANIMLAYICI"); }  // alias
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum0(p, "KULLAN", yol, s, u);
}
// genel/dışa sonrası tanım (işlev/yapı/çeşit/sabit).
işlev parse_disa_govde(p: &değişken Ayr) -> tam32 {
    eğer sim_mi(p, "GERCEKZAMANLI") veya sim_mi(p, "ISLEV") veya sim_mi(p, "CIPLAK") { ver parse_islev(p); }
    eğer sim_mi(p, "YAPI") { ver parse_yapi(p); }
    eğer sim_mi(p, "CESIT") { ver parse_cesit(p); }
    eğer sim_mi(p, "SABIT") { ver parse_sabit(p); }
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    p.hata_say = p.hata_say + 1;
    ilerle(p);
    ver dugum0(p, "HATA", "", s, u);
}
işlev parse_disa(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // dışa
    ver dugum1(p, "DISA", "", s, u, parse_disa_govde(p));
}
// genel SARMALAMAZ — iç tanımı doğrudan döner (genel_mi bayrağı dump'ta yok).
işlev parse_genel(p: &değişken Ayr) -> tam32 {
    ilerle(p);  // genel
    ver parse_disa_govde(p);
}
işlev parse_modul(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // modül
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    bekle(p, "SOL_SUSLU");
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse { dizi_ekle(kids, parse_ust_oge(p)); }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "MODUL", ad, s, u, kids);
}
işlev parse_ust_oge(p: &değişken Ayr) -> tam32 {
    eğer sim_mi(p, "GERCEKZAMANLI") veya sim_mi(p, "ISLEV") veya sim_mi(p, "CIPLAK") { ver parse_islev(p); }
    eğer sim_mi(p, "YAPI") { ver parse_yapi(p); }
    eğer sim_mi(p, "CESIT") { ver parse_cesit(p); }
    eğer sim_mi(p, "OZELLIK") { ver parse_ozellik(p); }
    eğer sim_mi(p, "UYGULA") { ver parse_uygula(p); }
    eğer sim_mi(p, "SABIT") { ver parse_sabit(p); }
    eğer sim_mi(p, "KURESEL") { ver parse_kuresel(p); }   // D-253
    eğer sim_mi(p, "KULLAN") { ver parse_kullan(p); }
    eğer sim_mi(p, "DISA") { ver parse_disa(p); }
    eğer sim_mi(p, "GENEL") { ver parse_genel(p); }
    eğer sim_mi(p, "MODUL") { ver parse_modul(p); }
    // P5: satıriçi_asm (üst düzey değil; deyim) — kalan
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    p.hata_say = p.hata_say + 1;
    ilerle(p);
    ver dugum0(p, "HATA", "", s, u);
}
işlev parse_program(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);  // ilk token konumu
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse { dizi_ekle(kids, parse_ust_oge(p)); }
    }
    ver dugum_n(p, "PROGRAM", "", s, u, kids);
}

// ---- Düz --ast dumper (preorder; C ast_duz_yaz ile birebir) ----
// ============================================================================
// AŞAMA 3 (D-072) — CG1 codegen: AST-yürüten LLVM IR text emitter.
//   Oracle: SEMANTİK (exit-kod) eşdeğerlik (byte-identik IR DEĞİL — bkz. D-072).
//   CG1 kapsamı: işlev (parametresiz) + ver + tam literal + ikili aritmetik
//   (+ - * / %). Hoist-free: tek blok (entry:), SSA sıralı %N (p.reg).
// ============================================================================
işlev yeni_reg(p: &değişken Ayr) -> tam32 {
    değişken r: tam32 = p.reg;
    p.reg = p.reg + 1;
    ver r;
}
işlev reg_str(r: tam32) -> metin { ver metin_birlestir("%", tam64_str(r olarak tam64)); }
işlev ll_ikili(op: metin) -> metin {
    eğer metin_esit(op, "+") { ver "add"; }
    eğer metin_esit(op, "-") { ver "sub"; }
    eğer metin_esit(op, "*") { ver "mul"; }
    eğer metin_esit(op, "/") { ver "sdiv"; }
    eğer metin_esit(op, "ve") { ver "and"; }    // mantıksal (kısa-devresiz, C v1 ile aynı)
    eğer metin_esit(op, "veya") { ver "or"; }
    // Bit/kaydırma (D3 parite — C llvm.c:2436-2442 ile birebir). Not: codegen.kem
    // imzasızlık (dtam) izlemiyor — sdiv/srem'de olduğu gibi DAİMA imzalı varyant;
    // `>>` → ashr (C imzalıda ashr, yalnız dtam'da lshr — kapsam dışı, izlenmiyor).
    eğer metin_esit(op, "&") { ver "and"; }
    eğer metin_esit(op, "|") { ver "or"; }
    eğer metin_esit(op, "^") { ver "xor"; }
    eğer metin_esit(op, "<<") { ver "shl"; }
    eğer metin_esit(op, ">>") { ver "ashr"; }
    ver "srem";   // %
}
işlev karsilastirma_mi(op: metin) -> mantıksal {
    ver metin_esit(op, "==") veya metin_esit(op, "!=") veya metin_esit(op, "<")
        veya metin_esit(op, ">") veya metin_esit(op, "<=") veya metin_esit(op, ">=");
}
işlev icmp_pred(op: metin) -> metin {
    eğer metin_esit(op, "==") { ver "eq"; }
    eğer metin_esit(op, "!=") { ver "ne"; }
    eğer metin_esit(op, "<") { ver "slt"; }
    eğer metin_esit(op, ">") { ver "sgt"; }
    eğer metin_esit(op, "<=") { ver "sle"; }
    ver "sge";   // >=
}
// D3 Öncelik-1: float/double — operand LLVM tipi float/double mu?
işlev kesirli_ll_mi(t: metin) -> mantıksal {
    ver metin_esit(t, "float") veya metin_esit(t, "double");
}
// Float aritmetik mnemonik (C llvm.c:2426-2432 ile birebir).
işlev ll_ikili_f(op: metin) -> metin {
    eğer metin_esit(op, "+") { ver "fadd"; }
    eğer metin_esit(op, "-") { ver "fsub"; }
    eğer metin_esit(op, "*") { ver "fmul"; }
    eğer metin_esit(op, "/") { ver "fdiv"; }
    ver "frem";   // %
}
// Float karşılaştırma — ordered yüklemler (C llvm.c oeq/one/olt/ogt/ole/oge).
işlev fcmp_pred(op: metin) -> metin {
    eğer metin_esit(op, "==") { ver "oeq"; }
    eğer metin_esit(op, "!=") { ver "one"; }
    eğer metin_esit(op, "<") { ver "olt"; }
    eğer metin_esit(op, ">") { ver "ogt"; }
    eğer metin_esit(op, "<=") { ver "ole"; }
    ver "oge";   // >=
}
// LLVM float-sabiti nokta gerektirir (`2` geçersiz; `2.0` geçerli). ondalik_bicimle
// trailing `.0`'ı düşürebiliyor → KESIRLI emit'inde noktayı garanti et.
işlev kesirli_lit(s: metin) -> metin {
    değişken i: tam32 = 0;
    değişken n: tam32 = metin_uzunluk(s);
    iken i < n {
        eğer bayt(s, i) == 46 { ver s; }   // '.' var → olduğu gibi geçerli
        i = i + 1;
    }
    ver metin_birlestir(s, ".0");
}
// D3: "{i8, i32, ptr}" → n. alanın LLVM tipi (0="i8" tag, 1/2=payload). virgül-böl.
işlev agg_alan(s: metin, n: tam32) -> metin {
    değişken uz: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 1;            // '{' atla
    değişken alan: tam32 = 0;
    değişken bas: tam32 = 1;
    değişken derinlik: tam32 = 0;     // B1: iç-içe agregat brace/bracket/angle derinliği
    değişken sonuc: metin = "i32";
    değişken bitti: mantıksal = yanlış;
    // B1 (C llvm.c agg_alan_ir AYNASI): ',' / '}' yalnız derinlik==0'da alan sınırı.
    // İç-içe agregat alanı ({i8,{i8,i32}} gibi) → iç virgül ATLANIR (eski naif kod
    // iç virgülde bölüp "{i8" gibi BUDANMIŞ tip döndürürdü → tagged-union/payload
    // çeşit miscompile). Açıcı {[< derinlik++, kapayıcı }]> derinlik--.
    iken i < uz ve bitti == yanlış {
        değişken c: tam32 = bayt(s, i);
        eğer c == 123 veya c == 91 veya c == 60 {        // '{' '[' '<'
            derinlik = derinlik + 1; i = i + 1;
        } değilse {
            eğer (c == 125 veya c == 93 veya c == 62) ve derinlik > 0 {   // iç kapanış }])>
                derinlik = derinlik - 1; i = i + 1;
            } değilse {
                eğer derinlik == 0 ve (c == 44 veya c == 125) {   // depth-0 alan sınırı
                    eğer alan == n {
                        değişken son: tam32 = i;
                        iken son > bas ve bayt(s, son - 1) == 32 { son = son - 1; }
                        sonuc = metin_kes(s, bas, son - bas); bitti = doğru;
                    }
                    eğer c == 125 { bitti = doğru; }   // agregat sonu
                    değilse {
                        alan = alan + 1;
                        i = i + 1;
                        iken i < uz ve bayt(s, i) == 32 { i = i + 1; }   // ', ' sonrası boşluk atla
                        bas = i;
                    }
                } değilse { i = i + 1; }
            }
        }
    }
    ver sonuc;
}
// D3: tagged-union yapıcı adı mı? (değer/tamam/hata)
işlev tagunion_yapici_mi(ad: metin) -> mantıksal {
    ver metin_esit(ad, "değer") veya metin_esit(ad, "tamam") veya metin_esit(ad, "hata");
}
// i1 sonucu → i32 (0/1) genişlet; üretilen reg'i döndür.
işlev zext_i1(p: &değişken Ayr, c: metin) -> metin {
    değişken r: tam32 = yeni_reg(p);
    değişken rs: metin = reg_str(r);
    yaz_str("  "); yaz_str(rs); yaz_str(" = zext i1 "); yaz_str(c); yaz_str(" to i32"); yb(10);
    ver rs;
}
// CG3: işlev-içi değişken adı → alloca operandı (append-on-create; sondan ara = shadow).
işlev cg_var_ekle(p: &değişken Ayr, ad: metin, areg: metin, tip: metin, ref: metin, elem: metin) -> tam32 {
    dizi_ekle(p.cg_ad, ad);
    dizi_ekle(p.cg_areg, areg);
    dizi_ekle(p.cg_atip, tip);   // CG6: LLVM tipi
    dizi_ekle(p.cg_aref, ref);   // CG7c: ptr → işaret edilen yapı
    dizi_ekle(p.cg_aelem, elem); // CG8: Dizi → eleman tipi
    dizi_ekle(p.cg_apointee, ""); // D-267: varsayılan "" (skaler pointer decl'i dizi_yaz ile set eder)
    dizi_ekle(p.cg_aic, "");      // D-299: varsayılan "" (görev/kanal decl'i dizi_yaz ile set eder)
    ver 0;
}
// D-299: görev<T>/kanal<T> değişkeninin T LLVM tipi ("" bulunamazsa).
// cg_var_elem_bul aynası — arama yönü ve cg_base sınırı birebir aynı olmalı
// (blok-kapsam gölgelemesi için: sondan başa, cg_base'e kadar).
işlev cg_var_ic_bul(p: &değişken Ayr, ad: metin) -> metin {
    değişken i: tam32 = dizi_boyut(p.cg_ad) - 1;
    iken i >= p.cg_base {
        eğer metin_esit(dizi_al(p.cg_ad, i), ad) { ver dizi_al(p.cg_aic, i); }
        i = i - 1;
    }
    ver "";
}
// CG-SCOPE: leksik kapsam kapanışı. Blok/döngü/eşleş-kolu girişinde alınan
// `kapsam_bas = dizi_boyut(p.cg_ad)` ile çağrılır; [kapsam_bas, son) aralığındaki
// iç-kapsam bağlamalarının ADINI "" yapar → cg_var_bul (sondan→cg_base arar) boş
// adı atlar, shadow'lanan dış bağlamaya geri döner. C llvm.c scope_gir/scope_cik
// ile aynı disiplin; dizi-shrink built-in'i olmadığından truncate yerine ad-blank
// (slot kalır ama isim-eşleşmesi ölür; emit edilmiş IR değişmez). Eski hata:
// append-only tablo iç `değişken v`'yi dış `v`'den sonra bulur → yanlış slot.
işlev cg_kapsam_kapat(p: &değişken Ayr, kapsam_bas: tam32) -> tam32 {
    değişken i: tam32 = kapsam_bas;
    değişken n: tam32 = dizi_boyut(p.cg_ad);
    iken i < n {
        dizi_yaz(p.cg_ad, i, "");   // ad-blank → lookup'ta görünmez (slot canlı kalır)
        i = i + 1;
    }
    ver 0;
}
// CG7c: değişkenin işaret ettiği yapı adı (ptr ise; değilse "").
işlev cg_var_ref_bul(p: &değişken Ayr, ad: metin) -> metin {
    değişken i: tam32 = dizi_boyut(p.cg_ad) - 1;
    iken i >= p.cg_base {
        eğer metin_esit(dizi_al(p.cg_ad, i), ad) { ver dizi_al(p.cg_aref, i); }
        i = i - 1;
    }
    ver "";
}
// D-267: *tamN pointer değişkeninin skaler pointee LLVM tipi ("i8"/.../"i64"); değilse "".
işlev cg_var_pointee_bul(p: &değişken Ayr, ad: metin) -> metin {
    değişken i: tam32 = dizi_boyut(p.cg_ad) - 1;
    iken i >= p.cg_base {
        eğer metin_esit(dizi_al(p.cg_ad, i), ad) { ver dizi_al(p.cg_apointee, i); }
        i = i - 1;
    }
    ver "";
}
// CG8: Dizi değişkeninin eleman tipi ("" değilse).
işlev cg_var_elem_bul(p: &değişken Ayr, ad: metin) -> metin {
    değişken i: tam32 = dizi_boyut(p.cg_ad) - 1;
    iken i >= p.cg_base {
        eğer metin_esit(dizi_al(p.cg_ad, i), ad) { ver dizi_al(p.cg_aelem, i); }
        i = i - 1;
    }
    ver "";
}
işlev cg_var_bul(p: &değişken Ayr, ad: metin) -> metin {
    değişken i: tam32 = dizi_boyut(p.cg_ad) - 1;
    iken i >= p.cg_base {
        eğer metin_esit(dizi_al(p.cg_ad, i), ad) { ver dizi_al(p.cg_areg, i); }
        i = i - 1;
    }
    ver "";   // bulunamadı (geçerli programda olmaz; checker garantiler)
}
// CG6: değişkenin LLVM tipi (sondan ara).
işlev cg_var_tip_bul(p: &değişken Ayr, ad: metin) -> metin {
    değişken i: tam32 = dizi_boyut(p.cg_ad) - 1;
    iken i >= p.cg_base {
        eğer metin_esit(dizi_al(p.cg_ad, i), ad) { ver dizi_al(p.cg_atip, i); }
        i = i - 1;
    }
    ver "i32";
}
// CG6: KEMGU tip-düğümü → LLVM tip metni. mantıksal=i32 (CG2/CG4 bool mantığıyla tutarlı).
işlev ll_tip(p: &değişken Ayr, tip_idx: tam32) -> metin {
    eğer tip_idx < 0 { ver "i32"; }
    değişken ta: metin = dizi_al(p.a_ad, tip_idx);
    // Referans/pointer/dizi → ptr (CG7b: &Yapi=ptr, Dizi<T>=heap ptr)
    eğer metin_esit(ta, "TIP_REFERANS") veya metin_esit(ta, "TIP_POINTER")
         veya metin_esit(ta, "TIP_DIZI") { ver "ptr"; }
    // D-299 (Katman 2 parite): görev<T> / kanal<T> runtime'da OPAK handle (ptr).
    // T yalnız tip-kontrolde yaşar. Bu dal olmadan ikisi de aşağıdaki "i32"
    // fallback'ine düşüyordu → 64-bit handle 32 bite kırpılırdı (C llvm.c aynası).
    eğer metin_esit(ta, "TIP_GOREV") veya metin_esit(ta, "TIP_KANAL") { ver "ptr"; }
    eğer metin_esit(ta, "TIP_SECIMLIK") {   // D3: seçimlik<T> → {i8 tag, T}
        değişken tt: metin = ll_tip(p, dizi_al(p.cocuk, dizi_al(p.a_cb, tip_idx)));
        ver metin_birlestir(metin_birlestir("{i8, ", tt), "}");
    }
    eğer metin_esit(ta, "TIP_SONUC") {   // D3: sonuç<T,H> → {i8 tag, T, H}
        değişken sc: tam32 = dizi_al(p.a_cb, tip_idx);
        değişken tt: metin = ll_tip(p, dizi_al(p.cocuk, sc));
        değişken hh: metin = ll_tip(p, dizi_al(p.cocuk, sc + 1));
        değişken r1: metin = metin_birlestir("{i8, ", tt);
        değişken r2: metin = metin_birlestir(r1, ", ");
        değişken r3: metin = metin_birlestir(r2, hh);
        ver metin_birlestir(r3, "}");
    }
    // D-303: gönderen<T>/alan<T> — kanal yön uçları. TIP_KULLANICI generic
    // (kids[0]=ad-node). Runtime'da OPAK ptr (kanal<T> ile aynı). Bu dal olmadan
    // aşağıdaki i32-fallback'ine düşüp handle'ı 32 bite kırpardı (C llvm.c aynası).
    eğer metin_esit(ta, "TIP_KULLANICI") {
        değişken kad: metin = dizi_al(p.a_deg,
            dizi_al(p.cocuk, dizi_al(p.a_cb, tip_idx)));
        eğer metin_esit(kad, "gönderen") veya metin_esit(kad, "alan") { ver "ptr"; }
        // D-306: generic yapı/çeşit annotasyonu (Kutu<T>) → base yapı/çeşit IR.
        // Self-host "T→i32 tek-layout" modeli: %Kutu BİR KEZ emit edilir (alan
        // tipleri T→i32 fallback ile). Bu dal olmadan annotasyon i32'ye düşüp
        // construction'ın ürettiği %Kutu ile ÇAKIŞIYORDU (k'nın alloca'sı i32,
        // RHS %Kutu → store uyumsuz + alan erişimi ver "0"). Annotasyon da %Kutu'ya
        // çözülmeli → construction + extractvalue tutarlı. C llvm.c paritesi.
        eğer yapi_var_mi(p, kad) { ver metin_birlestir("%", kad); }
        eğer cesit_var_mi(p, kad) {
            eğer cesit_enum_mi(p, kad) { ver "i8"; }
            ver cesit_struct_ir(p, kad);
        }
    }
    eğer metin_esit(ta, "TIP_BASIT") == yanlış { ver "i32"; }  // TIP_KULLANICI (qualified) → CG sonrası
    değişken t: metin = dizi_al(p.a_deg, tip_idx);
    eğer metin_esit(t, "tam8") veya metin_esit(t, "dtam8") { ver "i8"; }
    eğer metin_esit(t, "tam16") veya metin_esit(t, "dtam16") { ver "i16"; }
    eğer metin_esit(t, "tam64") veya metin_esit(t, "dtam64") { ver "i64"; }
    eğer metin_esit(t, "kesirli32") { ver "float"; }    // D3 Öncelik-1: float
    eğer metin_esit(t, "kesirli64") { ver "double"; }   // D3 Öncelik-1: double
    eğer metin_esit(t, "metin") { ver "ptr"; }   // CG7: metin → ptr
    eğer yapi_var_mi(p, t) { ver metin_birlestir("%", t); }   // CG7b: yapı → %Ad
    eğer cesit_var_mi(p, t) {                 // D3: çeşit (ADT)
        eğer cesit_enum_mi(p, t) { ver "i8"; }     // payloadsuz → bare disc
        ver cesit_struct_ir(p, t);                 // payload → {i8, <payloadlar>}
    }
    ver "i32";   // tam32/dtam32/mantıksal/karakter/boş → i32
}
// CG6: iki operand tipini birleştir (KEMGU örtük-dönüşüm yok → biri i32-literal-default ise diğeri).
işlev tip_birlestir(a: metin, b: metin) -> metin {
    eğer metin_esit(a, b) { ver a; }
    eğer metin_esit(a, "i32") { ver b; }
    ver a;
}
// CG8: Dizi<T> tip düğümü → eleman LLVM tipi ("" Dizi değilse).
işlev ll_eleman_tip(p: &değişken Ayr, tip_idx: tam32) -> metin {
    eğer tip_idx < 0 { ver ""; }
    eğer metin_esit(dizi_al(p.a_ad, tip_idx), "TIP_DIZI") {
        ver ll_tip(p, dizi_al(p.cocuk, dizi_al(p.a_cb, tip_idx)));
    }
    ver "";
}
// D-299: görev<T> / kanal<T> tip düğümü → T'nin LLVM tipi ("" ikisi de değilse).
// görev<T>/kanal<T> IR'de opak `ptr` olduğu için T SİLİNİR; runtime i64 taşır ve
// sonuç T'ye daraltılır (trunc / inttoptr). T'nin tek güvenilir kaynağı BİLDİRİLEN
// tiptir — C llvm.c'deki gorev_ic_ir_al / kanal_ic_ir_al aynası.
işlev ll_ic_tip(p: &değişken Ayr, tip_idx: tam32) -> metin {
    eğer tip_idx < 0 { ver ""; }
    değişken ta: metin = dizi_al(p.a_ad, tip_idx);
    eğer metin_esit(ta, "TIP_GOREV") veya metin_esit(ta, "TIP_KANAL") {
        ver ll_tip(p, dizi_al(p.cocuk, dizi_al(p.a_cb, tip_idx)));
    }
    ver "";
}
// CG8: eleman LLVM tipi → kdl_dizi_olustur eleman_byte ("8"=ptr/i64, "4"=diğer).
işlev dizi_eleman_byte(elem: metin) -> metin {
    eğer metin_esit(elem, "ptr") veya metin_esit(elem, "i64") { ver "8"; }
    ver "4";
}
// CG8: değer tipi → kdl_dizi_ekle_* sonek (tam/tam64/ptr).
işlev dizi_ekle_sonek(et: metin) -> metin {
    eğer metin_esit(et, "i64") { ver "tam64"; }
    eğer metin_esit(et, "ptr") { ver "ptr"; }
    ver "tam";
}
// CG8: değer tipi → çağrı argüman LLVM tipi (i64/ptr/i32).
işlev dizi_arg_tip(et: metin) -> metin {
    eğer metin_esit(et, "i64") { ver "i64"; }
    eğer metin_esit(et, "ptr") { ver "ptr"; }
    ver "i32";
}
// CG8: eleman tipi → kdl_dizi_al_* sonek + dönüş tipi.
işlev dizi_al_sonek(elem: metin) -> metin {
    eğer metin_esit(elem, "ptr") { ver "ptr"; }
    eğer metin_esit(elem, "i64") { ver "tam64"; }
    ver "tam";
}
işlev dizi_al_rettip(elem: metin) -> metin {
    eğer metin_esit(elem, "ptr") { ver "ptr"; }
    eğer metin_esit(elem, "i64") { ver "i64"; }
    ver "i32";
}
// CG6: LLVM int tip bit-genişliği (sext/trunc seçimi için).
işlev tip_genislik(t: metin) -> tam32 {
    eğer metin_esit(t, "i8") { ver 8; }
    eğer metin_esit(t, "i16") { ver 16; }
    eğer metin_esit(t, "i64") { ver 64; }
    ver 32;   // i32 (varsayılan)
}
// LLVM tamsayı tipi mi? (i1/i8/i16/i32/i64). ptr/void/float/struct → yanlış.
işlev int_ll_mi(t: metin) -> mantıksal {
    ver metin_esit(t, "i1") veya metin_esit(t, "i8") veya metin_esit(t, "i16")
        veya metin_esit(t, "i32") veya metin_esit(t, "i64");
}
// Karar 1 (D-30x): `ver <ifade>` değerini fn dönüşüne (cur_ret) uydur — YALNIZ
// iki taraf da tamsayı ve genişlik farklıysa (trunc/sext). görev_birleştir gibi
// i64-taşıyıcı dönen ifadeler eşleş-bound iç-tip kaybında i64 kalır; `ver`
// bağlamında fn dönüşü i32 ise burada daraltılır. C paritesi: C, daraltmayı
// birleştir'de beklenen ile yapar; self-host ret'te yapar → exit-kod eşdeğer
// (trunc(a+b) == trunc(a)+trunc(b)). cur_ret struct/ptr/float ise NO-OP.
işlev ret_uydur(p: &değişken Ayr, op: metin) -> metin {
    eğer metin_esit(p.son_tip, p.cur_ret) { ver op; }
    eğer int_ll_mi(p.son_tip) == yanlış veya int_ll_mi(p.cur_ret) == yanlış { ver op; }
    değişken islem: metin = "sext";
    eğer tip_genislik(p.cur_ret) < tip_genislik(p.son_tip) { islem = "trunc"; }
    değişken r: tam32 = yeni_reg(p);
    değişken rs: metin = reg_str(r);
    yaz_str("  "); yaz_str(rs); yaz_str(" = "); yaz_str(islem); yaz_str(" ");
    yaz_str(p.son_tip); yaz_str(" "); yaz_str(op); yaz_str(" to "); yaz_str(p.cur_ret); yb(10);
    p.son_tip = p.cur_ret;
    ver rs;
}
// ============================================================================
// CG7 — metin literali + runtime builtin + declare header (D-072).
// ============================================================================
işlev hex1(d: tam32) -> metin {
    eğer d < 10 { ver hane_str(d); }
    eğer d == 10 { ver "A"; }   eğer d == 11 { ver "B"; }
    eğer d == 12 { ver "C"; }   eğer d == 13 { ver "D"; }
    eğer d == 14 { ver "E"; }   ver "F";
}
işlev hex2(b: tam32) -> metin { ver metin_birlestir(hex1(b / 16), hex1(b % 16)); }
// Metin literali → @.str.N id (find-or-add; dedup).
işlev str_id(p: &değişken Ayr, val: metin) -> tam32 {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.str_deg) {
        eğer metin_esit(dizi_al(p.str_deg, i), val) { ver i; }
        i = i + 1;
    }
    dizi_ekle(p.str_deg, val);
    ver dizi_boyut(p.str_deg) - 1;
}
// Global içeriği yaz: \ " <0x20 >=0x7F → \HH (büyük hex); diğer ham.
işlev str_kacis_yaz(p: &değişken Ayr, s: metin) -> tam32 {
    değişken n: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 0;
    iken i < n {
        değişken c: tam32 = bayt(s, i);   // 0-255
        eğer (c == 92) veya (c == 34) veya (c < 32) veya (c >= 127) {
            yb(92); yaz_str(hex2(c));   // \HH
        } değilse { yb(c); }
        i = i + 1;
    }
    ver 0;
}
// Tüm @.str.N global sabitlerini yaz.
işlev str_globalleri_emit(p: &değişken Ayr) -> tam32 {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.str_deg) {
        değişken s: metin = dizi_al(p.str_deg, i);
        değişken k: tam32 = metin_uzunluk(s) + 1;   // null sonlandırıcı dahil
        yaz_str("@.str."); yaz_str(tam64_str(i olarak tam64));
        yaz_str(" = private unnamed_addr constant ["); yaz_str(tam64_str(k olarak tam64));
        yaz_str(" x i8] c"); yb(34);
        str_kacis_yaz(p, s);
        yb(92); yaz_str("00"); yb(34); yb(10);   // \00 + kapanış tırnak
        i = i + 1;
    }
    ver 0;
}
// Ön-pass: düz düğüm tablosunu tara, tüm METIN literallerini topla.
işlev str_pre_pass(p: &değişken Ayr) -> tam32 {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.a_ad) {
        eğer metin_esit(dizi_al(p.a_ad, i), "METIN") { str_id(p, dizi_al(p.a_deg, i)); }
        i = i + 1;
    }
    ver 0;
}
// KEMGU built-in adı → @kdl_* adı ("" = built-in değil, kullanıcı işlevi). dizi_* özel (CG8).
// Önek-tabanlı (C codegen ile aynı): metin_/dosya_/yaz_/yazdir_/arg_ + birkaç tekil.
işlev builtin_kdl_ad(ad: metin) -> metin {
    eğer metin_baslar(ad, "metin_") veya metin_baslar(ad, "dosya_") veya metin_baslar(ad, "yaz_")
         veya metin_baslar(ad, "yazdir_") veya metin_baslar(ad, "arg_")
         veya metin_esit(ad, "oku_karakter") veya metin_esit(ad, "ondalik_bicimle") {
        ver metin_birlestir("kdl_", ad);
    }
    ver "";
}
// Built-in dönüş LLVM tipi (sonek-bazlı).
işlev builtin_ret(ad: metin) -> metin {
    eğer metin_esit(ad, "metin_uzunluk") { ver "i32"; }
    eğer metin_esit(ad, "metin_bayt") { ver "i8"; }
    eğer metin_esit(ad, "metin_esit") veya metin_esit(ad, "metin_icerir") veya metin_esit(ad, "metin_baslar")
         veya metin_esit(ad, "metin_biter") veya metin_esit(ad, "dosya_var_mi") { ver "i1"; }
    eğer metin_esit(ad, "dosya_yaz") veya metin_esit(ad, "dosya_sil") veya metin_esit(ad, "dosya_yeniden_adlandir")
         veya metin_esit(ad, "arg_sayi") veya metin_esit(ad, "oku_karakter") { ver "i32"; }
    eğer metin_esit(ad, "dosya_boyut") { ver "i64"; }
    eğer metin_baslar(ad, "metin_") veya metin_esit(ad, "dosya_oku") veya metin_esit(ad, "dosya_ac")
         veya metin_esit(ad, "arg_al") veya metin_esit(ad, "ondalik_bicimle") { ver "ptr"; }
    ver "void";   // yaz_*/yazdir_*/dosya_kapat → void
}
// Runtime declare başlığı (codegen.kem'in kullandığı alt küme + libc).
işlev runtime_header_yaz(p: &değişken Ayr) -> tam32 {
    yaz_str("declare i32 @puts(ptr)"); yb(10);
    yaz_str("declare ptr @malloc(i64)"); yb(10);
    yaz_str("declare void @free(ptr)"); yb(10);
    yaz_str("declare ptr @kdl_global_bolge_al()"); yb(10);   // V2-F4.2a: main/ρ-seed
    yaz_str("declare ptr @kdl_bolge_olustur()"); yb(10);       // V2-F4.2b: ρ_yerel aç
    yaz_str("declare void @kdl_bolge_serbest(ptr)"); yb(10);   // V2-F4.2b: ρ_yerel serbest
    // D-299 (Katman 2 parite): görev/kanal runtime hedefleri. İmzalar C llvm.c ile
    // BİREBİR aynı; kanal declare'i host (kdl_runtime.c) ve bare-metal (kdl_kanal.c)
    // sürümlerinin ikisine de uyar.
    yaz_str("declare i64 @kdl_gorev_birlestir(ptr)"); yb(10);
    yaz_str("declare ptr @kdl_gorev_basla_kapanis(ptr, ptr, ptr)"); yb(10);   // D-300
    // Karar 1 (D-30x): görev_başlat başarısızlığında sonuç'un hata(metin)
    // payload'u. Metin ön-geçişinden bağımsız sabit — 19 bayt + \00 = 20.
    // KEMGU string literal'i \" / \\ işlemez → tırnak yb(34), ters-eğik yb(92)
    // (str_globalleri_emit ile aynı desen). "gorev baslatilamadi" = 19 + \00 = 20.
    yaz_str("@.gorev_hata_str = private constant [20 x i8] c"); yb(34);
    yaz_str("gorev baslatilamadi"); yb(92); yaz_str("00"); yb(34); yb(10);
    yaz_str("declare ptr @kdl_kanal_olustur(i32)"); yb(10);
    yaz_str("declare void @kdl_kanal_gonder(ptr, i64)"); yb(10);
    yaz_str("declare i64 @kdl_kanal_al(ptr)"); yb(10);
    yaz_str("declare ptr @memcpy(ptr, ptr, i64)"); yb(10);
    yaz_str("declare i32 @kdl_metin_uzunluk(ptr)"); yb(10);
    yaz_str("declare i8 @kdl_metin_bayt(ptr, i32)"); yb(10);
    yaz_str("declare i1 @kdl_metin_esit(ptr, ptr)"); yb(10);
    yaz_str("declare ptr @kdl_metin_birlestir(ptr, ptr)"); yb(10);
    yaz_str("declare ptr @kdl_metin_kes(ptr, i32, i32)"); yb(10);
    yaz_str("declare i1 @kdl_metin_icerir(ptr, ptr)"); yb(10);
    yaz_str("declare i1 @kdl_metin_baslar(ptr, ptr)"); yb(10);
    yaz_str("declare i1 @kdl_metin_biter(ptr, ptr)"); yb(10);
    yaz_str("declare ptr @kdl_metin_kucuk(ptr)"); yb(10);
    yaz_str("declare ptr @kdl_metin_buyuk(ptr)"); yb(10);
    yaz_str("declare ptr @kdl_metin_kirp(ptr)"); yb(10);
    yaz_str("declare ptr @kdl_metin_yer_degistir(ptr, ptr, ptr)"); yb(10);
    yaz_str("declare ptr @kdl_metin_kucuk_tr(ptr)"); yb(10);
    yaz_str("declare ptr @kdl_metin_buyuk_tr(ptr)"); yb(10);
    yaz_str("declare ptr @kdl_metin_kucuk_ascii(ptr)"); yb(10);
    yaz_str("declare ptr @kdl_metin_buyuk_ascii(ptr)"); yb(10);
    yaz_str("declare void @kdl_dizi_yaz_tam(ptr, i32, i32)"); yb(10);
    yaz_str("declare void @kdl_dizi_yaz_tam64(ptr, i32, i64)"); yb(10);
    yaz_str("declare void @kdl_dizi_yaz_ptr(ptr, i32, ptr)"); yb(10);
    yaz_str("declare i32 @kdl_dizi_kapasite(ptr)"); yb(10);
    yaz_str("declare ptr @kdl_dosya_ac(ptr, ptr)"); yb(10);
    yaz_str("declare i32 @kdl_dosya_yaz(ptr, ptr)"); yb(10);
    yaz_str("declare void @kdl_dosya_kapat(ptr)"); yb(10);
    yaz_str("declare i1 @kdl_dosya_var_mi(ptr)"); yb(10);
    yaz_str("declare i32 @kdl_dosya_sil(ptr)"); yb(10);
    yaz_str("declare i32 @kdl_dosya_yeniden_adlandir(ptr, ptr)"); yb(10);
    yaz_str("declare i64 @kdl_dosya_boyut(ptr)"); yb(10);
    yaz_str("declare void @kdl_yazdir_tam(i32)"); yb(10);
    yaz_str("declare void @kdl_yazdir_tam64(i64)"); yb(10);
    yaz_str("declare ptr @kdl_ondalik_bicimle(ptr)"); yb(10);
    yaz_str("declare void @kdl_yazdir_isaretsiz_tam(i32)"); yb(10);
    yaz_str("declare void @kdl_yazdir_isaretsiz_tam64(i64)"); yb(10);
    yaz_str("declare void @kdl_yazdir_onaltilik(i64)"); yb(10);
    yaz_str("declare void @kdl_yaz_onaltilik(i64)"); yb(10);
    yaz_str("declare void @kdl_yazdir_karakter(i32)"); yb(10);
    yaz_str("declare void @kdl_yaz_karakter(i32)"); yb(10);
    yaz_str("declare ptr @kdl_dizi_olustur(ptr, i32)"); yb(10);   // V2-F4.2a: ρ
    yaz_str("declare void @kdl_dizi_ekle_tam(ptr, ptr, i32)"); yb(10);
    yaz_str("declare void @kdl_dizi_ekle_tam64(ptr, ptr, i64)"); yb(10);
    yaz_str("declare void @kdl_dizi_ekle_ptr(ptr, ptr, ptr)"); yb(10);
    yaz_str("declare i32 @kdl_dizi_al_tam(ptr, i32)"); yb(10);
    yaz_str("declare i64 @kdl_dizi_al_tam64(ptr, i32)"); yb(10);
    yaz_str("declare ptr @kdl_dizi_al_ptr(ptr, i32)"); yb(10);
    yaz_str("declare i32 @kdl_dizi_boyut(ptr)"); yb(10);
    yaz_str("declare void @kdl_dizi_kapasite_ayarla(ptr, ptr, i32)"); yb(10);   // V2-F4.2a: ρ
    yaz_str("declare ptr @kdl_dosya_oku(ptr)"); yb(10);
    yaz_str("declare i32 @kdl_arg_sayi()"); yb(10);
    yaz_str("declare ptr @kdl_arg_al(i32)"); yb(10);
    yaz_str("declare void @kdl_yaz_tam(i32)"); yb(10);
    yaz_str("declare void @kdl_yaz_tam64(i64)"); yb(10);
    yaz_str("declare void @kdl_yaz_bayt(i32)"); yb(10);
    yaz_str("declare void @kdl_yazdir_metin(ptr)"); yb(10);
    yaz_str("declare void @kdl_yazdir_satir()"); yb(10);
    yaz_str("declare i32 @kdl_oku_karakter()"); yb(10);
    yaz_str("declare void @kdl_panik(ptr)"); yb(10);
    ver 0;
}
// ============================================================================
// CG7b — yapı (struct): tablo + tip-def + oluştur/erişim.
// ============================================================================
işlev yapi_idx(p: &değişken Ayr, ad: metin) -> tam32 {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.yapi_ad) {
        eğer metin_esit(dizi_al(p.yapi_ad, i), ad) { ver i; }
        i = i + 1;
    }
    ver -1;
}
işlev yapi_var_mi(p: &değişken Ayr, ad: metin) -> mantıksal { ver yapi_idx(p, ad) >= 0; }
// Alan adı → yapı içi 0-tabanlı indeks (-1 yok).
işlev yapi_alan_idx(p: &değişken Ayr, yad: metin, alan: metin) -> tam32 {
    değişken k: tam32 = yapi_idx(p, yad);
    eğer k < 0 { ver -1; }
    değişken base: tam32 = dizi_al(p.yapi_abase, k);
    değişken cnt: tam32 = dizi_al(p.yapi_acount, k);
    değişken j: tam32 = 0;
    iken j < cnt {
        eğer metin_esit(dizi_al(p.alan_ad, base + j), alan) { ver j; }
        j = j + 1;
    }
    ver -1;
}
// Alan adı → LLVM tipi.
işlev yapi_alan_tip(p: &değişken Ayr, yad: metin, alan: metin) -> metin {
    değişken k: tam32 = yapi_idx(p, yad);
    eğer k < 0 { ver "i32"; }
    değişken base: tam32 = dizi_al(p.yapi_abase, k);
    değişken cnt: tam32 = dizi_al(p.yapi_acount, k);
    değişken j: tam32 = 0;
    iken j < cnt {
        eğer metin_esit(dizi_al(p.alan_ad, base + j), alan) { ver dizi_al(p.alan_tip, base + j); }
        j = j + 1;
    }
    ver "i32";
}
// CG8: Dizi alanının eleman tipi ("" Dizi değilse).
işlev yapi_alan_elem(p: &değişken Ayr, yad: metin, alan: metin) -> metin {
    değişken k: tam32 = yapi_idx(p, yad);
    eğer k < 0 { ver ""; }
    değişken base: tam32 = dizi_al(p.yapi_abase, k);
    değişken cnt: tam32 = dizi_al(p.yapi_acount, k);
    değişken j: tam32 = 0;
    iken j < cnt {
        eğer metin_esit(dizi_al(p.alan_ad, base + j), alan) { ver dizi_al(p.alan_elem, base + j); }
        j = j + 1;
    }
    ver "";
}
// Ön-pass: üst-düzey YAPI tanımları → tablo (önce adlar, sonra alanlar — iç içe yapı ref'i için).
işlev yapi_topla(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    // Pass A: adlar
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dis_ac(p, dizi_al(p.cocuk, cb + i));   // D3: dışa-aç
        eğer metin_esit(dizi_al(p.a_ad, c), "YAPI") { dizi_ekle(p.yapi_ad, dizi_al(p.a_deg, c)); }
        i = i + 1;
    }
    // Pass B: alanlar (abase/acount + alan_ad/alan_tip)
    i = 0;
    iken i < cs {
        değişken c2: tam32 = dis_ac(p, dizi_al(p.cocuk, cb + i));   // D3: dışa-aç
        eğer metin_esit(dizi_al(p.a_ad, c2), "YAPI") {
            dizi_ekle(p.yapi_abase, dizi_boyut(p.alan_ad));
            değişken ccb: tam32 = dizi_al(p.a_cb, c2);
            değişken ccs: tam32 = dizi_al(p.a_cs, c2);
            değişken say: tam32 = 0;
            değişken j: tam32 = 0;
            iken j < ccs {
                değişken ac: tam32 = dizi_al(p.cocuk, ccb + j);
                eğer metin_esit(dizi_al(p.a_ad, ac), "ALAN") {
                    değişken atn: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, ac));   // alan tip düğümü
                    dizi_ekle(p.alan_ad, dizi_al(p.a_deg, ac));
                    dizi_ekle(p.alan_tip, ll_tip(p, atn));
                    dizi_ekle(p.alan_elem, ll_eleman_tip(p, atn));   // CG8: Dizi alanı eleman tipi
                    say = say + 1;
                }
                j = j + 1;
            }
            dizi_ekle(p.yapi_acount, say);
        }
        i = i + 1;
    }
    // Pass C: nested modül üyelerini recursive topla (flat model) — D3
    i = 0;
    iken i < cs {
        değişken c3: tam32 = dis_ac(p, dizi_al(p.cocuk, cb + i));
        eğer metin_esit(dizi_al(p.a_ad, c3), "MODUL") { yapi_topla(p, c3); }
        i = i + 1;
    }
    ver 0;
}
// Yapı tip tanımlarını yaz: %Ad = type { t0, t1, ... }
işlev yapi_tip_emit(p: &değişken Ayr) -> tam32 {
    değişken k: tam32 = 0;
    iken k < dizi_boyut(p.yapi_ad) {
        yaz_str("%"); yaz_str(dizi_al(p.yapi_ad, k)); yaz_str(" = type { ");
        değişken base: tam32 = dizi_al(p.yapi_abase, k);
        değişken cnt: tam32 = dizi_al(p.yapi_acount, k);
        değişken j: tam32 = 0;
        iken j < cnt {
            eğer j > 0 { yaz_str(", "); }
            yaz_str(dizi_al(p.alan_tip, base + j));
            j = j + 1;
        }
        yaz_str(" }"); yb(10);
        k = k + 1;
    }
    ver 0;
}
// CG6: çağrılan işlevin dönüş LLVM tipi (ön-pass tablosu).
işlev fn_ret_bul(p: &değişken Ayr, ad: metin) -> metin {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.fn_ad) {
        eğer metin_esit(dizi_al(p.fn_ad, i), ad) { ver dizi_al(p.fn_ret, i); }
        i = i + 1;
    }
    ver "i32";
}
// CG7a: ad bir KULLANICI işlevi mi (imza tablosunda)? (built-in/user ayrımı için).
işlev fn_var_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.fn_ad) {
        eğer metin_esit(dizi_al(p.fn_ad, i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// CG6: ISLEV'in dönüş LLVM tipi (PARAMETRE/BLOK olmayan çocuk = dönüş tip düğümü; yoksa i32).
işlev islev_donus_tip(p: &değişken Ayr, idx: tam32) -> metin {
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken cs: tam32 = dizi_al(p.a_cs, idx);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        değişken ca: metin = dizi_al(p.a_ad, c);
        eğer metin_esit(ca, "PARAMETRE") == yanlış ve metin_esit(ca, "BLOK") == yanlış {
            ver ll_tip(p, c);
        }
        i = i + 1;
    }
    ver "i32";
}
// CG4: temel-blok etiket üret/yaz + koşullu fall-through dal.
işlev yeni_label(p: &değişken Ayr) -> metin {
    değişken l: tam32 = p.lbl;
    p.lbl = p.lbl + 1;
    ver metin_birlestir("bb", tam64_str(l olarak tam64));
}
işlev etiket_yaz(p: &değişken Ayr, L: metin) -> tam32 {
    yaz_str(L); yaz_str(":"); yb(10);
    p.bb_term = 0;   // yeni blok başladı
    ver 0;
}
// Mevcut blok terminatörlü değilse L'ye dallan (fall-through).
işlev br_to(p: &değişken Ayr, L: metin) -> tam32 {
    eğer p.bb_term == 0 {
        yaz_str("  br label %"); yaz_str(L); yb(10);
        p.bb_term = 1;
    }
    ver 0;
}
// i32 (0/1) koşulu → i1 (icmp ne 0); üretilen i1 reg'i döndür.
işlev kosul_i1(p: &değişken Ayr, c: metin) -> metin {
    değişken r: tam32 = yeni_reg(p);
    değişken rs: metin = reg_str(r);
    yaz_str("  "); yaz_str(rs); yaz_str(" = icmp ne i32 "); yaz_str(c); yaz_str(", 0"); yb(10);
    ver rs;
}

// İfade → operand metni ("5" veya "%3"); yan-IR yaz_str ile akıtılır.
işlev ifade_uret(p: &değişken Ayr, idx: tam32) -> metin {
    değişken ad: metin = dizi_al(p.a_ad, idx);
    eğer metin_esit(ad, "TAM") { p.son_tip = "i32"; ver dizi_al(p.a_deg, idx); }
    // D3 Öncelik-1: kesirli literal — immediate (TAM gibi), son_tip double (kesirli64
    // varsayılan). Değer parse'ta ondalik_bicimle ile noktalı (LLVM float-sabit) format.
    // kesirli32/float bağlamı bidirectional çıkarsama gerektirir (ayrı iş — şimdilik double).
    eğer metin_esit(ad, "KESIRLI") { p.son_tip = "double"; ver kesirli_lit(dizi_al(p.a_deg, idx)); }
    eğer metin_esit(ad, "MANTIKSAL") { p.son_tip = "i32"; ver dizi_al(p.a_deg, idx); }   // a_deg="1"/"0"
    eğer metin_esit(ad, "METIN") {
        değişken val: metin = dizi_al(p.a_deg, idx);
        değişken id: tam32 = str_id(p, val);
        değişken k: tam32 = metin_uzunluk(val) + 1;
        değişken r: tam32 = yeni_reg(p);
        değişken rs: metin = reg_str(r);
        yaz_str("  "); yaz_str(rs); yaz_str(" = getelementptr ["); yaz_str(tam64_str(k olarak tam64));
        yaz_str(" x i8], ptr @.str."); yaz_str(tam64_str(id olarak tam64));
        yaz_str(", i32 0, i32 0"); yb(10);
        p.son_tip = "ptr";
        ver rs;
    }
    eğer metin_esit(ad, "TANIMLAYICI") {
        // D3: `hiç` yapıcısı — seçimlik {i8 1} (payload yok). beklenen_ll bağlamı şart.
        eğer metin_esit(dizi_al(p.a_deg, idx), "hiç") {
            eğer metin_uzunluk(p.beklenen_ll) > 0 {
                eğer bayt(p.beklenen_ll, 0) == 123 {
                    değişken agg: metin = p.beklenen_ll;
                    değişken ar: metin = reg_str(yeni_reg(p));
                    yaz_str("  "); yaz_str(ar); yaz_str(" = alloca "); yaz_str(agg); yb(10);
                    değişken g0: metin = reg_str(yeni_reg(p));
                    yaz_str("  "); yaz_str(g0); yaz_str(" = getelementptr "); yaz_str(agg);
                    yaz_str(", ptr "); yaz_str(ar); yaz_str(", i32 0, i32 0"); yb(10);
                    yaz_str("  store i8 1, ptr "); yaz_str(g0); yb(10);
                    değişken lr: metin = reg_str(yeni_reg(p));
                    yaz_str("  "); yaz_str(lr); yaz_str(" = load "); yaz_str(agg);
                    yaz_str(", ptr "); yaz_str(ar); yb(10);
                    p.son_tip = agg; p.son_ref = ""; p.son_elem = "";
                    ver lr;
                }
            }
        }
        // D-253: küresel değişken → @ad'den load (local DEĞİL; sabit gibi inline değil).
        değişken kt: metin = kuresel_tip_bul(p, dizi_al(p.a_deg, idx));
        eğer metin_uzunluk(kt) > 0 {
            değişken kr: tam32 = yeni_reg(p);
            değişken krs: metin = reg_str(kr);
            yaz_str("  "); yaz_str(krs); yaz_str(" = load "); yaz_str(kt);
            yaz_str(", ptr @"); yaz_str(dizi_al(p.a_deg, idx)); yb(10);
            p.son_tip = kt;
            ver krs;
        }
        değişken areg: metin = cg_var_bul(p, dizi_al(p.a_deg, idx));
        değişken vt: metin = cg_var_tip_bul(p, dizi_al(p.a_deg, idx));
        değişken r: tam32 = yeni_reg(p);
        değişken rs: metin = reg_str(r);
        yaz_str("  "); yaz_str(rs); yaz_str(" = load "); yaz_str(vt); yaz_str(", ptr "); yaz_str(areg); yb(10);
        p.son_tip = vt;
        p.son_ref = cg_var_ref_bul(p, dizi_al(p.a_deg, idx));   // CG7c: ptr ise işaret edilen yapı
        p.son_elem = cg_var_elem_bul(p, dizi_al(p.a_deg, idx)); // CG8: Dizi ise eleman tipi
        ver rs;
    }
    eğer metin_esit(ad, "CAGRI") {
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken cs: tam32 = dizi_al(p.a_cs, idx);
        // D3 payload çeşit: Çeşit::Varyant(args) → {i8 disc, payload@ofset} (hedef=YOL).
        değişken hed: tam32 = dizi_al(p.cocuk, cb);
        eğer metin_esit(dizi_al(p.a_ad, hed), "YOL") {
            değişken hsol: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, hed));
            değişken hvary: metin = dizi_al(p.a_deg, hed);   // varyant adı (sağ)
            eğer metin_esit(dizi_al(p.a_ad, hsol), "TANIMLAYICI") {
                değişken hcad: metin = dizi_al(p.a_deg, hsol);
                eğer cesit_var_mi(p, hcad) {
                    değişken agg: metin = cesit_struct_ir(p, hcad);
                    değişken disc: tam32 = cesit_disc(p, hcad, hvary);
                    değişken ofs: tam32 = cesit_var_ofset(p, hcad, disc);
                    değişken ar: metin = reg_str(yeni_reg(p));
                    yaz_str("  "); yaz_str(ar); yaz_str(" = alloca "); yaz_str(agg); yb(10);
                    değişken g0: metin = reg_str(yeni_reg(p));
                    yaz_str("  "); yaz_str(g0); yaz_str(" = getelementptr "); yaz_str(agg); yaz_str(", ptr "); yaz_str(ar); yaz_str(", i32 0, i32 0"); yb(10);
                    yaz_str("  store i8 "); yaz_str(tam64_str(disc olarak tam64)); yaz_str(", ptr "); yaz_str(g0); yb(10);
                    değişken ai: tam32 = 1;
                    iken ai < cs {
                        değişken pf: tam32 = ofs + ai - 1;
                        değişken pt: metin = agg_alan(agg, pf);
                        değişken pv: metin = ifade_uret(p, dizi_al(p.cocuk, cb + ai));
                        değişken gp: metin = reg_str(yeni_reg(p));
                        yaz_str("  "); yaz_str(gp); yaz_str(" = getelementptr "); yaz_str(agg); yaz_str(", ptr "); yaz_str(ar); yaz_str(", i32 0, i32 "); yaz_str(tam64_str(pf olarak tam64)); yb(10);
                        yaz_str("  store "); yaz_str(pt); yaz_str(" "); yaz_str(pv); yaz_str(", ptr "); yaz_str(gp); yb(10);
                        ai = ai + 1;
                    }
                    değişken lr: metin = reg_str(yeni_reg(p));
                    yaz_str("  "); yaz_str(lr); yaz_str(" = load "); yaz_str(agg); yaz_str(", ptr "); yaz_str(ar); yb(10);
                    p.son_tip = agg; p.son_ref = ""; p.son_elem = "";
                    ver lr;
                }
            }
        }
        değişken fad: metin = dizi_al(p.a_deg, dizi_al(p.cocuk, cb));  // hedef TANIMLAYICI adı
        // D3: tagged-union yapıcı (değer/tamam/hata) — beklenen_ll bağlamı varsa
        // {i8,..} inşa et (C llvm.c yapici_uret: alloca+store tag+payload+load).
        eğer tagunion_yapici_mi(fad) {
            eğer metin_uzunluk(p.beklenen_ll) > 0 {
                eğer bayt(p.beklenen_ll, 0) == 123 {
                    değişken agg: metin = p.beklenen_ll;
                    değişken tag: tam32 = 0;
                    değişken pf: tam32 = 1;
                    eğer metin_esit(fad, "hata") { tag = 1; pf = 2; }
                    değişken pt: metin = agg_alan(agg, pf);
                    değişken ar: metin = reg_str(yeni_reg(p));
                    yaz_str("  "); yaz_str(ar); yaz_str(" = alloca "); yaz_str(agg); yb(10);
                    değişken g0: metin = reg_str(yeni_reg(p));
                    yaz_str("  "); yaz_str(g0); yaz_str(" = getelementptr "); yaz_str(agg);
                    yaz_str(", ptr "); yaz_str(ar); yaz_str(", i32 0, i32 0"); yb(10);
                    yaz_str("  store i8 "); yaz_str(tam64_str(tag olarak tam64));
                    yaz_str(", ptr "); yaz_str(g0); yb(10);
                    // payload = child[cb+1]; iç içe yapıcı için beklenen_ll ayarla
                    değişken esk: metin = p.beklenen_ll; p.beklenen_ll = "";
                    eğer bayt(pt, 0) == 123 { p.beklenen_ll = pt; }
                    değişken pv: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
                    p.beklenen_ll = esk;
                    değişken gp: metin = reg_str(yeni_reg(p));
                    yaz_str("  "); yaz_str(gp); yaz_str(" = getelementptr "); yaz_str(agg);
                    yaz_str(", ptr "); yaz_str(ar); yaz_str(", i32 0, i32 ");
                    yaz_str(tam64_str(pf olarak tam64)); yb(10);
                    yaz_str("  store "); yaz_str(pt); yaz_str(" "); yaz_str(pv);
                    yaz_str(", ptr "); yaz_str(gp); yb(10);
                    değişken lr: metin = reg_str(yeni_reg(p));
                    yaz_str("  "); yaz_str(lr); yaz_str(" = load "); yaz_str(agg);
                    yaz_str(", ptr "); yaz_str(ar); yb(10);
