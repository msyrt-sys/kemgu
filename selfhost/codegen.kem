            etiket_yaz(p, Lson);
            değişken rr: metin = reg_str(yeni_reg(p));
            yaz_str("  "); yaz_str(rr); yaz_str(" = load i32, ptr "); yaz_str(slot); yb(10);
            p.son_tip = "i32"; p.son_ref = ""; p.son_elem = "";
            ver rr;
        }
        değişken sol: metin = ifade_uret(p, dizi_al(p.cocuk, cb));
        değişken st: metin = p.son_tip;
        değişken sag: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
        değişken gt: metin = p.son_tip;
        değişken optip: metin = tip_birlestir(st, gt);
        eğer karsilastirma_mi(op) {
            değişken c: tam32 = yeni_reg(p);
            değişken cs2: metin = reg_str(c);
            // D3 Öncelik-1: float/double → fcmp + ordered yüklem; aksi icmp.
            değişken cmpk: metin = "icmp ";
            değişken pred: metin = icmp_pred(op);
            eğer kesirli_ll_mi(optip) { cmpk = "fcmp "; pred = fcmp_pred(op); }
            yaz_str("  "); yaz_str(cs2); yaz_str(" = "); yaz_str(cmpk); yaz_str(pred);
            yaz_str(" "); yaz_str(optip); yaz_str(" "); yaz_str(sol); yaz_str(", "); yaz_str(sag); yb(10);
            değişken z: metin = zext_i1(p, cs2); p.son_tip = "i32"; ver z;
        }
        // aritmetik (+ - * / %) + mantıksal (ve/veya → and/or): tek komut.
        // D3 Öncelik-1: float/double → f-varyant (fadd/...); aksi tamsayı.
        değişken r: tam32 = yeni_reg(p);
        değişken rs: metin = reg_str(r);
        değişken mnem: metin = ll_ikili(op);
        eğer kesirli_ll_mi(optip) { mnem = ll_ikili_f(op); }
        yaz_str("  "); yaz_str(rs); yaz_str(" = "); yaz_str(mnem);
        yaz_str(" "); yaz_str(optip); yaz_str(" "); yaz_str(sol); yaz_str(", "); yaz_str(sag); yb(10);
        p.son_tip = optip;
        ver rs;
    }
    eğer metin_esit(ad, "TEKLI") {
        değişken op: metin = dizi_al(p.a_deg, idx);
        değişken opnode: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
        // CG7c: & / &değişken adres-al — LOAD YOK (alloca zaten adres).
        eğer metin_esit(op, "&") veya metin_esit(op, "&degisken") {
            eğer metin_esit(dizi_al(p.a_ad, opnode), "TANIMLAYICI") {
                değişken on: metin = dizi_al(p.a_deg, opnode);
                değişken ot: metin = cg_var_tip_bul(p, on);
                p.son_tip = "ptr";
                eğer bayt(ot, 0) == 37 { p.son_ref = metin_kes(ot, 1, metin_uzunluk(ot) - 1); }
                değilse { p.son_ref = cg_var_ref_bul(p, on); }
                ver cg_var_bul(p, on);
            }
            p.son_tip = "ptr"; p.son_ref = ""; ver "0";
        }
        değişken x: metin = ifade_uret(p, opnode);
        değişken xt: metin = p.son_tip;
        eğer metin_esit(op, "neg") {
            değişken r: tam32 = yeni_reg(p);
            değişken rs: metin = reg_str(r);
            yaz_str("  "); yaz_str(rs); yaz_str(" = sub "); yaz_str(xt); yaz_str(" 0, "); yaz_str(x); yb(10);
            p.son_tip = xt;
            ver rs;
        }
        eğer metin_esit(op, "degil") {
            değişken c: tam32 = yeni_reg(p);
            değişken cs2: metin = reg_str(c);
            yaz_str("  "); yaz_str(cs2); yaz_str(" = icmp eq "); yaz_str(xt); yaz_str(" "); yaz_str(x); yaz_str(", 0"); yb(10);
            değişken z: metin = zext_i1(p, cs2); p.son_tip = "i32"; ver z;
        }
        eğer metin_esit(op, "~") {   // bit-değil: ~x = xor TYPE x, -1 (C llvm.c:2530)
            değişken r: tam32 = yeni_reg(p);
            değişken rs: metin = reg_str(r);
            yaz_str("  "); yaz_str(rs); yaz_str(" = xor "); yaz_str(xt); yaz_str(" "); yaz_str(x); yaz_str(", -1"); yb(10);
            p.son_tip = xt;
            ver rs;
        }
        eğer metin_esit(op, "deref*") {   // *x — ptr'den yükle (C llvm.c:2490)
            // D-267: yük-tipi POINTEE'den (C llvm.c OP_DEREFERANS aynası; D-265 latent
            // parite kapandı). Yapı pointee → operand ref'inden (%Yapi); skaler pointee
            // (*tam8/16/64) → cg_apointee'den (i8/i16/i64). Hiçbiri yoksa i32 varsayılan
            // (canonical *tam32 / mantıksal). Böylece self-host `*tam8==0` → i8-yük (C ile birebir).
            değişken yuk: metin = "i32";
            eğer metin_esit(dizi_al(p.a_ad, opnode), "TANIMLAYICI") {
                değişken pref: metin = cg_var_ref_bul(p, dizi_al(p.a_deg, opnode));
                eğer metin_uzunluk(pref) > 0 { yuk = metin_birlestir("%", pref); }
                değilse {
                    değişken sptr: metin = cg_var_pointee_bul(p, dizi_al(p.a_deg, opnode));
                    eğer metin_uzunluk(sptr) > 0 { yuk = sptr; }
                }
            }
            değişken r: tam32 = yeni_reg(p);
            değişken rs: metin = reg_str(r);
            // D-249 (GAP-3 parite): VOLATILE load. deref* checker-gereği güvensiz-only
            // → C llvm.c'nin guvensiz_derinlik>0 koşulu daima doğru → koşulsuz volatile.
            yaz_str("  "); yaz_str(rs); yaz_str(" = load volatile "); yaz_str(yuk); yaz_str(", ptr "); yaz_str(x); yb(10);
            p.son_tip = yuk;
            ver rs;
        }
        p.son_tip = "i32";
        ver "0";   // & / &degisken (TANIMLAYICI dışı) → CG sonrası
    }
    eğer metin_esit(ad, "YAPI_OLUSTUR") {
        değişken yad: metin = dizi_al(p.a_deg, idx);
        değişken lltip: metin = metin_birlestir("%", yad);
        değişken ap: tam32 = yeni_reg(p);
        değişken apr: metin = reg_str(ap);
        yaz_str("  "); yaz_str(apr); yaz_str(" = alloca "); yaz_str(lltip); yb(10);
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken cs: tam32 = dizi_al(p.a_cs, idx);
        değişken i: tam32 = 0;
        iken i < cs {
            değişken an: tam32 = dizi_al(p.cocuk, cb + i);   // ALAN_ATAMA
            değişken alan_ad_s: metin = dizi_al(p.a_deg, an);
            değişken fidx: tam32 = yapi_alan_idx(p, yad, alan_ad_s);
            değişken ftip: metin = yapi_alan_tip(p, yad, alan_ad_s);
            p.beklenen_elem = yapi_alan_elem(p, yad, alan_ad_s);   // CG8: [] alan değeri için bağlam
            değişken v: metin = ifade_uret(p, dizi_al(p.cocuk, dizi_al(p.a_cb, an)));
            değişken g: tam32 = yeni_reg(p);
            değişken gr: metin = reg_str(g);
            yaz_str("  "); yaz_str(gr); yaz_str(" = getelementptr "); yaz_str(lltip); yaz_str(", ptr ");
            yaz_str(apr); yaz_str(", i32 0, i32 "); yaz_str(tam64_str(fidx olarak tam64)); yb(10);
            yaz_str("  store "); yaz_str(ftip); yaz_str(" "); yaz_str(v); yaz_str(", ptr "); yaz_str(gr); yb(10);
            i = i + 1;
        }
        değişken r: tam32 = yeni_reg(p);
        değişken rs: metin = reg_str(r);
        yaz_str("  "); yaz_str(rs); yaz_str(" = load "); yaz_str(lltip); yaz_str(", ptr "); yaz_str(apr); yb(10);
        p.son_tip = lltip;
        ver rs;
    }
    eğer metin_esit(ad, "ERISIM") {
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken alan_ad_s: metin = dizi_al(p.a_deg, idx);
        değişken nesne: metin = ifade_uret(p, dizi_al(p.cocuk, cb));
        değişken ntip: metin = p.son_tip;
        değişken nref: metin = p.son_ref;
        // CG7b: struct VALUE ("%..." ile başlar) → extractvalue.
        eğer bayt(ntip, 0) == 37 {
            değişken yad: metin = metin_kes(ntip, 1, metin_uzunluk(ntip) - 1);
            değişken fidx: tam32 = yapi_alan_idx(p, yad, alan_ad_s);
            değişken ftip: metin = yapi_alan_tip(p, yad, alan_ad_s);
            değişken r: tam32 = yeni_reg(p);
            değişken rs: metin = reg_str(r);
            yaz_str("  "); yaz_str(rs); yaz_str(" = extractvalue "); yaz_str(ntip); yaz_str(" "); yaz_str(nesne);
            yaz_str(", "); yaz_str(tam64_str(fidx olarak tam64)); yb(10);
            p.son_tip = ftip; p.son_ref = ""; p.son_elem = yapi_alan_elem(p, yad, alan_ad_s);
            ver rs;
        }
        // CG7c: ptr (referans) → getelementptr + load.
        eğer metin_esit(nref, "") == yanlış {
            değişken lltip: metin = metin_birlestir("%", nref);
            değişken fidx2: tam32 = yapi_alan_idx(p, nref, alan_ad_s);
            değişken ftip2: metin = yapi_alan_tip(p, nref, alan_ad_s);
            değişken g: tam32 = yeni_reg(p);
            değişken gr: metin = reg_str(g);
            yaz_str("  "); yaz_str(gr); yaz_str(" = getelementptr "); yaz_str(lltip); yaz_str(", ptr ");
            yaz_str(nesne); yaz_str(", i32 0, i32 "); yaz_str(tam64_str(fidx2 olarak tam64)); yb(10);
            değişken r2: tam32 = yeni_reg(p);
            değişken rs2: metin = reg_str(r2);
            yaz_str("  "); yaz_str(rs2); yaz_str(" = load "); yaz_str(ftip2); yaz_str(", ptr "); yaz_str(gr); yb(10);
            p.son_tip = ftip2; p.son_ref = ""; p.son_elem = yapi_alan_elem(p, nref, alan_ad_s);
            ver rs2;
        }
        p.son_tip = "i32"; p.son_ref = ""; p.son_elem = "";
        ver "0";
    }
    eğer metin_esit(ad, "DIZI_OLUSTUR") {
        değişken elem: metin = p.beklenen_elem;
        p.beklenen_elem = "";   // tek seferlik tüket
        eğer metin_esit(elem, "") { elem = "i32"; }
        // V2-F4.2b (b3): YÖNLENDİRME — confined+skaler dizi → ρ_yerel (ret'te serbest);
        // aksi → rho_ref (ρ_caller). Hem olustur hem ekle AYNI ρ'yu kullanır (tutarlılık).
        değişken drho: metin = bolge_yerel_yonlendir(p, idx, elem);
        değişken d: tam32 = yeni_reg(p);
        değişken dr: metin = reg_str(d);
        yaz_str("  "); yaz_str(dr); yaz_str(" = call ptr @kdl_dizi_olustur(ptr ");
        yaz_str(drho); yaz_str(", i32 ");   // V2-F4.2b: yönlendirilmiş ρ
        yaz_str(dizi_eleman_byte(elem)); yaz_str(")"); yb(10);
        // elemanları ekle (boş [] → atla)
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken cs: tam32 = dizi_al(p.a_cs, idx);
        değişken i: tam32 = 0;
        iken i < cs {
            değişken e: metin = ifade_uret(p, dizi_al(p.cocuk, cb + i));
            değişken et: metin = p.son_tip;
            yaz_str("  call void @kdl_dizi_ekle_"); yaz_str(dizi_ekle_sonek(et)); yaz_str("(ptr ");
            yaz_str(drho); yaz_str(", ptr ");   // V2-F4.2b: aynı yönlendirilmiş ρ
            yaz_str(dr); yaz_str(", "); yaz_str(dizi_arg_tip(et)); yaz_str(" "); yaz_str(e); yaz_str(")"); yb(10);
            i = i + 1;
        }
        p.son_tip = "ptr"; p.son_elem = elem; p.son_ref = "";
        ver dr;
    }
    eğer metin_esit(ad, "INDEKS") {
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken arr: metin = ifade_uret(p, dizi_al(p.cocuk, cb));
        değişken elem: metin = p.son_elem;
        değişken i2: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
        eğer metin_esit(elem, "") { elem = "i32"; }
        değişken r: tam32 = yeni_reg(p);
        değişken rs: metin = reg_str(r);
        yaz_str("  "); yaz_str(rs); yaz_str(" = call "); yaz_str(dizi_al_rettip(elem));
        yaz_str(" @kdl_dizi_al_"); yaz_str(dizi_al_sonek(elem)); yaz_str("(ptr "); yaz_str(arr);
        yaz_str(", i32 "); yaz_str(i2); yaz_str(")"); yb(10);
        p.son_tip = dizi_al_rettip(elem); p.son_elem = ""; p.son_ref = "";
        ver rs;
    }
    eğer metin_esit(ad, "TIP_DONUSTUR") {
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken x: metin = ifade_uret(p, dizi_al(p.cocuk, cb));
        değişken kaynak: metin = p.son_tip;
        değişken hedef: metin = ll_tip(p, dizi_al(p.cocuk, cb + 1));
        eğer metin_esit(kaynak, hedef) { p.son_tip = hedef; ver x; }
        değişken r: tam32 = yeni_reg(p);
        değişken rs: metin = reg_str(r);
        // D-249 (GAP-1 parite, C llvm.c D-248 aynası): int↔ptr cast. güvensiz-scoped
        // (checker); hedef ptr → inttoptr, kaynak ptr → ptrtoint.
        eğer metin_esit(hedef, "ptr") ve (metin_esit(kaynak, "ptr") == yanlış) {
            yaz_str("  "); yaz_str(rs); yaz_str(" = inttoptr "); yaz_str(kaynak);
            yaz_str(" "); yaz_str(x); yaz_str(" to ptr"); yb(10);
            p.son_tip = "ptr"; ver rs;
        }
        eğer metin_esit(kaynak, "ptr") ve (metin_esit(hedef, "ptr") == yanlış) {
            yaz_str("  "); yaz_str(rs); yaz_str(" = ptrtoint ptr "); yaz_str(x);
            yaz_str(" to "); yaz_str(hedef); yb(10);
            p.son_tip = hedef; ver rs;
        }
        // D3: float↔int + float↔float cast (C llvm.c:3763-3781). int↔int = sext/trunc.
        değişken ksf: mantıksal = kesirli_ll_mi(kaynak);
        değişken hdf: mantıksal = kesirli_ll_mi(hedef);
        değişken islem: metin = "sext";
        eğer ksf == yanlış ve hdf == yanlış {
            eğer tip_genislik(hedef) < tip_genislik(kaynak) { islem = "trunc"; }
        }
        eğer ksf == yanlış ve hdf { islem = "sitofp"; }      // int → float
        eğer ksf ve hdf == yanlış { islem = "fptosi"; }      // float → int
        eğer ksf ve hdf {                                     // float ↔ float
            islem = "fpext";
            eğer metin_esit(kaynak, "double") { islem = "fptrunc"; }
        }
        yaz_str("  "); yaz_str(rs); yaz_str(" = "); yaz_str(islem); yaz_str(" "); yaz_str(kaynak);
        yaz_str(" "); yaz_str(x); yaz_str(" to "); yaz_str(hedef); yb(10);
        p.son_tip = hedef;
        ver rs;
    }
    eğer metin_esit(ad, "YOL") {
        // D3 çeşit: Çeşit::Varyant (payloadsuz enum) → i8 disc sabiti (immediate).
        // Payload varyant (Çeşit::V(x)) + modül YOL → sonraki iş.
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken sol: tam32 = dizi_al(p.cocuk, cb);
        değişken vary: metin = dizi_al(p.a_deg, idx);   // sağ segment = varyant adı
        eğer metin_esit(dizi_al(p.a_ad, sol), "TANIMLAYICI") {
            değişken cad: metin = dizi_al(p.a_deg, sol);
            eğer cesit_enum_mi(p, cad) {
                p.son_tip = "i8";
                ver tam64_str(cesit_disc(p, cad, vary) olarak tam64);
            }
            eğer cesit_var_mi(p, cad) {
                // payload çeşit, payloadsuz varyant (Çeşit::Nokta) → {i8 disc, undef}
                değişken agg: metin = cesit_struct_ir(p, cad);
                değişken ar: metin = reg_str(yeni_reg(p));
                yaz_str("  "); yaz_str(ar); yaz_str(" = alloca "); yaz_str(agg); yb(10);
                değişken g0: metin = reg_str(yeni_reg(p));
                yaz_str("  "); yaz_str(g0); yaz_str(" = getelementptr "); yaz_str(agg); yaz_str(", ptr "); yaz_str(ar); yaz_str(", i32 0, i32 0"); yb(10);
                yaz_str("  store i8 "); yaz_str(tam64_str(cesit_disc(p, cad, vary) olarak tam64)); yaz_str(", ptr "); yaz_str(g0); yb(10);
                değişken lr: metin = reg_str(yeni_reg(p));
                yaz_str("  "); yaz_str(lr); yaz_str(" = load "); yaz_str(agg); yaz_str(", ptr "); yaz_str(ar); yb(10);
                p.son_tip = agg; p.son_ref = ""; p.son_elem = "";
                ver lr;
            }
        }
        p.son_tip = "i32"; ver "0";   // diğer YOL → sonraki iş
    }
    p.son_tip = "i32";
    ver "0";   // CG6 dışı düğüm → CG7+
}

// Deyim → IR.
işlev deyim_uret(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken ad: metin = dizi_al(p.a_ad, idx);
    eğer metin_esit(ad, "BLOK") {
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken cs: tam32 = dizi_al(p.a_cs, idx);
        // CG-SCOPE: blok = leksik kapsam. Giriş slice'ını al; çıkışta iç bağlamaları
        // kapat (shadow geri-al). eğer/iken/güvensiz gövdeleri de BLOK → bu yoldan kapsamlanır.
        değişken kapsam_bas: tam32 = dizi_boyut(p.cg_ad);
        değişken i: tam32 = 0;
        iken i < cs { deyim_uret(p, dizi_al(p.cocuk, cb + i)); i = i + 1; }
        cg_kapsam_kapat(p, kapsam_bas);
        ver 0;
    }
    eğer metin_esit(ad, "GUVENSIZ") {
        // CG: güvensiz = codegen açısından DÜZ BLOK → tek çocuğu (BLOK gövde) aynen emit et.
        // Önceki durum: bu kol yoktu → gövde sessizce DÜŞERDİ (latent miscompile).
        // C llvm.c DUGUM_GUVENSIZ ile aynı amaç: gövde aynen üretilir. C'de ayrıca
        // guvensiz_derinlik ile inline stack sınır-kontrolü atlanır; self-host HEAP-uniform
        // (dizi erişimi runtime-kontrollü) → inline stack kontrolü zaten yok, o makine GEREKMEZ.
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        deyim_uret(p, dizi_al(p.cocuk, cb));   // gövde bloğunu emit et
        ver 0;
    }
    eğer metin_esit(ad, "VER") {
        eğer dizi_al(p.a_cs, idx) > 0 {
            // D3: dönüş tipi tagged-union ({i8,..}) ise yapıcı bağlamı (ver tamam(x))
            değişken eski_bll: metin = p.beklenen_ll;
            eğer bayt(p.cur_ret, 0) == 123 { p.beklenen_ll = p.cur_ret; }
            değişken op: metin = ifade_uret(p, dizi_al(p.cocuk, dizi_al(p.a_cb, idx)));
            p.beklenen_ll = eski_bll;
            op = ret_uydur(p, op);       // Karar 1: i64-taşıyıcı → fn dönüşüne daralt
            rho_iter_serbest_emit(p);    // F4.3 a2: döngü-içi ver → ρ_iter (iç) önce
            rho_yerel_serbest_emit(p);   // V2-F4.2b (b2): sonra ρ_yerel (dış); dönüş değeri materyalize sonrası
            yaz_str("  ret "); yaz_str(p.cur_ret); yaz_str(" "); yaz_str(op); yb(10);
        } değilse { rho_iter_serbest_emit(p); rho_yerel_serbest_emit(p); yaz_str("  ret "); yaz_str(p.cur_ret); yaz_str(" 0"); yb(10); }
        p.bb_term = 1;   // ret = terminatör
        ver 0;
    }
    eğer metin_esit(ad, "EGER") {
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken cs: tam32 = dizi_al(p.a_cs, idx);
        değişken c: metin = kosul_i1(p, ifade_uret(p, dizi_al(p.cocuk, cb)));
        değişken Lthen: metin = yeni_label(p);
        değişken Lend: metin = yeni_label(p);
        değişken Lelse: metin = Lend;
        eğer cs >= 3 { Lelse = yeni_label(p); }
        yaz_str("  br i1 "); yaz_str(c); yaz_str(", label %"); yaz_str(Lthen);
        yaz_str(", label %"); yaz_str(Lelse); yb(10); p.bb_term = 1;
        etiket_yaz(p, Lthen);
        deyim_uret(p, dizi_al(p.cocuk, cb + 1));
        br_to(p, Lend);
        eğer cs >= 3 {
            etiket_yaz(p, Lelse);
            deyim_uret(p, dizi_al(p.cocuk, cb + 2));
            br_to(p, Lend);
        }
        etiket_yaz(p, Lend);
        ver 0;
    }
    eğer metin_esit(ad, "IKEN") {
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken Lhead: metin = yeni_label(p);
        değişken Lbody: metin = yeni_label(p);
        değişken Lend: metin = yeni_label(p);
        br_to(p, Lhead);
        etiket_yaz(p, Lhead);
        değişken c: metin = kosul_i1(p, ifade_uret(p, dizi_al(p.cocuk, cb)));
        yaz_str("  br i1 "); yaz_str(c); yaz_str(", label %"); yaz_str(Lbody);
        yaz_str(", label %"); yaz_str(Lend); yb(10); p.bb_term = 1;
        etiket_yaz(p, Lbody);
        // F4.3 a2: en-dış döngü (dongu_d 0→1) → gövde-girişinde ρ_iter YARAT (per-iterasyon;
        // Lbody re-entry → %ri her iter yeniden). İç döngü (dongu_d>1) ρ_iter'a dokunmaz.
        p.dongu_d = p.dongu_d + 1;
        // D-256: çıplak fn'de ρ_iter (per-iterasyon region) DE bastırılır → C paritesi
        // (C llvm.c'de rho_iter kavramı yok; çıplak "sıfır region-symbol" invaryantı döngüde de).
        eğer p.dongu_d == 1 ve p.ciplak_aktif == 0 {
            değişken ri: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(ri)); yaz_str(" = call ptr @kdl_bolge_olustur()"); yb(10);
            p.rho_iter = reg_str(ri);
        }
        deyim_uret(p, dizi_al(p.cocuk, cb + 1));
        // F4.3 a2: gövde fall-through (bb_term==0) → back-edge ÖNCESİ ρ_iter serbest.
        // ver-yolu VER handler'da serbest etti (bb_term==1 → atla, çift-serbest yok).
        eğer p.dongu_d == 1 { eğer p.bb_term == 0 { rho_iter_serbest_emit(p); } }
        p.dongu_d = p.dongu_d - 1;
        eğer p.dongu_d == 0 { p.rho_iter = ""; }
        br_to(p, Lhead);   // başa dön
        etiket_yaz(p, Lend);
        ver 0;
    }
    eğer metin_esit(ad, "ICIN") {
        // D3 P2: için x: dizi { gövde } — heap KdlDizi* iterasyonu (C llvm.c:4350).
        // koleksiyon TANIMLAYICI + heap dizi (eleman tipi "" değil) olmalı; aksi atla.
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken col: tam32 = dizi_al(p.cocuk, cb);
        değişken govde: tam32 = dizi_al(p.cocuk, cb + 1);
        değişken dvar: metin = dizi_al(p.a_deg, idx);   // döngü değişkeni adı
        eğer metin_esit(dizi_al(p.a_ad, col), "TANIMLAYICI") == yanlış {
            yaz_str("  ; icin: koleksiyon tanimlayici degil"); yb(10); ver 0;
        }
        değişken kp: metin = ifade_uret(p, col);   // KdlDizi* ptr
        değişken et: metin = p.son_elem;
        eğer metin_esit(et, "") {
            yaz_str("  ; icin: heap dizi degil (v1 sinir)"); yb(10); ver 0;
        }
        // n = kdl_dizi_boyut(kp)
        değişken nr: metin = reg_str(yeni_reg(p));
        yaz_str("  "); yaz_str(nr); yaz_str(" = call i32 @kdl_dizi_boyut(ptr "); yaz_str(kp); yaz_str(")"); yb(10);
        // i alloca = 0
        değişken ia: metin = reg_str(yeni_reg(p));
        yaz_str("  "); yaz_str(ia); yaz_str(" = alloca i32"); yb(10);
        yaz_str("  store i32 0, ptr "); yaz_str(ia); yb(10);
        // x alloca (eleman) + döngü değişkenini bağla
        değişken xa: metin = reg_str(yeni_reg(p));
        yaz_str("  "); yaz_str(xa); yaz_str(" = alloca "); yaz_str(et); yb(10);
        // CG-SCOPE: döngü değişkeni `dvar` yalnız gövdede görünür. Bağlamadan önce
        // slice'ı al; döngü çıkışında kapat (dış aynı-ad bağlamasını shadow'lamasın).
        değişken kapsam_bas: tam32 = dizi_boyut(p.cg_ad);
        cg_var_ekle(p, dvar, xa, et, "", "");
        değişken Lhead: metin = yeni_label(p);
        değişken Lbody: metin = yeni_label(p);
        değişken Ldone: metin = yeni_label(p);
        br_to(p, Lhead);
        etiket_yaz(p, Lhead);
        değişken il: metin = reg_str(yeni_reg(p));
        yaz_str("  "); yaz_str(il); yaz_str(" = load i32, ptr "); yaz_str(ia); yb(10);
        değişken cmp: metin = reg_str(yeni_reg(p));
        yaz_str("  "); yaz_str(cmp); yaz_str(" = icmp slt i32 "); yaz_str(il); yaz_str(", "); yaz_str(nr); yb(10);
        yaz_str("  br i1 "); yaz_str(cmp); yaz_str(", label %"); yaz_str(Lbody);
        yaz_str(", label %"); yaz_str(Ldone); yb(10); p.bb_term = 1;
        etiket_yaz(p, Lbody);
        // x = kdl_dizi_al_<sonek>(kp, i)
        değişken elr: metin = reg_str(yeni_reg(p));
        yaz_str("  "); yaz_str(elr); yaz_str(" = call "); yaz_str(dizi_al_rettip(et));
        yaz_str(" @kdl_dizi_al_"); yaz_str(dizi_al_sonek(et)); yaz_str("(ptr "); yaz_str(kp);
        yaz_str(", i32 "); yaz_str(il); yaz_str(")"); yb(10);
        yaz_str("  store "); yaz_str(et); yaz_str(" "); yaz_str(elr); yaz_str(", ptr "); yaz_str(xa); yb(10);
        // F4.3 a2: en-dış döngü (dongu_d 0→1) → gövde-girişinde ρ_iter yarat (per-iterasyon).
        p.dongu_d = p.dongu_d + 1;
        // D-256: çıplak fn'de ρ_iter bastırılır (C paritesi; yukarı IKEN ile aynı gerekçe).
        eğer p.dongu_d == 1 ve p.ciplak_aktif == 0 {
            değişken ri2: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(ri2)); yaz_str(" = call ptr @kdl_bolge_olustur()"); yb(10);
            p.rho_iter = reg_str(ri2);
        }
        deyim_uret(p, govde);
        eğer p.bb_term == 0 {
            eğer p.dongu_d == 1 { rho_iter_serbest_emit(p); }   // F4.3 a2: back-edge öncesi serbest
            değişken ni: metin = reg_str(yeni_reg(p));
            yaz_str("  "); yaz_str(ni); yaz_str(" = add i32 "); yaz_str(il); yaz_str(", 1"); yb(10);
            yaz_str("  store i32 "); yaz_str(ni); yaz_str(", ptr "); yaz_str(ia); yb(10);
            br_to(p, Lhead);
        }
        p.dongu_d = p.dongu_d - 1;
        eğer p.dongu_d == 0 { p.rho_iter = ""; }   // F4.3 a2: döngü-dışına çıktı
        etiket_yaz(p, Ldone);
        cg_kapsam_kapat(p, kapsam_bas);   // CG-SCOPE: döngü değişkeni kapsamını kapat
        ver 0;
    }
    eğer metin_esit(ad, "ESLES") {
        // D3 Öncelik-1 (kısmi): tamsayı/float eşleş — literal + joker/tanımlayıcı
        // catch-all (icmp eq zinciri, C llvm.c:4441 skaler altkümesi). Tagged-union
        // (sonuç/seçimlik/çeşit) destructuring AYRI iş (beklenen-tip plumbing +
        // payload extract) → struct/ptr scrutinee'de atla (sonraki rung).
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken cs: tam32 = dizi_al(p.a_cs, idx);
        değişken sval: metin = ifade_uret(p, dizi_al(p.cocuk, cb));
        değişken sty: metin = p.son_tip;
        değişken skaler: mantıksal = metin_esit(sty, "i8") veya metin_esit(sty, "i16")
            veya metin_esit(sty, "i32") veya metin_esit(sty, "i64")
            veya metin_esit(sty, "float") veya metin_esit(sty, "double");
        eğer skaler == yanlış {
            // D3: tagged-union ({i8,..}) destructuring — değilse atla (çeşit ileride)
            değişken tagged: mantıksal = yanlış;
            eğer metin_uzunluk(sty) > 0 { eğer bayt(sty, 0) == 123 { tagged = doğru; } }
            eğer tagged == yanlış { ver 0; }
            değişken tagr: metin = reg_str(yeni_reg(p));
            yaz_str("  "); yaz_str(tagr); yaz_str(" = extractvalue "); yaz_str(sty);
            yaz_str(" "); yaz_str(sval); yaz_str(", 0"); yb(10);
            değişken Lend: metin = yeni_label(p);
            değişken acik: mantıksal = doğru;
            değişken i: tam32 = 1;
            iken i < cs ve acik {
                değişken kol: tam32 = dizi_al(p.cocuk, cb + i);
                değişken kcb: tam32 = dizi_al(p.a_cb, kol);
                değişken desen: tam32 = dizi_al(p.cocuk, kcb);
                değişken govde: tam32 = dizi_al(p.cocuk, kcb + 1);
                // CG-SCOPE: kol payload bağlamaları (değer(v)/hata(e)/Çeşit::V(a,b))
                // yalnız bu kolun gövdesinde görünür. Bağlamalardan önce slice'ı al.
                değişken kapsam_bas: tam32 = dizi_boyut(p.cg_ad);
                değişken dad: metin = dizi_al(p.a_ad, desen);
                değişken pad: metin = dizi_al(p.a_deg, desen);
                değişken variant: mantıksal = metin_esit(pad, "değer")
                    veya metin_esit(pad, "tamam") veya metin_esit(pad, "hata")
                    veya metin_esit(pad, "hiç");
                değişken Lbody: metin = yeni_label(p);
                değişken katch: mantıksal = metin_esit(dad, "DESEN_JOKER")
                    veya (metin_esit(dad, "DESEN_TANIMLAYICI") ve variant == yanlış);
                eğer katch {
                    br_to(p, Lbody);
                    etiket_yaz(p, Lbody);
                    deyim_uret(p, govde);
                    cg_kapsam_kapat(p, kapsam_bas);   // CG-SCOPE: kol kapsamını kapat
                    br_to(p, Lend);
                    acik = yanlış;
                }
                değilse {
                    değişken tag: tam32 = 0;
                    değişken pf: tam32 = 1;
                    eğer metin_esit(pad, "hata") { tag = 1; pf = 2; }
                    eğer metin_esit(pad, "hiç") { tag = 1; }
                    eğer metin_esit(dad, "DESEN_YOL") { tag = yol_disc(p, pad); }  // çeşit disc
                    değişken Lnext: metin = yeni_label(p);
                    değişken cr: metin = reg_str(yeni_reg(p));
                    yaz_str("  "); yaz_str(cr); yaz_str(" = icmp eq i8 "); yaz_str(tagr);
                    yaz_str(", "); yaz_str(tam64_str(tag olarak tam64)); yb(10);
                    yaz_str("  br i1 "); yaz_str(cr); yaz_str(", label %"); yaz_str(Lbody);
                    yaz_str(", label %"); yaz_str(Lnext); yb(10); p.bb_term = 1;
                    etiket_yaz(p, Lbody);
                    // DESEN_YAPICI (değer(v)/tamam(v)/hata(e)) → payload'ı ada bağla
                    eğer metin_esit(dad, "DESEN_YAPICI") {
                        değişken dcs: tam32 = dizi_al(p.a_cs, desen);
                        eğer dcs > 0 {
                            değişken alt: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, desen));
                            değişken bad: metin = dizi_al(p.a_deg, alt);
                            değişken pt: metin = agg_alan(sty, pf);
                            değişken pv: metin = reg_str(yeni_reg(p));
                            yaz_str("  "); yaz_str(pv); yaz_str(" = extractvalue "); yaz_str(sty);
                            yaz_str(" "); yaz_str(sval); yaz_str(", "); yaz_str(tam64_str(pf olarak tam64)); yb(10);
                            değişken ba: metin = reg_str(yeni_reg(p));
                            yaz_str("  "); yaz_str(ba); yaz_str(" = alloca "); yaz_str(pt); yb(10);
                            yaz_str("  store "); yaz_str(pt); yaz_str(" "); yaz_str(pv);
                            yaz_str(", ptr "); yaz_str(ba); yb(10);
                            cg_var_ekle(p, bad, ba, pt, "", "");
                        }
                    }
                    eğer metin_esit(dad, "DESEN_YOL") {
                        // D3 çeşit payload bind: alt-desenler struct ofsetinden extract
                        değişken ccad: metin = yol_cesit(pad);
                        değişken ofs: tam32 = cesit_var_ofset(p, ccad, tag);
                        değişken dcs2: tam32 = dizi_al(p.a_cs, desen);
                        değişken dcb2: tam32 = dizi_al(p.a_cb, desen);
                        değişken k: tam32 = 0;
                        iken k < dcs2 {
                            değişken sub: tam32 = dizi_al(p.cocuk, dcb2 + k);
                            değişken bad2: metin = dizi_al(p.a_deg, sub);
                            değişken pf3: tam32 = ofs + k;
                            değişken pt2: metin = agg_alan(sty, pf3);
                            değişken pv2: metin = reg_str(yeni_reg(p));
                            yaz_str("  "); yaz_str(pv2); yaz_str(" = extractvalue "); yaz_str(sty);
                            yaz_str(" "); yaz_str(sval); yaz_str(", "); yaz_str(tam64_str(pf3 olarak tam64)); yb(10);
                            değişken ba2: metin = reg_str(yeni_reg(p));
                            yaz_str("  "); yaz_str(ba2); yaz_str(" = alloca "); yaz_str(pt2); yb(10);
                            yaz_str("  store "); yaz_str(pt2); yaz_str(" "); yaz_str(pv2);
                            yaz_str(", ptr "); yaz_str(ba2); yb(10);
                            cg_var_ekle(p, bad2, ba2, pt2, "", "");
                            k = k + 1;
                        }
                    }
                    deyim_uret(p, govde);
                    cg_kapsam_kapat(p, kapsam_bas);   // CG-SCOPE: kol kapsamını kapat
                    br_to(p, Lend);
                    etiket_yaz(p, Lnext);
                }
                i = i + 1;
            }
            br_to(p, Lend);
            etiket_yaz(p, Lend);
            ver 0;
        }
        değişken kesirli: mantıksal = kesirli_ll_mi(sty);
        değişken Lend: metin = yeni_label(p);
        değişken acik: mantıksal = doğru;
        değişken i: tam32 = 1;
        iken i < cs ve acik {
            değişken kol: tam32 = dizi_al(p.cocuk, cb + i);
            değişken kcb: tam32 = dizi_al(p.a_cb, kol);
            değişken desen: tam32 = dizi_al(p.cocuk, kcb);
            değişken govde: tam32 = dizi_al(p.cocuk, kcb + 1);
            değişken dad: metin = dizi_al(p.a_ad, desen);
            değişken Lbody: metin = yeni_label(p);
            değişken katch: mantıksal = metin_esit(dad, "DESEN_JOKER")
                veya metin_esit(dad, "DESEN_TANIMLAYICI");
            eğer katch {
                br_to(p, Lbody);
                etiket_yaz(p, Lbody);
                deyim_uret(p, govde);
                br_to(p, Lend);
                acik = yanlış;   // catch-all sonrası kollar erişilemez
            }
            değilse {
                // DESEN_LITERAL: child[0] = literal ifade; DESEN_YOL: enum çeşit disc.
                değişken Lnext: metin = yeni_label(p);
                değişken lit: metin = "";
                eğer metin_esit(dad, "DESEN_YOL") {
                    // D3 çeşit: Çeşit::Varyant deseni → disc sabiti (i8 scrutinee)
                    lit = tam64_str(yol_disc(p, dizi_al(p.a_deg, desen)) olarak tam64);
                }
                değilse {
                    değişken dcb: tam32 = dizi_al(p.a_cb, desen);
                    lit = ifade_uret(p, dizi_al(p.cocuk, dcb));
                }
                değişken cr: tam32 = yeni_reg(p);
                değişken crs: metin = reg_str(cr);
                değişken cmpk: metin = "icmp eq ";
                eğer kesirli { cmpk = "fcmp oeq "; }
                yaz_str("  "); yaz_str(crs); yaz_str(" = "); yaz_str(cmpk); yaz_str(sty);
                yaz_str(" "); yaz_str(sval); yaz_str(", "); yaz_str(lit); yb(10);
                yaz_str("  br i1 "); yaz_str(crs); yaz_str(", label %"); yaz_str(Lbody);
                yaz_str(", label %"); yaz_str(Lnext); yb(10); p.bb_term = 1;
                etiket_yaz(p, Lbody);
                deyim_uret(p, govde);
                br_to(p, Lend);
                etiket_yaz(p, Lnext);
            }
            i = i + 1;
        }
        br_to(p, Lend);   // hiçbiri eşleşmedi → end
        etiket_yaz(p, Lend);
        ver 0;
    }
    eğer metin_esit(ad, "DEGISKEN") {
        // değer = SON çocuk; tip-annot opsiyonel İLK çocuk (TIP_*)
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken cs: tam32 = dizi_al(p.a_cs, idx);
        değişken vtip: metin = "i32";
        değişken velem: metin = "";
        değişken vpointee: metin = "";   // D-267: *tamN ise skaler pointee LLVM tipi
        değişken vic: metin = "";        // D-299: görev<T>/kanal<T> ise T'nin LLVM tipi
        değişken annot: tam32 = 0;
        eğer cs >= 2 {
            değişken annot_node: tam32 = dizi_al(p.cocuk, cb);
            vtip = ll_tip(p, annot_node); annot = 1;
            velem = ll_eleman_tip(p, annot_node);             // Dizi<T> → eleman
            vic = ll_ic_tip(p, annot_node);                   // D-299: görev/kanal → T
            p.beklenen_elem = velem;                          // CG8: [] için bağlam
            // D-267: *tamN pointer → skaler pointee (deref-read yük-genişliği; C pointee_llvm_tip aynası)
            eğer metin_esit(dizi_al(p.a_ad, annot_node), "TIP_POINTER") {
                vpointee = ll_tip(p, dizi_al(p.cocuk, dizi_al(p.a_cb, annot_node)));
            }
        }
        // D3: annotasyon tagged-union ({i8,..}) ise yapıcı bağlamı kur (değer/tamam/...)
        değişken eski_bll: metin = p.beklenen_ll;
        eğer annot == 1 { eğer bayt(vtip, 0) == 123 { p.beklenen_ll = vtip; } }
        değişken v: metin = ifade_uret(p, dizi_al(p.cocuk, cb + cs - 1));
        p.beklenen_ll = eski_bll;   // RESET (sızdırma)
        değişken vref: metin = p.son_ref;   // CG7c: değer ptr ise işaret ettiği yapı (&p vb.)
        eğer annot == 0 { vtip = p.son_tip; velem = p.son_elem; }   // annotasyon yok → değerden çıkar
        // CG9: annotasyonlu → alloca entry'de hoist edildi; değilse inline (eski yol).
        değişken areg: metin = "";
        eğer annot == 1 { areg = pa_reg_bul(p, idx); }
        eğer metin_esit(areg, "") {
            değişken a: tam32 = yeni_reg(p);
            areg = reg_str(a);
            yaz_str("  "); yaz_str(areg); yaz_str(" = alloca "); yaz_str(vtip); yb(10);
        }
        yaz_str("  store "); yaz_str(vtip); yaz_str(" "); yaz_str(v); yaz_str(", ptr "); yaz_str(areg); yb(10);
        cg_var_ekle(p, dizi_al(p.a_deg, idx), areg, vtip, vref, velem);
        eğer metin_uzunluk(vpointee) > 0 {   // D-267: skaler pointee tipi kaydet
            dizi_yaz(p.cg_apointee, dizi_boyut(p.cg_apointee) - 1, vpointee);
        }
        eğer metin_uzunluk(vic) > 0 {   // D-299: görev<T>/kanal<T> iç tipi kaydet
            dizi_yaz(p.cg_aic, dizi_boyut(p.cg_aic) - 1, vic);
        }
        ver 0;
    }
    eğer metin_esit(ad, "ATAMA") {
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken lhs: tam32 = dizi_al(p.cocuk, cb);
        // CG3: lhs TANIMLAYICI → doğrudan store.
        eğer metin_esit(dizi_al(p.a_ad, lhs), "TANIMLAYICI") {
            // D-253: küresel değişken → store @ad (local DEĞİL).
            değişken kt2: metin = kuresel_tip_bul(p, dizi_al(p.a_deg, lhs));
            eğer metin_uzunluk(kt2) > 0 {
                değişken vk: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
                yaz_str("  store "); yaz_str(kt2); yaz_str(" "); yaz_str(vk);
                yaz_str(", ptr @"); yaz_str(dizi_al(p.a_deg, lhs)); yb(10);
                ver 0;
            }
            değişken v: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            değişken vt: metin = cg_var_tip_bul(p, dizi_al(p.a_deg, lhs));
            yaz_str("  store "); yaz_str(vt); yaz_str(" "); yaz_str(v); yaz_str(", ptr ");
            yaz_str(cg_var_bul(p, dizi_al(p.a_deg, lhs))); yb(10);
            ver 0;
        }
        // CG7c: lhs ERISIM (p.alan = v) — tek seviye, nesne TANIMLAYICI.
        eğer metin_esit(dizi_al(p.a_ad, lhs), "ERISIM") {
            değişken obj: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, lhs));
            değişken alan: metin = dizi_al(p.a_deg, lhs);
            eğer metin_esit(dizi_al(p.a_ad, obj), "TANIMLAYICI") {
                değişken oname: metin = dizi_al(p.a_deg, obj);
                değişken otip: metin = cg_var_tip_bul(p, oname);
                değişken v2: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
                değişken base: metin = "";
                değişken yad: metin = "";
                eğer bayt(otip, 0) == 37 {   // struct-değer değişkeni → alloca = adres
                    base = cg_var_bul(p, oname);
                    yad = metin_kes(otip, 1, metin_uzunluk(otip) - 1);
                } değilse {                   // ptr → param-alloca'dan yükle
                    değişken lr: tam32 = yeni_reg(p);
                    değişken lrs: metin = reg_str(lr);
                    yaz_str("  "); yaz_str(lrs); yaz_str(" = load ptr, ptr "); yaz_str(cg_var_bul(p, oname)); yb(10);
                    base = lrs;
                    yad = cg_var_ref_bul(p, oname);
                }
                değişken fidx: tam32 = yapi_alan_idx(p, yad, alan);
                değişken ftip: metin = yapi_alan_tip(p, yad, alan);
                değişken g: tam32 = yeni_reg(p);
                değişken gr: metin = reg_str(g);
                yaz_str("  "); yaz_str(gr); yaz_str(" = getelementptr %"); yaz_str(yad); yaz_str(", ptr ");
                yaz_str(base); yaz_str(", i32 0, i32 "); yaz_str(tam64_str(fidx olarak tam64)); yb(10);
                yaz_str("  store "); yaz_str(ftip); yaz_str(" "); yaz_str(v2); yaz_str(", ptr "); yaz_str(gr); yb(10);
            }
            ver 0;
        }
        // CG8b: lhs INDEKS (arr[i] = v) — heap KdlDizi yazma; dizi_yaz built-in'iyle AYNI emisyon.
        // (HEAP-uniform: her dizi KdlDizi* → kdl_dizi_yaz_* route; sınır kontrolü runtime'da.)
        eğer metin_esit(dizi_al(p.a_ad, lhs), "INDEKS") {
            değişken lcb: tam32 = dizi_al(p.a_cb, lhs);
            değişken taban: metin = ifade_uret(p, dizi_al(p.cocuk, lcb));       // dizi → ptr
            değişken iy2: metin = ifade_uret(p, dizi_al(p.cocuk, lcb + 1));     // indeks → i32
            değişken vy2: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));      // değer
            değişken vty2: metin = p.son_tip;                                  // değer LLVM tipi
            yaz_str("  call void @kdl_dizi_yaz_"); yaz_str(dizi_ekle_sonek(vty2)); yaz_str("(ptr ");
            yaz_str(taban); yaz_str(", i32 "); yaz_str(iy2); yaz_str(", "); yaz_str(dizi_arg_tip(vty2));
            yaz_str(" "); yaz_str(vy2); yaz_str(")"); yb(10);
            ver 0;
        }
        // D-249 (GAP-2 parite, C llvm.c D-248 aynası): *p = v — ham pointer deref-write.
        // güvensiz-only (checker); pointer'ı üret + değeri üret + store VOLATILE.
        eğer metin_esit(dizi_al(p.a_ad, lhs), "TEKLI") ve metin_esit(dizi_al(p.a_deg, lhs), "deref*") {
            değişken pcb: tam32 = dizi_al(p.a_cb, lhs);
            değişken pr: metin = ifade_uret(p, dizi_al(p.cocuk, pcb));    // pointer → ptr
            değişken v3: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1)); // değer
            değişken vt3: metin = p.son_tip;                             // değer LLVM tipi
            yaz_str("  store volatile "); yaz_str(vt3); yaz_str(" "); yaz_str(v3);
            yaz_str(", ptr "); yaz_str(pr); yb(10);
            ver 0;
        }
        ver 0;
    }
    eğer metin_esit(ad, "IFADE_DEYIMI") {
        ifade_uret(p, dizi_al(p.cocuk, dizi_al(p.a_cb, idx)));   // yan etki için değerlendir
        ver 0;
    }
    ver 0;   // CG3 dışı deyim → CG4+ (eğer/iken/...)
}

// İşlev → define i32 @ad() { ... }. CG1: parametresiz; gövde = BLOK çocuğu.
// CG9: hoist-edilen DEGISKEN düğümünün entry-alloca reg'i ("" = hoist edilmedi).
işlev pa_reg_bul(p: &değişken Ayr, node: tam32) -> metin {
    değişken i: tam32 = dizi_boyut(p.pa_node) - 1;
    iken i >= p.pa_base {
        eğer dizi_al(p.pa_node, i) == node { ver dizi_al(p.pa_reg, i); }
        i = i - 1;
    }
    ver "";
}
// CG9: alloca-hoist ön-pass — işlev gövdesindeki TÜM annotasyonlu DEGISKEN alloca'larını
// entry bloğuna çıkar (döngü-içi alloca → yığın taşması önlenir; C codegen D-041 ile aynı amaç).
işlev alloca_hoist_pass(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken ad: metin = dizi_al(p.a_ad, idx);
    eğer metin_esit(ad, "DEGISKEN") {
        değişken cs: tam32 = dizi_al(p.a_cs, idx);
        eğer cs >= 2 {   // annotasyonlu → hoist
            değişken tip: metin = ll_tip(p, dizi_al(p.cocuk, dizi_al(p.a_cb, idx)));
            değişken r: tam32 = yeni_reg(p);
            değişken rs: metin = reg_str(r);
            yaz_str("  "); yaz_str(rs); yaz_str(" = alloca "); yaz_str(tip); yb(10);
            dizi_ekle(p.pa_node, idx);
            dizi_ekle(p.pa_reg, rs);
        }
        ver 0;   // değer alt-ifadesinde DEGISKEN olmaz
    }
    // konteyner deyimler: çocuklara in (BLOK/EGER/IKEN gövdeleri + GUVENSIZ tek çocuğu BLOK)
    eğer metin_esit(ad, "BLOK") veya metin_esit(ad, "EGER") veya metin_esit(ad, "IKEN") veya metin_esit(ad, "GUVENSIZ") {
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken cs2: tam32 = dizi_al(p.a_cs, idx);
        değişken i: tam32 = 0;
        iken i < cs2 { alloca_hoist_pass(p, dizi_al(p.cocuk, cb + i)); i = i + 1; }
    }
    ver 0;
}
// CG6: PARAMETRE'nin LLVM tipi (çocuk[0]=tip; kendin/tipsiz → i32).
işlev param_tip(p: &değişken Ayr, c: tam32) -> metin {
    eğer dizi_al(p.a_cs, c) > 0 { ver ll_tip(p, dizi_al(p.cocuk, dizi_al(p.a_cb, c))); }
    // B2: childless `kendin` param → aktif uygula bloğunun hedef yapı tipi (by-value
    // receiver, C llvm.c:5881 + tip_kontrol.c:5122 aynası). uygula_hedef "" ise i32.
    eğer metin_esit(dizi_al(p.a_deg, c), "kendin") {
        eğer metin_esit(p.uygula_hedef, "") == yanlış { ver p.uygula_hedef; }
    }
    ver "i32";
}
// CG8: PARAMETRE Dizi<T> ise eleman tipi; &Dizi<T> ise referans-hedefinin
// eleman tipi (D-086: param girişte deref → normal heap dizi gibi indekslenir);
// değilse "".
işlev param_elem(p: &değişken Ayr, c: tam32) -> metin {
    eğer dizi_al(p.a_cs, c) == 0 { ver ""; }
    değişken tn: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, c));   // tip düğümü
    // D-086: &Dizi<T> → iç TIP_DIZI'nin eleman tipini al (deref sonrası KdlDizi*).
    eğer metin_esit(dizi_al(p.a_ad, tn), "TIP_REFERANS") {
        ver ll_eleman_tip(p, dizi_al(p.cocuk, dizi_al(p.a_cb, tn)));
    }
    ver ll_eleman_tip(p, tn);
}
// CG7c: PARAMETRE &Yapi ise işaret edilen yapı adı; değilse "".
işlev param_ref_yapi(p: &değişken Ayr, c: tam32) -> metin {
    eğer dizi_al(p.a_cs, c) == 0 { ver ""; }
    değişken tn: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, c));   // tip düğümü
    eğer metin_esit(dizi_al(p.a_ad, tn), "TIP_REFERANS") == yanlış { ver ""; }
    değişken ic: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, tn));  // iç tip
    eğer metin_esit(dizi_al(p.a_ad, ic), "TIP_BASIT") == yanlış { ver ""; }
    değişken nm: metin = dizi_al(p.a_deg, ic);
    eğer yapi_var_mi(p, nm) { ver nm; }
    ver "";
}
// D-267: PARAMETRE *tamN (skaler pointer) ise pointee LLVM tipi ("i8"/"i16"/"i64");
// değilse "". deref-read yük-genişliği için (C llvm.c:5494 pointee_ir_al aynası).
işlev param_pointee(p: &değişken Ayr, c: tam32) -> metin {
    eğer dizi_al(p.a_cs, c) == 0 { ver ""; }
    değişken tn: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, c));   // tip düğümü
    eğer metin_esit(dizi_al(p.a_ad, tn), "TIP_POINTER") == yanlış { ver ""; }
    ver ll_tip(p, dizi_al(p.cocuk, dizi_al(p.a_cb, tn)));        // pointee tipi
}
// D-299: çağrı argümanı bir TANIMLAYICI ise, o değişkenin bildirilen görev<T>/
// kanal<T> iç tipini döner. Değilse "" → çağıran i64'e (tam genişlik) düşer,
// yani KIRPMA olmaz. C llvm.c'deki `gi->gorev_ic_ir` aramasının aynası.
işlev cagri_ic_tip(p: &değişken Ayr, argidx: tam32) -> metin {
    eğer metin_esit(dizi_al(p.a_ad, argidx), "TANIMLAYICI") {
        ver cg_var_ic_bul(p, dizi_al(p.a_deg, argidx));
    }
    ver "";
}
// D-299: `deg` (tipi `dt`) değerini i64 taşıyıcıya genişlet.
// ptr → ptrtoint, i64 → aynen, dar tamsayı → sext (alım tarafı trunc ettiği için
// dtamN'de de bit deseni korunur).
işlev i64_genislet(p: &değişken Ayr, deg: metin, dt: metin) -> metin {
    eğer metin_esit(dt, "i64") { ver deg; }
    değişken r: tam32 = yeni_reg(p);
    değişken rs: metin = reg_str(r);
    eğer metin_esit(dt, "ptr") {
        yaz_str("  "); yaz_str(rs); yaz_str(" = ptrtoint ptr "); yaz_str(deg);
        yaz_str(" to i64"); yb(10);
        ver rs;
    }
    // IMMEDIATE (register değil, yani '%' ile başlamıyor) → TAM GENİŞLİKTE
    // materyalize et. Self-host TAM literalini daima "i32" sayar ve ham rakam
    // dizisi döndürür; `kanal<tam64>`de 2^33 gibi bir literal `sext i32 <lit>`
    // ile SESSİZCE bozulurdu (ölçüldü: exit 1, doğrusu 42 — C `add i64 0, <lit>`
    // üretiyor). Küçük literaller için de bu dönüşüm değer-eşdeğerdir.
    eğer bayt(deg, 0) != 37 {   // 37 = '%'
        yaz_str("  "); yaz_str(rs); yaz_str(" = add i64 0, "); yaz_str(deg); yb(10);
        ver rs;
    }
    yaz_str("  "); yaz_str(rs); yaz_str(" = sext "); yaz_str(dt); yaz_str(" ");
    yaz_str(deg); yaz_str(" to i64"); yb(10);
    ver rs;
}
// D-299: `@fn(ptr h)` çağrısını i64 dönüşle yap ve sonucu `t`ye daralt.
// t=="" → i64 bırak (KIRPMA YOK — bilinmeyen T'de tam genişlik güvenlidir;
// C'deki `beklenen ? beklenen : "i64"` son çaresinin aynası, D-295 bloker onarımı).
işlev i64_daralt(p: &değişken Ayr, fn: metin, h: metin, t: metin) -> metin {
    değişken r64: tam32 = yeni_reg(p);
    değişken r64s: metin = reg_str(r64);
    yaz_str("  "); yaz_str(r64s); yaz_str(" = call i64 @"); yaz_str(fn);
    yaz_str("(ptr "); yaz_str(h); yaz_str(")"); yb(10);
    p.son_elem = ""; p.son_ref = "";
    eğer metin_esit(t, "") veya metin_esit(t, "i64") { p.son_tip = "i64"; ver r64s; }
    eğer metin_esit(t, "void") {   // görev<boş>: sonuç yok → yer tutucu
        değişken rv: tam32 = yeni_reg(p);
        değişken rvs: metin = reg_str(rv);
        yaz_str("  "); yaz_str(rvs); yaz_str(" = add i32 0, 0"); yb(10);
        p.son_tip = "i32"; ver rvs;
    }
    değişken rn: tam32 = yeni_reg(p);
    değişken rns: metin = reg_str(rn);
    eğer metin_esit(t, "ptr") {
        yaz_str("  "); yaz_str(rns); yaz_str(" = inttoptr i64 "); yaz_str(r64s);
        yaz_str(" to ptr"); yb(10);
    }
    değilse {
        // i1/i8/i16/i32 → trunc. i32 dönen gövdenin üst 32 biti ÇÖP olduğu için
        // bu daraltma ŞART (kozmetik değil).
        yaz_str("  "); yaz_str(rns); yaz_str(" = trunc i64 "); yaz_str(r64s);
        yaz_str(" to "); yaz_str(t); yb(10);
    }
    p.son_tip = t;
    ver rns;
}
// D-299: `görev<T>` / `kanal<T>` tipli PARAMETRE → T'nin LLVM tipi ("" değilse).
// `işlev uretici(k: kanal<tam32>)` gibi imzalarda T'nin tek kaynağı budur.
işlev param_ic(p: &değişken Ayr, c: tam32) -> metin {
    eğer dizi_al(p.a_cs, c) == 0 { ver ""; }
    ver ll_ic_tip(p, dizi_al(p.cocuk, dizi_al(p.a_cb, c)));      // tip düğümü
}

// ===== D-300: lifted-lambda (görev_başlat closure) yardımcıları =====
// Lambda PARAMETRE'si mi? (capture'dan dışla). C capture_param_mi aynası.
işlev lam_param_mi(p: &değişken Ayr, lam: tam32, ad: metin) -> mantıksal {
    değişken cb: tam32 = dizi_al(p.a_cb, lam);
    değişken cs: tam32 = dizi_al(p.a_cs, lam);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "PARAMETRE") {
            eğer metin_esit(dizi_al(p.a_deg, c), ad) { ver doğru; }
        }
        i = i + 1;
    }
    ver yanlış;
}
// Bu lambda'nın [base, dizi_boyut) capture diliminde `ad` var mı? (dedup).
işlev lam_cap_dedup(p: &değişken Ayr, base: tam32, ad: metin) -> mantıksal {
    değişken n: tam32 = dizi_boyut(p.lam_capisim);
    değişken i: tam32 = base;
    iken i < n {
        eğer metin_esit(dizi_al(p.lam_capisim, i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// Lambda gövdesindeki SERBEST değişkenleri lam_capisim/ir'e ekle (C lambda_serbest_tara
// aynası). TANIMLAYICI + çevre-lokal/param (cg_var_bul != "") + lambda-param DEĞİL →
// capture. İç LAMBDA'ya GİRME. `base` = bu lambda'nın capture dilim başı (dedup için).
işlev lam_cap_tara(p: &değişken Ayr, node: tam32, lam: tam32, base: tam32) -> tam32 {
    eğer node < 0 { ver 0; }
    değişken t: metin = dizi_al(p.a_ad, node);
    eğer metin_esit(t, "TANIMLAYICI") {
        değişken ad: metin = dizi_al(p.a_deg, node);
        eğer lam_param_mi(p, lam, ad) { ver 0; }
        eğer lam_cap_dedup(p, base, ad) { ver 0; }
        değişken vt: metin = cg_var_bul(p, ad);      // çevre lokal/param mı?
        eğer metin_esit(vt, "") { ver 0; }           // global/fn/bilinmez → capture değil
        dizi_ekle(p.lam_capisim, ad);
        dizi_ekle(p.lam_capir, cg_var_tip_bul(p, ad));
        ver 0;
    }
    eğer metin_esit(t, "LAMBDA") { ver 0; }          // iç lambda'ya girme
    değişken cb: tam32 = dizi_al(p.a_cb, node);
    değişken cs: tam32 = dizi_al(p.a_cs, node);
    değişken i: tam32 = 0;
    iken i < cs {
        lam_cap_tara(p, dizi_al(p.cocuk, cb + i), lam, base);
        i = i + 1;
    }
    ver 0;
}
// Capture IR dilimi [base, base+cnt) → env struct tipi "{ ir0, ir1, ... }".
işlev lam_envtip(p: &değişken Ayr, base: tam32, cnt: tam32) -> metin {
    değişken r: metin = "{ ";
    değişken i: tam32 = 0;
    iken i < cnt {
        eğer i > 0 { r = metin_birlestir(r, ", "); }
        r = metin_birlestir(r, dizi_al(p.lam_capir, base + i));
        i = i + 1;
    }
    ver metin_birlestir(r, " }");
}
// ============================================================================
// V2-F4.2b — KESİN-YEREL (confined) KANITI: POZİTİF, default-deny local-proof.
// C-tarafı src/escape.c (ky_confined / ky_dizi_builtin_confined / kesin_yerel)
// AYNASI — self-host indeks-tabanlı düz düğüm tablosuna uyarlandı. Escape DFA'ya
// GÜVENMEZ; bir diziyi ρ_yerel'de serbest etmeden ÖNCE yerelliğini KANITLA.
// Bir dizi-değişken "confined" SADECE govdedeki HER kullanımı şunlardan biriyse:
//   - var[i] okuma (INDEKS, nesne=var),
//   - var[i] = ... yerinde yazma (ATAMA hedef=INDEKS(var)),
//   - retain-ETMEYEN dizi-builtin'in İLK argümanı (dizi_al/boyut/yaz/ekle/kapasite).
// Başka HER konum (ver, b=var alias, [..,var,..]/yapı alanı, çağrı-argı,
// lambda-yakalama, &var, var=... yeniden-atama) → DENY (ρ_caller). Sound.
// ============================================================================

// Düğüm TANIMLAYICI ve adı `ad` mı?
işlev ky_ad_esit(p: &değişken Ayr, node: tam32, ad: metin) -> mantıksal {
    eğer node < 0 { ver yanlış; }
    eğer metin_esit(dizi_al(p.a_ad, node), "TANIMLAYICI") == yanlış { ver yanlış; }
    ver metin_esit(dizi_al(p.a_deg, node), ad);
}

// Diziyi RETAIN ETMEYEN (yalnız oku/yerinde-değiştir) builtin'ler.
işlev ky_dizi_builtin_confined(ad: metin) -> mantıksal {
    ver metin_esit(ad, "dizi_al") veya metin_esit(ad, "dizi_boyut")
        veya metin_esit(ad, "dizi_yaz") veya metin_esit(ad, "dizi_ekle")
        veya metin_esit(ad, "dizi_kapasite");
}

// `ad` alt-ağaçta HERHANGİ bir yerde TANIMLAYICI olarak geçiyor mu? (lambda-yakalama için)
işlev ky_var_gecer(p: &değişken Ayr, node: tam32, ad: metin) -> mantıksal {
    eğer node < 0 { ver yanlış; }
    eğer ky_ad_esit(p, node, ad) { ver doğru; }
    değişken cb: tam32 = dizi_al(p.a_cb, node);
    değişken cs: tam32 = dizi_al(p.a_cs, node);
    değişken i: tam32 = 0;
    iken i < cs {
        eğer ky_var_gecer(p, dizi_al(p.cocuk, cb + i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}

// `ad`in govdedeki TÜM kullanımları confined mi? Bare var (parent tüketmediyse) = yanlış.
işlev ky_confined(p: &değişken Ayr, node: tam32, ad: metin) -> mantıksal {
    eğer node < 0 { ver doğru; }
    değişken t: metin = dizi_al(p.a_ad, node);
    değişken cb: tam32 = dizi_al(p.a_cb, node);
    değişken cs: tam32 = dizi_al(p.a_cs, node);
    // bare var = güvensiz (parent INDEKS/dizi-builtin tüketmediyse buraya düşer)
    eğer metin_esit(t, "TANIMLAYICI") {
        eğer metin_esit(dizi_al(p.a_deg, node), ad) { ver yanlış; }
        ver doğru;
    }
    // INDEKS: var[i] okuma OK (indeks alt-ifadesi de confined olmalı)
    eğer metin_esit(t, "INDEKS") {
        değişken nesne: tam32 = dizi_al(p.cocuk, cb);
        değişken indeks: tam32 = dizi_al(p.cocuk, cb + 1);
        eğer ky_ad_esit(p, nesne, ad) { ver ky_confined(p, indeks, ad); }
        ver ky_confined(p, nesne, ad) ve ky_confined(p, indeks, ad);
    }
    // ATAMA: var[i] = rhs yerinde yazma OK; var = ... yeniden-atama güvensiz
    eğer metin_esit(t, "ATAMA") {
        değişken hedef: tam32 = dizi_al(p.cocuk, cb);
        değişken deger: tam32 = dizi_al(p.cocuk, cb + 1);
        eğer metin_esit(dizi_al(p.a_ad, hedef), "INDEKS") {
            değişken hnesne: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, hedef));
            eğer ky_ad_esit(p, hnesne, ad) {
                değişken hindeks: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, hedef) + 1);
                ver ky_confined(p, hindeks, ad) ve ky_confined(p, deger, ad);
            }
        }
        eğer ky_ad_esit(p, hedef, ad) { ver yanlış; }   // var = ... yeniden-atama
        ver ky_confined(p, hedef, ad) ve ky_confined(p, deger, ad);
    }
    // CAGRI: dizi_*(var, ...) ilk-arg tüketilir; callee=child0, arg0=child1.
    eğer metin_esit(t, "CAGRI") {
        değişken callee: tam32 = dizi_al(p.cocuk, cb);
        değişken safe0: mantıksal = yanlış;
        eğer metin_esit(dizi_al(p.a_ad, callee), "TANIMLAYICI") {
            eğer ky_dizi_builtin_confined(dizi_al(p.a_deg, callee)) {
                eğer cs >= 2 {
                    eğer ky_ad_esit(p, dizi_al(p.cocuk, cb + 1), ad) { safe0 = doğru; }
                }
            }
        }
        eğer ky_confined(p, callee, ad) == yanlış { ver yanlış; }
        değişken i: tam32 = 1;
        iken i < cs {
            eğer i == 1 ve safe0 {
                // dizi_*(var, ...) ilk arg tüketildi — atla
            } değilse {
                eğer ky_confined(p, dizi_al(p.cocuk, cb + i), ad) == yanlış { ver yanlış; }
            }
            i = i + 1;
        }
        ver doğru;
    }
    // LAMBDA: govdesi var'ı yakalıyorsa güvensiz.
    eğer metin_esit(t, "LAMBDA") {
        eğer ky_var_gecer(p, node, ad) { ver yanlış; }
        ver doğru;
    }
    // Diğer HER düğüm: tüm çocuklar confined olmalı. TEKLI &var / VER var / b=var /
    // [..,var,..] / {f:var} → çocuk bare-var TANIMLAYICI'ya iner → DENY (sound).
    değişken j: tam32 = 0;
    iken j < cs {
        eğer ky_confined(p, dizi_al(p.cocuk, cb + j), ad) == yanlış { ver yanlış; }
        j = j + 1;
    }
    ver doğru;
}

// Gövdeyi gez: her `değişken V: Dizi<...> = [literal]` için V confined ise literal
// DIZI_OLUSTUR düğümünü ky_node'a işaretle. LAMBDA görülürse fn-routing GUARD'ı aç.
işlev ky_isaretle(p: &değişken Ayr, node: tam32, govde: tam32, dongu_d: tam32) -> tam32 {
    eğer node < 0 { ver 0; }
    değişken t: metin = dizi_al(p.a_ad, node);
    eğer metin_esit(t, "LAMBDA") { p.ky_lambda = 1; }
    eğer metin_esit(t, "DEGISKEN") {
        değişken cs: tam32 = dizi_al(p.a_cs, node);
        eğer cs >= 2 {
            değişken cb: tam32 = dizi_al(p.a_cb, node);
            değişken annot: tam32 = dizi_al(p.cocuk, cb);
            değişken deger: tam32 = dizi_al(p.cocuk, cb + cs - 1);
            eğer metin_esit(dizi_al(p.a_ad, annot), "TIP_DIZI") {
                eğer metin_esit(dizi_al(p.a_ad, deger), "DIZI_OLUSTUR") {
                    eğer ky_confined(p, govde, dizi_al(p.a_deg, node)) {
                        dizi_ekle(p.ky_node, deger);
                        // F4.3 a1: bildirim döngü-gövdesinde (dongu_d>=1) ise iterasyon-confined.
                        // ky_confined kaçışı zaten reddeder (no-escape); döngü-gövde-bildirimi →
                        // her iterasyon TAZE binding → loop-carry imkânsız. IR-NÖTR: yalnız işaretle.
                        eğer dongu_d >= 1 { dizi_ekle(p.ky_iter_node, deger); }
                    }
                }
            }
        }
    }
    // Çocuklara recurse. IKEN/ICIN alt-ağacı → loop-depth+1 (`değişken X=[...]` bildirimi
    // yalnız gövde-BLOK'ta olur → tüm IKEN/ICIN alt-ağacına +1 = gövde-scope ile eşdeğer).
    değişken alt_d: tam32 = dongu_d;
    eğer metin_esit(t, "IKEN") veya metin_esit(t, "ICIN") { alt_d = dongu_d + 1; }
    değişken cb2: tam32 = dizi_al(p.a_cb, node);
    değişken cs2: tam32 = dizi_al(p.a_cs, node);
    değişken i: tam32 = 0;
    iken i < cs2 { ky_isaretle(p, dizi_al(p.cocuk, cb2 + i), govde, alt_d); i = i + 1; }
    ver 0;
}

// V2-F4.2b (b3): dizi-tahsis düğümü kesin-yerel (confined) işaretli mi? (ky_node fn-dilim taraması)
işlev ky_kesin_yerel(p: &değişken Ayr, node: tam32) -> mantıksal {
    değişken n: tam32 = dizi_boyut(p.ky_node);
    değişken i: tam32 = p.ky_base;
    iken i < n {
        eğer dizi_al(p.ky_node, i) == node { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// F4.3: dizi-tahsis düğümü iterasyon-confined işaretli mi? (ky_iter_node fn-dilim taraması)
işlev ky_iter_kesin(p: &değişken Ayr, node: tam32) -> mantıksal {
    değişken n: tam32 = dizi_boyut(p.ky_iter_node);
    değişken i: tam32 = p.ky_iter_base;
    iken i < n {
        eğer dizi_al(p.ky_iter_node, i) == node { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}

// V2-F4.2b (b3): dizi-tahsis düğümü `idx` için ρ seç. ρ_yerel'e (ret'te serbest) SADECE:
// kesin-yerel (confined) işaretli VE SKALER-eleman (ne "ptr" ne "%struct") VE fn'de
// lambda-guard yok VE ρ_yerel mevcut. Aksi → rho_ref (ρ_caller, serbest EDİLMEZ).
// C-tarafı src/llvm.c bolge_yerel_yonlendir AYNASI: POZİTİF ky_confined + skaler-eleman
// (ptr/struct eleman → iç heap-ref dizi_al ile kaçabilir → ρ_caller). DAR tut = sound.
işlev bolge_yerel_yonlendir(p: &değişken Ayr, idx: tam32, elem: metin) -> metin {
    eğer p.ky_lambda == 1 { ver p.rho_ref; }            // closure-capture sound backstop
    // SKALER-eleman (ρ_iter + ρ_yerel ortak ön-koşul): ptr/struct eleman → iç-ptr
    // dizi_al ile kaçabilir → ρ_caller (serbest edilmez).
    eğer metin_esit(elem, "ptr") { ver p.rho_ref; }
    eğer bayt(elem, 0) == 37 { ver p.rho_ref; }         // '%' = struct-eleman
    // F4.3 a3: iterasyon-confined (ky_confined ∧ döngü-gövde-bildirimi) + en-dış ρ_iter
    // mevcut → ρ_iter (HER İTERASYONDA serbest). no-escape ∧ no-loop-carry → SOUND.
    // OS kernel-loop'unu bunun için yaşatır (sonsuz döngüde per-iter free = sınırlı bellek).
    eğer metin_esit(p.rho_iter, "") == yanlış {
        eğer ky_iter_kesin(p, idx) { ver p.rho_iter; }
    }
    // F4.2b: kesin-yerel + ρ_yerel mevcut → ρ_yerel (fn-dönüşünde serbest); aksi → ρ_caller.
    eğer metin_esit(p.rho_yerel, "") { ver p.rho_ref; } // ρ_yerel yok
    eğer ky_kesin_yerel(p, idx) == yanlış { ver p.rho_ref; }  // confined kanıtı yok
    ver p.rho_yerel;
}

// F4.3 a2: ρ_iter'i serbest bırak — HER gövde-çıkışında (back-edge + ver). Boş ("") → no-op.
işlev rho_iter_serbest_emit(p: &değişken Ayr) -> tam32 {
    eğer metin_esit(p.rho_iter, "") == yanlış {
        yaz_str("  call void @kdl_bolge_serbest(ptr "); yaz_str(p.rho_iter); yaz_str(")"); yb(10);
    }
    ver 0;
}
// V2-F4.2b (b2): ρ_yerel'i serbest bırak — HER ret'ten ÖNCE çağrılır (R4: dönüş değeri
// zaten materyalize/ρ_caller'da). Boş ρ_yerel ("") → no-op. C-tarafı rho_yerel_serbest_emit aynası.
işlev rho_yerel_serbest_emit(p: &değişken Ayr) -> tam32 {
    eğer metin_esit(p.rho_yerel, "") == yanlış {
        yaz_str("  call void @kdl_bolge_serbest(ptr "); yaz_str(p.rho_yerel); yaz_str(")"); yb(10);
    }
    ver 0;
}

// D-086: PARAMETRE &Dizi<T> / &değişken Dizi<T> mi? (TIP_REFERANS → TIP_DIZI).
// Çağıran dizi değişkeninin SLOT adresini (KdlDizi**) geçer; girişte BİR KEZ
// deref edilip alloca KdlDizi* tutar → dizi_al/dizi_boyut/dizi_yaz/[] ek deref
// gerektirmez (C llvm.c:5341 `dizi_ref` ile birebir).
işlev param_dizi_ref_mi(p: &değişken Ayr, c: tam32) -> mantıksal {
    eğer dizi_al(p.a_cs, c) == 0 { ver yanlış; }
    değişken tn: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, c));   // tip düğümü
    eğer metin_esit(dizi_al(p.a_ad, tn), "TIP_REFERANS") == yanlış { ver yanlış; }
    değişken ic: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, tn));  // iç tip
    ver metin_esit(dizi_al(p.a_ad, ic), "TIP_DIZI");
}
// D-255: idx çıplak işlev mi? (g_ciplak listesi). Çıplak → region-prologue SKIP.
işlev ciplak_mi(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken n: tam32 = dizi_boyut(p.g_ciplak);
    değişken i: tam32 = 0;
    iken i < n {
        eğer dizi_al(p.g_ciplak, i) == idx { ver 1; }
        i = i + 1;
    }
    ver 0;
}
// D-258: çağrılan işlev ADIYLA çıplak mı? (g_ciplak node'larının a_deg adları).
// Çağrı yerinde yalnız callee adı bilinir → çıplak-callee'ye ρ geçme (C-ABI).
işlev fn_ciplak_ad_mi(p: &değişken Ayr, ad: metin) -> tam32 {
    değişken n: tam32 = dizi_boyut(p.g_ciplak);
    değişken i: tam32 = 0;
    iken i < n {
        değişken idx: tam32 = dizi_al(p.g_ciplak, i);
        eğer metin_esit(dizi_al(p.a_deg, idx), ad) { ver 1; }
        i = i + 1;
    }
    ver 0;
}
// D-300: kuyruğa alınan bir lifted-lambda'yı top-level `define` olarak emit et.
// görev_başlat closure'ı: `işlev() -> T` (DRF001 → SIFIR param). ρ ilk param
// (%rho), varsa env ikinci (%env). Env'den capture'lar alloca'ya yüklenir → gövde
// isimle erişir. Dönüş = gövdenin doğal tipi (runtime i64 okur, görev_birleştir
// daraltır). C lambda_emit aynası — ama self-host doğrudan-stdout olduğu için
// gövde-sonrası (kuyruk) emit edilir, C'nin tmpfile+hoist_renumber'ı yerine.
işlev lam_emit(p: &değişken Ayr, qi: tam32) -> tam32 {
    değişken lam: tam32 = dizi_al(p.lam_node, qi);
    değişken mad: metin = dizi_al(p.lam_ad, qi);
    değişken capbase: tam32 = dizi_al(p.lam_capbase, qi);
    değişken capcnt: tam32 = dizi_al(p.lam_capcount, qi);
    değişken has_env: tam32 = 0;
    eğer capcnt > 0 { has_env = 1; }
    p.reg = 0;
    p.lbl = 0;
    p.bb_term = 0;
    p.rho_iter = "";
    p.dongu_d = 0;
    p.rho_yerel = "";           // lambda ρ_yerel ALMAZ (C paritesi)
    p.rho_ref = "%rho";         // ρ dispatch tarafından geçilir
    p.cg_base = dizi_boyut(p.cg_ad);
    p.pa_base = dizi_boyut(p.pa_node);
    // Gövde = SON çocuk; dönüş tipi ÖN-BELİRLENEMEZ (gövde emit edilince belli).
    // Bu yüzden gövdeyi geçici çıkarsamak yerine: ifade-form'da emit → son_tip;
    // C ile aynı v1 sınırı — dönüş IR'ı önden bilinemediği için imza gövdeden
    // SONRA yazılamaz (doğrudan-stdout). Çözüm: expr-form gövdeyi "i64" beklenen
    // yerine DOĞAL üret; imzayı i64 aç ve gövde sonucunu i64'e genişletip ret et.
    // Böylece runtime KdlGorevBare (int64_t) ile ABI-uyumlu, imza-önden-yazma
    // gövde-tip-bilme sorununu çözer (C'nin iki-tampon numarasına gerek kalmaz).
    değişken lcb: tam32 = dizi_al(p.a_cb, lam);
    değişken lcs: tam32 = dizi_al(p.a_cs, lam);
    değişken govde: tam32 = dizi_al(p.cocuk, lcb + lcs - 1);
    // İmza: i64 dönüş (runtime taşıyıcısı), ρ + opsiyonel env.
    yaz_str("define i64 @"); yaz_str(mad); yaz_str("(ptr %rho");
    eğer has_env == 1 { yaz_str(", ptr %env"); }
    yaz_str(") {"); yb(10);
    yaz_str("entry:"); yb(10);
    // Capture'ları env'den yükle → alloca → cg_var kaydı.
    değişken ci: tam32 = 0;
    iken ci < capcnt {
        değişken cad: metin = dizi_al(p.lam_capisim, capbase + ci);
        değişken cir: metin = dizi_al(p.lam_capir, capbase + ci);
        değişken et: metin = lam_envtip(p, capbase, capcnt);
        değişken gp: tam32 = yeni_reg(p);
        yaz_str("  "); yaz_str(reg_str(gp)); yaz_str(" = getelementptr "); yaz_str(et);
        yaz_str(", ptr %env, i32 0, i32 "); yaz_str(tam64_str(ci olarak tam64)); yb(10);
        değişken lv: tam32 = yeni_reg(p);
        yaz_str("  "); yaz_str(reg_str(lv)); yaz_str(" = load "); yaz_str(cir);
        yaz_str(", ptr "); yaz_str(reg_str(gp)); yb(10);
        değişken al: tam32 = yeni_reg(p);
        yaz_str("  "); yaz_str(reg_str(al)); yaz_str(" = alloca "); yaz_str(cir); yb(10);
        yaz_str("  store "); yaz_str(cir); yaz_str(" "); yaz_str(reg_str(lv));
        yaz_str(", ptr "); yaz_str(reg_str(al)); yb(10);
        cg_var_ekle(p, cad, reg_str(al), cir, "", "");
        ci = ci + 1;
    }
    // Gövde: ifade-form (v1). Değeri i64'e genişletip ret.
    eğer metin_esit(dizi_al(p.a_ad, govde), "BLOK") {
        // Blok-form gövde: v1'de son-ver çıkarsaması yok — güvenli fallback
        // olarak boş i64 dön (C ile aynı sınır; DRF001 zaten expr-form garanti
        // etmez ama korpus expr-form kullanır).
        yaz_str("  ret i64 0"); yb(10);
    } değilse {
        değişken bv: metin = ifade_uret(p, govde);
        değişken b64: metin = i64_genislet(p, bv, p.son_tip);
        yaz_str("  ret i64 "); yaz_str(b64); yb(10);
    }
    yaz_str("}"); yb(10); yb(10);
    ver 0;
}
// D-300: tüm kuyruğa alınmış lifted-lambda'ları emit et (emit_tanimlar SONRASI).
işlev lam_kuyruk_emit(p: &değişken Ayr) -> tam32 {
    değişken n: tam32 = dizi_boyut(p.lam_node);
    değişken i: tam32 = 0;
    iken i < n {
        lam_emit(p, i);
        i = i + 1;
    }
    ver 0;
}
işlev islev_uret(p: &değişken Ayr, idx: tam32) -> tam32 {
    p.reg = 0;
    p.lbl = 0;
    p.rho_iter = "";   // F4.3: fn başında döngü-dışı
    p.dongu_d = 0;
    p.cg_base = dizi_boyut(p.cg_ad);   // CG3: bu işlevin değişken-slice'ı buradan başlar
    p.pa_base = dizi_boyut(p.pa_node); // CG9: hoist-alloca slice'ı
    p.cur_ret = islev_donus_tip(p, idx);   // CG6: dönüş tipi (ver için)
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken cs: tam32 = dizi_al(p.a_cs, idx);
    // V2-F4.2a: region-passing ABI. main HARİÇ her fonksiyon ilk param `ptr %rho`.
    // D-258 çıplak: true C-ABI → ρ param HİÇ almaz (main gibi). rho_var = bu fn ρ alır mı.
    değişken main_mi: tam32 = 0;
    eğer metin_esit(dizi_al(p.a_deg, idx), "main") { main_mi = 1; }
    değişken ciplak: tam32 = ciplak_mi(p, idx);
    değişken rho_var: tam32 = 1;
    eğer main_mi == 1 { rho_var = 0; }
    eğer ciplak == 1 { rho_var = 0; }
    // 1) İmza: adlı parametreler (%a0, %a1...) — adlı olduğundan %N reg sayacını tüketmez.
    yaz_str("define "); yaz_str(p.cur_ret); yaz_str(" @"); ir_ad_yaz(dizi_al(p.a_deg, idx)); yaz_str("(");
    eğer rho_var == 1 { yaz_str("ptr %rho"); }   // V2-F4.2a: ρ ilk param (çıplak/main hariç)
    değişken pn: tam32 = 0;
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "PARAMETRE") {
            eğer pn > 0 veya rho_var == 1 { yaz_str(", "); }   // ρ'dan sonra virgül
            yaz_str(param_tip(p, c)); yaz_str(" %a"); yaz_str(tam64_str(pn olarak tam64));
            pn = pn + 1;
        }
        i = i + 1;
    }
    yaz_str(") {"); yb(10);
    yaz_str("entry:"); yb(10);
    p.bb_term = 0;   // entry taze blok
    // 2) Parametreler: alloca + store %aN + ad→reg kaydı (CG3 yerel deseni; mutable param)
    değişken pj: tam32 = 0;
    i = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "PARAMETRE") {
            değişken pt: metin = param_tip(p, c);
            değişken a: tam32 = yeni_reg(p);
            değişken areg: metin = reg_str(a);
            yaz_str("  "); yaz_str(areg); yaz_str(" = alloca "); yaz_str(pt); yb(10);
            // D-086: &Dizi<T> param → girişte BİR KEZ deref (KdlDizi** → KdlDizi*),
            // alloca KdlDizi* tutsun (C llvm.c:5346 ile birebir). Aksi: çift-pointer
            // descriptor gibi indekslenip çöp/PANIK (ASan stack-buffer-overflow).
            eğer param_dizi_ref_mi(p, c) {
                değişken dr: tam32 = yeni_reg(p);
                değişken drs: metin = reg_str(dr);
                yaz_str("  "); yaz_str(drs); yaz_str(" = load ptr, ptr %a");
                yaz_str(tam64_str(pj olarak tam64)); yb(10);
                yaz_str("  store ptr "); yaz_str(drs); yaz_str(", ptr "); yaz_str(areg); yb(10);
            }
            değilse {
                yaz_str("  store "); yaz_str(pt); yaz_str(" %a"); yaz_str(tam64_str(pj olarak tam64));
                yaz_str(", ptr "); yaz_str(areg); yb(10);
            }
            cg_var_ekle(p, dizi_al(p.a_deg, c), areg, pt, param_ref_yapi(p, c), param_elem(p, c));
            değişken ppo: metin = param_pointee(p, c);   // D-267: skaler pointer pointee
            eğer metin_uzunluk(ppo) > 0 {
                dizi_yaz(p.cg_apointee, dizi_boyut(p.cg_apointee) - 1, ppo);
            }
            değişken pic: metin = param_ic(p, c);        // D-299: görev/kanal iç tipi
            eğer metin_uzunluk(pic) > 0 {
                dizi_yaz(p.cg_aic, dizi_boyut(p.cg_aic) - 1, pic);
            }
            pj = pj + 1;
        }
        i = i + 1;
    }
    // 3) CG9: alloca-hoist — gövdedeki tüm annotasyonlu DEGISKEN alloca'larını entry'e çıkar
    i = 0;
    iken i < cs {
        değişken hc: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, hc), "BLOK") { alloca_hoist_pass(p, hc); }
        i = i + 1;
    }
    // V2-F4.2a: ρ referansı. Normal fn → "%rho" (param). main → global bölge seed
    // (alloca-hoist'tan SONRA → seed reg, hoist-edilen alloca'lardan sonra; C llvm.c
    // ile birebir). Seed gövdeden önce gelir → kullanıcı-fn/dizi çağrıları ρ'yı kullanır.
    // D-255/D-258 çıplak işlev: region-prologue EMIT EDİLMEZ (WALL-2). D-258: ρ param
    // HİÇ alınmaz (true C-ABI, üstte rho_var=0) → rho_ref = "null" (çıplak-call-rule
    // gereği kullanılmaz; çıplak yalnız çıplak/extern çağırır). rho_yerel="" → serbest
    // no-op. C llvm.c islev_uret ρ-prologue/ρ-drop aynası.
    p.ciplak_aktif = ciplak;   // D-256: gövde-içi ρ_iter (döngü region) de bu bayrağa göre bastırılır
    eğer ciplak == 1 {
        p.rho_ref = "null";
        p.rho_yerel = "";
    } değilse {
        // V2-F4.2a: ρ referansı. Normal fn → "%rho". main → global bölge seed.
        eğer main_mi == 1 {
            değişken rr: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(rr)); yaz_str(" = call ptr @kdl_global_bolge_al()"); yb(10);
            p.rho_ref = reg_str(rr);
        } değilse {
            p.rho_ref = "%rho";
        }
        // V2-F4.2b (b2): ρ_yerel — scope-yerel bölge aç (gövdeden ÖNCE). Kaçmayan (confined)
        // diziler buraya yönlenir (b3), her ret öncesi kdl_bolge_serbest. main dahil HER fn
        // (main'in GLOBAL %rho'su serbest EDİLMEZ; ρ_yerel ayrı + serbest). C llvm.c aynası.
        değişken yr_yerel: tam32 = yeni_reg(p);
        yaz_str("  "); yaz_str(reg_str(yr_yerel)); yaz_str(" = call ptr @kdl_bolge_olustur()"); yb(10);
        p.rho_yerel = reg_str(yr_yerel);
    }
    // B4: ve/veya kısa-devre slot'u ENTRY bloğunda BİR KEZ (C hoist davranışı aynası).
    // Tüm ve/veya tekrar kullanır → döngü-içi alloca yığın taşması YOK. Kullanılmasa da
    // zararsız (entry alloca). Reuse sound: her ve/veya load'u sonraki store'dan önce
    // materyalize olur (iç-içe/ardışık ve/veya çakışmaz).
    değişken sc: tam32 = yeni_reg(p);
    yaz_str("  "); yaz_str(reg_str(sc)); yaz_str(" = alloca i32"); yb(10);
    p.sc_slot = reg_str(sc);
    // V2-F4.2b (b1): confinement ön-pass — gövdedeki confined dizi-değişken literallerini
    // ky_node'a işaretle (POZİTİF kanıt). Bu adımda EMİSYON DEĞİŞMEZ (IR-NÖTR); routing
    // (b3) ky_kesin_yerel'i okuyup ρ_yerel'e yönlendirir. ky_base = fn-bazlı dilim başı.
    p.ky_base = dizi_boyut(p.ky_node);
    p.ky_iter_base = dizi_boyut(p.ky_iter_node);   // F4.3 a1: iterasyon-confined dilim başı
    p.ky_lambda = 0;
    i = 0;
    iken i < cs {
        değişken kc: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, kc), "BLOK") { ky_isaretle(p, kc, kc, 0); }
        i = i + 1;
    }
    // 4) Gövde (BLOK çocuğu)
    i = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "BLOK") { deyim_uret(p, c); }
        i = i + 1;
    }
    eğer p.bb_term == 0 { rho_yerel_serbest_emit(p); yaz_str("  ret "); yaz_str(p.cur_ret); yaz_str(" 0"); yb(10); }   // V2-F4.2b (b2): örtük fn-sonu dönüşünden önce serbest
    yaz_str("}"); yb(10);
    ver 0;
}

// CG6: ön-pass — üst-düzey işlev imza tablosu (ad → dönüş LLVM tipi); CAGRI için.
// D3: `dışa <tanım>` → iç tanımı aç (DISA child[0]); değilse düğümün kendisi.
işlev dis_ac(p: &değişken Ayr, c: tam32) -> tam32 {
    eğer metin_esit(dizi_al(p.a_ad, c), "DISA") {
        ver dizi_al(p.cocuk, dizi_al(p.a_cb, c));
    }
    ver c;
}
işlev imza_topla(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dis_ac(p, dizi_al(p.cocuk, cb + i));   // D3: dışa-aç
        eğer metin_esit(dizi_al(p.a_ad, c), "ISLEV") {
            dizi_ekle(p.fn_ad, dizi_al(p.a_deg, c));
            dizi_ekle(p.fn_ret, islev_donus_tip(p, c));
        }
        eğer metin_esit(dizi_al(p.a_ad, c), "MODUL") { imza_topla(p, c); }  // D3: modül üyeleri (flat)
        eğer metin_esit(dizi_al(p.a_ad, c), "UYGULA") {   // B2: uygula metod imzaları (CAGRI dispatch için)
            değişken ucb: tam32 = dizi_al(p.a_cb, c);
            değişken ucs: tam32 = dizi_al(p.a_cs, c);
            değişken ui: tam32 = 0;
            iken ui < ucs {
                değişken m: tam32 = dizi_al(p.cocuk, ucb + ui);
                eğer metin_esit(dizi_al(p.a_ad, m), "ISLEV") {
                    dizi_ekle(p.fn_ad, dizi_al(p.a_deg, m));
                    dizi_ekle(p.fn_ret, islev_donus_tip(p, m));
                }
                ui = ui + 1;
            }
        }
        i = i + 1;
    }
    ver 0;
}
// Program → IR başlık + her üst-düzey ISLEV.
// D3: tanımları emit et — DISA aç + MODUL üyelerine recurse (flat) + ISLEV emit.
işlev emit_tanimlar(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dis_ac(p, dizi_al(p.cocuk, cb + i));
        eğer metin_esit(dizi_al(p.a_ad, c), "ISLEV") { islev_uret(p, c); }
        eğer metin_esit(dizi_al(p.a_ad, c), "MODUL") { emit_tanimlar(p, c); }
        eğer metin_esit(dizi_al(p.a_ad, c), "UYGULA") {   // B2: uygula metodlarını emit et
            // kids[0] = hedef yapı tipi → kendin'in by-value tipi (uygula_hedef).
            // Metod ISLEV'leri normal fn gibi emit; kendin PARAMETRE'si param_tip ile
            // %Yapi alır. C llvm.c:5870-5892 (DUGUM_UYGULA döngüsü) aynası.
            değişken ucb: tam32 = dizi_al(p.a_cb, c);
            değişken ucs: tam32 = dizi_al(p.a_cs, c);
            değişken eski_uh: metin = p.uygula_hedef;
            p.uygula_hedef = ll_tip(p, dizi_al(p.cocuk, ucb));
            değişken ui: tam32 = 0;
            iken ui < ucs {
                değişken m: tam32 = dizi_al(p.cocuk, ucb + ui);
                eğer metin_esit(dizi_al(p.a_ad, m), "ISLEV") { islev_uret(p, m); }
                ui = ui + 1;
            }
            p.uygula_hedef = eski_uh;
        }
        i = i + 1;
    }
    ver 0;
}
// D-253: küresel değişken (modül-mutable global) — C llvm.c parite.
işlev kuresel_tip_bul(p: &değişken Ayr, ad: metin) -> metin {
    değişken n: tam32 = dizi_boyut(p.g_kuresel_ad);
    değişken i: tam32 = 0;
    iken i < n {
        eğer metin_esit(dizi_al(p.g_kuresel_ad, i), ad) { ver dizi_al(p.g_kuresel_tip, i); }
        i = i + 1;
    }
    ver "";
}
işlev kuresel_init_yaz(p: &değişken Ayr, dv: tam32, ir: metin) -> tam32 {
    değişken t: metin = dizi_al(p.a_ad, dv);
    eğer metin_esit(t, "BOS") { yaz_str("null"); ver 0; }
    eğer metin_esit(t, "TAM") { yaz_str(dizi_al(p.a_deg, dv)); ver 0; }
    eğer metin_esit(t, "MANTIKSAL") { yaz_str(dizi_al(p.a_deg, dv)); ver 0; }
    eğer metin_esit(ir, "ptr") { yaz_str("null"); ver 0; }
    yaz_str("0"); ver 0;
}
// Üst-düzey KURESEL düğümlerini tara → kayıt + @ad = internal global <ir> <init>.
işlev kuresel_topla(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken u: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, u), "KURESEL") {
            değişken ad: metin = dizi_al(p.a_deg, u);
            değişken ucb: tam32 = dizi_al(p.a_cb, u);
            değişken ir: metin = ll_tip(p, dizi_al(p.cocuk, ucb));
            dizi_ekle(p.g_kuresel_ad, ad);
            dizi_ekle(p.g_kuresel_tip, ir);
            yaz_str("@"); yaz_str(ad); yaz_str(" = internal global "); yaz_str(ir); yaz_str(" ");
            kuresel_init_yaz(p, dizi_al(p.cocuk, ucb + 1), ir);
            yb(10);
        }
        i = i + 1;
    }
    ver 0;
}

işlev program_uret(p: &değişken Ayr, kok: tam32) -> tam32 {
    yapi_topla(p, kok);   // CG7b: yapı tablosu (ll_tip/imza ondan önce gerekir)
    imza_topla(p, kok);   // CG6: işlev imza tablosu (CAGRI dönüş tipi)
    yaz_str("target triple = "); yb(34); yaz_str("x86_64-pc-windows-gnu"); yb(34); yb(10); yb(10);
    yapi_tip_emit(p);        // CG7b: %Ad = type { ... }
    runtime_header_yaz(p);   // CG7: @kdl_* declare'ları
    str_pre_pass(p);         // CG7: metin literallerini topla
    str_globalleri_emit(p);  // CG7: @.str.N global sabitleri
    kuresel_topla(p, kok);   // D-253: küresel değişken module-globalleri
    yb(10);
    emit_tanimlar(p, kok);   // D3: DISA-aç + MODUL-recurse + ISLEV emit
    lam_kuyruk_emit(p);      // D-300: görev_başlat lifted-lambda'ları (gövde-sonrası)
    ver 0;
}


// ============================================================================
// AŞAMA 4 (driver) — TİP DENETLEYİCİ (checker.kem'den port; D-086).
//   --check modu çekirdeği: kontrol_program → th_kod/th_sat/th_sut hata listesi.
//   Çatışma: karsilastirma_mi (checker, yalnız sıralı <>) → sirali_kars_mi
//   (codegen'in ==/!= dahil olanıyla çakışmasın); yapi_var_mi drop (codegen'inki
//   yapi_idx ≡ checker yapi_idx_bul). checker.kem origin/main'de DEĞİŞMEMİŞ.
// ============================================================================
işlev duz_yaz(p: &değişken Ayr, idx: tam32, derinlik: tam32) -> tam32 {
    yaz_tam(derinlik);  yb(9);
    yaz_str(dizi_al(p.a_ad, idx));  yb(9);
    yaz_kacis(dizi_al(p.a_deg, idx));  yb(9);
    yaz_tam(dizi_al(p.a_sat, idx));  yb(9);
    yaz_tam(dizi_al(p.a_sut, idx));  yb(10);
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken cs: tam32 = dizi_al(p.a_cs, idx);
    değişken i: tam32 = 0;
    iken i < cs {
        duz_yaz(p, dizi_al(p.cocuk, cb + i), derinlik + 1);
        i = i + 1;
    }
    ver 0;
}

işlev g_ekle(p: &değişken Ayr, ad: metin) -> tam32 { dizi_ekle(p.g_isim, ad); ver 0; }
// 47 builtin (tip_kontrol.c EKLE_BUILTIN) + sık özel-builtin'ler.
işlev builtin_ekle(p: &değişken Ayr) -> tam32 {
    g_ekle(p, "yazdir"); g_ekle(p, "yazdir_tam"); g_ekle(p, "yazdir_tam64");
    g_ekle(p, "yazdir_satir"); g_ekle(p, "yazdir_metin"); g_ekle(p, "yazdir_karakter");
    g_ekle(p, "yazdir_isaretsiz_tam"); g_ekle(p, "yazdir_isaretsiz_tam64");
    g_ekle(p, "yazdir_onaltilik"); g_ekle(p, "yaz_tam"); g_ekle(p, "yaz_tam64");
    g_ekle(p, "yaz_bayt"); g_ekle(p, "yaz_karakter"); g_ekle(p, "yaz_onaltilik");
    g_ekle(p, "oku_karakter"); g_ekle(p, "ondalik_bicimle");
    g_ekle(p, "bellek_al"); g_ekle(p, "bellek_serbest"); g_ekle(p, "bellek_kopyala");
    g_ekle(p, "metin_uzunluk"); g_ekle(p, "metin_bayt"); g_ekle(p, "metin_esit");
    g_ekle(p, "metin_birlestir"); g_ekle(p, "metin_kes"); g_ekle(p, "metin_kirp");
    g_ekle(p, "metin_icerir"); g_ekle(p, "metin_baslar"); g_ekle(p, "metin_biter");
    g_ekle(p, "metin_kucuk"); g_ekle(p, "metin_buyuk"); g_ekle(p, "metin_kucuk_tr");
    g_ekle(p, "metin_buyuk_tr"); g_ekle(p, "metin_kucuk_ascii"); g_ekle(p, "metin_buyuk_ascii");
    g_ekle(p, "metin_yer_degistir");
    g_ekle(p, "dizi_olustur"); g_ekle(p, "dizi_ekle"); g_ekle(p, "dizi_al");
    g_ekle(p, "dizi_yaz"); g_ekle(p, "dizi_boyut"); g_ekle(p, "dizi_kapasite");
    g_ekle(p, "dizi_kapasite_ayarla");
    g_ekle(p, "arg_sayi"); g_ekle(p, "arg_al");
    g_ekle(p, "dosya_ac"); g_ekle(p, "dosya_kapat"); g_ekle(p, "dosya_oku");
    g_ekle(p, "dosya_yaz"); g_ekle(p, "dosya_boyut"); g_ekle(p, "dosya_var_mi");
    g_ekle(p, "dosya_sil"); g_ekle(p, "dosya_yeniden_adlandir");
    g_ekle(p, "otp_anahtar_uret"); g_ekle(p, "otp_xor_uygula");
    // özel-builtin'ler (CAGRI handler'ında, EKLE_BUILTIN değil)
    g_ekle(p, "tekkez_olustur"); g_ekle(p, "sabitsüre_olustur");
    g_ekle(p, "delege"); g_ekle(p, "geri_al");
    g_ekle(p, "görev_başlat"); g_ekle(p, "görev_birleştir");
    g_ekle(p, "kanal_gönder"); g_ekle(p, "kanal_al"); g_ekle(p, "dur"); g_ekle(p, "dondur");
    g_ekle(p, "yetki_olustur");
    g_ekle(p, "mmio_oku16"); g_ekle(p, "mmio_yaz16"); g_ekle(p, "mmio_oku32");
    g_ekle(p, "mmio_yaz32"); g_ekle(p, "mmio_oku64"); g_ekle(p, "mmio_yaz64");
    g_ekle(p, "vektor_doldur"); g_ekle(p, "vektor_eleman"); g_ekle(p, "vektor_topla");
    g_ekle(p, "vektor_min"); g_ekle(p, "vektor_max"); g_ekle(p, "vektor_esit");
    g_ekle(p, "vektor_kucuk"); g_ekle(p, "vektor_buyuk"); g_ekle(p, "vektor_sec");
    // keyword-konstrüktörler (tip_belirle özel-case: değer/tamam/hata + hiç + kendin)
    g_ekle(p, "değer"); g_ekle(p, "tamam"); g_ekle(p, "hata"); g_ekle(p, "kendin");
    ver 0;
}
işlev ad_tanimli_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken n: tam32 = dizi_boyut(p.g_isim);
    değişken i: tam32 = 0;
    iken i < n { eğer metin_esit(dizi_al(p.g_isim, i), ad) { ver doğru; } i = i + 1; }
    n = dizi_boyut(p.yerel);
    i = p.yerel_basla;
    iken i < n { eğer metin_esit(dizi_al(p.yerel, i), ad) { ver doğru; } i = i + 1; }
    ver yanlış;
}
// Üst-düzey tanım adları (işlev/yapı/çeşit/sabit) → genel; modül recurse.
işlev genel_topla(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        değişken ad: metin = dizi_al(p.a_ad, c);
        eğer metin_esit(ad, "ISLEV") veya metin_esit(ad, "YAPI")
          veya metin_esit(ad, "CESIT") veya metin_esit(ad, "SABIT")
          veya metin_esit(ad, "KURESEL") {   // D-253 küresel değişken → global ad
            g_ekle(p, dizi_al(p.a_deg, c));
        }
        eğer metin_esit(ad, "ISLEV") { imza_kaydet(p, c); }   // TC3d imza tablosu
        eğer metin_esit(ad, "YAPI") { yapi_kaydet(p, c); }    // TC4 yapı tablosu
        eğer metin_esit(ad, "MODUL") { g_ekle(p, dizi_al(p.a_deg, c)); genel_topla(p, c); }
        eğer metin_esit(ad, "DISA") {       // dışa <tanım> → iç tanım adı
            değişken dcb: tam32 = dizi_al(p.a_cb, c);
            eğer dizi_al(p.a_cs, c) > 0 {
                değişken ic: tam32 = dizi_al(p.cocuk, dcb);
                g_ekle(p, dizi_al(p.a_deg, ic));
                eğer metin_esit(dizi_al(p.a_ad, ic), "ISLEV") { imza_kaydet(p, ic); }
                eğer metin_esit(dizi_al(p.a_ad, ic), "YAPI") { yapi_kaydet(p, ic); }
            }
        }
        i = i + 1;
    }
    ver 0;
}
// Alt-ağaçtaki param/lokal/için/desen-binding adlarını yerel'e topla.
// ---- TC3: tip çıkarsama (string-encoded; "?" = bilinmiyor → T001 atla) ----
işlev tip_str(p: &değişken Ayr, idx: tam32) -> metin {
    eğer metin_esit(dizi_al(p.a_ad, idx), "TIP_BASIT") { ver dizi_al(p.a_deg, idx); }
    ver "?";   // bileşik tip (Dizi/&/seçimlik/...) — ileri TC
}
işlev sayisal_mi(t: metin) -> mantıksal {
    ver metin_esit(t, "tam8") veya metin_esit(t, "tam16") veya metin_esit(t, "tam32")
      veya metin_esit(t, "tam64") veya metin_esit(t, "dtam8") veya metin_esit(t, "dtam16")
      veya metin_esit(t, "dtam32") veya metin_esit(t, "dtam64")
      veya metin_esit(t, "kesirli32") veya metin_esit(t, "kesirli64");
}
işlev kesirli_mi(t: metin) -> mantıksal {
    ver metin_esit(t, "kesirli32") veya metin_esit(t, "kesirli64");
}
// Tamsayı tipi mi? (bit operatörleri tamsayı ister — kesirli/mantıksal HARİÇ.)
işlev tamsayi_mi(t: metin) -> mantıksal {
    ver metin_esit(t, "tam8") veya metin_esit(t, "tam16") veya metin_esit(t, "tam32")
      veya metin_esit(t, "tam64") veya metin_esit(t, "dtam8") veya metin_esit(t, "dtam16")
      veya metin_esit(t, "dtam32") veya metin_esit(t, "dtam64");
}
// Bilinen skaler tip mi? (CAGRI dönüş çıkarsamasında güvenli alt küme — generic
// param/yapı/bileşik dönüşler "?" kalır, böylece T001 false-positive yok.)
işlev bilinen_skaler_mi(t: metin) -> mantıksal {
    ver sayisal_mi(t) veya metin_esit(t, "mantıksal") veya metin_esit(t, "metin")
      veya metin_esit(t, "karakter") veya metin_esit(t, "boş");
}
// Aritmetik ikili op mu? (C kontrol_ikili_sayisal — T003 sol/sag sayısal ister.)
işlev aritmetik_mi(op: metin) -> mantıksal {
    ver metin_esit(op, "+") veya metin_esit(op, "-") veya metin_esit(op, "*")
      veya metin_esit(op, "/") veya metin_esit(op, "%");
}
// Karşılaştırma ikili op mu? (C OP_KUCUK/BUYUK/... — T003 sayısal ister.)
işlev sirali_kars_mi(op: metin) -> mantıksal {
    ver metin_esit(op, "<") veya metin_esit(op, ">")
      veya metin_esit(op, "<=") veya metin_esit(op, ">=");
}
// "Kesinlikle sayısal değil" — bilinen (≠"?") ama sayısal olmayan tip.
işlev bilinen_sayisal_degil(t: metin) -> mantıksal {
    ver (metin_esit(t, "?") == yanlış) ve (sayisal_mi(t) == yanlış);
}
// "Kesinlikle mantıksal değil" — bilinen (≠"?") ama mantıksal olmayan tip.
işlev bilinen_mantiksal_degil(t: metin) -> mantıksal {
    ver (metin_esit(t, "?") == yanlış) ve (metin_esit(t, "mantıksal") == yanlış);
}
// Bit/kaydırma ikili op mu? (& | ^ << >> — C: operandlar tamsayı, aksi T028.)
işlev bit_op_mi(op: metin) -> mantıksal {
    ver metin_esit(op, "&") veya metin_esit(op, "|") veya metin_esit(op, "^")
      veya metin_esit(op, "<<") veya metin_esit(op, ">>");
}
// "Kesinlikle tamsayı değil" — bilinen (≠"?") ama tamsayı olmayan tip.
işlev bilinen_tamsayi_degil(t: metin) -> mantıksal {
    ver (metin_esit(t, "?") == yanlış) ve (tamsayi_mi(t) == yanlış);
}
// Atama hedefi lvalue mi? (C: TANIMLAYICI/ERISIM/INDEKS — aksi T022.)
işlev lvalue_mi(ad: metin) -> mantıksal {
    ver metin_esit(ad, "TANIMLAYICI") veya metin_esit(ad, "ERISIM")
      veya metin_esit(ad, "INDEKS");
}
// Bir işlev düğümünün PARAMETRE çocuk sayısı (arite).
işlev param_say(p: &değişken Ayr, fn: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, fn);
    değişken cs: tam32 = dizi_al(p.a_cs, fn);
    değişken i: tam32 = 0;  değişken n: tam32 = 0;
    iken i < cs {
        eğer metin_esit(dizi_al(p.a_ad, dizi_al(p.cocuk, cb + i)), "PARAMETRE") { n = n + 1; }
        i = i + 1;
    }
    ver n;
}
// Bir PARAMETRE düğümünün tip-string'i (kendin → çocuk yok → "?"; bileşik → "?").
işlev param_tip_str(p: &değişken Ayr, param_idx: tam32) -> metin {
    değişken tc: tam32 = son_cocuk(p, param_idx);
    eğer (tc >= 0) ve metin_baslar(dizi_al(p.a_ad, tc), "TIP_") { ver tip_str(p, tc); }
    ver "?";
}
// İşlev imzasını tabloya kaydet (CAGRI dönüş + T010 + per-arg T001). Dönüş/param
// yalnız bilinen skaler ise saklanır; aksi (yapı/generic/bileşik) "?" → atlanır.
işlev imza_kaydet(p: &değişken Ayr, fn: tam32) -> tam32 {
    dizi_ekle(p.fn_ad, dizi_al(p.a_deg, fn));
    değişken dt: metin = donus_str(p, fn);
    eğer bilinen_skaler_mi(dt) { dizi_ekle(p.fn_donus, dt); }
    değilse { dizi_ekle(p.fn_donus, "?"); }
    dizi_ekle(p.fn_psay, param_say(p, fn));
    dizi_ekle(p.fn_pbase, dizi_boyut(p.fn_ptip));   // param tiplerinin başlangıcı
    değişken cb: tam32 = dizi_al(p.a_cb, fn);
    değişken cs: tam32 = dizi_al(p.a_cs, fn);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "PARAMETRE") {
            değişken pt: metin = param_tip_str(p, c);
            eğer bilinen_skaler_mi(pt) { dizi_ekle(p.fn_ptip, pt); }
            değilse { dizi_ekle(p.fn_ptip, "?"); }
            değişken tc: tam32 = son_cocuk(p, c);   // param tip çocuğu → tekkez mi (TC5b)
            eğer (tc >= 0) ve tip_node_tekkez_mi(dizi_al(p.a_ad, tc)) { dizi_ekle(p.fn_plin, 1); }
            değilse { dizi_ekle(p.fn_plin, 0); }
        }
        i = i + 1;
    }
    ver 0;
}
// İşlev adı + param indeksi → param lineer mi (1/0; bulunamazsa 0).
işlev fn_plin_bul(p: &değişken Ayr, ad: metin, j: tam32) -> tam32 {
    değişken n: tam32 = dizi_boyut(p.fn_ad);
    değişken i: tam32 = 0;
    iken i < n {
        eğer metin_esit(dizi_al(p.fn_ad, i), ad) { ver dizi_al(p.fn_plin, dizi_al(p.fn_pbase, i) + j); }
        i = i + 1;
    }
    ver 0;
}
// İşlev adı → dönüş tipi ("?" = kullanıcı işlevi değil veya bilinmeyen dönüş).
işlev fn_donus_bul(p: &değişken Ayr, ad: metin) -> metin {
    değişken n: tam32 = dizi_boyut(p.fn_ad);
    değişken i: tam32 = 0;
    iken i < n { eğer metin_esit(dizi_al(p.fn_ad, i), ad) { ver dizi_al(p.fn_donus, i); } i = i + 1; }
    ver "?";
}
// İşlev adı → parametre sayısı (-1 = kullanıcı işlevi değil).
işlev fn_psay_bul(p: &değişken Ayr, ad: metin) -> tam32 {
    değişken n: tam32 = dizi_boyut(p.fn_ad);
    değişken i: tam32 = 0;
    iken i < n { eğer metin_esit(dizi_al(p.fn_ad, i), ad) { ver dizi_al(p.fn_psay, i); } i = i + 1; }
    ver 0 - 1;
}
// İşlev adı + parametre indeksi → param tip-string'i ("?" = bilinmeyen/bileşik).
işlev fn_ptip_bul(p: &değişken Ayr, ad: metin, j: tam32) -> metin {
    değişken n: tam32 = dizi_boyut(p.fn_ad);
    değişken i: tam32 = 0;
    iken i < n {
        eğer metin_esit(dizi_al(p.fn_ad, i), ad) {
            ver dizi_al(p.fn_ptip, dizi_al(p.fn_pbase, i) + j);
        }
        i = i + 1;
    }
    ver "?";
}
// ---- TC4: yapı tablosu kayıt + sorgu ----
// Bir YAPI düğümünün alanlarını (ad + tip) tabloya kaydet.
işlev yapi_kaydet(p: &değişken Ayr, yapi: tam32) -> tam32 {
    dizi_ekle(p.yapi_ad, dizi_al(p.a_deg, yapi));
    dizi_ekle(p.yapi_abase, dizi_boyut(p.alan_ad));
    değişken cb: tam32 = dizi_al(p.a_cb, yapi);
    değişken cs: tam32 = dizi_al(p.a_cs, yapi);
    değişken i: tam32 = 0;  değişken n: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "ALAN") {
            dizi_ekle(p.alan_ad, dizi_al(p.a_deg, c));
            değişken tc: tam32 = son_cocuk(p, c);
            değişken ft: metin = "?";
            eğer (tc >= 0) ve metin_baslar(dizi_al(p.a_ad, tc), "TIP_") { ft = tip_str(p, tc); }
            eğer bilinen_skaler_mi(ft) { dizi_ekle(p.alan_tip, ft); }
            değilse { dizi_ekle(p.alan_tip, "?"); }
            n = n + 1;
        }
        i = i + 1;
    }
    dizi_ekle(p.yapi_acount, n);
    ver 0;
}
işlev yapi_idx_bul(p: &değişken Ayr, ad: metin) -> tam32 {
    değişken n: tam32 = dizi_boyut(p.yapi_ad);
    değişken i: tam32 = 0;
    iken i < n { eğer metin_esit(dizi_al(p.yapi_ad, i), ad) { ver i; } i = i + 1; }
    ver 0 - 1;
}
işlev alan_var_mi(p: &değişken Ayr, yad: metin, fad: metin) -> mantıksal {
    değişken yi: tam32 = yapi_idx_bul(p, yad);
    eğer yi < 0 { ver yanlış; }
    değişken base: tam32 = dizi_al(p.yapi_abase, yi);
    değişken cnt: tam32 = dizi_al(p.yapi_acount, yi);
    değişken j: tam32 = 0;
    iken j < cnt { eğer metin_esit(dizi_al(p.alan_ad, base + j), fad) { ver doğru; } j = j + 1; }
    ver yanlış;
}
işlev alan_tip_bul(p: &değişken Ayr, yad: metin, fad: metin) -> metin {
    değişken yi: tam32 = yapi_idx_bul(p, yad);
    eğer yi < 0 { ver "?"; }
    değişken base: tam32 = dizi_al(p.yapi_abase, yi);
    değişken cnt: tam32 = dizi_al(p.yapi_acount, yi);
    değişken j: tam32 = 0;
    iken j < cnt {
        eğer metin_esit(dizi_al(p.alan_ad, base + j), fad) { ver dizi_al(p.alan_tip, base + j); }
        j = j + 1;
    }
    ver "?";
}
// Bir ismin tipi (aktif işlev yerel dilimi). "?" = bilinmiyor/belirsiz.
// GÜVENLİ: aynı ad birden fazla FARKLI tiple bağlanmışsa (ayrı blok kapsamları —
// düz yerel listesinde kapsam yok) → "?" (belirsiz). Tek tip → o tip. (False
// T020/T001 önler: parse_birincil'de iki `ic` (metin + tam32) gibi durumlar.)
işlev var_tip(p: &değişken Ayr, ad: metin) -> metin {
    değişken n: tam32 = dizi_boyut(p.yerel);
    değişken i: tam32 = p.yerel_basla;
    değişken bulunan: metin = "?";
    değişken sayi: tam32 = 0;
    iken i < n {
        eğer metin_esit(dizi_al(p.yerel, i), ad) {
            değişken t: metin = dizi_al(p.yerel_tip, i);
            eğer sayi == 0 { bulunan = t; }
            değilse { eğer metin_esit(bulunan, t) == yanlış { ver "?"; } }
            sayi = sayi + 1;
        }
        i = i + 1;
    }
    ver bulunan;
}
// İfade tipi (beklenen ile bidirectional). Bilinmeyen → "?". (TC3a: literal+ident.)
işlev ifade_tip(p: &değişken Ayr, idx: tam32, beklenen: metin) -> metin {
    değişken ad: metin = dizi_al(p.a_ad, idx);
    eğer metin_esit(ad, "TAM") {
        eğer sayisal_mi(beklenen) { ver beklenen; }   // bidirectional sayı literal
        ver "tam32";
    }
    eğer metin_esit(ad, "KESIRLI") {
        eğer kesirli_mi(beklenen) { ver beklenen; }
        ver "kesirli64";
    }
    eğer metin_esit(ad, "METIN") { ver "metin"; }
    eğer metin_esit(ad, "KARAKTER") { ver "karakter"; }
    eğer metin_esit(ad, "MANTIKSAL") { ver "mantıksal"; }
    eğer metin_esit(ad, "BOS") { ver "boş"; }
    eğer metin_esit(ad, "TANIMLAYICI") { ver var_tip(p, dizi_al(p.a_deg, idx)); }
    eğer metin_esit(ad, "IKILI") {
        değişken op: metin = dizi_al(p.a_deg, idx);
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken sol: tam32 = dizi_al(p.cocuk, cb);
        değişken sag: tam32 = dizi_al(p.cocuk, cb + 1);
        eğer aritmetik_mi(op) {   // sayısal → operand tipi; sayısal değilse "?" (C: TIP_HATA)
            değişken st: metin = ifade_tip(p, sol, beklenen);
            değişken gt: metin = ifade_tip(p, sag, beklenen);
            eğer bilinen_sayisal_degil(st) veya bilinen_sayisal_degil(gt) { ver "?"; }
            ver st;
        }
        eğer sirali_kars_mi(op) {   // sayısal operand → mantıksal; değilse "?" (C: TIP_HATA)
            değişken st: metin = ifade_tip(p, sol, "?");
            değişken gt: metin = ifade_tip(p, sag, "?");
            eğer bilinen_sayisal_degil(st) veya bilinen_sayisal_degil(gt) { ver "?"; }
            ver "mantıksal";
        }
        eğer metin_esit(op, "ve") veya metin_esit(op, "veya") {   // mantıksal değilse "?" (C: TIP_HATA)
            değişken st: metin = ifade_tip(p, sol, "mantıksal");
            değişken gt: metin = ifade_tip(p, sag, "mantıksal");
            eğer bilinen_mantiksal_degil(st) veya bilinen_mantiksal_degil(gt) { ver "?"; }
            ver "mantıksal";
        }
        eğer metin_esit(op, "==") veya metin_esit(op, "!=") { ver "mantıksal"; }
        eğer bit_op_mi(op) {   // tamsayı operand → sol tipi; tamsayı değilse "?" (C: TIP_HATA)
            değişken st: metin = ifade_tip(p, sol, beklenen);
            değişken gt: metin = ifade_tip(p, sag, "?");
            eğer bilinen_tamsayi_degil(st) veya bilinen_tamsayi_degil(gt) { ver "?"; }
            ver st;
        }
        ver ifade_tip(p, sol, beklenen);  // bilinmeyen op → sol tipi
    }
    eğer metin_esit(ad, "TEKLI") {
        değişken op: metin = dizi_al(p.a_deg, idx);
        değişken operand: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
        eğer metin_esit(op, "degil") {   // mantıksal değilse "?" (C: TIP_HATA)
            değişken t: metin = ifade_tip(p, operand, "mantıksal");
            eğer bilinen_mantiksal_degil(t) { ver "?"; }
            ver "mantıksal";
        }
        eğer metin_esit(op, "neg") {   // sayısal değilse "?" (C: TIP_HATA)
            değişken t: metin = ifade_tip(p, operand, beklenen);
            eğer bilinen_sayisal_degil(t) { ver "?"; }
            ver t;
        }
        eğer metin_esit(op, "~") {   // bit değil: tamsayı → operand tipi; aksi "?" (T028)
            değişken t: metin = ifade_tip(p, operand, beklenen);
            eğer bilinen_tamsayi_degil(t) { ver "?"; }
            ver t;
        }
        ver "?";   // & (ref) / deref* → ileri TC
    }
    eğer metin_esit(ad, "CAGRI") {   // TC3d: kullanıcı işlevi çağrısı → dönüş tipi
        değişken h: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));   // çocuk[0]=hedef
        eğer metin_esit(dizi_al(p.a_ad, h), "TANIMLAYICI") {
            ver fn_donus_bul(p, dizi_al(p.a_deg, h));   // "?" = kullanıcı işlevi değil
        }
        ver "?";   // method/dolaylı çağrı → ileri TC
    }
    eğer metin_esit(ad, "YAPI_OLUSTUR") {   // TC4: yapı oluştur → yapı adı (tip)
        değişken tad: metin = dizi_al(p.a_deg, idx);
        eğer yapi_var_mi(p, tad) { ver tad; }
        ver "?";
    }
    eğer metin_esit(ad, "ERISIM") {   // TC4: nesne.alan → alan tipi (skaler; aksi "?")
        değişken nesne: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
        değişken nt: metin = ifade_tip(p, nesne, "?");   // referans → "?" → atla
        ver alan_tip_bul(p, nt, dizi_al(p.a_deg, idx));
    }
    ver "?";   // INDEKS/YOL/... → ileri TC
}
// DEGISKEN/SABIT annotation tip-string ("?"=yok/bileşik).
işlev annot_str(p: &değişken Ayr, idx: tam32) -> metin {
    eğer dizi_al(p.a_cs, idx) >= 2 {
        değişken c0: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
        eğer metin_baslar(dizi_al(p.a_ad, c0), "TIP_") { ver tip_str(p, c0); }
    }
    ver "?";
}
işlev son_cocuk(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken cs: tam32 = dizi_al(p.a_cs, idx);
    eğer cs == 0 { ver 0 - 1; }
    ver dizi_al(p.cocuk, dizi_al(p.a_cb, idx) + cs - 1);
}
// T001: annotation vs değer tipi (DEGISKEN/SABIT). Güvenli — yalnız emin olunca.
işlev t001_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken annot: metin = annot_str(p, idx);
    eğer metin_esit(annot, "?") { ver 0; }
    değişken vc: tam32 = son_cocuk(p, idx);
    eğer vc < 0 { ver 0; }
    değişken vt: metin = ifade_tip(p, vc, annot);
    eğer (metin_esit(vt, "?") == yanlış) ve (metin_esit(annot, vt) == yanlış) {
        dizi_ekle(p.th_kod, "T001");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
    }
    ver 0;
}
// İşlev dönüş tipi (çocuklardaki TIP_* düğümü; yoksa "boş").
işlev donus_str(p: &değişken Ayr, fn: tam32) -> metin {
    değişken cb: tam32 = dizi_al(p.a_cb, fn);
    değişken cs: tam32 = dizi_al(p.a_cs, fn);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_baslar(dizi_al(p.a_ad, c), "TIP_") { ver tip_str(p, c); }
        i = i + 1;
    }
    ver "boş";
}
// T020: ver değeri işlev dönüş tipiyle uyumsuz (ver_idx konumu). "?"→atla.
işlev t020_kontrol(p: &değişken Ayr, ver_idx: tam32) -> tam32 {
    eğer metin_esit(p.aktif_donus, "?") { ver 0; }
    eğer dizi_al(p.a_cs, ver_idx) == 0 {           // ver;  → dönüş boş olmalı
        eğer metin_esit(p.aktif_donus, "boş") == yanlış {
            dizi_ekle(p.th_kod, "T020");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, ver_idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, ver_idx));
        }
        ver 0;
    }
    değişken vc: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, ver_idx));
    değişken vt: metin = ifade_tip(p, vc, p.aktif_donus);
    eğer (metin_esit(vt, "?") == yanlış) ve (metin_esit(vt, p.aktif_donus) == yanlış) {
        dizi_ekle(p.th_kod, "T020");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, ver_idx));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, ver_idx));
    }
    ver 0;
}
// T021: eğer/iken koşulu mantıksal olmalı. eger_idx konumunda. ("?"→atla)
işlev t021_kontrol(p: &değişken Ayr, eger_idx: tam32, kosul_idx: tam32) -> tam32 {
    değişken kt: metin = ifade_tip(p, kosul_idx, "mantıksal");
    eğer (metin_esit(kt, "?") == yanlış) ve (metin_esit(kt, "mantıksal") == yanlış) {
        dizi_ekle(p.th_kod, "T021");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, eger_idx));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, eger_idx));
    }
    ver 0;
}
// T003: aritmetik/karşılaştırma ikili operandı sayısal değil (IKILI düğümünde).
// C: operand TIP_HATA ise erken dönüş → T003 yok → "?" operand atla (false-pos yok).
işlev t003_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken op: metin = dizi_al(p.a_deg, idx);
    eğer (aritmetik_mi(op) veya sirali_kars_mi(op)) == yanlış { ver 0; }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken st: metin = ifade_tip(p, dizi_al(p.cocuk, cb), "?");
    değişken gt: metin = ifade_tip(p, dizi_al(p.cocuk, cb + 1), "?");
    eğer bilinen_sayisal_degil(st) veya bilinen_sayisal_degil(gt) {
        dizi_ekle(p.th_kod, "T003");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
    }
    ver 0;
}
// T004: ikili ve/veya operandı mantıksal olmalı (IKILI düğümünde). "?"→atla.
işlev t004_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken op: metin = dizi_al(p.a_deg, idx);
    eğer (metin_esit(op, "ve") veya metin_esit(op, "veya")) == yanlış { ver 0; }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken st: metin = ifade_tip(p, dizi_al(p.cocuk, cb), "mantıksal");
    değişken gt: metin = ifade_tip(p, dizi_al(p.cocuk, cb + 1), "mantıksal");
    eğer bilinen_mantiksal_degil(st) veya bilinen_mantiksal_degil(gt) {
        dizi_ekle(p.th_kod, "T004");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
    }
    ver 0;
}
// T028: bit/kaydırma ikili operandı tamsayı olmalı (IKILI düğümünde). "?"→atla.
işlev t028_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken op: metin = dizi_al(p.a_deg, idx);
    eğer bit_op_mi(op) == yanlış { ver 0; }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken st: metin = ifade_tip(p, dizi_al(p.cocuk, cb), "?");
    değişken gt: metin = ifade_tip(p, dizi_al(p.cocuk, cb + 1), "?");
    eğer bilinen_tamsayi_degil(st) veya bilinen_tamsayi_degil(gt) {
        dizi_ekle(p.th_kod, "T028");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
    }
    ver 0;
}
// Tekli operatör kontrolü: neg → T003 (sayısal), degil → T004 (mantıksal),
// ~ (bit değil) → T028 (tamsayı); & / deref* → ileri TC. "?"→atla.
işlev tekli_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken op: metin = dizi_al(p.a_deg, idx);
    değişken operand: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
    eğer metin_esit(op, "neg") {
        değişken t: metin = ifade_tip(p, operand, "?");
        eğer bilinen_sayisal_degil(t) {
            dizi_ekle(p.th_kod, "T003");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
        }
        ver 0;
    }
    eğer metin_esit(op, "~") {
        değişken tt: metin = ifade_tip(p, operand, "?");
        eğer bilinen_tamsayi_degil(tt) {
            dizi_ekle(p.th_kod, "T028");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
        }
        ver 0;
    }
    eğer metin_esit(op, "degil") {
        değişken t: metin = ifade_tip(p, operand, "mantıksal");
        eğer bilinen_mantiksal_degil(t) {
            dizi_ekle(p.th_kod, "T004");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
        }
    }
    // TC5b L004: lineer bağlama referansı alınamaz (& / &değişken).
    eğer metin_esit(op, "&") veya metin_esit(op, "&degisken") {
        eğer metin_esit(dizi_al(p.a_ad, operand), "TANIMLAYICI")
          ve (lin_idx(p, dizi_al(p.a_deg, operand)) >= 0) {
            dizi_ekle(p.th_kod, "L004");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
        }
    }
    ver 0;
}
// ---- TC5b: lineer akış izleme yardımcıları ----
// Linear Types Spec V1 = YALNIZ tekkez (yetki → CP005/TC7, görev → DRF/TC6 ayrı kod).
işlev tip_node_tekkez_mi(ad: metin) -> mantıksal { ver metin_esit(ad, "TIP_TEKKEZ"); }
// Bir değişkenin tekkez olup olmadığı: annot tekkez VEYA değer tekkez_olustur(...).
işlev deg_lineer_mi(p: &değişken Ayr, idx: tam32) -> mantıksal {
    eğer dizi_al(p.a_cs, idx) >= 2 {
        değişken c0: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
        eğer tip_node_tekkez_mi(dizi_al(p.a_ad, c0)) { ver doğru; }
    }
    değişken vc: tam32 = son_cocuk(p, idx);
    eğer (vc >= 0) ve metin_esit(dizi_al(p.a_ad, vc), "CAGRI") {
        değişken h: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, vc));
        eğer metin_esit(dizi_al(p.a_ad, h), "TANIMLAYICI")
          ve metin_esit(dizi_al(p.a_deg, h), "tekkez_olustur") { ver doğru; }
    }
    ver yanlış;
}
işlev lin_ekle(p: &değişken Ayr, ad: metin, sat: tam32, sut: tam32) -> tam32 {
    dizi_ekle(p.lin_ad, ad); dizi_ekle(p.lin_sat, sat);
    dizi_ekle(p.lin_sut, sut); dizi_ekle(p.lin_tuk, 0); ver 0;
}
// Aktif dilimde (en yeni) lineer bağlamanın indeksi; yoksa -1.
işlev lin_idx(p: &değişken Ayr, ad: metin) -> tam32 {
    değişken i: tam32 = dizi_boyut(p.lin_ad) - 1;
    iken i >= p.lin_basla {
        eğer metin_esit(dizi_al(p.lin_ad, i), ad) { ver i; }
        i = i - 1;
    }
    ver 0 - 1;
}
// Bir düğüm lineer bağlamaysa tüket; zaten tüketilmişse L002 (düğüm konumu).
işlev lin_tuket_dugum(p: &değişken Ayr, node: tam32) -> tam32 {
    eğer metin_esit(dizi_al(p.a_ad, node), "TANIMLAYICI") == yanlış { ver 0; }
    değişken idx: tam32 = lin_idx(p, dizi_al(p.a_deg, node));
    eğer idx < 0 { ver 0; }
    eğer dizi_al(p.lin_tuk, idx) >= 1 {
        dizi_ekle(p.th_kod, "L002");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, node));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, node));
    }
    dizi_yaz(p.lin_tuk, idx, dizi_al(p.lin_tuk, idx) + 1);
    ver 0;
}
// İşlev lineer parametrelerini aktif dilime ekle (L001 + tüketim için).
işlev lin_param_topla(p: &değişken Ayr, fn: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, fn);
    değişken cs: tam32 = dizi_al(p.a_cs, fn);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "PARAMETRE") {
            değişken tc: tam32 = son_cocuk(p, c);
            eğer (tc >= 0) ve tip_node_tekkez_mi(dizi_al(p.a_ad, tc)) {
                lin_ekle(p, dizi_al(p.a_deg, c), dizi_al(p.a_sat, c), dizi_al(p.a_sut, c));
            }
        }
        i = i + 1;
    }
    ver 0;
}
// İşlev scope kapanışı: aktif dilimde tüketilmemiş lineer bağlama → L001.
işlev lin_kapanis(p: &değişken Ayr) -> tam32 {
    değişken n: tam32 = dizi_boyut(p.lin_ad);
    değişken i: tam32 = p.lin_basla;
    iken i < n {
        eğer dizi_al(p.lin_tuk, i) == 0 {
            dizi_ekle(p.th_kod, "L001");
            dizi_ekle(p.th_sat, dizi_al(p.lin_sat, i));
            dizi_ekle(p.th_sut, dizi_al(p.lin_sut, i));
        }
        i = i + 1;
    }
    ver 0;
}

// Yerel/param tip-string filtresi: yalnız bilinen skaler VEYA bilinen yapı adı
// saklanır; aksi (generic "T" gibi bilinmeyen ad) → "?" → kontrol atlanır.
// C: TIP_GENERIC_PARAM için tip_sayisal_mi "deferred true" → generic'te T003 yok.
işlev yerel_tip_filtrele(p: &değişken Ayr, t: metin) -> metin {
    eğer bilinen_skaler_mi(t) veya yapi_var_mi(p, t) { ver t; }
    ver "?";
}
işlev yerel_topla(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken ad: metin = dizi_al(p.a_ad, idx);
    eğer metin_esit(ad, "PARAMETRE") {
        dizi_ekle(p.yerel, dizi_al(p.a_deg, idx));
        değişken tc: tam32 = son_cocuk(p, idx);   // param tip çocuğu (kendin → çocuk yok)
        eğer (tc >= 0) ve metin_baslar(dizi_al(p.a_ad, tc), "TIP_") {
            dizi_ekle(p.yerel_tip, yerel_tip_filtrele(p, tip_str(p, tc)));
        } değilse { dizi_ekle(p.yerel_tip, "?"); }
    } değilse {
        eğer metin_esit(ad, "DEGISKEN") {
            dizi_ekle(p.yerel, dizi_al(p.a_deg, idx));
            dizi_ekle(p.yerel_tip, yerel_tip_filtrele(p, annot_str(p, idx)));
        } değilse {
            eğer metin_esit(ad, "ICIN") veya metin_esit(ad, "DESEN_TANIMLAYICI") {
                dizi_ekle(p.yerel, dizi_al(p.a_deg, idx));
                dizi_ekle(p.yerel_tip, "?");
            }
        }
    }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken cs: tam32 = dizi_al(p.a_cs, idx);
    değişken i: tam32 = 0;
    iken i < cs { yerel_topla(p, dizi_al(p.cocuk, cb + i)); i = i + 1; }
    ver 0;
}
// İfade alt-ağacında T002 (tanımsız) + DEGISKEN/SABIT T001. Tip/desen/yol atla.
işlev kontrol_dugum(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken ad: metin = dizi_al(p.a_ad, idx);
    eğer metin_baslar(ad, "TIP_") { ver 0; }
    eğer metin_baslar(ad, "DESEN") { ver 0; }
    eğer metin_esit(ad, "YOL") { ver 0; }
    eğer metin_esit(ad, "TANIMLAYICI") {
        değişken nm: metin = dizi_al(p.a_deg, idx);
        eğer (ad_tanimli_mi(p, nm) == yanlış) ve (metin_esit(nm, "hiç") == yanlış) {
            dizi_ekle(p.th_kod, "T002");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
        }
        ver 0;
    }
    // eğer/iken: koşulu (1. çocuk) önce kontrol + T021, sonra dalları (C sırası)
    eğer metin_esit(ad, "EGER") veya metin_esit(ad, "IKEN") {
        değişken kb: tam32 = dizi_al(p.a_cb, idx);
        değişken kc: tam32 = dizi_al(p.a_cs, idx);
        değişken kosul: tam32 = dizi_al(p.cocuk, kb);
        kontrol_dugum(p, kosul);
        t021_kontrol(p, idx, kosul);
        değişken j: tam32 = 1;
        iken j < kc { kontrol_dugum(p, dizi_al(p.cocuk, kb + j)); j = j + 1; }
        ver 0;
    }
    // CAGRI: hedef T002 → (tanımsız → erken dön) → T010 arite (uyumsuz → erken dön)
    // → argümanlar. C tip_belirle(CAGRI) sırası: hedef, arite, sonra arg kontrolü.
    eğer metin_esit(ad, "CAGRI") {
        değişken hb: tam32 = dizi_al(p.a_cb, idx);
        değişken hc: tam32 = dizi_al(p.a_cs, idx);
        değişken hedef: tam32 = dizi_al(p.cocuk, hb);
        kontrol_dugum(p, hedef);                 // hedef T002 (C: tip_belirle(hedef))
        eğer metin_esit(dizi_al(p.a_ad, hedef), "TANIMLAYICI") {
            değişken fad: metin = dizi_al(p.a_deg, hedef);
            eğer ad_tanimli_mi(p, fad) == yanlış {
                ver 0;   // C: tanımsız hedef → TIP_HATA → erken dönüş (arg atlanır)
            }
            değişken ps: tam32 = fn_psay_bul(p, fad);
            eğer ps >= 0 {                        // kullanıcı işlevi → arite bilinir
                eğer (hc - 1) != ps {             // çocuk[0]=hedef → arg sayısı = hc-1
                    dizi_ekle(p.th_kod, "T010");
                    dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
                    dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
                    ver 0;   // C: arite uyumsuz → erken dönüş (arg tip kontrolü yok)
                }
                // arite OK → her arg: traverse (iç T002) + per-arg T001 (param tipi)
                değişken a: tam32 = 1;
                iken a < hc {
                    değişken arg: tam32 = dizi_al(p.cocuk, hb + a);
                    kontrol_dugum(p, arg);
                    değişken pt: metin = fn_ptip_bul(p, fad, a - 1);
                    eğer metin_esit(pt, "?") == yanlış {
                        değişken at: metin = ifade_tip(p, arg, pt);
                        eğer (metin_esit(at, "?") == yanlış) ve (metin_esit(at, pt) == yanlış) {
                            dizi_ekle(p.th_kod, "T001");
                            dizi_ekle(p.th_sat, dizi_al(p.a_sat, arg));
                            dizi_ekle(p.th_sut, dizi_al(p.a_sut, arg));
                        }
                    }
                    eğer fn_plin_bul(p, fad, a - 1) == 1 { lin_tuket_dugum(p, arg); }   // TC5b move
                    a = a + 1;
                }
                ver 0;
            }
        }
        değişken k: tam32 = 1;
        iken k < hc { kontrol_dugum(p, dizi_al(p.cocuk, hb + k)); k = k + 1; }
        ver 0;
    }
    // ATAMA: T022 (lvalue) önce → hedef T002 → değer T002 → T001 (tip uyumsuz).
    // C DUGUM_ATAMA sırası birebir. Konum: ATAMA düğümü (sol-taraf başı).
    eğer metin_esit(ad, "ATAMA") {
        değişken ab: tam32 = dizi_al(p.a_cb, idx);
        değişken hedef: tam32 = dizi_al(p.cocuk, ab);
        değişken deger: tam32 = dizi_al(p.cocuk, ab + 1);
        // D-249 (GAP-2 parite): *p (TEKLI deref*) da lvalue — ham pointer deref-write
        // (C tip_kontrol.c D-248 T022 gevşetme aynası; codegen'de store emit edilir).
        değişken hedef_deref: mantıksal = metin_esit(dizi_al(p.a_ad, hedef), "TEKLI")
            ve metin_esit(dizi_al(p.a_deg, hedef), "deref*");
        eğer (lvalue_mi(dizi_al(p.a_ad, hedef)) == yanlış) ve (hedef_deref == yanlış) {
            dizi_ekle(p.th_kod, "T022");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
        }
        kontrol_dugum(p, hedef);
        kontrol_dugum(p, deger);
        değişken ht: metin = ifade_tip(p, hedef, "?");   // TANIMLAYICI → var_tip; ERISIM/INDEKS → "?"
        eğer metin_esit(ht, "?") == yanlış {
            değişken dt: metin = ifade_tip(p, deger, ht);
            eğer (metin_esit(dt, "?") == yanlış) ve (metin_esit(dt, ht) == yanlış) {
                dizi_ekle(p.th_kod, "T001");
                dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
                dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
            }
        }
        ver 0;
    }
    // YAPI_OLUSTUR: T002 (tip tanımsız → erken dön) → her alan [T017 / değer T002 +
    // T001] → eksik alan T012. C kontrol_yapi_olustur_ic sırası + konum birebir.
    eğer metin_esit(ad, "YAPI_OLUSTUR") {
        değişken tad: metin = dizi_al(p.a_deg, idx);
        eğer yapi_var_mi(p, tad) == yanlış {
            dizi_ekle(p.th_kod, "T002");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
            ver 0;   // C: yapı tanımsız → erken dönüş (alan kontrolü yok)
        }
        değişken ob: tam32 = dizi_al(p.a_cb, idx);
        değişken oc: tam32 = dizi_al(p.a_cs, idx);
        değişken i: tam32 = 0;
        iken i < oc {
            değişken aa: tam32 = dizi_al(p.cocuk, ob + i);   // ALAN_ATAMA
            değişken fad: metin = dizi_al(p.a_deg, aa);
            eğer alan_var_mi(p, tad, fad) == yanlış {
                dizi_ekle(p.th_kod, "T017");   // C: değer kontrol edilmez
                dizi_ekle(p.th_sat, dizi_al(p.a_sat, aa));
                dizi_ekle(p.th_sut, dizi_al(p.a_sut, aa));
            } değilse {
                değişken val: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, aa));
                kontrol_dugum(p, val);
                değişken ft: metin = alan_tip_bul(p, tad, fad);
                eğer metin_esit(ft, "?") == yanlış {
                    değişken vt: metin = ifade_tip(p, val, ft);
                    eğer (metin_esit(vt, "?") == yanlış) ve (metin_esit(vt, ft) == yanlış) {
                        dizi_ekle(p.th_kod, "T001");
                        dizi_ekle(p.th_sat, dizi_al(p.a_sat, aa));
                        dizi_ekle(p.th_sut, dizi_al(p.a_sut, aa));
                    }
                }
            }
            i = i + 1;
        }
        // eksik alan (T012): her yapı alanı construction'da var mı?
        değişken yi: tam32 = yapi_idx_bul(p, tad);
        değişken base: tam32 = dizi_al(p.yapi_abase, yi);
        değişken cnt: tam32 = dizi_al(p.yapi_acount, yi);
        değişken j: tam32 = 0;
        iken j < cnt {
            değişken fn: metin = dizi_al(p.alan_ad, base + j);
            değişken bulundu: mantıksal = yanlış;
            değişken k: tam32 = 0;
            iken k < oc {
                eğer metin_esit(dizi_al(p.a_deg, dizi_al(p.cocuk, ob + k)), fn) { bulundu = doğru; }
                k = k + 1;
            }
            eğer bulundu == yanlış {
                dizi_ekle(p.th_kod, "T012");
                dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
                dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
            }
            j = j + 1;
        }
        ver 0;
    }
    // TC5b: kullan(e)/imha(e) → operand T002 sonra lineer tüketim (L002 çift-tüketim).
    eğer metin_esit(ad, "KULLAN_IFADE") veya metin_esit(ad, "IMHA_IFADE") {
        değişken op: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
        kontrol_dugum(p, op);
        lin_tuket_dugum(p, op);
        ver 0;
    }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken cs: tam32 = dizi_al(p.a_cs, idx);
    değişken i: tam32 = 0;
    iken i < cs { kontrol_dugum(p, dizi_al(p.cocuk, cb + i)); i = i + 1; }
    // DEGISKEN/SABIT: çocuk T002'lerinden SONRA T001; VER: T020 (C sırası)
    eğer metin_esit(ad, "DEGISKEN") veya metin_esit(ad, "SABIT") { t001_kontrol(p, idx); }
    // TC5b: değişken — değer lineer bağlamaysa move-tüket; bağlama lineer ise izle.
    eğer metin_esit(ad, "DEGISKEN") {
        değişken vc2: tam32 = son_cocuk(p, idx);
        eğer vc2 >= 0 { lin_tuket_dugum(p, vc2); }   // move: değer lineer bağlamaysa tüket
        eğer deg_lineer_mi(p, idx) {
            lin_ekle(p, dizi_al(p.a_deg, idx), dizi_al(p.a_sat, idx), dizi_al(p.a_sut, idx));
        }
    }
    eğer metin_esit(ad, "VER") {
        t020_kontrol(p, idx);
        eğer dizi_al(p.a_cs, idx) > 0 { lin_tuket_dugum(p, dizi_al(p.cocuk, dizi_al(p.a_cb, idx))); }
    }
    eğer metin_esit(ad, "IKILI") { t003_kontrol(p, idx); t004_kontrol(p, idx); t028_kontrol(p, idx); }   // TC3e/f + T028
    eğer metin_esit(ad, "TEKLI") { tekli_kontrol(p, idx); }   // TC3f: neg/degil + TC5b L004
    ver 0;
}
// İşlev gövdesini (BLOK çocuğu) kontrol et.
işlev kontrol_govde(p: &değişken Ayr, fn: tam32) -> tam32 {
    p.aktif_donus = yerel_tip_filtrele(p, donus_str(p, fn));   // T020 bağlamı (generic dönüş "T" → "?")
    p.lin_basla = dizi_boyut(p.lin_ad);  // TC5b: aktif işlev lineer dilimi
    lin_param_topla(p, fn);              // lineer parametreler dilime
    değişken cb: tam32 = dizi_al(p.a_cb, fn);
    değişken cs: tam32 = dizi_al(p.a_cs, fn);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "BLOK") { kontrol_dugum(p, c); }
        i = i + 1;
    }
    lin_kapanis(p);   // TC5b: tüketilmemiş lineer bağlama → L001
    ver 0;
}
// Üst-düzeyleri gez: işlev gövdesi + sabit değeri kontrol; modül recurse.
işlev kontrol_ust(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        değişken ad: metin = dizi_al(p.a_ad, c);
        eğer metin_esit(ad, "ISLEV") {
            p.yerel_basla = dizi_boyut(p.yerel);
            yerel_topla(p, c);
            kontrol_govde(p, c);
        } değilse {
            eğer metin_esit(ad, "SABIT") {
                p.yerel_basla = dizi_boyut(p.yerel);
                kontrol_dugum(p, c);
            } değilse {
                eğer metin_esit(ad, "MODUL") { kontrol_ust(p, c); }
                değilse {
                    eğer metin_esit(ad, "DISA") {  // dışa <tanım> → iç tanımı kontrol
                        değişken dcb: tam32 = dizi_al(p.a_cb, c);
                        eğer dizi_al(p.a_cs, c) > 0 {
                            değişken ic: tam32 = dizi_al(p.cocuk, dcb);
                            eğer metin_esit(dizi_al(p.a_ad, ic), "ISLEV") {
                                p.yerel_basla = dizi_boyut(p.yerel);
                                yerel_topla(p, ic); kontrol_govde(p, ic);
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    ver 0;
}
// TC2: üst-düzey tanım adı (işlev/yapı/çeşit/sabit/özellik/modül; dışa içini aç).
işlev tanim_adi(p: &değişken Ayr, c: tam32) -> metin {
    değişken ad: metin = dizi_al(p.a_ad, c);
    eğer metin_esit(ad, "ISLEV") veya metin_esit(ad, "YAPI") veya metin_esit(ad, "CESIT")
      veya metin_esit(ad, "SABIT") veya metin_esit(ad, "OZELLIK") veya metin_esit(ad, "MODUL") {
        ver dizi_al(p.a_deg, c);
    }
    eğer metin_esit(ad, "DISA") {
        eğer dizi_al(p.a_cs, c) > 0 { ver dizi_al(p.a_deg, dizi_al(p.cocuk, dizi_al(p.a_cb, c))); }
    }
    ver "";   // UYGULA (ad yok) / KULLAN / HATA → dup-muaf
}
// Çift-tanım kodu: yapı/çeşit → T026, diğer (işlev/sabit/özellik/modül) → T024.
işlev dup_kod(p: &değişken Ayr, c: tam32) -> metin {
    değişken ad: metin = dizi_al(p.a_ad, c);
    eğer metin_esit(ad, "DISA") {
        eğer dizi_al(p.a_cs, c) > 0 { ad = dizi_al(p.a_ad, dizi_al(p.cocuk, dizi_al(p.a_cb, c))); }
    }
    eğer metin_esit(ad, "YAPI") veya metin_esit(ad, "CESIT") { ver "T026"; }
    ver "T024";
}
// Etkin tür (dışa-sarmalını aç): YAPI/CESIT/ISLEV/SABIT/MODUL/OZELLIK/UYGULA/...
işlev etkin_kind(p: &değişken Ayr, c: tam32) -> metin {
    değişken ad: metin = dizi_al(p.a_ad, c);
    eğer metin_esit(ad, "DISA") {
        eğer dizi_al(p.a_cs, c) > 0 { ver dizi_al(p.a_ad, dizi_al(p.cocuk, dizi_al(p.a_cb, c))); }
    }
    ver ad;
}
// Bir tanımı paylaşılan `gor` kümesine göre çift-tanım kontrol et + ekle.
işlev dup_isle(p: &değişken Ayr, gor: Dizi<metin>, c: tam32) -> tam32 {
    değişken nm: metin = tanim_adi(p, c);
    eğer metin_esit(nm, "") { ver 0; }
    değişken j: tam32 = 0;  değişken bulundu: mantıksal = yanlış;
    iken j < dizi_boyut(gor) {
        eğer metin_esit(dizi_al(gor, j), nm) { bulundu = doğru; }
        j = j + 1;
    }
    eğer bulundu {
        dizi_ekle(p.th_kod, dup_kod(p, c));
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, c));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, c));
    } değilse { dizi_ekle(gor, nm); }
    ver 0;
}
// TC2: ÜST-DÜZEY çift tanım (T024/T026). C pre_populate 4-geçiş sırası birebir:
// özellik → yapı/çeşit → (uygula: ad yok) → işlev/sabit/modül. Paylaşılan global
// kapsam (gor). İkinci tanımın konumunda hata. (Modül-içi/lokal → ileri TC.)
işlev dup_kontrol(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken gor: Dizi<metin> = [];
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {       // Geçiş 1: özellik
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(etkin_kind(p, c), "OZELLIK") { dup_isle(p, gor, c); }
        i = i + 1;
    }
    i = 0;
    iken i < cs {       // Geçiş 2: yapı + çeşit
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        değişken k: metin = etkin_kind(p, c);
        eğer metin_esit(k, "YAPI") veya metin_esit(k, "CESIT") { dup_isle(p, gor, c); }
        i = i + 1;
    }
    i = 0;
    iken i < cs {       // Geçiş 3 (uygula: ad yok) atlanır; Geçiş 4: işlev+sabit+modül
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        değişken k: metin = etkin_kind(p, c);
        eğer metin_esit(k, "ISLEV") veya metin_esit(k, "SABIT") veya metin_esit(k, "MODUL") {
            dup_isle(p, gor, c);
        }
        i = i + 1;
    }
    ver 0;
}
// TC5a: yapı lineer alan içeremez (LR002). Lineer tip = tekkez/yetki/görev.
işlev tip_node_lineer_mi(ad: metin) -> mantıksal {
    ver metin_esit(ad, "TIP_TEKKEZ") veya metin_esit(ad, "TIP_YETKI")
      veya metin_esit(ad, "TIP_GOREV");
}
işlev lr002_yapi(p: &değişken Ayr, yapi: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, yapi);
    değişken cs: tam32 = dizi_al(p.a_cs, yapi);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "ALAN") {
            değişken tc: tam32 = son_cocuk(p, c);
            eğer (tc >= 0) ve tip_node_lineer_mi(dizi_al(p.a_ad, tc)) {
                dizi_ekle(p.th_kod, "LR002");
                dizi_ekle(p.th_sat, dizi_al(p.a_sat, c));
                dizi_ekle(p.th_sut, dizi_al(p.a_sut, c));
            }
        }
        i = i + 1;
    }
    ver 0;
}
// Üst-düzey + modül + dışa YAPI'lar üzerinde LR002 (pre-pass — gövdelerden ÖNCE).
işlev lr002_kontrol(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        değişken ad: metin = dizi_al(p.a_ad, c);
        eğer metin_esit(ad, "YAPI") { lr002_yapi(p, c); }
        eğer metin_esit(ad, "MODUL") { lr002_kontrol(p, c); }
        eğer metin_esit(ad, "DISA") {
            eğer dizi_al(p.a_cs, c) > 0 {
                değişken ic: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, c));
                eğer metin_esit(dizi_al(p.a_ad, ic), "YAPI") { lr002_yapi(p, ic); }
            }
        }
        i = i + 1;
    }
    ver 0;
}
// ---- TC8a: cross-file/modül import — `kullan` ile dışa sembol toplama ----
// Bir yolun dizin kısmı (son '/' öncesi); '/' yoksa "".
işlev dizin_al(yol: metin) -> metin {
    değişken n: tam32 = metin_uzunluk(yol);
    değişken son: tam32 = 0 - 1;
    değişken i: tam32 = 0;
    iken i < n { eğer metin_bayt(yol, i) == 47 { son = i; } i = i + 1; }   // 47 = '/'
    eğer son < 0 { ver ""; }
    ver metin_kes(yol, 0, son);
}
// Modül yolu (a::b::c) → göreli dosya yolu (a/b/c.kem).
işlev modul_path(modul_yol: metin) -> metin {
    ver metin_birlestir(metin_yer_degistir(modul_yol, "::", "/"), ".kem");
}
// Modül içeriğini 3 arama yoluyla oku (C modulleri_yukle: dizin → kök → kütüphane/).
// Bulunamazsa "" (T040 → TC8b; şimdilik atla).
işlev modul_icerik(dizin: metin, rel: metin) -> metin {
    eğer metin_uzunluk(dizin) > 0 {
        değişken a0: metin = metin_birlestir(metin_birlestir(dizin, "/"), rel);
        eğer dosya_var_mi(a0) { ver dosya_oku(a0); }
    }
    eğer dosya_var_mi(rel) { ver dosya_oku(rel); }
    değişken a2: metin = metin_birlestir("kütüphane/", rel);
    eğer dosya_var_mi(a2) { ver dosya_oku(a2); }
    ver "";
}
// Bir modülü yükle: dışa-export adlarını p.g_isim'e ekle; kullan'ı transitif izle.
işlev modul_yukle(p: &değişken Ayr, modul_yol: metin, importer_dizin: metin) -> tam32 {
    değişken gn: tam32 = dizi_boyut(p.kullan_gorulen);
    değişken gi: tam32 = 0;
    iken gi < gn { eğer metin_esit(dizi_al(p.kullan_gorulen, gi), modul_yol) { ver 0; } gi = gi + 1; }
    dizi_ekle(p.kullan_gorulen, modul_yol);
    değişken rel: metin = modul_path(modul_yol);
    değişken ic: metin = modul_icerik(importer_dizin, rel);
    eğer metin_esit(ic, "") { ver 0; }   // bulunamadı (T040 → TC8b)
    değişken mp: Ayr = ayr_olustur(ic);
    lex_et(&değişken mp);
    değişken mkok: tam32 = parse_program(&değişken mp);
    değişken mdiz: metin = dizin_al(rel);   // transitif importer dizini
    değişken cb: tam32 = dizi_al(mp.a_cb, mkok);
    değişken cs: tam32 = dizi_al(mp.a_cs, mkok);
    değişken ci: tam32 = 0;
    iken ci < cs {
        değişken c: tam32 = dizi_al(mp.cocuk, cb + ci);
        değişken cad: metin = dizi_al(mp.a_ad, c);
        eğer metin_esit(cad, "DISA") {   // dışa <tanım> → iç tanım adı flat-görünür
            eğer dizi_al(mp.a_cs, c) > 0 {
                değişken inner: tam32 = dizi_al(mp.cocuk, dizi_al(mp.a_cb, c));
                g_ekle(p, dizi_al(mp.a_deg, inner));
            }
        }
        eğer metin_esit(cad, "KULLAN") { modul_yukle(p, dizi_al(mp.a_deg, c), mdiz); }
        ci = ci + 1;
    }
    ver 0;
}
// Üst-düzey tüm `kullan`'ları yükle (giriş dosyasının dizininden).
işlev kullan_yukle_hepsi(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "KULLAN") {
            modul_yukle(p, dizi_al(p.a_deg, c), p.giris_dizin);
        }
        i = i + 1;
    }
    ver 0;
}
işlev kontrol_program(p: &değişken Ayr, kok: tam32) -> tam32 {
    builtin_ekle(p);
    kullan_yukle_hepsi(p, kok);   // TC8a: cross-file dışa semboller (T002'den ÖNCE)
    genel_topla(p, kok);
    dup_kontrol(p, kok);     // T024 (üst-düzey çift tanım) — T002'den ÖNCE
    lr002_kontrol(p, kok);   // TC5a: yapı lineer alan (LR002) — gövdelerden ÖNCE
    kontrol_ust(p, kok);
    ver 0;
}

işlev ayr_olustur(kaynak: metin) -> Ayr {
    ver Ayr {
        kaynak: kaynak,
        t_ad: [], t_sat: [], t_sut: [], t_off: [], t_uz: [],
        imlec: 0,
        a_ad: [], a_deg: [], a_sat: [], a_sut: [], a_cb: [], a_cs: [], cocuk: [],
        hata_say: 0,
        yapi_izni: 1,
        sk_pending: 0,
        reg: 0,
        cg_ad: [], cg_areg: [], cg_atip: [], cg_aref: [], son_ref: "", cg_base: 0,
        cg_aelem: [], cg_apointee: [], cg_aic: [], beklenen_elem: "", son_elem: "", beklenen_ll: "",
        cv_cesit: [], cv_ad: [], cv_pc: [], cc_ad: [], cc_node: [],
        lbl: 0, bb_term: 0,
        fn_ad: [], fn_ret: [], son_tip: "i32", cur_ret: "i32", rho_ref: "%rho",
        ky_node: [], ky_base: 0, ky_iter_node: [], ky_iter_base: 0, ky_lambda: 0, rho_yerel: "", uygula_hedef: "", sc_slot: "", rho_iter: "", dongu_d: 0, ciplak_aktif: 0,
        pa_node: [], pa_reg: [], pa_base: 0,
        lam_node: [], lam_ad: [], lam_capbase: [], lam_capcount: [], lam_capisim: [], lam_capir: [], lam_sayac: 0,
        str_deg: [],
        yapi_ad: [], yapi_abase: [], yapi_acount: [], alan_ad: [], alan_tip: [], alan_elem: [],
        g_isim: [], g_kuresel_ad: [], g_kuresel_tip: [], g_ciplak: [], yerel: [], yerel_tip: [], yerel_basla: 0, aktif_donus: "boş",
        fn_donus: [], fn_psay: [], fn_pbase: [], fn_ptip: [], fn_plin: [],
        giris_dizin: "", kullan_gorulen: [],
        lin_ad: [], lin_sat: [], lin_sut: [], lin_tuk: [], lin_basla: 0,
        th_kod: [], th_sat: [], th_sut: []
    };
}

// ---- AŞAMA 4: --token dökümü (lex_et tabloları → C --token formatı) ----
// Format: <TIP>\t<satır>\t<sütun>\t<offset>\t<uzunluk>\n (DOSYA_SONU dahil son satır).
// lexer.kem lex_dosya/emit PORT EDİLMEDİ (divergent helper'lar); codegen lex_et yeniden kullanılır.
işlev token_dump(p: &değişken Ayr) -> tam32 {
    değişken n: tam32 = dizi_boyut(p.t_ad);
    değişken i: tam32 = 0;
    iken i < n {
        yaz_str(dizi_al(p.t_ad, i));  yb(9);
        yaz_tam(dizi_al(p.t_sat, i)); yb(9);
        yaz_tam(dizi_al(p.t_sut, i)); yb(9);
        yaz_tam(dizi_al(p.t_off, i)); yb(9);
        yaz_tam(dizi_al(p.t_uz, i));  yb(10);
        i = i + 1;
    }
    ver 0;
}

// ---- AŞAMA 4 (driver): birleşik dispatch — tek self-host kemgu binary ----
//   --token  → C --token (lexer dump)        --check → C --checkdump (KOD\tsat\tsüt / OK)
//   --parse  → C --ast    (düz AST dump)      --llvm  → C --llvm     (LLVM IR; varsayılan)
//   Flag yok → --llvm (codegen_diff/bootstrap harness geri uyumu: `<file>` → IR).
işlev main() -> tam32 {
    eğer arg_sayi() < 2 {
        yaz_str("kullanim: kemgu [--token|--parse|--check|--llvm] <kaynak.kem>"); yb(10);
        ver 1;
    }
    değişken mod: metin = "--llvm";      // varsayılan (no-flag geri uyum)
    değişken yol: metin = arg_al(1);
    eğer arg_sayi() >= 3 { mod = arg_al(1); yol = arg_al(2); }
    değişken kaynak: metin = dosya_oku(yol);
    değişken p: Ayr = ayr_olustur(kaynak);
    lex_et(&değişken p);
    eğer metin_esit(mod, "--token") { token_dump(&değişken p); ver 0; }
    değişken kok: tam32 = parse_program(&değişken p);
    eğer metin_esit(mod, "--parse") { duz_yaz(&değişken p, kok, 0); ver 0; }
    eğer metin_esit(mod, "--check") {
        p.giris_dizin = dizin_al(yol);   // import arama yolu (cross-file)
        kontrol_program(&değişken p, kok);
        değişken nh: tam32 = dizi_boyut(p.th_kod);
        eğer nh == 0 { yaz_str("OK"); yb(10); ver 0; }
        değişken i: tam32 = 0;
        iken i < nh {
            yaz_str(dizi_al(p.th_kod, i)); yb(9);
            yaz_tam(dizi_al(p.th_sat, i)); yb(9);
            yaz_tam(dizi_al(p.th_sut, i)); yb(10);
            i = i + 1;
        }
        ver 0;
    }
    // --llvm (varsayılan)
    program_uret(&değişken p, kok);
    ver 0;
}
