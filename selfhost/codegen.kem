        // görev_başlat + DUGUM_LAMBDA fat-value aynası: env-null (capture yok) ya da
        // heap-env (capture var); lifted @lambda_N gövde-SONRASI emit (kuyruk).
        eğer metin_esit(fad, "görev_başlat") {
            değişken lam: tam32 = dizi_al(p.cocuk, cb + 1);
            // Mangled ad
            değişken mad: metin = metin_birlestir("lambda_", tam64_str(p.lam_sayac olarak tam64));
            p.lam_sayac = p.lam_sayac + 1;
            // Capture analizi (çevre scope canlıyken). Lambda gövdesi = SON çocuk.
            değişken lcb: tam32 = dizi_al(p.a_cb, lam);
            değişken lcs: tam32 = dizi_al(p.a_cs, lam);
            değişken govde: tam32 = dizi_al(p.cocuk, lcb + lcs - 1);
            değişken capbase: tam32 = dizi_boyut(p.lam_capisim);
            lam_cap_tara(p, govde, lam, capbase);
            değişken capcnt: tam32 = dizi_boyut(p.lam_capisim) - capbase;
            // Env: capture yoksa null; varsa HEAP struct (C V2-F2 aynası).
            // D-322: emisyon lam_env_uret'e taşındı — genel kapanış kolu AYNI kodu
            // kullanır (iki kopya ayrışırsa görev/kapanış env düzeni sessizce sapardı).
            değişken envreg: metin = lam_env_uret(p, capbase, capcnt);
            // Runtime çağrısı: fn AYNI ptr iki kez (bare/kapanış), env üçüncü.
            değişken gr: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(gr));
            yaz_str(" = call ptr @kdl_gorev_basla_kapanis(ptr @"); yaz_str(mad);
            yaz_str(", ptr @"); yaz_str(mad); yaz_str(", ptr "); yaz_str(envreg);
            // D-309: ρ_sahip POZİTİF hapsedilme kanıtı (C gorev_rho_confined aynası).
            // Kanıtlıysa runtime join'de ρ_sahip'i geri verir; değilse sızdırır.
            yaz_str(", i32 ");
            eğer rho_confined(p, govde) { yaz_str("1"); } değilse { yaz_str("0"); }
            yaz_str(")"); yb(10);
            // Karar 1 (D-30x): görev_başlat → sonuç<görev<T>, metin>. görev<T> ve
            // metin ikisi de IR'de ptr → aggregate DAİMA { i8, ptr, ptr } (T'den
            // bağımsız). DALLANMASIZ sarma: tag = (handle==null)?1:0; 3 alan da
            // koşulsuz dolu — okuyucu tag'e göre alan1 (handle) ya da alan2 (hata
            // metni) okur. Runtime spawn başarısızsa NULL döner (panik YOK). C
            // llvm.c görev_başlat sonuç-sarma aynası.
            değişken isn: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(isn));
            yaz_str(" = icmp eq ptr "); yaz_str(reg_str(gr)); yaz_str(", null"); yb(10);
            değişken tg: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(tg));
            yaz_str(" = zext i1 "); yaz_str(reg_str(isn)); yaz_str(" to i8"); yb(10);
            değişken slot: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(slot));
            yaz_str(" = alloca { i8, ptr, ptr }"); yb(10);
            değişken f0: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(f0));
            yaz_str(" = getelementptr { i8, ptr, ptr }, ptr "); yaz_str(reg_str(slot));
            yaz_str(", i32 0, i32 0"); yb(10);
            yaz_str("  store i8 "); yaz_str(reg_str(tg)); yaz_str(", ptr "); yaz_str(reg_str(f0)); yb(10);
            değişken f1: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(f1));
            yaz_str(" = getelementptr { i8, ptr, ptr }, ptr "); yaz_str(reg_str(slot));
            yaz_str(", i32 0, i32 1"); yb(10);
            yaz_str("  store ptr "); yaz_str(reg_str(gr)); yaz_str(", ptr "); yaz_str(reg_str(f1)); yb(10);
            değişken em: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(em));
            yaz_str(" = getelementptr [20 x i8], ptr @.gorev_hata_str, i32 0, i32 0"); yb(10);
            değişken f2: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(f2));
            yaz_str(" = getelementptr { i8, ptr, ptr }, ptr "); yaz_str(reg_str(slot));
            yaz_str(", i32 0, i32 2"); yb(10);
            yaz_str("  store ptr "); yaz_str(reg_str(em)); yaz_str(", ptr "); yaz_str(reg_str(f2)); yb(10);
            değişken ld: tam32 = yeni_reg(p);
            yaz_str("  "); yaz_str(reg_str(ld));
            yaz_str(" = load { i8, ptr, ptr }, ptr "); yaz_str(reg_str(slot)); yb(10);
            // Lifted lambda'yı kuyruğa al (gövde-sonrası emit).
            dizi_ekle(p.lam_node, lam);
            dizi_ekle(p.lam_ad, mad);
            dizi_ekle(p.lam_capbase, capbase);
            dizi_ekle(p.lam_capcount, capcnt);
            dizi_ekle(p.lam_ret, "i64");   // D-322: görev yolu = runtime i64 taşıyıcı
            p.son_tip = "{ i8, ptr, ptr }"; p.son_elem = ""; p.son_ref = "";
            // D-396: görev<T>'nin T'sini YAYINLA. Aggregate `{ i8, ptr, ptr }` T'yi
            // SİLER (görev<T> ve metin ikisi de ptr) → `eşleş tamam(g)` ile bağlanan
            // `g`nin iç tipi başka hiçbir yerden kurtarılamaz. T = lifted lambda'nın
            // DOĞAL dönüş IR'ı (kuyruğa yazılan "i64" runtime TAŞIYICISIDIR, T değil).
            // Yazılmazsa `görev_birleştir(g)` hedef tipi "" görür, i64_daralt i64'te
            // kalır ve ptr yuvasına yazılır → `i64 but expected ptr` (gorev_temel).
            p.son_ic = lam_ret_tahmin(p, govde);
            ver reg_str(ld);
        }
        // ---- D-397: SIMD yerleşikleri (C llvm.c aynası) ----
        // vektor_doldur(s) → splat. Beklenen "<N x T>" ise ondan; yoksa C ile AYNI
        // varsayılan `<4 x i32>` (uydurmadım, oracle'dan ölçtüm).
        eğer metin_esit(fad, "vektor_doldur") ve (cs == 2) {
            değişken vt: metin = p.beklenen_ll;
            eğer vek_ir_mi(vt) == yanlış { vt = "<4 x i32>"; }
            değişken el: metin = vek_elem(vt);
            değişken ln: metin = vek_lane(vt);
            değişken eski: metin = p.beklenen_ll;
            p.beklenen_ll = el;   // skaler argüman eleman tipinde üretilmeli
            değişken sv: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            p.beklenen_ll = eski;
            değişken r1: metin = reg_str(yeni_reg(p));
            yaz_str("  "); yaz_str(r1); yaz_str(" = insertelement "); yaz_str(vt);
            yaz_str(" undef, "); yaz_str(el); yaz_str(" "); yaz_str(sv);
            yaz_str(", i32 0"); yb(10);
            değişken r2: metin = reg_str(yeni_reg(p));
            yaz_str("  "); yaz_str(r2); yaz_str(" = shufflevector "); yaz_str(vt);
            yaz_str(" "); yaz_str(r1); yaz_str(", "); yaz_str(vt);
            yaz_str(" undef, <"); yaz_str(ln); yaz_str(" x i32> zeroinitializer"); yb(10);
            p.son_tip = vt; p.son_elem = ""; p.son_ref = ""; p.son_ic = "";
            ver r2;
        }
        // vektor_eleman(v, i) -> T (extractelement). Eleman tipi DEĞERİN IR'ından
        // okunur — beklenen tipten DEĞİL (beklenen T'dir, vektör değil).
        eğer metin_esit(fad, "vektor_eleman") ve (cs == 3) {
            değişken eskib: metin = p.beklenen_ll;
            p.beklenen_ll = "";
            değişken vv: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            değişken vt2: metin = p.son_tip;
            p.beklenen_ll = "i32";
            değişken iv: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 2));
            p.beklenen_ll = eskib;
            değişken el2: metin = "i32";
            eğer vek_ir_mi(vt2) { el2 = vek_elem(vt2); }
            değişken r3: metin = reg_str(yeni_reg(p));
            yaz_str("  "); yaz_str(r3); yaz_str(" = extractelement "); yaz_str(vt2);
            yaz_str(" "); yaz_str(vv); yaz_str(", i32 "); yaz_str(iv); yb(10);
            p.son_tip = el2; p.son_elem = ""; p.son_ref = ""; p.son_ic = "";
            ver r3;
        }
        // vektor_topla(v) -> T. Kesirli eleman → reduce.fadd (SIRALI toplama için
        // başlangıç operandı 0.0 ŞART); tamsayı → reduce.add (başlangıç YOK).
        // İki intrinsic'in ARİTELERİ farklı — karıştırmak LLVM-red verir.
        eğer metin_esit(fad, "vektor_topla") ve (cs == 2) {
            değişken eskib2: metin = p.beklenen_ll;
            p.beklenen_ll = "";
            değişken vv2: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            değişken vt3: metin = p.son_tip;
            p.beklenen_ll = eskib2;
            değişken el3: metin = "i32";
            değişken ln3: metin = "4";
            eğer vek_ir_mi(vt3) { el3 = vek_elem(vt3); ln3 = vek_lane(vt3); }
            değişken r4: metin = reg_str(yeni_reg(p));
            yaz_str("  "); yaz_str(r4); yaz_str(" = call "); yaz_str(el3);
            eğer metin_esit(el3, "float") veya metin_esit(el3, "double") {
                yaz_str(" @llvm.vector.reduce.fadd.v"); yaz_str(ln3);
                yaz_str(vek_abbr(el3)); yaz_str("("); yaz_str(el3); yaz_str(" 0.0, ");
                yaz_str(vt3); yaz_str(" "); yaz_str(vv2); yaz_str(")"); yb(10);
            } değilse {
                yaz_str(" @llvm.vector.reduce.add.v"); yaz_str(ln3);
                yaz_str(vek_abbr(el3)); yaz_str("("); yaz_str(vt3); yaz_str(" ");
                yaz_str(vv2); yaz_str(")"); yb(10);
            }
            p.son_tip = el3; p.son_elem = ""; p.son_ref = ""; p.son_ic = "";
            ver r4;
        }
        // D-405: `bölge_al(yetki, N)` → küresel bölge işaretçisi.
        // **C ARGÜMANLARI YOK SAYAR** ve parametresiz `@kdl_global_bolge_al()`
        // çağırır (ölçüldü, tahmin değil) — yani ARİTE FARKLI, salt ad eşlemesi
        // (`builtin_kdl_ad`) YETMEZ; genel çağrı yolu argümanları basacaktı.
        // Eşleme hiç yoktu → self-host `call i32 @"bölge_al"(...)` üretiyordu:
        // hem TANIMSIZ SEMBOL hem YANLIŞ TİP (`store ptr %N` beklenen yerde i32).
        // `kütüphane/dizi.kem`in `oluştur`u bunu kullanıyor → kalan 7 modül
        // dosyasının ORTAK takoz noktasıydı. "Dönüş-tipi-güdümlü çıkarsama"
        // sandığım şeyin ALTINDA bu duruyordu — kökü ölçmeden büyük bir özellik
        // yazmaya kalksaydım yanlış yeri onarırdım.
        eğer metin_esit(fad, "bölge_al") {
            değişken br: metin = reg_str(yeni_reg(p));
            yaz_str("  "); yaz_str(br); yaz_str(" = call ptr @kdl_global_bolge_al()"); yb(10);
            p.son_tip = "ptr"; p.son_elem = ""; p.son_ref = ""; p.son_ic = "";
            ver br;
        }
        // ---- D-404: Capability Spec V1 yerleşikleri (C llvm.c aynası) ----
        // yetki_olustur(kaynak_tipi, izin) -> yetki<R>. OUT-PTR ABI: dönüş
        // register'da DEĞİL, çağıran alloca'yı geçer. Argümanlar i16.
        eğer metin_esit(fad, "yetki_olustur") ve (cs == 3) {
            değişken eskiy: metin = p.beklenen_ll;
            p.beklenen_ll = "i16";
            değişken kt: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            değişken ktt: metin = p.son_tip;
            değişken iz: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 2));
            değişken izt: metin = p.son_tip;
            p.beklenen_ll = eskiy;
            // Literaller i32 gelebilir → i16'ya uydur. `int_uydur` kaynağı
            // `p.son_tip`ten okur, o yüzden önce geri yükleniyor. (Immediate ise
            // dokunmaz — literal zaten beklenen bağlamla i16 basılır.)
            p.son_tip = ktt; kt = int_uydur(p, kt, "i16", 0);
            p.son_tip = izt; iz = int_uydur(p, iz, "i16", 0);
            değişken slot: metin = reg_str(yeni_reg(p));
            yaz_str("  "); yaz_str(slot); yaz_str(" = alloca %kdl_yetki"); yb(10);
            yaz_str("  call void @kdl_yetki_olustur(ptr "); yaz_str(slot);
            yaz_str(", i16 "); yaz_str(kt); yaz_str(", i16 "); yaz_str(iz); yaz_str(")"); yb(10);
            değişken yv: metin = reg_str(yeni_reg(p));
            yaz_str("  "); yaz_str(yv); yaz_str(" = load %kdl_yetki, ptr "); yaz_str(slot); yb(10);
            p.son_tip = "%kdl_yetki"; p.son_elem = ""; p.son_ref = ""; p.son_ic = "";
            ver yv;
        }
        // geri_al(y) — yetkiyi TÜKETİR. Runtime SLOT ADRESİ ister (değer değil),
        // çünkü yetkiyi yerinde geçersizleştirir. Argüman bir TANIMLAYICI ise
        // alloca'sı doğrudan geçilir; değilse geçici slota yazılıp adresi verilir.
        eğer metin_esit(fad, "geri_al") ve (cs == 2) {
            değişken an: tam32 = dizi_al(p.cocuk, cb + 1);
            değişken adr: metin = "";
            eğer metin_esit(dizi_al(p.a_ad, an), "TANIMLAYICI") {
                adr = cg_var_bul(p, dizi_al(p.a_deg, an));
            }
            eğer metin_esit(adr, "") {
                değişken v: metin = ifade_uret(p, an);
                değişken ts: metin = reg_str(yeni_reg(p));
                yaz_str("  "); yaz_str(ts); yaz_str(" = alloca %kdl_yetki"); yb(10);
                yaz_str("  store %kdl_yetki "); yaz_str(v); yaz_str(", ptr "); yaz_str(ts); yb(10);
                adr = ts;
            }
            yaz_str("  call void @kdl_yetki_geri_al(ptr "); yaz_str(adr); yaz_str(")"); yb(10);
            p.son_tip = "void"; p.son_elem = ""; p.son_ref = ""; p.son_ic = "";
            ver "0";
        }
        // D-408: `ifşa(e)` — Sabitsüre Spec declassify. PASS-THROUGH (sıfır
        // talimat); gizlilik muhasebesi tamamen TİP KONTROLDE yaşar, IR'da izi
        // yoktur. C ölçüldü: hiçbir çağrı yaymıyor. Bu dal olmadan genel çağrı
        // yoluna düşüp TANIMSIZ `@ifşa` üretiyordu (`tekkez_olustur`/`dondur`
        // ile aynı sınıf).
        eğer metin_esit(fad, "ifşa") ve (cs == 2) {
            ver ifade_uret(p, dizi_al(p.cocuk, cb + 1));
        }
        eğer metin_esit(fad, "tekkez_olustur") ve (cs == 2) {
            // D-319: tekkez_olustur(e) — PASS-THROUGH (sıfır talimat). Lineer
            // muhasebe tamamen tip kontrolde; bu dal olmadan genel çağrı yoluna
            // düşüp TANIMSIZ @tekkez_olustur üretiyordu (link hatası).
            ver ifade_uret(p, dizi_al(p.cocuk, cb + 1));
        }
        eğer metin_esit(fad, "dondur") {
            // dondur(v: &değişken T) -> &T — V1'de TİP-seviyesi işlem; runtime
            // temsili aynı ptr → identity, sıfır talimat (C ile birebir).
            ver ifade_uret(p, dizi_al(p.cocuk, cb + 1));
        }
        // D-303: gönderen(k)/alan(k) — kanal yön ucu projeksiyonu. Runtime-free
        // IDENTITY (dondur gibi): uçlar aynı KdlKanal* ptr'ına type-level görünüm.
        // Yön güvenliği tip kontrolünde (C tarafı). fn_var_mi guard = C'nin `!ik`
        // aynası: kullanıcının `alan`/`gönderen` adlı İŞLEVİ varsa ONA düşer
        // (`alan`="alan/bölge" yaygın; isim gaspı yok — cg_cesit_payload'daki
        // gerçek `işlev alan(s: Şekil)` bunu kanıtladı).
        eğer (metin_esit(fad, "gönderen") veya metin_esit(fad, "alan"))
             ve (fn_var_mi(p, fad) == yanlış) {
            ver ifade_uret(p, dizi_al(p.cocuk, cb + 1));
        }
        eğer metin_esit(fad, "kanal_oluştur") {
            değişken kkap: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            değişken rk: tam32 = yeni_reg(p);
            değişken rks: metin = reg_str(rk);
            yaz_str("  "); yaz_str(rks); yaz_str(" = call ptr @kdl_kanal_olustur(i32 ");
            yaz_str(kkap); yaz_str(")"); yb(10);
            p.son_tip = "ptr"; p.son_elem = ""; p.son_ref = "";
            ver rks;
        }
        eğer metin_esit(fad, "kanal_gönder") {
            değişken kgk: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            değişken kgv: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 2));
            // Taşıyıcı i64: değeri DOĞAL tipinden genişlet (kırpma YOK).
            değişken kg64: metin = i64_genislet(p, kgv, p.son_tip);
            yaz_str("  call void @kdl_kanal_gonder(ptr "); yaz_str(kgk);
            yaz_str(", i64 "); yaz_str(kg64); yaz_str(")"); yb(10);
            // Çağıran bir değer bekliyor — void yerine yer tutucu (built-in deseni).
            değişken rpz: tam32 = yeni_reg(p);
            değişken rpzs: metin = reg_str(rpz);
            yaz_str("  "); yaz_str(rpzs); yaz_str(" = add i32 0, 0"); yb(10);
            p.son_tip = "i32"; p.son_elem = ""; p.son_ref = "";
            ver rpzs;
        }
        eğer metin_esit(fad, "kanal_al") {
            değişken kad: tam32 = dizi_al(p.cocuk, cb + 1);
            değişken kat: metin = cagri_ic_tip(p, kad);   // bildirilen kanal<T> → T
            değişken kak: metin = ifade_uret(p, kad);
            ver i64_daralt(p, "kdl_kanal_al", kak, kat);
        }
        eğer metin_esit(fad, "görev_birleştir") {
            değişken gbd: tam32 = dizi_al(p.cocuk, cb + 1);
            değişken gbt: metin = cagri_ic_tip(p, gbd);   // bildirilen görev<T> → T
            değişken gbg: metin = ifade_uret(p, gbd);
            ver i64_daralt(p, "kdl_gorev_birlestir", gbg, gbt);
        }
        // CG8: dizi_* element-tip polimorfik built-in'leri (özel — arg sırasına bağlı).
        // D-389: `dizi_olustur(N)` FONKSİYON-ÇAĞRISI formu. Literal `[..]` yolu
        // (parse_dizi_olustur) zaten doğruydu; ama çağrı-formu özel-durumsuz
        // olduğundan genel builtin yoluna düşüp `call i32 @dizi_olustur` (yanlış
        // ad + yanlış dönüş + eksik kapasite_ayarla) üretiyordu → clang "i32 but
        // expected ptr" (B sınıfı, 9 dosya). C llvm.c'nin çağrı-formu aynası:
        //   %r = call ptr @kdl_dizi_olustur(ρ, eleman_byte)   [kapasite DEĞİL]
        //   call void @kdl_dizi_kapasite_ayarla(ρ, %r, N)      [kullanıcının N'i]
        // eleman_byte: C güvenlik kuralı (D-030) — BİLİNMEYEN eleman = 8 (güvenli
        // üst sınır; 4 yazmak ptr/i64 dizisini yarı-rezerve edip HEAP-OVERFLOW
        // ediyordu). dizi_eleman_byte("") "4" döndürdüğü için boş durumu ELLE 8.
        eğer metin_esit(fad, "dizi_olustur") {
            değişken doelem: metin = p.beklenen_elem;
            değişken doeb: metin = "8";
            eğer metin_esit(doelem, "") == yanlış { doeb = dizi_eleman_byte(doelem); }
            değişken dokap: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            değişken dor: tam32 = yeni_reg(p);
            değişken dors: metin = reg_str(dor);
            yaz_str("  "); yaz_str(dors); yaz_str(" = call ptr @kdl_dizi_olustur(ptr ");
            yaz_str(p.rho_ref); yaz_str(", i32 "); yaz_str(doeb); yaz_str(")"); yb(10);
            yaz_str("  call void @kdl_dizi_kapasite_ayarla(ptr ");
            yaz_str(p.rho_ref); yaz_str(", ptr "); yaz_str(dors);
            yaz_str(", i32 "); yaz_str(dokap); yaz_str(")"); yb(10);
            p.son_tip = "ptr"; p.son_elem = doelem; p.son_ref = "";
            ver dors;
        }
        eğer metin_esit(fad, "dizi_boyut") {
            değişken d: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            değişken r: tam32 = yeni_reg(p);
            değişken rs: metin = reg_str(r);
            yaz_str("  "); yaz_str(rs); yaz_str(" = call i32 @kdl_dizi_boyut(ptr "); yaz_str(d); yaz_str(")"); yb(10);
            p.son_tip = "i32"; p.son_elem = ""; p.son_ref = "";
            ver rs;
        }
        eğer metin_esit(fad, "dizi_ekle") {
            değişken d2: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            değişken e: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 2));
            değişken et: metin = p.son_tip;
            eğer dizi_eleman_yapi_mi(et) {   // D-342: by-value eleman
                dizi_yapi_ekle_emit(p, p.rho_ref, d2, et, e);
            }
            değilse {
                yaz_str("  call void @kdl_dizi_ekle_"); yaz_str(dizi_ekle_sonek(et)); yaz_str("(ptr ");
                yaz_str(p.rho_ref); yaz_str(", ptr ");   // V2-F4.2a: ρ
                yaz_str(d2); yaz_str(", "); yaz_str(dizi_arg_tip(et)); yaz_str(" "); yaz_str(e); yaz_str(")"); yb(10);
            }
            p.son_tip = "void"; p.son_elem = ""; p.son_ref = "";
            ver "0";
        }
        eğer metin_esit(fad, "dizi_yaz") {
            değişken dy: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            değişken iy: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 2));
            değişken vy: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 3));
            değişken vty: metin = p.son_tip;
            eğer dizi_eleman_yapi_mi(vty) {   // D-342: by-value eleman
                dizi_yapi_yaz_emit(p, dy, iy, vty, vy);
            }
            değilse {
                yaz_str("  call void @kdl_dizi_yaz_"); yaz_str(dizi_ekle_sonek(vty)); yaz_str("(ptr ");
                yaz_str(dy); yaz_str(", i32 "); yaz_str(iy); yaz_str(", "); yaz_str(dizi_arg_tip(vty));
                yaz_str(" "); yaz_str(vy); yaz_str(")"); yb(10);
            }
            p.son_tip = "void"; p.son_elem = ""; p.son_ref = "";
            ver "0";
        }
        eğer metin_esit(fad, "dizi_al") {
            değişken d3: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            değişken elem: metin = p.son_elem;
            değişken i3: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 2));
            eğer metin_esit(elem, "") { elem = "i32"; }
            eğer dizi_eleman_yapi_mi(elem) {   // D-342: by-value eleman
                değişken fr3: metin = dizi_yapi_al_emit(p, d3, i3, elem);
                p.son_tip = elem; p.son_elem = ""; p.son_ref = "";
                ver fr3;
            }
            değişken r3: tam32 = yeni_reg(p);
            değişken rs3: metin = reg_str(r3);
            yaz_str("  "); yaz_str(rs3); yaz_str(" = call "); yaz_str(dizi_al_rettip(elem));
            yaz_str(" @kdl_dizi_al_"); yaz_str(dizi_al_sonek(elem)); yaz_str("(ptr "); yaz_str(d3);
            yaz_str(", i32 "); yaz_str(i3); yaz_str(")"); yb(10);
            p.son_tip = dizi_al_rettip(elem); p.son_elem = ""; p.son_ref = "";
            ver rs3;
        }
        // D-322: KAPANIŞ ÇAĞRISI — hedef, fat value { fnptr, envptr } tutan yerel
        // bağlama ise dolaylı çağır. Bu kol olmadan `f()` bir üst-düzey işlev
        // sanılıp TANIMSIZ `@f` üretiliyordu (link hatası; ölçüldü).
        // ABI (C llvm.c aynası): fn(ptr %rho [, ptr %env], args...); env null ise
        // bare çağrı. İki dal AYRI `call` gerektirir (imza farklı) → sonuç slot'ta
        // buluşur. Argümanlar fat value YÜKLENMEDEN ÖNCE değerlendirilir (C sırası).
        eğer fn_var_mi(p, fad) == yanlış {
            eğer metin_esit(cg_var_tip_bul(p, fad), "{ ptr, ptr }") {
                değişken kargs: Dizi<metin> = [];
                değişken kargt: Dizi<metin> = [];
                değişken ki: tam32 = 1;
                iken ki < cs {
                    dizi_ekle(kargs, ifade_uret(p, dizi_al(p.cocuk, cb + ki)));
                    dizi_ekle(kargt, p.son_tip);
                    ki = ki + 1;
                }
                // Dönüş IR'ı: bildirilen `işlev(...) -> T`'den (cg_aic'te saklı).
                değişken kret: metin = cg_var_ic_bul(p, fad);
                eğer metin_esit(kret, "") { kret = "i32"; }
                değişken kfv: tam32 = yeni_reg(p);
                yaz_str("  "); yaz_str(reg_str(kfv)); yaz_str(" = load { ptr, ptr }, ptr ");
                yaz_str(cg_var_bul(p, fad)); yb(10);
                // D-341: dolaylı çağrı ORTAK yoldan (fat_cagri_uret).
                ver fat_cagri_uret(p, reg_str(kfv), kret, kargs, kargt);
            }
