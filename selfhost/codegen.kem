        // D-341: KAPANIŞ ALANI mı, METOD mu? `k.fn()` iki şekli de gösterebilir.
        // Alanın BİLDİRİLEN tipi `işlev(...) -> T` ise bu bir metod DEĞİL, fat
        // value tutan ALANDIR → dolaylı çağrı. Önceki davranış: her ERISIM-hedefli
        // çağrı metod sayılıyordu → alan adıyla `@fn` çağrılıp LINK hatası (ölçüldü).
        eğer metin_esit(dizi_al(p.a_ad, hed), "ERISIM") {
            değişken eic: metin = erisim_kapanis_ic(p, hed);
            eğer metin_esit(eic, "") == yanlış {
                // Alıcı + alan okuması ERISIM dalının kendisinden gelir (tek kaynak).
                değişken efv: metin = ifade_uret(p, hed);
                değişken eargs: Dizi<metin> = [];
                değişken eargt: Dizi<metin> = [];
                değişken ei: tam32 = 1;
                iken ei < cs {
                    dizi_ekle(eargs, ifade_uret(p, dizi_al(p.cocuk, cb + ei)));
                    dizi_ekle(eargt, p.son_tip);
                    ei = ei + 1;
                }
                ver fat_cagri_uret(p, efv, eic, eargs, eargt);
            }
        }
        // D-341: DİZİ ELEMANI kapanış çağrısı — `xs[i]()`. Hedefi üret; IR tipi fat
        // value ise dolaylı çağır, DEĞİLSE GÜRÜLTÜLÜ hata (sessiz 0 YASAK, D-326).
        eğer metin_esit(dizi_al(p.a_ad, hed), "INDEKS") {
            değişken ifv: metin = ifade_uret(p, hed);
            eğer dizi_eleman_yapi_mi(p.son_tip) == yanlış {
                // GÜRÜLTÜLÜ red: BİLDİRİLMEMİŞ sembole çağrı → LLVM ayrıştırma
                // hatası. Sessizce "0" dönmek yanlış cevap üretirdi (D-326).
                yaz_str("  ; HATA: dizi elemani cagrilabilir degil (kapanis bekleniyor)"); yb(10);
                yaz_str("  call void @kdl_cg_hata_kapanis_bekleniyor()"); yb(10);
                p.hata_say = p.hata_say + 1;
                p.son_tip = "i32"; p.son_elem = ""; p.son_ref = ""; p.son_ic = "";
                ver "0";
            }
            değişken iic: metin = p.son_ic;
            eğer metin_esit(iic, "") { iic = "i32"; }
            değişken iargs: Dizi<metin> = [];
            değişken iargt: Dizi<metin> = [];
            değişken ii: tam32 = 1;
            iken ii < cs {
                dizi_ekle(iargs, ifade_uret(p, dizi_al(p.cocuk, cb + ii)));
                dizi_ekle(iargt, p.son_tip);
                ii = ii + 1;
            }
            ver fat_cagri_uret(p, ifv, iic, iargs, iargt);
        }
        // Built-in mi? Önce KULLANICI işlevi mi bak (yaz_str/yaz_kacis gibi yaz_ önekli user fn'leri
        // built-in sanmamak için); değilse önek-tabanlı @kdl_* eşlemesi dene.
        değişken kdl: metin = "";
        eğer fn_var_mi(p, fad) == yanlış { kdl = builtin_kdl_ad(fad); }
        değişken rt: metin = "";
        değişken fname: metin = "";
        değişken kullanici: tam32 = 0;   // V2-F4.2a: kullanıcı-fn mı (ρ alır)?
        eğer metin_esit(kdl, "") {
            // D-398: KULLANICI işlevinin IR adını çöz. İki yol:
            //  (a) hedef YOL ise (a::f, d::i::f) → noktalı ad "a.f" / "d.i.f".
            //      Öncesinde a_deg'den YALNIZ son segment alınıyordu ("f") →
            //      `call @f` yayılıp tanımsız sembol oluyordu.
            //  (b) çıplak ad ise MODÜL-ÖNCE çöz (modül içindeysek kardeş üye).
            // Bu nokta BİLİNÇLİ olarak seçildi: `fad`ı yukarıda topluca
            // değiştirmek yerleşik/çeşit-yapıcı ayrımlarını bozardı (onlar
            // `fad`ı ÇIPLAK adla karşılaştırıyor).
            değişken hedef: tam32 = dizi_al(p.cocuk, cb);
            değişken rn: metin = fn_coz(p, fad);
            eğer metin_esit(dizi_al(p.a_ad, hedef), "YOL") {
                rn = yol_noktali(p, hedef);
                // D-412: GÖRELİ YOL. `modül m` içinden `ic::g()` yazmak `m.ic.g`
                // demektir, mutlak `ic.g` değil. `yol_noktali` yolu MUTLAK kurar;
                // modül içindeysek ÖNCE mevcut önekle denenmeli — bu, `fn_coz`un
                // çıplak adlar için uyguladığı MODÜL-ÖNCE kuralının nitelikli
                // yollara uzantısıdır (D-398). Kayıt kontrolüyle: göreli karşılığı
                // YOKSA mutlak ada dokunulmaz, yani mutlak yollar bozulmaz.
                eğer metin_uzunluk(p.mod_onek) > 0 {
                    değişken gy: metin = mangle(p.mod_onek, rn);
                    eğer fn_kayitli_mi(p, gy) { rn = gy; }
                }
            }
            rt = fn_ret_bul(p, rn); fname = rn; kullanici = 1;
        }
        değilse { rt = builtin_ret(fad); fname = kdl; }
        // Argümanları SIRAYLA değerlendir (yan-IR akar), operand+tip biriktir.
        değişken args: Dizi<metin> = [];
        değişken argt: Dizi<metin> = [];
        // B3: metod dispatch — hed ERISIM ise (x.metod(...)) receiver'ı `kendin`
        // olarak İLK argüman geç. fad zaten a_deg[hed]=metod adı; imza_topla UYGULA
        // dalı metodu fn_ad'a kaydetti → kullanici=1, %rho sonra receiver. C llvm.c
        // :2616-2648 (ERISIM-hedef dispatch) aynası.
        eğer metin_esit(dizi_al(p.a_ad, hed), "ERISIM") {
            dizi_ekle(args, ifade_uret(p, dizi_al(p.cocuk, dizi_al(p.a_cb, hed))));
            dizi_ekle(argt, p.son_tip);
        }
        değişken i: tam32 = 1;
        iken i < cs {
            değişken av: metin = ifade_uret(p, dizi_al(p.cocuk, cb + i));
            değişken at: metin = p.son_tip;
            // D-393: ARGÜMAN, PARAMETRENİN BİLDİRİLEN IR tipine genişletilmeli.
            // Eskiden argümanın DOĞAL tipi basılıyordu → `f(a: dtam64, ..)` için
            // `call @f(i32 10, ..)`; `define` i64 bekliyor. LLVM bunu SESSİZCE
            // kabul eder (D-295) → ilk 3 argüman register'a sığdığı için doğru
            // görünür, 4.'den itibaren ÇÖP okunur (D-392'de ölçüldü).
            // Tablo codegen'in KENDİ ön-geçişinden (`param_ir_topla`); checker'ın
            // `fn_ptip` tablosu bu yolda BOŞTUR ve sınır-güvensizdir.
            eğer kullanici == 1 {
                değişken pt: metin = param_ir_tip(p, fname, i - 1);
