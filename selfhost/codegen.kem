            değişken gbd: tam32 = dizi_al(p.cocuk, cb + 1);
            değişken gbt: metin = cagri_ic_tip(p, gbd);   // bildirilen görev<T> → T
            değişken gbg: metin = ifade_uret(p, gbd);
            ver i64_daralt(p, "kdl_gorev_birlestir", gbg, gbt);
        }
