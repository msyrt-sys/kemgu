            dizi_ekle(p.lam_node, lam);
            dizi_ekle(p.lam_ad, mad);
            dizi_ekle(p.lam_capbase, capbase);
            dizi_ekle(p.lam_capcount, capcnt);
            p.son_tip = "{ i8, ptr, ptr }"; p.son_elem = ""; p.son_ref = "";
            ver reg_str(ld);
        }
        eğer metin_esit(fad, "dondur") {
            // dondur(v: &değişken T) -> &T — V1'de TİP-seviyesi işlem; runtime
            // temsili aynı ptr → identity, sıfır talimat (C ile birebir).
            ver ifade_uret(p, dizi_al(p.cocuk, cb + 1));
        }
        // D-303: gönderen(k)/alan(k) — kanal yön ucu projeksiyonu. Runtime-free
        // IDENTITY (dondur gibi): uçlar aynı KdlKanal* ptr'ına type-level görünüm.
        // Yön güvenliği tip kontrolünde (C tarafı). fn_var_mi guard = C'nin `!ik`
        // aynası: kullanıcının `alan`/`gönderen` adlı İŞLEVİ varsa ONA düşer
        // (`alan`="alan/bölge" yaygın; isim gaspı yok — cg_cesit_payload'daki
        // gerçek `işlev alan(s: Şekil)` bunu kanıtladı).
        eğer (metin_esit(fad, "gönderen") veya metin_esit(fad, "alan"))
             ve (fn_var_mi(p, fad) == yanlış) {
            ver ifade_uret(p, dizi_al(p.cocuk, cb + 1));
        }
        eğer metin_esit(fad, "kanal_oluştur") {
            değişken kkap: metin = ifade_uret(p, dizi_al(p.cocuk, cb + 1));
            değişken rk: tam32 = yeni_reg(p);
            değişken rks: metin = reg_str(rk);
            yaz_str("  "); yaz_str(rks); yaz_str(" = call ptr @kdl_kanal_olustur(i32 ");
            yaz_str(kkap); yaz_str(")"); yb(10);
