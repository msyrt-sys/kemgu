// ============================================================================
// selfhost/parser.kem — KEMGU parser'ı KEMGU'da (SELF-HOST bootstrap, Aşama 1).
//
// HEDEF: C parser'ının (src/parser.c + ifade.c) TAM İKAMESİ. Doğruluk: C
// `--ast` düz-dump oracle'ına karşı SIFIR-DİFF (D-043).
//   Format: <derinlik>\t<TIP_ADI>\t<deger>\t<satır>\t<sütün>
//
// MİMARİ (D-043): indeks-tabanlı DÜZ düğüm tablosu (paralel Dizi). Lexer scanning
// REUSE edilir → token tablosu (emit sink'i print yerine dizi_ekle). State =
// `Ayr` struct, &değişken ile geçirilir (D-044 fix'i Dizi-alanlı struct'ı sağlar).
//
// İLERLEME: P1a (token tablo + re-emit doğrulama) → P1b (Pratt ifade) → ...
// ============================================================================

yapı Ayr {
    kaynak: metin;
    // Token tablosu (lex çıktısı)
    t_ad: Dizi<metin>;
    t_sat: Dizi<tam32>;
    t_sut: Dizi<tam32>;
    t_off: Dizi<tam32>;
    t_uz: Dizi<tam32>;
    // Parser imleci
    imlec: tam32;
    // AST düğüm tablosu (paralel)
    a_ad: Dizi<metin>;
    a_deg: Dizi<metin>;
    a_sat: Dizi<tam32>;
    a_sut: Dizi<tam32>;
    a_cb: Dizi<tam32>;    // çocuk listesi başlangıç indeksi
    a_cs: Dizi<tam32>;    // çocuk sayısı
    cocuk: Dizi<tam32>;   // düz çocuk indeks listesi
    hata_say: tam32;     // parser hata sayısı
    yapi_izni: tam32;    // 1=Tip{..} yapı-oluştur izinli; 0=koşul bağlamı (blok başı)
    sk_pending: tam32;   // >> (SAGA_KAYDIR) yarı-tüketildi (generic kapanış böl)
    // ---- TC1: tip denetleyici durumu ----
    g_isim: Dizi<metin>;   // global isimler (builtin + üst-düzey tanım)
    yerel: Dizi<metin>;   // append-only kapsam yığını (param + lokal)
    yerel_tip: Dizi<metin>; // yerel ile paralel: her ismin tip-string'i ("?"=bilinmiyor)
    yerel_ptr: Dizi<tam32>; // D-351: yerel ile paralel — 1 = ham işaretçi (*T) bağlaması (G001)
    yerel_ham: Dizi<metin>; // D-352: yerel ile paralel — SÜZÜLMEMİŞ annotation tip adı (M001)
    yerel_dizi: Dizi<tam32>;// D-353: yerel ile paralel — 1 = Dizi<T> bağlaması (T005)
    yerel_yig: Dizi<tam32>; // D-358: 1 = annotasyonsuz dizi-literali bağlaması (YIĞIN dizi) — G003
    yerel_fn: Dizi<tam32>;  // D-358: 1 = `işlev(...)->T` annotasyonlu bağlama — G004
    yerel_yet: Dizi<metin>; // D-364: `yetki<R>` bağlamasının KAYNAK adı ("" = yetki değil)
    yerel_sab: Dizi<tam32>; // D-367: 1 = `sabitsüre<T>` annotasyonlu bağlama (CT001-CT008)
    yerel_yon: Dizi<metin>; // D-366: kanal ucu yönü ("alan"/"gönderen"/"") — DRF007.
                            // Tipten DEĞİL, DEĞERDEN okunur: `alan<T>` annotasyonu
                            // TIP_KULLANICI'ya düşer ve ADI düğümde tutulmaz.
    drf_bek: metin;         // D-366: aktif `görev<kesirli*>`/`kanal<kesirli*>` bağlamı
    dizi_bek: metin;        // D-354: aktif Dizi<E> bağlamının eleman tipi ("?"=yok)
    cv_cesit: Dizi<metin>;  // D-352: her varyant için sahip çeşit adı (parser yan-kanalı)
    cv_ad: Dizi<metin>;     // D-352: varyant adı (cv_cesit ile paralel)
    cv_pc: Dizi<tam32>;     // D-357: varyant payload alan sayısı (enum=0) — M003
    cv_pb: Dizi<tam32>;     // D-368: varyantın payload TİP tablosundaki tabanı (M004)
    cv_pt: Dizi<metin>;     // D-368: düz payload tip dizgileri ("?" = bilinmiyor)
    kur_ad: Dizi<metin>;    // D-351: küresel değişken adları (E010)
    cip_node: Dizi<tam32>;  // D-351: `çıplak` işlev düğümleri — gövdesi örtük güvensiz
    asm_node: Dizi<tam32>;  // D-373: SATIRICI_ASM düğümü — `mimari:` etiketi (AS001)
    asm_mim: Dizi<metin>;   // D-373: asm_node ile paralel — etiketteki mimari adı
    si_ad: Dizi<metin>;     // D-361: seçili import adları (`kullan m::{a,b}`) — niteliksiz gelir
    si_yol: Dizi<metin>;    // D-361: si_ad ile paralel — hangi modülden (T042 belirsizliği)
    mod_ad: Dizi<metin>;    // D-362: bilinen modül adları (yüklenen + `modül m` + alias) — T016
    gp_ad: Dizi<metin>;     // D-370: generic tip parametresi ADLARI (T011 muafiyeti)
    gp_sahip: Dizi<metin>;  // D-369: generic bound tablosu — sahip tip adı
    gp_idx: Dizi<tam32>;    // D-369: paralel — tip parametresinin sırası (0-tabanlı)
    gp_bound: Dizi<metin>;  // D-369: paralel — bound (özellik) adı
    oz_ad: Dizi<metin>;     // D-369: bilinen `özellik` adları (T031)
    uyg_tip: Dizi<metin>;   // D-369: `uygula OZ için TIP` — TIP tarafı
    uyg_oz: Dizi<metin>;    // D-369: paralel — OZ tarafı (T030)
    gen_node: Dizi<tam32>;  // D-363: `genel` işaretli tanım düğümleri (parser yan-kanalı)
    priv_mod: Dizi<metin>;  // D-363: dosya-modülünün `genel` OLMAYAN üyeleri — modül adı
    priv_ad: Dizi<metin>;   // D-363: priv_mod ile paralel — üye adı (T041)
    yerel_basla: tam32;   // aktif işlevin yerel diliminin başlangıcı (slice)
    aktif_donus: metin;   // aktif işlevin dönüş tipi ("boş"=void, "?"=bilinmiyor) — T020
    aktif_fn: tam32;       // D-324: aktif işlev düğümü (G005 ileri-tarama kapsamı)
    // ---- TC3d: işlev imza tablosu (CAGRI dönüş çıkarsama + T010 arite) ----
    fn_ad: Dizi<metin>;   // üst-düzey/modül işlev adları
    fn_donus: Dizi<metin>; // paralel: dönüş tipi (yalnız bilinen skaler; aksi "?")
    fn_psay: Dizi<tam32>; // paralel: parametre sayısı
    // ---- TC3g: parametre tip tablosu (CAGRI per-arg T001) ----
    fn_pbase: Dizi<tam32>; // paralel: fn_ptip'te bu işlevin param tiplerinin başı
    fn_ptip: Dizi<metin>; // düz param tip listesi (yalnız bilinen skaler; aksi "?")
    // ---- TC4: yapı tablosu (yapı_olustur T017/T012/T001 + erişim tipi) ----
    yapi_ad: Dizi<metin>;    // yapı adları
    yapi_abase: Dizi<tam32>; // paralel: alan_ad/alan_tip'te alan başlangıcı
    yapi_acount: Dizi<tam32>; // paralel: alan sayısı
    alan_ad: Dizi<metin>;    // düz alan adı listesi
    alan_tip: Dizi<metin>;   // paralel: alan tipi (yalnız bilinen skaler; aksi "?")
    fn_plin: Dizi<tam32>;    // fn_ptip ile paralel: param lineer mi (1/0) — tüketim
    fn_pdizi: Dizi<tam32>;   // D-358: fn_ptip ile paralel: param Dizi<T> mü (G003)
    // ---- TC8: cross-file/modül import (kullan → dışa sembol toplama) ----
    giris_dizin: metin;      // giriş dosyasının dizini (import arama yolu)
    kullan_gorulen: Dizi<metin>;  // yüklenen modül adları (döngü/elmas dedup)
    // ---- TC5b: lineer bağlama izleme (L001/L002 akış) — aktif işlev dilimi ----
    ly_ad: Dizi<metin>;      // D-314: `yapı tekkez K` — lineer yapı adları
    lyf_yapi: Dizi<metin>;   // D-314: lineer yapının LİNEER alanları (yapı adı)
    lyf_alan: Dizi<metin>;   // D-314: paralel — alan adı (kısmi-taşıma denetimi)
    lin_ad: Dizi<metin>;     // lineer bağlama adları (param + tekkez değişken)
    lin_sat: Dizi<tam32>;    // bildirim konumu (L001 için)
    lin_sut: Dizi<tam32>;
    lin_tuk: Dizi<tam32>;    // tüketim sayacı (0=tüketilmedi; >=1 sonrası L002)
    dy_node: Dizi<tam32>;    // D-318: DESEN_YAPI düğüm idx (yan-kanal — dump DEĞİŞMEZ)
    dy_yapi: Dizi<metin>;    // D-318: paralel — desendeki yapı adı
    dyf_node: Dizi<tam32>;   // D-318: alan girdisi: sahip desen düğümü
    dyf_alan: Dizi<metin>;   // D-318: paralel — alan adı
    lin_maske: Dizi<tam32>;  // D-316: kısmi taşıma — hangi lineer alanlar taşındı (bit)
    lin_fnk: Dizi<tam32>;    // D-321: bağlama tekkez<işlev(...)> mü (LC-3 çağrı tüketimi)
    lin_yet: Dizi<tam32>;    // D-365: 1 = bağlama `yetki<R>` — L001/L002/L004 yerine CP005
    lin_tek: Dizi<tam32>;    // D-355: 1 = bağlamanın KESİN `yapı tekkez` olduğu biliniyor.
                             // 0 = tekkez<T> VEYA bilinmiyor (annotasyonsuz `değişken k =
                             // tekkez_olustur(..)` de 0) → L007 YALNIZ 1'de verilir.
    snap_tuk: Dizi<tam32>;   // D-317: L-COND dal izolasyonu — tüketim anlık görüntüsü
    snap_maske: Dizi<tam32>; // D-317: paralel — maske anlık görüntüsü
    snap_top: tam32;         // D-317: anlık-görüntü yığını tepesi
    imha_bag: tam32;         // D-316: imha(...) operandını tüketiyoruz (kısmi taşınmış yapı yalnız imha edilebilir)
    guv_bag: tam32;          // `güvensiz` blok derinliği (C tk->guvensiz_baglam aynası)
    cip_bag: tam32;          // D-360: `çıplak` gövde derinliği (C ciplak_baglam) — E013.
                             // guv_bag'den AYRI: `güvensiz` blok çıplak yapmaz.
    lin_basla: tam32;        // aktif işlevin lineer bağlama diliminin başı
    th_kod: Dizi<metin>;  // tip-hata kodları (traversal sırası)
    th_sat: Dizi<tam32>;
    th_sut: Dizi<tam32>;
}

// ---- Çıktı yardımcıları ----
// HAM bayt yaz (yaz_karakter UTF-8 encode eder → Türkçe bayt mojibake;
// yaz_bayt ham byte yazar — METIN değer dump'ında UTF-8 korunur).
işlev yb(c: tam32) -> tam32 { yaz_bayt(c); ver 0; }
işlev yaz_str(s: metin) -> tam32 {
    değişken n: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 0;
    iken i < n { yb(metin_bayt(s, i) olarak tam32); i = i + 1; }
    ver 0;
}
// --ast deger alanı: \t \n \r \\ kaçışlı (C duz_kacis_yaz ile birebir).
işlev yaz_kacis(s: metin) -> tam32 {
    değişken n: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 0;
    iken i < n {
        değişken c: tam32 = metin_bayt(s, i) olarak tam32;
        eğer c < 0 { c = c + 256; }
        eğer c == 9 { yb(92); yb(116); }
        değilse { eğer c == 10 { yb(92); yb(110); }
        değilse { eğer c == 13 { yb(92); yb(114); }
        değilse { eğer c == 92 { yb(92); yb(92); }
        değilse { yb(c); } } } }
        i = i + 1;
    }
    ver 0;
}

// ---- Token tablosuna ekle (lexer emit sink) ----
işlev tok_ekle(p: &değişken Ayr, ad: metin, satir: tam32, sutun: tam32, offset: tam32, uzunluk: tam32) -> tam32 {
    dizi_ekle(p.t_ad, ad);
    dizi_ekle(p.t_sat, satir);
    dizi_ekle(p.t_sut, sutun);
    dizi_ekle(p.t_off, offset);
    dizi_ekle(p.t_uz, uzunluk);
    ver 0;
}

// ---- Lexer çekirdeği (selfhost/lexer.kem ile BİREBİR; emit→tok_ekle) ----
işlev bayt(s: metin, i: tam32) -> tam32 {
    değişken b: tam32 = metin_bayt(s, i) olarak tam32;
    eğer b < 0 { ver b + 256; }
    ver b;
}
işlev rakam_mi(b: tam32) -> mantıksal { ver b >= 48 ve b <= 57; }
işlev harf_mi(b: tam32) -> mantıksal {
    ver (b >= 97 ve b <= 122) veya (b >= 65 ve b <= 90);
}
işlev bosluk_mu(b: tam32) -> mantıksal {
    ver (b == 32) veya (b == 9) veya (b == 13) veya (b == 10);
}
işlev turkce_2byte_mi(b0: tam32, b1: tam32) -> mantıksal {
    eğer b0 == 195 {
        ver (b1 == 167) veya (b1 == 135) veya (b1 == 182)
          veya (b1 == 150) veya (b1 == 188) veya (b1 == 156);
    }
    eğer b0 == 196 {
        ver (b1 == 159) veya (b1 == 158) veya (b1 == 177) veya (b1 == 176);
    }
    eğer b0 == 197 { ver (b1 == 159) veya (b1 == 158); }
    ver yanlış;
}
işlev kimlik_basi_uz(kaynak: metin, pos: tam32, uz: tam32) -> tam32 {
    eğer pos >= uz { ver 0; }
    değişken b0: tam32 = bayt(kaynak, pos);
    eğer harf_mi(b0) veya (b0 == 95) { ver 1; }
    eğer pos + 1 < uz {
        eğer turkce_2byte_mi(b0, bayt(kaynak, pos + 1)) { ver 2; }
    }
    ver 0;
}
işlev kimlik_devam_uz(kaynak: metin, pos: tam32, uz: tam32) -> tam32 {
    eğer pos >= uz { ver 0; }
    değişken b0: tam32 = bayt(kaynak, pos);
    eğer harf_mi(b0) veya rakam_mi(b0) veya (b0 == 95) { ver 1; }
    eğer pos + 1 < uz {
        eğer turkce_2byte_mi(b0, bayt(kaynak, pos + 1)) { ver 2; }
    }
    ver 0;
}
işlev anahtar_tip(w: metin) -> metin {
    eğer metin_esit(w, "iken") { ver "IKEN"; }
    eğer metin_esit(w, "ve") { ver "VE"; }
    eğer metin_esit(w, "veya") { ver "VEYA"; }
    eğer metin_esit(w, "ver") { ver "VER"; }
    eğer metin_esit(w, "delege") { ver "DELEGE"; }
    eğer metin_esit(w, "hata") { ver "HATA"; }
    eğer metin_esit(w, "imha") { ver "IMHA"; }
    eğer metin_esit(w, "kendin") { ver "KENDIN"; }
    eğer metin_esit(w, "kullan") { ver "KULLAN"; }
    eğer metin_esit(w, "olarak") { ver "OLARAK"; }
    eğer metin_esit(w, "sabit") { ver "SABIT"; }
    eğer metin_esit(w, "tamam") { ver "TAMAM"; }
    eğer metin_esit(w, "tekkez") { ver "TEKKEZ"; }
    eğer metin_esit(w, "yetki") { ver "YETKI"; }
    eğer metin_esit(w, "genel") { ver "GENEL"; }
    eğer metin_esit(w, "geri_al") { ver "GERI_AL"; }
    eğer metin_esit(w, "uygula") { ver "UYGULA"; }
    eğer metin_esit(w, "kanal") { ver "KANAL"; }
    eğer metin_esit(w, "eğer") { ver "EGER"; }
    eğer metin_esit(w, "değilse") { ver "DEGILSE"; }
    eğer metin_esit(w, "için") { ver "ICIN"; }
    eğer metin_esit(w, "eşleş") { ver "ESLES"; }
    eğer metin_esit(w, "işlev") { ver "ISLEV"; }
    eğer metin_esit(w, "yapı") { ver "YAPI"; }
    eğer metin_esit(w, "çeşit") { ver "CESIT"; }
    eğer metin_esit(w, "özellik") { ver "OZELLIK"; }
    eğer metin_esit(w, "modül") { ver "MODUL"; }
    eğer metin_esit(w, "değişken") { ver "DEGISKEN"; }
    eğer metin_esit(w, "doğru") { ver "DOGRU"; }
    eğer metin_esit(w, "yanlış") { ver "YANLIS"; }
    eğer metin_esit(w, "boş") { ver "BOS"; }
    eğer metin_esit(w, "değil") { ver "DEGIL"; }
    eğer metin_esit(w, "dışa") { ver "DISA"; }
    eğer metin_esit(w, "bölge") { ver "BOLGE"; }
    eğer metin_esit(w, "seçimlik") { ver "SECIMLIK"; }
    eğer metin_esit(w, "sonuç") { ver "SONUC"; }
    eğer metin_esit(w, "değer") { ver "DEGER"; }
    eğer metin_esit(w, "hiç") { ver "HIC"; }
    eğer metin_esit(w, "güvensiz") { ver "GUVENSIZ"; }
    eğer metin_esit(w, "sabitsüre") { ver "SABITSURE"; }
    eğer metin_esit(w, "gerçekzamanlı") { ver "GERCEKZAMANLI"; }
    eğer metin_esit(w, "küresel") { ver "KURESEL"; }   // D-253: modül-mutable global
    eğer metin_esit(w, "çıplak") { ver "CIPLAK"; }     // D-255: no-region-prologue işlev
    eğer metin_esit(w, "vektör") { ver "VEKTOR"; }
    eğer metin_esit(w, "görev") { ver "GOREV"; }
    eğer metin_esit(w, "satıriçi_asm") { ver "SATIRICI_ASM"; }
    ver "TANIMLAYICI";
}
işlev ikinci_bayt(kaynak: metin, pos: tam32, uz: tam32) -> tam32 {
    eğer pos < uz { ver bayt(kaynak, pos); }
    ver 0;
}
işlev hex_rakam_mi(b: tam32) -> mantıksal {
    ver rakam_mi(b) veya (b >= 97 ve b <= 102) veya (b >= 65 ve b <= 70);
}
işlev utf8_uz(b: tam32) -> tam32 {
    eğer b < 128 { ver 1; }
    eğer (b >= 192) ve (b <= 223) { ver 2; }
    eğer (b >= 224) ve (b <= 239) { ver 3; }
    eğer (b >= 240) ve (b <= 247) { ver 4; }
    ver 0;
}
işlev ham_basi_mi(kaynak: metin, pos: tam32, uz: tam32) -> mantıksal {
    değişken s: tam32 = ikinci_bayt(kaynak, pos + 1, uz);
    eğer s == 34 { ver doğru; }
    eğer s == 35 {
        değişken b: tam32 = pos + 1;
        iken (b < uz) ve (bayt(kaynak, b) == 35) { b = b + 1; }
        eğer (b < uz) ve (bayt(kaynak, b) == 34) { ver doğru; }
    }
    ver yanlış;
}

// Operatör (maximal munch) — tüketilen bayt; tok_ekle ile tabloya yazar.
işlev op_emit(p: &değişken Ayr, kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken b0: tam32 = bayt(kaynak, pos);
    değişken b1: tam32 = ikinci_bayt(kaynak, pos + 1, uz);
    değişken b2: tam32 = ikinci_bayt(kaynak, pos + 2, uz);
    eğer b0 == 43 {
        eğer b1 == 61 { tok_ekle(p, "ARTI_ESIT", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "ARTI", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 45 {
        eğer b1 == 61 { tok_ekle(p, "EKSI_ESIT", satir, sutun, pos, 2); ver 2; }
        eğer b1 == 62 { tok_ekle(p, "OK", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "EKSI", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 42 {
        eğer b1 == 61 { tok_ekle(p, "YILDIZ_ESIT", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "YILDIZ", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 47 {
        eğer b1 == 61 { tok_ekle(p, "BOLU_ESIT", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "BOLU", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 37 {
        eğer b1 == 61 { tok_ekle(p, "MOD_ESIT", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "MOD", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 61 {
        eğer b1 == 61 { tok_ekle(p, "ESIT_ESIT", satir, sutun, pos, 2); ver 2; }
        eğer b1 == 62 { tok_ekle(p, "KALIN_OK", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "ESIT", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 33 {
        eğer b1 == 61 { tok_ekle(p, "ESIT_DEGIL", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "HATALI", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 60 {
        eğer b1 == 61 { tok_ekle(p, "KUCUK_ESIT", satir, sutun, pos, 2); ver 2; }
        eğer b1 == 60 { tok_ekle(p, "SOLA_KAYDIR", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "KUCUK", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 62 {
        eğer b1 == 61 { tok_ekle(p, "BUYUK_ESIT", satir, sutun, pos, 2); ver 2; }
        eğer b1 == 62 { tok_ekle(p, "SAGA_KAYDIR", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "BUYUK", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 38 { tok_ekle(p, "VE_BIT", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 124 { tok_ekle(p, "VEYA_BIT", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 94 { tok_ekle(p, "OZVEYA_BIT", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 126 { tok_ekle(p, "DEGIL_BIT", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 46 {
        eğer b1 == 46 {
            eğer b2 == 46 { tok_ekle(p, "UC_NOKTA", satir, sutun, pos, 3); ver 3; }
            tok_ekle(p, "ARALIK", satir, sutun, pos, 2); ver 2;
        }
        tok_ekle(p, "NOKTA", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 58 {
        eğer b1 == 58 { tok_ekle(p, "CIFT_IKI_NOKTA", satir, sutun, pos, 2); ver 2; }
        tok_ekle(p, "IKI_NOKTA", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 40 { tok_ekle(p, "SOL_PAREN", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 41 { tok_ekle(p, "SAG_PAREN", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 123 { tok_ekle(p, "SOL_SUSLU", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 125 { tok_ekle(p, "SAG_SUSLU", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 91 { tok_ekle(p, "SOL_KOSELI", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 93 { tok_ekle(p, "SAG_KOSELI", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 44 { tok_ekle(p, "VIRGUL", satir, sutun, pos, 1); ver 1; }
    eğer b0 == 59 { tok_ekle(p, "NOKTALI_VIRGUL", satir, sutun, pos, 1); ver 1; }
    tok_ekle(p, "HATALI", satir, sutun, pos, 1); ver 1;
}
işlev sayi_emit(p: &değişken Ayr, kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken pp: tam32 = pos;
    değişken ondalik: tam32 = 0;
    eğer bayt(kaynak, pp) == 48 {
        değişken s: tam32 = ikinci_bayt(kaynak, pp + 1, uz);
        eğer (s == 120) veya (s == 88) {
            pp = pp + 2;
            iken (pp < uz) ve (hex_rakam_mi(bayt(kaynak, pp)) veya (bayt(kaynak, pp) == 95)) { pp = pp + 1; }
            tok_ekle(p, "TAMSAYI", satir, sutun, pos, pp - pos); ver pp - pos;
        }
        eğer (s == 98) veya (s == 66) {
            pp = pp + 2;
            iken (pp < uz) ve ((bayt(kaynak, pp) == 48) veya (bayt(kaynak, pp) == 49) veya (bayt(kaynak, pp) == 95)) { pp = pp + 1; }
            tok_ekle(p, "TAMSAYI", satir, sutun, pos, pp - pos); ver pp - pos;
        }
        eğer (s == 111) veya (s == 79) {
            pp = pp + 2;
            iken (pp < uz) ve (((bayt(kaynak, pp) >= 48) ve (bayt(kaynak, pp) <= 55)) veya (bayt(kaynak, pp) == 95)) { pp = pp + 1; }
            tok_ekle(p, "TAMSAYI", satir, sutun, pos, pp - pos); ver pp - pos;
        }
    }
    iken (pp < uz) ve (rakam_mi(bayt(kaynak, pp)) veya (bayt(kaynak, pp) == 95)) { pp = pp + 1; }
    eğer (pp < uz) ve (bayt(kaynak, pp) == 46) {
        eğer ikinci_bayt(kaynak, pp + 1, uz) != 46 {
            ondalik = 1;
            pp = pp + 1;
            iken (pp < uz) ve (rakam_mi(bayt(kaynak, pp)) veya (bayt(kaynak, pp) == 95)) { pp = pp + 1; }
        }
    }
    eğer (pp < uz) ve ((bayt(kaynak, pp) == 101) veya (bayt(kaynak, pp) == 69)) {
        ondalik = 1;
        pp = pp + 1;
        eğer (pp < uz) ve ((bayt(kaynak, pp) == 43) veya (bayt(kaynak, pp) == 45)) { pp = pp + 1; }
        iken (pp < uz) ve (rakam_mi(bayt(kaynak, pp)) veya (bayt(kaynak, pp) == 95)) { pp = pp + 1; }
    }
    eğer ondalik == 1 { tok_ekle(p, "ONDALIK", satir, sutun, pos, pp - pos); }
    değilse { tok_ekle(p, "TAMSAYI", satir, sutun, pos, pp - pos); }
    ver pp - pos;
}
işlev dize_emit(p: &değişken Ayr, kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken pp: tam32 = pos + 1;
    değişken durum: tam32 = 0;
    iken (pp < uz) ve (durum == 0) {
        değişken c: tam32 = bayt(kaynak, pp);
        eğer c == 34 { durum = 1; }
        değilse {
            eğer c == 92 { pp = pp + 1; eğer pp < uz { pp = pp + 1; } }
            değilse {
                eğer c == 10 { durum = 2; }
                değilse { pp = pp + 1; }
            }
        }
    }
    eğer durum == 1 { pp = pp + 1; tok_ekle(p, "METIN", satir, sutun, pos, pp - pos); ver pp - pos; }
    tok_ekle(p, "HATALI", satir, sutun, pos, pp - pos); ver pp - pos;
}
işlev karakter_emit(p: &değişken Ayr, kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken pp: tam32 = pos + 1;
    eğer (pp >= uz) veya (bayt(kaynak, pp) == 39) {
        eğer pp < uz { pp = pp + 1; }
        tok_ekle(p, "HATALI", satir, sutun, pos, pp - pos); ver pp - pos;
    }
    eğer bayt(kaynak, pp) == 92 {
        pp = pp + 1;
        eğer pp < uz { pp = pp + 1; }
    } değilse {
        değişken cl: tam32 = utf8_uz(bayt(kaynak, pp));
        eğer cl == 0 { cl = 1; }
        değişken i: tam32 = 0;
        iken i < cl { eğer pp < uz { pp = pp + 1; } i = i + 1; }
    }
    eğer (pp >= uz) veya (bayt(kaynak, pp) != 39) {
        iken (pp < uz) ve (bayt(kaynak, pp) != 39) ve (bayt(kaynak, pp) != 10) { pp = pp + 1; }
        eğer (pp < uz) ve (bayt(kaynak, pp) == 39) { pp = pp + 1; }
        tok_ekle(p, "HATALI", satir, sutun, pos, pp - pos); ver pp - pos;
    }
    pp = pp + 1;
    tok_ekle(p, "KARAKTER", satir, sutun, pos, pp - pos); ver pp - pos;
}
işlev ham_emit(p: &değişken Ayr, kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken pp: tam32 = pos + 1;
    değişken hash_sayisi: tam32 = 0;
    iken (pp < uz) ve (bayt(kaynak, pp) == 35) { hash_sayisi = hash_sayisi + 1; pp = pp + 1; }
    eğer (pp >= uz) veya (bayt(kaynak, pp) != 34) {
        tok_ekle(p, "HATALI", satir, sutun, pos, pp - pos); ver pp - pos;
    }
    pp = pp + 1;
    değişken bitti: tam32 = 0;
    iken (pp < uz) ve (bitti == 0) {
        eğer bayt(kaynak, pp) == 34 {
            pp = pp + 1;
            değişken kapanan: tam32 = 0;
            iken (pp < uz) ve (bayt(kaynak, pp) == 35) ve (kapanan < hash_sayisi) {
                kapanan = kapanan + 1; pp = pp + 1;
            }
            eğer kapanan == hash_sayisi { bitti = 1; }
        } değilse {
            pp = pp + 1;
        }
    }
    eğer bitti == 1 { tok_ekle(p, "HAM_METIN", satir, sutun, pos, pp - pos); ver pp - pos; }
    tok_ekle(p, "HATALI", satir, sutun, pos, pp - pos); ver pp - pos;
}

// Kaynağı token tablosuna lex et (C lexer ile birebir; DOSYA_SONU dahil).
işlev lex_et(p: &değişken Ayr) -> tam32 {
    değişken kaynak: metin = p.kaynak;
    değişken uz: tam32 = metin_uzunluk(kaynak);
    değişken pos: tam32 = 0;
    değişken satir: tam32 = 1;
    değişken sutun: tam32 = 1;
    iken doğru {
        değişken trivia: mantıksal = doğru;
        iken trivia {
            eğer (pos < uz) ve bosluk_mu(bayt(kaynak, pos)) {
                eğer bayt(kaynak, pos) == 10 { satir = satir + 1; sutun = 1; }
                değilse { sutun = sutun + 1; }
                pos = pos + 1;
            } değilse {
                eğer (pos < uz) ve (bayt(kaynak, pos) == 47) ve (ikinci_bayt(kaynak, pos + 1, uz) == 47) {
                    pos = pos + 2; sutun = sutun + 2;
                    iken (pos < uz) ve (bayt(kaynak, pos) != 10) { pos = pos + 1; sutun = sutun + 1; }
                } değilse {
                    eğer (pos < uz) ve (bayt(kaynak, pos) == 47) ve (ikinci_bayt(kaynak, pos + 1, uz) == 42) {
                        pos = pos + 2; sutun = sutun + 2;
                        değişken derinlik: tam32 = 1;
                        iken (pos < uz) ve (derinlik > 0) {
                            eğer (bayt(kaynak, pos) == 47) ve (ikinci_bayt(kaynak, pos + 1, uz) == 42) {
                                pos = pos + 2; sutun = sutun + 2; derinlik = derinlik + 1;
                            } değilse {
                                eğer (bayt(kaynak, pos) == 42) ve (ikinci_bayt(kaynak, pos + 1, uz) == 47) {
                                    pos = pos + 2; sutun = sutun + 2; derinlik = derinlik - 1;
                                } değilse {
                                    eğer bayt(kaynak, pos) == 10 { satir = satir + 1; sutun = 1; }
                                    değilse { sutun = sutun + 1; }
                                    pos = pos + 1;
                                }
                            }
                        }
                    } değilse {
                        trivia = yanlış;
                    }
                }
            }
        }
        eğer pos >= uz { tok_ekle(p, "DOSYA_SONU", satir, sutun, pos, 0); ver 0; }

        değişken tb: tam32 = bayt(kaynak, pos);
        değişken t_off: tam32 = pos;
        değişken t_sat: tam32 = satir;
        değişken t_sut: tam32 = sutun;

        eğer rakam_mi(tb) {
            değişken slen: tam32 = sayi_emit(p, kaynak, pos, uz, t_sat, t_sut);
            pos = pos + slen; sutun = sutun + slen;
        } değilse {
            değişken bu: tam32 = kimlik_basi_uz(kaynak, pos, uz);
            eğer bu > 0 {
                eğer (tb == 114) ve ham_basi_mi(kaynak, pos, uz) {
                    değişken hlen: tam32 = ham_emit(p, kaynak, pos, uz, t_sat, t_sut);
                    değişken k: tam32 = 0;
                    iken k < hlen {
                        eğer bayt(kaynak, pos + k) == 10 { satir = satir + 1; sutun = 1; }
                        değilse { sutun = sutun + 1; }
                        k = k + 1;
                    }
                    pos = pos + hlen;
                } değilse {
                    pos = pos + bu; sutun = sutun + bu;
                    değişken devam: mantıksal = doğru;
                    iken devam {
                        değişken du: tam32 = kimlik_devam_uz(kaynak, pos, uz);
                        eğer du == 0 { devam = yanlış; }
                        değilse { pos = pos + du; sutun = sutun + du; }
                    }
                    değişken w: metin = metin_kes(kaynak, t_off, pos - t_off);
                    tok_ekle(p, anahtar_tip(w), t_sat, t_sut, t_off, pos - t_off);
                }
            } değilse {
                eğer tb == 34 {
                    değişken mlen: tam32 = dize_emit(p, kaynak, pos, uz, t_sat, t_sut);
                    pos = pos + mlen; sutun = sutun + mlen;
                } değilse {
                    eğer tb == 39 {
                        değişken klen: tam32 = karakter_emit(p, kaynak, pos, uz, t_sat, t_sut);
                        pos = pos + klen; sutun = sutun + klen;
                    } değilse {
                        değişken olen: tam32 = op_emit(p, kaynak, pos, uz, t_sat, t_sut);
                        pos = pos + olen; sutun = sutun + olen;
                    }
                }
            }
        }
    }
    ver 0;
}

// ===========================================================================
// P1b: AST düğüm tablosu + Pratt ifade parser + düz --ast dumper.
// ===========================================================================

// ---- AST düğüm oluşturucular (append-on-create; düz çocuk listesi) ----
işlev dugum0(p: &değişken Ayr, ad: metin, deger: metin, satir: tam32, sutun: tam32) -> tam32 {
    değişken idx: tam32 = dizi_boyut(p.a_ad);
    dizi_ekle(p.a_ad, ad);  dizi_ekle(p.a_deg, deger);
    dizi_ekle(p.a_sat, satir);  dizi_ekle(p.a_sut, sutun);
    dizi_ekle(p.a_cb, 0);  dizi_ekle(p.a_cs, 0);
    ver idx;
}
işlev dugum1(p: &değişken Ayr, ad: metin, deger: metin, satir: tam32, sutun: tam32, c1: tam32) -> tam32 {
    değişken idx: tam32 = dizi_boyut(p.a_ad);
    dizi_ekle(p.a_ad, ad);  dizi_ekle(p.a_deg, deger);
    dizi_ekle(p.a_sat, satir);  dizi_ekle(p.a_sut, sutun);
    dizi_ekle(p.a_cb, dizi_boyut(p.cocuk));  dizi_ekle(p.a_cs, 1);
    dizi_ekle(p.cocuk, c1);
    ver idx;
}
işlev dugum2(p: &değişken Ayr, ad: metin, deger: metin, satir: tam32, sutun: tam32, c1: tam32, c2: tam32) -> tam32 {
    değişken idx: tam32 = dizi_boyut(p.a_ad);
    dizi_ekle(p.a_ad, ad);  dizi_ekle(p.a_deg, deger);
    dizi_ekle(p.a_sat, satir);  dizi_ekle(p.a_sut, sutun);
    dizi_ekle(p.a_cb, dizi_boyut(p.cocuk));  dizi_ekle(p.a_cs, 2);
    dizi_ekle(p.cocuk, c1);  dizi_ekle(p.cocuk, c2);
    ver idx;
}
işlev dugum3(p: &değişken Ayr, ad: metin, deger: metin, satir: tam32, sutun: tam32, c1: tam32, c2: tam32, c3: tam32) -> tam32 {
    değişken idx: tam32 = dizi_boyut(p.a_ad);
    dizi_ekle(p.a_ad, ad);  dizi_ekle(p.a_deg, deger);
    dizi_ekle(p.a_sat, satir);  dizi_ekle(p.a_sut, sutun);
    dizi_ekle(p.a_cb, dizi_boyut(p.cocuk));  dizi_ekle(p.a_cs, 3);
    dizi_ekle(p.cocuk, c1);  dizi_ekle(p.cocuk, c2);  dizi_ekle(p.cocuk, c3);
    ver idx;
}
// Çocuk listesi (Dizi<tam32>) ile düğüm — değişken arite (blok/çağrı/program).
işlev dugum_n(p: &değişken Ayr, ad: metin, deger: metin, satir: tam32, sutun: tam32, kids: Dizi<tam32>) -> tam32 {
    değişken idx: tam32 = dizi_boyut(p.a_ad);
    dizi_ekle(p.a_ad, ad);  dizi_ekle(p.a_deg, deger);
    dizi_ekle(p.a_sat, satir);  dizi_ekle(p.a_sut, sutun);
    dizi_ekle(p.a_cb, dizi_boyut(p.cocuk));  dizi_ekle(p.a_cs, dizi_boyut(kids));
    değişken i: tam32 = 0;
    iken i < dizi_boyut(kids) { dizi_ekle(p.cocuk, dizi_al(kids, i)); i = i + 1; }
    ver idx;
}

// ---- Sayı değeri (C parse: '_' temizle + 0x/0b/0o taban) ----
işlev hane_deger(c: tam32) -> tam32 {
    eğer c >= 48 ve c <= 57 { ver c - 48; }       // 0-9
    eğer c >= 97 ve c <= 102 { ver c - 97 + 10; }  // a-f
    eğer c >= 65 ve c <= 70 { ver c - 65 + 10; }   // A-F
    ver 0;
}
işlev tamsayi_deger(lex: metin) -> tam64 {
    değişken n: tam32 = metin_uzunluk(lex);
    değişken taban: tam64 = 10;
    değişken i: tam32 = 0;
    // 0x / 0b / 0o prefix
    eğer n >= 2 ve bayt(lex, 0) == 48 {
        değişken c1: tam32 = bayt(lex, 1);
        eğer (c1 == 120) veya (c1 == 88) { taban = 16; i = 2; }
        eğer (c1 == 98) veya (c1 == 66) { taban = 2; i = 2; }
        eğer (c1 == 111) veya (c1 == 79) { taban = 8; i = 2; }
    }
    değişken sonuc: tam64 = 0;
    değişken maks: tam64 = 9223372036854775807;   // int64 max (strtoll clamp)
    değişken tasti: mantıksal = yanlış;
    iken i < n {
        değişken c: tam32 = bayt(lex, i);
        eğer c != 95 {                              // '_' atla
            değişken h: tam64 = hane_deger(c) olarak tam64;
            eğer sonuc > (maks - h) / taban { tasti = doğru; }  // taşma → LLONG_MAX
            eğer tasti { sonuc = maks; }
            değilse { sonuc = sonuc * taban + h; }
        }
        i = i + 1;
    }
    ver sonuc;
}
işlev hane_str(d: tam32) -> metin {
    eğer d == 0 { ver "0"; }   eğer d == 1 { ver "1"; }
    eğer d == 2 { ver "2"; }   eğer d == 3 { ver "3"; }
    eğer d == 4 { ver "4"; }   eğer d == 5 { ver "5"; }
    eğer d == 6 { ver "6"; }   eğer d == 7 { ver "7"; }
    eğer d == 8 { ver "8"; }   ver "9";
}
işlev tam64_str(v: tam64) -> metin {
    eğer v == 0 { ver "0"; }
    eğer v < 0 { ver metin_birlestir("-", tam64_str(0 - v)); }
    eğer v < 10 { ver hane_str(v olarak tam32); }
    ver metin_birlestir(tam64_str(v / 10), hane_str((v % 10) olarak tam32));
}
// Hex hane string'i (KARAKTER U+XXXX için).
işlev hex_str(d: tam32) -> metin {
    eğer d == 0 { ver "0"; }   eğer d == 1 { ver "1"; }
    eğer d == 2 { ver "2"; }   eğer d == 3 { ver "3"; }
    eğer d == 4 { ver "4"; }   eğer d == 5 { ver "5"; }
    eğer d == 6 { ver "6"; }   eğer d == 7 { ver "7"; }
    eğer d == 8 { ver "8"; }   eğer d == 9 { ver "9"; }
    eğer d == 10 { ver "A"; }  eğer d == 11 { ver "B"; }
    eğer d == 12 { ver "C"; }  eğer d == 13 { ver "D"; }
    eğer d == 14 { ver "E"; }  ver "F";
}
// KARAKTER deger = "U+%04X" (C ast_duz_yaz ile birebir).
işlev karakter_deger(b: tam32) -> metin {
    değişken r: metin = metin_birlestir("U+", hex_str((b / 4096) % 16));
    r = metin_birlestir(r, hex_str((b / 256) % 16));
    r = metin_birlestir(r, hex_str((b / 16) % 16));
    ver metin_birlestir(r, hex_str(b % 16));
}

// ---- Token erişim (sınır-güvenli: bozuk girdide imleç DOSYA_SONU'yu aşabilir;
//      sınır-dışı erişim → DOSYA_SONU/"" döner → tüm parse döngüleri sonlanır,
//      çökme/sonsuz-döngü yok. C lexer DOSYA_SONU sentineli ekler, peek bounded.) ----
işlev tip_i(p: &değişken Ayr, i: tam32) -> metin {
    eğer i >= dizi_boyut(p.t_ad) { ver "DOSYA_SONU"; }
    ver dizi_al(p.t_ad, i);
}
işlev lex_i(p: &değişken Ayr, i: tam32) -> metin {
    eğer i >= dizi_boyut(p.t_ad) { ver ""; }
    ver metin_kes(p.kaynak, dizi_al(p.t_off, i), dizi_al(p.t_uz, i));
}
işlev simdiki(p: &değişken Ayr) -> metin {
    değişken t: metin = tip_i(p, p.imlec);
    eğer (p.sk_pending == 1) ve metin_esit(t, "SAGA_KAYDIR") { ver "BUYUK"; }
    ver t;
}
// Generic kapanışı `>` bekle; `>>` (SAGA_KAYDIR) iki `>`'a böl (parser_buyuk_ayir).
işlev bekle_buyuk(p: &değişken Ayr) -> tam32 {
    değişken t: metin = tip_i(p, p.imlec);  // RAW (sk_pending atla)
    eğer metin_esit(t, "BUYUK") { ilerle(p); ver 1; }
    eğer metin_esit(t, "SAGA_KAYDIR") {
        eğer p.sk_pending == 1 { p.sk_pending = 0; p.imlec = p.imlec + 1; ver 1; }
        p.sk_pending = 1;  // ilk > tüketildi (ilerleme yok)
        ver 1;
    }
    p.hata_say = p.hata_say + 1;
    ver 0;
}
işlev simdiki_buyuk_mu(p: &değişken Ayr) -> mantıksal { ver metin_esit(simdiki(p), "BUYUK"); }
işlev sim_mi(p: &değişken Ayr, t: metin) -> mantıksal { ver metin_esit(simdiki(p), t); }
işlev sim_lex(p: &değişken Ayr) -> metin { ver lex_i(p, p.imlec); }
işlev sim_sat(p: &değişken Ayr) -> tam32 { ver dizi_al(p.t_sat, p.imlec); }
işlev sim_sut(p: &değişken Ayr) -> tam32 { ver dizi_al(p.t_sut, p.imlec); }
işlev ilerle(p: &değişken Ayr) -> tam32 { p.imlec = p.imlec + 1; ver 0; }
// Beklenen token'ı tüket; değilse hata say + ilerleme yok.
işlev bekle(p: &değişken Ayr, t: metin) -> tam32 {
    eğer sim_mi(p, t) { ilerle(p); ver 1; }
    p.hata_say = p.hata_say + 1;
    ver 0;
}

// ---- Öncelik tabloları (ifade.c ile birebir) ----
işlev ikili_onc(t: metin) -> tam32 {
    eğer metin_esit(t, "VEYA") { ver 1; }
    eğer metin_esit(t, "VE") { ver 2; }
    eğer metin_esit(t, "VEYA_BIT") { ver 3; }
    eğer metin_esit(t, "OZVEYA_BIT") { ver 4; }
    eğer metin_esit(t, "VE_BIT") { ver 5; }
    eğer metin_esit(t, "ESIT_ESIT") veya metin_esit(t, "ESIT_DEGIL") { ver 6; }
    eğer metin_esit(t, "KUCUK") veya metin_esit(t, "BUYUK")
      veya metin_esit(t, "KUCUK_ESIT") veya metin_esit(t, "BUYUK_ESIT") { ver 7; }
    eğer metin_esit(t, "SOLA_KAYDIR") veya metin_esit(t, "SAGA_KAYDIR") { ver 8; }
    eğer metin_esit(t, "ARTI") veya metin_esit(t, "EKSI") { ver 9; }
    eğer metin_esit(t, "YILDIZ") veya metin_esit(t, "BOLU") veya metin_esit(t, "MOD") { ver 10; }
    ver 0;
}
işlev sonek_onc(t: metin) -> tam32 {
    eğer metin_esit(t, "NOKTA") veya metin_esit(t, "SOL_KOSELI")
      veya metin_esit(t, "SOL_PAREN") veya metin_esit(t, "CIFT_IKI_NOKTA")
      veya metin_esit(t, "OLARAK") { ver 12; }
    ver 0;
}
işlev ikili_op_ad(t: metin) -> metin {
    eğer metin_esit(t, "VEYA") { ver "veya"; }
    eğer metin_esit(t, "VE") { ver "ve"; }
    eğer metin_esit(t, "VEYA_BIT") { ver "|"; }
    eğer metin_esit(t, "OZVEYA_BIT") { ver "^"; }
    eğer metin_esit(t, "VE_BIT") { ver "&"; }
    eğer metin_esit(t, "ESIT_ESIT") { ver "=="; }
    eğer metin_esit(t, "ESIT_DEGIL") { ver "!="; }
    eğer metin_esit(t, "KUCUK") { ver "<"; }
    eğer metin_esit(t, "BUYUK") { ver ">"; }
    eğer metin_esit(t, "KUCUK_ESIT") { ver "<="; }
    eğer metin_esit(t, "BUYUK_ESIT") { ver ">="; }
    eğer metin_esit(t, "SOLA_KAYDIR") { ver "<<"; }
    eğer metin_esit(t, "SAGA_KAYDIR") { ver ">>"; }
    eğer metin_esit(t, "ARTI") { ver "+"; }
    eğer metin_esit(t, "EKSI") { ver "-"; }
    eğer metin_esit(t, "YILDIZ") { ver "*"; }
    eğer metin_esit(t, "BOLU") { ver "/"; }
    ver "%";
}

// ---- İleri bildirimler (özyineleme) parser'da gerek yok; KEMGU tek-geçiş
//      değil ama çağrı sırası: parse_oncelik <-> parse_onek <-> parse_birincil
//      <-> parse_sonek hepsi aşağıda; KEMGU forward-ref destekler. ----

// Generic argüman listesi `< T1, T2, ... >` → çocuk Dizi (>> kapanış böl).
işlev parse_generic_args(p: &değişken Ayr) -> Dizi<tam32> {
    bekle(p, "KUCUK");
    değişken args: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    eğer simdiki_buyuk_mu(p) { devam = yanlış; }
    iken devam {
        dizi_ekle(args, parse_tip(p));
        eğer sim_mi(p, "VIRGUL") { ilerle(p); }
        değilse { devam = yanlış; }
    }
    bekle_buyuk(p);
    ver args;
}
// Tek-argümanlı generic tip (seçimlik/tekkez/sabitsüre/görev/kanal/yetki).
işlev parse_tek_arg(p: &değişken Ayr, dad: metin, s: tam32, u: tam32) -> tam32 {
    bekle(p, "KUCUK");
    değişken ic: tam32 = parse_tip(p);
    bekle_buyuk(p);
    ver dugum1(p, dad, "", s, u, ic);
}

// Tam tip sözdizimi (ifade.c parse_tip ile birebir) — P4.
işlev parse_tip(p: &değişken Ayr) -> tam32 {
    değişken t: metin = simdiki(p);
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    // &T / &değişken T
    eğer metin_esit(t, "VE_BIT") {
        ilerle(p);
        değişken dv: metin = "";
        eğer sim_mi(p, "DEGISKEN") { ilerle(p); dv = "degisken"; }
        ver dugum1(p, "TIP_REFERANS", dv, s, u, parse_tip(p));
    }
    // *T
    eğer metin_esit(t, "YILDIZ") {
        ilerle(p);
        ver dugum1(p, "TIP_POINTER", "", s, u, parse_tip(p));
    }
    eğer metin_esit(t, "TEKKEZ") { ilerle(p); ver parse_tek_arg(p, "TIP_TEKKEZ", s, u); }
    eğer metin_esit(t, "SABITSURE") { ilerle(p); ver parse_tek_arg(p, "TIP_SABITSURE", s, u); }
    eğer metin_esit(t, "GOREV") { ilerle(p); ver parse_tek_arg(p, "TIP_GOREV", s, u); }
    eğer metin_esit(t, "KANAL") { ilerle(p); ver parse_tek_arg(p, "TIP_KANAL", s, u); }
    eğer metin_esit(t, "YETKI") { ilerle(p); ver parse_tek_arg(p, "TIP_YETKI", s, u); }
    eğer metin_esit(t, "SECIMLIK") { ilerle(p); ver parse_tek_arg(p, "TIP_SECIMLIK", s, u); }
    // sonuç<T,H>
    eğer metin_esit(t, "SONUC") {
        ilerle(p);
        bekle(p, "KUCUK");
        değişken dt: tam32 = parse_tip(p);
        bekle(p, "VIRGUL");
        değişken ht: tam32 = parse_tip(p);
        bekle_buyuk(p);
        ver dugum2(p, "TIP_SONUC", "", s, u, dt, ht);
    }
    // vektör<T, N> (N = compile-time tamsayı)
    eğer metin_esit(t, "VEKTOR") {
        ilerle(p);
        bekle(p, "KUCUK");
        değişken et: tam32 = parse_tip(p);
        bekle(p, "VIRGUL");
        değişken lane: metin = sim_lex(p);
        bekle(p, "TAMSAYI");
        bekle_buyuk(p);
        ver dugum1(p, "TIP_VEKTOR", lane, s, u, et);
    }
    // işlev(T1, ...) -> T
    eğer metin_esit(t, "ISLEV") {
        ilerle(p);
        bekle(p, "SOL_PAREN");
        değişken kids: Dizi<tam32> = [];
        eğer sim_mi(p, "SAG_PAREN") == yanlış {
            değişken devam: mantıksal = doğru;
            iken devam {
                eğer sim_mi(p, "SAG_PAREN") { devam = yanlış; }
                değilse {
                    dizi_ekle(kids, parse_tip(p));
                    eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                    değilse { devam = yanlış; }
                }
            }
        }
        bekle(p, "SAG_PAREN");
        bekle(p, "OK");
        dizi_ekle(kids, parse_tip(p));   // dönüş tipi (çocukların SONU)
        ver dugum_n(p, "TIP_ISLEV", "", s, u, kids);
    }
    // boş → birim tip (TIP_BASIT "boş")
    eğer metin_esit(t, "BOS") {
        değişken ad: metin = sim_lex(p);
        ilerle(p);
        ver dugum0(p, "TIP_BASIT", ad, s, u);
    }
    // Tanımlayıcı: basit / kullanıcı / Dizi / nitelikli yol / generic
    eğer metin_esit(t, "TANIMLAYICI") {
        değişken ad: metin = sim_lex(p);
        ilerle(p);
        // nitelikli yol: modül::Tip[::Tip...]
        değişken yol: tam32 = 0;
        değişken nitelikli: mantıksal = yanlış;
        eğer sim_mi(p, "CIFT_IKI_NOKTA") {
            yol = dugum0(p, "TANIMLAYICI", ad, s, u);
            iken sim_mi(p, "CIFT_IKI_NOKTA") {
                ilerle(p);
                değişken sag: metin = sim_lex(p);
                bekle(p, "TANIMLAYICI");
                yol = dugum1(p, "YOL", sag, s, u, yol);
            }
            nitelikli = doğru;
        }
        // generic argümanlar?
        eğer sim_mi(p, "KUCUK") {
            değişken args: Dizi<tam32> = parse_generic_args(p);
            // Dizi<T> özel (yalnız niteliksiz)
            eğer (nitelikli == yanlış) ve metin_esit(ad, "Dizi") ve (dizi_boyut(args) == 1) {
                ver dugum1(p, "TIP_DIZI", "", s, u, dizi_al(args, 0));
            }
            değişken yk: tam32 = yol;
            eğer nitelikli == yanlış { yk = dugum0(p, "TANIMLAYICI", ad, s, u); }
            değişken kids: Dizi<tam32> = [];
            dizi_ekle(kids, yk);
            değişken i: tam32 = 0;
            iken i < dizi_boyut(args) { dizi_ekle(kids, dizi_al(args, i)); i = i + 1; }
            ver dugum_n(p, "TIP_KULLANICI", "", s, u, kids);
        }
        // niteliksiz generic-siz: nitelikli yol → KULLANICI, değilse BASIT
        eğer nitelikli {
            ver dugum1(p, "TIP_KULLANICI", "", s, u, yol);
        }
        ver dugum0(p, "TIP_BASIT", ad, s, u);
    }
    p.hata_say = p.hata_say + 1;
    ilerle(p);
    ver dugum0(p, "HATA", "", s, u);
}

// Yapı oluşturma: Tip { alan: ifade, ... } (poz = tip_id).
işlev parse_yapi_olustur(p: &değişken Ayr, tip_ad: metin, s: tam32, u: tam32) -> tam32 {
    ilerle(p);  // '{'
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse {
            değişken as: tam32 = sim_sat(p);  değişken au: tam32 = sim_sut(p);
            değişken alan: metin = sim_lex(p);
            bekle(p, "TANIMLAYICI");
            bekle(p, "IKI_NOKTA");
            değişken dg: tam32 = parse_ifade(p);
            dizi_ekle(kids, dugum1(p, "ALAN_ATAMA", alan, as, au, dg));
            eğer sim_mi(p, "VIRGUL") { ilerle(p); }
            değilse { devam = yanlış; }
        }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "YAPI_OLUSTUR", tip_ad, s, u, kids);
}
// Dizi oluşturma: [e1, e2, ...] (poz = '[').
işlev parse_dizi_olustur(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // '['
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_KOSELI") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse {
            dizi_ekle(kids, parse_ifade(p));
            eğer sim_mi(p, "VIRGUL") { ilerle(p); }
            değilse { devam = yanlış; }
        }
    }
    bekle(p, "SAG_KOSELI");
    ver dugum_n(p, "DIZI_OLUSTUR", "", s, u, kids);
}
// Parametre: ad ":" tip  |  kendin  |  &kendin  |  &değişken kendin.
işlev parse_parametre(p: &değişken Ayr) -> tam32 {
    // & ile başlayan kendin: &kendin / &değişken kendin
    eğer sim_mi(p, "VE_BIT") {
        değişken nxt: metin = tip_i(p, p.imlec + 1);
        eğer metin_esit(nxt, "KENDIN") veya metin_esit(nxt, "DEGISKEN") {
            ilerle(p);  // &
            eğer sim_mi(p, "DEGISKEN") { ilerle(p); }
            değişken ks: tam32 = sim_sat(p);  değişken ku: tam32 = sim_sut(p);
            eğer sim_mi(p, "KENDIN") {
                ilerle(p);
                ver dugum0(p, "PARAMETRE", "kendin", ks, ku);
            }
            p.hata_say = p.hata_say + 1;
            ver dugum0(p, "HATA", "", ks, ku);
        }
    }
    eğer sim_mi(p, "KENDIN") {
        değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
        ilerle(p);
        ver dugum0(p, "PARAMETRE", "kendin", s, u);
    }
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    bekle(p, "IKI_NOKTA");
    ver dugum1(p, "PARAMETRE", ad, s, u, parse_tip(p));
}
// Generic tip parametre listesi `<T, U: B1 + B2, ...>` — PARSE + DISCARD (dump'ta
// yok; bound tip düğümleri orphan kalır, kök'ten erişilmez). `>>` kapanış böl.
işlev atla_tip_paramlar(p: &değişken Ayr) -> tam32 { ver atla_tip_paramlar_sahipli(p, ""); }
// D-369: `sahip` verilirse generic parametre ADLARI ve BOUND'ları yan-kanala
// yazılır (dump DEĞİŞMEZ — düğüm üretilmiyor). T030/T031 bu tabloya dayanır:
// `Vektor<Tam>` yazıldığında T'nin bound'ları burada bulunur.
işlev atla_tip_paramlar_sahipli(p: &değişken Ayr, sahip: metin) -> tam32 {
    eğer sim_mi(p, "KUCUK") == yanlış { ver 0; }
    bekle(p, "KUCUK");
    değişken devam: mantıksal = doğru;
    değişken pi: tam32 = 0;
    eğer simdiki_buyuk_mu(p) { devam = yanlış; }
    iken devam {
        // D-370: param ADI da yan-kanala — T011 evreninde generic paramlar MUAF.
        // Kapsam-duyarsız (tüm bildirimlerin paramları tek listede): yalnız
        // EKSİK tanı üretebilir, YANLIŞ tanı üretemez.
        dizi_ekle(p.gp_ad, sim_lex(p));
        bekle(p, "TANIMLAYICI");          // param adı
        eğer sim_mi(p, "IKI_NOKTA") {     // bound listesi
            ilerle(p);
            değişken b1: metin = sim_lex(p);
            parse_tip(p);                 // ilk bound (orphan düğüm)
            eğer metin_esit(sahip, "") == yanlış {
                dizi_ekle(p.gp_sahip, sahip); dizi_ekle(p.gp_idx, pi);
                dizi_ekle(p.gp_bound, b1);
            }
            iken sim_mi(p, "ARTI") {
                ilerle(p);
                değişken bn: metin = sim_lex(p);
                parse_tip(p);
                eğer metin_esit(sahip, "") == yanlış {
                    dizi_ekle(p.gp_sahip, sahip); dizi_ekle(p.gp_idx, pi);
                    dizi_ekle(p.gp_bound, bn);
                }
            }
        }
        pi = pi + 1;
        eğer sim_mi(p, "VIRGUL") { ilerle(p); }
        değilse { devam = yanlış; }
    }
    bekle_buyuk(p);
    ver 0;
}
// Lambda: |p: t, ...| ifade  veya  |...| { blok } (poz = ilk '|').
işlev parse_lambda(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // ilk '|' (VEYA_BIT)
    değişken kids: Dizi<tam32> = [];
    eğer sim_mi(p, "VEYA_BIT") == yanlış {
        değişken devam: mantıksal = doğru;
        iken devam {
            dizi_ekle(kids, parse_parametre(p));
            eğer sim_mi(p, "VIRGUL") { ilerle(p); }
            değilse { devam = yanlış; }
        }
    }
    bekle(p, "VEYA_BIT");  // kapanış '|'
    eğer sim_mi(p, "SOL_SUSLU") { dizi_ekle(kids, parse_blok(p)); }
    değilse { dizi_ekle(kids, parse_ifade(p)); }
    ver dugum_n(p, "LAMBDA", "", s, u, kids);
}

// Birincil ifade.
işlev parse_birincil(p: &değişken Ayr) -> tam32 {
    değişken t: metin = simdiki(p);
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    eğer metin_esit(t, "TAMSAYI") {
        değişken v: tam64 = tamsayi_deger(sim_lex(p));
        ilerle(p);
        ver dugum0(p, "TAM", tam64_str(v), s, u);
    }
    eğer metin_esit(t, "ONDALIK") {
        değişken lx: metin = sim_lex(p);
        ilerle(p);
        ver dugum0(p, "KESIRLI", ondalik_bicimle(lx), s, u);
    }
    eğer metin_esit(t, "DOGRU") { ilerle(p); ver dugum0(p, "MANTIKSAL", "1", s, u); }
    eğer metin_esit(t, "YANLIS") { ilerle(p); ver dugum0(p, "MANTIKSAL", "0", s, u); }
    eğer metin_esit(t, "BOS") { ilerle(p); ver dugum0(p, "BOS", "", s, u); }
    eğer metin_esit(t, "TANIMLAYICI") veya metin_esit(t, "KENDIN")
      veya metin_esit(t, "HIC") veya metin_esit(t, "DEGER")
      veya metin_esit(t, "TAMAM") veya metin_esit(t, "HATA") {
        değişken ad: metin = sim_lex(p);
        ilerle(p);
        eğer (p.yapi_izni == 1) ve sim_mi(p, "SOL_SUSLU") { ver parse_yapi_olustur(p, ad, s, u); }
        ver dugum0(p, "TANIMLAYICI", ad, s, u);
    }
    eğer metin_esit(t, "METIN") {
        değişken off: tam32 = dizi_al(p.t_off, p.imlec);
        değişken ln: tam32 = dizi_al(p.t_uz, p.imlec);
        değişken icuz: tam32 = ln - 2;
        eğer icuz < 0 { icuz = 0; }
        değişken ic: metin = metin_kes(p.kaynak, off + 1, icuz);
        ilerle(p);
        ver dugum0(p, "METIN", ic, s, u);
    }
    eğer metin_esit(t, "KARAKTER") {
        değişken off: tam32 = dizi_al(p.t_off, p.imlec);
        değişken ln: tam32 = dizi_al(p.t_uz, p.imlec);
        değişken kp: tam32 = 0;
        eğer ln >= 3 { kp = bayt(p.kaynak, off + 1); }
        ilerle(p);
        ver dugum0(p, "KARAKTER", karakter_deger(kp), s, u);
    }
    eğer metin_esit(t, "SOL_KOSELI") { ver parse_dizi_olustur(p); }
    eğer metin_esit(t, "VEYA_BIT") { ver parse_lambda(p); }
    eğer metin_esit(t, "KULLAN") {
        ilerle(p);
        bekle(p, "SOL_PAREN");
        değişken e: tam32 = parse_ifade(p);
        bekle(p, "SAG_PAREN");
        ver dugum1(p, "KULLAN_IFADE", "", s, u, e);
    }
    eğer metin_esit(t, "IMHA") {
        ilerle(p);
        bekle(p, "SOL_PAREN");
        değişken e: tam32 = parse_ifade(p);
        bekle(p, "SAG_PAREN");
        ver dugum1(p, "IMHA_IFADE", "", s, u, e);
    }
    // delege(y, izin) / geri_al(y) → DUGUM_CAGRI (hedef = TANIMLAYICI "delege"/"geri_al")
    eğer metin_esit(t, "DELEGE") veya metin_esit(t, "GERI_AL") {
        değişken ad: metin = sim_lex(p);
        ilerle(p);
        bekle(p, "SOL_PAREN");
        değişken kids: Dizi<tam32> = [];
        dizi_ekle(kids, dugum0(p, "TANIMLAYICI", ad, s, u));  // hedef
        eğer sim_mi(p, "SAG_PAREN") == yanlış {
            değişken devam: mantıksal = doğru;
            iken devam {
                dizi_ekle(kids, parse_ifade(p));
                eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                değilse { devam = yanlış; }
            }
        }
        bekle(p, "SAG_PAREN");
        ver dugum_n(p, "CAGRI", "", s, u, kids);
    }
    eğer metin_esit(t, "SOL_PAREN") {
        ilerle(p);
        değişken ic: tam32 = parse_ifade(p);
        bekle(p, "SAG_PAREN");
        ver ic;
    }
    // P1 dışı (KESIRLI float → sonraki adım): hata düğümü
    p.hata_say = p.hata_say + 1;
    ilerle(p);
    ver dugum0(p, "HATA", "", s, u);
}

// Önek operatörler (operand = parse_oncelik(ONC_ONEK=11)).
işlev parse_onek(p: &değişken Ayr) -> tam32 {
    değişken t: metin = simdiki(p);
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    eğer metin_esit(t, "EKSI") {
        ilerle(p);
        ver dugum1(p, "TEKLI", "neg", s, u, parse_oncelik(p, 11));
    }
    eğer metin_esit(t, "DEGIL") {
        ilerle(p);
        ver dugum1(p, "TEKLI", "degil", s, u, parse_oncelik(p, 11));
    }
    eğer metin_esit(t, "DEGIL_BIT") {
        ilerle(p);
        ver dugum1(p, "TEKLI", "~", s, u, parse_oncelik(p, 11));
    }
    eğer metin_esit(t, "YILDIZ") {
        ilerle(p);
        ver dugum1(p, "TEKLI", "deref*", s, u, parse_oncelik(p, 11));
    }
    eğer metin_esit(t, "VE_BIT") {
        ilerle(p);
        değişken opad: metin = "&";
        eğer sim_mi(p, "DEGISKEN") { ilerle(p); opad = "&degisken"; }
        ver dugum1(p, "TEKLI", opad, s, u, parse_oncelik(p, 11));
    }
    ver parse_birincil(p);
}

// Sonek operatör (. [] () :: olarak). Pozisyon = sonek token'ı.
işlev parse_sonek(p: &değişken Ayr, sol: tam32) -> tam32 {
    değişken t: metin = simdiki(p);
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    eğer metin_esit(t, "NOKTA") {
        ilerle(p);
        değişken alan: metin = sim_lex(p);
        bekle(p, "TANIMLAYICI");
        ver dugum1(p, "ERISIM", alan, s, u, sol);
    }
    eğer metin_esit(t, "SOL_KOSELI") {
        ilerle(p);
        değişken idx: tam32 = parse_ifade(p);
        bekle(p, "SAG_KOSELI");
        ver dugum2(p, "INDEKS", "", s, u, sol, idx);
    }
    eğer metin_esit(t, "SOL_PAREN") {
        ilerle(p);
        değişken kids: Dizi<tam32> = [];
        dizi_ekle(kids, sol);  // çocuk[0] = hedef
        eğer sim_mi(p, "SAG_PAREN") == yanlış {
            değişken devam: mantıksal = doğru;
            iken devam {
                eğer sim_mi(p, "SAG_PAREN") { devam = yanlış; }
                değilse {
                    dizi_ekle(kids, parse_ifade(p));
                    eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                    değilse { devam = yanlış; }
                }
            }
        }
        bekle(p, "SAG_PAREN");
        ver dugum_n(p, "CAGRI", "", s, u, kids);
    }
    eğer metin_esit(t, "CIFT_IKI_NOKTA") {
        ilerle(p);
        değişken sag: metin = sim_lex(p);
        bekle(p, "TANIMLAYICI");
        ver dugum1(p, "YOL", sag, s, u, sol);
    }
    eğer metin_esit(t, "OLARAK") {
        ilerle(p);
        değişken ht: tam32 = parse_tip(p);
        ver dugum2(p, "TIP_DONUSTUR", "", s, u, sol, ht);
    }
    ver sol;
}

// Pratt ana döngüsü (ifade.c parse_oncelik ile birebir).
işlev parse_oncelik(p: &değişken Ayr, min_onc: tam32) -> tam32 {
    değişken sol: tam32 = parse_onek(p);
    değişken devam: mantıksal = doğru;
    iken devam {
        değişken t: metin = simdiki(p);
        eğer sonek_onc(t) > min_onc {
            sol = parse_sonek(p, sol);
        } değilse {
            değişken oo: tam32 = ikili_onc(t);
            eğer oo <= min_onc { devam = yanlış; }
            değilse {
                değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
                değişken opad: metin = ikili_op_ad(t);
                ilerle(p);
                değişken sag: tam32 = parse_oncelik(p, oo);
                sol = dugum2(p, "IKILI", opad, s, u, sol, sag);
            }
        }
    }
    ver sol;
}
işlev parse_ifade(p: &değişken Ayr) -> tam32 { ver parse_oncelik(p, 0); }

// ---- P2: Deyimler / kontrol akışı ----
// Koşul ifadesi (yapı-oluştur izni KAPALI → `eğer x {` → '{' blok başı).
işlev parse_kosul(p: &değişken Ayr) -> tam32 {
    değişken eski: tam32 = p.yapi_izni;
    p.yapi_izni = 0;
    değişken d: tam32 = parse_ifade(p);
    p.yapi_izni = eski;
    ver d;
}
işlev parse_ver(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // ver
    değişken kids: Dizi<tam32> = [];
    eğer sim_mi(p, "NOKTALI_VIRGUL") == yanlış { dizi_ekle(kids, parse_ifade(p)); }
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum_n(p, "VER", "", s, u, kids);
}
işlev parse_degisken(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // değişken
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    değişken kids: Dizi<tam32> = [];
    eğer sim_mi(p, "IKI_NOKTA") { ilerle(p); dizi_ekle(kids, parse_tip(p)); }
    bekle(p, "ESIT");
    dizi_ekle(kids, parse_ifade(p));
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum_n(p, "DEGISKEN", ad, s, u, kids);
}
işlev parse_ifade_veya_atama(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    değişken e: tam32 = parse_ifade(p);
    eğer sim_mi(p, "ESIT") {
        ilerle(p);
        değişken dg: tam32 = parse_ifade(p);
        bekle(p, "NOKTALI_VIRGUL");
        ver dugum2(p, "ATAMA", "", s, u, e, dg);
    }
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum1(p, "IFADE_DEYIMI", "", s, u, e);
}
işlev parse_eger(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // eğer
    değişken kids: Dizi<tam32> = [];
    dizi_ekle(kids, parse_kosul(p));   // koşul
    dizi_ekle(kids, parse_blok(p));    // eğer dalı
    eğer sim_mi(p, "DEGILSE") {
        ilerle(p);
        eğer sim_mi(p, "EGER") { dizi_ekle(kids, parse_eger(p)); }  // else-if zinciri
        değilse { dizi_ekle(kids, parse_blok(p)); }
    }
    ver dugum_n(p, "EGER", "", s, u, kids);
}
işlev parse_iken(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // iken
    değişken kosul: tam32 = parse_kosul(p);
    değişken govde: tam32 = parse_blok(p);
    ver dugum2(p, "IKEN", "", s, u, kosul, govde);
}
işlev parse_icin(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // için
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    bekle(p, "IKI_NOKTA");
    değişken kol: tam32 = parse_kosul(p);
    değişken govde: tam32 = parse_blok(p);
    ver dugum2(p, "ICIN", ad, s, u, kol, govde);
}
işlev parse_guvensiz(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // güvensiz
    eğer sim_mi(p, "SOL_KOSELI") {     // [etiket: "..."] (dump'ta yok, tüket)
        ilerle(p);
        bekle(p, "TANIMLAYICI");
        bekle(p, "IKI_NOKTA");
        bekle(p, "METIN");
        bekle(p, "SAG_KOSELI");
    }
    ver dugum1(p, "GUVENSIZ", "", s, u, parse_blok(p));
}
// Desen (eşleş kolları için).
işlev parse_desen(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    eğer sim_mi(p, "TANIMLAYICI") ve metin_esit(sim_lex(p), "_") {
        ilerle(p);
        ver dugum0(p, "DESEN_JOKER", "", s, u);
    }
    eğer sim_mi(p, "TANIMLAYICI") veya sim_mi(p, "HIC") veya sim_mi(p, "DEGER")
      veya sim_mi(p, "TAMAM") veya sim_mi(p, "HATA") {
        değişken ad: metin = sim_lex(p);
        ilerle(p);
        eğer sim_mi(p, "CIFT_IKI_NOKTA") {        // Çeşit::Varyant [(payload)]
            ilerle(p);
            değişken vad: metin = sim_lex(p);
            bekle(p, "TANIMLAYICI");
            değişken kids: Dizi<tam32> = [];
            eğer sim_mi(p, "SOL_PAREN") {
                ilerle(p);
                değişken devam: mantıksal = doğru;
                iken devam {
                    eğer sim_mi(p, "SAG_PAREN") { devam = yanlış; }
                    değilse {
                        dizi_ekle(kids, parse_desen(p));
                        eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                        değilse { devam = yanlış; }
                    }
                }
                bekle(p, "SAG_PAREN");
            }
            ver dugum_n(p, "DESEN_YOL", metin_birlestir(metin_birlestir(ad, "::"), vad), s, u, kids);
        }
        // D-318: `YapiAdi { alan1, alan2 }` — yapı destructuring deseni.
        // Desen POZİSYONUNDA `{` belirsiz DEĞİLDİR (kol gövdesi `=>` sonrası).
        // Düğüm dump'ı C ile AYNI: değer BOŞ, çocuk YOK → --ast paritesi korunur;
        // yapı/alan adları YAN-KANALA yazılır (çeşit cv_*/cc_* deseni).
        eğer sim_mi(p, "SOL_SUSLU") {
            ilerle(p);   // {
            değişken alanlar: Dizi<metin> = [];
            değişken dvm: mantıksal = doğru;
            iken dvm {
                eğer sim_mi(p, "SAG_SUSLU") { dvm = yanlış; }
                değilse {
                    dizi_ekle(alanlar, sim_lex(p));
                    bekle(p, "TANIMLAYICI");
                    eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                    değilse { dvm = yanlış; }
                }
            }
            bekle(p, "SAG_SUSLU");
            değişken dn: tam32 = dugum0(p, "DESEN_YAPI", "", s, u);
            dizi_ekle(p.dy_node, dn);
            dizi_ekle(p.dy_yapi, ad);
            değişken fi: tam32 = 0;
            iken fi < dizi_boyut(alanlar) {
                dizi_ekle(p.dyf_node, dn);
                dizi_ekle(p.dyf_alan, dizi_al(alanlar, fi));
                fi = fi + 1;
            }
            ver dn;
        }
        eğer sim_mi(p, "SOL_PAREN") {             // Yapıcı(alt, ...)
            ilerle(p);
            değişken kids: Dizi<tam32> = [];
            değişken devam: mantıksal = doğru;
            iken devam {
                eğer sim_mi(p, "SAG_PAREN") { devam = yanlış; }
                değilse {
                    dizi_ekle(kids, parse_desen(p));
                    eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                    değilse { devam = yanlış; }
                }
            }
            bekle(p, "SAG_PAREN");
            ver dugum_n(p, "DESEN_YAPICI", ad, s, u, kids);
        }
        ver dugum0(p, "DESEN_TANIMLAYICI", ad, s, u);
    }
    eğer sim_mi(p, "TAMSAYI") veya sim_mi(p, "ONDALIK") veya sim_mi(p, "METIN")
      veya sim_mi(p, "KARAKTER") veya sim_mi(p, "DOGRU") veya sim_mi(p, "YANLIS")
      veya sim_mi(p, "BOS") {
        ver dugum1(p, "DESEN_LITERAL", "", s, u, parse_ifade(p));
    }
    p.hata_say = p.hata_say + 1;
    ilerle(p);
    ver dugum0(p, "HATA", "", s, u);
}
işlev parse_esles_kolu(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    değişken desen: tam32 = parse_desen(p);
    bekle(p, "KALIN_OK");
    değişken govde: tam32 = 0;
    eğer sim_mi(p, "SOL_SUSLU") { govde = parse_blok(p); }
    değilse { govde = parse_ifade(p); bekle(p, "NOKTALI_VIRGUL"); }
    ver dugum2(p, "ESLES_KOLU", "", s, u, desen, govde);
}
işlev parse_esles(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // eşleş
    değişken kids: Dizi<tam32> = [];
    dizi_ekle(kids, parse_kosul(p));   // eşleşen değer
    bekle(p, "SOL_SUSLU");
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse { dizi_ekle(kids, parse_esles_kolu(p)); }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "ESLES", "", s, u, kids);
}
// satıriçi_asm { mimari: X  şablon: r#".."#  çıktı("k",&v) girdi("k",e) bozulan("k") çevrim: N }
// Yalnız `girdi` ifadeleri AST çocuğu (C ast_duz_yaz); gerisi tüketilir.
işlev asm_kisit_atla(p: &değişken Ayr) -> tam32 {
    eğer sim_mi(p, "METIN") veya sim_mi(p, "HAM_METIN") { ilerle(p); ver 1; }
    p.hata_say = p.hata_say + 1; ver 0;
}
işlev parse_satirici_asm(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // satıriçi_asm
    bekle(p, "SOL_SUSLU");
    değişken kids: Dizi<tam32> = [];   // girdi ifadeleri
    değişken mim: metin = "";          // D-373: `mimari:` etiketi (AS001 yan-kanalı)
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse {
            değişken lx: metin = sim_lex(p);
            eğer metin_esit(lx, "mimari") {
                ilerle(p); bekle(p, "IKI_NOKTA");
                mim = sim_lex(p);   // D-373: etiketi YAKALA (düğüme alan eklemek
                                    // `--ast` paritesini bozardı → yan-kanal)
                bekle(p, "TANIMLAYICI");
            } değilse {
            eğer metin_esit(lx, "şablon") {
                ilerle(p); bekle(p, "IKI_NOKTA"); asm_kisit_atla(p);
            } değilse {
            eğer metin_esit(lx, "çevrim") {
                ilerle(p); bekle(p, "IKI_NOKTA"); parse_ifade(p);
            } değilse {
            eğer metin_esit(lx, "çıktı") {
                ilerle(p); bekle(p, "SOL_PAREN"); asm_kisit_atla(p);
                bekle(p, "VIRGUL"); bekle(p, "VE_BIT");
                eğer sim_mi(p, "DEGISKEN") { ilerle(p); }
                bekle(p, "TANIMLAYICI"); bekle(p, "SAG_PAREN");
            } değilse {
            eğer metin_esit(lx, "girdi") {
                ilerle(p); bekle(p, "SOL_PAREN"); asm_kisit_atla(p);
                bekle(p, "VIRGUL"); dizi_ekle(kids, parse_ifade(p)); bekle(p, "SAG_PAREN");
            } değilse {
            eğer metin_esit(lx, "bozulan") {
                ilerle(p); bekle(p, "SOL_PAREN"); asm_kisit_atla(p); bekle(p, "SAG_PAREN");
            } değilse {
                p.hata_say = p.hata_say + 1; ilerle(p);   // bilinmeyen clause
            } } } } } }
        }
    }
    bekle(p, "SAG_SUSLU");
    değişken nd: tam32 = dugum_n(p, "SATIRICI_ASM", "", s, u, kids);
    dizi_ekle(p.asm_node, nd); dizi_ekle(p.asm_mim, mim);   // D-373
    ver nd;
}
işlev parse_deyim(p: &değişken Ayr) -> tam32 {
    eğer sim_mi(p, "DEGISKEN") { ver parse_degisken(p); }
    eğer sim_mi(p, "VER") { ver parse_ver(p); }
    eğer sim_mi(p, "SOL_SUSLU") { ver parse_blok(p); }
    eğer sim_mi(p, "EGER") { ver parse_eger(p); }
    eğer sim_mi(p, "IKEN") { ver parse_iken(p); }
    eğer sim_mi(p, "ICIN") { ver parse_icin(p); }
    eğer sim_mi(p, "ESLES") { ver parse_esles(p); }
    eğer sim_mi(p, "GUVENSIZ") { ver parse_guvensiz(p); }
    eğer sim_mi(p, "SATIRICI_ASM") { ver parse_satirici_asm(p); }
    ver parse_ifade_veya_atama(p);
}
işlev parse_blok(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    bekle(p, "SOL_SUSLU");
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse { dizi_ekle(kids, parse_deyim(p)); }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "BLOK", "", s, u, kids);
}
// ---- P3: Bildirimler (işlev/yapı/çeşit/özellik/uygula/sabit) ----
// İşlev (gerçekzamanlı? + generic + param + dönüş + gövde). imza_yeterli=1 →
// gövde yerine ';' (özellik imzası). Generic params PARSE+DISCARD (dump'ta yok).
işlev parse_islev_genel(p: &değişken Ayr, imza_yeterli: tam32) -> tam32 {
    // D-255: çıplak / gerçekzamanlı işlev-modifier (herhangi sıra). C parser.c aynası.
    // D-351: `çıplak` YAN-KANALDA kaydedilir (düğüme alan eklenmez → --ast/--parse
    // dump paritesi bozulmaz). C D-257: çıplak gövde örtük `güvensiz` bağlamdır.
    değişken devam_mod: mantıksal = doğru;
    değişken ciplak_mi: mantıksal = yanlış;
    iken devam_mod {
        eğer sim_mi(p, "GERCEKZAMANLI") { ilerle(p); }
        değilse {
            eğer sim_mi(p, "CIPLAK") { ilerle(p); ciplak_mi = doğru; }
            değilse { devam_mod = yanlış; }
        }
    }
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    bekle(p, "ISLEV");
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    atla_tip_paramlar(p);
    bekle(p, "SOL_PAREN");
    değişken kids: Dizi<tam32> = [];
    eğer sim_mi(p, "SAG_PAREN") == yanlış {
        değişken devam: mantıksal = doğru;
        iken devam {
            dizi_ekle(kids, parse_parametre(p));
            eğer sim_mi(p, "VIRGUL") { ilerle(p); }
            değilse { devam = yanlış; }
        }
    }
    bekle(p, "SAG_PAREN");
    eğer sim_mi(p, "OK") { ilerle(p); dizi_ekle(kids, parse_tip(p)); }
    eğer sim_mi(p, "SOL_SUSLU") { dizi_ekle(kids, parse_blok(p)); }
    değilse {
        eğer (imza_yeterli == 1) ve sim_mi(p, "NOKTALI_VIRGUL") { ilerle(p); }
        değilse { p.hata_say = p.hata_say + 1; }
    }
    değişken fn: tam32 = dugum_n(p, "ISLEV", ad, s, u, kids);
    eğer ciplak_mi { dizi_ekle(p.cip_node, fn); }   // D-351 yan-kanal
    ver fn;
}
işlev parse_islev(p: &değişken Ayr) -> tam32 { ver parse_islev_genel(p, 0); }

işlev parse_alan(p: &değişken Ayr) -> tam32 {
    eğer sim_mi(p, "GENEL") { ilerle(p); }   // genel öneki (dump'ta yok)
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    bekle(p, "IKI_NOKTA");
    değişken tip: tam32 = parse_tip(p);
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum1(p, "ALAN", ad, s, u, tip);
}
işlev parse_yapi(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // yapı
    // D-314 (Linear V2 portu): `yapı tekkez K { ... }` — yapının KENDİSİ lineer.
    değişken lineer: mantıksal = yanlış;
    eğer sim_mi(p, "TEKKEZ") { lineer = doğru; ilerle(p); }
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    eğer lineer { dizi_ekle(p.ly_ad, ad); }
    atla_tip_paramlar_sahipli(p, ad);   // D-369: bound tablosu (T030/T031)
    bekle(p, "SOL_SUSLU");
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse { dizi_ekle(kids, parse_alan(p)); }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "YAPI", ad, s, u, kids);
}
işlev parse_cesit(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // çeşit
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    eğer sim_mi(p, "KUCUK") {           // çeşit generic v1'de YOK → atla (C birebir)
        p.hata_say = p.hata_say + 1;
        iken (sim_mi(p, "BUYUK") == yanlış) ve (sim_mi(p, "SOL_SUSLU") == yanlış)
          ve (sim_mi(p, "DOSYA_SONU") == yanlış) { ilerle(p); }
        eğer sim_mi(p, "BUYUK") { ilerle(p); }
    }
    bekle(p, "SOL_SUSLU");
    değişken kids: Dizi<tam32> = [];   // payload tip düğümleri (varyant-sırası düz)
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse {
            eğer sim_mi(p, "TANIMLAYICI") == yanlış {  // anti-hang (C panik_sync+break)
                p.hata_say = p.hata_say + 1; ilerle(p); devam = yanlış;
            } değilse {
            değişken vad: metin = sim_lex(p);
            ilerle(p);   // varyant adı (dump'ta yok)
            dizi_ekle(p.cv_cesit, ad);   // D-352 yan-kanal: M001 için varyant tablosu
            dizi_ekle(p.cv_ad, vad);
            değişken pc0: tam32 = dizi_boyut(kids);   // D-357: payload alan sayısı (M003)
            eğer sim_mi(p, "SOL_PAREN") {
                ilerle(p);
                değişken d2: mantıksal = doğru;
                iken d2 {
                    eğer sim_mi(p, "SAG_PAREN") { d2 = yanlış; }
                    değilse {
                        dizi_ekle(kids, parse_tip(p));
                        eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                        değilse { d2 = yanlış; }
                    }
                }
                bekle(p, "SAG_PAREN");
            }
            dizi_ekle(p.cv_pc, dizi_boyut(kids) - pc0);   // D-357
            // D-368 M004: payload TİP dizgilerini düz tabloya yaz (varyant başına
            // taban + sayı). `kids` bu çeşidin payload tip düğümlerini varyant
            // sırasında tutuyor; tip_str TIP_BASIT dışını "?" yapar → emin
            // olmadığımız yerde karşılaştırma atlanır.
            dizi_ekle(p.cv_pb, dizi_boyut(p.cv_pt));
            değişken pk: tam32 = pc0;
            iken pk < dizi_boyut(kids) {
                dizi_ekle(p.cv_pt, tip_str(p, dizi_al(kids, pk)));
                pk = pk + 1;
            }
            eğer sim_mi(p, "VIRGUL") { ilerle(p); }   // virgül opsiyonel
            }
        }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "CESIT", ad, s, u, kids);
}
işlev parse_ozellik(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // özellik
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    atla_tip_paramlar(p);
    bekle(p, "SOL_SUSLU");
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "ISLEV") veya sim_mi(p, "GERCEKZAMANLI") veya sim_mi(p, "CIPLAK") {
            dizi_ekle(kids, parse_islev_genel(p, 1));
        } değilse { devam = yanlış; }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "OZELLIK", ad, s, u, kids);
}
işlev parse_uygula(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // uygula
    atla_tip_paramlar(p);
    değişken birinci: tam32 = parse_tip(p);
    değişken kids: Dizi<tam32> = [];
    eğer sim_mi(p, "ICIN") {           // trait impl: tip için hedef
        ilerle(p);
        dizi_ekle(kids, parse_tip(p));  // hedef tip (UYGULA.tip)
        dizi_ekle(kids, birinci);       // özellik (UYGULA.ozellikler[0])
    } değilse {
        dizi_ekle(kids, birinci);       // inherent: hedef = birinci
    }
    bekle(p, "SOL_SUSLU");
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "ISLEV") veya sim_mi(p, "GERCEKZAMANLI") veya sim_mi(p, "CIPLAK") {
            dizi_ekle(kids, parse_islev(p));
        } değilse { devam = yanlış; }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "UYGULA", "", s, u, kids);
}
işlev parse_sabit(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // sabit
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    bekle(p, "IKI_NOKTA");
    değişken tip: tam32 = parse_tip(p);
    bekle(p, "ESIT");
    değişken dg: tam32 = parse_ifade(p);
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum2(p, "SABIT", ad, s, u, tip, dg);
}
// D-253: küresel değişken ad: tip = init;  → "KURESEL" düğüm (C parser.c parite).
işlev parse_kuresel(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // küresel
    bekle(p, "DEGISKEN");
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    bekle(p, "IKI_NOKTA");
    değişken tip: tam32 = parse_tip(p);
    bekle(p, "ESIT");
    değişken dg: tam32 = parse_ifade(p);
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum2(p, "KURESEL", ad, s, u, tip, dg);
}
// ---- P5: modül / kullan / dışa / genel ----
// kullan m[::seg...][::{a,b}][olarak d];  → KULLAN (deger=yol; seçili/alias dump'ta yok).
işlev parse_kullan(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // kullan
    değişken yol: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    değişken devam: mantıksal = doğru;
    iken devam ve sim_mi(p, "CIFT_IKI_NOKTA") {
        ilerle(p);
        eğer sim_mi(p, "SOL_SUSLU") {      // ::{a, b} seçili import
            ilerle(p);
            değişken d2: mantıksal = doğru;
            iken d2 {
                // D-361 yan-kanal: seçili adlar NİTELİKSİZ gelir → global ad
                // olarak kaydedilmezse geçerli kullanımları sahte T002 alır
                // (ana_secili.kem ile ölçüldü). Aynı ad iki modülden gelirse T042.
                değişken sad: metin = sim_lex(p);
                bekle(p, "TANIMLAYICI");
                dizi_ekle(p.si_ad, sad);
                dizi_ekle(p.si_yol, yol);
                eğer sim_mi(p, "VIRGUL") { ilerle(p); }
                değilse { d2 = yanlış; }
            }
            bekle(p, "SAG_SUSLU");
            devam = yanlış;
        } değilse {
            değişken seg: metin = sim_lex(p);
            bekle(p, "TANIMLAYICI");
            yol = metin_birlestir(metin_birlestir(yol, "::"), seg);
        }
    }
    eğer sim_mi(p, "OLARAK") {   // alias: `kullan m olarak d` → `d::` de geçerli modül
        ilerle(p);
        dizi_ekle(p.mod_ad, sim_lex(p));   // D-362 yan-kanal (T016 yanlış-pozitifi önler)
        bekle(p, "TANIMLAYICI");
    }
    bekle(p, "NOKTALI_VIRGUL");
    ver dugum0(p, "KULLAN", yol, s, u);
}
// genel/dışa sonrası tanım (işlev/yapı/çeşit/sabit).
işlev parse_disa_govde(p: &değişken Ayr) -> tam32 {
    eğer sim_mi(p, "GERCEKZAMANLI") veya sim_mi(p, "ISLEV") veya sim_mi(p, "CIPLAK") { ver parse_islev(p); }
    eğer sim_mi(p, "YAPI") { ver parse_yapi(p); }
    eğer sim_mi(p, "CESIT") { ver parse_cesit(p); }
    eğer sim_mi(p, "SABIT") { ver parse_sabit(p); }
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    p.hata_say = p.hata_say + 1;
    ilerle(p);
    ver dugum0(p, "HATA", "", s, u);
}
işlev parse_disa(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // dışa
    ver dugum1(p, "DISA", "", s, u, parse_disa_govde(p));
}
// genel SARMALAMAZ — iç tanımı doğrudan döner (genel_mi bayrağı dump'ta yok).
işlev parse_genel(p: &değişken Ayr) -> tam32 {
    ilerle(p);  // genel
    // D-363: `genel` düğüme yansımıyor (parse_disa_govde ÇIPLAK tanım döner) →
    // `genel işlev f` ile `işlev f` ayırt edilemiyordu. Yan-kanal: işaretli
    // düğümler. T041 (private-by-default) bu ayrımın üstünde duruyor.
    değişken n: tam32 = parse_disa_govde(p);
    dizi_ekle(p.gen_node, n);
    ver n;
}
işlev parse_modul(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    ilerle(p);  // modül
    değişken ad: metin = sim_lex(p);
    bekle(p, "TANIMLAYICI");
    bekle(p, "SOL_SUSLU");
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "SAG_SUSLU") veya sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse { dizi_ekle(kids, parse_ust_oge(p)); }
    }
    bekle(p, "SAG_SUSLU");
    ver dugum_n(p, "MODUL", ad, s, u, kids);
}
işlev parse_ust_oge(p: &değişken Ayr) -> tam32 {
    eğer sim_mi(p, "GERCEKZAMANLI") veya sim_mi(p, "ISLEV") veya sim_mi(p, "CIPLAK") { ver parse_islev(p); }
    eğer sim_mi(p, "KURESEL") { ver parse_kuresel(p); }   // D-253
    eğer sim_mi(p, "YAPI") { ver parse_yapi(p); }
    eğer sim_mi(p, "CESIT") { ver parse_cesit(p); }
    eğer sim_mi(p, "OZELLIK") { ver parse_ozellik(p); }
    eğer sim_mi(p, "UYGULA") { ver parse_uygula(p); }
    eğer sim_mi(p, "SABIT") { ver parse_sabit(p); }
    eğer sim_mi(p, "KULLAN") { ver parse_kullan(p); }
    eğer sim_mi(p, "DISA") { ver parse_disa(p); }
    eğer sim_mi(p, "GENEL") { ver parse_genel(p); }
    eğer sim_mi(p, "MODUL") { ver parse_modul(p); }
    // P5: satıriçi_asm (üst düzey değil; deyim) — kalan
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);
    p.hata_say = p.hata_say + 1;
    ilerle(p);
    ver dugum0(p, "HATA", "", s, u);
}
işlev parse_program(p: &değişken Ayr) -> tam32 {
    değişken s: tam32 = sim_sat(p);  değişken u: tam32 = sim_sut(p);  // ilk token konumu
    değişken kids: Dizi<tam32> = [];
    değişken devam: mantıksal = doğru;
    iken devam {
        eğer sim_mi(p, "DOSYA_SONU") { devam = yanlış; }
        değilse { dizi_ekle(kids, parse_ust_oge(p)); }
    }
    ver dugum_n(p, "PROGRAM", "", s, u, kids);
}

// ---- Düz --ast dumper (preorder; C ast_duz_yaz ile birebir) ----
işlev duz_yaz(p: &değişken Ayr, idx: tam32, derinlik: tam32) -> tam32 {
    yaz_tam(derinlik);  yb(9);
    yaz_str(dizi_al(p.a_ad, idx));  yb(9);
    yaz_kacis(dizi_al(p.a_deg, idx));  yb(9);
    yaz_tam(dizi_al(p.a_sat, idx));  yb(9);
    yaz_tam(dizi_al(p.a_sut, idx));  yb(10);
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken cs: tam32 = dizi_al(p.a_cs, idx);
    değişken i: tam32 = 0;
    iken i < cs {
        duz_yaz(p, dizi_al(p.cocuk, cb + i), derinlik + 1);
        i = i + 1;
    }
    ver 0;
}

işlev ayr_olustur(kaynak: metin) -> Ayr {
    ver Ayr {
        kaynak: kaynak,
        t_ad: [], t_sat: [], t_sut: [], t_off: [], t_uz: [],
        imlec: 0,
        a_ad: [], a_deg: [], a_sat: [], a_sut: [], a_cb: [], a_cs: [], cocuk: [],
        hata_say: 0,
        yapi_izni: 1,
        sk_pending: 0,
        g_isim: [], yerel: [], yerel_tip: [], yerel_ptr: [], yerel_ham: [], yerel_dizi: [], yerel_yig: [], yerel_fn: [], yerel_yet: [], yerel_yon: [], yerel_sab: [], drf_bek: "", dizi_bek: "?", cv_cesit: [], cv_ad: [], cv_pc: [], cv_pb: [], cv_pt: [], kur_ad: [], cip_node: [], asm_node: [], asm_mim: [], si_ad: [], si_yol: [], mod_ad: [], gp_ad: [], gp_sahip: [], gp_idx: [], gp_bound: [], oz_ad: [], uyg_tip: [], uyg_oz: [], gen_node: [], priv_mod: [], priv_ad: [], yerel_basla: 0, aktif_donus: "boş", aktif_fn: 0 - 1,
        fn_ad: [], fn_donus: [], fn_psay: [], fn_pbase: [], fn_ptip: [], fn_plin: [], fn_pdizi: [],
        yapi_ad: [], yapi_abase: [], yapi_acount: [], alan_ad: [], alan_tip: [],
        giris_dizin: "", kullan_gorulen: [],
        ly_ad: [], lyf_yapi: [], lyf_alan: [], lin_ad: [], lin_sat: [], lin_sut: [], lin_tuk: [], dy_node: [], dy_yapi: [], dyf_node: [], dyf_alan: [], lin_maske: [], lin_fnk: [], lin_tek: [], lin_yet: [], snap_tuk: [], snap_maske: [], snap_top: 0, imha_bag: 0, guv_bag: 0, cip_bag: 0, lin_basla: 0,
        th_kod: [], th_sat: [], th_sut: []
    };
}

// =========================================================================
// TC1: tip denetleyici — temel kapsam/ad çözümü (T002 tanımsız sembol).
// C tip_kontrol.c accept/reject + tanı paritesi (--checkdump oracle).
// Mimari (D-051): genel + yerel-dilim isim kümeleri, parser AST traversal.
// Tip/desen alt-ağaçları + YOL atlanır (ileri TC). hiç → T002 muaf.
// =========================================================================

işlev g_ekle(p: &değişken Ayr, ad: metin) -> tam32 { dizi_ekle(p.g_isim, ad); ver 0; }
// 47 builtin (tip_kontrol.c EKLE_BUILTIN) + sık özel-builtin'ler.
işlev builtin_ekle(p: &değişken Ayr) -> tam32 {
    g_ekle(p, "yazdir"); g_ekle(p, "yazdir_tam"); g_ekle(p, "yazdir_tam64");
    g_ekle(p, "yazdir_satir"); g_ekle(p, "yazdir_metin"); g_ekle(p, "yazdir_karakter");
    g_ekle(p, "yazdir_isaretsiz_tam"); g_ekle(p, "yazdir_isaretsiz_tam64");
    g_ekle(p, "yazdir_onaltilik"); g_ekle(p, "yaz_tam"); g_ekle(p, "yaz_tam64");
    g_ekle(p, "yaz_bayt"); g_ekle(p, "yaz_karakter"); g_ekle(p, "yaz_onaltilik");
    g_ekle(p, "oku_karakter"); g_ekle(p, "ondalik_bicimle");
    g_ekle(p, "bellek_al"); g_ekle(p, "bellek_serbest"); g_ekle(p, "bellek_kopyala");
    g_ekle(p, "metin_uzunluk"); g_ekle(p, "metin_bayt"); g_ekle(p, "metin_esit");
    g_ekle(p, "metin_birlestir"); g_ekle(p, "metin_kes"); g_ekle(p, "metin_kirp");
    g_ekle(p, "metin_icerir"); g_ekle(p, "metin_baslar"); g_ekle(p, "metin_biter");
    g_ekle(p, "metin_kucuk"); g_ekle(p, "metin_buyuk"); g_ekle(p, "metin_kucuk_tr");
    g_ekle(p, "metin_buyuk_tr"); g_ekle(p, "metin_kucuk_ascii"); g_ekle(p, "metin_buyuk_ascii");
    g_ekle(p, "metin_yer_degistir");
    g_ekle(p, "dizi_olustur"); g_ekle(p, "dizi_ekle"); g_ekle(p, "dizi_al");
    g_ekle(p, "dizi_yaz"); g_ekle(p, "dizi_boyut"); g_ekle(p, "dizi_kapasite");
    g_ekle(p, "dizi_kapasite_ayarla");
    g_ekle(p, "arg_sayi"); g_ekle(p, "arg_al");
    g_ekle(p, "dosya_ac"); g_ekle(p, "dosya_kapat"); g_ekle(p, "dosya_oku");
    g_ekle(p, "dosya_yaz"); g_ekle(p, "dosya_boyut"); g_ekle(p, "dosya_var_mi");
    g_ekle(p, "dosya_sil"); g_ekle(p, "dosya_yeniden_adlandir");
    g_ekle(p, "otp_anahtar_uret"); g_ekle(p, "otp_xor_uygula");
    // özel-builtin'ler (CAGRI handler'ında, EKLE_BUILTIN değil)
    g_ekle(p, "tekkez_olustur"); g_ekle(p, "sabitsüre_olustur");
    g_ekle(p, "delege"); g_ekle(p, "geri_al");
    g_ekle(p, "görev_başlat"); g_ekle(p, "görev_birleştir");
    g_ekle(p, "kanal_gönder"); g_ekle(p, "kanal_al"); g_ekle(p, "dur"); g_ekle(p, "dondur");
    g_ekle(p, "yetki_olustur");
    g_ekle(p, "mmio_oku16"); g_ekle(p, "mmio_yaz16"); g_ekle(p, "mmio_oku32");
    g_ekle(p, "mmio_yaz32"); g_ekle(p, "mmio_oku64"); g_ekle(p, "mmio_yaz64");
    g_ekle(p, "vektor_doldur"); g_ekle(p, "vektor_eleman"); g_ekle(p, "vektor_topla");
    g_ekle(p, "vektor_min"); g_ekle(p, "vektor_max"); g_ekle(p, "vektor_esit");
    g_ekle(p, "vektor_kucuk"); g_ekle(p, "vektor_buyuk"); g_ekle(p, "vektor_sec");
    // D-361: C'de VAR ama listede EKSİK olanlar — her biri geçerli programda
    // sahte T002 üretiyordu (kap.kem `bölge_al` ile ölçüldü).
    // D-367: `ifşa` (ş ile!) C built-in'i; listede yoktu → geçerli declassify
    // çağrıları sahte T002 alıyordu. D-361'de ASCII `ifsa` denenmişti, C de onu
    // tanımıyor — doğru yazım ölçülerek bulundu.
    g_ekle(p, "ifşa");
    g_ekle(p, "bölge_al"); g_ekle(p, "kanal_oluştur");
    g_ekle(p, "gönderen"); g_ekle(p, "alan");
    g_ekle(p, "vektor_ve_azalt"); g_ekle(p, "vektor_veya_azalt");
    // keyword-konstrüktörler (tip_belirle özel-case: değer/tamam/hata + hiç + kendin)
    g_ekle(p, "değer"); g_ekle(p, "tamam"); g_ekle(p, "hata"); g_ekle(p, "kendin");
    ver 0;
}
işlev ad_tanimli_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken n: tam32 = dizi_boyut(p.g_isim);
    değişken i: tam32 = 0;
    iken i < n { eğer metin_esit(dizi_al(p.g_isim, i), ad) { ver doğru; } i = i + 1; }
    n = dizi_boyut(p.yerel);
    i = p.yerel_basla;
    iken i < n { eğer metin_esit(dizi_al(p.yerel, i), ad) { ver doğru; } i = i + 1; }
    ver yanlış;
}
// Üst-düzey tanım adları (işlev/yapı/çeşit/sabit) → genel; modül recurse.
işlev genel_topla(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        değişken ad: metin = dizi_al(p.a_ad, c);
        eğer metin_esit(ad, "ISLEV") veya metin_esit(ad, "YAPI")
          veya metin_esit(ad, "CESIT") veya metin_esit(ad, "SABIT")
          veya metin_esit(ad, "KURESEL") {   // D-253: küresel değişken adı da global
            g_ekle(p, dizi_al(p.a_deg, c));
        }
        eğer metin_esit(ad, "ISLEV") { imza_kaydet(p, c); }   // TC3d imza tablosu
        eğer metin_esit(ad, "YAPI") { yapi_kaydet(p, c); }    // TC4 yapı tablosu
        eğer metin_esit(ad, "MODUL") { g_ekle(p, dizi_al(p.a_deg, c)); genel_topla(p, c); }
        eğer metin_esit(ad, "DISA") {       // dışa <tanım> → iç tanım adı
            değişken dcb: tam32 = dizi_al(p.a_cb, c);
            eğer dizi_al(p.a_cs, c) > 0 {
                değişken ic: tam32 = dizi_al(p.cocuk, dcb);
                g_ekle(p, dizi_al(p.a_deg, ic));
                eğer metin_esit(dizi_al(p.a_ad, ic), "ISLEV") { imza_kaydet(p, ic); }
                eğer metin_esit(dizi_al(p.a_ad, ic), "YAPI") { yapi_kaydet(p, ic); }
            }
        }
        i = i + 1;
    }
    ver 0;
}
// Alt-ağaçtaki param/lokal/için/desen-binding adlarını yerel'e topla.
// ---- TC3: tip çıkarsama (string-encoded; "?" = bilinmiyor → T001 atla) ----
işlev tip_str(p: &değişken Ayr, idx: tam32) -> metin {
    eğer metin_esit(dizi_al(p.a_ad, idx), "TIP_BASIT") { ver dizi_al(p.a_deg, idx); }
    ver "?";   // bileşik tip (Dizi/&/seçimlik/...) — ileri TC
}
işlev sayisal_mi(t: metin) -> mantıksal {
    ver metin_esit(t, "tam8") veya metin_esit(t, "tam16") veya metin_esit(t, "tam32")
      veya metin_esit(t, "tam64") veya metin_esit(t, "dtam8") veya metin_esit(t, "dtam16")
      veya metin_esit(t, "dtam32") veya metin_esit(t, "dtam64")
      veya metin_esit(t, "kesirli32") veya metin_esit(t, "kesirli64");
}
işlev kesirli_mi(t: metin) -> mantıksal {
    ver metin_esit(t, "kesirli32") veya metin_esit(t, "kesirli64");
}
// Tamsayı tipi mi? (bit operatörleri tamsayı ister — kesirli/mantıksal HARİÇ.)
işlev tamsayi_mi(t: metin) -> mantıksal {
    ver metin_esit(t, "tam8") veya metin_esit(t, "tam16") veya metin_esit(t, "tam32")
      veya metin_esit(t, "tam64") veya metin_esit(t, "dtam8") veya metin_esit(t, "dtam16")
      veya metin_esit(t, "dtam32") veya metin_esit(t, "dtam64");
}
// Bilinen skaler tip mi? (CAGRI dönüş çıkarsamasında güvenli alt küme — generic
// param/yapı/bileşik dönüşler "?" kalır, böylece T001 false-positive yok.)
işlev bilinen_skaler_mi(t: metin) -> mantıksal {
    ver sayisal_mi(t) veya metin_esit(t, "mantıksal") veya metin_esit(t, "metin")
      veya metin_esit(t, "karakter") veya metin_esit(t, "boş");
}
// Aritmetik ikili op mu? (C kontrol_ikili_sayisal — T003 sol/sag sayısal ister.)
işlev aritmetik_mi(op: metin) -> mantıksal {
    ver metin_esit(op, "+") veya metin_esit(op, "-") veya metin_esit(op, "*")
      veya metin_esit(op, "/") veya metin_esit(op, "%");
}
// Karşılaştırma ikili op mu? (C OP_KUCUK/BUYUK/... — T003 sayısal ister.)
işlev karsilastirma_mi(op: metin) -> mantıksal {
    ver metin_esit(op, "<") veya metin_esit(op, ">")
      veya metin_esit(op, "<=") veya metin_esit(op, ">=");
}
// "Kesinlikle sayısal değil" — bilinen (≠"?") ama sayısal olmayan tip.
işlev bilinen_sayisal_degil(t: metin) -> mantıksal {
    ver (metin_esit(t, "?") == yanlış) ve (sayisal_mi(t) == yanlış);
}
// "Kesinlikle mantıksal değil" — bilinen (≠"?") ama mantıksal olmayan tip.
işlev bilinen_mantiksal_degil(t: metin) -> mantıksal {
    ver (metin_esit(t, "?") == yanlış) ve (metin_esit(t, "mantıksal") == yanlış);
}
// Bit/kaydırma ikili op mu? (& | ^ << >> — C: operandlar tamsayı, aksi T028.)
işlev bit_op_mi(op: metin) -> mantıksal {
    ver metin_esit(op, "&") veya metin_esit(op, "|") veya metin_esit(op, "^")
      veya metin_esit(op, "<<") veya metin_esit(op, ">>");
}
// "Kesinlikle tamsayı değil" — bilinen (≠"?") ama tamsayı olmayan tip.
işlev bilinen_tamsayi_degil(t: metin) -> mantıksal {
    ver (metin_esit(t, "?") == yanlış) ve (tamsayi_mi(t) == yanlış);
}
// Atama hedefi lvalue mi? (C: TANIMLAYICI/ERISIM/INDEKS — aksi T022.)
işlev lvalue_mi(ad: metin) -> mantıksal {
    ver metin_esit(ad, "TANIMLAYICI") veya metin_esit(ad, "ERISIM")
      veya metin_esit(ad, "INDEKS");
}
// Bir işlev düğümünün PARAMETRE çocuk sayısı (arite).
işlev param_say(p: &değişken Ayr, fn: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, fn);
    değişken cs: tam32 = dizi_al(p.a_cs, fn);
    değişken i: tam32 = 0;  değişken n: tam32 = 0;
    iken i < cs {
        eğer metin_esit(dizi_al(p.a_ad, dizi_al(p.cocuk, cb + i)), "PARAMETRE") { n = n + 1; }
        i = i + 1;
    }
    ver n;
}
// Bir PARAMETRE düğümünün tip-string'i (kendin → çocuk yok → "?"; bileşik → "?").
işlev param_tip_str(p: &değişken Ayr, param_idx: tam32) -> metin {
    değişken tc: tam32 = son_cocuk(p, param_idx);
    eğer (tc >= 0) ve metin_baslar(dizi_al(p.a_ad, tc), "TIP_") { ver tip_str(p, tc); }
    ver "?";
}
// İşlev imzasını tabloya kaydet (CAGRI dönüş + T010 + per-arg T001). Dönüş/param
// yalnız bilinen skaler ise saklanır; aksi (yapı/generic/bileşik) "?" → atlanır.
işlev imza_kaydet(p: &değişken Ayr, fn: tam32) -> tam32 {
    dizi_ekle(p.fn_ad, dizi_al(p.a_deg, fn));
    değişken dt: metin = donus_str(p, fn);
    eğer bilinen_skaler_mi(dt) { dizi_ekle(p.fn_donus, dt); }
    değilse { dizi_ekle(p.fn_donus, "?"); }
    dizi_ekle(p.fn_psay, param_say(p, fn));
    dizi_ekle(p.fn_pbase, dizi_boyut(p.fn_ptip));   // param tiplerinin başlangıcı
    değişken cb: tam32 = dizi_al(p.a_cb, fn);
    değişken cs: tam32 = dizi_al(p.a_cs, fn);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "PARAMETRE") {
            değişken pt: metin = param_tip_str(p, c);
            eğer bilinen_skaler_mi(pt) { dizi_ekle(p.fn_ptip, pt); }
            değilse { dizi_ekle(p.fn_ptip, "?"); }
            değişken tc: tam32 = son_cocuk(p, c);   // param tip çocuğu → tekkez mi (TC5b)
            eğer (tc >= 0) ve param_lineer_mi(p, tc) { dizi_ekle(p.fn_plin, 1); }
            değilse { dizi_ekle(p.fn_plin, 0); }
            dizi_ekle(p.fn_pdizi, tip_node_dizi_mi(p, tc));   // D-358 G003
        }
        i = i + 1;
    }
    ver 0;
}
// İşlev adı + param indeksi → param lineer mi (1/0; bulunamazsa 0).
işlev fn_plin_bul(p: &değişken Ayr, ad: metin, j: tam32) -> tam32 {
    değişken n: tam32 = dizi_boyut(p.fn_ad);
    değişken i: tam32 = 0;
    iken i < n {
        eğer metin_esit(dizi_al(p.fn_ad, i), ad) { ver dizi_al(p.fn_plin, dizi_al(p.fn_pbase, i) + j); }
        i = i + 1;
    }
    ver 0;
}
// İşlev adı → dönüş tipi ("?" = kullanıcı işlevi değil veya bilinmeyen dönüş).
işlev fn_donus_bul(p: &değişken Ayr, ad: metin) -> metin {
    değişken n: tam32 = dizi_boyut(p.fn_ad);
    değişken i: tam32 = 0;
    iken i < n { eğer metin_esit(dizi_al(p.fn_ad, i), ad) { ver dizi_al(p.fn_donus, i); } i = i + 1; }
    ver "?";
}
// İşlev adı → parametre sayısı (-1 = kullanıcı işlevi değil).
işlev fn_psay_bul(p: &değişken Ayr, ad: metin) -> tam32 {
    değişken n: tam32 = dizi_boyut(p.fn_ad);
    değişken i: tam32 = 0;
    iken i < n { eğer metin_esit(dizi_al(p.fn_ad, i), ad) { ver dizi_al(p.fn_psay, i); } i = i + 1; }
    ver 0 - 1;
}
// İşlev adı + parametre indeksi → param tip-string'i ("?" = bilinmeyen/bileşik).
işlev fn_ptip_bul(p: &değişken Ayr, ad: metin, j: tam32) -> metin {
    değişken n: tam32 = dizi_boyut(p.fn_ad);
    değişken i: tam32 = 0;
    iken i < n {
        eğer metin_esit(dizi_al(p.fn_ad, i), ad) {
            ver dizi_al(p.fn_ptip, dizi_al(p.fn_pbase, i) + j);
        }
        i = i + 1;
    }
    ver "?";
}
// ---- TC4: yapı tablosu kayıt + sorgu ----
// Bir YAPI düğümünün alanlarını (ad + tip) tabloya kaydet.
işlev yapi_kaydet(p: &değişken Ayr, yapi: tam32) -> tam32 {
    dizi_ekle(p.yapi_ad, dizi_al(p.a_deg, yapi));
    dizi_ekle(p.yapi_abase, dizi_boyut(p.alan_ad));
    değişken cb: tam32 = dizi_al(p.a_cb, yapi);
    değişken cs: tam32 = dizi_al(p.a_cs, yapi);
    değişken i: tam32 = 0;  değişken n: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "ALAN") {
            dizi_ekle(p.alan_ad, dizi_al(p.a_deg, c));
            değişken tc: tam32 = son_cocuk(p, c);
            değişken ft: metin = "?";
            eğer (tc >= 0) ve metin_baslar(dizi_al(p.a_ad, tc), "TIP_") { ft = tip_str(p, tc); }
            eğer bilinen_skaler_mi(ft) { dizi_ekle(p.alan_tip, ft); }
            değilse { dizi_ekle(p.alan_tip, "?"); }
            n = n + 1;
        }
        i = i + 1;
    }
    dizi_ekle(p.yapi_acount, n);
    ver 0;
}
işlev yapi_idx_bul(p: &değişken Ayr, ad: metin) -> tam32 {
    değişken n: tam32 = dizi_boyut(p.yapi_ad);
    değişken i: tam32 = 0;
    iken i < n { eğer metin_esit(dizi_al(p.yapi_ad, i), ad) { ver i; } i = i + 1; }
    ver 0 - 1;
}
işlev yapi_var_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    ver yapi_idx_bul(p, ad) >= 0;
}
işlev alan_var_mi(p: &değişken Ayr, yad: metin, fad: metin) -> mantıksal {
    değişken yi: tam32 = yapi_idx_bul(p, yad);
    eğer yi < 0 { ver yanlış; }
    değişken base: tam32 = dizi_al(p.yapi_abase, yi);
    değişken cnt: tam32 = dizi_al(p.yapi_acount, yi);
    değişken j: tam32 = 0;
    iken j < cnt { eğer metin_esit(dizi_al(p.alan_ad, base + j), fad) { ver doğru; } j = j + 1; }
    ver yanlış;
}
işlev alan_tip_bul(p: &değişken Ayr, yad: metin, fad: metin) -> metin {
    değişken yi: tam32 = yapi_idx_bul(p, yad);
    eğer yi < 0 { ver "?"; }
    değişken base: tam32 = dizi_al(p.yapi_abase, yi);
    değişken cnt: tam32 = dizi_al(p.yapi_acount, yi);
    değişken j: tam32 = 0;
    iken j < cnt {
        eğer metin_esit(dizi_al(p.alan_ad, base + j), fad) { ver dizi_al(p.alan_tip, base + j); }
        j = j + 1;
    }
    ver "?";
}
// Bir ismin tipi (aktif işlev yerel dilimi). "?" = bilinmiyor/belirsiz.
// GÜVENLİ: aynı ad birden fazla FARKLI tiple bağlanmışsa (ayrı blok kapsamları —
// düz yerel listesinde kapsam yok) → "?" (belirsiz). Tek tip → o tip. (False
// T020/T001 önler: parse_birincil'de iki `ic` (metin + tam32) gibi durumlar.)
işlev var_tip(p: &değişken Ayr, ad: metin) -> metin {
    değişken n: tam32 = dizi_boyut(p.yerel);
    değişken i: tam32 = p.yerel_basla;
    değişken bulunan: metin = "?";
    değişken sayi: tam32 = 0;
    iken i < n {
        eğer metin_esit(dizi_al(p.yerel, i), ad) {
            değişken t: metin = dizi_al(p.yerel_tip, i);
            eğer sayi == 0 { bulunan = t; }
            değilse { eğer metin_esit(bulunan, t) == yanlış { ver "?"; } }
            sayi = sayi + 1;
        }
        i = i + 1;
    }
    ver bulunan;
}
// İfade tipi (beklenen ile bidirectional). Bilinmeyen → "?". (TC3a: literal+ident.)
işlev ifade_tip(p: &değişken Ayr, idx: tam32, beklenen: metin) -> metin {
    değişken ad: metin = dizi_al(p.a_ad, idx);
    eğer metin_esit(ad, "TAM") {
        // D-354: C `tip_tamsayi_mi(beklenen)` — tamsayı literali YALNIZ tamsayı
        // bağlamına uyarlanır. `sayisal_mi` demek `değişken x: kesirli64 = 1`i
        // sessizce kabul ettiriyordu (C: T001) ve dizi elemanında konum kaydırıyordu.
        eğer tamsayi_mi(beklenen) { ver beklenen; }   // bidirectional sayı literal
        ver "tam32";
    }
    eğer metin_esit(ad, "KESIRLI") {
        eğer kesirli_mi(beklenen) { ver beklenen; }
        ver "kesirli64";
    }
    eğer metin_esit(ad, "METIN") { ver "metin"; }
    eğer metin_esit(ad, "KARAKTER") { ver "karakter"; }
    eğer metin_esit(ad, "MANTIKSAL") { ver "mantıksal"; }
    eğer metin_esit(ad, "BOS") { ver "boş"; }
    eğer metin_esit(ad, "TANIMLAYICI") { ver var_tip(p, dizi_al(p.a_deg, idx)); }
    eğer metin_esit(ad, "IKILI") {
        değişken op: metin = dizi_al(p.a_deg, idx);
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        değişken sol: tam32 = dizi_al(p.cocuk, cb);
        değişken sag: tam32 = dizi_al(p.cocuk, cb + 1);
        eğer aritmetik_mi(op) {   // sayısal → operand tipi; sayısal değilse "?" (C: TIP_HATA)
            değişken st: metin = ifade_tip(p, sol, beklenen);
            değişken gt: metin = ifade_tip(p, sag, beklenen);
            eğer bilinen_sayisal_degil(st) veya bilinen_sayisal_degil(gt) { ver "?"; }
            ver st;
        }
        eğer karsilastirma_mi(op) {   // sayısal operand → mantıksal; değilse "?" (C: TIP_HATA)
            değişken st: metin = ifade_tip(p, sol, "?");
            değişken gt: metin = ifade_tip(p, sag, "?");
            eğer bilinen_sayisal_degil(st) veya bilinen_sayisal_degil(gt) { ver "?"; }
            ver "mantıksal";
        }
        eğer metin_esit(op, "ve") veya metin_esit(op, "veya") {   // mantıksal değilse "?" (C: TIP_HATA)
            değişken st: metin = ifade_tip(p, sol, "mantıksal");
            değişken gt: metin = ifade_tip(p, sag, "mantıksal");
            eğer bilinen_mantiksal_degil(st) veya bilinen_mantiksal_degil(gt) { ver "?"; }
            ver "mantıksal";
        }
        eğer metin_esit(op, "==") veya metin_esit(op, "!=") { ver "mantıksal"; }
        eğer bit_op_mi(op) {   // tamsayı operand → sol tipi; tamsayı değilse "?" (C: TIP_HATA)
            değişken st: metin = ifade_tip(p, sol, beklenen);
            değişken gt: metin = ifade_tip(p, sag, "?");
            eğer bilinen_tamsayi_degil(st) veya bilinen_tamsayi_degil(gt) { ver "?"; }
            ver st;
        }
        ver ifade_tip(p, sol, beklenen);  // bilinmeyen op → sol tipi
    }
    eğer metin_esit(ad, "TEKLI") {
        değişken op: metin = dizi_al(p.a_deg, idx);
        değişken operand: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
        eğer metin_esit(op, "degil") {   // mantıksal değilse "?" (C: TIP_HATA)
            değişken t: metin = ifade_tip(p, operand, "mantıksal");
            eğer bilinen_mantiksal_degil(t) { ver "?"; }
            ver "mantıksal";
        }
        eğer metin_esit(op, "neg") {   // sayısal değilse "?" (C: TIP_HATA)
            değişken t: metin = ifade_tip(p, operand, beklenen);
            eğer bilinen_sayisal_degil(t) { ver "?"; }
            ver t;
        }
        eğer metin_esit(op, "~") {   // bit değil: tamsayı → operand tipi; aksi "?" (T028)
            değişken t: metin = ifade_tip(p, operand, beklenen);
            eğer bilinen_tamsayi_degil(t) { ver "?"; }
            ver t;
        }
        ver "?";   // & (ref) / deref* → ileri TC
    }
    eğer metin_esit(ad, "CAGRI") {   // TC3d: kullanıcı işlevi çağrısı → dönüş tipi
        değişken h: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));   // çocuk[0]=hedef
        eğer metin_esit(dizi_al(p.a_ad, h), "TANIMLAYICI") {
            ver fn_donus_bul(p, dizi_al(p.a_deg, h));   // "?" = kullanıcı işlevi değil
        }
        ver "?";   // method/dolaylı çağrı → ileri TC
    }
    eğer metin_esit(ad, "YAPI_OLUSTUR") {   // TC4: yapı oluştur → yapı adı (tip)
        değişken tad: metin = dizi_al(p.a_deg, idx);
        eğer yapi_var_mi(p, tad) { ver tad; }
        ver "?";
    }
    eğer metin_esit(ad, "ERISIM") {   // TC4: nesne.alan → alan tipi (skaler; aksi "?")
        değişken nesne: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
        değişken nt: metin = ifade_tip(p, nesne, "?");   // referans → "?" → atla
        ver alan_tip_bul(p, nt, dizi_al(p.a_deg, idx));
    }
    ver "?";   // INDEKS/YOL/... → ileri TC
}
// DEGISKEN/SABIT annotation tip-string ("?"=yok/bileşik).
işlev annot_str(p: &değişken Ayr, idx: tam32) -> metin {
    eğer dizi_al(p.a_cs, idx) >= 2 {
        değişken c0: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
        eğer metin_baslar(dizi_al(p.a_ad, c0), "TIP_") { ver tip_str(p, c0); }
    }
    ver "?";
}
işlev son_cocuk(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken cs: tam32 = dizi_al(p.a_cs, idx);
    eğer cs == 0 { ver 0 - 1; }
    ver dizi_al(p.cocuk, dizi_al(p.a_cb, idx) + cs - 1);
}
// T001: annotation vs değer tipi (DEGISKEN/SABIT). Güvenli — yalnız emin olunca.
işlev t001_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken annot: metin = annot_str(p, idx);
    eğer metin_esit(annot, "?") { ver 0; }
    // D-370: annotasyon BİLİNMEYEN bir tipse C tipi HATA'ya düşürür ve T001'e
    // hiç gelmez (yalnız T011 çıkar). Aksi hâlde tek kusur iki tanı üretirdi.
    eğer tip_adi_bilinir_mi(p, annot) == yanlış { ver 0; }
    değişken vc: tam32 = son_cocuk(p, idx);
    eğer vc < 0 { ver 0; }
    değişken vt: metin = ifade_tip(p, vc, annot);
    eğer (metin_esit(vt, "?") == yanlış) ve (metin_esit(annot, vt) == yanlış) {
        dizi_ekle(p.th_kod, "T001");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
    }
    ver 0;
}
// İşlev dönüş tipi (çocuklardaki TIP_* düğümü; yoksa "boş").
işlev donus_str(p: &değişken Ayr, fn: tam32) -> metin {
    değişken cb: tam32 = dizi_al(p.a_cb, fn);
    değişken cs: tam32 = dizi_al(p.a_cs, fn);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_baslar(dizi_al(p.a_ad, c), "TIP_") { ver tip_str(p, c); }
        i = i + 1;
    }
    ver "boş";
}
// T020: ver değeri işlev dönüş tipiyle uyumsuz (ver_idx konumu). "?"→atla.
işlev t020_kontrol(p: &değişken Ayr, ver_idx: tam32) -> tam32 {
    eğer metin_esit(p.aktif_donus, "?") { ver 0; }
    eğer dizi_al(p.a_cs, ver_idx) == 0 {           // ver;  → dönüş boş olmalı
        eğer metin_esit(p.aktif_donus, "boş") == yanlış {
            dizi_ekle(p.th_kod, "T020");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, ver_idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, ver_idx));
        }
        ver 0;
    }
    değişken vc: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, ver_idx));
    değişken vt: metin = ifade_tip(p, vc, p.aktif_donus);
    eğer (metin_esit(vt, "?") == yanlış) ve (metin_esit(vt, p.aktif_donus) == yanlış) {
        dizi_ekle(p.th_kod, "T020");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, ver_idx));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, ver_idx));
    }
    ver 0;
}
// T021: eğer/iken koşulu mantıksal olmalı. eger_idx konumunda. ("?"→atla)
işlev t021_kontrol(p: &değişken Ayr, eger_idx: tam32, kosul_idx: tam32) -> tam32 {
    // D-367: `sabitsüre<T>` koşulu mantıksal DEĞİLDİR → T021 (C aynı sırada
    // T021'i CT001'den ÖNCE verir). Bağlamanın tipi `yerel_tip`'te "?" olduğu
    // için normal yol bunu göremiyordu.
    eğer sabitsure_ifade_mi(p, kosul_idx) { ver sekil_hata(p, eger_idx, "T021"); }
    değişken kt: metin = ifade_tip(p, kosul_idx, "mantıksal");
    eğer (metin_esit(kt, "?") == yanlış) ve (metin_esit(kt, "mantıksal") == yanlış) {
        dizi_ekle(p.th_kod, "T021");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, eger_idx));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, eger_idx));
    }
    ver 0;
}
// T003: aritmetik/karşılaştırma ikili operandı sayısal değil (IKILI düğümünde).
// C: operand TIP_HATA ise erken dönüş → T003 yok → "?" operand atla (false-pos yok).
// D-367 CT004/CT008: sabitsüre operand üzerinde `/`,`%` (variable-time div) ve
// sabitsüre KAYDIRMA MİKTARI (barrel-shifter zamanlaması) yasak.
işlev ct_ikili_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken op: metin = dizi_al(p.a_deg, idx);
    eğer dizi_al(p.a_cs, idx) < 2 { ver 0; }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken sol: tam32 = dizi_al(p.cocuk, cb);
    değişken sag: tam32 = dizi_al(p.cocuk, cb + 1);
    eğer metin_esit(op, "/") veya metin_esit(op, "%") {
        eğer sabitsure_ifade_mi(p, sol) veya sabitsure_ifade_mi(p, sag) {
            ver sekil_hata(p, idx, "CT004");
        }
    }
    eğer metin_esit(op, "<<") veya metin_esit(op, ">>") {
        eğer sabitsure_ifade_mi(p, sag) { ver sekil_hata(p, idx, "CT008"); }
    }
    ver 0;
}
işlev t003_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken op: metin = dizi_al(p.a_deg, idx);
    eğer (aritmetik_mi(op) veya karsilastirma_mi(op)) == yanlış { ver 0; }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken st: metin = ifade_tip(p, dizi_al(p.cocuk, cb), "?");
    değişken gt: metin = ifade_tip(p, dizi_al(p.cocuk, cb + 1), "?");
    eğer bilinen_sayisal_degil(st) veya bilinen_sayisal_degil(gt) {
        dizi_ekle(p.th_kod, "T003");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
    }
    ver 0;
}
// T004: ikili ve/veya operandı mantıksal olmalı (IKILI düğümünde). "?"→atla.
işlev t004_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken op: metin = dizi_al(p.a_deg, idx);
    eğer (metin_esit(op, "ve") veya metin_esit(op, "veya")) == yanlış { ver 0; }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken st: metin = ifade_tip(p, dizi_al(p.cocuk, cb), "mantıksal");
    değişken gt: metin = ifade_tip(p, dizi_al(p.cocuk, cb + 1), "mantıksal");
    eğer bilinen_mantiksal_degil(st) veya bilinen_mantiksal_degil(gt) {
        dizi_ekle(p.th_kod, "T004");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
    }
    ver 0;
}
// T028: bit/kaydırma ikili operandı tamsayı olmalı (IKILI düğümünde). "?"→atla.
işlev t028_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken op: metin = dizi_al(p.a_deg, idx);
    eğer bit_op_mi(op) == yanlış { ver 0; }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken st: metin = ifade_tip(p, dizi_al(p.cocuk, cb), "?");
    değişken gt: metin = ifade_tip(p, dizi_al(p.cocuk, cb + 1), "?");
    eğer bilinen_tamsayi_degil(st) veya bilinen_tamsayi_degil(gt) {
        dizi_ekle(p.th_kod, "T028");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
    }
    ver 0;
}
// Tekli operatör kontrolü: neg → T003 (sayısal), degil → T004 (mantıksal),
// ~ (bit değil) → T028 (tamsayı); & / deref* → ileri TC. "?"→atla.
işlev tekli_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken op: metin = dizi_al(p.a_deg, idx);
    değişken operand: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
    eğer metin_esit(op, "neg") {
        değişken t: metin = ifade_tip(p, operand, "?");
        eğer bilinen_sayisal_degil(t) {
            dizi_ekle(p.th_kod, "T003");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
        }
        ver 0;
    }
    eğer metin_esit(op, "~") {
        değişken tt: metin = ifade_tip(p, operand, "?");
        eğer bilinen_tamsayi_degil(tt) {
            dizi_ekle(p.th_kod, "T028");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
        }
        ver 0;
    }
    eğer metin_esit(op, "degil") {
        değişken t: metin = ifade_tip(p, operand, "mantıksal");
        eğer bilinen_mantiksal_degil(t) {
            dizi_ekle(p.th_kod, "T004");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
        }
    }
    // D-351 G001: `*p` ham işaretçi dereferansı yalnız güvensiz blokta.
    // Güvenli referans deref (`*v`, &T) SERBEST (D-305) — ptr_ifade_mi yalnız *T'ye doğru.
    eğer metin_esit(op, "deref*") {
        eğer ptr_ifade_mi(p, operand) ve (p.guv_bag == 0) { g001_hata(p, idx); }
        ver 0;
    }
    // TC5b L004: lineer bağlama referansı alınamaz (& / &değişken).
    eğer metin_esit(op, "&") veya metin_esit(op, "&degisken") {
        eğer metin_esit(dizi_al(p.a_ad, operand), "TANIMLAYICI")
          ve (lin_idx(p, dizi_al(p.a_deg, operand)) >= 0) {
            // D-365: yetki bağlamasına referans → CP005 (aksi L004).
            dizi_ekle(p.th_kod, lin_kod(p, lin_idx(p, dizi_al(p.a_deg, operand)), "L004"));
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
        }
    }
    ver 0;
}
// ---- Madde E: explicit tip dönüştürme (`x olarak T`) — E001/E002/E003/E004 ----
// C src/tip_kontrol.c DUGUM_TIP_DONUSTUR kolunun aynası (kural sırası birebir).
// Sınıf dizgisi: skaler tip adı | "*" (ham işaretçi) | "&" (referans) | "tekkez" | "?".
// "?" = emin değil → kontrol ATLANIR (C emin olduğu yerde hata verir; yanlış-pozitif yok).
işlev cast_hedef_sinif(p: &değişken Ayr, tn: tam32) -> metin {
    değişken a: metin = dizi_al(p.a_ad, tn);
    eğer metin_esit(a, "TIP_POINTER") { ver "*"; }
    eğer metin_esit(a, "TIP_TEKKEZ") { ver "tekkez"; }
    eğer metin_esit(a, "TIP_REFERANS") { ver "&"; }
    eğer metin_esit(a, "TIP_BASIT") {
        değişken ad: metin = dizi_al(p.a_deg, tn);
        eğer bilinen_skaler_mi(ad) { ver ad; }   // kullanıcı tipi → "?" (C'de T011 riski)
    }
    ver "?";
}
işlev cast_kaynak_sinif(p: &değişken Ayr, src: tam32) -> metin {
    değişken a: metin = dizi_al(p.a_ad, src);
    eğer metin_esit(a, "TEKLI") {
        değişken op: metin = dizi_al(p.a_deg, src);
        eğer metin_esit(op, "&") veya metin_esit(op, "&degisken") { ver "&"; }
    }
    eğer metin_esit(a, "TANIMLAYICI") {
        eğer lin_idx(p, dizi_al(p.a_deg, src)) >= 0 { ver "tekkez"; }
    }
    değişken t: metin = ifade_tip(p, src, "?");
    eğer bilinen_skaler_mi(t) { ver t; }
    ver "?";
}
// C kw_kaynak/kw_hedef aynası: tamsayı bit genişliği; kesirli32=320, kesirli64=640.
işlev cast_genislik(t: metin) -> tam32 {
    eğer metin_esit(t, "tam8") veya metin_esit(t, "dtam8") { ver 8; }
    eğer metin_esit(t, "tam16") veya metin_esit(t, "dtam16") { ver 16; }
    eğer metin_esit(t, "tam32") veya metin_esit(t, "dtam32") { ver 32; }
    eğer metin_esit(t, "tam64") veya metin_esit(t, "dtam64") { ver 64; }
    eğer metin_esit(t, "kesirli32") { ver 320; }
    eğer metin_esit(t, "kesirli64") { ver 640; }
    eğer metin_esit(t, "karakter") { ver 32; }
    ver 0;
}
işlev cast_hata(p: &değişken Ayr, idx: tam32, kod: metin) -> tam32 {
    dizi_ekle(p.th_kod, kod);
    dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
    dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
    ver 0;
}
işlev cast_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    eğer dizi_al(p.a_cs, idx) < 2 { ver 0; }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken ks: metin = cast_kaynak_sinif(p, dizi_al(p.cocuk, cb));
    değişken hs: metin = cast_hedef_sinif(p, dizi_al(p.cocuk, cb + 1));
    eğer metin_esit(hs, "tekkez") { ver cast_hata(p, idx, "E001"); }   // hedef tekkez
    eğer metin_esit(ks, "tekkez") { ver cast_hata(p, idx, "E003"); }   // kaynak tekkez
    eğer metin_esit(hs, "?") veya metin_esit(ks, "?") { ver 0; }       // emin değil → atla
    eğer metin_esit(ks, "*") ve metin_esit(hs, "metin") { ver 0; }     // tipli ptr → opak
    eğer p.guv_bag > 0 {
        eğer tamsayi_mi(ks) ve metin_esit(hs, "*") { ver 0; }          // inttoptr
        eğer metin_esit(ks, "*") ve tamsayi_mi(hs) { ver 0; }          // ptrtoint
        eğer metin_esit(ks, "&") ve metin_esit(hs, "*") { ver 0; }     // D-349: &T -> *U (IR'da no-op)
    }
    eğer (sayisal_mi(ks) ve sayisal_mi(hs)) == yanlış {
        değişken c2i: mantıksal = metin_esit(ks, "karakter") ve tamsayi_mi(hs);
        değişken i2c: mantıksal = tamsayi_mi(ks) ve metin_esit(hs, "karakter");
        eğer (c2i veya i2c) == yanlış { ver cast_hata(p, idx, "E002"); }
    }
    değişken kw: tam32 = cast_genislik(ks);
    değişken hw: tam32 = cast_genislik(hs);
    eğer (kw > 0 ve kw <= 64) ve (hw > 0 ve hw <= 64) {
        eğer kw >= 64 ve hw < 32 { ver cast_hata(p, idx, "E004"); }    // tam64 → tam8/tam16
    }
    eğer (kw >= 320 ve hw >= 320) ve kw > hw { ver cast_hata(p, idx, "E004"); }  // kesirli64 → kesirli32
    ver 0;
}
// ---- D-351: G001 (ham işaretçi) + E010 (küresel erişim) — güvensiz-tier kapıları ----
// C: `*T` dereferansı/indekslemesi ve `küresel` değişken erişimi YALNIZ `güvensiz`
// blokta (D-252/D-257: `çıplak` gövde örtük güvensiz). İkisi de bellek-güvenliği
// kapısıdır — self-host'ta yoklukları "güvensiz program işaretsiz geçer" demekti.
işlev tip_node_ptr_mi(p: &değişken Ayr, tn: tam32) -> tam32 {
    eğer tn < 0 { ver 0; }
    eğer metin_esit(dizi_al(p.a_ad, tn), "TIP_POINTER") { ver 1; }
    ver 0;
}
işlev tip_node_sabitsure_mi(p: &değişken Ayr, tn: tam32) -> tam32 {   // D-367
    eğer tn < 0 { ver 0; }
    eğer metin_esit(dizi_al(p.a_ad, tn), "TIP_SABITSURE") { ver 1; }
    ver 0;
}
işlev tip_node_dizi_mi(p: &değişken Ayr, tn: tam32) -> tam32 {   // D-353
    eğer tn < 0 { ver 0; }
    eğer metin_esit(dizi_al(p.a_ad, tn), "TIP_DIZI") { ver 1; }
    ver 0;
}
// DEGISKEN/SABIT annotation tip düğümü (yoksa -1). annot_str ile aynı koşul.
işlev annot_node(p: &değişken Ayr, idx: tam32) -> tam32 {
    eğer dizi_al(p.a_cs, idx) >= 2 {
        değişken c0: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
        eğer metin_baslar(dizi_al(p.a_ad, c0), "TIP_") { ver c0; }
    }
    ver 0 - 1;
}
// Bağlama ham işaretçi mi? (yerel_ptr, yerel ile paralel; sondan ilk eşleşme.)
işlev bag_ptr_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = dizi_boyut(p.yerel) - 1;
    iken i >= p.yerel_basla {
        eğer metin_esit(dizi_al(p.yerel, i), ad) { ver dizi_al(p.yerel_ptr, i) == 1; }
        i = i - 1;
    }
    ver yanlış;
}
// İfade KESİNLİKLE ham işaretçi mi? Emin değilsek yanlış (yanlış-pozitif yok).
işlev ptr_ifade_mi(p: &değişken Ayr, idx: tam32) -> mantıksal {
    değişken a: metin = dizi_al(p.a_ad, idx);
    eğer metin_esit(a, "TANIMLAYICI") { ver bag_ptr_mi(p, dizi_al(p.a_deg, idx)); }
    // (e olarak *T) → ham işaretçi, AMA yalnız `güvensiz` içinde: dışarıda bu cast'in
    // KENDİSİ E002'dir ve C tipi HATA'ya düşürüp deref'ten erken döner (G001 vermez).
    // Koşulsuz saymak `*(4096 olarak *tam32)`da E002+G001 üretiyordu (ölçüldü).
    eğer metin_esit(a, "TIP_DONUSTUR") ve (p.guv_bag > 0) {
        eğer dizi_al(p.a_cs, idx) >= 2 {
            ver tip_node_ptr_mi(p, dizi_al(p.cocuk, dizi_al(p.a_cb, idx) + 1)) == 1;
        }
    }
    ver yanlış;
}
// Bir ad küresel değişken mi? (kur_ad listesi — E010.)
işlev kuresel_ad_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.kur_ad) {
        eğer metin_esit(dizi_al(p.kur_ad, i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// Aktif işlevin yerel diliminde bu ad var mı? (gölgeleme: yerel küreseli örter.)
işlev yerel_var_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = p.yerel_basla;
    iken i < dizi_boyut(p.yerel) {
        eğer metin_esit(dizi_al(p.yerel, i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// Üst düzeyden (modül/dışa dâhil) küresel değişken ADLARINI topla (E010 için).
işlev kur_ad_topla(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        değişken ad: metin = dizi_al(p.a_ad, c);
        eğer metin_esit(ad, "KURESEL") { dizi_ekle(p.kur_ad, dizi_al(p.a_deg, c)); }
        eğer metin_esit(ad, "MODUL") veya metin_esit(ad, "DISA") { kur_ad_topla(p, c); }
        i = i + 1;
    }
    ver 0;
}
// İşlev düğümü `çıplak` mı? (parser yan-kanalı cip_node — dump'a yansımaz.)
işlev ciplak_govde_mi(p: &değişken Ayr, fn: tam32) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.cip_node) {
        eğer dizi_al(p.cip_node, i) == fn { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// D-360 (C D-257 çıplak-call-rule): çağrılan işlev ADIYLA çıplak mı?
// Çıplak işlev ρ-suz C-ABI'dir; normal (ρ-alan) bir işlevi çağırırsa codegen
// `ptr null` geçirir → callee null-bölgeye tahsis eder → segfault. Statik red.
işlev fn_ciplak_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.cip_node) {
        eğer metin_esit(dizi_al(p.a_deg, dizi_al(p.cip_node, i)), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// G001: ham işaretçi dereferansı / indekslemesi güvensiz blok ister.
işlev g001_hata(p: &değişken Ayr, idx: tam32) -> tam32 {
    dizi_ekle(p.th_kod, "G001");
    dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
    dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
    ver 0;
}
// INDEKS denetimi — C DUGUM_INDEKS sırası birebir:
//   taban ham işaretçi → indeks tamsayı değilse T005, değilse güvensiz dışında G001
//   taban Dizi<T> DEĞİL (bilinen skaler) → T008
//   taban Dizi<T> → indeks tamsayı değilse T005
// Taban şekli bilinmiyorsa hiçbir şey söylenmez.
işlev indeks_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    eğer dizi_al(p.a_cs, idx) < 2 { ver 0; }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken taban: tam32 = dizi_al(p.cocuk, cb);
    değişken it: metin = ifade_tip(p, dizi_al(p.cocuk, cb + 1), "?");
    // D-367 CT002: sabitsüre indeks = cache-timing yan kanalı (`ifşa` gerekir).
    eğer sabitsure_ifade_mi(p, dizi_al(p.cocuk, cb + 1)) {
        ver sekil_hata(p, idx, "CT002");
    }
    eğer ptr_ifade_mi(p, taban) {
        eğer bilinen_tamsayi_degil(it) { ver sekil_hata(p, idx, "T005"); }   // D-353
        eğer p.guv_bag == 0 { ver g001_hata(p, idx); }
        ver 0;
    }
    eğer bilinen_skaler_mi(ifade_tip(p, taban, "?")) { ver sekil_hata(p, idx, "T008"); }
    eğer dizi_ifade_mi(p, taban) ve bilinen_tamsayi_degil(it) {
        ver sekil_hata(p, idx, "T005");
    }
    ver 0;
}
// ---- D-353: "yanlış şekil" tanıları — T005/T006/T007/T008/T027 ----
// Ortak kalıp: ifadenin tipi BİLİNEN bir skaler, ama bağlam yapı / dizi / işlev
// şekli istiyor. "?" (emin değil) → kontrol ATLANIR (yanlış-pozitif yok).
işlev sekil_hata(p: &değişken Ayr, idx: tam32, kod: metin) -> tam32 {
    dizi_ekle(p.th_kod, kod);
    dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
    dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
    ver 0;
}
// Bağlama KESİN olarak Dizi<T> mi? (yerel_dizi, yerel ile paralel.)
işlev bag_dizi_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = dizi_boyut(p.yerel) - 1;
    iken i >= p.yerel_basla {
        eğer metin_esit(dizi_al(p.yerel, i), ad) { ver dizi_al(p.yerel_dizi, i) == 1; }
        i = i - 1;
    }
    ver yanlış;
}
işlev dizi_ifade_mi(p: &değişken Ayr, idx: tam32) -> mantıksal {
    eğer metin_esit(dizi_al(p.a_ad, idx), "DIZI_OLUSTUR") { ver doğru; }
    eğer metin_esit(dizi_al(p.a_ad, idx), "TANIMLAYICI") {
        ver bag_dizi_mi(p, dizi_al(p.a_deg, idx));
    }
    ver yanlış;
}
// ---- D-370: T011 — bilinmeyen tip ----
// Tip-adı EVRENİ: yerleşik skalerler + `yapı` + `çeşit` + generic param adları
// + küresel ad tablosu (çapraz-dosya `dışa` ithalatları oradan gelir).
// `özellik` adı EVRENDE DEĞİL — ölçüldü: `işlev f(x: Say)` C'de T011 verir
// (özellik bound'dur, tip değil). Bound konumundaki adlar zaten orphan
// düğümlerdedir (kökten erişilmez) → bu denetime hiç uğramazlar.
// Emin olamadığımız her şeyde SUSULUR: yalnız TIP_BASIT denetlenir.
işlev generic_param_adi_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.gp_ad) {
        eğer metin_esit(dizi_al(p.gp_ad, i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// Yetenek KAYNAK tipleri (`yetki<R>` içinde R): C'de yerleşik nominal tipler.
işlev yetki_kaynak_tipi_mi(ad: metin) -> mantıksal {
    ver metin_esit(ad, "MMIO") veya metin_esit(ad, "Dosya") veya metin_esit(ad, "Soket")
      veya metin_esit(ad, "Bellek") veya metin_esit(ad, "Donanim")
      veya metin_esit(ad, "OTP_Anahtar");
}
işlev tip_adi_bilinir_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    eğer bilinen_skaler_mi(ad) { ver doğru; }
    eğer yetki_kaynak_tipi_mi(ad) { ver doğru; }   // D-370
    eğer yapi_var_mi(p, ad) { ver doğru; }
    eğer cesit_var_mi(p, ad) { ver doğru; }
    eğer generic_param_adi_mi(p, ad) { ver doğru; }
    // Küresel ad tablosu: çapraz-dosya `dışa` yapı/çeşit adları burada.
    // (İşlev/sabit adlarını da içerir → aynı adlı bir tip için tanı KAÇAR;
    // eksik tanı kabul, yanlış tanı DEĞİL.)
    ver ad_tanimli_mi(p, ad);
}
işlev t011_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    eğer metin_esit(dizi_al(p.a_ad, idx), "TIP_BASIT") == yanlış { ver 0; }
    eğer tip_adi_bilinir_mi(p, dizi_al(p.a_deg, idx)) == yanlış {
        sekil_hata(p, idx, "T011");
    }
    ver 0;
}
// ---- D-369: T030 + T031 — generic bound denetimi ----
// `yapı Vektor<T: Say>` yazıldıysa `Vektor<Tam>` ancak `uygula Say için Tam`
// varsa geçerlidir (T030). Bound olarak verilen ad hiç özellik değilse T031.
// Konum: TIP_KULLANICI düğümü (C tip_d ile aynı).
// Bound tablosu parser yan-kanalından (gp_*), özellik/uygula kayıtları AST'den.
işlev ozellik_var_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.oz_ad) {
        eğer metin_esit(dizi_al(p.oz_ad, i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
işlev uygula_var_mi(p: &değişken Ayr, tip: metin, oz: metin) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.uyg_tip) {
        eğer metin_esit(dizi_al(p.uyg_tip, i), tip)
          ve metin_esit(dizi_al(p.uyg_oz, i), oz) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// Üst düzeyden `özellik` adlarını ve `uygula X için T` çiftlerini topla.
işlev ozellik_uygula_topla(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        değişken ad: metin = dizi_al(p.a_ad, c);
        eğer metin_esit(ad, "OZELLIK") { dizi_ekle(p.oz_ad, dizi_al(p.a_deg, c)); }
        // UYGULA: çocuk[0]=hedef tip, çocuk[1]=özellik (trait impl); tek çocuk
        // inherent impl demektir (özellik yok) → kayıt dışı.
        eğer metin_esit(ad, "UYGULA") ve (dizi_al(p.a_cs, c) >= 2) {
            değişken ub: tam32 = dizi_al(p.a_cb, c);
            değişken ht: tam32 = dizi_al(p.cocuk, ub);
            değişken oz: tam32 = dizi_al(p.cocuk, ub + 1);
            eğer metin_esit(dizi_al(p.a_ad, ht), "TIP_BASIT")
              ve metin_esit(dizi_al(p.a_ad, oz), "TIP_BASIT") {
                dizi_ekle(p.uyg_tip, dizi_al(p.a_deg, ht));
                dizi_ekle(p.uyg_oz, dizi_al(p.a_deg, oz));
            }
        }
        eğer metin_esit(ad, "MODUL") veya metin_esit(ad, "DISA") {
            ozellik_uygula_topla(p, c);
        }
        i = i + 1;
    }
    ver 0;
}
// `Vektor<Tam>` — TIP_KULLANICI: çocuk[0] = ad (TANIMLAYICI), çocuk[1..] = argümanlar.
işlev t030_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    eğer metin_esit(dizi_al(p.a_ad, idx), "TIP_KULLANICI") == yanlış { ver 0; }
    değişken cs: tam32 = dizi_al(p.a_cs, idx);
    eğer cs < 2 { ver 0; }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken h: tam32 = dizi_al(p.cocuk, cb);
    eğer metin_esit(dizi_al(p.a_ad, h), "TANIMLAYICI") == yanlış { ver 0; }
    değişken tad: metin = dizi_al(p.a_deg, h);
    değişken ai: tam32 = 0;
    iken ai < (cs - 1) {
        değişken arg: tam32 = dizi_al(p.cocuk, cb + 1 + ai);
        // Argüman tipi yalnız TIP_BASIT ise adı bilinir; aksi (iç içe generic,
        // Dizi, referans...) → emin değiliz, susuyoruz.
        eğer metin_esit(dizi_al(p.a_ad, arg), "TIP_BASIT") {
            değişken argad: metin = dizi_al(p.a_deg, arg);
            // Generic param adı (`T` gibi) bound denetiminden MUAF — C'de de
            // resolve enclosing scope'tan gelir.
            eğer (bilinen_skaler_mi(argad) veya yapi_var_mi(p, argad)
                  veya cesit_var_mi(p, argad)) {
                değişken bi: tam32 = 0;
                iken bi < dizi_boyut(p.gp_sahip) {
                    eğer metin_esit(dizi_al(p.gp_sahip, bi), tad)
                      ve (dizi_al(p.gp_idx, bi) == ai) {
                        değişken bd: metin = dizi_al(p.gp_bound, bi);
                        eğer ozellik_var_mi(p, bd) == yanlış {
                            sekil_hata(p, idx, "T031");
                        } değilse {
                            eğer uygula_var_mi(p, argad, bd) == yanlış {
                                sekil_hata(p, idx, "T030");
                            }
                        }
                    }
                    bi = bi + 1;
                }
            }
        }
        ai = ai + 1;
    }
    ver 0;
}
// ---- D-367: CT001-CT008 — sabitsüre (constant-time) kuralları, BAĞLAMA DÜZEYİ ----
// `sabitsüre<T>` gizli veriyi işaretler: dallanma/indeksleme/bölme ONUN üzerinde
// yapılamaz (cache + branch zamanlama yan kanalları), normal tipe implicit
// dönüşemez (`ifşa(...)` zorunlu). Sarılan tip constant-time YETENEKLİ olmalı.
//
// KAPSAM (bilinçli): "bu ifade sabitsüre mi?" sorusu YALNIZ doğrudan annotasyonlu
// bağlama için yanıtlanıyor. `s + s` gibi TAINT YAYILIMI (C'de sabitsüre aritmetik
// sonucu da sabitsüredir) BU PARTİDE YOK — ayrı adım. Yayılım olmadığı için
// eksik tanı olur, YANLIŞ tanı olmaz.
işlev tip_sabitsure_yetenekli_mi(t: metin) -> mantıksal {
    ver tamsayi_mi(t) veya metin_esit(t, "karakter") veya metin_esit(t, "mantıksal");
}
// Tip düğümü `sabitsüre<X>` ve X CT-yetenekli DEĞİL → CT006.
işlev ct006_tip_kontrol(p: &değişken Ayr, tn: tam32) -> tam32 {
    eğer metin_esit(dizi_al(p.a_ad, tn), "TIP_SABITSURE") == yanlış { ver 0; }
    eğer dizi_al(p.a_cs, tn) == 0 { ver 0; }
    değişken ic: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, tn));
    // Dizi<T> için elemana bak; TIP_BASIT dışı (yapı/seçimlik/...) → emin değiliz.
    eğer metin_esit(dizi_al(p.a_ad, ic), "TIP_BASIT") == yanlış { ver 0; }
    eğer tip_sabitsure_yetenekli_mi(dizi_al(p.a_deg, ic)) == yanlış {
        sekil_hata(p, tn, "CT006");
    }
    ver 0;
}
// Bağlama doğrudan `sabitsüre<T>` annotasyonlu mu? (yerel_sab yan-dizisi)
işlev bag_sabitsure_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = dizi_boyut(p.yerel) - 1;
    iken i >= p.yerel_basla {
        eğer metin_esit(dizi_al(p.yerel, i), ad) { ver dizi_al(p.yerel_sab, i) == 1; }
        i = i - 1;
    }
    ver yanlış;
}
// İfade KESİN sabitsüre mi? Doğrudan bağlama + ARİTMETİK/BİT yayılımı.
// C'de sabitsüre operandlı aritmetiğin sonucu da sabitsüredir (ölçüldü:
// `sabitsüre<tam32> = s + s` KABUL, `eğer s + s` ise CT001). Karşılaştırma ve
// `ifşa(...)` bu yoldan DIŞARIDA: ilki mantıksal üretir, ikincisi declassify eder.
işlev sabitsure_ifade_mi(p: &değişken Ayr, idx: tam32) -> mantıksal {
    değişken a: metin = dizi_al(p.a_ad, idx);
    eğer metin_esit(a, "TANIMLAYICI") { ver bag_sabitsure_mi(p, dizi_al(p.a_deg, idx)); }
    eğer metin_esit(a, "IKILI") {
        değişken op: metin = dizi_al(p.a_deg, idx);
        eğer (aritmetik_mi(op) veya bit_op_mi(op)) == yanlış { ver yanlış; }
        eğer dizi_al(p.a_cs, idx) < 2 { ver yanlış; }
        değişken cb: tam32 = dizi_al(p.a_cb, idx);
        ver sabitsure_ifade_mi(p, dizi_al(p.cocuk, cb))
          veya sabitsure_ifade_mi(p, dizi_al(p.cocuk, cb + 1));
    }
    ver yanlış;
}
// CT005 / CT007: `sabitsüre_olustur` ve `ifşa` arite + operand kuralları.
işlev ct_cagri_kontrol(p: &değişken Ayr, idx: tam32, fad: metin) -> mantıksal {
    değişken n: tam32 = dizi_al(p.a_cs, idx) - 1;
    eğer metin_esit(fad, "sabitsüre_olustur") {
        eğer n != 1 { sekil_hata(p, idx, "CT005"); ver doğru; }
        eğer metin_esit(p.drf_bek, "ct6") { sekil_hata(p, idx, "CT006"); ver doğru; }
        ver yanlış;
    }
    eğer metin_esit(fad, "ifşa") {
        eğer n != 1 { sekil_hata(p, idx, "CT007"); ver doğru; }
        // `ifşa` operandı sabitsüre olmalı; bilinen skaler ise KESİN değildir.
        değişken a0: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx) + 1);
        eğer (sabitsure_ifade_mi(p, a0) == yanlış)
          ve bilinen_skaler_mi(ifade_tip(p, a0, "?")) {
            sekil_hata(p, idx, "CT007");
            ver doğru;
        }
        ver yanlış;
    }
    ver yanlış;
}
// ---- D-366: DRF001-DRF007 — eşzamanlılık (görev/kanal) kuralları ----
// DRF001/DRF006: `görev<T>` ve `kanal<T>` V1'de KESİRLİ T taşıyamaz. Runtime
//   sonucu tamsayı yazmacından okur (x0/rax), kesirli değer v0/xmm0'dadır →
//   bitcast SESSİZ ÇÖP olurdu. İKİ yerde raporlanır: annotasyon/tip düğümü VE
//   yapıcı çağrısı (C aynı kısıtı iki yolda ayrı ayrı uygular).
// DRF002-005: intrinsic ariteleri (görev_birleştir 1, kanal_gönder 2,
//   kanal_al 1, dondur 1) — hepsi ÇAĞRI düğümünde.
// DRF007: `alan<T>` (alıcı ucu) üzerinden `kanal_gönder` yapılamaz (yön garantisi).
işlev tip_kesirli_arg_mi(p: &değişken Ayr, tn: tam32) -> mantıksal {
    eğer tn < 0 { ver yanlış; }
    eğer dizi_al(p.a_cs, tn) == 0 { ver yanlış; }
    değişken ic: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, tn));
    eğer metin_esit(dizi_al(p.a_ad, ic), "TIP_BASIT") == yanlış { ver yanlış; }
    ver kesirli_mi(dizi_al(p.a_deg, ic));
}
// Tip düğümü denetimi: `görev<kesirli*>` → DRF001, `kanal<kesirli*>` → DRF006.
işlev drf_tip_kontrol(p: &değişken Ayr, tn: tam32) -> tam32 {
    eğer tip_kesirli_arg_mi(p, tn) == yanlış { ver 0; }
    eğer metin_esit(dizi_al(p.a_ad, tn), "TIP_GOREV") { ver sekil_hata(p, tn, "DRF001"); }
    eğer metin_esit(dizi_al(p.a_ad, tn), "TIP_KANAL") { ver sekil_hata(p, tn, "DRF006"); }
    ver 0;
}
// Değer bir kanal UCU projeksiyonu mu? `alan(k)` / `gönderen(k)` → yön adı.
// Tipten okunamıyor: `alan<T>` annotasyonu TIP_KULLANICI'ya düşüyor ve ADI
// düğümde tutulmuyor (ölçüldü) → DEĞER tarafı tek güvenilir sinyal.
işlev kanal_uc_yonu(p: &değişken Ayr, deger: tam32) -> metin {
    eğer deger < 0 { ver ""; }
    eğer metin_esit(dizi_al(p.a_ad, deger), "CAGRI") == yanlış { ver ""; }
    eğer dizi_al(p.a_cs, deger) == 0 { ver ""; }
    değişken h: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, deger));
    eğer metin_esit(dizi_al(p.a_ad, h), "TANIMLAYICI") == yanlış { ver ""; }
    değişken nm: metin = dizi_al(p.a_deg, h);
    eğer metin_esit(nm, "alan") veya metin_esit(nm, "gönderen") { ver nm; }
    ver "";
}
// Bağlamanın kanal YÖNÜ: "alan" = alıcı ucu (DRF007), "" = bilinmiyor/yön yok.
işlev bag_kanal_yon(p: &değişken Ayr, ad: metin) -> metin {
    değişken i: tam32 = dizi_boyut(p.yerel) - 1;
    iken i >= p.yerel_basla {
        eğer metin_esit(dizi_al(p.yerel, i), ad) { ver dizi_al(p.yerel_yon, i); }
        i = i - 1;
    }
    ver "";
}
// DRF intrinsic arite + yön denetimi. Dönüş: 1 = erken dönüldü.
işlev drf_cagri_kontrol(p: &değişken Ayr, idx: tam32, fad: metin) -> mantıksal {
    değişken n: tam32 = dizi_al(p.a_cs, idx) - 1;   // çocuk[0] = hedef
    eğer metin_esit(fad, "görev_birleştir") {
        eğer n != 1 { sekil_hata(p, idx, "DRF002"); ver doğru; }
        ver yanlış;
    }
    eğer metin_esit(fad, "kanal_al") {
        eğer n != 1 { sekil_hata(p, idx, "DRF004"); ver doğru; }
        ver yanlış;
    }
    eğer metin_esit(fad, "dondur") {
        eğer n != 1 { sekil_hata(p, idx, "DRF005"); ver doğru; }
        ver yanlış;
    }
    // D-366: yapıcı çağrısı yolu — C aynı kesirli kısıtını burada TEKRAR uygular
    // (annotasyon yolundan bağımsız; iki tanı birden çıkar). Konumlar FARKLI:
    // görev_başlat → ARGÜMAN düğümü, kanal_oluştur → ÇAĞRI düğümü (C birebir).
    eğer metin_esit(fad, "görev_başlat") ve metin_esit(p.drf_bek, "görev") {
        eğer n >= 1 {
            sekil_hata(p, dizi_al(p.cocuk, dizi_al(p.a_cb, idx) + 1), "DRF001");
            ver doğru;
        }
    }
    eğer metin_esit(fad, "kanal_oluştur") ve metin_esit(p.drf_bek, "kanal") {
        sekil_hata(p, idx, "DRF006");
        ver doğru;
    }
    eğer metin_esit(fad, "kanal_gönder") {
        eğer n != 2 { sekil_hata(p, idx, "DRF003"); ver doğru; }
        // DRF007: ilk argüman ALICI ucu (`alan<T>`) ise gönderim yapılamaz.
        değişken a0: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx) + 1);
        eğer metin_esit(dizi_al(p.a_ad, a0), "TANIMLAYICI")
          ve metin_esit(bag_kanal_yon(p, dizi_al(p.a_deg, a0)), "alan") {
            sekil_hata(p, a0, "DRF007");   // C: ARGÜMAN düğümü (çağrı değil)
            ver doğru;
        }
        ver yanlış;
    }
    ver yanlış;
}
// ---- D-364: MM001/MM002/MM003 + CP004 — MMIO ve yetki intrinsikleri ----
// mmio_okuN(y: yetki<MMIO>, adres: tam64) -> tamN        (2 argüman)
// mmio_yazN(y: yetki<MMIO>, adres: tam64, değer: tamN)   (3 argüman)
//   MM001 arite (ÇAĞRI düğümü) · MM002 arg0 yetki<MMIO> değil (ARG düğümü)
//   MM003 adres/değer tamsayı değil (ARG düğümü)
// geri_al(y: yetki<R>)  → CP004 arite (ÇAĞRI) / operand yetki değil (ARG)
// CP005 (çift tüketim) BU PARTİDE YOK: lineer yetki izleme ayrı iş.
// Tip düğümünden `yetki<R>`nin KAYNAK adı ("" = yetki değil / emin değil).
işlev yetki_kaynak_adi(p: &değişken Ayr, tn: tam32) -> metin {
    eğer tn < 0 { ver ""; }
    eğer metin_esit(dizi_al(p.a_ad, tn), "TIP_YETKI") == yanlış { ver ""; }
    eğer dizi_al(p.a_cs, tn) == 0 { ver ""; }
    değişken ic: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, tn));
    eğer metin_esit(dizi_al(p.a_ad, ic), "TIP_BASIT") { ver dizi_al(p.a_deg, ic); }
    ver "";
}
// Bağlamanın yetki kaynağı ("" = yetki değil / bilinmiyor).
işlev bag_yetki_kaynak(p: &değişken Ayr, ad: metin) -> metin {
    değişken i: tam32 = dizi_boyut(p.yerel) - 1;
    iken i >= p.yerel_basla {
        eğer metin_esit(dizi_al(p.yerel, i), ad) { ver dizi_al(p.yerel_yet, i); }
        i = i - 1;
    }
    ver "";
}
// İfade KESİN olarak yetki<R> DEĞİL mi? (emin değilsek yanlış → susarız)
işlev kesin_yetki_degil(p: &değişken Ayr, idx: tam32) -> mantıksal {
    eğer metin_esit(dizi_al(p.a_ad, idx), "TANIMLAYICI") {
        değişken nm: metin = dizi_al(p.a_deg, idx);
        eğer yerel_var_mi(p, nm) { ver metin_esit(bag_yetki_kaynak(p, nm), ""); }
        ver yanlış;
    }
    ver bilinen_skaler_mi(ifade_tip(p, idx, "?"));   // literal/skaler → yetki değil
}
işlev mmio_oku_mu(ad: metin) -> mantıksal {
    ver metin_esit(ad, "mmio_oku16") veya metin_esit(ad, "mmio_oku32")
      veya metin_esit(ad, "mmio_oku64");
}
işlev mmio_yaz_mi(ad: metin) -> mantıksal {
    ver metin_esit(ad, "mmio_yaz16") veya metin_esit(ad, "mmio_yaz32")
      veya metin_esit(ad, "mmio_yaz64");
}
// MMIO çağrısı denetimi. C sırası: MM001 (arite, erken dönüş) → MM002 (arg0)
// → MM003 (adres, sonra değer). Dönüş: 1 = erken dönüldü (arite hatası).
işlev mmio_kontrol(p: &değişken Ayr, idx: tam32, fad: metin) -> mantıksal {
    değişken oku: mantıksal = mmio_oku_mu(fad);
    değişken yaz: mantıksal = mmio_yaz_mi(fad);
    eğer (oku veya yaz) == yanlış { ver yanlış; }
    değişken n: tam32 = dizi_al(p.a_cs, idx) - 1;   // çocuk[0] = hedef
    değişken bek: tam32 = 2;
    eğer yaz { bek = 3; }
    eğer n != bek { sekil_hata(p, idx, "MM001"); ver doğru; }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken a0: tam32 = dizi_al(p.cocuk, cb + 1);
    eğer metin_esit(bag_yetki_kaynak_ifade(p, a0), "MMIO") == yanlış
      ve kesin_yetki_degil(p, a0) { sekil_hata(p, a0, "MM002"); }
    değişken a1: tam32 = dizi_al(p.cocuk, cb + 2);
    eğer bilinen_tamsayi_degil(ifade_tip(p, a1, "?")) { sekil_hata(p, a1, "MM003"); }
    eğer yaz {
        değişken a2: tam32 = dizi_al(p.cocuk, cb + 3);
        eğer bilinen_tamsayi_degil(ifade_tip(p, a2, "?")) { sekil_hata(p, a2, "MM003"); }
    }
    ver yanlış;
}
// İfadenin yetki kaynağı (yalnız TANIMLAYICI bağlaması için bilinir).
işlev bag_yetki_kaynak_ifade(p: &değişken Ayr, idx: tam32) -> metin {
    eğer metin_esit(dizi_al(p.a_ad, idx), "TANIMLAYICI") {
        ver bag_yetki_kaynak(p, dizi_al(p.a_deg, idx));
    }
    ver "";
}
// CP004: `geri_al` TAM 1 argüman alır ve operandı yetki<R> olmalı.
işlev cp004_kontrol(p: &değişken Ayr, idx: tam32, fad: metin) -> mantıksal {
    eğer metin_esit(fad, "geri_al") == yanlış { ver yanlış; }
    değişken n: tam32 = dizi_al(p.a_cs, idx) - 1;
    eğer n != 1 { sekil_hata(p, idx, "CP004"); ver doğru; }
    değişken a0: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx) + 1);
    eğer kesin_yetki_degil(p, a0) { sekil_hata(p, a0, "CP004"); ver doğru; }
    // D-365: `geri_al` yetkiyi TÜKETİR (mmio_*/bölge_al ÖDÜNÇ alır, tüketmez).
    // İkinci `geri_al` → lin_tuket_dugum CP005 verir.
    lin_tuket_dugum(p, a0);
    ver yanlış;
}
// ---- D-358: G002 + G003 + G004 — güvensiz-tier ve temsil kuralları ----
// ---- D-373: AS001 — satıriçi_asm mimari etiketi hedefle uyuşmalı ----
// HEDEF MİMARİ self-host'ta SABİT "x86_64": C'nin varsayılanı budur ve self-host
// sürücüde `--mimari` bayrağı YOKTUR → hedef gerçekten değişmez. Bu bir varsayım
// değil, ölçülmüş bir olgu; sürücüye `--mimari` eklenirse BURASI da güncellenmeli.
// Etiket parser yan-kanalından gelir (`asm_node`/`asm_mim`) — düğüme alan eklemek
// `--ast` paritesini bozardı.
işlev asm_mimari_bul(p: &değişken Ayr, idx: tam32) -> metin {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.asm_node) {
        eğer dizi_al(p.asm_node, i) == idx { ver dizi_al(p.asm_mim, i); }
        i = i + 1;
    }
    ver "";
}
işlev as001_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken m: metin = asm_mimari_bul(p, idx);
    eğer metin_esit(m, "") { ver 0; }   // etiket yoksa denetim yok (C: mimari==NULL)
    eğer metin_esit(m, "x86_64") == yanlış { sekil_hata(p, idx, "AS001"); }
    ver 0;
}
// G002: `satıriçi_asm` yalnız `güvensiz` blokta (ham makine kodu = tier kapısı).
// G003: annotasyonsuz `değişken a = [..]` YIĞIN dizi üretir; `Dizi<T>` parametresi
//       dinamik KdlDizi* bekler → callee yığın diziyi KdlDizi sanar (misaligned
//       UB/SEGFAULT). Derleme zamanında reddedilir (çökmezlik #1). Literal argüman
//       ETKİLENMEZ (codegen onu heap'e yönlendirir); annotasyonlu Dizi de serbest.
// G004: `işlev(...)` tipli bağlama YENİDEN ATANAMAZ — closure temsili (bare fn-ptr
//       vs {fn,env}) bağlama anında sabitlenir; farklı yakalama-durumlu bir değerle
//       yeniden atama çağrı yerinde yanlış dispatch → segfault.
işlev bag_biti(p: &değişken Ayr, ad: metin, hangi: tam32) -> mantıksal {
    değişken i: tam32 = dizi_boyut(p.yerel) - 1;
    iken i >= p.yerel_basla {
        eğer metin_esit(dizi_al(p.yerel, i), ad) {
            eğer hangi == 0 { ver dizi_al(p.yerel_yig, i) == 1; }
            ver dizi_al(p.yerel_fn, i) == 1;
        }
        i = i - 1;
    }
    ver yanlış;
}
işlev fn_pdizi_bul(p: &değişken Ayr, ad: metin, j: tam32) -> tam32 {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.fn_ad) {
        eğer metin_esit(dizi_al(p.fn_ad, i), ad) {
            ver dizi_al(p.fn_pdizi, dizi_al(p.fn_pbase, i) + j);
        }
        i = i + 1;
    }
    ver 0;
}
// G003: argüman düğümünde raporlanır (C ile aynı konum).
işlev g003_kontrol(p: &değişken Ayr, fad: metin, j: tam32, arg: tam32) -> tam32 {
    eğer fn_pdizi_bul(p, fad, j) != 1 { ver 0; }
    eğer metin_esit(dizi_al(p.a_ad, arg), "TANIMLAYICI") == yanlış { ver 0; }
    eğer bag_biti(p, dizi_al(p.a_deg, arg), 0) { sekil_hata(p, arg, "G003"); }
    ver 0;
}
// ---- D-357: M002 + M003 — çeşit varyantı ve payload arite ----
// ÜÇ bölgede geçerli, üçü de C'de ayrı kod: (A) değer `Çeşit::V`, (B) yapıcı
// çağrısı `Çeşit::V(a,b)`, (C) `eşleş` deseni `Çeşit::V(a,b)`.
// C desende varyantı DESENİN ÖNEKİNDEN DEĞİL, SKRUTİNİNİN tipinden arar — bu
// yüzden (C) yolu `esles_cesit_adi`yi kullanır (D-352 altyapısı).
// M004 (payload TİPİ) portlanmadı: payload tip tablosu + generic substitüsyon ister.
işlev cesit_varyant_var(p: &değişken Ayr, cad: metin, vad: metin) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.cv_cesit) {
        eğer metin_esit(dizi_al(p.cv_cesit, i), cad)
          ve metin_esit(dizi_al(p.cv_ad, i), vad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// D-368: varyantın payload tip tablosundaki tabanı (yoksa -1).
işlev cesit_varyant_pb(p: &değişken Ayr, cad: metin, vad: metin) -> tam32 {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.cv_cesit) {
        eğer metin_esit(dizi_al(p.cv_cesit, i), cad)
          ve metin_esit(dizi_al(p.cv_ad, i), vad) { ver dizi_al(p.cv_pb, i); }
        i = i + 1;
    }
    ver 0 - 1;
}
işlev cesit_varyant_pc(p: &değişken Ayr, cad: metin, vad: metin) -> tam32 {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.cv_cesit) {
        eğer metin_esit(dizi_al(p.cv_cesit, i), cad)
          ve metin_esit(dizi_al(p.cv_ad, i), vad) { ver dizi_al(p.cv_pc, i); }
        i = i + 1;
    }
    ver 0 - 1;
}
// YOL düğümünün SOL tarafı bir çeşit adı mı? ("" = değil / emin değil)
// `mod::Renk::Kirmizi` için iç YOL'un a_deg'i çeşit adıdır.
işlev yol_cesit_adi(p: &değişken Ayr, sol: tam32) -> metin {
    değişken a: metin = dizi_al(p.a_ad, sol);
    eğer metin_esit(a, "TANIMLAYICI") veya metin_esit(a, "YOL") {
        değişken nm: metin = dizi_al(p.a_deg, sol);
        eğer cesit_var_mi(p, nm) { ver nm; }
    }
    ver "";
}
// "Ad::Varyant" dizgisinden varyant kısmı (sonek). Yoksa dizginin kendisi.
işlev yol_varyant_adi(p: &değişken Ayr, s: metin) -> metin {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.cv_ad) {
        değişken v: metin = dizi_al(p.cv_ad, i);
        eğer metin_biter(s, metin_birlestir("::", v)) { ver v; }
        i = i + 1;
    }
    ver "";
}
// (A) değer konumunda `Çeşit::V` — varyant yoksa M002 (YOL düğümünde).
işlev m002_yol_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    eğer dizi_al(p.a_cs, idx) == 0 { ver 0; }
    değişken sol: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
    değişken cad: metin = yol_cesit_adi(p, sol);
    eğer metin_esit(cad, "") {
        // D-362 T016: çeşit değilse modül olmalı. Yalnız TANIMLAYICI sol için
        // (iç içe `a::b::c` yolunda ara düğüm YOL'dur — C onu modül zinciriyle
        // çözer, self-host emin olamaz → susar).
        eğer metin_esit(dizi_al(p.a_ad, sol), "TANIMLAYICI")
          ve (modul_ad_mi(p, dizi_al(p.a_deg, sol)) == yanlış)
          ve (yerel_var_mi(p, dizi_al(p.a_deg, sol)) == yanlış) {
            sekil_hata(p, idx, "T016");
            ver 0;
        }
        // D-363 T041: modül BULUNDU ama üye `genel` değil (private-by-default).
        eğer metin_esit(dizi_al(p.a_ad, sol), "TANIMLAYICI")
          ve ozel_uye_mi(p, dizi_al(p.a_deg, sol), dizi_al(p.a_deg, idx)) {
            sekil_hata(p, idx, "T041");
        }
        ver 0;
    }
    eğer cesit_varyant_var(p, cad, dizi_al(p.a_deg, idx)) == yanlış {
        sekil_hata(p, idx, "M002");
    }
    ver 0;
}
// (B) yapıcı çağrısı `Çeşit::V(a,b)` — M002 sonra M003 (ikisi de ÇAĞRI düğümünde).
// C her ikisinde de erken döner → argüman kontrolü yapılmaz.
işlev m002_yapici_kontrol(p: &değişken Ayr, idx: tam32, hedef: tam32) -> mantıksal {
    eğer metin_esit(dizi_al(p.a_ad, hedef), "YOL") == yanlış { ver yanlış; }
    eğer dizi_al(p.a_cs, hedef) == 0 { ver yanlış; }
    değişken cad: metin = yol_cesit_adi(p, dizi_al(p.cocuk, dizi_al(p.a_cb, hedef)));
    eğer metin_esit(cad, "") { ver yanlış; }
    değişken vad: metin = dizi_al(p.a_deg, hedef);
    eğer cesit_varyant_var(p, cad, vad) == yanlış {
        sekil_hata(p, idx, "M002");
        ver doğru;
    }
    eğer (dizi_al(p.a_cs, idx) - 1) != cesit_varyant_pc(p, cad, vad) {
        sekil_hata(p, idx, "M003");
        ver doğru;
    }
    // D-368 M004: arite tuttu → her argüman payload TİPİYLE karşılaştırılır.
    // Konum ARGÜMAN düğümü; birden çok uyumsuz argüman birden çok tanı verir.
    // Beklenen tip bağlam olarak geçirilir (literal uyarlaması C ile aynı:
    // `Bir(tam8)` + `5` KABUL). Taraflardan biri "?" ise ATLANIR.
    değişken tb: tam32 = cesit_varyant_pb(p, cad, vad);
    eğer tb >= 0 {
        değişken ai: tam32 = 0;
        değişken an2: tam32 = dizi_al(p.a_cs, idx) - 1;
        iken ai < an2 {
            değişken bekt: metin = dizi_al(p.cv_pt, tb + ai);
            eğer metin_esit(bekt, "?") == yanlış {
                değişken arg: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx) + 1 + ai);
                değişken att: metin = ifade_tip(p, arg, bekt);
                eğer (metin_esit(att, "?") == yanlış) ve (metin_esit(att, bekt) == yanlış) {
                    sekil_hata(p, arg, "M004");
                }
            }
            ai = ai + 1;
        }
    }
    ver yanlış;
}
// (C) desen `Çeşit::V(a,b)` — varyant SKRUTİNİNİN çeşidinde aranır.
// C: alt-desen sayısı 0 ise M003 VERİLMEZ (çıplak `Çeşit::V` deseni serbest).
işlev m002_desen_kontrol(p: &değişken Ayr, des: tam32, cad: metin) -> tam32 {
    eğer metin_esit(cad, "") { ver 0; }
    eğer metin_esit(dizi_al(p.a_ad, des), "DESEN_YOL") == yanlış { ver 0; }
    değişken vad: metin = yol_varyant_adi(p, dizi_al(p.a_deg, des));
    eğer metin_esit(vad, "") veya (cesit_varyant_var(p, cad, vad) == yanlış) {
        sekil_hata(p, des, "M002");
        ver 0;
    }
    değişken an: tam32 = dizi_al(p.a_cs, des);
    eğer (an > 0) ve (an != cesit_varyant_pc(p, cad, vad)) {
        sekil_hata(p, des, "M003");
    }
    ver 0;
}
// ---- D-356: E011 + E012 — `küresel` tip ve başlangıç kısıtları ----
// C pre_populate_kuresel aynası. Küresel durum bootstrap-circularity çözümüdür:
// allocator'a bağlanamaz → tip YALNIZ skaler/ham-işaretçi, başlangıç YALNIZ
// sabit-literal. (`metin` İKİSİNİ de ihlal eder: hem tip hem literal yasak.)
// Konum: KURESEL düğümü. Sıra: E011 → E012 → T024 (C sembol_ekle'den önce).
işlev kuresel_tip_izinli_mi(p: &değişken Ayr, tn: tam32) -> mantıksal {
    eğer tn < 0 { ver yanlış; }
    değişken a: metin = dizi_al(p.a_ad, tn);
    eğer metin_esit(a, "TIP_POINTER") { ver doğru; }        // ham işaretçi serbest
    eğer metin_esit(a, "TIP_BASIT") == yanlış { ver yanlış; }  // Dizi/&/seçimlik/... yasak
    değişken t: metin = dizi_al(p.a_deg, tn);
    ver sayisal_mi(t) veya metin_esit(t, "mantıksal") veya metin_esit(t, "karakter");
}
işlev sabit_literal_mi(ad: metin) -> mantıksal {
    ver metin_esit(ad, "TAM") veya metin_esit(ad, "KESIRLI")
      veya metin_esit(ad, "MANTIKSAL") veya metin_esit(ad, "BOS")
      veya metin_esit(ad, "KARAKTER");   // METIN BİLİNÇLİ olarak YOK (C ile birebir)
}
işlev kuresel_kisit_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken cs: tam32 = dizi_al(p.a_cs, idx);
    değişken tn: tam32 = 0 - 1;
    eğer cs > 0 { tn = dizi_al(p.cocuk, cb); }
    eğer kuresel_tip_izinli_mi(p, tn) == yanlış { sekil_hata(p, idx, "E011"); }
    değişken dv: tam32 = 0 - 1;
    eğer cs > 1 { dv = dizi_al(p.cocuk, cb + 1); }
    eğer (dv < 0) veya (sabit_literal_mi(dizi_al(p.a_ad, dv)) == yanlış) {
        sekil_hata(p, idx, "E012");
    }
    ver 0;
}
// ---- D-355: L007 — `kullan`/`imha` operandının lineerliği ----
// C: `kullan(e)` operandı TAM OLARAK `tekkez<T>` olmalı (sarmalanan değeri ÇIKARIR;
// `yapı tekkez`in sarmalanmış bir değeri yoktur → orada da L007). `imha(e)` ise
// HERHANGİ bir lineer değeri kabul eder (tekkez / yetki / görev / `yapı tekkez`).
// Hata varsa C t_hata döner → operand TÜKETİLMEZ (ardından L001 gelebilir).
// Emin olamadığımız operandlarda (tip "?") kontrol atlanır.
işlev l007_kontrol(p: &değişken Ayr, idx: tam32, op: tam32, kullan_mi: mantıksal) -> mantıksal {
    eğer metin_esit(dizi_al(p.a_ad, op), "TANIMLAYICI") {
        değişken li: tam32 = lin_idx(p, dizi_al(p.a_deg, op));
        eğer li >= 0 {
            // KESİN lineer yapı + `kullan` → L007. Bit 0 ise (tekkez<T> ya da
            // annotasyonsuz bağlama) SUSULUR — 0 "yapı" demek DEĞİL, "bilinmiyor".
            eğer kullan_mi ve (dizi_al(p.lin_tek, li) == 1) {
                sekil_hata(p, idx, "L007");
                ver doğru;
            }
            ver yanlış;   // lineer ve uygun → hata yok
        }
    }
    eğer bilinen_skaler_mi(ifade_tip(p, op, "?")) {   // kesinlikle lineer değil
        sekil_hata(p, idx, "L007");
        ver doğru;
    }
    ver yanlış;
}
// ---- D-354: T013 — dizi literali eleman tipi ----
// C DUGUM_DIZI_OLUSTUR'un İKİ yolu var ve konumları farklı:
//   (a) Dizi<E> BAĞLAMI var  → her eleman E ile karşılaştırılır (İLK eleman DÂHİL)
//   (b) bağlam yok           → İLK eleman referanstır, sonrakiler onunla karşılaştırılır
// (a) yolunda referans E olduğu için hata İLK elemanda çıkabilir; (b)'yi (a) yerine
// kullanmak KONUMU kaydırırdı — bu yüzden bağlam `dizi_bek` ile taşınır.
// (b) yolunda İKİ eleman da sayısalsa ATLANIR: C orada literali bağlama tipine
// uyarlıyor ve hangi elemanın suçlandığı bağlama bağlı (yanlış konum riski).
// Dizi<E> bağlamı YALNIZ annotasyonlu bildirimden gelir; `ver`/argüman bağlamları
// "?" kalır (muhafazakâr alt küme — yanlış-pozitif yok).
işlev dizi_eleman_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken n: tam32 = dizi_al(p.a_cs, idx);
    eğer n == 0 { ver 0; }        // boş dizi (T014) bu partide YOK — bkz. D-354 notu
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken bek: metin = p.dizi_bek;
    eğer metin_esit(bek, "?") == yanlış {          // (a) bağlamlı yol
        değişken i: tam32 = 0;
        iken i < n {
            değişken e: tam32 = dizi_al(p.cocuk, cb + i);
            değişken t: metin = ifade_tip(p, e, bek);
            eğer (metin_esit(t, "?") == yanlış) ve (metin_esit(t, bek) == yanlış) {
                sekil_hata(p, e, "T013");
            }
            i = i + 1;
        }
        ver 0;
    }
    değişken ilk: metin = ifade_tip(p, dizi_al(p.cocuk, cb), "?");   // (b) bağlamsız
    eğer metin_esit(ilk, "?") { ver 0; }
    değişken j: tam32 = 1;
    iken j < n {
        değişken e2: tam32 = dizi_al(p.cocuk, cb + j);
        değişken t2: metin = ifade_tip(p, e2, "?");
        eğer (metin_esit(t2, "?") == yanlış) ve (metin_esit(t2, ilk) == yanlış) {
            eğer (sayisal_mi(ilk) ve sayisal_mi(t2)) == yanlış { sekil_hata(p, e2, "T013"); }
        }
        j = j + 1;
    }
    ver 0;
}
// T007: `x.alan` — x bilinen bir SKALER ise yapı değildir.
işlev t007_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    eğer dizi_al(p.a_cs, idx) == 0 { ver 0; }
    değişken nt: metin = ifade_tip(p, dizi_al(p.cocuk, dizi_al(p.a_cb, idx)), "?");
    eğer bilinen_skaler_mi(nt) { ver sekil_hata(p, idx, "T007"); }
    ver 0;
}
// T027: `için x: k` — k bilinen bir SKALER ise Dizi<T> değildir.
işlev t027_kontrol(p: &değişken Ayr, idx: tam32, kol: tam32) -> tam32 {
    eğer bilinen_skaler_mi(ifade_tip(p, kol, "?")) { ver sekil_hata(p, idx, "T027"); }
    ver 0;
}
// T006: `f(...)` — f bilinen SKALER tipte bir YEREL bağlama ise işlev değildir.
// (Kullanıcı işlevleri ve builtin'ler yerel bağlama DEĞİLDİR → etkilenmez.)
işlev t006_kontrol(p: &değişken Ayr, idx: tam32, hedef: tam32) -> mantıksal {
    eğer metin_esit(dizi_al(p.a_ad, hedef), "TANIMLAYICI") == yanlış { ver yanlış; }
    değişken nm: metin = dizi_al(p.a_deg, hedef);
    eğer yerel_var_mi(p, nm) == yanlış { ver yanlış; }
    eğer bilinen_skaler_mi(var_tip(p, nm)) == yanlış { ver yanlış; }
    sekil_hata(p, idx, "T006");
    ver doğru;
}
// ---- D-352: M001 — `eşleş` kapsayıcılık (exhaustiveness), ÇEŞİT dalı ----
// C esles_exhaustive_kontrol aynası. KAPSAM: yalnız çeşit skrutinisi. seçimlik<T>
// ve sonuç<T,H> dalları PORTLANMADI — self-host'ta bileşik tip bilgisi yok
// (ifade_tip "?" döner); o iki dal bilinçli boşluktur (yanlış-pozitif üretmez).
işlev metin_biter(s: metin, son: metin) -> mantıksal {
    değişken n: tam32 = metin_uzunluk(s);
    değişken m: tam32 = metin_uzunluk(son);
    eğer m > n { ver yanlış; }
    değişken i: tam32 = 0;
    iken i < m {
        eğer metin_bayt(s, n - m + i) != metin_bayt(son, i) { ver yanlış; }
        i = i + 1;
    }
    ver doğru;
}
işlev cesit_var_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.cv_cesit) {
        eğer metin_esit(dizi_al(p.cv_cesit, i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// Skrutini ÇEŞİT tipinde mi? Değilse/emin değilsek "" (kontrol atlanır).
// Yalnız TANIMLAYICI: annotasyonlu yerel/parametre. Diğer ifadeler → "".
işlev esles_cesit_adi(p: &değişken Ayr, kosul: tam32) -> metin {
    eğer metin_esit(dizi_al(p.a_ad, kosul), "TANIMLAYICI") == yanlış { ver ""; }
    değişken nm: metin = dizi_al(p.a_deg, kosul);
    değişken i: tam32 = dizi_boyut(p.yerel) - 1;
    iken i >= p.yerel_basla {
        eğer metin_esit(dizi_al(p.yerel, i), nm) {
            değişken t: metin = dizi_al(p.yerel_ham, i);
            eğer cesit_var_mi(p, t) { ver t; }
            ver "";
        }
        i = i - 1;
    }
    ver "";
}
// Kolun deseni (yoksa -1).
işlev kol_deseni(p: &değişken Ayr, kol: tam32) -> tam32 {
    eğer dizi_al(p.a_cs, kol) == 0 { ver 0 - 1; }
    ver dizi_al(p.cocuk, dizi_al(p.a_cb, kol));
}
işlev m001_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken ec: tam32 = dizi_al(p.a_cs, idx);
    eğer ec < 1 { ver 0; }
    değişken eb: tam32 = dizi_al(p.a_cb, idx);
    // Üst düzey joker `_` ya da bağlama yakalayıcısı → exhaustive ('hiç' HARİÇ:
    // o seçimlik varyantıdır, yakalayıcı değil — C ile birebir).
    değişken ki: tam32 = 1;
    iken ki < ec {
        değişken des: tam32 = kol_deseni(p, dizi_al(p.cocuk, eb + ki));
        eğer des >= 0 {
            değişken da: metin = dizi_al(p.a_ad, des);
            eğer metin_esit(da, "DESEN_JOKER") { ver 0; }
            eğer metin_esit(da, "DESEN_TANIMLAYICI")
              ve (metin_esit(dizi_al(p.a_deg, des), "hiç") == yanlış) { ver 0; }
        }
        ki = ki + 1;
    }
    değişken cad: metin = esles_cesit_adi(p, dizi_al(p.cocuk, eb));
    eğer metin_esit(cad, "") { ver 0; }
    // Her varyant bir DESEN_YOL ile kapsanmalı. C YALNIZ varyant kısmını
    // karşılaştırır (yol öneki yok sayılır) → sonek eşleşmesi birebir aynısı.
    değişken eksik_var: mantıksal = yanlış;
    değişken v: tam32 = 0;
    iken v < dizi_boyut(p.cv_cesit) {
        eğer metin_esit(dizi_al(p.cv_cesit, v), cad) {
            değişken hedef: metin = metin_birlestir("::", dizi_al(p.cv_ad, v));
            değişken kapsandi: mantıksal = yanlış;
            değişken k2: tam32 = 1;
            iken k2 < ec {
                değişken d2: tam32 = kol_deseni(p, dizi_al(p.cocuk, eb + k2));
                eğer d2 >= 0 {
                    eğer metin_esit(dizi_al(p.a_ad, d2), "DESEN_YOL")
                      ve metin_biter(dizi_al(p.a_deg, d2), hedef) { kapsandi = doğru; }
                }
                k2 = k2 + 1;
            }
            eğer kapsandi == yanlış { eksik_var = doğru; }
        }
        v = v + 1;
    }
    eğer eksik_var {
        dizi_ekle(p.th_kod, "M001");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
    }
    ver 0;
}
// ---- TC5b: lineer akış izleme yardımcıları ----
// Linear Types Spec V1 = YALNIZ tekkez (yetki → CP005/TC7, görev → DRF/TC6 ayrı kod).
// D-365: `yetki<R>` de LİNEER (Capability Spec V1) — C tip_lineer_mi ile aynı.
// Bu sayede L001/L002/L004 makinesinin TAMAMI yetki için de çalışır; tek fark
// RAPORLANAN KOD: yetki bağlamasında CP005 (lin_yet biti).
işlev tip_node_tekkez_mi(ad: metin) -> mantıksal {
    ver metin_esit(ad, "TIP_TEKKEZ") veya metin_esit(ad, "TIP_YETKI");
}
// D-365: lineer dilimdeki bağlama yetki mi? (kod seçimi için)
işlev lin_yetki_mi(p: &değişken Ayr, i: tam32) -> mantıksal {
    eğer i < 0 { ver yanlış; }
    eğer i >= dizi_boyut(p.lin_yet) { ver yanlış; }
    ver dizi_al(p.lin_yet, i) == 1;
}
// D-365: lineer tanı kodu — yetki bağlamasında CP005, aksi verilen kod.
işlev lin_kod(p: &değişken Ayr, i: tam32, kod: metin) -> metin {
    eğer lin_yetki_mi(p, i) { ver "CP005"; }
    ver kod;
}
// D-316: parametre tip düğümü LİNEER mi? tekkez<T> VEYA `yapı tekkez K`.
// Yalnız TIP_TEKKEZ bakmak, lineer YAPI parametresini tüketimsiz bırakıyordu
// (ölçüldü: cagri argümanı tüketilmeyip yanlış L001 çıkıyordu).
işlev param_lineer_mi(p: &değişken Ayr, tc: tam32) -> mantıksal {
    eğer tc < 0 { ver yanlış; }
    değişken ta: metin = dizi_al(p.a_ad, tc);
    eğer metin_esit(ta, "TIP_TEKKEZ") { ver doğru; }
    // D-372: `yetki<R>` parametresi de LİNEER → argüman TAŞINIR (tüketilir).
    // D-365 TIP_YETKI'yi `tip_node_tekkez_mi`ye ekledi ama BURAYA eklemedi →
    // `işlev f(y: yetki<MMIO>)` çağrısı y'yi tüketmiyordu → sahte CP005 (ölçüldü).
    eğer metin_esit(ta, "TIP_YETKI") { ver doğru; }
    eğer metin_esit(ta, "TIP_BASIT") { ver lineer_yapi_mi(p, dizi_al(p.a_deg, tc)); }
    ver yanlış;
}
// Bir değişkenin tekkez olup olmadığı: annot tekkez VEYA değer tekkez_olustur(...).
// D-314: ad bir LINEER YAPI mı (`yapı tekkez K`)?
işlev lineer_yapi_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.ly_ad) {
        eğer metin_esit(dizi_al(p.ly_ad, i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// ============================================================================
// D-317 — L-COND / L-LOOP portu (C tip_kontrol.c D-311/D-312 aynası).
//   Tüketim takibi AKIŞ-DUYARSIZ sayaçtı: `eğer p { kullan(t) } değilse { imha(t) }`
//   (spec'in KANONİK örneği) L002 veriyor, tek-dallı tüketim ise SESSİZ geçiyordu.
//   Çözüm: dal girişinde aktif lineer dilim ANLIK-GÖRÜNTÜLENİR, her dal kendi
//   kopyasında çalışır, çıkışta BİRLEŞTİRİLİR.
// ============================================================================
işlev lin_dilim_n(p: &değişken Ayr) -> tam32 {
    ver dizi_boyut(p.lin_ad) - p.lin_basla;
}
// Aktif dilimi anlık-görüntü yığınına it; taban indeksi döner.
işlev lin_snap_it(p: &değişken Ayr) -> tam32 {
    değişken base: tam32 = p.snap_top;
    değişken i: tam32 = p.lin_basla;
    iken i < dizi_boyut(p.lin_ad) {
        eğer p.snap_top < dizi_boyut(p.snap_tuk) {
            dizi_yaz(p.snap_tuk, p.snap_top, dizi_al(p.lin_tuk, i));
            dizi_yaz(p.snap_maske, p.snap_top, dizi_al(p.lin_maske, i));
        } değilse {
            dizi_ekle(p.snap_tuk, dizi_al(p.lin_tuk, i));
            dizi_ekle(p.snap_maske, dizi_al(p.lin_maske, i));
        }
        p.snap_top = p.snap_top + 1;
        i = i + 1;
    }
    ver base;
}
// Anlık görüntüden geri yükle (dal izolasyonu). n = görüntü alınırken ki eleman sayısı;
// dal İÇİNDE tanımlanan bağlamalar dilimi büyütebilir → n ile sınırla.
işlev lin_snap_geri(p: &değişken Ayr, base: tam32, n: tam32) -> tam32 {
    değişken k: tam32 = 0;
    iken (k < n) ve ((p.lin_basla + k) < dizi_boyut(p.lin_ad)) {
        dizi_yaz(p.lin_tuk, p.lin_basla + k, dizi_al(p.snap_tuk, base + k));
        dizi_yaz(p.lin_maske, p.lin_basla + k, dizi_al(p.snap_maske, base + k));
        k = k + 1;
    }
    ver 0;
}
işlev lin_snap_at(p: &değişken Ayr, base: tam32) -> tam32 { p.snap_top = base; ver 0; }
// L005 raporla (dal/döngü tutarsızlığı).
işlev l005_yaz(p: &değişken Ayr, idx: tam32) -> tam32 {
    dizi_ekle(p.th_kod, "L005");
    dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
    dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
    ver 0;
}
// D-317 L-LOOP: gövde DIŞ bir lineer bağlamayı tüketiyorsa hata. Döngü 0 kez
// dönerse sızıntı, >=2 kez dönerse ÇİFT tüketim. Gövde İÇİNDE tanımlananlar
// anlık görüntüde DEĞİLDİR (n ile sınırlı) → onlar serbesttir.
işlev lin_dongu_birlestir(p: &değişken Ayr, idx: tam32, base: tam32, n: tam32) -> tam32 {
    değişken k: tam32 = 0;
    iken (k < n) ve ((p.lin_basla + k) < dizi_boyut(p.lin_ad)) {
        değişken taban: tam32 = dizi_al(p.snap_tuk, base + k);
        eğer dizi_al(p.lin_tuk, p.lin_basla + k) > taban {
            l005_yaz(p, idx);
            dizi_yaz(p.lin_tuk, p.lin_basla + k, taban + 1);
        }
        k = k + 1;
    }
    ver 0;
}
// D-318: yapı deseni doğrulaması — C tip_kontrol.c aynası.
//   T009: desende bilinmeyen alan.
//   T012: TÜM alanlar listelenmeli (eksik alan = lineer yapıda SESSİZ SIZINTI;
//         listelenmeyen lineer alan hiçbir yere bağlanmaz ama yapı tüketilir).
// Ayrıca bağlanan LİNEER alanları lineer bağlama olarak kaydeder (L001 izler).
işlev desen_yapi_dogrula(p: &değişken Ayr, des: tam32) -> tam32 {
    değişken yad: metin = "";
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.dy_node) {
        eğer dizi_al(p.dy_node, i) == des { yad = dizi_al(p.dy_yapi, i); }
        i = i + 1;
    }
    eğer metin_esit(yad, "") { ver 0; }
    eğer yapi_idx_bul(p, yad) < 0 { ver 0; }   // yapı bilinmiyor → başka hata
    değişken listelenen: tam32 = 0;
    değişken q: tam32 = 0;
    iken q < dizi_boyut(p.dyf_node) {
        eğer dizi_al(p.dyf_node, q) == des {
            değişken fad: metin = dizi_al(p.dyf_alan, q);
            listelenen = listelenen + 1;   // C: desendeki alan SAYISI (geçerlilikten bağımsız)
            eğer alan_var_mi(p, yad, fad) == yanlış {
                dizi_ekle(p.th_kod, "T009");
                dizi_ekle(p.th_sat, dizi_al(p.a_sat, des));
                dizi_ekle(p.th_sut, dizi_al(p.a_sut, des));
            } değilse {
                // Bağlanan alan LİNEER ise kendi başına lineer bağlamadır.
                eğer lineer_alan_mi(p, yad, fad) {
                    lin_ekle(p, fad, dizi_al(p.a_sat, des), dizi_al(p.a_sut, des));
                }
            }
        }
        q = q + 1;
    }
    değişken yi: tam32 = yapi_idx_bul(p, yad);
    eğer listelenen != dizi_al(p.yapi_acount, yi) {
        dizi_ekle(p.th_kod, "T012");
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, des));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, des));
    }
    ver 0;
}
// D-316: 1 << n (okunabilirlik için ayrı işlev).
işlev bit_kaydir_sol(v: tam32, n: tam32) -> tam32 { ver v << n; }
// D-316: alanın, o yapının LİNEER alanları içindeki 0-tabanlı sırası (-1 yok).
işlev lineer_alan_sirasi(p: &değişken Ayr, yad: metin, fad: metin) -> tam32 {
    değişken ord: tam32 = 0;
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.lyf_yapi) {
        eğer metin_esit(dizi_al(p.lyf_yapi, i), yad) {
            eğer metin_esit(dizi_al(p.lyf_alan, i), fad) { ver ord; }
            ord = ord + 1;
        }
        i = i + 1;
    }
    ver 0 - 1;
}
// D-314: (yapı adı, alan adı) çifti lineer yapının LİNEER alanı mı?
işlev lineer_alan_mi(p: &değişken Ayr, yad: metin, fad: metin) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.lyf_yapi) {
        eğer metin_esit(dizi_al(p.lyf_yapi, i), yad)
          ve metin_esit(dizi_al(p.lyf_alan, i), fad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
işlev deg_lineer_mi(p: &değişken Ayr, idx: tam32) -> mantıksal {
    eğer dizi_al(p.a_cs, idx) >= 2 {
        değişken c0: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
        eğer tip_node_tekkez_mi(dizi_al(p.a_ad, c0)) { ver doğru; }
        // D-314: annotasyon LINEER YAPI ise bağlama da lineerdir.
        eğer metin_esit(dizi_al(p.a_ad, c0), "TIP_BASIT")
          ve lineer_yapi_mi(p, dizi_al(p.a_deg, c0)) { ver doğru; }
    }
    değişken vc: tam32 = son_cocuk(p, idx);
    // D-316: değer bir lineer ALAN erişimiyse (kısmi taşıma) bağlama LİNEERDİR.
    // Bu dal olmadan `değişken f = s.x` izlenmez → L001 çıkmaz (sessiz sızıntı).
    eğer (vc >= 0) ve metin_esit(dizi_al(p.a_ad, vc), "ERISIM") {
        değişken vn: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, vc));
        eğer metin_esit(dizi_al(p.a_ad, vn), "TANIMLAYICI") {
            eğer lineer_alan_mi(p, var_tip(p, dizi_al(p.a_deg, vn)),
                                dizi_al(p.a_deg, vc)) { ver doğru; }
        }
    }
    eğer (vc >= 0) ve metin_esit(dizi_al(p.a_ad, vc), "CAGRI") {
        değişken h: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, vc));
        eğer metin_esit(dizi_al(p.a_ad, h), "TANIMLAYICI")
          ve metin_esit(dizi_al(p.a_deg, h), "tekkez_olustur") { ver doğru; }
    }
    ver yanlış;
}
// D-321 (LC-3): bağlama annotasyonu `tekkez<işlev(...)>` mü? Böyle bir bağlama
// ÇAĞRILDIĞINDA çağrının kendisi tüketimdir (C tip_kontrol.c: hedef tipi TIP_TEKKEZ
// + iç TIP_ISLEV ise hedef sembolü tüketilir). Bağlama başına SABİT bilgi olduğu için
// anlık-görüntü (snapshot) makinesine dahil DEĞİL.
// ===== D-324: G005 (işaretçi yakalayan kaçan kapanış) — C tip_kontrol.c aynası =====
// C kuralı (D-323 daraltılmış): lambda ÇEVRE lokal/param YAKALIYOR **ve** yakalananlardan
// en az biri İŞARETÇİ-benzeri **ve** lambda KAÇIYOR → G005. env HEAP olduğu için skaler
// yakalama güvenli; işaretçi kopyası gösterdiği bölgeyi aşabilir.
// KONUM: LAMBDA düğümü — C ile birebir (ölçüldü: doğrudan `ver ||s`, transitif
// `değişken f=||s; ver f`, çağrı argümanı `al(f)` → üçünde de hata LAMBDA'nın sat/sut'unda).
// Self-host'ta genel escape DFA YOK → C'nin ESC_CAGIRAN tetikleyicileri ÖLÇÜLEREK taklit
// edilir: `ver <ad>` ya da CAGRI ARGÜMANI olmak. Çağrı HEDEFİ (`f()`) kaçış DEĞİLDİR
// (C'de de OK — ölçüldü). Tip çözülemezse (`"?"`) İŞARETÇİ varsayılır (default-deny).
işlev g005_skaler_tip_mi(t: metin) -> mantıksal {
    eğer metin_esit(t, "tam8") veya metin_esit(t, "tam16") { ver doğru; }
    eğer metin_esit(t, "tam32") veya metin_esit(t, "tam64") { ver doğru; }
    eğer metin_esit(t, "dtam8") veya metin_esit(t, "dtam16") { ver doğru; }
    eğer metin_esit(t, "dtam32") veya metin_esit(t, "dtam64") { ver doğru; }
    eğer metin_esit(t, "kesirli32") veya metin_esit(t, "kesirli64") { ver doğru; }
    eğer metin_esit(t, "mantıksal") veya metin_esit(t, "karakter") { ver doğru; }
    eğer metin_esit(t, "boş") { ver doğru; }
    ver yanlış;   // metin/Dizi/&T/ham-pointer/yapı/"?" → İŞARETÇİ (default-deny)
}
// Ad, lambda'nın KENDİ parametresi mi? (yakalama değil)
işlev g005_lam_param_mi(p: &değişken Ayr, lam: tam32, ad: metin) -> mantıksal {
    değişken cb: tam32 = dizi_al(p.a_cb, lam);
    değişken cs: tam32 = dizi_al(p.a_cs, lam);
    değişken i: tam32 = 0;
    iken i < cs - 1 {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "PARAMETRE") {
            eğer metin_esit(dizi_al(p.a_deg, c), ad) { ver doğru; }
        }
        i = i + 1;
    }
    ver yanlış;
}
// Ad lambda GÖVDESİNDE bildirilmiş mi? (yakalama değil — checker'ın yerel tablosu
// gövde-içi bildirimleri de içerir, ayıklanmazsa SAHTE yakalama üretir.)
işlev g005_govde_bildirimi_mi(p: &değişken Ayr, node: tam32, ad: metin) -> mantıksal {
    eğer node < 0 { ver yanlış; }
    eğer metin_esit(dizi_al(p.a_ad, node), "DEGISKEN") {
        eğer metin_esit(dizi_al(p.a_deg, node), ad) { ver doğru; }
    }
    değişken cb: tam32 = dizi_al(p.a_cb, node);
    değişken cs: tam32 = dizi_al(p.a_cs, node);
    değişken i: tam32 = 0;
    iken i < cs {
        eğer g005_govde_bildirimi_mi(p, dizi_al(p.cocuk, cb + i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// Ad, aktif işlev diliminde YEREL/PARAM mı? (global/işlev adı → yakalama değil)
işlev g005_yerel_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken n: tam32 = dizi_boyut(p.yerel);
    değişken i: tam32 = p.yerel_basla;
    iken i < n {
        eğer metin_esit(dizi_al(p.yerel, i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// Lambda İŞARETÇİ-benzeri bir çevre bağını yakalıyor mu? İç LAMBDA'ya GİRMEZ
// (C lambda_serbest_tara / self lam_cap_tara ile aynı sınır).
işlev g005_ptr_yakalar_mi(p: &değişken Ayr, node: tam32, lam: tam32, govde: tam32) -> mantıksal {
    eğer node < 0 { ver yanlış; }
    değişken t: metin = dizi_al(p.a_ad, node);
    eğer metin_esit(t, "TANIMLAYICI") {
        değişken ad: metin = dizi_al(p.a_deg, node);
        eğer g005_lam_param_mi(p, lam, ad) { ver yanlış; }
        eğer g005_govde_bildirimi_mi(p, govde, ad) { ver yanlış; }
        eğer g005_yerel_mi(p, ad) == yanlış { ver yanlış; }
        ver g005_skaler_tip_mi(var_tip(p, ad)) == yanlış;
    }
    eğer metin_esit(t, "LAMBDA") { ver yanlış; }
    değişken cb: tam32 = dizi_al(p.a_cb, node);
    değişken cs: tam32 = dizi_al(p.a_cs, node);
    değişken i: tam32 = 0;
    iken i < cs {
        eğer g005_ptr_yakalar_mi(p, dizi_al(p.cocuk, cb + i), lam, govde) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
işlev g005_lam_ptr_mi(p: &değişken Ayr, lam: tam32) -> mantıksal {
    değişken cb: tam32 = dizi_al(p.a_cb, lam);
    değişken cs: tam32 = dizi_al(p.a_cs, lam);
    eğer cs < 1 { ver yanlış; }
    değişken gv: tam32 = dizi_al(p.cocuk, cb + cs - 1);
    ver g005_ptr_yakalar_mi(p, gv, lam, gv);
}
// `ad` bağı bu alt-ağaçta KAÇIYOR mu? (C ESC_CAGIRAN tetikleyicileri — ölçüldü)
işlev g005_ad_kaciyor_mu(p: &değişken Ayr, node: tam32, ad: metin) -> mantıksal {
    eğer node < 0 { ver yanlış; }
    değişken t: metin = dizi_al(p.a_ad, node);
    değişken cb: tam32 = dizi_al(p.a_cb, node);
    değişken cs: tam32 = dizi_al(p.a_cs, node);
    eğer metin_esit(t, "VER") {
        eğer cs > 0 {
            değişken v: tam32 = dizi_al(p.cocuk, cb);
            eğer metin_esit(dizi_al(p.a_ad, v), "TANIMLAYICI") {
                eğer metin_esit(dizi_al(p.a_deg, v), ad) { ver doğru; }
            }
        }
    }
    eğer metin_esit(t, "CAGRI") {
        değişken k: tam32 = 1;   // çocuk 0 = HEDEF; çağırmak kaçış DEĞİL
        iken k < cs {
            değişken arg: tam32 = dizi_al(p.cocuk, cb + k);
            eğer metin_esit(dizi_al(p.a_ad, arg), "TANIMLAYICI") {
                eğer metin_esit(dizi_al(p.a_deg, arg), ad) { ver doğru; }
            }
            k = k + 1;
        }
    }
    değişken i: tam32 = 0;
    iken i < cs {
        eğer g005_ad_kaciyor_mu(p, dizi_al(p.cocuk, cb + i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
işlev g005_yaz(p: &değişken Ayr, lam: tam32) -> tam32 {
    dizi_ekle(p.th_kod, "G005");
    dizi_ekle(p.th_sat, dizi_al(p.a_sat, lam));
    dizi_ekle(p.th_sut, dizi_al(p.a_sut, lam));
    ver 0;
}
// DEGISKEN değeri LAMBDA ise: işaretçi yakalıyor + bağ aktif işlevde kaçıyorsa G005.
// Karar LAMBDA yerinde verilir (ileri-tarama) → C'nin raporlama SIRASI da korunur.
işlev g005_degisken_kontrol(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken cs: tam32 = dizi_al(p.a_cs, idx);
    eğer cs < 1 { ver 0; }
    değişken v: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx) + cs - 1);
    eğer metin_esit(dizi_al(p.a_ad, v), "LAMBDA") == yanlış { ver 0; }
    eğer g005_lam_ptr_mi(p, v) == yanlış { ver 0; }
    eğer p.aktif_fn < 0 { ver 0; }
    eğer g005_ad_kaciyor_mu(p, p.aktif_fn, dizi_al(p.a_deg, idx)) { g005_yaz(p, v); }
    ver 0;
}
// `ver <lambda>` / `f(<lambda>)`: bağ yok, lambda DOĞRUDAN kaçıyor.
işlev g005_dogrudan_kontrol(p: &değişken Ayr, node: tam32) -> tam32 {
    eğer node < 0 { ver 0; }
    eğer metin_esit(dizi_al(p.a_ad, node), "LAMBDA") == yanlış { ver 0; }
    eğer g005_lam_ptr_mi(p, node) { g005_yaz(p, node); }
    ver 0;
}
işlev lin_fn_tipi_mi(p: &değişken Ayr, idx: tam32) -> mantıksal {
    eğer dizi_al(p.a_cs, idx) < 2 { ver yanlış; }
    değişken c0: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
    eğer metin_esit(dizi_al(p.a_ad, c0), "TIP_TEKKEZ") == yanlış { ver yanlış; }
    eğer dizi_al(p.a_cs, c0) < 1 { ver yanlış; }
    ver metin_esit(dizi_al(p.a_ad, dizi_al(p.cocuk, dizi_al(p.a_cb, c0))), "TIP_ISLEV");
}
işlev lin_ekle(p: &değişken Ayr, ad: metin, sat: tam32, sut: tam32) -> tam32 {
    dizi_ekle(p.lin_ad, ad); dizi_ekle(p.lin_sat, sat);
    dizi_ekle(p.lin_sut, sut); dizi_ekle(p.lin_tuk, 0);
    dizi_ekle(p.lin_maske, 0); dizi_ekle(p.lin_fnk, 0);
    dizi_ekle(p.lin_tek, 0); dizi_ekle(p.lin_yet, 0);
    ver 0;   // D-316/D-321/D-355/D-365
}
// Aktif dilimde (en yeni) lineer bağlamanın indeksi; yoksa -1.
işlev lin_idx(p: &değişken Ayr, ad: metin) -> tam32 {
    değişken i: tam32 = dizi_boyut(p.lin_ad) - 1;
    iken i >= p.lin_basla {
        eğer metin_esit(dizi_al(p.lin_ad, i), ad) { ver i; }
        i = i - 1;
    }
    ver 0 - 1;
}
// Bir düğüm lineer bağlamaysa tüket; zaten tüketilmişse L002 (düğüm konumu).
işlev lin_tuket_dugum(p: &değişken Ayr, node: tam32) -> tam32 {
    eğer metin_esit(dizi_al(p.a_ad, node), "TANIMLAYICI") == yanlış { ver 0; }
    değişken idx: tam32 = lin_idx(p, dizi_al(p.a_deg, node));
    eğer idx < 0 { ver 0; }
    eğer dizi_al(p.lin_tuk, idx) >= 1 {
        dizi_ekle(p.th_kod, lin_kod(p, idx, "L002"));   // D-365: yetki → CP005
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, node));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, node));
    }
    // D-316: KISMİ TAŞINMIŞ yapı BÜTÜN OLARAK TAŞINAMAZ; `imha` serbest.
    eğer (dizi_al(p.lin_maske, idx) != 0) ve (p.imha_bag == 0) {
        dizi_ekle(p.th_kod, lin_kod(p, idx, "L002"));
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, node));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, node));
    }
    dizi_yaz(p.lin_tuk, idx, dizi_al(p.lin_tuk, idx) + 1);
    ver 0;
}
// İşlev lineer parametrelerini aktif dilime ekle (L001 + tüketim için).
işlev lin_param_topla(p: &değişken Ayr, fn: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, fn);
    değişken cs: tam32 = dizi_al(p.a_cs, fn);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "PARAMETRE") {
            değişken tc: tam32 = son_cocuk(p, c);
            eğer (tc >= 0) ve param_lineer_mi(p, tc) {
                lin_ekle(p, dizi_al(p.a_deg, c), dizi_al(p.a_sat, c), dizi_al(p.a_sut, c));
                // D-355: parametre KESİN `yapı tekkez` mi? (`kullan` yalnız tekkez<T> alır)
                eğer metin_esit(dizi_al(p.a_ad, tc), "TIP_BASIT")
                  ve lineer_yapi_mi(p, dizi_al(p.a_deg, tc)) {
                    dizi_yaz(p.lin_tek, dizi_boyut(p.lin_tek) - 1, 1);
                }
                // D-365: `yetki<R>` parametresi → tanılar CP005.
                eğer metin_esit(yetki_kaynak_adi(p, tc), "") == yanlış {
                    dizi_yaz(p.lin_yet, dizi_boyut(p.lin_yet) - 1, 1);
                }
            }
        }
        i = i + 1;
    }
    ver 0;
}
// İşlev scope kapanışı: aktif dilimde tüketilmemiş lineer bağlama → L001.
işlev lin_kapanis(p: &değişken Ayr) -> tam32 {
    değişken n: tam32 = dizi_boyut(p.lin_ad);
    değişken i: tam32 = p.lin_basla;
    iken i < n {
        eğer dizi_al(p.lin_tuk, i) == 0 {
            dizi_ekle(p.th_kod, lin_kod(p, i, "L001"));   // D-365: yetki → CP005
            dizi_ekle(p.th_sat, dizi_al(p.lin_sat, i));
            dizi_ekle(p.th_sut, dizi_al(p.lin_sut, i));
        }
        i = i + 1;
    }
    ver 0;
}

// Yerel/param tip-string filtresi: yalnız bilinen skaler VEYA bilinen yapı adı
// saklanır; aksi (generic "T" gibi bilinmeyen ad) → "?" → kontrol atlanır.
// C: TIP_GENERIC_PARAM için tip_sayisal_mi "deferred true" → generic'te T003 yok.
işlev yerel_tip_filtrele(p: &değişken Ayr, t: metin) -> metin {
    eğer bilinen_skaler_mi(t) veya yapi_var_mi(p, t) { ver t; }
    ver "?";
}
işlev yerel_topla(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken ad: metin = dizi_al(p.a_ad, idx);
    eğer metin_esit(ad, "PARAMETRE") {
        dizi_ekle(p.yerel, dizi_al(p.a_deg, idx));
        değişken tc: tam32 = son_cocuk(p, idx);   // param tip çocuğu (kendin → çocuk yok)
        eğer (tc >= 0) ve metin_baslar(dizi_al(p.a_ad, tc), "TIP_") {
            dizi_ekle(p.yerel_tip, yerel_tip_filtrele(p, tip_str(p, tc)));
        } değilse { dizi_ekle(p.yerel_tip, "?"); }
        dizi_ekle(p.yerel_ptr, tip_node_ptr_mi(p, tc));   // D-351 G001
        eğer (tc >= 0) ve metin_baslar(dizi_al(p.a_ad, tc), "TIP_") {
            dizi_ekle(p.yerel_ham, tip_str(p, tc));       // D-352 M001 (süzülmemiş)
        } değilse { dizi_ekle(p.yerel_ham, "?"); }
        dizi_ekle(p.yerel_dizi, tip_node_dizi_mi(p, tc));   // D-353 T005
        dizi_ekle(p.yerel_yig, 0);   // parametre yığın-dizi bağlaması olamaz
        dizi_ekle(p.yerel_fn, 0);
        dizi_ekle(p.yerel_yet, yetki_kaynak_adi(p, tc));   // D-364 MM002/CP004
        dizi_ekle(p.yerel_yon, "");   // D-366: parametrede yön sinyali yok
        dizi_ekle(p.yerel_sab, tip_node_sabitsure_mi(p, tc));   // D-367 CT
    } değilse {
        eğer metin_esit(ad, "DEGISKEN") {
            dizi_ekle(p.yerel, dizi_al(p.a_deg, idx));
            dizi_ekle(p.yerel_tip, yerel_tip_filtrele(p, annot_str(p, idx)));
            dizi_ekle(p.yerel_ptr, tip_node_ptr_mi(p, annot_node(p, idx)));   // D-351
            dizi_ekle(p.yerel_ham, annot_str(p, idx));    // D-352
            dizi_ekle(p.yerel_dizi, tip_node_dizi_mi(p, annot_node(p, idx)));   // D-353
            // D-358 G003: annotasyonsuz `değişken a = [..]` YIĞIN dizi üretir.
            değişken van: tam32 = annot_node(p, idx);
            değişken vvc: tam32 = son_cocuk(p, idx);
            eğer (van < 0) ve (vvc >= 0)
              ve metin_esit(dizi_al(p.a_ad, vvc), "DIZI_OLUSTUR") {
                dizi_ekle(p.yerel_yig, 1);
            } değilse { dizi_ekle(p.yerel_yig, 0); }
            // D-358 G004: `işlev(...)->T` annotasyonlu bağlama yeniden atanamaz.
            eğer (van >= 0) ve metin_esit(dizi_al(p.a_ad, van), "TIP_ISLEV") {
                dizi_ekle(p.yerel_fn, 1);
            } değilse { dizi_ekle(p.yerel_fn, 0); }
            dizi_ekle(p.yerel_yet, yetki_kaynak_adi(p, van));   // D-364
            dizi_ekle(p.yerel_yon, kanal_uc_yonu(p, son_cocuk(p, idx)));   // D-366 DRF007
            dizi_ekle(p.yerel_sab, tip_node_sabitsure_mi(p, van));   // D-367
        } değilse {
            eğer metin_esit(ad, "ICIN") veya metin_esit(ad, "DESEN_TANIMLAYICI") {
                dizi_ekle(p.yerel, dizi_al(p.a_deg, idx));
                dizi_ekle(p.yerel_tip, "?");
                dizi_ekle(p.yerel_ptr, 0);
                dizi_ekle(p.yerel_ham, "?");
                dizi_ekle(p.yerel_dizi, 0);
                dizi_ekle(p.yerel_yig, 0);
                dizi_ekle(p.yerel_fn, 0);
                dizi_ekle(p.yerel_yet, "");
                dizi_ekle(p.yerel_yon, "");
                dizi_ekle(p.yerel_sab, 0);
            }
            // D-318: yapı deseni alanları da yerel bağlamadır (yan-kanaldan).
            eğer metin_esit(ad, "DESEN_YAPI") {
                değişken q: tam32 = 0;
                iken q < dizi_boyut(p.dyf_node) {
                    eğer dizi_al(p.dyf_node, q) == idx {
                        dizi_ekle(p.yerel, dizi_al(p.dyf_alan, q));
                        dizi_ekle(p.yerel_tip, "?");
                        dizi_ekle(p.yerel_ptr, 0);
                        dizi_ekle(p.yerel_ham, "?");
                        dizi_ekle(p.yerel_dizi, 0);
                        dizi_ekle(p.yerel_yig, 0);
                        dizi_ekle(p.yerel_fn, 0);
                        dizi_ekle(p.yerel_yet, "");
                        dizi_ekle(p.yerel_yon, "");
                        dizi_ekle(p.yerel_sab, 0);
                    }
                    q = q + 1;
                }
            }
        }
    }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken cs: tam32 = dizi_al(p.a_cs, idx);
    değişken i: tam32 = 0;
    iken i < cs { yerel_topla(p, dizi_al(p.cocuk, cb + i)); i = i + 1; }
    ver 0;
}
// İfade alt-ağacında T002 (tanımsız) + DEGISKEN/SABIT T001. Tip/desen/yol atla.
işlev kontrol_dugum(p: &değişken Ayr, idx: tam32) -> tam32 {
    değişken ad: metin = dizi_al(p.a_ad, idx);
    // Madde E: TIP_DONUSTUR bir İFADE'dir (TIP_ öneki yanıltıcı) — kaynak alt-ağacı
    // gezilir (C: önce kaynağın tipi belirlenir), sonra E001-E004; hedef tip düğümü atlanır.
    eğer metin_esit(ad, "TIP_DONUSTUR") {
        eğer dizi_al(p.a_cs, idx) > 0 { kontrol_dugum(p, dizi_al(p.cocuk, dizi_al(p.a_cb, idx))); }
        cast_kontrol(p, idx);
        ver 0;
    }
    eğer metin_baslar(ad, "TIP_") {
        // D-366: tip düğümü de denetlenir — `görev<kesirli*>`/`kanal<kesirli*>`
        // annotasyon/parametre yolunda DRF001/DRF006. Alt tipler için özyinele
        // (`Dizi<görev<kesirli64>>` gibi iç içe şekiller de yakalansın).
        drf_tip_kontrol(p, idx);
        ct006_tip_kontrol(p, idx);   // D-367
        t030_kontrol(p, idx);        // D-369 T030/T031
        t011_kontrol(p, idx);        // D-370 T011
        değişken tb: tam32 = dizi_al(p.a_cb, idx);
        değişken tc2: tam32 = dizi_al(p.a_cs, idx);
        değişken ti: tam32 = 0;
        iken ti < tc2 {
            değişken tcc: tam32 = dizi_al(p.cocuk, tb + ti);
            eğer metin_baslar(dizi_al(p.a_ad, tcc), "TIP_") { kontrol_dugum(p, tcc); }
            ti = ti + 1;
        }
        ver 0;
    }
    eğer metin_baslar(ad, "DESEN") { ver 0; }
    eğer metin_esit(ad, "YOL") { m002_yol_kontrol(p, idx); ver 0; }   // D-357 (A)
    // D-314 KISMİ TAŞIMA YASAĞI: lineer yapının LİNEER alanı dışarı okunamaz
    // (hem alan hem yapı tüketilir → aynı kaynak İKİ kez imha). Lineer-OLMAYAN
    // alan SERBEST. Kanca BURADA: ifade_tip yalnız annotasyonlu bildirimde çağrılır.
    // D-316 (V2.1 portu): lineer alan DIŞARI TAŞINABİLİR (bağlama başına bit-maske);
    // ikinci taşıma L002; bağlama çözülemezse / 31+ alan → muhafazakâr LR002.
    eğer metin_esit(ad, "ERISIM") {
        değişken enes: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
        eğer metin_esit(dizi_al(p.a_ad, enes), "TANIMLAYICI") {
            değişken ent: metin = var_tip(p, dizi_al(p.a_deg, enes));
            eğer lineer_alan_mi(p, ent, dizi_al(p.a_deg, idx)) {
                değişken eli: tam32 = lin_idx(p, dizi_al(p.a_deg, enes));
                değişken eord: tam32 = lineer_alan_sirasi(p, ent, dizi_al(p.a_deg, idx));
                eğer (eli < 0) veya (eord < 0) veya (eord > 30) {
                    dizi_ekle(p.th_kod, "LR002");
                    dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
                    dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
                } değilse {
                    değişken ebit: tam32 = bit_kaydir_sol(1, eord);
                    eğer (dizi_al(p.lin_maske, eli) & ebit) != 0 {
                        dizi_ekle(p.th_kod, "L002");
                        dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
                        dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
                    } değilse {
                        dizi_yaz(p.lin_maske, eli, dizi_al(p.lin_maske, eli) | ebit);
                    }
                }
            }
        }
    }
    eğer metin_esit(ad, "TANIMLAYICI") {
        değişken nm: metin = dizi_al(p.a_deg, idx);
        eğer (ad_tanimli_mi(p, nm) == yanlış) ve (metin_esit(nm, "hiç") == yanlış) {
            dizi_ekle(p.th_kod, "T002");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
        } değilse eğer (yerel_var_mi(p, nm) == yanlış) ve secili_belirsiz_mi(p, nm) {
            sekil_hata(p, idx, "T042");   // D-361: çıplak ad iki modülden geldi
        } değilse {
            // D-351 E010: küresel değişkene erişim (okuma + yazma) yalnız güvensiz
            // blokta. Yerel bir bağlama aynı adı gölgeliyorsa küresel ÇÖZÜLMEZ (C:
            // sembol tablosu yereli kazandırır) → E010 yok. C hata verse de akışı
            // KESMEZ (t_hata dönmez) — burada da devam ediyoruz.
            eğer (p.guv_bag == 0) ve kuresel_ad_mi(p, nm) ve (yerel_var_mi(p, nm) == yanlış) {
                dizi_ekle(p.th_kod, "E010");
                dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
                dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
            }
        }
        ver 0;
    }
    // eğer/iken: koşulu (1. çocuk) önce kontrol + T021, sonra dalları (C sırası)
    eğer metin_esit(ad, "EGER") veya metin_esit(ad, "IKEN") {
        değişken kb: tam32 = dizi_al(p.a_cb, idx);
        değişken kc: tam32 = dizi_al(p.a_cs, idx);
        değişken kosul: tam32 = dizi_al(p.cocuk, kb);
        kontrol_dugum(p, kosul);
        t021_kontrol(p, idx, kosul);
        // D-367 CT001: gizli veri üzerinde dallanma = branch-timing yan kanalı.
        // C sırası: T021'den SONRA (ikisi de EGER/IKEN düğümünde).
        eğer sabitsure_ifade_mi(p, kosul) { sekil_hata(p, idx, "CT001"); }
        eğer metin_esit(ad, "IKEN") {
            // D-317 L-LOOP: gövde dış lineer bağlamayı tüketemez.
            değişken ln: tam32 = lin_dilim_n(p);
            değişken lb: tam32 = lin_snap_it(p);
            değişken j2: tam32 = 1;
            iken j2 < kc { kontrol_dugum(p, dizi_al(p.cocuk, kb + j2)); j2 = j2 + 1; }
            lin_dongu_birlestir(p, idx, lb, ln);
            lin_snap_at(p, lb);
            ver 0;
        }
        // D-317 L-COND: then/else AYRI anlık görüntüden çalışır, sonra birleşir.
        değişken n0: tam32 = lin_dilim_n(p);
        değişken b0: tam32 = lin_snap_it(p);          // taban
        eğer kc > 1 { kontrol_dugum(p, dizi_al(p.cocuk, kb + 1)); }   // then
        değişken bt: tam32 = lin_snap_it(p);          // then sonrası
        lin_snap_geri(p, b0, n0);                     // dalları izole et
        eğer kc > 2 { kontrol_dugum(p, dizi_al(p.cocuk, kb + 2)); }   // else
        // Birleştir: iki dal da tüketti → BİR tüketim; tam biri → L005.
        değişken k: tam32 = 0;
        iken (k < n0) ve ((p.lin_basla + k) < dizi_boyut(p.lin_ad)) {
            değişken tb: tam32 = dizi_al(p.snap_tuk, b0 + k);
            değişken t_then: mantıksal = dizi_al(p.snap_tuk, bt + k) > tb;
            değişken t_else: mantıksal = dizi_al(p.lin_tuk, p.lin_basla + k) > tb;
            eğer t_then ve t_else { dizi_yaz(p.lin_tuk, p.lin_basla + k, tb + 1); }
            değilse {
                eğer t_then veya t_else {
                    l005_yaz(p, idx);
                    // Tüketilmiş say: aksi halde scope sonunda AYRICA L001 patlar
                    // (tek kusur İKİ hata olarak raporlanırdı).
                    dizi_yaz(p.lin_tuk, p.lin_basla + k, tb + 1);
                } değilse { dizi_yaz(p.lin_tuk, p.lin_basla + k, tb); }
            }
            k = k + 1;
        }
        lin_snap_at(p, b0);
        ver 0;
    }
    // D-317 L-LOOP (`için`): çocuk[0]=koleksiyon, çocuk[1]=gövde.
    eğer metin_esit(ad, "ICIN") {
        değişken ib: tam32 = dizi_al(p.a_cb, idx);
        değişken ic: tam32 = dizi_al(p.a_cs, idx);
        eğer ic > 0 { kontrol_dugum(p, dizi_al(p.cocuk, ib)); }
        eğer ic > 0 { t027_kontrol(p, idx, dizi_al(p.cocuk, ib)); }   // D-353 T027
        değişken in0: tam32 = lin_dilim_n(p);
        değişken ib0: tam32 = lin_snap_it(p);
        eğer ic > 1 { kontrol_dugum(p, dizi_al(p.cocuk, ib + 1)); }
        lin_dongu_birlestir(p, idx, ib0, in0);
        lin_snap_at(p, ib0);
        ver 0;
    }
    // D-317 L-COND (`eşleş`): `eğer`in N-kollu genellemesi. çocuk[0]=değer,
    // çocuk[1..]=ESLES_KOLU. Ya HEPSİ tüketir ya HİÇBİRİ; karışıksa L005.
    eğer metin_esit(ad, "ESLES") {
        değişken eb: tam32 = dizi_al(p.a_cb, idx);
        değişken ec: tam32 = dizi_al(p.a_cs, idx);
        eğer ec > 0 { kontrol_dugum(p, dizi_al(p.cocuk, eb)); }
        değişken en0: tam32 = lin_dilim_n(p);
        değişken eb0: tam32 = lin_snap_it(p);
        değişken kol_n: tam32 = ec - 1;
        değişken tuketen: Dizi<tam32> = [];
        değişken z: tam32 = 0;
        iken z < en0 { dizi_ekle(tuketen, 0); z = z + 1; }
        değişken ki: tam32 = 1;
        iken ki < ec {
            lin_snap_geri(p, eb0, en0);          // her kolu İZOLE et
            // D-318: YAPI DESENI yapıyı TÜKETİR (lineer ise) — aksi halde hem
            // yapı hem bağlanan alanlar canlı kalır = aynı kaynak iki kez.
            değişken kol_d: tam32 = dizi_al(p.cocuk, eb + ki);
            eğer dizi_al(p.a_cs, kol_d) > 0 {
                değişken des: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, kol_d));
                // D-357 (C): desen varyantı + payload aritesi (gövdeden ÖNCE).
                m002_desen_kontrol(p, des, esles_cesit_adi(p, dizi_al(p.cocuk, eb)));
                eğer metin_esit(dizi_al(p.a_ad, des), "DESEN_YAPI") ve (ec > 0) {
                    lin_tuket_dugum(p, dizi_al(p.cocuk, eb));
                    desen_yapi_dogrula(p, des);
                }
            }
            kontrol_dugum(p, dizi_al(p.cocuk, eb + ki));
            değişken m: tam32 = 0;
            iken (m < en0) ve ((p.lin_basla + m) < dizi_boyut(p.lin_ad)) {
                eğer dizi_al(p.lin_tuk, p.lin_basla + m) > dizi_al(p.snap_tuk, eb0 + m) {
                    dizi_yaz(tuketen, m, dizi_al(tuketen, m) + 1);
                }
                m = m + 1;
            }
            ki = ki + 1;
        }
        lin_snap_geri(p, eb0, en0);
        değişken q: tam32 = 0;
        iken (q < en0) ve ((p.lin_basla + q) < dizi_boyut(p.lin_ad)) {
            değişken tb2: tam32 = dizi_al(p.snap_tuk, eb0 + q);
            eğer dizi_al(tuketen, q) == 0 { dizi_yaz(p.lin_tuk, p.lin_basla + q, tb2); }
            değilse {
                eğer (dizi_al(tuketen, q) == kol_n) ve (kol_n > 0) {
                    dizi_yaz(p.lin_tuk, p.lin_basla + q, tb2 + 1);
                } değilse {
                    l005_yaz(p, idx);
                    dizi_yaz(p.lin_tuk, p.lin_basla + q, tb2 + 1);
                }
            }
            q = q + 1;
        }
        lin_snap_at(p, eb0);
        m001_kontrol(p, idx);   // D-352: C sırası — L005'ten SONRA (kapsayıcılık en son)
        ver 0;
    }
    // CAGRI: hedef T002 → (tanımsız → erken dön) → T010 arite (uyumsuz → erken dön)
    // → argümanlar. C tip_belirle(CAGRI) sırası: hedef, arite, sonra arg kontrolü.
    eğer metin_esit(ad, "CAGRI") {
        değişken hb: tam32 = dizi_al(p.a_cb, idx);
        değişken hc: tam32 = dizi_al(p.a_cs, idx);
        değişken hedef: tam32 = dizi_al(p.cocuk, hb);
        // D-357 (B): çeşit yapıcısı `Çeşit::V(...)` — C bunu normal çağrı yolundan
        // ÖNCE dener ve hata varsa erken döner (argüman kontrolü yok).
        eğer m002_yapici_kontrol(p, idx, hedef) { ver 0; }
        kontrol_dugum(p, hedef);                 // hedef T002 (C: tip_belirle(hedef))
        eğer metin_esit(dizi_al(p.a_ad, hedef), "TANIMLAYICI") {
            değişken fad: metin = dizi_al(p.a_deg, hedef);
            eğer ad_tanimli_mi(p, fad) == yanlış {
                ver 0;   // C: tanımsız hedef → TIP_HATA → erken dönüş (arg atlanır)
            }
            // D-353 T006: hedef işlev tipinde değil → C erken döner (arite/arg yok).
            eğer t006_kontrol(p, idx, hedef) { ver 0; }
            // D-364: MMIO + yetki intrinsikleri (C bunları normal çağrı yolundan
            // ÖNCE özel-case eder; hata varsa erken döner).
            eğer mmio_kontrol(p, idx, fad) { ver 0; }
            eğer cp004_kontrol(p, idx, fad) { ver 0; }
            eğer drf_cagri_kontrol(p, idx, fad) { ver 0; }   // D-366
            eğer ct_cagri_kontrol(p, idx, fad) { ver 0; }    // D-367 CT005/CT007
            // D-355 L008: `tekkez_olustur` üretici intrinsic'i TAM 1 argüman alır.
            eğer metin_esit(fad, "tekkez_olustur") ve ((hc - 1) != 1) {
                sekil_hata(p, idx, "L008");
                ver 0;   // C: t_hata → argüman kontrolü yok
            }
            // D-321 (LC-3): hedef, lineer bir `tekkez<işlev(...)>` bağlaması ise
            // ÇAĞRI onu TÜKETİR. Bu dal olmadan bilinen-arite yoluna girmeyen çağrı
            // hedefi hiç tüketilmiyordu → sahte L001 (C kabul ediyor, self reddediyordu).
            eğer fn_psay_bul(p, fad) < 0 {
                değişken lfi: tam32 = lin_idx(p, fad);
                eğer lfi >= 0 {
                    eğer dizi_al(p.lin_fnk, lfi) == 1 { lin_tuket_dugum(p, hedef); }
                }
            }
            değişken ps: tam32 = fn_psay_bul(p, fad);
            eğer ps >= 0 {                        // kullanıcı işlevi → arite bilinir
                eğer (hc - 1) != ps {             // çocuk[0]=hedef → arg sayısı = hc-1
                    dizi_ekle(p.th_kod, "T010");
                    dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
                    dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
                    ver 0;   // C: arite uyumsuz → erken dönüş (arg tip kontrolü yok)
                }
                // D-360 E013: çıplak gövdeden normal (ρ-alan) kullanıcı işlevi
                // çağrılamaz. C sırası: T010'dan SONRA; hata AKIŞI KESMEZ (arg
                // kontrolü devam eder). Built-in/extern ρ almaz → muaf.
                eğer (p.cip_bag > 0) ve (fn_ciplak_mi(p, fad) == yanlış) {
                    sekil_hata(p, idx, "E013");
                }
                // arite OK → her arg: traverse (iç T002) + per-arg T001 (param tipi)
                değişken a: tam32 = 1;
                iken a < hc {
                    değişken arg: tam32 = dizi_al(p.cocuk, hb + a);
                    kontrol_dugum(p, arg);
                    değişken pt: metin = fn_ptip_bul(p, fad, a - 1);
                    eğer metin_esit(pt, "?") == yanlış {
                        değişken at: metin = ifade_tip(p, arg, pt);
                        eğer (metin_esit(at, "?") == yanlış) ve (metin_esit(at, pt) == yanlış) {
                            dizi_ekle(p.th_kod, "T001");
                            dizi_ekle(p.th_sat, dizi_al(p.a_sat, arg));
                            dizi_ekle(p.th_sut, dizi_al(p.a_sut, arg));
                        }
                    }
                    eğer fn_plin_bul(p, fad, a - 1) == 1 { lin_tuket_dugum(p, arg); }   // TC5b move
                    g003_kontrol(p, fad, a - 1, arg);   // D-358: C sırası — lineer tüketimden SONRA
                    a = a + 1;
                }
                ver 0;
            }
        }
        değişken k: tam32 = 1;
        // D-371: DOĞRUDAN lambda argümanı KAÇIŞ SAYILMAZ — C `escape.c` onu
        // ESC_CAGIRAN terfisinden bilinçli olarak MUAF tutar (`görev_başlat(|| ..)`
        // deseni; görev'in kendi R-YAKALAMA-THREAD sahiplik modeli var). Ada BAĞLI
        // lambda muaf DEĞİL (`değişken f = || s; al(f)` → G005; ölçüldü).
        iken k < hc { kontrol_dugum(p, dizi_al(p.cocuk, hb + k)); k = k + 1; }
        ver 0;
    }
    // ATAMA: T022 (lvalue) önce → hedef T002 → değer T002 → T001 (tip uyumsuz).
    // C DUGUM_ATAMA sırası birebir. Konum: ATAMA düğümü (sol-taraf başı).
    eğer metin_esit(ad, "ATAMA") {
        değişken ab: tam32 = dizi_al(p.a_cb, idx);
        değişken hedef: tam32 = dizi_al(p.cocuk, ab);
        değişken deger: tam32 = dizi_al(p.cocuk, ab + 1);
        // D-249 (GAP-2 parite): *p (TEKLI deref*) da lvalue — ham pointer deref-write
        // (C tip_kontrol.c D-248 T022 gevşetme aynası).
        değişken hedef_deref: mantıksal = metin_esit(dizi_al(p.a_ad, hedef), "TEKLI")
            ve metin_esit(dizi_al(p.a_deg, hedef), "deref*");
        eğer (lvalue_mi(dizi_al(p.a_ad, hedef)) == yanlış) ve (hedef_deref == yanlış) {
            dizi_ekle(p.th_kod, "T022");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
        }
        kontrol_dugum(p, hedef);
        kontrol_dugum(p, deger);
        // D-358 G004: `işlev(...)` tipli bağlama yeniden atanamaz (temsil sabitlenir).
        eğer metin_esit(dizi_al(p.a_ad, hedef), "TANIMLAYICI")
          ve bag_biti(p, dizi_al(p.a_deg, hedef), 1) { sekil_hata(p, idx, "G004"); }
        değişken ht: metin = ifade_tip(p, hedef, "?");   // TANIMLAYICI → var_tip; ERISIM/INDEKS → "?"
        eğer metin_esit(ht, "?") == yanlış {
            değişken dt: metin = ifade_tip(p, deger, ht);
            eğer (metin_esit(dt, "?") == yanlış) ve (metin_esit(dt, ht) == yanlış) {
                dizi_ekle(p.th_kod, "T001");
                dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
                dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
            }
        }
        ver 0;
    }
    // YAPI_OLUSTUR: T002 (tip tanımsız → erken dön) → her alan [T017 / değer T002 +
    // T001] → eksik alan T012. C kontrol_yapi_olustur_ic sırası + konum birebir.
    eğer metin_esit(ad, "YAPI_OLUSTUR") {
        değişken tad: metin = dizi_al(p.a_deg, idx);
        eğer yapi_var_mi(p, tad) == yanlış {
            dizi_ekle(p.th_kod, "T002");
            dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
            dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
            ver 0;   // C: yapı tanımsız → erken dönüş (alan kontrolü yok)
        }
        değişken ob: tam32 = dizi_al(p.a_cb, idx);
        değişken oc: tam32 = dizi_al(p.a_cs, idx);
        değişken i: tam32 = 0;
        iken i < oc {
            değişken aa: tam32 = dizi_al(p.cocuk, ob + i);   // ALAN_ATAMA
            değişken fad: metin = dizi_al(p.a_deg, aa);
            eğer alan_var_mi(p, tad, fad) == yanlış {
                dizi_ekle(p.th_kod, "T017");   // C: değer kontrol edilmez
                dizi_ekle(p.th_sat, dizi_al(p.a_sat, aa));
                dizi_ekle(p.th_sut, dizi_al(p.a_sut, aa));
            } değilse {
                değişken val: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, aa));
                kontrol_dugum(p, val);
                değişken ft: metin = alan_tip_bul(p, tad, fad);
                eğer metin_esit(ft, "?") == yanlış {
                    değişken vt: metin = ifade_tip(p, val, ft);
                    eğer (metin_esit(vt, "?") == yanlış) ve (metin_esit(vt, ft) == yanlış) {
                        dizi_ekle(p.th_kod, "T001");
                        dizi_ekle(p.th_sat, dizi_al(p.a_sat, aa));
                        dizi_ekle(p.th_sut, dizi_al(p.a_sut, aa));
                    }
                }
            }
            i = i + 1;
        }
        // eksik alan (T012): her yapı alanı construction'da var mı?
        değişken yi: tam32 = yapi_idx_bul(p, tad);
        değişken base: tam32 = dizi_al(p.yapi_abase, yi);
        değişken cnt: tam32 = dizi_al(p.yapi_acount, yi);
        değişken j: tam32 = 0;
        iken j < cnt {
            değişken fn: metin = dizi_al(p.alan_ad, base + j);
            değişken bulundu: mantıksal = yanlış;
            değişken k: tam32 = 0;
            iken k < oc {
                eğer metin_esit(dizi_al(p.a_deg, dizi_al(p.cocuk, ob + k)), fn) { bulundu = doğru; }
                k = k + 1;
            }
            eğer bulundu == yanlış {
                dizi_ekle(p.th_kod, "T012");
                dizi_ekle(p.th_sat, dizi_al(p.a_sat, idx));
                dizi_ekle(p.th_sut, dizi_al(p.a_sut, idx));
            }
            j = j + 1;
        }
        ver 0;
    }
    // TC5b: kullan(e)/imha(e) → operand T002 sonra lineer tüketim (L002 çift-tüketim).
    eğer metin_esit(ad, "KULLAN_IFADE") veya metin_esit(ad, "IMHA_IFADE") {
        değişken op: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, idx));
        kontrol_dugum(p, op);
        // D-355 L007: operand lineer değilse C erken döner → TÜKETİM YOK (L001 gelebilir).
        eğer l007_kontrol(p, idx, op, metin_esit(ad, "KULLAN_IFADE")) { ver 0; }
        // D-316: imha bağlamı — kısmi taşınmış yapı YALNIZ imha ile tüketilebilir.
        eğer metin_esit(ad, "IMHA_IFADE") { p.imha_bag = p.imha_bag + 1; }
        lin_tuket_dugum(p, op);
        eğer metin_esit(ad, "IMHA_IFADE") { p.imha_bag = p.imha_bag - 1; }
        ver 0;
    }
    // Madde E: `güvensiz` gövdesinde int <-> *T dönüşümü izinli (C guvensiz_baglam).
    eğer metin_esit(ad, "GUVENSIZ") {
        p.guv_bag = p.guv_bag + 1;
        değişken gcb: tam32 = dizi_al(p.a_cb, idx);
        değişken gcs: tam32 = dizi_al(p.a_cs, idx);
        değişken gi: tam32 = 0;
        iken gi < gcs { kontrol_dugum(p, dizi_al(p.cocuk, gcb + gi)); gi = gi + 1; }
        p.guv_bag = p.guv_bag - 1;
        ver 0;
    }
    değişken cb: tam32 = dizi_al(p.a_cb, idx);
    değişken cs: tam32 = dizi_al(p.a_cs, idx);
    // D-354: `değişken xs: Dizi<E> = [...]` — E'yi çocuk gezintisi boyunca bağlam
    // olarak taşı (C'nin beklenen-tip yolu). Diğer bağlamlar "?" kalır.
    değişken eski_bek: metin = p.dizi_bek;
    // D-366: `görev<kesirli*>` / `kanal<kesirli*>` annotasyonu → yapıcı çağrısı
    // yolunda DRF001/DRF006 (C aynı kısıtı iki yolda ayrı ayrı uygular).
    değişken eski_drf: metin = p.drf_bek;
    eğer metin_esit(ad, "DEGISKEN") veya metin_esit(ad, "SABIT") {
        değişken dan: tam32 = annot_node(p, idx);
        p.drf_bek = "";
        eğer tip_kesirli_arg_mi(p, dan) {
            eğer metin_esit(dizi_al(p.a_ad, dan), "TIP_GOREV") { p.drf_bek = "görev"; }
            eğer metin_esit(dizi_al(p.a_ad, dan), "TIP_KANAL") { p.drf_bek = "kanal"; }
        }
        // D-367 CT006 yapıcı yolu: annotasyon `sabitsüre<CT-olmayan>` ise
        // `sabitsüre_olustur` çağrısı da reddedilir (C iki yolda ayrı ayrı).
        eğer (tip_node_sabitsure_mi(p, dan) == 1) ve (dizi_al(p.a_cs, dan) > 0) {
            değişken dic: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, dan));
            eğer metin_esit(dizi_al(p.a_ad, dic), "TIP_BASIT")
              ve (tip_sabitsure_yetenekli_mi(dizi_al(p.a_deg, dic)) == yanlış) {
                p.drf_bek = "ct6";
            }
        }
    }
    eğer metin_esit(ad, "DEGISKEN") veya metin_esit(ad, "SABIT") {
        değişken an: tam32 = annot_node(p, idx);
        eğer tip_node_dizi_mi(p, an) == 1 {
            eğer dizi_al(p.a_cs, an) > 0 {
                p.dizi_bek = tip_str(p, dizi_al(p.cocuk, dizi_al(p.a_cb, an)));
            } değilse { p.dizi_bek = "?"; }
        } değilse { p.dizi_bek = "?"; }
    }
    değişken i: tam32 = 0;
    iken i < cs { kontrol_dugum(p, dizi_al(p.cocuk, cb + i)); i = i + 1; }
    p.dizi_bek = eski_bek;
    p.drf_bek = eski_drf;
    // DEGISKEN/SABIT: çocuk T002'lerinden SONRA T001; VER: T020 (C sırası)
    eğer metin_esit(ad, "DEGISKEN") veya metin_esit(ad, "SABIT") { t001_kontrol(p, idx); }
    // D-367 CT003: sabitsüre değer NORMAL tipli bağlamaya implicit akamaz
    // (`ifşa(...)` zorunlu). Annotasyon sabitsüre ise akış meşrudur.
    eğer metin_esit(ad, "DEGISKEN") veya metin_esit(ad, "SABIT") {
        değişken can: tam32 = annot_node(p, idx);
        değişken cvc: tam32 = son_cocuk(p, idx);
        eğer (can >= 0) ve (tip_node_sabitsure_mi(p, can) == 0)
          ve (cvc >= 0) ve sabitsure_ifade_mi(p, cvc) {
            sekil_hata(p, idx, "CT003");
        }
    }
    // TC5b: değişken — değer lineer bağlamaysa move-tüket; bağlama lineer ise izle.
    eğer metin_esit(ad, "DEGISKEN") {
        değişken vc2: tam32 = son_cocuk(p, idx);
        eğer vc2 >= 0 { lin_tuket_dugum(p, vc2); }   // move: değer lineer bağlamaysa tüket
        g005_degisken_kontrol(p, idx);   // D-324
        eğer deg_lineer_mi(p, idx) {
            lin_ekle(p, dizi_al(p.a_deg, idx), dizi_al(p.a_sat, idx), dizi_al(p.a_sut, idx));
            eğer lin_fn_tipi_mi(p, idx) {
                dizi_yaz(p.lin_fnk, dizi_boyut(p.lin_fnk) - 1, 1);   // D-321
            }
            // D-365: `yetki<R>` bağlaması → tanılar CP005 olarak raporlanır.
            eğer metin_esit(yetki_kaynak_adi(p, annot_node(p, idx)), "") == yanlış {
                dizi_yaz(p.lin_yet, dizi_boyut(p.lin_yet) - 1, 1);
            }
            // D-355: annotasyon KESİN lineer YAPI mı? (annotasyonsuz / tekkez<T> → 0)
            değişken lan: tam32 = annot_node(p, idx);
            eğer (lan >= 0) ve metin_esit(dizi_al(p.a_ad, lan), "TIP_BASIT")
              ve lineer_yapi_mi(p, dizi_al(p.a_deg, lan)) {
                dizi_yaz(p.lin_tek, dizi_boyut(p.lin_tek) - 1, 1);
            }
        }
    }
    eğer metin_esit(ad, "VER") {
        t020_kontrol(p, idx);
        eğer dizi_al(p.a_cs, idx) > 0 { g005_dogrudan_kontrol(p, dizi_al(p.cocuk, dizi_al(p.a_cb, idx))); }   // D-324
        eğer dizi_al(p.a_cs, idx) > 0 { lin_tuket_dugum(p, dizi_al(p.cocuk, dizi_al(p.a_cb, idx))); }
    }
    eğer metin_esit(ad, "IKILI") { t003_kontrol(p, idx); t004_kontrol(p, idx); t028_kontrol(p, idx); ct_ikili_kontrol(p, idx); }   // TC3e/f + T028 + D-367
    eğer metin_esit(ad, "TEKLI") { tekli_kontrol(p, idx); }   // TC3f: neg/degil + TC5b L004
    eğer metin_esit(ad, "INDEKS") { indeks_kontrol(p, idx); }   // D-351 G001 + D-353 T005/T008
    // D-358 G002: satıriçi asm yalnız güvensiz blokta (ham makine kodu tier kapısı).
    eğer metin_esit(ad, "SATIRICI_ASM") ve (p.guv_bag == 0) { sekil_hata(p, idx, "G002"); }
    // D-373: AS001 — `mimari:` etiketi HEDEF mimariyle uyuşmalı. C sırası: G002 SONRA.
    // Yanlış hedefe sessizce bozuk makine kodu üretmek yerine derleme hatası.
    eğer metin_esit(ad, "SATIRICI_ASM") { as001_kontrol(p, idx); }
    eğer metin_esit(ad, "ERISIM") { t007_kontrol(p, idx); }     // D-353 T007
    eğer metin_esit(ad, "DIZI_OLUSTUR") { dizi_eleman_kontrol(p, idx); }   // D-354 T013
    ver 0;
}
// İşlev gövdesini (BLOK çocuğu) kontrol et.
// D-370: İMZA GEÇİŞİ. C, tipleri `pre_populate`de çözer → TÜM imza/alan tanıları
// TÜM gövde tanılarından ÖNCE çıkar (ölçüldü: T030@8 imza, T011@5 gövde → 8 önce).
// D-369 bunu kontrol_govde içine koymuştu; küme doğruydu ama SIRA yanlıştı —
// korpusta imza-hatası ile gövde-hatası aynı dosyada olmadığı için gizli kalmıştı.
işlev kontrol_imza(p: &değişken Ayr, fn: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, fn);
    değişken cs: tam32 = dizi_al(p.a_cs, fn);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_baslar(dizi_al(p.a_ad, c), "TIP_") { kontrol_dugum(p, c); }
        eğer metin_esit(dizi_al(p.a_ad, c), "PARAMETRE") ve (dizi_al(p.a_cs, c) > 0) {
            değişken ptn: tam32 = son_cocuk(p, c);
            eğer (ptn >= 0) ve metin_baslar(dizi_al(p.a_ad, ptn), "TIP_") {
                kontrol_dugum(p, ptn);
            }
        }
        i = i + 1;
    }
    ver 0;
}
// D-370: `yapı`/`çeşit` ALAN ve PAYLOAD tipleri (aynı ön-geçişte).
işlev kontrol_yapi_alanlari(p: &değişken Ayr, c: tam32) -> tam32 {
    değişken yb: tam32 = dizi_al(p.a_cb, c);
    değişken yc: tam32 = dizi_al(p.a_cs, c);
    değişken yi: tam32 = 0;
    iken yi < yc {
        değişken yn: tam32 = dizi_al(p.cocuk, yb + yi);
        eğer metin_baslar(dizi_al(p.a_ad, yn), "TIP_") { kontrol_dugum(p, yn); }
        eğer metin_esit(dizi_al(p.a_ad, yn), "ALAN") ve (dizi_al(p.a_cs, yn) > 0) {
            değişken atn: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, yn));
            eğer metin_baslar(dizi_al(p.a_ad, atn), "TIP_") { kontrol_dugum(p, atn); }
        }
        yi = yi + 1;
    }
    ver 0;
}
işlev kontrol_govde(p: &değişken Ayr, fn: tam32) -> tam32 {
    p.aktif_donus = yerel_tip_filtrele(p, donus_str(p, fn));   // T020 bağlamı (generic dönüş "T" → "?")
    p.aktif_fn = fn;                     // D-324: G005 kaçış taramasının kökü
    p.lin_basla = dizi_boyut(p.lin_ad);  // TC5b: aktif işlev lineer dilimi
    lin_param_topla(p, fn);              // lineer parametreler dilime
    // D-351 (C D-257): `çıplak` işlev gövdesi ÖRTÜK güvensiz bağlamdır — küresel
    // erişim ve ham işaretçi izni oradan gelir (kem_malloc'un gerçek deseni).
    değişken cip: mantıksal = ciplak_govde_mi(p, fn);
    eğer cip { p.guv_bag = p.guv_bag + 1; p.cip_bag = p.cip_bag + 1; }   // D-360
    değişken cb: tam32 = dizi_al(p.a_cb, fn);
    değişken cs: tam32 = dizi_al(p.a_cs, fn);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "BLOK") { kontrol_dugum(p, c); }
        i = i + 1;
    }
    eğer cip { p.guv_bag = p.guv_bag - 1; p.cip_bag = p.cip_bag - 1; }
    lin_kapanis(p);   // TC5b: tüketilmemiş lineer bağlama → L001
    ver 0;
}
// Üst-düzeyleri gez: işlev gövdesi + sabit değeri kontrol; modül recurse.
işlev kontrol_ust(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    // ---- D-370 ÖN-GEÇİŞ (C `pre_populate`): ÖNCE tüm yapılar, SONRA tüm işlevler ----
    iken i < cs {
        değişken pc: tam32 = dizi_al(p.cocuk, cb + i);
        değişken pa: metin = dizi_al(p.a_ad, pc);
        eğer metin_esit(pa, "DISA") ve (dizi_al(p.a_cs, pc) > 0) {
            pc = dizi_al(p.cocuk, dizi_al(p.a_cb, pc));
            pa = dizi_al(p.a_ad, pc);
        }
        p.yerel_basla = dizi_boyut(p.yerel);
        eğer metin_esit(pa, "YAPI") veya metin_esit(pa, "CESIT") { kontrol_yapi_alanlari(p, pc); }
        i = i + 1;
    }
    i = 0;
    iken i < cs {
        değişken fc: tam32 = dizi_al(p.cocuk, cb + i);
        değişken fa: metin = dizi_al(p.a_ad, fc);
        eğer metin_esit(fa, "DISA") ve (dizi_al(p.a_cs, fc) > 0) {
            fc = dizi_al(p.cocuk, dizi_al(p.a_cb, fc));
            fa = dizi_al(p.a_ad, fc);
        }
        p.yerel_basla = dizi_boyut(p.yerel);
        eğer metin_esit(fa, "ISLEV") { kontrol_imza(p, fc); }
        i = i + 1;
    }
    // ---- GÖVDE GEÇİŞİ ----
    i = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        değişken ad: metin = dizi_al(p.a_ad, c);
        eğer metin_esit(ad, "ISLEV") {
            p.yerel_basla = dizi_boyut(p.yerel);
            yerel_topla(p, c);
            kontrol_govde(p, c);
        } değilse {
            // D-253: KURESEL init'i SABIT gibi denetlenir (üst-düzey, yerel yok).
            eğer metin_esit(ad, "SABIT") veya metin_esit(ad, "KURESEL") {
                p.yerel_basla = dizi_boyut(p.yerel);
                kontrol_dugum(p, c);
            } değilse {
                eğer metin_esit(ad, "MODUL") { kontrol_ust(p, c); }
                değilse {
                    eğer metin_esit(ad, "DISA") {  // dışa <tanım> → iç tanımı kontrol
                        değişken dcb: tam32 = dizi_al(p.a_cb, c);
                        eğer dizi_al(p.a_cs, c) > 0 {
                            değişken ic: tam32 = dizi_al(p.cocuk, dcb);
                            eğer metin_esit(dizi_al(p.a_ad, ic), "ISLEV") {
                                p.yerel_basla = dizi_boyut(p.yerel);
                                yerel_topla(p, ic); kontrol_govde(p, ic);
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    ver 0;
}
// TC2: üst-düzey tanım adı (işlev/yapı/çeşit/sabit/özellik/modül; dışa içini aç).
işlev tanim_adi(p: &değişken Ayr, c: tam32) -> metin {
    değişken ad: metin = dizi_al(p.a_ad, c);
    eğer metin_esit(ad, "ISLEV") veya metin_esit(ad, "YAPI") veya metin_esit(ad, "CESIT")
      veya metin_esit(ad, "SABIT") veya metin_esit(ad, "OZELLIK") veya metin_esit(ad, "MODUL")
      veya metin_esit(ad, "KURESEL") {   // D-356: küresel de global sembol (T024)
        ver dizi_al(p.a_deg, c);
    }
    eğer metin_esit(ad, "DISA") {
        eğer dizi_al(p.a_cs, c) > 0 { ver dizi_al(p.a_deg, dizi_al(p.cocuk, dizi_al(p.a_cb, c))); }
    }
    ver "";   // UYGULA (ad yok) / KULLAN / HATA → dup-muaf
}
// Çift-tanım kodu: yapı/çeşit → T026, diğer (işlev/sabit/özellik/modül) → T024.
işlev dup_kod(p: &değişken Ayr, c: tam32) -> metin {
    değişken ad: metin = dizi_al(p.a_ad, c);
    eğer metin_esit(ad, "DISA") {
        eğer dizi_al(p.a_cs, c) > 0 { ad = dizi_al(p.a_ad, dizi_al(p.cocuk, dizi_al(p.a_cb, c))); }
    }
    eğer metin_esit(ad, "YAPI") veya metin_esit(ad, "CESIT") { ver "T026"; }
    ver "T024";
}
// Etkin tür (dışa-sarmalını aç): YAPI/CESIT/ISLEV/SABIT/MODUL/OZELLIK/UYGULA/...
işlev etkin_kind(p: &değişken Ayr, c: tam32) -> metin {
    değişken ad: metin = dizi_al(p.a_ad, c);
    eğer metin_esit(ad, "DISA") {
        eğer dizi_al(p.a_cs, c) > 0 { ver dizi_al(p.a_ad, dizi_al(p.cocuk, dizi_al(p.a_cb, c))); }
    }
    ver ad;
}
// Bir tanımı paylaşılan `gor` kümesine göre çift-tanım kontrol et + ekle.
işlev dup_isle(p: &değişken Ayr, gor: Dizi<metin>, c: tam32) -> tam32 {
    değişken nm: metin = tanim_adi(p, c);
    eğer metin_esit(nm, "") { ver 0; }
    değişken j: tam32 = 0;  değişken bulundu: mantıksal = yanlış;
    iken j < dizi_boyut(gor) {
        eğer metin_esit(dizi_al(gor, j), nm) { bulundu = doğru; }
        j = j + 1;
    }
    eğer bulundu {
        dizi_ekle(p.th_kod, dup_kod(p, c));
        dizi_ekle(p.th_sat, dizi_al(p.a_sat, c));
        dizi_ekle(p.th_sut, dizi_al(p.a_sut, c));
    } değilse { dizi_ekle(gor, nm); }
    ver 0;
}
// TC2: ÜST-DÜZEY çift tanım (T024/T026). C pre_populate 4-geçiş sırası birebir:
// özellik → yapı/çeşit → (uygula: ad yok) → işlev/sabit/modül. Paylaşılan global
// kapsam (gor). İkinci tanımın konumunda hata. (Modül-içi/lokal → ileri TC.)
işlev dup_kontrol(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken gor: Dizi<metin> = [];
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {       // Geçiş 1: özellik
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(etkin_kind(p, c), "OZELLIK") { dup_isle(p, gor, c); }
        i = i + 1;
    }
    i = 0;
    iken i < cs {       // Geçiş 2: yapı + çeşit
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        değişken k: metin = etkin_kind(p, c);
        eğer metin_esit(k, "YAPI") veya metin_esit(k, "CESIT") { dup_isle(p, gor, c); }
        i = i + 1;
    }
    i = 0;
    iken i < cs {       // Geçiş 3 (uygula: ad yok) atlanır; Geçiş 4: işlev+sabit+modül
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        değişken k: metin = etkin_kind(p, c);
        // D-356: küresel de C'nin 4. geçişinde — kaynak sırası korunur (E011/E012
        // ile T024 arasındaki serpiştirme C ile aynı kalsın diye AYNI döngüde).
        eğer metin_esit(k, "ISLEV") veya metin_esit(k, "SABIT") veya metin_esit(k, "MODUL")
          veya metin_esit(k, "KURESEL") {
            eğer metin_esit(k, "KURESEL") { kuresel_kisit_kontrol(p, c); }
            dup_isle(p, gor, c);
        }
        i = i + 1;
    }
    ver 0;
}
// TC5a: yapı lineer alan içeremez (LR002). Lineer tip = tekkez/yetki/görev.
işlev tip_node_lineer_mi(ad: metin) -> mantıksal {
    ver metin_esit(ad, "TIP_TEKKEZ") veya metin_esit(ad, "TIP_YETKI")
      veya metin_esit(ad, "TIP_GOREV");
}
işlev lr002_yapi(p: &değişken Ayr, yapi: tam32) -> tam32 {
    // D-314 MUAFİYET: lineer yapı lineer alan taşıyabilir (sahiplik zinciri
    // kopmaz). Muaf tutarken lineer ALANLARI kaydet (kısmi-taşıma denetimi).
    eğer lineer_yapi_mi(p, dizi_al(p.a_deg, yapi)) {
        değişken lcb: tam32 = dizi_al(p.a_cb, yapi);
        değişken lcs: tam32 = dizi_al(p.a_cs, yapi);
        değişken li: tam32 = 0;
        iken li < lcs {
            değişken lc: tam32 = dizi_al(p.cocuk, lcb + li);
            eğer metin_esit(dizi_al(p.a_ad, lc), "ALAN") {
                değişken ltc: tam32 = son_cocuk(p, lc);
                eğer (ltc >= 0) ve tip_node_lineer_mi(dizi_al(p.a_ad, ltc)) {
                    dizi_ekle(p.lyf_yapi, dizi_al(p.a_deg, yapi));
                    dizi_ekle(p.lyf_alan, dizi_al(p.a_deg, lc));
                }
            }
            li = li + 1;
        }
        ver 0;
    }
    değişken cb: tam32 = dizi_al(p.a_cb, yapi);
    değişken cs: tam32 = dizi_al(p.a_cs, yapi);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "ALAN") {
            değişken tc: tam32 = son_cocuk(p, c);
            eğer (tc >= 0) ve tip_node_lineer_mi(dizi_al(p.a_ad, tc)) {
                dizi_ekle(p.th_kod, "LR002");
                dizi_ekle(p.th_sat, dizi_al(p.a_sat, c));
                dizi_ekle(p.th_sut, dizi_al(p.a_sut, c));
            }
        }
        i = i + 1;
    }
    ver 0;
}
// Üst-düzey + modül + dışa YAPI'lar üzerinde LR002 (pre-pass — gövdelerden ÖNCE).
işlev lr002_kontrol(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        değişken ad: metin = dizi_al(p.a_ad, c);
        eğer metin_esit(ad, "YAPI") { lr002_yapi(p, c); }
        eğer metin_esit(ad, "MODUL") { lr002_kontrol(p, c); }
        eğer metin_esit(ad, "DISA") {
            eğer dizi_al(p.a_cs, c) > 0 {
                değişken ic: tam32 = dizi_al(p.cocuk, dizi_al(p.a_cb, c));
                eğer metin_esit(dizi_al(p.a_ad, ic), "YAPI") { lr002_yapi(p, ic); }
            }
        }
        i = i + 1;
    }
    ver 0;
}
// ---- TC8a: cross-file/modül import — `kullan` ile dışa sembol toplama ----
// Bir yolun dizin kısmı (son '/' öncesi); '/' yoksa "".
işlev dizin_al(yol: metin) -> metin {
    değişken n: tam32 = metin_uzunluk(yol);
    değişken son: tam32 = 0 - 1;
    değişken i: tam32 = 0;
    iken i < n { eğer metin_bayt(yol, i) == 47 { son = i; } i = i + 1; }   // 47 = '/'
    eğer son < 0 { ver ""; }
    ver metin_kes(yol, 0, son);
}
// Modül yolu (a::b::c) → göreli dosya yolu (a/b/c.kem).
işlev modul_path(modul_yol: metin) -> metin {
    ver metin_birlestir(metin_yer_degistir(modul_yol, "::", "/"), ".kem");
}
// Modül içeriğini 3 arama yoluyla oku (C modulleri_yukle: dizin → kök → kütüphane/).
// Bulunamazsa "" (T040 → TC8b; şimdilik atla).
işlev modul_icerik(dizin: metin, rel: metin) -> metin {
    eğer metin_uzunluk(dizin) > 0 {
        değişken a0: metin = metin_birlestir(metin_birlestir(dizin, "/"), rel);
        eğer dosya_var_mi(a0) { ver dosya_oku(a0); }
    }
    eğer dosya_var_mi(rel) { ver dosya_oku(rel); }
    değişken a2: metin = metin_birlestir("kütüphane/", rel);
    eğer dosya_var_mi(a2) { ver dosya_oku(a2); }
    ver "";
}
// D-363: üst-düzey bir TANIM mı? (`dışa`/`kullan`/`uygula` değil — onların ya
// sarmalı ya da adı yok.) T041 yalnız adlandırılmış tanımlar için anlamlı.
işlev tanim_kind_mi(ad: metin) -> mantıksal {
    ver metin_esit(ad, "ISLEV") veya metin_esit(ad, "YAPI") veya metin_esit(ad, "CESIT")
      veya metin_esit(ad, "SABIT") veya metin_esit(ad, "OZELLIK");
}
// D-363: düğüm `genel` işaretli mi? (o modülün KENDİ ayrıştırıcısının yan-kanalı)
işlev gen_isaretli_mi(mp: &değişken Ayr, n: tam32) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(mp.gen_node) {
        eğer dizi_al(mp.gen_node, i) == n { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// D-363 / T041: `mod::uye` — üye o dosya-modülünde var ama `genel` değil.
işlev ozel_uye_mi(p: &değişken Ayr, mad: metin, uad: metin) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.priv_mod) {
        eğer metin_esit(dizi_al(p.priv_mod, i), mad)
          ve metin_esit(dizi_al(p.priv_ad, i), uad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// Bir modülü yükle: dışa-export adlarını p.g_isim'e ekle; kullan'ı transitif izle.
işlev modul_yukle(p: &değişken Ayr, modul_yol: metin, importer_dizin: metin) -> tam32 {
    değişken gn: tam32 = dizi_boyut(p.kullan_gorulen);
    değişken gi: tam32 = 0;
    iken gi < gn { eğer metin_esit(dizi_al(p.kullan_gorulen, gi), modul_yol) { ver 0; } gi = gi + 1; }
    dizi_ekle(p.kullan_gorulen, modul_yol);
    değişken rel: metin = modul_path(modul_yol);
    değişken ic: metin = modul_icerik(importer_dizin, rel);
    eğer metin_esit(ic, "") { ver 0 - 1; }   // D-361: bulunamadı → çağıran T040 verir
    değişken mp: Ayr = ayr_olustur(ic);
    lex_et(&değişken mp);
    değişken mkok: tam32 = parse_program(&değişken mp);
    değişken mdiz: metin = dizin_al(rel);   // transitif importer dizini
    değişken cb: tam32 = dizi_al(mp.a_cb, mkok);
    değişken cs: tam32 = dizi_al(mp.a_cs, mkok);
    değişken ci: tam32 = 0;
    iken ci < cs {
        değişken c: tam32 = dizi_al(mp.cocuk, cb + ci);
        değişken cad: metin = dizi_al(mp.a_ad, c);
        eğer metin_esit(cad, "DISA") {   // dışa <tanım> → iç tanım adı flat-görünür
            eğer dizi_al(mp.a_cs, c) > 0 {
                değişken inner: tam32 = dizi_al(mp.cocuk, dizi_al(mp.a_cb, c));
                g_ekle(p, dizi_al(mp.a_deg, inner));
            }
        }
        // D-363 T041 (private-by-default): DOSYA-modülünün `genel` İŞARETSİZ
        // üyeleri dışarıdan erişilemez. `dışa` sarmalı ve `genel` işaretlisi
        // muaf; dosya-içi `modül m { }` blokları C'de de denetlenmiyor (burası
        // yalnız dosya-modülü yolu olduğu için doğal olarak muaf).
        eğer tanim_kind_mi(cad) ve (gen_isaretli_mi(&değişken mp, c) == yanlış) {
            dizi_ekle(p.priv_mod, son_segment(modul_yol));
            dizi_ekle(p.priv_ad, dizi_al(mp.a_deg, c));
        }
        eğer metin_esit(cad, "KULLAN") { modul_yukle(p, dizi_al(mp.a_deg, c), mdiz); }
        ci = ci + 1;
    }
    ver 0;
}
// Üst-düzey tüm `kullan`'ları yükle (giriş dosyasının dizininden).
işlev kullan_yukle_hepsi(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "KULLAN") {
            // D-362 T040: modül dosyası bulunamadı. C İKİ KEZ raporlar — ana.c'de
            // iki yükleme geçişi var (legacy_kullan_yukle + modulleri_yukle) ve
            // ikisi de aynı KULLAN düğümünde hata verir; parite için ikisi de.
            // ÖNKOŞUL (D-361'de eksikti): runtime'ın UTF-8 yol desteği. Yoksa
            // `kütüphane/` modülleri açılamaz ve GEÇERLİ dosyalar sahte T040 alır.
            eğer modul_yukle(p, dizi_al(p.a_deg, c), p.giris_dizin) < 0 {
                sekil_hata(p, c, "T040");
                sekil_hata(p, c, "T040");
            } değilse {
                // D-362 T016: başarıyla yüklenen modülün SON segmenti nitelikli
                // erişimde kullanılır (`a::b::f` → `b::f` de yazılabilir).
                dizi_ekle(p.mod_ad, son_segment(dizi_al(p.a_deg, c)));
                dizi_ekle(p.mod_ad, dizi_al(p.a_deg, c));
            }
        }
        i = i + 1;
    }
    // D-361: seçili import adları NİTELİKSİZ görünür → global ada ekle.
    değişken j: tam32 = 0;
    iken j < dizi_boyut(p.si_ad) { g_ekle(p, dizi_al(p.si_ad, j)); j = j + 1; }
    ver 0;
}
// D-362: "a::b::c" → "c" (yol son segmenti). Segmentsizse dizginin kendisi.
işlev son_segment(yol: metin) -> metin {
    değişken n: tam32 = metin_uzunluk(yol);
    değişken i: tam32 = n - 1;
    iken i > 0 {
        eğer (metin_bayt(yol, i) == 58) ve (metin_bayt(yol, i - 1) == 58) {
            ver metin_kes(yol, i + 1, n - i - 1);
        }
        i = i - 1;
    }
    ver yol;
}
// D-362 / T016: `X::y` — X bilinen bir modül (ya da çeşit) değilse "modül
// bulunamadı". Modül adları: yüklenen `kullan`lar + alias'lar + `modül m` blokları.
işlev modul_ad_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = 0;
    iken i < dizi_boyut(p.mod_ad) {
        eğer metin_esit(dizi_al(p.mod_ad, i), ad) { ver doğru; }
        i = i + 1;
    }
    ver yanlış;
}
// Dosya içi `modül m { ... }` bildirimlerini topla (üst düzey + iç içe).
işlev modul_bildirim_topla(p: &değişken Ayr, kok: tam32) -> tam32 {
    değişken cb: tam32 = dizi_al(p.a_cb, kok);
    değişken cs: tam32 = dizi_al(p.a_cs, kok);
    değişken i: tam32 = 0;
    iken i < cs {
        değişken c: tam32 = dizi_al(p.cocuk, cb + i);
        eğer metin_esit(dizi_al(p.a_ad, c), "MODUL") {
            dizi_ekle(p.mod_ad, dizi_al(p.a_deg, c));
            modul_bildirim_topla(p, c);
        }
        eğer metin_esit(dizi_al(p.a_ad, c), "DISA") { modul_bildirim_topla(p, c); }
        i = i + 1;
    }
    ver 0;
}
// D-361 / T042: aynı ad BİRDEN ÇOK modülden seçili-import edildiyse çıplak
// kullanımı belirsizdir (nitelikli erişim geçerli kalır). C: kullanım yerinde.
işlev secili_belirsiz_mi(p: &değişken Ayr, ad: metin) -> mantıksal {
    değişken i: tam32 = 0;  değişken n: tam32 = 0;  değişken ilk: metin = "";
    iken i < dizi_boyut(p.si_ad) {
        eğer metin_esit(dizi_al(p.si_ad, i), ad) {
            eğer n == 0 { ilk = dizi_al(p.si_yol, i); n = 1; }
            değilse {
                eğer metin_esit(dizi_al(p.si_yol, i), ilk) == yanlış { ver doğru; }
            }
        }
        i = i + 1;
    }
    ver yanlış;
}
işlev kontrol_program(p: &değişken Ayr, kok: tam32) -> tam32 {
    builtin_ekle(p);
    kullan_yukle_hepsi(p, kok);   // TC8a: cross-file dışa semboller (T002'den ÖNCE)
    modul_bildirim_topla(p, kok); // D-362: dosya içi `modül m` adları (T016)
    genel_topla(p, kok);
    dup_kontrol(p, kok);     // T024 (üst-düzey çift tanım) — T002'den ÖNCE
    lr002_kontrol(p, kok);   // TC5a: yapı lineer alan (LR002) — gövdelerden ÖNCE
    kur_ad_topla(p, kok);    // D-351: E010 için küresel adlar — gövdelerden ÖNCE
    ozellik_uygula_topla(p, kok);   // D-369: özellik + uygula kayıtları (T030/T031)
    kontrol_ust(p, kok);
    ver 0;
}

işlev main() -> tam32 {
    eğer arg_sayi() < 2 {
        yaz_str("kullanim: kemgu_checker <kaynak.kem>"); yb(10);
        ver 1;
    }
    değişken yol: metin = arg_al(1);
    değişken kaynak: metin = dosya_oku(yol);
    değişken p: Ayr = ayr_olustur(kaynak);
    p.giris_dizin = dizin_al(yol);   // TC8a: import arama yolu
    lex_et(&değişken p);
    değişken kok: tam32 = parse_program(&değişken p);
    kontrol_program(&değişken p, kok);
    değişken nh: tam32 = dizi_boyut(p.th_kod);
    eğer nh == 0 { yaz_str("OK"); yb(10); ver 0; }
    değişken i: tam32 = 0;
    iken i < nh {
        yaz_str(dizi_al(p.th_kod, i)); yb(9);
        yaz_tam(dizi_al(p.th_sat, i)); yb(9);
        yaz_tam(dizi_al(p.th_sut, i)); yb(10);
        i = i + 1;
    }
    ver 0;
}
