// ============================================================================
// selfhost/lexer.kem — KEMGU lexer'ı KEMGU'da (SELF-HOST bootstrap).
//
// HEDEF: C lexer'ının (src/lexer.c) TAM İKAMESİ. Doğruluk: C-lexer `--token`
// dump'ına karşı SIFIR-DİFF (oracle). Format (D-035):
//   <TIP>\t<satır>\t<sütün>\t<offset>\t<uzunluk>
//
// MILESTONE M1: ASCII çekirdek (identifier + ondalık + tek-kar op + ayraç + EOF).
// MILESTONE M2: UTF-8 + TÜRKÇE anahtar kelimeler (44 keyword + bayt-sütün).
// MILESTONE M5: trivia + ham string. bosluk_atla'ya `//` satır + `/* */` İÇ İÇE
//   blok yorum (derinlik sayacı); ham string r#"..."# (hash eşleme, L002/L011).
//   C bosluk_atla/ham_metin_oku birebir. Kasıtlı NON-hata: kapanmamış blok-yorum
//   SESSİZ biter. Ham string ÇOK-SATIRLI → satir/sutun re-scan ile güncellenir.
// MILESTONE M4: literaller — sayi_emit (ondalık/hex/bin/oct + float kesir+üs),
//   dize_emit ("..." + escape ham-bırakma + L001), karakter_emit ('a'/UTF-8 +
//   L009/L010). C lexer sayi_oku/metin_oku/karakter_oku ile birebir (span-exact).
// MILESTONE M3: operatörler + noktalama — MAXIMAL MUNCH.
//   - Çatışma zincirleri (C lexer ile birebir, switch 318-375):
//     . / .. / ...   :  / ::   <  / <= / <<   >  / >= / >>
//     =  / == / =>    -  / -= / ->   + / +=   * / *=   / / /=   % / %=   ! / !=
//   - Bit ops & | ^ ~ KOŞULSUZ (&& yok; &değişken lexer'da BİRLEŞMEZ — parser işi).
//   - >> daima tek SAGA_KAYDIR (generic'i parser böler — lexer çözmez).
//   - Tek ! → HATALI (yalnız != geçerli). Kalan ayraç [ ] : eklendi.
//   - NOT: // ve /* trivia M5'te; M3 yalnız / ve /= verir. M3 korpusu yorum/literal
//     içermez; özellikle `rakam.` (float) M4'e ait — M3 korpusunda `digit.` YOK
//     (yalnız `..`/`...` aralık güvenli).
//   - metin_bayt İŞARETLİ → bayt() helper'ı UNSIGNED (0-255) döndürür.
//   (sayı varyant/literal → M4; yorum/raw/hata → M5; bootstrap ikame → M6.)
//
// Kullanım: kemgu_lexer.exe <kaynak.kem>
// ============================================================================

// Tek bayt yaz (yaz_karakter `karakter` ister; tam32 → karakter cast).
işlev yb(c: tam32) -> tam32 { yaz_karakter(c olarak karakter); ver 0; }
// Bir metni satır-sonu EKLEMEDEN bayt-bayt yaz (yaz_metin builtin değil).
işlev yaz_str(s: metin) -> tam32 {
    değişken n: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 0;
    iken i < n { yb(metin_bayt(s, i) olarak tam32); i = i + 1; }
    ver 0;
}
işlev emit(tip: metin, satir: tam32, sutun: tam32, offset: tam32, uzunluk: tam32) -> tam32 {
    yaz_str(tip);     yb(9);
    yaz_tam(satir);   yb(9);
    yaz_tam(sutun);   yb(9);
    yaz_tam(offset);  yb(9);
    yaz_tam(uzunluk); yb(10);
    ver 0;
}

// metin_bayt işaretli tam8 döner (Türkçe 0xC3 = -61). UNSIGNED bayt (0-255).
işlev bayt(s: metin, i: tam32) -> tam32 {
    değişken b: tam32 = metin_bayt(s, i) olarak tam32;
    eğer b < 0 { ver b + 256; }
    ver b;
}

işlev rakam_mi(b: tam32) -> mantıksal { ver b >= 48 ve b <= 57; }
işlev harf_mi(b: tam32) -> mantıksal {
    ver (b >= 97 ve b <= 122) veya (b >= 65 ve b <= 90);
}
işlev bosluk_mu(b: tam32) -> mantıksal {
    ver (b == 32) veya (b == 9) veya (b == 13) veya (b == 10);
}

// İki bayt bir Türkçe harf mi (utf8.c turkce_harf_2byte ile BİREBİR).
//   0xC3(195): ç Ç ö Ö ü Ü   0xC4(196): ğ Ğ ı İ   0xC5(197): ş Ş
işlev turkce_2byte_mi(b0: tam32, b1: tam32) -> mantıksal {
    eğer b0 == 195 {
        ver (b1 == 167) veya (b1 == 135) veya (b1 == 182)
          veya (b1 == 150) veya (b1 == 188) veya (b1 == 156);
    }
    eğer b0 == 196 {
        ver (b1 == 159) veya (b1 == 158) veya (b1 == 177) veya (b1 == 176);
    }
    eğer b0 == 197 { ver (b1 == 159) veya (b1 == 158); }
    ver yanlış;
}
// identifier-BAŞ karakter bayt-uzunluğu: 1 (ASCII harf/_) | 2 (Türkçe) | 0.
işlev kimlik_basi_uz(kaynak: metin, pos: tam32, uz: tam32) -> tam32 {
    eğer pos >= uz { ver 0; }
    değişken b0: tam32 = bayt(kaynak, pos);
    eğer harf_mi(b0) veya (b0 == 95) { ver 1; }
    eğer pos + 1 < uz {
        eğer turkce_2byte_mi(b0, bayt(kaynak, pos + 1)) { ver 2; }
    }
    ver 0;
}
// identifier-DEVAM karakter bayt-uzunluğu: 1 (ASCII harf/rakam/_) | 2 (Türkçe) | 0.
işlev kimlik_devam_uz(kaynak: metin, pos: tam32, uz: tam32) -> tam32 {
    eğer pos >= uz { ver 0; }
    değişken b0: tam32 = bayt(kaynak, pos);
    eğer harf_mi(b0) veya rakam_mi(b0) veya (b0 == 95) { ver 1; }
    eğer pos + 1 < uz {
        eğer turkce_2byte_mi(b0, bayt(kaynak, pos + 1)) { ver 2; }
    }
    ver 0;
}

// Bir kelime anahtar kelime mi → token adı; değilse "TANIMLAYICI". (44 keyword)
işlev anahtar_tip(w: metin) -> metin {
    // ASCII
    eğer metin_esit(w, "iken") { ver "IKEN"; }
    eğer metin_esit(w, "ve") { ver "VE"; }
    eğer metin_esit(w, "veya") { ver "VEYA"; }
    eğer metin_esit(w, "ver") { ver "VER"; }
    eğer metin_esit(w, "delege") { ver "DELEGE"; }
    eğer metin_esit(w, "hata") { ver "HATA"; }
    eğer metin_esit(w, "imha") { ver "IMHA"; }
    eğer metin_esit(w, "kendin") { ver "KENDIN"; }
    eğer metin_esit(w, "kullan") { ver "KULLAN"; }
    eğer metin_esit(w, "olarak") { ver "OLARAK"; }
    eğer metin_esit(w, "sabit") { ver "SABIT"; }
    eğer metin_esit(w, "tamam") { ver "TAMAM"; }
    eğer metin_esit(w, "tekkez") { ver "TEKKEZ"; }
    eğer metin_esit(w, "yetki") { ver "YETKI"; }
    eğer metin_esit(w, "genel") { ver "GENEL"; }
    eğer metin_esit(w, "geri_al") { ver "GERI_AL"; }
    eğer metin_esit(w, "uygula") { ver "UYGULA"; }
    eğer metin_esit(w, "kanal") { ver "KANAL"; }
    // Türkçe (UTF-8 lexeme'ler doğrudan)
    eğer metin_esit(w, "eğer") { ver "EGER"; }
    eğer metin_esit(w, "değilse") { ver "DEGILSE"; }
    eğer metin_esit(w, "için") { ver "ICIN"; }
    eğer metin_esit(w, "eşleş") { ver "ESLES"; }
    eğer metin_esit(w, "işlev") { ver "ISLEV"; }
    eğer metin_esit(w, "yapı") { ver "YAPI"; }
    eğer metin_esit(w, "çeşit") { ver "CESIT"; }
    eğer metin_esit(w, "özellik") { ver "OZELLIK"; }
    eğer metin_esit(w, "modül") { ver "MODUL"; }
    eğer metin_esit(w, "değişken") { ver "DEGISKEN"; }
    eğer metin_esit(w, "doğru") { ver "DOGRU"; }
    eğer metin_esit(w, "yanlış") { ver "YANLIS"; }
    eğer metin_esit(w, "boş") { ver "BOS"; }
    eğer metin_esit(w, "değil") { ver "DEGIL"; }
    eğer metin_esit(w, "dışa") { ver "DISA"; }
    eğer metin_esit(w, "bölge") { ver "BOLGE"; }
    eğer metin_esit(w, "seçimlik") { ver "SECIMLIK"; }
    eğer metin_esit(w, "sonuç") { ver "SONUC"; }
    eğer metin_esit(w, "değer") { ver "DEGER"; }
    eğer metin_esit(w, "hiç") { ver "HIC"; }
    eğer metin_esit(w, "güvensiz") { ver "GUVENSIZ"; }
    eğer metin_esit(w, "sabitsüre") { ver "SABITSURE"; }
    eğer metin_esit(w, "gerçekzamanlı") { ver "GERCEKZAMANLI"; }
    eğer metin_esit(w, "vektör") { ver "VEKTOR"; }
    eğer metin_esit(w, "görev") { ver "GOREV"; }
    eğer metin_esit(w, "satıriçi_asm") { ver "SATIRICI_ASM"; }
    ver "TANIMLAYICI";
}

// Sınır-güvenli bayt: pos < uz ise bayt, değilse 0 (lookahead).
işlev ikinci_bayt(kaynak: metin, pos: tam32, uz: tam32) -> tam32 {
    eğer pos < uz { ver bayt(kaynak, pos); }
    ver 0;
}
// Operatör/noktalama token'ı emit et (MAXIMAL MUNCH) → tüketilen bayt sayısı.
// ASCII: + 43  - 45  * 42  / 47  % 37  = 61  ! 33  < 60  > 62  & 38  | 124
//        ^ 94  ~ 126  . 46  : 58  ( 40  ) 41  { 123  } 125  [ 91  ] 93  , 44  ; 59
işlev op_emit(kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken b0: tam32 = bayt(kaynak, pos);
    değişken b1: tam32 = ikinci_bayt(kaynak, pos + 1, uz);
    değişken b2: tam32 = ikinci_bayt(kaynak, pos + 2, uz);
    eğer b0 == 43 {                                          // + +=
        eğer b1 == 61 { emit("ARTI_ESIT", satir, sutun, pos, 2); ver 2; }
        emit("ARTI", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 45 {                                          // - -= ->
        eğer b1 == 61 { emit("EKSI_ESIT", satir, sutun, pos, 2); ver 2; }
        eğer b1 == 62 { emit("OK", satir, sutun, pos, 2); ver 2; }
        emit("EKSI", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 42 {                                          // * *=
        eğer b1 == 61 { emit("YILDIZ_ESIT", satir, sutun, pos, 2); ver 2; }
        emit("YILDIZ", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 47 {                                          // / /= (// /* → M5)
        eğer b1 == 61 { emit("BOLU_ESIT", satir, sutun, pos, 2); ver 2; }
        emit("BOLU", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 37 {                                          // % %=
        eğer b1 == 61 { emit("MOD_ESIT", satir, sutun, pos, 2); ver 2; }
        emit("MOD", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 61 {                                          // = == =>
        eğer b1 == 61 { emit("ESIT_ESIT", satir, sutun, pos, 2); ver 2; }
        eğer b1 == 62 { emit("KALIN_OK", satir, sutun, pos, 2); ver 2; }
        emit("ESIT", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 33 {                                          // ! != (tek ! → HATALI)
        eğer b1 == 61 { emit("ESIT_DEGIL", satir, sutun, pos, 2); ver 2; }
        emit("HATALI", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 60 {                                          // < <= <<
        eğer b1 == 61 { emit("KUCUK_ESIT", satir, sutun, pos, 2); ver 2; }
        eğer b1 == 60 { emit("SOLA_KAYDIR", satir, sutun, pos, 2); ver 2; }
        emit("KUCUK", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 62 {                                          // > >= >> (generic'i parser böler)
        eğer b1 == 61 { emit("BUYUK_ESIT", satir, sutun, pos, 2); ver 2; }
        eğer b1 == 62 { emit("SAGA_KAYDIR", satir, sutun, pos, 2); ver 2; }
        emit("BUYUK", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 38 { emit("VE_BIT", satir, sutun, pos, 1); ver 1; }      // &
    eğer b0 == 124 { emit("VEYA_BIT", satir, sutun, pos, 1); ver 1; }   // |
    eğer b0 == 94 { emit("OZVEYA_BIT", satir, sutun, pos, 1); ver 1; }  // ^
    eğer b0 == 126 { emit("DEGIL_BIT", satir, sutun, pos, 1); ver 1; }  // ~
    eğer b0 == 46 {                                          // . .. ...
        eğer b1 == 46 {
            eğer b2 == 46 { emit("UC_NOKTA", satir, sutun, pos, 3); ver 3; }
            emit("ARALIK", satir, sutun, pos, 2); ver 2;
        }
        emit("NOKTA", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 58 {                                          // : ::
        eğer b1 == 58 { emit("CIFT_IKI_NOKTA", satir, sutun, pos, 2); ver 2; }
        emit("IKI_NOKTA", satir, sutun, pos, 1); ver 1;
    }
    eğer b0 == 40 { emit("SOL_PAREN", satir, sutun, pos, 1); ver 1; }       // (
    eğer b0 == 41 { emit("SAG_PAREN", satir, sutun, pos, 1); ver 1; }       // )
    eğer b0 == 123 { emit("SOL_SUSLU", satir, sutun, pos, 1); ver 1; }      // {
    eğer b0 == 125 { emit("SAG_SUSLU", satir, sutun, pos, 1); ver 1; }      // }
    eğer b0 == 91 { emit("SOL_KOSELI", satir, sutun, pos, 1); ver 1; }      // [
    eğer b0 == 93 { emit("SAG_KOSELI", satir, sutun, pos, 1); ver 1; }      // ]
    eğer b0 == 44 { emit("VIRGUL", satir, sutun, pos, 1); ver 1; }          // ,
    eğer b0 == 59 { emit("NOKTALI_VIRGUL", satir, sutun, pos, 1); ver 1; }  // ;
    emit("HATALI", satir, sutun, pos, 1); ver 1;            // default (L005)
}

// ---- M4: literaller (sayı / metin / karakter) ----

işlev hex_rakam_mi(b: tam32) -> mantıksal {                 // 0-9 a-f A-F
    ver rakam_mi(b) veya (b >= 97 ve b <= 102) veya (b >= 65 ve b <= 70);
}
// UTF-8 lider-bayttan karakter bayt-uzunluğu (utf8.c utf8_karakter_uzunlugu).
işlev utf8_uz(b: tam32) -> tam32 {
    eğer b < 128 { ver 1; }
    eğer (b >= 192) ve (b <= 223) { ver 2; }
    eğer (b >= 224) ve (b <= 239) { ver 3; }
    eğer (b >= 240) ve (b <= 247) { ver 4; }
    ver 0;
}

// Sayı token'ı emit (C sayi_oku birebir) → tüketilen bayt. TAMSAYI veya ONDALIK.
işlev sayi_emit(kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken p: tam32 = pos;
    değişken ondalik: tam32 = 0;
    eğer bayt(kaynak, p) == 48 {                             // '0' → prefix?
        değişken s: tam32 = ikinci_bayt(kaynak, p + 1, uz);
        eğer (s == 120) veya (s == 88) {                    // 0x 0X (erken return)
            p = p + 2;
            iken (p < uz) ve (hex_rakam_mi(bayt(kaynak, p)) veya (bayt(kaynak, p) == 95)) { p = p + 1; }
            emit("TAMSAYI", satir, sutun, pos, p - pos); ver p - pos;
        }
        eğer (s == 98) veya (s == 66) {                     // 0b 0B
            p = p + 2;
            iken (p < uz) ve ((bayt(kaynak, p) == 48) veya (bayt(kaynak, p) == 49) veya (bayt(kaynak, p) == 95)) { p = p + 1; }
            emit("TAMSAYI", satir, sutun, pos, p - pos); ver p - pos;
        }
        eğer (s == 111) veya (s == 79) {                    // 0o 0O
            p = p + 2;
            iken (p < uz) ve (((bayt(kaynak, p) >= 48) ve (bayt(kaynak, p) <= 55)) veya (bayt(kaynak, p) == 95)) { p = p + 1; }
            emit("TAMSAYI", satir, sutun, pos, p - pos); ver p - pos;
        }
    }
    iken (p < uz) ve (rakam_mi(bayt(kaynak, p)) veya (bayt(kaynak, p) == 95)) { p = p + 1; }  // ondalık gövde
    eğer (p < uz) ve (bayt(kaynak, p) == 46) {              // kesir: '.' && sonraki!='.'
        eğer ikinci_bayt(kaynak, p + 1, uz) != 46 {
            ondalik = 1;
            p = p + 1;
            iken (p < uz) ve (rakam_mi(bayt(kaynak, p)) veya (bayt(kaynak, p) == 95)) { p = p + 1; }
        }
    }
    eğer (p < uz) ve ((bayt(kaynak, p) == 101) veya (bayt(kaynak, p) == 69)) {  // üs: e/E
        ondalik = 1;
        p = p + 1;
        eğer (p < uz) ve ((bayt(kaynak, p) == 43) veya (bayt(kaynak, p) == 45)) { p = p + 1; }  // ±
        iken (p < uz) ve (rakam_mi(bayt(kaynak, p)) veya (bayt(kaynak, p) == 95)) { p = p + 1; }
    }
    eğer ondalik == 1 { emit("ONDALIK", satir, sutun, pos, p - pos); }
    değilse { emit("TAMSAYI", satir, sutun, pos, p - pos); }
    ver p - pos;
}

// Metin "..." emit (C metin_oku birebir) → tüketilen bayt. METIN veya HATALI(L001).
// NOT: ad `dize_emit` — codegen `metin_*` ön-ekini runtime intrinsic'e yönlendirir
// (llvm.c:2961), bu yüzden `metin_emit` adı KULLANILAMAZ (kdl_metin_emit çakışması).
işlev dize_emit(kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken p: tam32 = pos + 1;                            // açılış "
    değişken durum: tam32 = 0;                             // 0=devam 1=kapandı 2=newline
    iken (p < uz) ve (durum == 0) {
        değişken c: tam32 = bayt(kaynak, p);
        eğer c == 34 { durum = 1; }                        // kapanış "
        değilse {
            eğer c == 92 {                                 // \ → \ + 1 (escape ham)
                p = p + 1;
                eğer p < uz { p = p + 1; }
            } değilse {
                eğer c == 10 { durum = 2; }                // \n → L001
                değilse { p = p + 1; }
            }
        }
    }
    eğer durum == 1 { p = p + 1; emit("METIN", satir, sutun, pos, p - pos); ver p - pos; }
    emit("HATALI", satir, sutun, pos, p - pos); ver p - pos;  // newline veya EOF → L001
}

// Karakter '...' emit (C karakter_oku birebir) → tüketilen bayt. KARAKTER / HATALI(L009/L010).
işlev karakter_emit(kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken p: tam32 = pos + 1;                            // açılış '
    eğer (p >= uz) veya (bayt(kaynak, p) == 39) {           // boş/EOF → L009
        eğer p < uz { p = p + 1; }
        emit("HATALI", satir, sutun, pos, p - pos); ver p - pos;
    }
    eğer bayt(kaynak, p) == 92 {                            // \ escape (ham, +1)
        p = p + 1;
        eğer p < uz { p = p + 1; }
    } değilse {                                             // tek UTF-8 karakter
        değişken cl: tam32 = utf8_uz(bayt(kaynak, p));
        eğer cl == 0 { cl = 1; }
        değişken i: tam32 = 0;
        iken i < cl { eğer p < uz { p = p + 1; } i = i + 1; }
    }
    eğer (p >= uz) veya (bayt(kaynak, p) != 39) {           // kapanış ' yok → L010
        iken (p < uz) ve (bayt(kaynak, p) != 39) ve (bayt(kaynak, p) != 10) { p = p + 1; }
        eğer (p < uz) ve (bayt(kaynak, p) == 39) { p = p + 1; }
        emit("HATALI", satir, sutun, pos, p - pos); ver p - pos;
    }
    p = p + 1;                                              // kapanış '
    emit("KARAKTER", satir, sutun, pos, p - pos); ver p - pos;
}

// ---- M5: ham string (raw) ----

// pos 'r'da; r" veya r#...#" başlangıcı mı (C dispatch L294-301 birebir).
işlev ham_basi_mi(kaynak: metin, pos: tam32, uz: tam32) -> mantıksal {
    değişken s: tam32 = ikinci_bayt(kaynak, pos + 1, uz);
    eğer s == 34 { ver doğru; }                             // r"
    eğer s == 35 {                                          // r#...#"
        değişken b: tam32 = pos + 1;
        iken (b < uz) ve (bayt(kaynak, b) == 35) { b = b + 1; }
        eğer (b < uz) ve (bayt(kaynak, b) == 34) { ver doğru; }
    }
    ver yanlış;
}
// Ham string r#"..."# emit (C ham_metin_oku birebir) → tüketilen bayt.
// HAM_METIN / HATALI(L011 geçersiz baş, L002 kapanmamış). ÇOK-SATIRLI olabilir.
işlev ham_emit(kaynak: metin, pos: tam32, uz: tam32, satir: tam32, sutun: tam32) -> tam32 {
    değişken p: tam32 = pos + 1;                            // 'r' atla
    değişken hash_sayisi: tam32 = 0;
    iken (p < uz) ve (bayt(kaynak, p) == 35) { hash_sayisi = hash_sayisi + 1; p = p + 1; }
    eğer (p >= uz) veya (bayt(kaynak, p) != 34) {           // L011
        emit("HATALI", satir, sutun, pos, p - pos); ver p - pos;
    }
    p = p + 1;                                              // açılış "
    değişken bitti: tam32 = 0;
    iken (p < uz) ve (bitti == 0) {
        eğer bayt(kaynak, p) == 34 {                        // " → kapanış hash say
            p = p + 1;
            değişken kapanan: tam32 = 0;
            iken (p < uz) ve (bayt(kaynak, p) == 35) ve (kapanan < hash_sayisi) {
                kapanan = kapanan + 1; p = p + 1;
            }
            eğer kapanan == hash_sayisi { bitti = 1; }
        } değilse {
            p = p + 1;
        }
    }
    eğer bitti == 1 { emit("HAM_METIN", satir, sutun, pos, p - pos); ver p - pos; }
    emit("HATALI", satir, sutun, pos, p - pos); ver p - pos;  // L002 EOF
}

işlev lex_dosya(kaynak: metin) -> tam32 {
    değişken uz: tam32 = metin_uzunluk(kaynak);
    değişken pos: tam32 = 0;
    değişken satir: tam32 = 1;
    değişken sutun: tam32 = 1;
    iken doğru {
        // boşluk + yorum atla (C bosluk_atla birebir: WS + // + /* iç içe)
        değişken trivia: mantıksal = doğru;
        iken trivia {
            eğer (pos < uz) ve bosluk_mu(bayt(kaynak, pos)) {
                eğer bayt(kaynak, pos) == 10 { satir = satir + 1; sutun = 1; }
                değilse { sutun = sutun + 1; }
                pos = pos + 1;
            } değilse {
                eğer (pos < uz) ve (bayt(kaynak, pos) == 47) ve (ikinci_bayt(kaynak, pos + 1, uz) == 47) {
                    pos = pos + 2; sutun = sutun + 2;        // // satır yorumu (\n tüketme)
                    iken (pos < uz) ve (bayt(kaynak, pos) != 10) { pos = pos + 1; sutun = sutun + 1; }
                } değilse {
                    eğer (pos < uz) ve (bayt(kaynak, pos) == 47) ve (ikinci_bayt(kaynak, pos + 1, uz) == 42) {
                        pos = pos + 2; sutun = sutun + 2;    // /* iç içe blok yorum
                        değişken derinlik: tam32 = 1;
                        iken (pos < uz) ve (derinlik > 0) {
                            eğer (bayt(kaynak, pos) == 47) ve (ikinci_bayt(kaynak, pos + 1, uz) == 42) {
                                pos = pos + 2; sutun = sutun + 2; derinlik = derinlik + 1;
                            } değilse {
                                eğer (bayt(kaynak, pos) == 42) ve (ikinci_bayt(kaynak, pos + 1, uz) == 47) {
                                    pos = pos + 2; sutun = sutun + 2; derinlik = derinlik - 1;
                                } değilse {
                                    eğer bayt(kaynak, pos) == 10 { satir = satir + 1; sutun = 1; }
                                    değilse { sutun = sutun + 1; }
                                    pos = pos + 1;
                                }
                            }
                        }
                    } değilse {
                        trivia = yanlış;                     // trivia bitti
                    }
                }
            }
        }
        eğer pos >= uz { emit("DOSYA_SONU", satir, sutun, pos, 0); ver 0; }

        değişken tb: tam32 = bayt(kaynak, pos);
        değişken t_off: tam32 = pos;
        değişken t_sat: tam32 = satir;
        değişken t_sut: tam32 = sutun;

        eğer rakam_mi(tb) {                                 // TAMSAYI / ONDALIK (M4)
            değişken slen: tam32 = sayi_emit(kaynak, pos, uz, t_sat, t_sut);
            pos = pos + slen; sutun = sutun + slen;
        } değilse {
            değişken bu: tam32 = kimlik_basi_uz(kaynak, pos, uz);
            eğer bu > 0 {                                  // IDENT / anahtar / ham string
                eğer (tb == 114) ve ham_basi_mi(kaynak, pos, uz) {  // r" veya r#...#" (M5)
                    değişken hlen: tam32 = ham_emit(kaynak, pos, uz, t_sat, t_sut);
                    değişken k: tam32 = 0;                 // ÇOK-SATIRLI → satir/sutun re-scan
                    iken k < hlen {
                        eğer bayt(kaynak, pos + k) == 10 { satir = satir + 1; sutun = 1; }
                        değilse { sutun = sutun + 1; }
                        k = k + 1;
                    }
                    pos = pos + hlen;
                } değilse {                                // IDENT / anahtar (UTF-8)
                    pos = pos + bu; sutun = sutun + bu;
                    değişken devam: mantıksal = doğru;
                    iken devam {
                        değişken du: tam32 = kimlik_devam_uz(kaynak, pos, uz);
                        eğer du == 0 { devam = yanlış; }
                        değilse { pos = pos + du; sutun = sutun + du; }
                    }
                    değişken w: metin = metin_kes(kaynak, t_off, pos - t_off);
                    emit(anahtar_tip(w), t_sat, t_sut, t_off, pos - t_off);
                }
            } değilse {
                eğer tb == 34 {                            // "  → METIN (M4)
                    değişken mlen: tam32 = dize_emit(kaynak, pos, uz, t_sat, t_sut);
                    pos = pos + mlen; sutun = sutun + mlen;
                } değilse {
                    eğer tb == 39 {                        // '  → KARAKTER (M4)
                        değişken klen: tam32 = karakter_emit(kaynak, pos, uz, t_sat, t_sut);
                        pos = pos + klen; sutun = sutun + klen;
                    } değilse {                            // operatör/noktalama (maximal munch)
                        değişken olen: tam32 = op_emit(kaynak, pos, uz, t_sat, t_sut);
                        pos = pos + olen; sutun = sutun + olen;
                    }
                }
            }
        }
    }
    ver 0;
}

işlev main() -> tam32 {
    eğer arg_sayi() < 2 {
        yaz_str("kullanim: kemgu_lexer <kaynak.kem>"); yb(10);
        ver 1;
    }
    değişken yol: metin = arg_al(1);
    değişken kaynak: metin = dosya_oku(yol);
    eğer metin_uzunluk(kaynak) == 0 { lex_dosya(""); ver 0; }
    lex_dosya(kaynak);
    ver 0;
}
