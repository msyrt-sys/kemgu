// kem_mmu.kem — FAZ-A1 (D-276): SAF-.kem MMU/fault entegrasyonu.
// ============================================================================
// ALT-HEDEF A: [5] EXC'i GERÇEK vektör-bağlı fault yap (mevcut C-MMU + .S recovery).
//   Sentetik self-test (kem_istisna_isle, hardcoded ESR/FAR) KALIR — ESR-decode
//   mantığını doğrular. Buna EK: gerçek data-abort → FAR → recovery kanıtı.
//
// SAF-.kem primitifleri (hepsi kanıtlı — D-269 P1 + çıplak-tier + inline-asm):
//   • Gerçek fault: 0x80000000 HARİTASIZ (C-MMU L1[2..511]=0 → level-1 çeviri-fault).
//     Volatile oku → data-abort → .S kdl_exc_ortak: FAR→kdl_fault_yakalanan, bayrağı
//     temizle, ELR+=4 (faulting ldr'yi ATLA), frame restore, eret → OS DEVAM.
//     Taklit edilemez (MMU zorlamıyorsa 0x80000000 okuması sessizce geçer → gate kırmızı).
//   • Recovery-scratch (kdl_fault_bekleniyor / kdl_fault_yakalanan): .S kdl_exc_ortak
//     ile EŞLEŞİK 2 global. C-tanımlı KALIR (.S substrat'ı ile birlikte) — .kem 'küresel'
//     internal-linkage olduğundan .S'ye açılamaz (codegen-gap; bkz. D-276 sınır-notu).
//     .kem bunlara INLINE-ASM (adrp/add + ldr/str) ile erişir → pure-.kem raw-mem
//     primitifi. ~{memory} clobber = C `volatile` semantiğinin asm karşılığı (store'ları
//     fault'tan önce görünür kılar + fault sonrası zorla-reload; clang const-fold etmez).
//   • Build'de kem_os.kem ile CAT edilir (tek birim → çıplak→çıplak, T002 YOK).

// Haritasız test VA (0x80000000 = 2147483648): C-MMU L1[2..511]=0 → level-1 çeviri-fault.
sabit KMMU_FAULT_VA: tam64 = 2147483648;

// --- Recovery-scratch erişimi: C-global'lere inline-asm (adrp/add + ldr/str). x9=scratch. ---
çıplak işlev kmmu_bekle_yaz(v: tam64) {
    güvensiz {
        satıriçi_asm {
            mimari: arm64
            şablon: r#"adrp x9, kdl_fault_bekleniyor
add x9, x9, :lo12:kdl_fault_bekleniyor
str $0, [x9]"#
            girdi("r", v)
            bozulan("~{x9}") bozulan("~{memory}")
        }
    }
}
çıplak işlev kmmu_yakala_yaz(v: tam64) {
    güvensiz {
        satıriçi_asm {
            mimari: arm64
            şablon: r#"adrp x9, kdl_fault_yakalanan
add x9, x9, :lo12:kdl_fault_yakalanan
str $0, [x9]"#
            girdi("r", v)
            bozulan("~{x9}") bozulan("~{memory}")
        }
    }
}
çıplak işlev kmmu_bekle_oku() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz {
        satıriçi_asm {
            mimari: arm64
            şablon: r#"adrp x9, kdl_fault_bekleniyor
add x9, x9, :lo12:kdl_fault_bekleniyor
ldr $0, [x9]"#
            çıktı("=r", &x)
            bozulan("~{x9}") bozulan("~{memory}")
        }
    }
    ver x;
}
çıplak işlev kmmu_yakala_oku() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz {
        satıriçi_asm {
            mimari: arm64
            şablon: r#"adrp x9, kdl_fault_yakalanan
add x9, x9, :lo12:kdl_fault_yakalanan
ldr $0, [x9]"#
            çıktı("=r", &x)
            bozulan("~{x9}") bozulan("~{memory}")
        }
    }
    ver x;
}

// Haritasız VA'yı volatile oku → GERÇEK data-abort (tek ldr; .S ELR+=4 ile atlar).
// Dönen değer ÇÖP (fault sırasında yakalanır) — çağıran atar.
çıplak işlev kmmu_oku_faulting(adr: tam64) -> tam64 {
    değişken p: *tam64 = adr olarak *tam64;
    ver *p;
}

// A2 (D-278): GERÇEK syndrome oku — mrs ESR_EL1 / FAR_EL1. Trap SONRASI (eret sonrası)
// bu register'lar bir-sonraki istisnaya dek fault değerlerini TUTAR (ARMv8: yalnız istisna
// girişinde yazılır). .S kdl_exc_ortak yalnız OKUR (mrs) → değiştirmez → post-recovery geçerli.
çıplak işlev kmmu_esr_oku() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: arm64 şablon: r#"mrs $0, esr_el1"# çıktı("=r", &x) } }
    ver x;
}
çıplak işlev kmmu_far_mrs() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: arm64 şablon: r#"mrs $0, far_el1"# çıktı("=r", &x) } }
    ver x;
}

// ============================================================================
// ALT-HEDEF B (D-277): kdl_mmu_kur SAF-.kem — page-table setup + non-identity çeviri.
//   Kanıtlı-C kdl_mmu.c'nin BİREBİR yeniden gerçekleştirmesi (descriptor bit'leri +
//   MAIR/TCR/TTBR0 aynı). .S boot `bl kdl_mmu_kur` artık .kem'i çağırır (C guard'lı).
//   EK: bir non-identity çeviri (VA 0x50000000 → PA 0x46000000) → çeviri gate.
//   Çıplak (region-prologue YOK — boot'ta pre-main, heap/region henüz yok); yalnız
//   SABİT-adres store + MSR. MMU OFF iken tabloları yaz → MSR sctlr ile MMU ON.

sabit KMMU_L1: tam64 = 1157627904;         // 0x45000000 (4KB-hizalı, free RAM)
sabit KMMU_L2: tam64 = 1157632000;         // 0x45001000
sabit KMMU_CEVIRI_VA: tam64 = 1342177280;  // 0x50000000 (non-identity kaynak)
sabit KMMU_CEVIRI_PA: tam64 = 1174405120;  // 0x46000000 (backed RAM hedef, free)
sabit KMMU_RAM: tam64 = 1073741824;        // 0x40000000
sabit KMMU_2MB: tam64 = 2097152;           // 0x200000
// AH-3a: kdl_mmu_kur'un GERÇEKTEN haritaladığı 2MB blok sayısı. Sabit değil,
// DTB'den türetilir; buraya yazılır ki kapı ölçebilsin (aynı ikili farklı
// bellek boyutlarında farklı sayı bildirmeli — sabit kod bunu yapamaz).
sabit KMMU_BLOK_SLOT: tam64 = 1157640272;  // 0x45003050

çıplak işlev kmmu_y64(adr: tam64, deger: tam64) { değişken p: *tam64 = adr olarak *tam64; *p = deger; }
çıplak işlev kmmu_o64(adr: tam64) -> tam64 { değişken p: *tam64 = adr olarak *tam64; ver *p; }

// SAF-.kem MMU kurulumu — .S boot'tan çağrılır. Descriptor'lar kdl_mmu.c birebir:
//   Device blok=0x401(1025), Normal-2MB blok=pa|0x705(+1797), tablo=l2|0x3(+3).
çıplak işlev kdl_mmu_kur() {
    // AH-3a: haritalanacak RAM miktarı artık DEVICE-TREE'den. Eskiden koşulsuz
    // 512 blok (1 GiB) haritalanıyordu — RAM'i olmayan adresler de "geçerli"
    // görünüyordu ve oraya erişim çeviri hatası yerine SENKRON HARİCİ ABORT
    // veriyordu (MB-1a'da tam bu yaşandı: 0x48000000, RAM tavanının bir baytı
    // ötesi). Var olmayan belleği haritalamak, hatayı geç ve yanlış yerde
    // gösterir. Artık yalnız GERÇEKTEN var olan RAM haritalanır.
    //
    // DTB yoksa/bozuksa eski davranışa düşülür (1 GiB) — gerileme değil, aynı
    // yer. Bu bilinçli: keşif başarısızsa çekirdek yine boot etmeli.
    //
    // SINIR (v1): RAM'in L1[1] penceresinde (0x40000000..0x80000000) olduğu
    // varsayımı SÜRÜYOR; yalnız BOYUT keşiften geliyor. RAM'i 0x0'da başlayan
    // kartlar (Raspberry Pi) L1[0] gerektirir — AH-4'ün işi.
    değişken dtb: tam64 = kdtb_adres();
    değişken rboy: tam64 = 512 * KMMU_2MB;                            // yedek: 1 GiB
    eğer kdtb_gecerli_mi(dtb) == 1 {
        değişken rb: tam64 = kdtb_ram_tabani(dtb);
        değişken rn: tam64 = kdtb_ram_boyutu(dtb);
        // Yalnız BEKLENEN pencereye oturan ve makul boyutlu bir keşif kabul
        // edilir; aksi halde yedek. Saçma bir DTB yüzünden boot'u kaybetmeyiz.
        eğer (rb == KMMU_RAM) ve (rn >= 33554432) { rboy = rn; }
    }
    değişken blok: tam64 = rboy / KMMU_2MB;
    eğer blok > 512 { blok = 512; }                                   // tek L2 = 1 GiB tavan
    kmmu_y64(KMMU_BLOK_SLOT, blok);                                   // teşhis/kapı için

    değişken i: tam64 = 0;
    iken i < 512 { kmmu_y64(KMMU_L1 + i * 8, 0); i = i + 1; }        // L1 sıfırla
    değişken n: tam64 = 0;
    iken n < 512 {
        eğer n < blok {                                               // GERÇEK RAM → identity
            değişken pa: tam64 = KMMU_RAM + n * KMMU_2MB;
            kmmu_y64(KMMU_L2 + n * 8, pa + 1797);                    // |0x705
        } değilse {
            kmmu_y64(KMMU_L2 + n * 8, 0);                            // RAM YOK → haritasız
        }
        n = n + 1;
    }
    değişken idx: tam64 = (KMMU_CEVIRI_VA - KMMU_RAM) / KMMU_2MB;     // 128: non-identity override
    kmmu_y64(KMMU_L2 + idx * 8, KMMU_CEVIRI_PA + 1797);              // VA 0x50000000 → PA 0x46000000
    // A5 (D-281): EL0 user page — 0x42000000 (L2[16]) AP=01 (EL0+EL1 RW, UXN=0 EL0-exec).
    // desc = pa | 0x745 (0x705 Normal + bit6 AP=01). EL0 stub + user yığını burada.
    kmmu_y64(KMMU_L2 + 16 * 8, 1107296256 + 1861);                  // 0x42000000 | 0x745
    // MB-4: blok 0'ı (çekirdek imajı) 4KB sayfalara böl ve W^X uygula.
    // [0x40000000, __text_end)          → EL1 RO + ÇALIŞTIRILABİLİR
    // [__text_end, __rodata_sayfa_sonu) → EL1 RO + çalıştırılamaz
    // gerisi (data/bss/yığın/heap başı)  → EL1 RW + çalıştırılamaz
    // Sınırlar linker'da 4KB'a hizalı (bkz. bare-metal-aarch64.ld) — hizalı
    // olmasalardı .text ile .rodata aynı sayfayı paylaşır, ayrım anlamını
    // yitirirdi. MMU HENÜZ KAPALI: tablolar düz yazma ile kuruluyor.
    değişken tson: tam64 = kmmu_text_son();
    değişken rson: tam64 = kmmu_rodata_son();
    değişken s: tam64 = 0;
    iken s < KMMU_SAYFA_SAYI {
        değişken va: tam64 = KMMU_RAM + s * KMMU_SAYFA;
        değişken tan: tam64 = KMMU_K_VERI;
        eğer va < tson {
            tan = KMMU_K_KOD;
        } değilse {
            eğer va < rson { tan = KMMU_K_ROD; }
        }
        kmmu_y64(KMMU_K_L3 + s * 8, va + tan);
        s = s + 1;
    }
    kmmu_y64(KMMU_L2, KMMU_K_L3 + 3);                               // L2[0] → çekirdek L3
    kmmu_y64(KMMU_L1, 1025);                                         // L1[0] Device (0x401)
    kmmu_y64(KMMU_L1 + 8, KMMU_L2 + 3);                             // L1[1] → L2 tablo (0x3)
    değişken mair: tam64 = 65280;                                    // 0xFF00
    değişken tcr: tam64 = 4303369497;                              // 0x100803519
    değişken sbit: tam64 = 4101;                                   // 0x1005 (SCTLR M|C|I)
    güvensiz {
        satıriçi_asm {
            mimari: arm64
            şablon: r#"msr mair_el1, $0
msr tcr_el1, $1
msr ttbr0_el1, $2
dsb ish
tlbi vmalle1
dsb ish
isb
mrs x9, sctlr_el1
orr x9, x9, $3
msr sctlr_el1, x9
isb"#
            girdi("r", mair) girdi("r", tcr) girdi("r", KMMU_L1) girdi("r", sbit)
            bozulan("~{x9}") bozulan("~{memory}")
        }
    }
}

// ÇEVİRİ gate: VA 0x50000000 ↔ PA 0x46000000 ALIAS doğrula (çift-yönlü, volatile).
// 1 = non-identity çeviri donanımda çalışıyor (identity olsaydı VA→PA 0x50000000
// backed-değil, alias olmazdı). Taklit edilemez: iki farklı VA aynı PA'yı görüyor.
çıplak işlev kmmu_ceviri_testi() -> tam32 {
    kmmu_y64(KMMU_CEVIRI_PA, 3735928559);            // 0xDEADBEEF → identity VA (=PA)
    değişken a: tam64 = kmmu_o64(KMMU_CEVIRI_VA);     // non-identity VA'dan oku → alias mı?
    kmmu_y64(KMMU_CEVIRI_VA, 3405691582);            // 0xCAFEBABE → non-identity VA (ters yön)
    değişken b: tam64 = kmmu_o64(KMMU_CEVIRI_PA);     // identity VA'dan oku → alias mı?
    eğer a == 3735928559 ve b == 3405691582 {
        ver 1;
    }
    ver 0;
}

// ============================================================================
// MODEL B / MB-1a: SÜREÇ BAŞINA ADRES ALANI (per-process TTBR0).
// ----------------------------------------------------------------------------
// Bugüne kadar (Model A) kem_os TEK adres alanı kullanıyordu: tüm görevler aynı
// L1/L2'yi paylaşıyordu (kem_gorev.kem: "TTBR swap YOK (v1)"). EL0/EL1 ayrımı
// vardı ama SÜREÇLER BİRBİRİNDEN YALITIK DEĞİLDİ — iki EL0 süreci aynı sanal
// adreste aynı fiziksel baytı görüyordu. "Kullanılabilir OS" eşiğinin altındaki
// asıl eksik buydu.
//
// TASARIM: her adres alanı KENDİ L1+L2 çiftine sahip. L2, çekirdek L2'sinin
// TAM KOPYASI (512 giriş) — yani tüm çekirdek RAM'i her adres alanında AYNI
// identity eşlemeyle görünür. Bu ZORUNLU: TTBR0 düşük VA'ları kapsar ve
// çekirdek de düşük VA'da koşar (TTBR1/high-half yok); kopyalamazsak TTBR
// yazan komutun BİR SONRAKİ komutu haritasız kalır ve çekirdek ölür.
// TEK fark: KMMU_OZEL_VA girişi her alanda BAŞKA bir fiziksel sayfaya bakar.
//
// SINIR (MB-1a): özel sayfa VERİ sayfasıdır; EL0 KOD sayfası (L2[16]) hâlâ
// paylaşılır. Süreç başına KOD eşlemesi ELF yükleyicinin (MB-2) işidir.
sabit KMMU_AS_TABAN: tam64 = 1157660672;    // 0x45010000: adres-alanı tablo arenası
sabit KMMU_AS_ADIM: tam64 = 12288;          // 0x3000: her alan = L1 + L2 + L3 (3×4KB)
// AH-1'DE ÖLÇÜLEREK TAŞINDI (0x44000000 → 0x54000000). Ham imajla boot edilince
// QEMU device-tree'yi TAM 0x44000000'a koyuyor — yani süreç-özel eşleme gerçek
// DTB'yi GÖLGELİYORDU; çekirdek kendi keşif verisini okuyamıyordu. Bu bir tesadüf
// değil sınıfsal bir hata: süreç-özel SANAL adres, gerçek RAM'i gölgelememeli.
// 0x54000000 identity penceresi (0x40000000..0x80000000) içinde ama 128 MiB RAM
// tavanının ÜSTÜNDE → hiçbir firmware yapısıyla çakışamaz; L2 girişi zaten
// süreç sayfasına yönlendirildiği için arkasında RAM olmaması sorun değil.
sabit KMMU_OZEL_VA: tam64 = 1409286144;     // 0x54000000: süreç-özel VA (L2[160])
sabit KMMU_OZEL_IDX: tam64 = 160;           // (0x54000000 - 0x40000000) / 2MB
// ÖLÇÜLDÜ (ampirik, ilk denemede 0x48000000 seçilmişti): QEMU `-M virt` komut
// satırında `-m` YOK → varsayılan RAM 128 MiB → fiziksel RAM 0x40000000..0x48000000.
// 0x48000000 tam bir bayt DIŞARIDA: yazma ESR=0x96000050 (DFSC=0b010000 = senkron
// HARİCİ abort — "çeviri oldu, fiziksel adres yok") verdi. Çeviri hatası DEĞİL;
// tablolar doğruydu, hedef RAM yoktu. Özel sayfalar RAM tavanının ALTINDA olmalı.
// Yığınlar 0x47100000/0x47200000 (2MB blok 56-57) → 58'den itibaren boş, 63'e kadar.
sabit KMMU_OZEL_PA: tam64 = 1195376640;     // 0x47400000: özel sayfa PA tabanı (blok 58)
sabit KMMU_AS_AZAMI: tam64 = 6;             // blok 58..63 → en çok 6 adres alanı

// --- MB-3: 4KB SAYFA GRANÜLÜ (L3) + W^X ---------------------------------
// Süreç-özel bölge artık TEK 2MB blok değil, 512×4KB SAYFA. Sebep: W^X izinleri
// segment başına verilebilsin. 2MB blokta kod ve veri aynı tanımlayıcıyı
// paylaştığı için sayfa zorunlu olarak hem YAZILABİLİR hem ÇALIŞTIRILABİLİRDİ —
// klasik W^X ihlali: yüklenen bir program kendi kodunu değiştirebilir, ya da
// veri olarak yazdığı baytları çalıştırabilirdi.
//
// Tanımlayıcı bitleri (ARMv8-A, 4KB granül, L3 sayfa):
//   bit[1:0]=0b11 sayfa | bit[4:2]=AttrIdx(1=Normal, MAIR 0xFF00) | bit[9:8]=0b11 iç-paylaşım
//   bit10=AF(erişim bayrağı) | bit[7:6]=AP | bit53=PXN | bit54=UXN
//   Taban = 0x400(AF) + 0x300(SH) + 0x4(AttrIdx=1) + 0x3(sayfa) = 0x707
//   AP=01 (0x40): EL1 RW + EL0 RW   |  AP=11 (0xC0): EL1 RO + EL0 RO
sabit KMMU_S_VERI: tam64 = 27021597764224839;
//   = 0x747 (taban+AP01) + (1<<53 PXN) + (1<<54 UXN)  → EL0 RW, ÇALIŞTIRILAMAZ
sabit KMMU_S_KOD: tam64 = 9007199254742983;
//   = 0x7C7 (taban+AP11) + (1<<53 PXN)                 → EL0 RO+X, YAZILAMAZ
//   PXN her ikisinde de SET: çekirdek kullanıcı sayfalarından KOMUT GETİRMEZ.
//   Yükleyici kod sayfasına çekirdeğin IDENTITY görüşünden yazar (başka VA) —
//   bu yüzden AP=11 (EL1 RO) yükleme yolunu engellemez.
sabit KMMU_SAYFA: tam64 = 4096;
sabit KMMU_SAYFA_SAYI: tam64 = 512;         // 2MB / 4KB

// --- MB-4: ÇEKİRDEĞİN KENDİ SAYFALARINA W^X --------------------------------
// MB-3 kullanıcı tarafını sertleştirdi ama çekirdek hâlâ 2MB blok + AP=00 idi:
// EL1 için RWX. Yani çekirdek KENDİ KODUNU yazabiliyordu. Kullanıcı tarafını
// kapatıp çekirdeği açık bırakmak, saldırı yüzeyini taşımaktan ibaret olurdu.
//
// Çekirdek imajı ölçüldü: .text 0x40000000..~0x4000c000, .rodata, .data/.bss,
// 16KB yığın ve heap başlangıcı — HEPSİ blok 0 (0x40000000..0x40200000) içinde.
// Bu yüzden yalnız blok 0 için L3 kurulur; kalan 511 blok 2MB olarak kalır
// (heap 0x4100f9d0'a kadar uzanıyor — orası zaten veri, kod yok).
//
// EL1 izinleri (EL0'ın hiçbirine erişimi yok — AP=00/10 ikisi de EL0'a kapalı):
//   AP=00 (0x00) EL1 RW  |  AP=10 (0x80) EL1 RO
//   Taban 0x707 = AF + iç-paylaşım + AttrIdx1 + sayfa
// 0x45030000: çekirdek blok-0 L3 tablosu. Adres-alanı arenası 0x45010000..
// 0x45022000'i kaplıyor (6 × 12KB) → çakışmayı önlemek için 0x45030000.
sabit KMMU_K_L3: tam64 = 1157824512;
sabit KMMU_K_KOD: tam64 = 18014398509483911;
//   = 0x787 (taban+AP10) + (1<<54 UXN)            → EL1 RO + ÇALIŞTIRILABİLİR
sabit KMMU_K_ROD: tam64 = 27021597764224903;
//   = 0x787 + (1<<54 UXN) + (1<<53 PXN)           → EL1 RO, çalıştırılamaz
sabit KMMU_K_VERI: tam64 = 27021597764224775;
//   = 0x707 (taban+AP00) + UXN + PXN              → EL1 RW, çalıştırılamaz

// Linker sembolleri inline-asm ile okunur (.kem `küresel` internal-linkage
// olduğu için bunlar C/linker tarafında tanımlı kalır — D-276 deseni).
çıplak işlev kmmu_text_son() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: arm64 şablon: r#"adrp $0, __text_end
add $0, $0, :lo12:__text_end"# çıktı("=r", &x) } }
    ver x;
}
çıplak işlev kmmu_rodata_son() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: arm64 şablon: r#"adrp $0, __rodata_sayfa_sonu
add $0, $0, :lo12:__rodata_sayfa_sonu"# çıktı("=r", &x) } }
    ver x;
}

// Adres alanı #i'yi kur; L1 fiziksel adresini döner (TTBR0'a yazılacak değer).
// i >= KMMU_AS_AZAMI ise 0 döner (SESSİZ TAŞMA YOK — çağıran 0'ı görür).
çıplak işlev kmmu_as_olustur(i: tam64) -> tam64 {
    eğer (i < 0) veya (i >= KMMU_AS_AZAMI) { ver 0; }
    değişken l1: tam64 = KMMU_AS_TABAN + i * KMMU_AS_ADIM;
    değişken l2: tam64 = l1 + 4096;
    değişken k: tam64 = 0;
    iken k < 512 { kmmu_y64(l1 + k * 8, 0); k = k + 1; }          // L1 sıfırla
    değişken n: tam64 = 0;
    iken n < 512 {                                                 // L2 = çekirdek L2 KOPYASI
        kmmu_y64(l2 + n * 8, kmmu_o64(KMMU_L2 + n * 8));
        n = n + 1;
    }
    // TEK FARK: özel VA artık 2MB BLOK değil, kendi L3 TABLOSU (512×4KB sayfa).
    // Sayfalar VARSAYILAN OLARAK VERİ (RW + çalıştırılamaz) — en kısıtlı makul
    // başlangıç. Kod izni yalnızca ELF yükleyicisinin AÇIKÇA verdiği sayfalara
    // konur (kmmu_sayfa_kod). Ters sıra (varsayılan çalıştırılabilir) seçilseydi,
    // izin atamayı unutan her yol sessizce W^X'i devre dışı bırakırdı.
    değişken l3: tam64 = l1 + 8192;
    değişken pa: tam64 = KMMU_OZEL_PA + i * KMMU_2MB;
    değişken s: tam64 = 0;
    iken s < KMMU_SAYFA_SAYI {
        kmmu_y64(l3 + s * 8, (pa + s * KMMU_SAYFA) + KMMU_S_VERI);
        s = s + 1;
    }
    kmmu_y64(l2 + KMMU_OZEL_IDX * 8, l3 + 3);                      // L2[32] → L3 tablosu
    kmmu_y64(l1, 1025);                                            // L1[0] Device (0x401)
    kmmu_y64(l1 + 8, l2 + 3);                                      // L1[1] → kendi L2'si
    ver l1;
}

// Adres alanı #i'de, özel bölgenin `sayfa` numaralı 4KB sayfasını KOD yap
// (EL0 için salt-okunur + çalıştırılabilir). Aralık dışı → 0 (sessiz yok sayma
// YOK: çağıran kaç sayfanın işaretlendiğini sayabilir).
çıplak işlev kmmu_sayfa_kod(i: tam64, sayfa: tam64) -> tam32 {
    eğer (i < 0) veya (i >= KMMU_AS_AZAMI) { ver 0; }
    eğer (sayfa < 0) veya (sayfa >= KMMU_SAYFA_SAYI) { ver 0; }
    değişken l3: tam64 = KMMU_AS_TABAN + i * KMMU_AS_ADIM + 8192;
    değişken pa: tam64 = KMMU_OZEL_PA + i * KMMU_2MB + sayfa * KMMU_SAYFA;
    kmmu_y64(l3 + sayfa * 8, pa + KMMU_S_KOD);
    ver 1;
}

// TTBR0'ı değiştir + TLB'yi tamamen geçersiz kıl. dsb/isb sıralaması ŞART:
// isb olmadan sonraki komutlar ESKİ çeviriyle getirilmiş olabilir.
// ASID kullanılmıyor (v1) → tam TLB flush; doğru ama pahalı.
çıplak işlev kmmu_ttbr_yaz(l1: tam64) {
    güvensiz {
        satıriçi_asm {
            mimari: arm64
            şablon: r#"msr ttbr0_el1, $0
dsb ish
tlbi vmalle1
dsb ish
isb"#
            girdi("r", l1)
            bozulan("~{memory}")
        }
    }
}

// İZOLASYON KANITI (falsifiye edilebilir): iki adres alanı, AYNI sanal adres,
// FARKLI fiziksel sayfa. A'ya yaz → B'ye yaz → A'ya DÖN → A'nın değeri DURUYOR mu?
//
// Tek adres alanında bu TAKLİT EDİLEMEZ: B'nin yazması A'nınkini ezerdi ve
// son okuma 0xBB verirdi. Ayrıca çekirdeğin identity görüşünden iki fiziksel
// sayfa BAĞIMSIZ olarak doğrulanır — yani "değeri bir yerde sakladık" türü bir
// sahtelik de elenir. 1 = süreç izolasyonu donanımda GERÇEK.
çıplak işlev kmmu_izolasyon_testi() -> tam32 {
    değişken a: tam64 = kmmu_as_olustur(0);
    değişken b: tam64 = kmmu_as_olustur(1);
    eğer (a == 0) veya (b == 0) { ver 0; }

    kmmu_ttbr_yaz(a);
    kmmu_y64(KMMU_OZEL_VA, 2863311530);              // 0xAAAAAAAA → A'nın sayfası
    kmmu_ttbr_yaz(b);
    kmmu_y64(KMMU_OZEL_VA, 3149642683);              // 0xBBBBBBBB → B'nin sayfası
    değişken bv: tam64 = kmmu_o64(KMMU_OZEL_VA);     // B kendi değerini görmeli
    kmmu_ttbr_yaz(a);
    değişken av: tam64 = kmmu_o64(KMMU_OZEL_VA);     // ASIL KANIT: A'nınki DURUYOR mu?

    kmmu_ttbr_yaz(KMMU_L1);                          // çekirdek alanına dön
    // Bağımsız doğrulama: çekirdeğin identity görüşünden iki AYRI fiziksel sayfa.
    değişken pa: tam64 = kmmu_o64(KMMU_OZEL_PA);
    değişken pb: tam64 = kmmu_o64(KMMU_OZEL_PA + KMMU_2MB);

    eğer (av == 2863311530) ve (bv == 3149642683)
       ve (pa == 2863311530) ve (pb == 3149642683) {
        ver 1;
    }
    ver 0;
}

// Haritalı ama SALT-OKUNUR bir adrese volatile YAZ → izin fault'u (tek str;
// .S recovery ELR+=4 ile atlar). kmmu_oku_faulting'in yazma ikizi.
çıplak işlev kmmu_yaz_faulting(adr: tam64, v: tam64) {
    değişken p: *tam64 = adr olarak *tam64;
    *p = v;
}

// ÇEKİRDEK W^X kapısı: çekirdek KENDİ .text'ine yazmayı dener → izin fault'u.
// Taklit edilemez: .text yazılabilir olsaydı store SESSİZCE başarılı olur,
// fault hiç oluşmaz, bayrak temizlenmez → 0. Ayrıca yazılan değerin GERÇEKTEN
// yazılmadığı da doğrulanır (kod baytı değişmemeli) — "fault oldu ama yazma da
// geçti" gibi bir ara durum elenmiş olur.
çıplak işlev kmmu_kernel_wx_testi() -> tam32 {
    değişken hedef: tam64 = KMMU_RAM;             // 0x40000000 = _start (.text)
    değişken once: tam64 = kmmu_o64(hedef);       // okuma SERBEST (RO)
    kmmu_yakala_yaz(0);
    kmmu_bekle_yaz(1);                            // .S recovery iste
    kmmu_yaz_faulting(hedef, 3735928559);         // 0xDEADBEEF → izin fault'u
    değişken bekle: tam64 = kmmu_bekle_oku();     // 0 = .S kurtardı
    değişken far: tam64 = kmmu_yakala_oku();
    değişken sonra: tam64 = kmmu_o64(hedef);      // kod DEĞİŞMEMİŞ olmalı
    eğer (bekle == 0) ve (far == hedef) ve (sonra == once) {
        ver 1;
    }
    ver 0;
}

// GERÇEK fault-gate: haritasız VA oku → .S recovery → FAR doğru + kurtarıldı mı?
// 1 = MMU zorluyor + gerçek fault yakalandı + FAR==VA + OS devam ediyor. Sentetik DEĞİL.
çıplak işlev kmmu_fault_testi() -> tam32 {
    kmmu_yakala_yaz(0);                                        // FAR sonucu temizle
    kmmu_bekle_yaz(1);                                         // .S recovery iste (yoksa halt)
    değişken cop: tam64 = kmmu_oku_faulting(KMMU_FAULT_VA);    // GERÇEK fault → .S recovery
    değişken bekle: tam64 = kmmu_bekle_oku();                  // .S temizledi mi? (0 = kurtarıldı)
    değişken far: tam64 = kmmu_yakala_oku();                   // yakalanan FAR
    eğer bekle == 0 ve far == KMMU_FAULT_VA {
        ver 1;
    }
    ver 0;
}

// ============================================================================
// ZERO-C B1 (D-283): SAF-.kem kdl_istisna_isle — EL1 kurtarılamaz-fault raporu.
// Kanıtlı-C kdl_istisna_isle (kdl_kesme.c) BİREBİR .kem yeniden gerçekleştirmesi.
// .S kdl_exc_ortak `bl kdl_istisna_isle(tip,a,b)` çağırır (kurtarılamaz-fault yolu —
// D-276 recovery bayrağı SET DEĞİLSE). WEAK-OVERRIDE: C tanımı weak yapıldı, bu strong
// .kem link'te kazanır (guard/cascade yok). Çıplak (trap-bağlamı, region yok) → mevcut
// normal-tier uart_metin/satir/onaltilik (yetki<MMIO> capability) ÇAĞRILAMAZ (D-257
// çıplak-call-rule, E013) → YENİ çıplak-tier ham-MMIO UART primitifi (vblk_y8 deseni:
// doğrudan volatile-deref, capability-suz). noreturn (rapor + wfe sonsuz).

sabit KIS_UART_TABAN: tam64 = 150994944;   // 0x09000000 PL011 (UART_TABAN ile aynı)
sabit KIS_UART_DR: tam64    = 150994944;   // +0x00
// D-287 DÜZELTME: 150995112 (0x090000A8) YANLIŞ değerdi (B1'den beri, latent bug) — PL011
// FR register GERÇEK offset'i 0x18 = 150994968 (0x09000018), NOT 0xA8. 0xA8 PL011'de
// tanımsız/reserved alan — QEMU'da muhtemelen HER ZAMAN 0 okunuyordu. TX (kis_bayt) bu
// yüzden hiç GERÇEKTEN TXFF beklemiyordu (her zaman "dolu değil" görüp hemen geçiyordu) —
// sessizce çalışıyordu (yanlış ama zararsız: TX asla gerçekten bloklanmadı). RX (kis_satir_oku,
// D-287) AYNI bug'ı MASKELEYEMEDİ — RXFE her zaman 0 (=veri var) okununca sonsuz-döngü
// (DR'den çöp okuyup asla \n/\r bulamama) oluştu — gerçek gate (UART RX) bunu ortaya çıkardı.
sabit KIS_UART_FR: tam64    = 150994968;   // 0x09000018 (DOĞRU — kdl_uart.c/UART_FR ile eşleşir)
sabit KIS_UART_TXFF: tam32  = 32;          // bit5

çıplak işlev kis_o32(adr: tam64) -> tam32 { değişken p: *tam32 = adr olarak *tam32; ver *p; }
çıplak işlev kis_y32(adr: tam64, v: tam32) { değişken p: *tam32 = adr olarak *tam32; *p = v; }

// TXFF boşalana dek bekle + bayt yaz (çıplak, capability-suz — mevcut uart_bayt'ın ham eşleniği).
çıplak işlev kis_bayt(b: tam32) {
    iken (kis_o32(KIS_UART_FR) & KIS_UART_TXFF) != 0 { }
    kis_y32(KIS_UART_DR, b);
}
çıplak işlev kis_metin(s: metin) {
    değişken n: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 0;
    iken i < n { kis_bayt(metin_bayt(s, i) olarak tam32); i = i + 1; }
}
çıplak işlev kis_satir() { kis_bayt(10); }
çıplak işlev kis_hex_basamak(d: dtam64) {
    eğer d > 0 {
        kis_hex_basamak(d / 16);
        değişken r: tam32 = (d - (d / 16) * 16) olarak tam32;
        eğer r < 10 { kis_bayt(r + 48); } değilse { kis_bayt(r + 87); }
    }
}
çıplak işlev kis_onaltilik(d: dtam64) {
    eğer d == 0 { kis_bayt(48); } değilse { kis_hex_basamak(d); }
}
çıplak işlev kis_far_oku() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: arm64 şablon: r#"mrs $0, far_el1"# çıktı("=r", &x) } }
    ver x;
}

// kdl_istisna_isle birebir: FAR oku + "ISTISNA tip=0x.. a=0x.. b=0x.. adr=0x.." + wfe sonsuz.
çıplak işlev kdl_istisna_isle(tip: tam64, a: tam64, b: tam64) {
    değişken adr: tam64 = kis_far_oku();
    // kis_onaltilik ISARETSIZ (dtam64) ister — adres/ESR degerleri isaretsiz
    // yorumlanmali (tam64 negatif goruntusu onaltilik basaminda YANLIS olur).
    kis_metin("ISTISNA tip=0x"); kis_onaltilik(tip olarak dtam64);
    kis_metin(" a=0x"); kis_onaltilik(a olarak dtam64);
    kis_metin(" b=0x"); kis_onaltilik(b olarak dtam64);
    kis_metin(" adr=0x"); kis_onaltilik(adr olarak dtam64);
    kis_satir();
    iken 1 == 1 {
        güvensiz { satıriçi_asm { mimari: arm64 şablon: r#"wfe"# bozulan("~{memory}") } }
    }
}

// ============================================================================
// ZERO-C B2 (D-284): SAF-.kem kdl_el0_izolasyon_isle — EL0 izolasyon-ihlali → süreç öldür.
// Kanıtlı-C kdl_el0_izolasyon_isle (kdl_kesme.c) BİREBİR .kem yeniden gerçekleştirmesi.
// .S kdl_exc_ortak `bl kdl_el0_izolasyon_isle(far)` çağırır (EL0-kaynaklı fault + kill
// AÇIK ise). Rapor (kis_* B1'den) + kem_gorev_bitir() (kem_gorev.kem — kem_paktif'i
// KG_OLU'da işaretle; scheduler bir daha seçmez). kdl_el0_kill_aktif C-DATA KALIR (.S
// substrat'ı okuyor, D-276 fault-scratch deseni) — .kem inline-asm YAZAR (opt-in aç).

çıplak işlev kis_el0_kill_ac() {
    güvensiz {
        satıriçi_asm {
            mimari: arm64
            şablon: r#"adrp x9, kdl_el0_kill_aktif
add x9, x9, :lo12:kdl_el0_kill_aktif
mov x10, #1
str x10, [x9]"#
            bozulan("~{x9}") bozulan("~{x10}") bozulan("~{memory}")
        }
    }
}

// kdl_el0_izolasyon_isle birebir: rapor + kem_gorev_bitir. .S FAR'ı x0'da geçer.
çıplak işlev kdl_el0_izolasyon_isle(far: tam64) {
    kis_metin("IZOLASYON OK: EL0 kernel-erisim reddedildi (surec olduruldu) FAR=0x");
    kis_onaltilik(far olarak dtam64);
    kis_satir();
    kem_gorev_bitir();
}

// ============================================================================
// USERLAND ADIM 2 (D-287): SAF-.kem UART-RX (sys 26 read_satir). Kanıtlı-C
// kdl_kesme.c:478-495 BİREBİR yeniden gerçekleştirmesi: PL011 FR.RXFE=bit4 bounded-poll
// (8M iter/bayt — deadlock-guard, D-158 dersi: yük-duyarlı sonsuz-bekleme YOK), DR&0xFF
// oku, \n/\r'de dur, EOF'ta -1 (un==0 ise). kis_bayt (TX, B1) primitifinin ikizi.

sabit KIS_UART_RXFE: tam32 = 16;    // bit4 (0=veri var, 1=FIFO boş)

// DR'yi TEK sefer oku (gerçek donanımda okuma FIFO'dan tüketir — iki kez okumak FARKLI
// bayt/bozuk değer döndürebilir; tek-okuma + yerel değişkende mod-al ile düzeltildi).
çıplak işlev kis_rx_dr_oku() -> tam32 {
    değişken d: tam32 = kis_o32(KIS_UART_DR);
    ver d - ((d / 256) * 256);
}
çıplak işlev kis_buf_yaz8(adr: tam64, i: tam32, b: tam32) { değişken p: *dtam8 = (adr + (i olarak tam64)) olarak *dtam8; *p = b olarak dtam8; }
çıplak işlev kis_buf_oku8(adr: tam64, i: tam32) -> tam32 { değişken p: *dtam8 = (adr + (i olarak tam64)) olarak *dtam8; ver (*p) olarak tam32; }

// buf_adr'a satır oku (en fazla umax-1 bayt + null). Dönen: okunan bayt sayısı (>=0)
// veya EOF/timeout'ta -1 (hiç bayt gelmediyse). \n veya \r satırı sonlandırır (atılır).
// Poll-sınırı (bkz. KIS_RX_POLL_LIMIT): proven-C'nin 8_000_000'ı GERÇEK donanım hız
// varsayımıyla kalibre edilmişti; QEMU'da HER MMIO okuması device-emulation trap'i
// (mikrosaniyeler) — 8M iterasyon TÜM kem_os boot penceresini (12s) doldurup gate'i
// TIMEOUT ile öldürüyordu (ampirik bulgu). Küçültüldü — anlam AYNI (bounded-poll→EOF),
// sabit ortam-hızına göre kalibre edildi (kör-kopyalama DEĞİL).
çıplak işlev kis_satir_oku(buf_adr: tam64, umax: tam32) -> tam32 {
    değişken un: tam32 = 0;
    iken 1 == 1 {
        değişken geldi: tam32 = 0;
        değişken i: tam64 = 0;
        iken i < 20000 {
            eğer (kis_o32(KIS_UART_FR) & KIS_UART_RXFE) == 0 { geldi = 1; i = 20000; } değilse { i = i + 1; }
        }
        eğer geldi == 0 {
            kis_buf_yaz8(buf_adr, un, 0);
            eğer un > 0 { ver un; } değilse { ver 0 - 1; }
        }
        değişken c: tam32 = kis_rx_dr_oku();
        eğer (c == 10) veya (c == 13) {
            kis_buf_yaz8(buf_adr, un, 0);
            ver un;
        }
        eğer un < (umax - 1) {
            kis_buf_yaz8(buf_adr, un, c);
            un = un + 1;
        }
    }
    ver un;
}
