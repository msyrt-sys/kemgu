// kem_gorev_cekirdek.kem — MİMARİDEN BAĞIMSIZ preemptive zamanlayıcı çekirdeği (D-684).
// ============================================================================
// runtime/kem_gorev.kem'den taşındı. Mimariye özgü üç nokta KANCA:
//   kg_cerceve_kur(tepe, giris) -> sp   sentetik trap-frame (arm64 272 B / x86 iretq)
//   kg_alan_sifirla() / kg_alan_gec(i)  görev başına adres alanı (arm64 TTBR0; x86 yok)
// + sabit RAM adresleri (KG_PSP, KG_OLU, KG_G1/G2, KG_AKTIF, KG_STK1/2) ve görev
// giriş adresi yardımcıları (kg_gorev1_adr/2_adr) → runtime/mimari/<arch>/kem_gorev_hw.kem.

// Scheduler durumu — YALNIZ .kem okur/yazar (.S paylaşımı yok) → küresel internal OK.
// Sayaçlar (kem_g1/g2) FİXED RAM: yalnız asm-ile-kullanılan küresel DGE ile silinir →
// fixed-adres çıplak deref (volatile) hem stripping'i hem sonsuz-döngü store-sink'i çözer.
küresel değişken kem_paktif: tam64 = 0;    // o an koşan görev
küresel değişken kem_psayi: tam64 = 0;     // görev sayısı (0=main dahil kem_preempt_baslat'ta 1)

çıplak işlev kg_psp_yaz(i: tam64, v: tam64) { değişken p: *tam64 = (KG_PSP + i * 8) olarak *tam64; *p = v; }
çıplak işlev kg_psp_oku(i: tam64) -> tam64 { değişken p: *tam64 = (KG_PSP + i * 8) olarak *tam64; ver *p; }
çıplak işlev kg_yaz64(adr: tam64, v: tam64) { değişken p: *tam64 = adr olarak *tam64; *p = v; }
çıplak işlev kg_oku64(adr: tam64) -> tam64 { değişken p: *tam64 = adr olarak *tam64; ver *p; }

// main = görev 0; ilk preempt'te gerçek trap-frame SP'si kaydedilir.
çıplak işlev kem_preempt_baslat() {
    kem_paktif = 0;
    kem_psayi = 1;
    kg_yaz64(KG_AKTIF, 0);
    kg_yaz64(KG_G1, 0);          // sayaçları sıfırla (fixed RAM)
    kg_yaz64(KG_G2, 0);
    değişken k: tam64 = 0;
    iken k < 16 { kg_yaz64(KG_OLU + k * 8, 0); k = k + 1; }   // olu[] tablosu temizle
    kg_alan_sifirla();                       // [D-684] mimari kancası (arm64: ttbr[]=0)
}
çıplak işlev kem_preempt_ac() { kg_yaz64(KG_AKTIF, 1); }

// Sentetik trap-frame kur (kdl_preempt_gorev_olustur birebir): 34 slot × 8 = 272 bayt,
// tf@248=ELR=giriş, tf@256=SPSR=0x5 (EL1h IRQ-açık), gerisi 0. SP 16-hizalı. id döner.
// [D-606] GÖREV TABLOSU KAPASİTESİ. olu[]/psp[]/ttbr[] tabloları 16 girdiliktir (sys(14)
// durum zaten `arg >= 16` reddeder) ve olu[]'nun ARKASINDA KG_G1/KG_AKTIF durur. Önceden
// kem_psayi'nın ÜST SINIRI YOKTU: EL0'dan döngüyle sys(12) spawn çağıran bir program
// sayacı büyütüp zamanlayıcının olu[n]/psp[n] yazımlarını çekirdek durum değişkenlerine
// taşırabilirdi. Kapasite doluysa görev KURULMAZ, -1 döner (trap-frame yazılmadan ÖNCE).
sabit KG_GOREV_AZAMI: tam64 = 16;

çıplak işlev kem_gorev_olustur(giris: tam64, yigin_tepe: tam64) -> tam64 {
    eğer kem_psayi >= KG_GOREV_AZAMI { ver 0 - 1; }
    değişken sp: tam64 = kg_cerceve_kur(yigin_tepe, giris);   // [D-684] mimari kancası
    değişken i: tam64 = kem_psayi;
    kg_psp_yaz(i, sp);
    kem_psayi = kem_psayi + 1;
    ver i;
}

// Round-robin scheduler — .kem kdl_irq_isle her timer IRQ'da çağırır. sp = kesilen
// görevin trap-frame SP'si. aktif değilse/tek görevse sp (switch yok → A3 timer nötr).
// kdl_preempt birebir: bitmiş (kg_olu=1) görevler ATLANIR (round-robin sırada tara).
çıplak işlev kem_preempt(sp: tam64) -> tam64 {
    eğer (kg_oku64(KG_AKTIF) == 0) veya (kem_psayi < 2) { ver sp; }
    kg_psp_yaz(kem_paktif, sp);                   // mevcut görevin SP'sini kaydet
    değişken n: tam64 = kem_paktif;
    değişken t: tam64 = 0;
    değişken bulundu: tam64 = 0;
    iken (t < kem_psayi) ve (bulundu == 0) {      // en fazla psayi adım tara, ilk canlıda dur
        n = n + 1;
        eğer n >= kem_psayi { n = 0; }
        eğer kg_oku64(KG_OLU + n * 8) == 0 { kem_paktif = n; bulundu = 1; }
        t = t + 1;
    }
    // MODEL B / MB-1b: seçilen görevin adres alanına geç. ttbr[i]==0 ise Model A
    // davranışı (çekirdek alanı) — geriye uyumlu. Anahtarlama BURADA güvenli:
    // kem_preempt EL1'de, IRQ içinde koşar ve her adres alanı çekirdek RAM'ini
    // AYNI identity eşlemeyle içerir (kmmu_as_olustur L2'yi kopyalar) → bu
    // işlevin kendi kodu/yığını anahtarlamadan SONRA da haritalı kalır.
    kg_alan_gec(kem_paktif);                      // [D-684] mimari kancası (arm64: TTBR0)
    ver kg_psp_oku(kem_paktif);                   // sonraki (canlı) görevin SP'si → .S switch
}

// Aktif görevi BİTİR (izolasyon-ihlali/exit) — kdl_gorev_bitir birebir. Scheduler bir
// daha seçmez (kem_preempt yukarıdaki tarama sırasında atlar).
çıplak işlev kem_gorev_bitir() {
    kg_yaz64(KG_OLU + kem_paktif * 8, 1);
}

// Görev gövdeleri — sonsuz sayaç (preemption ile kesilir; timer IRQ round-robin döndürür).
// Fixed-RAM volatile deref (kg_yaz64/kg_oku64) → store sink EDİLMEZ, main taze görür.
çıplak işlev kem_gorev1() { iken 1 == 1 { kg_yaz64(KG_G1, kg_oku64(KG_G1) + 1); } }
çıplak işlev kem_gorev2() { iken 1 == 1 { kg_yaz64(KG_G2, kg_oku64(KG_G2) + 1); } }

// A4 gate: 2 preemptive görev kur → preemption aç → main spin ederken timer-IRQ
// round-robin ile görevlere geçer → her iki sayaç ilerler (INTERLEAVE) → preemption
// çalışıyor. guard'lı (switch bozuksa hang yok). Sonra preemption'ı KAPAT → main
// [6..10]'a devam eder (görevler artık seçilmez — sonsuz döngüleri terk edilir).
çıplak işlev kem_preempt_testi() -> tam32 {
    kem_preempt_baslat();
    değişken t1: tam64 = kem_gorev_olustur(kg_gorev1_adr(), KG_STK1);
    değişken t2: tam64 = kem_gorev_olustur(kg_gorev2_adr(), KG_STK2);
    kem_preempt_ac();
    değişken guard: tam64 = 0;
    iken ((kg_oku64(KG_G1) < 2) veya (kg_oku64(KG_G2) < 2)) ve (guard < 200000000) {
        guard = guard + 1;
    }
    kg_yaz64(KG_AKTIF, 0);                        // preemption DURDUR → main devam
    eğer (kg_oku64(KG_G1) >= 2) ve (kg_oku64(KG_G2) >= 2) {
        ver 1;                                     // her iki görev de koştu → interleave
    }
    ver 0;
}

// [D-686] Mimariden bağımsız sistem çağrısı servisleri — arm64 kdl_syscall_isle'dan
// BİREBİR taşındı (dallar değişmedi). Kullanıcı işaretçisi gerektirmeyenler; EL0
// işaretçili servisler (5/17/18/26) ve konsol (7) mimari dağıtıcıda kalır.
çıplak işlev kem_syscall_temel_mi(num: tam64) -> mantıksal {
    ver (num == 10) veya (num == 11) veya (num == 13) veya (num == 14);
}
çıplak işlev kem_syscall_temel(num: tam64, arg: tam64) -> tam64 {
    eğer num == 10 { ver kem_tik_oku(); }
    eğer num == 11 { ver kem_paktif; }
    eğer num == 13 {
        kem_gorev_bitir();
        ver 0;
    }
    eğer num == 14 {
        eğer (arg < 0) veya (arg >= 16) { ver 1; }
        ver kg_oku64(KG_OLU + arg * 8);
    }
    ver 0 - 1;
}

// ============================================================================
// [D-694] DİL GÖREVİ (görev_başlat/birleştir) — kem_gorev.kem'den taşındı, mimariden
// bağımsız. Mimari kancaları (runtime/mimari/<arch>/kem_gorev_hw.kem): kg_irq_kapat,
// kg_irq_ac2, kg_dil_cagir(fn, rho, env), kg_dil_trampolin_adr, kg_cerceve_arg0
// (trampolinin ilk argüman yazmacının trap-frame ofseti: arm64 x0 @0, x86 rdi @72).
// ============================================================================
sabit KG_DIL_YIGIN: tam64 = 65536;          // görev başına yığın (malloc)
küresel değişken kem_dil_canli: tam64 = 0;  // birleştirilmemiş dil görevi sayısı

// Görev gövdesi. eret ile girilir (x30=0) → ASLA dönmez.
çıplak işlev kem_dil_trampolin(g: *tam8) {
    değişken kayit: tam64 = g olarak tam64;
    değişken fn: tam64 = kg_oku64(kayit);
    değişken env: tam64 = kg_oku64(kayit + 8);
    değişken rho: tam64 = kg_oku64(kayit + 16);
    değişken sonuc: tam64 = 0;
    sonuc = kg_dil_cagir(fn, rho, env);                    // [D-694] mimari kancası
    kg_yaz64(kayit + 32, sonuc);
    // SIRA ŞART ve IRQ MASKELİ: önce olu=1 (zamanlayıcı bir daha seçmez), sonra
    // bitti=1. Ters sıra: main bitti'yi görüp yığını serbest bırakırken ölü görev
    // yeniden seçilip O yığına trap-frame yazabilirdi (UAF). Maskesiz: olu=1 ile
    // bitti=1 arasına düşen bir IRQ görevi bitti yazılmadan KALICI atlatırdı →
    // birleştir sonsuza dek beklerdi. main bitti'yi ancak KOŞARKEN görür; o anda
    // bu görev koşmuyor ve olu=1 olduğu için bir daha asla koşmayacaktır.
    kg_irq_kapat();
    kem_gorev_bitir();
    kg_yaz64(kayit + 40, 1);
    kg_irq_ac2();
    iken doğru { }
}

çıplak işlev kdl_gorev_basla_kapanis(fn_bare: *tam8, fn_kapanis: *tam8, env: *tam8, rho_serbest: tam32) -> *tam8 {
    değişken rec: *tam8 = malloc(56);
    değişken kayit: tam64 = rec olarak tam64;
    eğer kayit == 0 { ver rec; }                          // OOM → null → sonuç::hata
    değişken rho: *tam8 = kdl_bolge_olustur();
    eğer (rho olarak tam64) == 0 { free(rec); ver 0 olarak *tam8; }
    değişken yigin: *tam8 = malloc(KG_DIL_YIGIN);
    değişken yb: tam64 = yigin olarak tam64;
    eğer yb == 0 { kdl_bolge_serbest(rho); free(rec); ver 0 olarak *tam8; }
    kg_yaz64(kayit, fn_kapanis olarak tam64);
    kg_yaz64(kayit + 8, env olarak tam64);
    kg_yaz64(kayit + 16, rho olarak tam64);
    kg_yaz64(kayit + 24, rho_serbest olarak tam64);
    kg_yaz64(kayit + 32, 0);
    kg_yaz64(kayit + 40, 0);
    kg_yaz64(kayit + 48, yb);
    // İlk canlı dil görevi: zamanlayıcıyı temiz kur (önceki fazların sonsuz test
    // görevleri düşer; main = görev 0). Canlı görev varken ASLA sıfırlanmaz.
    eğer kem_dil_canli == 0 { kem_preempt_baslat(); }
    kg_irq_kapat();                                        // frame kurulurken seçilmesin
    değişken id: tam64 = kem_gorev_olustur(kg_dil_trampolin_adr(), yb + KG_DIL_YIGIN);
    eğer id < 0 {
        kg_irq_ac2();
        free(yigin); kdl_bolge_serbest(rho); free(rec);
        ver 0 olarak *tam8;                                // tablo dolu → sonuç::hata
    }
    kg_yaz64(kg_psp_oku(id) + kg_cerceve_arg0(), kayit);   // ilk argüman yuvası = kayıt (D-694)
    kem_dil_canli = kem_dil_canli + 1;
    kem_preempt_ac();
    kg_irq_ac2();
    ver rec;
}

çıplak işlev kdl_gorev_birlestir(g: *tam8) -> tam64 {
    değişken kayit: tam64 = g olarak tam64;
    eğer kayit == 0 { kem_panik("PANIK: gorev_birlestir: gecersiz (NULL) gorev"); }
    iken kg_oku64(kayit + 40) == 0 { }                     // join: preemption karşıyı koşturur
    değişken r: tam64 = kg_oku64(kayit + 32);
    eğer kg_oku64(kayit + 24) != 0 { kdl_bolge_serbest(kg_oku64(kayit + 16) olarak *tam8); }
    free(kg_oku64(kayit + 48) olarak *tam8);              // ölü görevin yığını (bkz. trampolin)
    free(g);
    kem_dil_canli = kem_dil_canli - 1;
    eğer kem_dil_canli == 0 { kg_yaz64(KG_AKTIF, 0); }     // main tek başına: eski durum
    ver r;
}

// ============================================================================
// [D-705] KULLANICI-İŞARETÇİLİ SİSTEM ÇAĞRILARI — kem_gorev.kem'den taşındı (mimariden
// bağımsız). Kullanıcı penceresi mimari kancasıdır: kg_kul_min/kg_kul_max/kg_kul_boy
// (arm64 0x42000000 + 2 MiB; x86 0x54000000 + 2 MiB). kis_bayt / kis_buf_oku8 /
// kis_buf_yaz8 her mimarinin kendi MMU dosyasında (arm64 kem_mmu.kem, x86 kem_mmu_hw.kem).
// ============================================================================
// === D-610 GÜVENLİK: EL0-pointer doğrulama (proven-C kdl_kesme.c D-150/151 .kem aynası) ===
// EL0 syscall'ları kernel'e (EL1) pointer geçirir. Kernel o adresi denetimsiz DEREF
// ederse, kötü/hatalı bir EL0 süreç KERNEL BELLEĞİNİ okutabilir (info-leak: sys(5) o
// belleği UART'a basar) ya da kernel'e YAZDIRABİLİR (bellek bozulması / privilege
// escalation). kem_os user penceresi TEK 2 MiB sayfadır: [0x42000000, 0x42200000)
// (kem_mmu.kem L2[16], AP=01). Bu aralık dışındaki her pointer REDDEDİLİR.

// Kernel'in YAZDIĞI user-tampon: adres user penceresinde + len sınırlı + taşma yok.
çıplak işlev kg_user_yaz_ptr_gecerli(p: tam64, len: tam64) -> tam32 {
    eğer p < kg_kul_min() { ver 0; }            // kernel/aşağı bölge → RED
    eğer len > kg_kul_boy() { ver 0; }          // aşırı boy → RED
    eğer (p + len) < p { ver 0; }              // taşma → RED
    eğer (p + len) > kg_kul_max() { ver 0; }    // pencere dışı → RED
    ver 1;
}

// Kernel'in OKUDUĞU EL0-kontrollü null-sonlu string: pointer user penceresinde OLMALI
// ve null-sonlandırıcı pencere içinde (4 KiB tarama tavanı) BULUNMALI — aksi hâlde
// straddle-over-read riski → RED. Tarama YALNIZ mapped-izinli byte'lara dokunur →
// tarama fault üretemez (info-leak/DoS ikisi de kesilir).
çıplak işlev kg_user_oku_str_gecerli(p: tam64) -> tam32 {
    eğer p < kg_kul_min() { ver 0; }            // pencere dışı → RED (kernel-sızıntı engeli)
    eğer p >= kg_kul_max() { ver 0; }
    değişken son: tam64 = kg_kul_max();
    değişken tavan: tam64 = p + 4096;          // tarama maliyeti sınırı
    eğer (tavan > p) ve (tavan < son) { son = tavan; }   // taşma-korumalı min
    değişken a: tam64 = p;
    iken a < son {
        eğer kis_buf_oku8(a, 0) == 0 { ver 1; }   // bölge-içi null → string güvenli
        a = a + 1;
    }
    ver 0;                                      // null yok → straddle riski → RED
}
// Ad ilk 4 baytı (i>=uzunluk ise 0-pad — mfs_dosya_yaz/oku 4-bayt ad sözleşmesi).
çıplak işlev kg_ad_bayt(adr: tam64, i: tam32) -> dtam8 {
    değişken n: tam32 = kdl_metin_uzunluk(adr olarak *tam8);
    eğer i < n { ver (kdl_metin_bayt(adr olarak *tam8, i)) olarak dtam8; }
    ver 0 olarak dtam8;
}
çıplak işlev kem_syscall_kul_mi(num: tam64) -> mantıksal {
    ver (num == 5) veya (num == 17) veya (num == 18) veya (num == 26);   // 26: D-706
}
çıplak işlev kem_syscall_kul(num: tam64, arg: tam64, arg2: tam64) -> tam64 {
    eğer num == 26 {
        eğer kg_user_yaz_ptr_gecerli(arg, arg2) == 0 { ver 0 - 1; }  // D-610: buf yazma
        değişken r: tam32 = kis_satir_oku(arg, arg2 olarak tam32);
        ver r olarak tam64;
    }
    eğer num == 5 {
        eğer kg_user_oku_str_gecerli(arg) == 0 { ver 0 - 1; }   // D-610: EL0 str ptr
        değişken n5: tam32 = kdl_metin_uzunluk(arg olarak *tam8);
        değişken i5: tam32 = 0;
        iken i5 < n5 { kis_bayt((kdl_metin_bayt(arg olarak *tam8, i5)) olarak tam32); i5 = i5 + 1; }
        ver 0;
    }
    eğer num == 17 {
        eğer kg_user_oku_str_gecerli(arg) == 0 { ver 0 - 1; }    // D-610: ad okuma
        eğer kg_user_oku_str_gecerli(arg2) == 0 { ver 0 - 1; }   // D-610: içerik okuma
        değişken base: tam64 = vblk_bul();
        eğer base == 0 { ver 0 - 1; }
        eğer vblk_kur(base) != 0 { ver 0 - 1; }
        değişken n: tam32 = kdl_metin_uzunluk(arg2 olarak *tam8);
        değişken i: tam32 = 0;
        iken i < n {
            eğer i < 512 { vblk_data_yaz(i, (kdl_metin_bayt(arg2 olarak *tam8, i)) olarak dtam8); }
            i = i + 1;
        }
        değişken a0: dtam8 = kg_ad_bayt(arg, 0);
        değişken a1: dtam8 = kg_ad_bayt(arg, 1);
        değişken a2: dtam8 = kg_ad_bayt(arg, 2);
        değişken a3: dtam8 = kg_ad_bayt(arg, 3);
        değişken r: tam32 = mfs_dosya_yaz(base, a0, a1, a2, a3, n);
        eğer r != 0 { ver 0 - 1; }
        ver n olarak tam64;
    }
    eğer num == 18 {
        eğer kg_user_oku_str_gecerli(arg) == 0 { ver 0 - 1; }        // D-610: ad okuma
        eğer kg_user_yaz_ptr_gecerli(arg2, 512) == 0 { ver 0 - 1; }  // D-610: buf yazma (≤512)
        değişken base2: tam64 = vblk_bul();
        eğer base2 == 0 { ver 0 - 1; }
        eğer vblk_kur(base2) != 0 { ver 0 - 1; }
        değişken b0: dtam8 = kg_ad_bayt(arg, 0);
        değişken b1: dtam8 = kg_ad_bayt(arg, 1);
        değişken b2: dtam8 = kg_ad_bayt(arg, 2);
        değişken b3: dtam8 = kg_ad_bayt(arg, 3);
        değişken boyut: tam32 = mfs_dosya_oku(base2, b0, b1, b2, b3);
        eğer boyut < 0 { ver 0 - 1; }
        değişken j: tam32 = 0;
        iken j < boyut {
            eğer j < 511 { kis_buf_yaz8(arg2, j, (vblk_data_oku(j)) olarak tam32); }
            j = j + 1;
        }
        kis_buf_yaz8(arg2, boyut, 0);
        ver boyut olarak tam64;
    }
    ver 0 - 1;
}

// [D-706] UART satır okuma (kem_mmu.kem'den taşındı; sistem çağrısı 26). Donanım
// kancaları: kis_rx_hazir() (bayt var mı: arm64 PL011 RXFE, x86 16550 LSR bit0) ve
// kis_rx_oku() (baytı al). Sınırlı yoklama: girdi yoksa EOF (-1).
çıplak işlev kis_satir_oku(buf_adr: tam64, umax: tam32) -> tam32 {
    değişken un: tam32 = 0;
    iken 1 == 1 {
        değişken geldi: tam32 = 0;
        değişken i: tam64 = 0;
        iken i < 20000 {
            eğer kis_rx_hazir() == 1 { geldi = 1; i = 20000; } değilse { i = i + 1; }
        }
        eğer geldi == 0 {
            kis_buf_yaz8(buf_adr, un, 0);
            eğer un > 0 { ver un; } değilse { ver 0 - 1; }
        }
        değişken c: tam32 = kis_rx_oku();
        eğer (c == 10) veya (c == 13) {
            kis_buf_yaz8(buf_adr, un, 0);
            ver un;
        }
        eğer un < (umax - 1) {
            kis_buf_yaz8(buf_adr, un, c);
            un = un + 1;
        }
    }
    ver un;
}
