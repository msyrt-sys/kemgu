// x86_64 kullanıcı ABI'si. Ham adresler yalnız süreç adres alanına aittir.
çıplak işlev sis_cagir(num: tam64, ilk: tam64, ikinci: tam64, ucuncu: tam64) -> tam64 {
    değişken sonuc: tam64 = num;
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"int $$0x80"#
            çıktı("={rax}", &sonuc)
            girdi("0", num) girdi("{rdi}", ilk) girdi("{rdx}", ikinci) girdi("{rsi}", ucuncu)
            bozulan("~{memory}") bozulan("~{cc}")
        }
    }
    ver sonuc;
}
çıplak işlev sis_abi_surumu() -> tam64 { ver sis_cagir(40, 0, 0, 0); }
çıplak işlev sis_tik() -> tam64 { ver sis_cagir(10, 0, 0, 0); }
çıplak işlev sis_pid() -> tam64 { ver sis_cagir(11, 0, 0, 0); }
çıplak işlev sis_durum(pid: tam64) -> tam64 { ver sis_cagir(14, pid, 0, 0); }
çıplak işlev sis_cik(kod: tam64) {
    sis_cagir(13, kod, 0, 0);
    // Bir ABI hatasında da _start geçersiz bir dönüş adresine gitmez.
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"ud2"# } }
}
çıplak işlev sis_yaz(fd: tam64, buf: tam64, n: tam64) -> tam64 { ver sis_cagir(44, fd, buf, n); }
çıplak işlev sis_metin_adres(s: metin) -> tam64 {
    değişken yuva: *tam64 = (&s) olarak *tam64;
    ver *yuva;
}
çıplak işlev sis_metin(s: metin) -> tam64 {
    ver sis_yaz(1, sis_metin_adres(s), metin_uzunluk(s) olarak tam64);
}
çıplak işlev sis_bayt_yaz(fd: tam64, b: tam32) -> tam64 {
    değişken byt: dtam8 = b olarak dtam8;
    değişken p: *dtam8 = (&byt) olarak *dtam8;
    ver sis_yaz(fd, p olarak tam64, 1);
}

çıplak işlev sis_ac(yol: metin, kip: tam64) -> tam64 { ver sis_cagir(41,sis_metin_adres(yol),kip,0); }
çıplak işlev sis_kapat(fd: tam64) -> tam64 { ver sis_cagir(42,fd,0,0); }
çıplak işlev sis_oku(fd: tam64, buf: tam64, n: tam64) -> tam64 { ver sis_cagir(43,fd,buf,n); }
çıplak işlev sis_konumla(fd: tam64, ofs: tam64, nereden: tam64) -> tam64 { ver sis_cagir(45,fd,ofs,nereden); }
çıplak işlev sis_bilgi(yol: metin, buf: tam64) -> tam64 { ver sis_cagir(46,sis_metin_adres(yol),buf,0); }
çıplak işlev sis_dizin_oku(fd: tam64, buf: tam64, n: tam64) -> tam64 { ver sis_cagir(47,fd,buf,n); }
çıplak işlev sis_olustur_dizin(yol: metin) -> tam64 { ver sis_cagir(48,sis_metin_adres(yol),0,0); }
çıplak işlev sis_sil(yol: metin) -> tam64 { ver sis_cagir(49,sis_metin_adres(yol),0,0); }
çıplak işlev sis_sil_dizin(yol: metin) -> tam64 { ver sis_cagir(50,sis_metin_adres(yol),0,0); }
çıplak işlev sis_kopyala(eski: metin,yeni: metin) -> tam64 { ver sis_cagir(71,sis_metin_adres(eski),sis_metin_adres(yeni),0); }
çıplak işlev sis_tasi(eski: metin,yeni: metin) -> tam64 { ver sis_cagir(72,sis_metin_adres(eski),sis_metin_adres(yeni),0); }
çıplak işlev sis_yeniden_adlandir(eski: metin, yeni: metin) -> tam64 { ver sis_cagir(51,sis_metin_adres(eski),sis_metin_adres(yeni),0); }
çıplak işlev sis_calisma_dizini_al(buf: tam64,n: tam64) -> tam64 { ver sis_cagir(52,buf,n,0); }
çıplak işlev sis_calisma_dizini_degistir(yol: metin) -> tam64 { ver sis_cagir(53,sis_metin_adres(yol),0,0); }
çıplak işlev sis_esitle() -> tam64 { ver sis_cagir(54,0,0,0); }
çıplak işlev sis_tus_bekle(buf: tam64) -> tam64 { ver sis_cagir(55,buf,0,0); }
çıplak işlev sis_saat(buf: tam64) -> tam64 { ver sis_cagir(56,buf,0,0); }
çıplak işlev sis_uyu(ms: tam64) -> tam64 { ver sis_cagir(57,ms,0,0); }
çıplak işlev sis_baslat(yol: metin,argv: tam64) -> tam64 { ver sis_cagir(58,sis_metin_adres(yol),argv,0); }
çıplak işlev sis_bekle(pid: tam64,sonuc: tam64) -> tam64 { ver sis_cagir(59,pid,sonuc,0); }
çıplak işlev sis_surec_listesi(tampon: tam64,n: tam64) -> tam64 { ver sis_cagir(60,tampon,n,0); }
çıplak işlev sis_ekran_bilgi(p: tam64) -> tam64 { ver sis_cagir(61,p,0,0); }
çıplak işlev sis_ekran_yaz(sat: tam64,sut: tam64,p: tam64) -> tam64 { ver sis_cagir(62,sat,sut,p); }
çıplak işlev sis_ekran_temizle(renk: tam64) -> tam64 { ver sis_cagir(63,renk,0,0); }
çıplak işlev sis_imlec(sat: tam64,sut: tam64,gorunur: tam64) -> tam64 { ver sis_cagir(64,sat,sut,gorunur); }
yapı SisHucreMetni { adres: tam64; on: tam64; arka: tam64; }
çıplak işlev sis_hucre(sat: tam64,sut: tam64,m: metin,on: tam64,arka: tam64) -> tam64 {
    değişken y: SisHucreMetni = SisHucreMetni {adres:sis_metin_adres(m),on:on,arka:arka};
    değişken p: *SisHucreMetni = (&y) olarak *SisHucreMetni;
    ver sis_ekran_yaz(sat,sut,p olarak tam64);
}
çıplak işlev sis_fare_bekle(p: tam64) -> tam64 { ver sis_cagir(65,p,0,0); }
çıplak işlev sis_olay_bekle(p: tam64,maske: tam64,ms: tam64) -> tam64 { ver sis_cagir(66,p,maske,ms); }
çıplak işlev sis_alan(p: tam64,i: tam64) -> tam64 { değişken v: *tam64 = (p+i*8) olarak *tam64; ver *v; }
// Kullanıcı adres alanındaki sonlandırılmış UTF-8 tamponunun metin görünümü.
çıplak işlev sis_dize(p: tam64) -> metin {
    değişken m: *metin = (&p) olarak *metin; ver *m;
}
çıplak işlev sis_bayt_al(p: tam64) -> tam32 { değişken v: *dtam8 = p olarak *dtam8; ver ((*v) olarak tam32)&255; }
çıplak işlev sis_bayt_koy(p: tam64,v: tam32) { değişken b: *dtam8 = p olarak *dtam8; *b=v olarak dtam8; }

çıplak işlev sis_onplan_baslat(yol: metin,argv: tam64) -> tam64 { ver sis_cagir(67,sis_metin_adres(yol),argv,0); }

çıplak işlev sis_piksel_satiri(y: tam64,renkler: tam64,adet: tam64) -> tam64 { ver sis_cagir(68,y,renkler,adet); }

çıplak işlev sis_boru(cift: tam64) -> tam64 { ver sis_cagir(69,cift,0,0); }
çıplak işlev sis_baslat_eslemeli(yol: metin,argv: tam64,cift: tam64) -> tam64 { ver sis_cagir(70,sis_metin_adres(yol),argv,cift); }

// Son satırdaki alanı Enter ile kabul eder, Escape ile iptal eder.
// Çağıran olay kaydı ve UTF-8 alanı için en az 512 bayt ayırır.
işlev kul_metin_al(p: tam64,sat: tam32,etiket: metin) -> seçimlik<metin> {
    değişken n: tam32 = 0; değişken dolu: mantıksal = yanlış;
    iken doğru {
        sis_bayt_koy(p+128+(n olarak tam64),0);
        değişken bas: tam32 = 0;
        eğer n > 40 { bas=n-40; iken bas < n ve (sis_bayt_al(p+128+(bas olarak tam64))&192) == 128 { bas=bas+1; } }
        değişken mesaj: metin = metin_birlestir(etiket,sis_dize(p+128+(bas olarak tam64)));
        eğer dolu { mesaj="Alan sınırı 255 bayt. Geri silin."; }
        sis_hucre(sat olarak tam64,0,"                                                               ",0,16777215);
        sis_hucre(sat olarak tam64,0,mesaj,0,16777215);
        eğer sis_olay_bekle(p,1,-1) < 0 { ver hiç; }
        eğer sis_alan(p,3) != 0 {
            değişken kod: tam64 = sis_alan(p,1); değişken un: tam64 = sis_alan(p,2);
            eğer kod == 1 { ver hiç; }
            eğer kod == 28 ve değil dolu { ver değer(metin_birlestir("",sis_dize(p+128))); }
            eğer kod == 14 ve n > 0 {
                n=n-1; iken n > 0 ve (sis_bayt_al(p+128+(n olarak tam64))&192) == 128 { n=n-1; }
                dolu=yanlış;
            } değilse eğer un >= 32 ve değil dolu {
                değişken s: metin = kod_metin(un olarak tam32); değişken boy: tam32 = metin_uzunluk(s);
                eğer boy > 255-n { dolu=doğru; } değilse {
                    değişken i: tam32 = 0;
                    iken i < boy { sis_bayt_koy(p+128+(n olarak tam64),metin_bayt(s,i) olarak tam32); n=n+1; i=i+1; }
                    dolu=yanlış;
                }
            }
        }
    }
    ver hiç;
}
işlev kul_onay(p: tam64,sat: tam32,etiket: metin) -> mantıksal {
    sis_hucre(sat olarak tam64,0,etiket,0,16777215);
    iken doğru {
        eğer sis_olay_bekle(p,1,-1) < 0 { ver yanlış; }
        eğer sis_alan(p,3) != 0 {
            değişken kod: tam64 = sis_alan(p,1);
            eğer kod == 18 { ver doğru; } eğer kod == 1 veya kod == 35 { ver yanlış; }
        }
    } ver yanlış;
}

çıplak işlev sis_ping(ip: tam64,sira: tam64,ms: tam64) -> tam64 { ver sis_cagir(73,ip,sira,ms); }

// Soket ve çoklu bekleme çağrıları işlem tablosundaki fd değerlerini kullanır.
çıplak işlev sis_soket(tur: tam64) -> tam64 { ver sis_cagir(74,tur,0,0); }
çıplak işlev sis_bagla(fd: tam64,ip: tam64,port: tam64) -> tam64 { ver sis_cagir(75,fd,ip,port); }
çıplak işlev sis_baglan_dinle(fd: tam64,port: tam64,kuyruk: tam64) -> tam64 { ver sis_cagir(76,fd,port,kuyruk); }
