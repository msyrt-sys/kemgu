// kem_pci_hw.kem — [D-745] x86_64 PCI yapılandırma (port 0xCF8/0xCFC) + ham MMIO /
// fiziksel bellek erişimi. Sans-IO sürücülerin (drivers/*) GcIstek'leri bare-metal
// çekirdekte bunlarla yürütülür — qtest yürütücüsünün (tests/qemu/qtest.kem)
// gerçek donanım karşılığı. Yol haritası H1f (32-bit port G/Ç) bu dosyayla açılır.
// AS001: yalnız x86_64 asm'i; arm64 ikizi ayrı dosya olur (D2b kararı).
// Çıplak işlevde ham deref `volatile`dır (CLAUDE.md) → MMIO okumaları birleştirilmez.
// Adresler birebir (identity) eşlenmiş olmalı: boot/start_x86_64.S 0..1 GB (önbellekli
// RAM) ve 3..4 GB (UC MMIO penceresi) eşler. Pencere dışı adres çağıranın sorumluluğu.

kullan runtime::mimari::x86_64::kem_pci_adres::{ pci_port_adres, pci_port_veri16 } olarak pa;

// Eşlenen her veri yolu için 1 MiB pencerenin fiziksel başlangıcı. Sıfır CF8/CFC seçer.
küresel değişken pci_ecam_yollari: tam64 = 0;
çıplak işlev kem_ecam_yolu(bdf: tam32) -> tam64 {
    eğer pci_ecam_yollari == 0 veya bdf < 0 veya bdf > 65535 { ver 0; }
    ver kem_mmio_oku64(pci_ecam_yollari+((bdf/256) olarak tam64)*8);
}
çıplak işlev kem_ecam_adres(bdf: tam32,ofs: tam32) -> tam64 {
    değişken taban: tam64 = kem_ecam_yolu(bdf);
    eğer taban == 0 veya ofs < 0 veya ofs > 4095 { ver 0; }
    ver taban+(((bdf&255) olarak tam64)<<12)+(ofs olarak tam64);
}
// PCI yapılandırma (mekanizma 1). bdf = veriyolu * 256 + aygıt * 8 + işlev.
çıplak işlev kem_pci_adres(bdf: tam32, ofs: tam32) -> dtam32 {
    ver pci_port_adres(bdf,ofs);
}

çıplak işlev kem_cf8_oku32(bdf: tam32, ofs: tam32) -> tam64 {
    kem_port_yaz32(3320 olarak dtam16, kem_pci_adres(bdf, ofs));
    // C16-001: genişletmenin üst bitlerini iki derleyicide de temizle.
    ver (kem_port_oku32(3324 olarak dtam16) olarak tam64)&4294967295;
}

çıplak işlev kem_pci_oku32(bdf: tam32,ofs: tam32) -> tam64 {
    eğer bdf < 0 veya bdf > 65535 veya ofs < 0 veya ofs > 4092 veya (ofs&3) != 0 { ver 4294967295; }
    değişken a: tam64 = kem_ecam_adres(bdf,ofs);
    eğer a != 0 { ver kem_mmio_oku32(a); }
    eğer ofs >= 256 { ver 4294967295; }
    ver kem_cf8_oku32(bdf,ofs);
}
çıplak işlev kem_pci_oku16(bdf: tam32,ofs: tam32) -> tam32 {
    eğer bdf < 0 veya bdf > 65535 veya ofs < 0 veya ofs > 4094 veya (ofs&1) != 0 { ver 65535; }
    değişken a: tam64 = kem_ecam_adres(bdf,ofs);
    eğer a != 0 { değişken p: *dtam16 = a olarak *dtam16; ver ((*p) olarak tam32)&65535; }
    eğer ofs >= 256 { ver 65535; }
    kem_port_yaz32(3320 olarak dtam16,kem_pci_adres(bdf,ofs));
    ver (kem_port_oku16(pci_port_veri16(ofs)) olarak tam32)&65535;
}
çıplak işlev kem_pci_yaz16(bdf: tam32,ofs: tam32,v: tam32) {
    eğer bdf < 0 veya bdf > 65535 veya ofs < 0 veya ofs > 4094 veya (ofs&1) != 0 { ver; }
    değişken a: tam64 = kem_ecam_adres(bdf,ofs);
    eğer a != 0 { değişken p: *dtam16 = a olarak *dtam16; *p=v olarak dtam16; ver; }
    eğer ofs >= 256 { ver; }
    kem_port_yaz32(3320 olarak dtam16,kem_pci_adres(bdf,ofs));
    kem_port_yaz16(pci_port_veri16(ofs),v olarak dtam16);
}
çıplak işlev kem_pci_yaz32(bdf: tam32, ofs: tam32, v: tam64) {
    eğer bdf < 0 veya bdf > 65535 veya ofs < 0 veya ofs > 4092 veya (ofs&3) != 0 { ver; }
    değişken a: tam64 = kem_ecam_adres(bdf,ofs);
    eğer a != 0 { kem_mmio_yaz32(a,v); ver; }
    eğer ofs >= 256 { ver; }
    kem_port_yaz32(3320 olarak dtam16, kem_pci_adres(bdf, ofs));
    kem_port_yaz32(3324 olarak dtam16, (v & 4294967295) olarak dtam32);
}

// ---- ham MMIO / fiziksel bellek ----
çıplak işlev kem_mmio_oku32(adres: tam64) -> tam64 {
    değişken p: *dtam32 = adres olarak *dtam32;
    değişken v: dtam32 = *p;
    ver (v olarak tam64)&4294967295;
}

çıplak işlev kem_mmio_yaz32(adres: tam64, v: tam64) {
    değişken p: *dtam32 = adres olarak *dtam32;
    *p = (v & 4294967295) olarak dtam32;
}

çıplak işlev kem_mmio_oku64(adres: tam64) -> tam64 {
    değişken p: *tam64 = adres olarak *tam64;
    ver *p;
}

çıplak işlev kem_mmio_yaz64(adres: tam64, v: tam64) {
    değişken p: *tam64 = adres olarak *tam64;
    *p = v;
}

çıplak işlev kem_fiz_oku8(adres: tam64) -> tam32 {
    değişken p: *dtam8 = adres olarak *dtam8;
    değişken v: dtam8 = *p;
    ver v olarak tam32;
}

çıplak işlev kem_fiz_yaz8(adres: tam64, v: tam32) {
    değişken p: *dtam8 = adres olarak *dtam8;
    *p = ((v & 255) olarak tam32) olarak dtam8;
}

// Önceki yüklemelerden sonra işlemcinin zaman sayacını örnekle.
çıplak işlev bm_tsc_oku() -> tam64 {
    değişken n: tam64 = 0;
    güvensiz { satıriçi_asm { mimari:x86_64 şablon:r#"lfence
rdtsc
shlq $$32,%rdx
orq %rdx,%rax"# çıktı("={ax}",&n) bozulan("~{dx},~{flags},~{memory}") } }
    ver n;
}

// Kısa gecikme: port 0x80'e (POST kodu) okuma ~1 µs gerçek donanımda; QEMU'da
// hızlıdır ama aygıt modelinin işlemesi için ana döngüye zaman tanır.
çıplak işlev kem_bekle_us(us: tam32) {
    değişken i: tam32 = 0;
    iken i < us {
        değişken x: dtam8 = kem_port_oku8(128 olarak dtam16);
        i = i + 1;
    }
}

// QEMU isa-debug-exit (iobase 0xF4): QEMU (kod << 1) | 1 ile çıkar.
çıplak işlev kem_qemu_cik(kod: tam32) {
    kem_port_yaz8(244 olarak dtam16, ((kod & 255) olarak tam32) olarak dtam8);
}
