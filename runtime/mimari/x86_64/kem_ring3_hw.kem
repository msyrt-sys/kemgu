// kem_ring3_hw.kem — x86_64 KULLANICI MODU (ring3) girişi + dönüşü ([D-699]).
// ============================================================================
// arm64 ikizi: runtime/kem_gorev.kem EL0 yolu (kdl_el0_calistir, `eret` + SPSR=EL0t).
// C referansı: test/bare_metal/ring3_x86.c (kendi GDT/IDT/TSS'i; bu dosya ise AYNI
// kanıtı çekirdeğin KENDİ tablolarıyla, süreç adres alanı içinde verir).
//
// Bileşenler (her biri ayrı bir başarısızlık noktası; sabotajla ölçüldü):
//   * GDT 0x18/0x20 DPL3 kod/veri + 0x28 TSS tanımlayıcısı (boot/start_x86_64.S .data)
//   * TSS: RSP0 (kdl_x86_ring3_gir) + IOPB ofseti/tanımlayıcı/`ltr` (kxr_tss_kur)
//   * IDT 0x80 kapısı DPL3 (runtime/kdl_kesme.c, 0xEE) → ring3 `int 0x80` geçer
//   * kullanıcı sayfası: U/S biti tablo yürüyüşünün HER seviyesinde (PML4/PDPT/PD/PT)
//   * dönüş: ring3'te istisna → .S isr_ortak (CS RPL 3 + bekle) → kdl_x86_r3_don
//
// Kullanıcı programları (baytlar llvm-mc -show-encoding ile doğrulandı):
//   ofset 0 : 8c c9          movl %cs, %ecx      (CPL kanıtı: RPL 3)
//             b8 0b 00 00 00 movl $11, %eax      (11 = getpid, kem_syscall_temel)
//             cd 80          int  $0x80          (DPL3 kapı → .kem kdl_syscall_isle)
//             f4             hlt                 (ofset 9: ayrıcalıklı → #GP, vektör 13)
//   ofset 16: b8 00 00 10 00 movl $0x100000, %eax
//             48 8b 00       movq (%rax), %rax   (ofset 21: gözetmen sayfa → #PF hata 5)

sabit KXR_AS: tam64 = 3;                     // adres alanı #3 (x86 kem_os: 0/1 izolasyon, 2 W^X)
sabit KXR_KOD_SEL: tam64 = 27;               // 0x18 | 3
sabit KXR_TSS_SEL: tam64 = 40;               // 0x28 (GDT bayt ofseti)
sabit KXR_TSS_LIMIT: tam64 = 103;            // 104 B TSS → limit 103
sabit KXR_TSS_ERISIM: tam64 = 150633093005312;  // 0x89 << 40: P | DPL0 | tip 9 (64-bit TSS, müsait)
sabit KXR_TSS_IOPB: tam64 = 29273397577908224;  // 104 << 48: +96'dan yazılınca +102 (IOPB) = 104
sabit KXR_2_24: tam64 = 16777216;
sabit KXR_2_56: tam64 = 72057594037927936;
sabit KXR_US_RW: tam64 = 7;                  // P | RW | U/S
sabit KXR_US_RX: tam64 = 5;                  // P | U/S (salt-okunur, NX yok → çalıştırılabilir)
sabit KXR_YIGIN_UST: tam64 = 1411383296;     // 0x54200000: özel 2 MB pencerenin tepesi (sayfa 511)
sabit KXR_GP: tam64 = 13;
sabit KXR_PF: tam64 = 14;
sabit KXR_PF_KUL_OKU: tam64 = 5;             // P(1) | U/S(4): kullanıcı, mevcut sayfa, okuma
sabit KXR_GOZETMEN_VA: tam64 = 1048576;      // 0x100000: çekirdek imajı (gözetmen sayfa)
sabit KXR_GETPID: tam64 = 11;

// .S durum bloğu kdl_x86_r3_blok (ofsetler start_x86_64.S'teki açıklamayla birebir).
çıplak işlev kxr_blok_adr() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"leaq kdl_x86_r3_blok(%rip), $0"# çıktı("=r", &x) } }
    ver x;
}
çıplak işlev kxr_tss_adr() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"leaq kdl_x86_tss(%rip), $0"# çıktı("=r", &x) } }
    ver x;
}
çıplak işlev kxr_gdt_adr() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"leaq kdl_x86_gdt(%rip), $0"# çıktı("=r", &x) } }
    ver x;
}

// Ham bayt yaz (kullanıcı kod sayfasına makine kodu).
çıplak işlev kxr_y8(adr: tam64, v: dtam8) {
    değişken p: *dtam8 = adr olarak *dtam8;
    *p = v;
}

// TR = 0x28 (`ltr` tanımlayıcıyı MEŞGUL işaretler → yalnız BİR kez çağrılır).
çıplak işlev kxr_ltr() {
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"movw $$40, %ax
ltr %ax"#
            bozulan("~{rax}") bozulan("~{memory}")
        }
    }
}

// TSS: IOPB ofseti = 104 (bit haritası YOK → ring3 in/out #GP) + 16 B 64-bit TSS
// tanımlayıcısı (taban parçalı: [15:0] limit, [39:16] taban 0..23, [47:40] erişim,
// [63:56] taban 24..31; ikinci quad taban 32..63) + `ltr`. RSP0 her girişte .S'te.
çıplak işlev kxr_tss_kur() {
    değişken t: tam64 = kxr_tss_adr();
    kxm_y64(t + 96, KXR_TSS_IOPB);
    değişken g: tam64 = kxr_gdt_adr() + KXR_TSS_SEL;
    değişken alt: tam64 = KXR_TSS_LIMIT + (t % KXR_2_24) * 65536 + KXR_TSS_ERISIM
                        + ((t / KXR_2_24) % 256) * KXR_2_56;
    kxm_y64(g, alt);
    kxm_y64(g + 8, t / 4294967296);
    kxr_ltr();
}

// .S kdl_x86_ring3_gir(rdi=RIP, rsi=RSP) çağır. Kırmızı bölge (128 B) atlanır:
// derleyici bu asm'yi çağrı saymaz → yaprak işlevde yerelleri RSP altına koyabilir.
çıplak işlev kxr_gir(rip: tam64, rsp: tam64) {
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"movq $0, %rdi
movq $1, %rsi
subq $$128, %rsp
call kdl_x86_ring3_gir
addq $$128, %rsp"#
            girdi("r", rip) girdi("r", rsp)
            bozulan("~{rax}") bozulan("~{rcx}") bozulan("~{rdx}") bozulan("~{rsi}")
            bozulan("~{rdi}") bozulan("~{r8}") bozulan("~{r9}") bozulan("~{r10}")
            bozulan("~{r11}") bozulan("~{memory}") bozulan("~{cc}")
        }
    }
}

// RING3 KANITI (falsifiye edilebilir; 1 = hepsi doğru):
//   giriş 1: ring3'te CS okunur (RPL 3), int 0x80 getpid → çekirdek .kem servisi
//            çağıranın CS'ini 0x1B görür, dönüş değeri (rax) kullanıcıya ulaşır;
//            sonra `hlt` → #GP (vektör 13, RIP = giriş+9, CS 0x1B) → çekirdeğe dönüş.
//   giriş 2: kullanıcı gözetmen sayfayı okur → #PF hata 5 (P|U), CR2 = 0x100000.
// Taklit edilemez: DPL0 kapıda int 0x80 #GP verir (sc CS 0 kalır); CPL0'da `hlt`
// hata vermez; U/S'siz kullanıcı sayfası ilk komut getirmede #PF verir (vektör 14).
çıplak işlev kxr_ring3_testi() -> tam32 {
    değişken as: tam64 = kmmu_as_olustur(KXR_AS);
    eğer as == 0 { ver 0; }
    değişken pdpt: tam64 = as + 4096;
    değişken pd: tam64 = as + 8192;
    değişken pt: tam64 = as + 12288;
    değişken pa: tam64 = KMMU_OZEL_PA + KXR_AS * KMMU_2MB;
    // U/S YALNIZ bu alanın kendi tablolarında; kopyalanan çekirdek girdileri
    // (PDPT[0] 0..1 GB, PDPT[3] MMIO) gözetmen kalır → kullanıcı onlara erişemez.
    kxm_y64(as, pdpt + KXR_US_RW);                          // PML4[0]
    kxm_y64(pdpt + 8, pd + KXR_US_RW);                      // PDPT[1]
    kxm_y64(pd + KMMU_OZEL_IDX * 8, pt + KXR_US_RW);        // PD[160]
    kxm_y64(pt, pa + KXR_US_RX);                            // sayfa 0: kullanıcı KOD
    kxm_y64(pt + 511 * 8, KXM_NX_BIT + pa + 511 * KMMU_SAYFA + KXR_US_RW);  // sayfa 511: YIĞIN (NX)
    // Kullanıcı makine kodu (çekirdek identity görüşünden PA'ya).
    kxr_y8(pa + 0, 140);  kxr_y8(pa + 1, 201);              // movl %cs, %ecx
    kxr_y8(pa + 2, 184);  kxr_y8(pa + 3, 11);               // movl $11, %eax
    kxr_y8(pa + 4, 0);    kxr_y8(pa + 5, 0);    kxr_y8(pa + 6, 0);
    kxr_y8(pa + 7, 205);  kxr_y8(pa + 8, 128);              // int $0x80
    kxr_y8(pa + 9, 244);                                    // hlt
    kxr_y8(pa + 16, 184); kxr_y8(pa + 17, 0);  kxr_y8(pa + 18, 0);   // movl $0x100000, %eax
    kxr_y8(pa + 19, 16);  kxr_y8(pa + 20, 0);
    kxr_y8(pa + 21, 72);  kxr_y8(pa + 22, 139); kxr_y8(pa + 23, 0);  // movq (%rax), %rax
    kxr_tss_kur();
    değişken b: tam64 = kxr_blok_adr();
    değişken k: tam64 = kxm_cr3_oku();
    kmmu_as_gec(as);
    kxm_y64(b + 72, 0);                                     // son syscall CS'i temizle
    kxr_gir(KMMU_OZEL_VA, KXR_YIGIN_UST);                   // GİRİŞ 1
    değişken b1: tam64 = kxm_o64(b);
    değişken v1: tam64 = kxm_o64(b + 16);
    değişken h1: tam64 = kxm_o64(b + 24);
    değişken r1: tam64 = kxm_o64(b + 32);
    değişken c1: tam64 = kxm_o64(b + 40);
    değişken ax1: tam64 = kxm_o64(b + 48);
    değişken cx1: tam64 = kxm_o64(b + 56);
    değişken sc: tam64 = kxm_o64(b + 72);
    kxr_gir(KMMU_OZEL_VA + 16, KXR_YIGIN_UST);              // GİRİŞ 2
    değişken b2: tam64 = kxm_o64(b);
    değişken v2: tam64 = kxm_o64(b + 16);
    değişken h2: tam64 = kxm_o64(b + 24);
    değişken r2: tam64 = kxm_o64(b + 32);
    değişken c2: tam64 = kxm_o64(b + 40);
    değişken f2: tam64 = kxm_o64(b + 64);
    kmmu_as_gec(k);                                         // çekirdek alanına dön
    değişken pid: tam64 = kem_syscall_temel(KXR_GETPID, 0); // çekirdeğin KENDİ yanıtı
    eğer (b1 == 0) ve (v1 == KXR_GP) ve (h1 == 0) ve (r1 == KMMU_OZEL_VA + 9)
       ve (c1 == KXR_KOD_SEL) ve ((cx1 % 65536) == KXR_KOD_SEL)
       ve (sc == KXR_KOD_SEL) ve (ax1 == pid)
       ve (b2 == 0) ve (v2 == KXR_PF) ve (h2 == KXR_PF_KUL_OKU)
       ve (r2 == KMMU_OZEL_VA + 21) ve (c2 == KXR_KOD_SEL) ve (f2 == KXR_GOZETMEN_VA) {
        ver 1;
    }
    ver 0;
}

// [D-705] x86_64 ring3 dosya sistemi kanıtı (arm64 kem_os.kem [13] FS SYSCALL ikizi):
// kullanıcı kipinden gerçek virtio diske dosya_yaz(17) / dosya_oku(18) / yaz(5) —
// round-trip tamponu 0x541FF000'a yazılır; sonra D-610 çekirdek işaretçisi (0x100000)
// reddi (rax = -1) ve hlt → #GP kanıtlanır. int 0x80 → kdl_syscall_isle → kem_syscall_kul;
// kg_kul_min/max penceresi [0x54000000,0x54200000) doğrulanır.
sabit KXR_FS_AS: tam64 = 4;              // adres alanı #4 (0/1 izolasyon, 2 W^X, 3 ring3)
sabit KXR_FS_HLT: tam64 = 58;            // kullanıcı programında hlt ofseti
sabit KXR_FS_AD_OFS: tam64 = 256;        // "test" (0x54000100)
sabit KXR_FS_ICERIK_OFS: tam64 = 272;    // "KEMGU-X86" (0x54000110)
sabit KXR_FS_BUF_OFS: tam64 = 2093056;   // yığın sayfası 511 başı (0x541FF000) = okuma tamponu
çıplak işlev kxr_fs_testi() -> tam32 {
    değişken as: tam64 = kmmu_as_olustur(KXR_FS_AS);
    eğer as == 0 { ver 0; }
    değişken pdpt: tam64 = as + 4096;
    değişken pd: tam64 = as + 8192;
    değişken pt: tam64 = as + 12288;
    değişken pa: tam64 = KMMU_OZEL_PA + KXR_FS_AS * KMMU_2MB;
    // U/S YALNIZ bu alanın kendi tablolarında; kopyalanan çekirdek girdileri
    // (PDPT[0] 0..1 GB, PDPT[3] MMIO) gözetmen kalır → kullanıcı onlara erişemez.
    kxm_y64(as, pdpt + KXR_US_RW);
    kxm_y64(pdpt + 8, pd + KXR_US_RW);
    kxm_y64(pd + KMMU_OZEL_IDX * 8, pt + KXR_US_RW);
    kxm_y64(pt, pa + KXR_US_RX);
    kxm_y64(pt + 511 * 8, KXM_NX_BIT + pa + 511 * KMMU_SAYFA + KXR_US_RW);
    // Kullanıcı programı (59 bayt, llvm-mc ile derlendi).
    kxr_y8(pa + 0, 184);
    kxr_y8(pa + 1, 17);
    kxr_y8(pa + 2, 0);
    kxr_y8(pa + 3, 0);
    kxr_y8(pa + 4, 0);
    kxr_y8(pa + 5, 191);
    kxr_y8(pa + 6, 0);
    kxr_y8(pa + 7, 1);
    kxr_y8(pa + 8, 0);
    kxr_y8(pa + 9, 84);
    kxr_y8(pa + 10, 186);
    kxr_y8(pa + 11, 16);
    kxr_y8(pa + 12, 1);
    kxr_y8(pa + 13, 0);
    kxr_y8(pa + 14, 84);
    kxr_y8(pa + 15, 205);
    kxr_y8(pa + 16, 128);
    kxr_y8(pa + 17, 184);
    kxr_y8(pa + 18, 18);
    kxr_y8(pa + 19, 0);
    kxr_y8(pa + 20, 0);
    kxr_y8(pa + 21, 0);
    kxr_y8(pa + 22, 191);
    kxr_y8(pa + 23, 0);
    kxr_y8(pa + 24, 1);
    kxr_y8(pa + 25, 0);
    kxr_y8(pa + 26, 84);
    kxr_y8(pa + 27, 186);
    kxr_y8(pa + 28, 0);
    kxr_y8(pa + 29, 240);
    kxr_y8(pa + 30, 31);
    kxr_y8(pa + 31, 84);
    kxr_y8(pa + 32, 205);
    kxr_y8(pa + 33, 128);
    kxr_y8(pa + 34, 184);
    kxr_y8(pa + 35, 5);
    kxr_y8(pa + 36, 0);
    kxr_y8(pa + 37, 0);
    kxr_y8(pa + 38, 0);
    kxr_y8(pa + 39, 191);
    kxr_y8(pa + 40, 0);
    kxr_y8(pa + 41, 240);
    kxr_y8(pa + 42, 31);
    kxr_y8(pa + 43, 84);
    kxr_y8(pa + 44, 205);
    kxr_y8(pa + 45, 128);
    kxr_y8(pa + 46, 184);
    kxr_y8(pa + 47, 5);
    kxr_y8(pa + 48, 0);
    kxr_y8(pa + 49, 0);
    kxr_y8(pa + 50, 0);
    kxr_y8(pa + 51, 191);
    kxr_y8(pa + 52, 0);
    kxr_y8(pa + 53, 0);
    kxr_y8(pa + 54, 16);
    kxr_y8(pa + 55, 0);
    kxr_y8(pa + 56, 205);
    kxr_y8(pa + 57, 128);
    kxr_y8(pa + 58, 244);
    // "test" @ pa+256
    kxr_y8(pa + KXR_FS_AD_OFS + 0, 116);
    kxr_y8(pa + KXR_FS_AD_OFS + 1, 101);
    kxr_y8(pa + KXR_FS_AD_OFS + 2, 115);
    kxr_y8(pa + KXR_FS_AD_OFS + 3, 116);
    kxr_y8(pa + KXR_FS_AD_OFS + 4, 0);
    // "KEMGU-X86" @ pa+272
    kxr_y8(pa + KXR_FS_ICERIK_OFS + 0, 75);
    kxr_y8(pa + KXR_FS_ICERIK_OFS + 1, 69);
    kxr_y8(pa + KXR_FS_ICERIK_OFS + 2, 77);
    kxr_y8(pa + KXR_FS_ICERIK_OFS + 3, 71);
    kxr_y8(pa + KXR_FS_ICERIK_OFS + 4, 85);
    kxr_y8(pa + KXR_FS_ICERIK_OFS + 5, 45);
    kxr_y8(pa + KXR_FS_ICERIK_OFS + 6, 88);
    kxr_y8(pa + KXR_FS_ICERIK_OFS + 7, 56);
    kxr_y8(pa + KXR_FS_ICERIK_OFS + 8, 54);
    kxr_y8(pa + KXR_FS_ICERIK_OFS + 9, 0);
    // Okuma tamponunun ilk 16 baytını sıfırla.
    kxr_y8(pa + KXR_FS_BUF_OFS + 0, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 1, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 2, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 3, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 4, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 5, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 6, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 7, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 8, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 9, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 10, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 11, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 12, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 13, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 14, 0);
    kxr_y8(pa + KXR_FS_BUF_OFS + 15, 0);
    kxr_tss_kur();
    değişken b: tam64 = kxr_blok_adr();
    değişken k: tam64 = kxm_cr3_oku();
    kmmu_as_gec(as);
    kxr_gir(KMMU_OZEL_VA, KXR_YIGIN_UST);
    değişken bk: tam64 = kxm_o64(b);
    değişken v: tam64 = kxm_o64(b + 16);
    değişken r: tam64 = kxm_o64(b + 32);
    değişken ax: tam64 = kxm_o64(b + 48);
    kmmu_as_gec(k);
    eğer (bk == 0) ve (v == KXR_GP) ve (r == KMMU_OZEL_VA + KXR_FS_HLT) ve (ax == 0 - 1)
       ve (kis_buf_oku8(pa + KXR_FS_BUF_OFS + 0, 0) == 75)
       ve (kis_buf_oku8(pa + KXR_FS_BUF_OFS + 1, 0) == 69)
       ve (kis_buf_oku8(pa + KXR_FS_BUF_OFS + 2, 0) == 77)
       ve (kis_buf_oku8(pa + KXR_FS_BUF_OFS + 3, 0) == 71)
       ve (kis_buf_oku8(pa + KXR_FS_BUF_OFS + 4, 0) == 85)
       ve (kis_buf_oku8(pa + KXR_FS_BUF_OFS + 5, 0) == 45)
       ve (kis_buf_oku8(pa + KXR_FS_BUF_OFS + 6, 0) == 88)
       ve (kis_buf_oku8(pa + KXR_FS_BUF_OFS + 7, 0) == 56)
       ve (kis_buf_oku8(pa + KXR_FS_BUF_OFS + 8, 0) == 54)
       ve (kis_buf_oku8(pa + KXR_FS_BUF_OFS + 9, 0) == 0) {
        ver 1;
    }
    ver 0;
}

// [D-707] x86_64 ring3 UART satır okuma kanıtı (arm64 kem_os.kem [12] UART RX ikizi):
// kullanıcı kipinden sistem çağrısı 26 (kis_satir_oku, kem_gorev_cekirdek.kem) seri
// girdiden bir satırı KENDİ yığın sayfasına (0x541FF000) okur, dönen uzunluğu 0x541FF100'e
// yazar, satırı 5 (yaz) ile geri basar (yankı); sonra 26'yı ÇEKİRDEK adresiyle çağırır
// (D-610 reddi: rax = -1) ve hlt → #GP ile çekirdeğe döner. Donanım kancaları 16550
// (kem_uart.kem: LSR 0x3FD bit0, veri 0x3F8). Sonuç: 1 = satır "KEMGU-RX" okundu (uzunluk 8,
// sonlandırıcı yazıldı); 2 = girdi yok → EOF (-1, tampon[0] = 0); 0 = yapısal hata.
// İKİ sonuç da AYNI imajdan: normal koşumda seri girdi yok (EOF), Makefile Kanıt 29'un
// ayrı koşumunda `-chardev file,input-path=` satırı verir (OK + yankı satırı).
//
// Kullanıcı programı (55 bayt, llvm-mc -show-encoding ile üretildi):
//   0  b8 1a 00 00 00          movl $26, %eax
//   5  bf 00 f0 1f 54          movl $0x541FF000, %edi    (tampon)
//   10 ba 40 00 00 00          movl $64, %edx            (azami)
//   15 cd 80                   int  $0x80
//   17 48 89 04 25 00 f1 1f 54 movq %rax, 0x541FF100     (dönen uzunluk)
//   25 b8 05 00 00 00          movl $5, %eax
//   30 bf 00 f0 1f 54          movl $0x541FF000, %edi
//   35 cd 80                   int  $0x80                (yankı)
//   37 b8 1a 00 00 00          movl $26, %eax
//   42 bf 00 00 10 00          movl $0x100000, %edi      (çekirdek adresi → red)
//   47 ba 40 00 00 00          movl $64, %edx
//   52 cd 80                   int  $0x80
//   54 f4                      hlt                       (→ #GP, vektör 13)
sabit KXR_RX_AS: tam64 = 5;              // adres alanı #5 (son yuva; KMMU_AS_AZAMI = 6)
sabit KXR_RX_HLT: tam64 = 54;            // kullanıcı programında hlt ofseti
sabit KXR_RX_BUF_OFS: tam64 = 2093056;   // 0x541FF000 - 0x54000000 (yığın sayfası 511)
sabit KXR_RX_UZ_OFS: tam64 = 2093312;    // 0x541FF100 - 0x54000000 (dönen uzunluk)
sabit KXR_RX_NOBET: tam64 = 7777;        // uzunluk yuvası nöbetçisi (yazılmadıysa kalır)
sabit KXR_RX_DOLGU: tam32 = 170;         // tampon nöbetçisi 0xAA (sonlandırıcı kanıtı)
çıplak işlev kxr_rx_testi() -> tam32 {
    değişken as: tam64 = kmmu_as_olustur(KXR_RX_AS);
    eğer as == 0 { ver 0; }
    değişken pdpt: tam64 = as + 4096;
    değişken pd: tam64 = as + 8192;
    değişken pt: tam64 = as + 12288;
    değişken pa: tam64 = KMMU_OZEL_PA + KXR_RX_AS * KMMU_2MB;
    kxm_y64(as, pdpt + KXR_US_RW);
    kxm_y64(pdpt + 8, pd + KXR_US_RW);
    kxm_y64(pd + KMMU_OZEL_IDX * 8, pt + KXR_US_RW);
    kxm_y64(pt, pa + KXR_US_RX);
    kxm_y64(pt + 511 * 8, KXM_NX_BIT + pa + 511 * KMMU_SAYFA + KXR_US_RW);
    // Kullanıcı programı (55 bayt, llvm-mc ile derlendi).
    kxr_y8(pa + 0, 184);
    kxr_y8(pa + 1, 26);
    kxr_y8(pa + 2, 0);
    kxr_y8(pa + 3, 0);
    kxr_y8(pa + 4, 0);
    kxr_y8(pa + 5, 191);
    kxr_y8(pa + 6, 0);
    kxr_y8(pa + 7, 240);
    kxr_y8(pa + 8, 31);
    kxr_y8(pa + 9, 84);
    kxr_y8(pa + 10, 186);
    kxr_y8(pa + 11, 64);
    kxr_y8(pa + 12, 0);
    kxr_y8(pa + 13, 0);
    kxr_y8(pa + 14, 0);
    kxr_y8(pa + 15, 205);
    kxr_y8(pa + 16, 128);
    kxr_y8(pa + 17, 72);
    kxr_y8(pa + 18, 137);
    kxr_y8(pa + 19, 4);
    kxr_y8(pa + 20, 37);
    kxr_y8(pa + 21, 0);
    kxr_y8(pa + 22, 241);
    kxr_y8(pa + 23, 31);
    kxr_y8(pa + 24, 84);
    kxr_y8(pa + 25, 184);
    kxr_y8(pa + 26, 5);
    kxr_y8(pa + 27, 0);
    kxr_y8(pa + 28, 0);
    kxr_y8(pa + 29, 0);
    kxr_y8(pa + 30, 191);
    kxr_y8(pa + 31, 0);
    kxr_y8(pa + 32, 240);
    kxr_y8(pa + 33, 31);
    kxr_y8(pa + 34, 84);
    kxr_y8(pa + 35, 205);
    kxr_y8(pa + 36, 128);
    kxr_y8(pa + 37, 184);
    kxr_y8(pa + 38, 26);
    kxr_y8(pa + 39, 0);
    kxr_y8(pa + 40, 0);
    kxr_y8(pa + 41, 0);
    kxr_y8(pa + 42, 191);
    kxr_y8(pa + 43, 0);
    kxr_y8(pa + 44, 0);
    kxr_y8(pa + 45, 16);
    kxr_y8(pa + 46, 0);
    kxr_y8(pa + 47, 186);
    kxr_y8(pa + 48, 64);
    kxr_y8(pa + 49, 0);
    kxr_y8(pa + 50, 0);
    kxr_y8(pa + 51, 0);
    kxr_y8(pa + 52, 205);
    kxr_y8(pa + 53, 128);
    kxr_y8(pa + 54, 244);
    // Tampon (16 B) nöbetçiyle dolu, uzunluk yuvası nöbetçili.
    değişken d: tam32 = 0;
    iken d < 16 { kis_buf_yaz8(pa + KXR_RX_BUF_OFS, d, KXR_RX_DOLGU); d = d + 1; }
    kxm_y64(pa + KXR_RX_UZ_OFS, KXR_RX_NOBET);
    kxr_tss_kur();
    değişken b: tam64 = kxr_blok_adr();
    değişken k: tam64 = kxm_cr3_oku();
    kmmu_as_gec(as);
    kxr_gir(KMMU_OZEL_VA, KXR_YIGIN_UST);
    değişken bk: tam64 = kxm_o64(b);
    değişken v: tam64 = kxm_o64(b + 16);
    değişken r: tam64 = kxm_o64(b + 32);
    değişken ax: tam64 = kxm_o64(b + 48);
    kmmu_as_gec(k);
    değişken uz: tam64 = kxm_o64(pa + KXR_RX_UZ_OFS);
    değişken t: tam64 = pa + KXR_RX_BUF_OFS;
    // Yapısal: hlt'e kadar koştu (#GP, doğru RIP) ve çekirdek-adresli 26 REDDEDİLDİ.
    eğer (bk != 0) veya (v != KXR_GP) veya (r != KMMU_OZEL_VA + KXR_RX_HLT) veya (ax != 0 - 1) {
        ver 0;
    }
    eğer (uz == 8)
       ve (kis_buf_oku8(t, 0) == 75) ve (kis_buf_oku8(t, 1) == 69)
       ve (kis_buf_oku8(t, 2) == 77) ve (kis_buf_oku8(t, 3) == 71)
       ve (kis_buf_oku8(t, 4) == 85) ve (kis_buf_oku8(t, 5) == 45)
       ve (kis_buf_oku8(t, 6) == 82) ve (kis_buf_oku8(t, 7) == 88)
       ve (kis_buf_oku8(t, 8) == 0) {
        ver 1;                                  // "KEMGU-RX" + sonlandırıcı
    }
    eğer (uz == 0 - 1) ve (kis_buf_oku8(t, 0) == 0) { ver 2; }   // EOF
    ver 0;
}
