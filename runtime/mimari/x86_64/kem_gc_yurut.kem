// Ortak bare-metal GcIstek yürütücüsü; aynı birimde kem_pci_hw ve kem_uart ister.
// D-745 DMA okuma sırası ve genişliği korunur.
kullan drivers::ortak::gc::{ GcIstek, GcYanit, gc_bos };
kullan drivers::ortak::bayt::{ bayt_sifir, oku_u8, yaz_u8 };

işlev bm_yaz(m: metin) {
    değişken i: tam32 = 0;
    değişken n: tam32 = metin_uzunluk(m) olarak tam32;
    iken i < n { kem_uart_bayt((metin_bayt(m, i) olarak tam32) & 255); i = i + 1; }
    kem_uart_bayt(10);
}

// [D-745] Aygıttan gelen veriyi YIRTILMADAN oku. Aygıt (QEMU'da ayrı iş parçacığı,
// gerçek donanımda PCIe) girdiyi artan adreste 8 baytlık parçalarla yazar; bayt bayt
// okumak NVMe tamamlama girdisinde komut kimliğini (bayt 12-13) ESKİ, faz bitini
// (bayt 14) YENİ görebilir (ölçüldü: "nvme tamamlanma kimligi", gecikmeyle kayboluyor).
// Hizalı 8 baytlık okuma + AZALAN sıra: üst parça yeniyse altı da (TSO, artan yazım) yenidir.
işlev bm_bellek_oku(a: tam64, n: tam32) -> Dizi<dtam8> {
    değişken b: Dizi<dtam8> = [];
    eğer a % 8 == 0 ve n % 8 == 0 {
        değişken kelimeler: Dizi<tam64> = [];
        değişken k: tam32 = 0;
        iken k < n / 8 { dizi_ekle(kelimeler, 0); k = k + 1; }
        k = n / 8 - 1;
        iken k >= 0 { dizi_yaz(kelimeler, k, kem_mmio_oku64(a + (k olarak tam64) * 8)); k = k - 1; }
        k = 0;
        iken k < n / 8 {
            değişken w: tam64 = dizi_al(kelimeler, k);
            değişken j: tam32 = 0;
            iken j < 8 { dizi_ekle(b, (((w >> (j * 8)) & 255) olarak tam32) olarak dtam8); j = j + 1; }
            k = k + 1;
        }
        ver b;
    }
    değişken i: tam32 = 0;
    iken i < n { dizi_ekle(b, kem_fiz_oku8(a + (i olarak tam64)) olarak dtam8); i = i + 1; }
    ver b;
}

// PIT kanal 2 tek atım. BIOS kesmelerini ve LAPIC kalibrasyonunun kanal 0'ını kullanmaz.
// 1.193.182 Hz * 0,010 s = 11.932 sayaç. Hoparlör çıkışı ölçüm boyunca kapalı.
küresel değişken bm_cevrim_us: tam64 = 0;
çıplak işlev bm_pit_olc() -> tam64 {
    değişken ilk: tam32 = kem_port_oku8(97 olarak dtam16) olarak tam32;
    kem_port_yaz8(97 olarak dtam16, (ilk&252) olarak dtam8);
    kem_port_yaz8(67 olarak dtam16, 176 olarak dtam8);
    kem_port_yaz8(66 olarak dtam16, 156 olarak dtam8);
    kem_port_yaz8(66 olarak dtam16, 46 olarak dtam8);
    eğer ((kem_port_oku8(97 olarak dtam16) olarak tam32)&32) != 0 {
        kem_port_yaz8(97 olarak dtam16, ilk olarak dtam8); ver -1;
    }
    değişken bas: tam64 = bm_tsc_oku();
    kem_port_yaz8(97 olarak dtam16, ((ilk&252)|1) olarak dtam8);
    değişken tur: tam32 = 0;
    iken tur < 1000000 ve ((kem_port_oku8(97 olarak dtam16) olarak tam32)&32) == 0 {
        tur=tur+1;
    }
    değişken sure: tam64 = (bm_tsc_oku()-bas)/10000;
    kem_port_yaz8(97 olarak dtam16, ilk olarak dtam8);
    eğer tur == 1000000 veya sure <= 0 { ver -1; }
    ver sure;
}
işlev bm_gc_bekle(us: tam32) -> mantıksal {
    eğer us == 0 { ver doğru; }
    eğer us < 0 veya us > 1000000 { bm_yaz("KABUK HATA GC bekleme araligi"); ver yanlış; }
    güvensiz {
        eğer bm_cevrim_us == 0 {
            bm_cevrim_us=bm_pit_olc();
            eğer bm_cevrim_us < 0 { bm_yaz("KABUK HATA PIT kanal2 zaman asimi"); }
        }
        eğer bm_cevrim_us < 0 { ver yanlış; }
        değişken bas: tam64 = bm_tsc_oku();
        değişken hedef: tam64 = bm_cevrim_us*(us olarak tam64);
        değişken tur: tam64 = 0;
        iken tur < 1000000+(us olarak tam64)*1000 {
            eğer bm_tsc_oku()-bas >= hedef { ver doğru; }
            tur=tur+1;
        }
        bm_yaz("KABUK HATA TSC bekleme zaman asimi"); ver yanlış;
    }
}

// GcIstek → gerçek donanım (qt_yurut'un bare-metal ikizi).
işlev bm_yurut(bar: tam64, i: GcIstek) -> GcYanit {
    değişken y: GcYanit = gc_bos();
    eşleş i {
        GcIstek::Oku32(a) => { y.deger = kem_mmio_oku32(bar + a); }
        GcIstek::Oku64(a) => { y.deger = kem_mmio_oku64(bar + a); }
        GcIstek::Yaz32(a, v) => { kem_mmio_yaz32(bar + a, v); }
        GcIstek::Yaz64(a, v) => { kem_mmio_yaz64(bar + a, v); }
        GcIstek::BellekOku(a, n) => { y.baytlar = bm_bellek_oku(a, n); }
        GcIstek::BellekYaz(a, b) => {
            değişken k: tam32 = 0;
            iken k < dizi_boyut(b) { kem_fiz_yaz8(a + (k olarak tam64), dizi_al(b, k) olarak tam32); k = k + 1; }
        }
        GcIstek::Bekle(us) => { y.basarili = bm_gc_bekle(us); }
        _ => { }
    }
    ver y;
}

// Firmware'in numaralandırdığı köprü pencerelerini koru. Sıfır numaralı
// köprüye kardeşlerin ayrılmış pencerelerinden sonra yeni bir aralık ver.
işlev kem_pci_yol_tara(bus: tam32,sinir: tam32,goruldu: Dizi<dtam8>,islevler: Dizi<tam32>) -> tam32 {
    eğer bus < 0 veya bus > sinir veya oku_u8(goruldu,bus) != 0 { ver bus; }
    yaz_u8(goruldu,bus,1);
    değişken kopruler: Dizi<tam32> = [];
    değişken son: tam32 = bus;
    değişken devfn: tam32 = 0;
    iken devfn < 256 {
        değişken bdf: tam32 = bus*256+devfn;
        eğer (kem_pci_oku32(bdf,0)&65535) != 65535 {
            dizi_ekle(islevler,bdf);
            eğer (kem_pci_oku32(bdf,8)>>16) == 1540 {
                dizi_ekle(kopruler,bdf);
                değişken v: tam64 = kem_pci_oku32(bdf,24);
                değişken ikincil: tam32 = ((v>>8)&255) olarak tam32;
                değişken alt: tam32 = ((v>>16)&255) olarak tam32;
                eğer ikincil > bus ve ikincil <= alt ve alt <= sinir ve alt > son { son=alt; }
            }
        }
        devfn=devfn+1;
    }
    için kopru: kopruler {
        değişken v: tam64 = kem_pci_oku32(kopru,24);
        değişken ikincil: tam32 = ((v>>8)&255) olarak tam32;
        değişken alt: tam32 = ((v>>16)&255) olarak tam32;
        // Firmware bir numara ayırmış ama alt sınırı kurmamışsa aynı ikincil yolu koru.
        eğer (ikincil == 0 ve son < sinir) veya (ikincil > bus ve ikincil <= sinir ve alt < ikincil) {
            eğer ikincil == 0 { ikincil=son+1; }
            alt=sinir;
            için diger: kopruler {
                değişken sonraki: tam32 = ((kem_pci_oku32(diger,24)>>8)&255) olarak tam32;
                eğer sonraki > ikincil ve sonraki <= alt { alt=sonraki-1; }
            }
            değişken ayar: tam64 = (v&4278190080)|((alt olarak tam64)<<16)|((ikincil olarak tam64)<<8)|(bus olarak tam64);
            kem_pci_yaz32(kopru,24,ayar);
            değişken kullanilan: tam32 = kem_pci_yol_tara(ikincil,alt,goruldu,islevler);
            eğer kullanilan > son { son=kullanilan; }
            kem_pci_yaz32(kopru,24,(ayar&4278255615)|((kullanilan olarak tam64)<<16));
        } değilse eğer (v&255) == (bus olarak tam64) ve ikincil > bus ve ikincil <= alt ve alt <= sinir {
            kem_pci_yol_tara(ikincil,alt,goruldu,islevler);
        }
    }
    ver son;
}
işlev kem_pci_islevler() -> Dizi<tam32> {
    değişken sonuc: Dizi<tam32> = [];
    değişken goruldu: Dizi<dtam8> = bayt_sifir(256);
    kem_pci_yol_tara(0,255,goruldu,sonuc);
    ver sonuc;
}
işlev bm_pci_bul(sinif: tam32, alt_sinif: tam32, prog_if: tam32) -> sonuç<tam32, metin> {
    değişken hedef: tam64 = ((sinif olarak tam64)<<16)|((alt_sinif olarak tam64)<<8)|(prog_if olarak tam64);
    için bdf: kem_pci_islevler() {
        eğer (kem_pci_oku32(bdf,8)>>8) == hedef { ver tamam(bdf); }
    }
    ver hata("PCI aygiti bulunamadi");
}

// Kabuk/satır/yol bağımlılıkları: C runtime sözleşmesinin mevcut çıplak ilkellerle eşi.
// Ham erişim yalnız izinli yürütücüde; sürücüler saf kalır.
çıplak işlev kdl_metin_esit(a: *tam8, b: *tam8) -> mantıksal {
    eğer (a olarak tam64) == (b olarak tam64) { ver doğru; }
    eğer (a olarak tam64) == 0 veya (b olarak tam64) == 0 { ver yanlış; }
    değişken i: tam64 = 0;
    iken doğru {
        değişken pa: *dtam8 = ((a olarak tam64)+i) olarak *dtam8;
        değişken pb: *dtam8 = ((b olarak tam64)+i) olarak *dtam8;
        eğer *pa != *pb { ver yanlış; }
        eğer *pa == (0 olarak dtam8) { ver doğru; }
        i=i+1;
    } ver yanlış;
}
çıplak işlev kdl_metin_kes(s: *tam8, baslangic: tam32, uzunluk: tam32) -> *tam8 {
    eğer (s olarak tam64) == 0 { ver s; }
    değişken n: tam32 = kem_strlen(s) olarak tam32;
    eğer baslangic < 0 { baslangic=0; } eğer baslangic > n { baslangic=n; }
    değişken kalan: tam32 = n-baslangic;
    eğer uzunluk < 0 veya uzunluk > kalan { uzunluk=kalan; }
    değişken out: *tam8 = kdl_bolge_ayir(kdl_global_bolge_al(),(uzunluk olarak tam64)+1);
    eğer (out olarak tam64) == 0 { ver out; }
    memcpy(out,((s olarak tam64)+(baslangic olarak tam64)) olarak *tam8,uzunluk olarak tam64);
    kem_bayt_yaz((out olarak tam64)+(uzunluk olarak tam64),0);
    ver out;
}
