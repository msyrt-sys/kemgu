// Her canlı süreç kendi sayfa tablolarını ve LAPIC dönüş çerçevesini taşır.
kullan drivers::elf::elf64::{ Elf64, elf64_plan };

// Eski v2 ELF'leri kendi giriş adresinden tanınır. Yeni pencere onun bitişinden başlar.
yapı KxsYer { alt: tam64; heap: tam64; heap_son: tam64; yigin: tam64; ust: tam64; tablo: tam32; }
çıplak işlev kxs_yer(giris: tam64) -> KxsYer {
    eğer giris < KG_USER_MAX {
        ver KxsYer {alt:KG_USER_MIN,heap:1410334720,heap_son:1411313664,yigin:1411317760,ust:KG_USER_MAX,tablo:4};
    }
    ver KxsYer {alt:1411383296,heap:1415577600,heap_son:1423966208,yigin:1425014784,ust:1426063360,tablo:10};
}
çıplak işlev kxs_cerceve_sayisi(yer: KxsYer) -> tam32 {
    ver yer.tablo+((yer.ust-yer.alt)/4096) olarak tam32;
}
küresel değişken kxs_alt: tam64 = 0;
küresel değişken kxs_ust: tam64 = 0;
sabit KXS_ADRES_MASKESI: tam64 = 4503599627366400;
sabit KX_SIS_YAZ: tam64 = 44;
sabit KX_HATA_BADF: tam64 = 9;
sabit KX_HATA_FAULT: tam64 = 14;
sabit KX_HATA_INVAL: tam64 = 22;

küresel değişken kxs_ek_vekil: tam64 = 0;
küresel değişken kxs_cikis_eslendi: mantıksal = yanlış;
küresel değişken kxs_pt: tam64 = 0;
küresel değişken kxs_pid_son: tam64 = 0;
küresel değişken kxs_pid: tam64 = 0;
sabit KXS_BOS: tam64 = 0;
sabit KXS_HAZIR: tam64 = 1;
sabit KXS_KOSUYOR: tam64 = 2;
sabit KXS_BITTI: tam64 = 3;
sabit KXS_OLDURULDU: tam64 = 4;
sabit KXS_KABUK_PID: tam64 = 0;
küresel değişken kxs_durum: tam64 = 0;
küresel değişken kxs_cr3: tam64 = 0;
küresel değişken kxs_cikis_kodu: tam64 = 0;
küresel değişken kxs_tss_var: tam64 = 0;
küresel değişken kxs_heap_giris: tam64 = 0;
küresel değişken kxs_heap_cikis: tam64 = 0;
// Her süreç kaydı: donanım çerçevesi ve çekirdek sahipli durum alanları.
sabit KXS_YUVA_ADEDI: tam64 = 8;
sabit KXS_KAYIT_BOYU: tam64 = 272;
sabit KXS_DURUM_OFS: tam64 = 160;
sabit KXS_PID_OFS: tam64 = 168;
sabit KXS_CIKIS_OFS: tam64 = 176;
sabit KXS_DILIM_OFS: tam64 = 184;
sabit KXS_CR3_OFS: tam64 = 192;
sabit KXS_VEKTOR_OFS: tam64 = 200;
sabit KXS_HATA_OFS: tam64 = 208;
sabit KXS_RIP_OFS: tam64 = 216;
sabit KXS_CR2_OFS: tam64 = 224;
sabit KXS_EBEVEYN_OFS: tam64 = 232;
sabit KXS_UYUYOR: tam64 = 5;
sabit KXS_COCUK_BEKLIYOR: tam64 = 6;
sabit KXS_BORU_BEKLIYOR: tam64 = 8;
sabit KXS_TUS_BEKLIYOR: tam64 = 7;
sabit KXS_OLAY_OFS: tam64 = 240;
küresel değişken kxs_etkin_kayit: tam64 = 0;
küresel değişken kxs_ana_cr3: tam64 = 0;
küresel değişken kxs_on_pid: tam64 = 0;

çıplak işlev kxs_beklet(durum: tam64, olay: tam64, tekrar: tam64) -> tam64 {
    kxs_durum=durum;
    kxm_y64(kxs_etkin_kayit+KXS_OLAY_OFS,olay);
    kxm_y64(kxs_etkin_kayit+248,tekrar);
    ver 0;
}
çıplak işlev kxs_pid_yuva(pid: tam64) -> tam64 {
    eğer pid <= 0 { ver -1; }
    değişken i: tam64 = 0;
    iken i < KXS_YUVA_ADEDI {
        değişken r: tam64 = kxs_baglam(i);
        eğer kxm_o64(r+KXS_DURUM_OFS) != KXS_BOS ve kxm_o64(r+KXS_PID_OFS) == pid { ver i; }
        i=i+1;
    }
    ver -1;
}
küresel değişken kxs_havuz_dolu: tam64 = 0;
çıplak işlev kxs_yuva_ayir() -> tam64 {
    değişken n: tam64 = 0;
    iken n < KXS_YUVA_ADEDI {
        değişken i: tam64 = ((kxs_pid_son % KXS_YUVA_ADEDI) + n) % KXS_YUVA_ADEDI;
        eğer kxm_o64(kxs_baglam(i)+KXS_DURUM_OFS) == KXS_BOS {
            kxs_havuz_dolu=kxs_havuz_dolu | (1 << i);
            ver i;
        }
        n=n+1;
    }
    ver 0-1;
}
çıplak işlev kxs_yuva_serbest(i: tam64) {
    kxs_havuz_dolu=kxs_havuz_dolu & (255 ^ (1 << i));
}

yapı KxsSonuc { pid: tam64; ebeveyn: tam64; bitti: mantıksal; kod: tam64; vektor: tam64; hata_kodu: tam64; rip: tam64; cr2: tam64; }

çıplak işlev kxs_tablo_kopya(hedef: tam64, kaynak: tam64) {
    değişken i: tam64 = 0;
    iken i < 4096 {
        // Kopyalanan çekirdek dalları yalnız gözetmen.
        kxm_y64(hedef + i, kxm_o64(kaynak + i) & (0 - 5));
        i = i + 8;
    }
}

çıplak işlev kxs_tablo_kur(taban: tam64, ana: tam64, yer: KxsYer) {
    değişken kp: tam64 = kxm_o64(ana) & KXS_ADRES_MASKESI;
    değişken kd: tam64 = kxm_o64(kp + 8) & KXS_ADRES_MASKESI;
    kxs_tablo_kopya(taban, ana);
    kxs_tablo_kopya(taban + 4096, kp);
    kxs_tablo_kopya(taban + 8192, kd);
    kxm_y64(taban, (taban + 4096) | 7);
    kxm_y64(taban + 4096 + 8, (taban + 8192) | 7);
    değişken i: tam64 = 0;
    iken i < (yer.tablo-3) olarak tam64 {
        kxm_y64(taban+8192+(((yer.alt>>21)&511)+i)*8,(taban+12288+i*4096)|7);
        i=i+1;
    }
}
çıplak işlev kxs_esle(taban: tam64, yer: KxsYer, va: tam64, son: tam64, izin: tam64) {
    değişken a: tam64 = va;
    iken a < son {
        değişken fark: tam64 = a - yer.alt;
        kxm_y64(taban + 12288 + (fark / 4096) * 8, (taban + (yer.tablo olarak tam64)*4096 + fark) | izin);
        a = a + 4096;
    }
}

çıplak işlev kxs_aralik(p: tam64, n: tam64, yaz: mantıksal) -> mantıksal {
    eğer p < kxs_alt veya p >= kxs_ust veya n < 0 veya n > kxs_ust - p { ver yanlış; }
    eğer n == 0 { ver doğru; }
    değişken maske: tam64 = 5;
    eğer yaz { maske = 7; }
    değişken i: tam64 = (p - kxs_alt) / 4096;
    değişken son: tam64 = (p - kxs_alt + n - 1) / 4096;
    iken i <= son {
        eğer (kxm_o64(kxs_pt + i * 8) & maske) != maske { ver yanlış; }
        i = i + 1;
    }
    ver doğru;
}

çıplak işlev kxs_dize_boyu(p: tam64, azami: tam64) -> tam64 {
    değişken i: tam64 = 0;
    eğer p < kxs_alt veya p >= kxs_ust { ver 0 - KX_HATA_FAULT; }
    iken i < azami {
        eğer değil kxs_aralik(p+i, 1, yanlış) { ver 0 - KX_HATA_FAULT; }
        eğer kis_buf_oku8(p+i, 0) == 0 { ver i; }
        i = i + 1;
    }
    ver 0 - 36;
}
// Arka plan çıktısı satır tamamlanıncaya kadar süreç yuvasında tutulur.
çıplak işlev kxs_satir_adresi(y: tam64) -> tam64 {
    değişken p: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"leaq kdl_dilim_satir(%rip), $0"# çıktı("=r",&p) } }
    ver p+y*4104;
}
çıplak işlev kxs_satir_bosalt(y: tam64) {
    değişken p: tam64 = kxs_satir_adresi(y);
    değişken boy: tam64 = kxm_o64(p);
    değişken i: tam64 = 0;
    iken i < boy { ekran_cift_bayt(kis_buf_oku8(p+8+i,0)); i=i+1; }
    kxm_y64(p,0);
}
çıplak işlev kxs_arka_yaz(p: tam64,n: tam64) -> tam64 {
    değişken y: tam64 = kxs_pid_yuva(kxs_pid);
    değişken satir: tam64 = kxs_satir_adresi(y);
    değişken boy: tam64 = kxm_o64(satir);
    değişken i: tam64 = 0;
    iken i < n {
        eğer kis_buf_oku8(p+i,0) == 10 { boy=0; }
        değilse { boy=boy+1; eğer boy > 4096 { ver -34; } }
        i=i+1;
    }
    i=0; boy=kxm_o64(satir);
    iken i < n {
        değişken b: tam32 = kis_buf_oku8(p+i,0);
        eğer b == 10 {
            kxm_y64(satir,boy); kxs_satir_bosalt(y); ekran_cift_bayt(10); boy=0;
        } değilse { kis_buf_yaz8(satir+8+boy,0,b); boy=boy+1; }
        i=i+1;
    }
    kxm_y64(satir,boy);
    ver n;
}
çıplak işlev kxs_konsol_yaz(fd: tam64, p: tam64, n: tam64) -> tam64 {
    eğer fd != 1 ve fd != 2 { ver 0 - KX_HATA_BADF; }
    eğer n > 4096 { ver 0 - KX_HATA_INVAL; }
    eğer değil kxs_aralik(p, n, yanlış) { ver 0 - KX_HATA_FAULT; }
    eğer kxs_on_pid != kxs_pid { ver kxs_arka_yaz(p,n); }
    değişken i: tam64 = 0;
    iken i < n {
        ekran_cift_bayt(kis_buf_oku8(p+i, 0));
        i = i + 1;
    }
    ver i;
}
çıplak işlev kxs_hizmet(num: tam64, a: tam64, b: tam64, c: tam64) -> tam64 {
    eğer num == KX_SIS_YAZ ve (a == 2 veya (a == 1 ve değil kxs_cikis_eslendi)) { ver kxs_konsol_yaz(a,b,c); }
    eğer num == 5 {
        değişken n: tam64 = kxs_dize_boyu(a, 4096);
        eğer n < 0 { ver 0 - 1; }
        kxs_konsol_yaz(1,a,n);
        ver 0;
    }
    eğer num == 10 { ver kem_tik_oku(); }
    eğer num == 11 { ver kxs_pid; }
    eğer num == 13 {
        kxs_durum = KXS_BITTI;
        kxs_cikis_kodu = a;
        kxm_y64(kxr_blok_adr(), 0);
        ver 0;
    }
    eğer num == 14 {
        eğer a == kxs_pid { ver 0; }
        ver 1;
    }
    eğer num == 26 {
        eğer kxs_on_pid != kxs_pid { ver -13; }
        eğer b <= 0 veya b > 4096 veya değil kxs_aralik(a,b,doğru) { ver 0 - 1; }
        ver kis_satir_oku(a,b olarak tam32) olarak tam64;
    }
    eğer kxs_ek_vekil != 0 { ver kx_sis_vekil_cagir(kxs_ek_vekil,num,a,b,c); }
    ver 0 - KX_HATA_NOSYS;
}
çıplak işlev kxs_hizmet_adresi() -> tam64 {
    değişken adr: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"leaq kxs_hizmet(%rip), $0"# çıktı("=r", &adr) } }
    ver adr;
}
// LAPIC koçanındaki fiziksel kesme çerçevesinin gözetmen adresi.
çıplak işlev kxs_baglam(yuva: tam64) -> tam64 {
    değişken taban: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"leaq kdl_dilim_tablo(%rip), $0"# çıktı("=r",&taban) } }
    ver taban + yuva * KXS_KAYIT_BOYU;
}
çıplak işlev kxs_baglam_kur(baglam: tam64, giris: tam64,ust: tam64) {
    memset(baglam olarak *tam8, 0, 160);
    kxm_y64(baglam+120,giris);
    kxm_y64(baglam+128,27);
    kxm_y64(baglam+136,514);
    kxm_y64(baglam+144,ust-4104);
    kxm_y64(baglam+152,35);
}
çıplak işlev kxs_dilim(baglam: tam64) -> tam64 {
    değişken sonuc: tam64 = 0;
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"movq $1, %rdi
subq $$128, %rsp
pushfq
cli
swapgs
call kdl_dilim_gir
swapgs
popfq
addq $$128, %rsp
movq kdl_dilim_etkin(%rip), $0
movq $$0, kdl_dilim_etkin(%rip)"#
            çıktı("={rax}",&sonuc) girdi("r",baglam) bozulan("~{rdi}")
            bozulan("~{rcx}") bozulan("~{rdx}") bozulan("~{rsi}")
            bozulan("~{r8}") bozulan("~{r9}") bozulan("~{r10}") bozulan("~{r11}")
            bozulan("~{memory}") bozulan("~{cc}")
        }
    }
    ver sonuc;
}
// int 0x80 kapısı IF'yi temizler. Beklerken yalnız IRQ'lar açılır ve
// işleyici dönüşünde yeniden kapanır; kullanıcı RFLAGS'i iretq geri yükler.
çıplak işlev kxs_irq_bekle() {
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"sti
hlt
cli"# bozulan("~{memory}") } }
}
çıplak işlev kxs_fpu_kapat() -> tam64 {
    değişken cr0: tam64 = 0;
    güvensiz {
        satıriçi_asm { mimari: x86_64 şablon: r#"movq %cr0, $0
movq $0, %r11
orq $$8, %r11
movq %r11, %cr0"# çıktı("=r", &cr0) bozulan("~{r11}") bozulan("~{cc}") bozulan("~{memory}") }
    }
    ver cr0;
}
çıplak işlev kxs_fpu_geri(cr0: tam64) {
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"movq $0, %cr0"# girdi("r", cr0) bozulan("~{memory}") } }
}
çıplak işlev kxs_bellek_sifirla(taban: tam64,adet: tam32) {
    memset(taban olarak *tam8, 0, (adet olarak tam64)*4096);
}

// Dış ölçüm işlevi iki sayacın optimize edilip silinmesini önler.
çıplak işlev kxs_heap_olcum_oku(ofs: tam64) -> tam64 {
    eğer ofs == 0 { ver kxs_heap_giris; }
    ver kxs_heap_cikis;
}
çıplak işlev kxs_heap_iz(ofs: tam64) {
    eğer ofs == 0 { kxs_heap_giris=kem_bump; }
    değilse { kxs_heap_cikis=kem_bump; }
}

işlev kxs_segmentler(e: Elf64,yer: KxsYer) -> mantıksal {
    eğer e.tur != 2 veya e.makine != 62 { ver yanlış; }
    değişken giris: mantıksal = yanlış;
    için s: e.yuklemeler {
        eğer s.bellek_boyu > 0 {
            eğer s.hiza != 4096 veya s.sanal_adres % 4096 != 0 veya s.sanal_adres < yer.alt
                veya s.sanal_adres >= yer.heap veya s.bellek_boyu > yer.heap - s.sanal_adres
                veya (s.bayraklar != 4 ve s.bayraklar != 5 ve s.bayraklar != 6) { ver yanlış; }
            eğer s.bayraklar == 5 ve e.giris >= s.sanal_adres ve e.giris - s.sanal_adres < s.dosya_boyu {
                giris = doğru;
            }
        }
    }
    // Segmentlerin ayrı sayfa başlarında başlaması ve ELF64'ün örtüşme denetimi,
    // aynı sayfaya iki farklı izin verilmesini de önler.
    ver giris;
}
işlev kxs_segment_esle(taban: tam64, e: Elf64, yer: KxsYer) {
    için s: e.yuklemeler {
        eğer s.bellek_boyu > 0 {
            değişken izin: tam64 = 5;
            eğer s.bayraklar != 5 { izin = izin | KXM_NX_BIT; }
            eğer s.bayraklar == 6 { izin = izin | 2; }
            kxs_esle(taban,yer,s.sanal_adres,s.sanal_adres+s.bellek_boyu,izin);

        }
    }
    kxs_esle(taban,yer,yer.heap,yer.heap_son,KXM_NX_BIT | 7);
    kxs_esle(taban,yer,yer.yigin,yer.ust,KXM_NX_BIT | 7);
}
işlev kxs_yigin(taban: tam64, duzen: KxsYer, argv: Dizi<metin>) -> mantıksal {
    değişken adet: tam64 = dizi_boyut(argv) olarak tam64;
    eğer adet < 1 veya adet > 32 { ver yanlış; }
    değişken bas: tam64 = taban+(duzen.tablo olarak tam64)*4096+duzen.ust-4096-duzen.alt;
    değişken yer: tam64 = (adet+2)*8;
    değişken i: tam64 = 0;
    iken i < adet {
        değişken arg: metin = dizi_al(argv,i olarak tam32);
        değişken boy: tam64 = metin_uzunluk(arg) olarak tam64;
        eğer boy >= 4096 - yer { ver yanlış; }
        kxm_y64(bas + (i+1)*8,duzen.ust-4096+yer);
        değişken j: tam32 = 0;
        iken (j olarak tam64) < boy {
            kxr_y8(bas+yer+(j olarak tam64),metin_bayt(arg,j) olarak dtam8);
            j=j+1;
        }
        yer = yer + boy + 1;
        i = i + 1;
    }
    kxm_y64(bas,adet);
    ver doğru;
}

işlev kxs_hazirla(ayirici: tam64, e: Elf64, argv: Dizi<metin>, ebeveyn: tam64) -> sonuç<tam64,metin> {
    eğer ayirici == 0 { ver hata("surec icin UEFI belleği gerekli"); }
    değişken yer: KxsYer = kxs_yer(e.giris);
    değişken adet: tam32 = kxs_cerceve_sayisi(yer);
    eğer değil kxs_segmentler(e,yer) { ver hata("ELF surec penceresi veya izinleri"); }
    güvensiz {
        eğer kxs_pid_son == 9223372036854775807 { ver hata("pid siniri"); }
        değişken yuva: tam64 = kxs_yuva_ayir();
        eğer yuva < 0 { ver hata("surec tablosu dolu"); }
        değişken taban: tam64 = uefi_surec_ayir(adet);
        eğer taban == 0 { kxs_yuva_serbest(yuva); ver hata("surec icin RAM yetmedi"); }
        eğer taban > 1073741824-(adet olarak tam64)*4096 {
            uefi_surec_iade(taban,adet); kxs_yuva_serbest(yuva); ver hata("surec fiziksel adres siniri");
        }
        kxs_bellek_sifirla(taban,adet);
        eğer değil kxs_yigin(taban,yer,argv) {
            uefi_surec_iade(taban,adet); kxs_yuva_serbest(yuva);
            ver hata("argv surec yigini siniri");
        }
        değişken ana: tam64 = kxm_cr3_oku();
        eğer kxs_etkin_kayit != 0 { ana=kxs_ana_cr3; }
        kxs_tablo_kur(taban,ana,yer);
        kxs_segment_esle(taban,e,yer);
        eğer kxs_tss_var == 0 { kxr_tss_kur(); kxs_tss_var=1; }
        kxm_nx_ac();
        değişken kayit: tam64 = kxs_baglam(yuva);
        kxs_baglam_kur(kayit,e.giris,yer.ust);
        kxm_y64(kayit+256,yer.alt);
        kxs_pid_son=kxs_pid_son+1;
        kxm_y64(kayit+KXS_PID_OFS,kxs_pid_son);
        kxm_y64(kayit+KXS_CR3_OFS,taban);
        kxm_y64(kayit+KXS_EBEVEYN_OFS,ebeveyn);
        kxm_y64(kayit+KXS_DURUM_OFS,KXS_HAZIR);
        ver tamam(yuva);
    }
}
çıplak işlev kxs_bir_dilim(yuva: tam64) {
    değişken kayit: tam64 = kxs_baglam(yuva);
    eğer kxm_o64(kayit+KXS_DURUM_OFS) != KXS_HAZIR { ver; }
    değişken ana: tam64 = kxm_cr3_oku();
    değişken yer: KxsYer = kxs_yer(kxm_o64(kayit+256));
    kxs_alt=yer.alt; kxs_ust=yer.ust;
    kxs_etkin_kayit=kayit;
    kxs_ana_cr3=ana;
    kxs_cr3=kxm_o64(kayit+KXS_CR3_OFS);
    kxs_pt=kxs_cr3+12288;
    kxs_pid=kxm_o64(kayit+KXS_PID_OFS);
    kxs_durum=KXS_KOSUYOR;
    kxs_cikis_kodu=0;
    kxm_y64(kayit+KXS_DURUM_OFS,KXS_KOSUYOR);
    kx_sis_vekil=kxs_hizmet_adresi();
    değişken cr0: tam64 = kxs_fpu_kapat();
    smp_alan_degistir(kxs_cr3,kxs_pid);
    değişken durdu: tam64 = kxs_dilim(kayit);
    smp_alan_degistir(ana,0);
    kxs_fpu_geri(cr0);
    kx_sis_vekil=0;
    eğer durdu == 0 {
        eğer kxs_durum == KXS_KOSUYOR {
            kxm_y64(kayit+KXS_DILIM_OFS,kxm_o64(kayit+KXS_DILIM_OFS)+1);
            kxs_durum=KXS_HAZIR;
        }
        kxm_y64(kayit+KXS_DURUM_OFS,kxs_durum);
    }
    değilse {
        eğer kxs_durum == KXS_KOSUYOR { kxs_durum=KXS_OLDURULDU; }
        kxm_y64(kayit+KXS_DURUM_OFS,kxs_durum);
        kxm_y64(kayit+KXS_CIKIS_OFS,kxs_cikis_kodu);
        değişken r: tam64 = kxr_blok_adr();
        kxm_y64(kayit+KXS_VEKTOR_OFS,kxm_o64(r+16));
        kxm_y64(kayit+KXS_HATA_OFS,kxm_o64(r+24));
        kxm_y64(kayit+KXS_RIP_OFS,kxm_o64(r+32));
        kxm_y64(kayit+KXS_CR2_OFS,kxm_o64(r+64));
    }
    kxs_etkin_kayit=0; kxs_pid=0; kxs_pt=0; kxs_cr3=0; kxs_durum=KXS_BOS;
}
çıplak işlev kxs_sonuc_al(yuva: tam64,cikti: &değişken KxsSonuc) {
    değişken kayit: tam64 = kxs_baglam(yuva);
    cikti.pid=kxm_o64(kayit+KXS_PID_OFS);
    cikti.ebeveyn=kxm_o64(kayit+KXS_EBEVEYN_OFS);
    cikti.bitti=kxm_o64(kayit+KXS_DURUM_OFS) == KXS_BITTI;
    cikti.kod=kxm_o64(kayit+KXS_CIKIS_OFS);
    cikti.vektor=kxm_o64(kayit+KXS_VEKTOR_OFS);
    cikti.hata_kodu=kxm_o64(kayit+KXS_HATA_OFS);
    cikti.rip=kxm_o64(kayit+KXS_RIP_OFS);
    cikti.cr2=kxm_o64(kayit+KXS_CR2_OFS);
    memset(kayit olarak *tam8,0,KXS_KAYIT_BOYU);
}
