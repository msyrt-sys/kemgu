// kem_uart.kem — İş 2 (D-672, D2b): x86_64 (COM1 16550) UART bayt-yaz arayüzü.
// kem_panik artık mimariden bağımsız kem_uart_bayt çağırır; bu dosya x86'da
// COM1 16550 port I/O yolunu sağlar: veri 0x3F8 (=1016), LSR 0x3FD (=1021),
// LSR bit 5 (32) = THRE (verici tutma yazmacı boş). arm64 ikizi:
// runtime/mimari/arm64/kem_uart.kem (PL011 MMIO). Ayrı dosya: AS001 gereği bir
// dosyada yalnız TEK mimarinin satıriçi_asm'i olabilir; Makefile CAT listesi
// mimariye göre seçer (D2b kararı). LSR yoklaması SINIRLI: UART yoksa (ya da
// THRE donmuşsa) panik yolu ASILMASIN diye en çok 100000 deneme; sonra veri
// yine yazılır (mesaj kaybolabilir ama çekirdek ilerler).
çıplak işlev kem_port_yaz8(port: dtam16, deger: dtam8) {
    güvensiz {
        satıriçi_asm { mimari: x86_64 şablon: r#"outb $1, $0"# girdi("{dx}", port) girdi("{al}", deger) bozulan("~{memory}") }
    }
}

çıplak işlev kem_port_oku8(port: dtam16) -> dtam8 {
    değişken v: dtam8 = 0 olarak dtam8;
    güvensiz {
        satıriçi_asm { mimari: x86_64 şablon: r#"inb $1, $0"# çıktı("={al}", &v) girdi("{dx}", port) bozulan("~{memory}") }
    }
    ver v;
}

çıplak işlev kem_port_yaz16(port: dtam16, deger: dtam16) {
    güvensiz {
        satıriçi_asm { mimari: x86_64 şablon: r#"outw $1, $0"# girdi("{dx}", port) girdi("{ax}", deger) bozulan("~{memory}") }
    }
}

çıplak işlev kem_port_oku16(port: dtam16) -> dtam16 {
    değişken v: dtam16 = 0 olarak dtam16;
    güvensiz {
        satıriçi_asm { mimari: x86_64 şablon: r#"inw $1, $0"# çıktı("={ax}", &v) girdi("{dx}", port) bozulan("~{memory}") }
    }
    ver v;
}

çıplak işlev kem_port_yaz32(port: dtam16, deger: dtam32) {
    güvensiz {
        satıriçi_asm { mimari: x86_64 şablon: r#"outl $1, $0"# girdi("{dx}", port) girdi("{eax}", deger) bozulan("~{memory}") }
    }
}

çıplak işlev kem_port_oku32(port: dtam16) -> dtam32 {
    değişken v: dtam32 = 0 olarak dtam32;
    güvensiz {
        satıriçi_asm { mimari: x86_64 şablon: r#"inl $1, $0"# çıktı("={eax}", &v) girdi("{dx}", port) bozulan("~{memory}") }
    }
    ver v;
}

// Tek çekirdekte seri baytlarıyla aynı sırada ilerleyen, satır sınırını koruyan halka.
sabit KGUN_BOY: tam64 = 8192;
küresel değişken kgun_adres: tam64 = 0;
küresel değişken kgun_bas: tam64 = 0;
küresel değişken kgun_adet: tam64 = 0;
küresel değişken kgun_dusen: tam64 = 0;
küresel değişken kgun_uzun: mantıksal = yanlış;
çıplak işlev kgun_kur(adres: tam64) { kgun_adres=adres; }
çıplak işlev kgun_oku(i: tam64) -> tam32 {
    değişken p: *dtam8 = (kgun_adres+((kgun_bas+i)%KGUN_BOY)) olarak *dtam8;
    ver (*p) olarak tam32;
}
çıplak işlev kgun_ekle(b: tam32) {
    eğer kgun_adres == 0 { ver; }
    eğer kgun_uzun {
        eğer b == 10 { kgun_uzun=yanlış; }
        ver;
    }
    eğer kgun_adet == KGUN_BOY {
        değişken c: tam32 = 0;
        iken kgun_adet > 0 ve c != 10 {
            c=kgun_oku(0); kgun_bas=(kgun_bas+1)%KGUN_BOY; kgun_adet=kgun_adet-1;
        }
        kgun_dusen=kgun_dusen+1;
        eğer c != 10 { kgun_uzun=b != 10; ver; }
    }
    değişken p: *dtam8 = (kgun_adres+((kgun_bas+kgun_adet)%KGUN_BOY)) olarak *dtam8;
    *p=b olarak dtam8; kgun_adet=kgun_adet+1;
}
çıplak işlev kem_uart_bayt(b: tam32) {
    kgun_ekle(b);
    değişken deneme: tam32 = 0;
    iken deneme < 100000 {
        değişken lsr: tam32 = kem_port_oku8(1021) olarak tam32;
        // THRE set → yoklamayı BİTİR (döngüden çık), yazma AŞAĞIDA yapılır.
        // ⚠ Burada `ver;` YAZMA: işlev yazmadan döner, mesaj SESSİZCE kaybolur
        // (tur 3 üretiminde öyleydi; calistir_kem_os_x86 Kanıt 5 yakaladı).
        eğer (lsr & 32) != 0 { deneme = 100000; }
        değilse { deneme = deneme + 1; }
    }
    kem_port_yaz8(1016, b olarak dtam8);
}

// [D-706] UART alma kancaları (kis_satir_oku, kem_gorev_cekirdek.kem). 16550: LSR (0x3FD =
// 1021) bit0 = alınacak veri hazır; veri 0x3F8 (1016). arm64 ikizi kem_mmu.kem (PL011 RXFE).
çıplak işlev kis_rx_hazir() -> tam32 {
    eğer ((kem_port_oku8(1021) olarak tam32) & 1) != 0 { ver 1; }
    ver 0;
}
çıplak işlev kis_rx_oku() -> tam32 { ver kem_port_oku8(1016) olarak tam32; }
