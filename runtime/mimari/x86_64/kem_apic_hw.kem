// UEFI MADT → xAPIC/IOAPIC; saf yönlendirme kuralı drivers/acpi'dedir.
// Yazmaçlar Linux apicdef.h/io_apic.h; tools/codex/dalga11_sabit.py doğrular.
kullan drivers::acpi::madt::{ Madt, madt_coz };
kullan drivers::smp::islemci::{ smp_islemciler };
kullan drivers::ortak::bayt::{ imza_esit };
kullan drivers::acpi::yonlendirme::{ KesmeYolu, isa_yolu, kesme_girdisi };
küresel değişken kap_lapic_tik: tam64 = 0;
küresel değişken kap_pit_tik: tam64 = 0;
küresel değişken kap_lapic: tam64 = 0;
küresel değişken kap_io1: tam64 = 0;
küresel değişken kap_reg1: tam32 = 0;
küresel değişken kap_io12: tam64 = 0;
küresel değişken kap_reg12: tam32 = 0;

// Kalibrasyonda PIT kanal0 tek atım: her IRQ yeniden 11932 sayım kurar.
// Mode3 kare dalgasını QEMU IOAPIC çift yüksek bildirebilir; PIC/PVH yolu değişmez.
gerçekzamanlı çıplak işlev kdl_apic_pit_irq() {
 kap_pit_tik=kap_pit_tik+1;
 güvensiz { satıriçi_asm { mimari:x86_64 çevrim:2048 şablon:r#"movb $$156, %al
outb %al, $$64
movb $$46, %al
outb %al, $$64"# bozulan("~{rax}") bozulan("~{memory}") } }
}
çıplak işlev kap_pit_baslat() {
 kem_port_yaz8(67 olarak dtam16,48 olarak dtam8);
 kem_port_yaz8(64 olarak dtam16,156 olarak dtam8);
 kem_port_yaz8(64 olarak dtam16,46 olarak dtam8);kz_irq_ac();
}
gerçekzamanlı çıplak işlev kdl_apic_timer_irq() {
 güvensiz { satıriçi_asm { mimari:x86_64 çevrim:64 şablon:r#"incq kdl_cekirdek_bsp+16(%rip)"# bozulan("~{cc}") bozulan("~{memory}") } }
 eğer değil kesme_geldi(48,3) { ver; } kem_tik=kem_tik+1; kap_lapic_tik=kap_lapic_tik+1; }
çıplak işlev kap_pit_oku() -> tam64 {
 değişken n: tam64 = 0;
 güvensiz { satıriçi_asm { mimari:x86_64 şablon:r#"movq kap_pit_tik(%rip), $0"# çıktı("=r",&n) bozulan("~{memory}") } }
 ver n;
}
çıplak işlev kap_msr_oku() -> tam64 {
 değişken a: tam64 = 0; değişken d: tam64 = 0;
 güvensiz { satıriçi_asm { mimari:x86_64 şablon:r#"movl $$27, %ecx
rdmsr"# çıktı("={ax}",&a) çıktı("={dx}",&d) bozulan("~{rcx}") bozulan("~{memory}") } }
 ver (a&4294967295)|((d&4294967295)<<32);
}
çıplak işlev kap_msr_yaz(v: tam64) {
 değişken a: tam32 = v olarak tam32; değişken d: tam32 = (v>>32) olarak tam32;
 güvensiz { satıriçi_asm { mimari:x86_64 şablon:r#"movl $$27, %ecx
wrmsr"# girdi("{ax}",a) girdi("{dx}",d) bozulan("~{rcx}") bozulan("~{memory}") } }
}
çıplak işlev kap_taban_yaz(a: tam64) {
 kap_lapic=a;
 güvensiz { satıriçi_asm { mimari:x86_64 şablon:r#"movq $0, kdl_lapic_taban(%rip)"# girdi("r",a) bozulan("~{memory}") } }
}
çıplak işlev kap_io_oku(a: tam64, r: tam32) -> tam64 {
 kem_mmio_yaz32(a,r olarak tam64); ver kem_mmio_oku32(a+16)&4294967295;
}
çıplak işlev kap_io_yaz(a: tam64, r: tam32, v: tam64) {
 kem_mmio_yaz32(a,r olarak tam64); kem_mmio_yaz32(a+16,v);
}
çıplak işlev kap_ps2_ac() {
 // Denetleyici baytları/halka hazır olduktan sonra maskeyi indir.
 kap_io_yaz(kap_io1,kap_reg1,kap_io_oku(kap_io1,kap_reg1)&4294901759);
 kap_io_yaz(kap_io12,kap_reg12,kap_io_oku(kap_io12,kap_reg12)&4294901759);
}
işlev uefi_madt(b: UefiBilgi) -> sonuç<Madt,metin> {
 eşleş uefi_rsdp(b) { hata(e) => { ver hata(e); } tamam(r) => {
 eşleş rsdp_coz(r) { hata(e) => { ver hata("APIC RSDP"); } tamam(rsdp) => {
  değişken x: mantıksal = rsdp.xsdt != 0; değişken a: tam64 = rsdp.rsdt; eğer x { a=rsdp.xsdt; }
  eşleş uefi_sdt(b,a) { hata(e) => { ver hata(e); } tamam(kok) => {
  eşleş acpi_kok_coz(kok,x) { hata(e) => { ver hata(e); } tamam(xs) => {
   için adr: xs {
    eşleş uefi_sdt(b,adr) { hata(e) => { ver hata(e); } tamam(t) => {
     eşleş sdt_coz(t) { hata(e) => { ver hata("APIC SDT"); } tamam(h) => {
      eğer imza_esit(t,0,"APIC") { ver madt_coz(t); }
     } }
    } }
   }
  } } } }
 } } } }
 ver hata("MADT yok");
}
işlev uefi_apic_esle(d: &değişken CerceveAyirici, b: UefiBilgi) -> sonuç<mantıksal,metin> {
 eşleş uefi_madt(b) { hata(e) => { ver hata(e); } tamam(m) => {
  güvensiz { smp_birden_cok = smp_cok_mu(m); }
  eğer (m.lapic_adresi&4095) != 0 { ver hata("LAPIC hizasi"); }
  eşleş uefi_mmio_esle(d,m.lapic_adresi,4096) { hata(e) => { ver hata(e); } tamam(v) => { } }
  için g: m.girdiler { eğer g.tur == 1 {
   eğer (g.adres&4095) != 0 { ver hata("IOAPIC hizasi"); }
   eşleş uefi_mmio_esle(d,g.adres,4096) { hata(e) => { ver hata(e); } tamam(v) => { } }
  } }
 } }
 ver tamam(doğru);
}
işlev kap_dok(ad: metin, a: tam64, b: tam64, c: tam64) {
 değişken s: metin = metin_birlestir(ad," ");s=metin_birlestir(s,tam_metin(a));s=metin_birlestir(s," ");
 s=metin_birlestir(s,tam_metin(b));s=metin_birlestir(s," ");bm_yaz(metin_birlestir(s,tam_metin(c)));
}
işlev kap_yol_kur(m: Madt, irq: tam32, vektor: tam32, hedef: tam32, maskeli: mantıksal) -> sonuç<mantıksal,metin> {
 eşleş isa_yolu(m,irq) { hata(e) => { ver hata(e); } tamam(y) => {
  için g: m.girdiler { eğer g.tur == 1 {
   değişken n: tam64 = ((kap_io_oku(g.adres,1)>>16)&255)+1;
   eğer y.gsi >= g.gsi ve y.gsi-g.gsi < n {
    değişken r: tam32 = 16+((y.gsi-g.gsi) olarak tam32)*2;
    eşleş kesme_girdisi(y,vektor,hedef,maskeli) { hata(e) => { ver hata(e); } tamam(v) => {
     // Önce maskele; hedefi yaz; son olarak istenen alt sözcüğü yayımla.
     kap_io_yaz(g.adres,r,65536); kap_io_yaz(g.adres,r+1,v.ust); kap_io_yaz(g.adres,r,v.alt);
     eğer kap_io_oku(g.adres,r) != v.alt veya kap_io_oku(g.adres,r+1) != v.ust { ver hata("IOAPIC geri okuma"); }
     güvensiz {
      eğer irq == 1 { kap_io1=g.adres;kap_reg1=r; }
      eğer irq == 12 { kap_io12=g.adres;kap_reg12=r; }
     }
     kap_dok("APIC_YOL",irq olarak tam64,y.gsi,v.alt); ver tamam(doğru);
    } }
   }
  } }
 } }
 ver hata("GSI IOAPIC disinda");
}
çıplak işlev kap_pit_bekle(n: tam64) -> mantıksal {
 değişken i: tam32 = 0;
 // Port 0x80 QEMU’da mikrosaniye saati değildir; yalnız sınırlı ilerleme beklenir.
 iken i < 2000000 {
  eğer kap_pit_oku() >= n { ver doğru; }
  kem_bekle_us(50);i=i+1;
 }
 ver yanlış;
}
işlev uefi_apic_kur(b: UefiBilgi) -> sonuç<mantıksal,metin> {
 kg_irq_kapat();
 güvensiz {
  kesme_tablo=malloc(8192) olarak tam64;
  eğer kesme_tablo == 0 { ver hata("kesme kayit tablosu icin RAM yok"); }
  memset(kesme_tablo olarak *tam8,0,8192);
 }
 eğer değil kesme_kaydet(33,1) veya değil kesme_kaydet(44,2) veya değil kesme_kaydet(48,3) { ver hata("sabit kesme vektoru dolu"); }
 eşleş uefi_madt(b) { hata(e) => { ver hata(e); } tamam(m) => {
  değişken msr: tam64 = kap_msr_oku();
  eğer (msr&1024) != 0 { ver hata("x2APIC acik; xAPIC gerekli"); }
  kap_msr_yaz(m.lapic_adresi|(msr&4095)|2048);
  kap_taban_yaz(m.lapic_adresi);
  değişken a: tam64 = m.lapic_adresi;
  değişken id: tam32 = ((kem_mmio_oku32(a+32)>>24)&255) olarak tam32;
  güvensiz {
   smp_bsp_kimligi=id olarak tam64;
   kem_mmio_yaz64(smp_bsp_verisi()+8,id olarak tam64);
   değişken kayit_ptr: *tam64 = (&smp_bsp_kimligi) olarak *tam64;
   smp_kimlik_sayfasi=kayit_ptr olarak tam64;
   smp_cekirdek_sayisi=1;
  }
  kap_dok("APIC_LAPIC",a,id olarak tam64,kem_mmio_oku32(a+48));
  kem_port_yaz8(33 olarak dtam16,255 olarak dtam8); kem_port_yaz8(161 olarak dtam16,255 olarak dtam8);
  kem_mmio_yaz32(a+128,0);kem_mmio_yaz32(a+848,65536);kem_mmio_yaz32(a+864,65536);
  kem_mmio_yaz32(a+800,65584);kem_mmio_yaz32(a+240,511);kem_mmio_yaz32(a+992,3);
  değişken adet: tam32 = 0;
  için g: m.girdiler {
   eğer g.tur == 2 { kap_dok("APIC_ISO",g.kaynak olarak tam64,g.gsi,g.bayraklar); }
   eğer g.tur == 1 {
    değişken n: tam64 = ((kap_io_oku(g.adres,1)>>16)&255)+1;
    eğer n < 1 veya n > 120 { ver hata("IOAPIC girdi sayisi"); }
    kap_dok("APIC_IO",g.adres,g.gsi,n);adet=adet+1;
    değişken i: tam32 = 0;iken (i olarak tam64) < n { kap_io_yaz(g.adres,16+i*2,65536);i=i+1; }
   }
  }
  eğer adet == 0 { ver hata("IOAPIC yok"); }
  eşleş kap_yol_kur(m,0,32,id,yanlış) { hata(e) => { ver hata(e); } tamam(v) => { } }
  eşleş kap_yol_kur(m,1,33,id,doğru) { hata(e) => { ver hata(e); } tamam(v) => { } }
  eşleş kap_yol_kur(m,12,44,id,doğru) { hata(e) => { ver hata(e); } tamam(v) => { } }
  güvensiz { kap_pit_tik=0; }
  kap_pit_baslat(); // PIT 100 Hz tek atım; IRQ0 yalnız ISO/GSI yolunda.
  eğer değil kap_pit_bekle(2) { kg_irq_kapat();ver hata("APIC PIT ISO zaman asimi"); }
  kem_mmio_yaz32(a+896,4294967295);
  değişken bas: tam64 = kap_pit_oku(); değişken tsc_ilk: tam64 = bm_tsc_oku();
  eğer değil kap_pit_bekle(bas+10) { kg_irq_kapat();ver hata("APIC PIT kalibrasyon zaman asimi"); }
  kg_irq_kapat();
  değişken fark: tam64 = 4294967295-kem_mmio_oku32(a+912);
  değişken sure: tam64 = kap_pit_oku()-bas;
  eğer sure < 10 veya sure > 100 { ver hata("PIT olcum araligi"); }
  güvensiz {
   kap_tsc_ms=(bm_tsc_oku()-tsc_ilk)/(sure*10);
   // LAPIC kurulduktan sonra sürücüler mevcut PIT kanal 0 ölçüsünü paylaşır.
   eğer kap_tsc_ms >= 1000 { bm_cevrim_us=kap_tsc_ms/1000; }
  }
  değişken periyot: tam64 = fark/sure;
  eğer periyot < 100 veya periyot > 2147483647 { ver hata("LAPIC kalibrasyon araligi"); }
  eşleş kap_yol_kur(m,0,32,id,doğru) { hata(e) => { ver hata(e); } tamam(v) => { } }
  güvensiz { smp_lapic_periyodu=periyot; }
  kap_dok("APIC_KAL",sure,fark,periyot);
  kem_mmio_yaz32(a+800,131120);kem_mmio_yaz32(a+896,periyot);
  kz_irq_ac();
  güvensiz { eğer uefi_surec_ayirici != 0 ve smp_birden_cok {
   eşleş smp_baslat(b,m) { hata(e) => { ver hata(e); } tamam(v) => {} }
  } }
  bm_yaz("APIC_HAZIR");ver tamam(doğru);
 } }
}

// Firmware devrini takip eden ilk ana işlevden itibaren TSC çevrimleri.
küresel değişken kap_tsc_bas: tam64 = 0;
küresel değişken kap_tsc_ms: tam64 = 0;
işlev kap_damga(ad: metin) {
 güvensiz { eğer kap_tsc_bas != 0 { bm_yaz(metin_birlestir(metin_birlestir("ACILIS_TSC ",ad),metin_birlestir(" ",tam_metin(bm_tsc_oku()-kap_tsc_bas)))); } }
}

küresel değişken smp_birden_cok: mantıksal = yanlış;
küresel değişken smp_bsp_kimligi: tam64 = 0;
küresel değişken smp_kimlik_sayfasi: tam64 = 0;
küresel değişken smp_cekirdek_sayisi: tam32 = 0;

işlev smp_kesfet_madt(m: Madt) -> sonuç<mantıksal, metin> {
        değişken bsp: tam32 = ((kem_mmio_oku32(m.lapic_adresi + 32) >> 24) & 255) olarak tam32;
        eşleş smp_islemciler(m.girdiler, bsp) { hata(e) => { ver hata(e); } tamam(ids) => {
            değişken sayfa: tam64 = uefi_surec_ayir(1);
            eğer sayfa == 0 { ver hata("SMP kimlik sayfasi icin RAM yok"); }
            değişken no: tam32 = 0;
            için id: ids {
                kem_mmio_yaz64(sayfa + (no olarak tam64) * 8, id olarak tam64);
                kap_dok("SMP_CPU", no olarak tam64, id olarak tam64, bsp olarak tam64);
                no = no + 1;
            }
            güvensiz { smp_kimlik_sayfasi = sayfa; smp_cekirdek_sayisi = no; }
            ver tamam(doğru);
        } }
    ver hata("SMP MADT");
}

// Daha sonraki IPI hedefleri de çekirdek numarasından donanım kimliğine bu yolla geçer.
çıplak işlev smp_apic_kimligi(no: tam32) -> tam32 {
    eğer no < 0 veya no >= smp_cekirdek_sayisi { ver -1; }
    ver kem_mmio_oku64(smp_kimlik_sayfasi + (no olarak tam64) * 8) olarak tam32;
}

küresel değişken smp_ap_kayitlari: tam64 = 0;
küresel değişken smp_cevrimici: tam32 = 1;

// Bayrakları okumak tek işlemcili normal açılışta liste ya da çerçeve ayırmaz.
işlev smp_cok_mu(m: Madt) -> mantıksal {
    değişken n: tam32 = 0;
    için g: m.girdiler {
        eğer g.tur == 0 ve (g.bayraklar & 3) != 0 {
            n = n + 1;
            eğer n > 1 { ver doğru; }
        }
    }
    ver yanlış;
}

// Fiziksel ayırıcı ilk MiB'yi yönetmez. Firmware'in tür 7 olarak bıraktığı
// bitişik iki sayfa kullanılır. Sayfa sıfır ve SIPI aralığının sonu dışarıdadır.
işlev smp_alcak_sayfa(b: UefiBilgi) -> tam64 {
    değişken adres: tam64 = dizi_al(b.alan,9);
    değişken boy: tam64 = dizi_al(b.alan,10);
    değişken adim: tam64 = dizi_al(b.alan,11);
    eğer adim < 40 veya boy <= 0 veya boy % adim != 0 { ver 0; }
    değişken ofset: tam64 = 0;
    iken ofset < boy {
        değişken d: tam64 = adres + ofset;
        eğer kem_mmio_oku32(d) == 7 {
            değişken bas: tam64 = kem_mmio_oku64(d+8);
            değişken n: tam64 = kem_mmio_oku64(d+24);
            eğer bas >= 0 ve bas < 1048576 ve (bas & 4095) == 0 ve n >= 2 {
                değişken ilk: tam64 = bas;
                eğer ilk == 0 { ilk = 4096; }
                eğer ilk <= 1040384 ve n >= (ilk-bas)/4096+2 { ver ilk; }
            }
        }
        ofset = ofset + adim;
    }
    ver 0;
}

çıplak işlev smp_trampolin_yaz(sayfa: tam64, cr3: tam64, ust: tam64, no: tam32) {
    güvensiz { satıriçi_asm {
        mimari: x86_64
        şablon: r#"movq $0, %rdi
movq $1, %rsi
movq $2, %rdx
movl $3, %r8d
leaq kem_ap_giris(%rip), %rcx
subq $$128, %rsp
call kem_ap_sayfa_hazirla
addq $$128, %rsp"#
        girdi("r",sayfa) girdi("r",cr3) girdi("r",ust) girdi("r",no)
        bozulan("~{rax}") bozulan("~{rdi}") bozulan("~{rsi}") bozulan("~{rdx}")
        bozulan("~{rcx}") bozulan("~{r8}") bozulan("~{r9}") bozulan("~{cc}") bozulan("~{memory}")
    } }
}

çıplak işlev smp_rsp() -> tam64 {
    değişken p: tam64 = 0;
    güvensiz { satıriçi_asm { mimari:x86_64 şablon:r#"movq %rsp, $0"# çıktı("=r",&p) } }
    ver p;
}
çıplak işlev smp_bsp_yigin_ustu() -> tam64 {
    değişken p: tam64 = 0;
    güvensiz { satıriçi_asm { mimari:x86_64 şablon:r#"leaq __stack_top(%rip), $0"# çıktı("=r",&p) } }
    ver p;
}
çıplak işlev smp_icr_bekle() -> mantıksal {
    değişken ilk: tam64 = bm_tsc_oku();
    iken (kem_mmio_oku32(kap_lapic+768)&4096) != 0 {
        eğer bm_tsc_oku()-ilk > kap_tsc_ms*100 { ver yanlış; }
        güvensiz { satıriçi_asm { mimari:x86_64 şablon:r#"pause"# bozulan("~{memory}") } }
    }
    ver doğru;
}
çıplak işlev smp_icr_yaz(hedef: tam32, komut: tam64) -> mantıksal {
    eğer değil smp_icr_bekle() { ver yanlış; }
    kem_mmio_yaz32(kap_lapic+784,(hedef olarak tam64)<<24);
    kem_mmio_yaz32(kap_lapic+768,komut);
    ver smp_icr_bekle();
}
çıplak işlev smp_gecik_us(us: tam64) {
    değişken ilk: tam64 = bm_tsc_oku();
    değişken sure: tam64 = (kap_tsc_ms*us+999)/1000;
    iken bm_tsc_oku()-ilk < sure {
        güvensiz { satıriçi_asm { mimari:x86_64 şablon:r#"pause"# bozulan("~{memory}") } }
    }
}

küresel değişken smp_lapic_periyodu: tam64 = 0;

// Çekirdek numarası yalnızca çekirdek GS bağlamında okunur.
çıplak işlev cekirdek_no() -> tam64 {
    değişken no: tam64 = 0;
    güvensiz { satıriçi_asm { mimari:x86_64 şablon:r#"movq %gs:0, $0"# çıktı("=r",&no) bozulan("~{memory}") } }
    ver no;
}
gerçekzamanlı çıplak işlev smp_ap_zaman_irq() {
    güvensiz { satıriçi_asm { mimari:x86_64 çevrim:64 şablon:r#"incq %gs:16"# bozulan("~{cc}") bozulan("~{memory}") } }
}
çıplak işlev smp_bsp_verisi() -> tam64 {
    değişken adr: tam64 = 0;
    güvensiz { satıriçi_asm { mimari:x86_64 şablon:r#"leaq kdl_cekirdek_bsp(%rip), $0"# çıktı("=r",&adr) } }
    ver adr;
}
çıplak işlev smp_ap_tablo_kur(t: tam64, no: tam32, id: tam32, alt: tam64, ust: tam64) -> tam32 {
    değişken rc: tam32 = 0;
    güvensiz { satıriçi_asm { mimari:x86_64
        şablon:r#"movq $1, %rdi
movl $2, %esi
movl $3, %edx
movq $4, %rcx
movq $5, %r8
movq %rsp, %r11
subq $$128, %rsp
andq $$-16, %rsp
subq $$16, %rsp
movq %r11, (%rsp)
call kdl_smp_ap_kur
movq (%rsp), %rsp"#
        çıktı("={ax}",&rc) girdi("r",t) girdi("r",no) girdi("r",id) girdi("r",alt) girdi("r",ust)
        bozulan("~{rdi}") bozulan("~{rsi}") bozulan("~{rdx}") bozulan("~{rcx}") bozulan("~{r8}")
        bozulan("~{r9}") bozulan("~{r10}") bozulan("~{r11}") bozulan("~{memory}") bozulan("~{cc}")
    } }
    ver rc;
}
çıplak işlev smp_ap_saat_kur() {
    değişken a: tam64 = kap_lapic;
    kap_msr_yaz(a|(kap_msr_oku()&4095)|2048);
    kem_mmio_yaz32(a+128,0);
    kem_mmio_yaz32(a+848,65536);
    kem_mmio_yaz32(a+864,65536);
    kem_mmio_yaz32(a+240,511);
    kem_mmio_yaz32(a+992,3);
    kem_mmio_yaz32(a+800,131121);
    kem_mmio_yaz32(a+896,smp_lapic_periyodu);
}

// Kayıt yayımlanmadan BSP bu parametreleri başka AP için kullanamaz.
// Yalnız ilgili AP kendi kaydını yazar. Tablolar kurulduktan sonra IRQ açılır.
çıplak işlev kem_ap_giris(no: tam32) {
    kg_irq_kapat();
    değişken k: tam64 = smp_ap_kayitlari + (no olarak tam64)*64;
    değişken rsp: tam64 = smp_rsp();
    değişken alt: tam64 = kem_mmio_oku64(k+8);
    değişken ust: tam64 = kem_mmio_oku64(k+16);
    değişken id: tam64 = (kem_mmio_oku32(kap_lapic+32)>>24)&255;
    eğer rsp >= alt ve rsp < ust ve id == (smp_apic_kimligi(no) olarak tam64) {
        değişken t: tam64 = kem_mmio_oku64(k+48);
        eğer smp_ap_tablo_kur(t,no,id olarak tam32,alt,ust) == 0 { ver; }
        eğer cekirdek_no() != (no olarak tam64) { ver; }
        smp_ap_saat_kur();
        kem_mmio_yaz64(k+24,rsp);
        kem_mmio_yaz64(k+32,kxm_cr3_oku());
        kem_mmio_yaz64(k+40,id);
        kem_mmio_yaz64(k,1);
        kz_irq_ac();
    }
    iken doğru { güvensiz { satıriçi_asm { mimari:x86_64 şablon:r#"hlt"# bozulan("~{memory}") } } }
}

işlev smp_baslat(b: UefiBilgi, m: Madt) -> sonuç<mantıksal,metin> {
    eşleş smp_kesfet_madt(m) { hata(e) => { ver hata(e); } tamam(v) => {} }
    değişken sayfa: tam64 = smp_alcak_sayfa(b);
    eğer sayfa == 0 { bm_yaz("SMP tek cekirdek: dusuk UEFI sayfasi yok"); ver tamam(doğru); }
    değişken cr3: tam64 = kxm_cr3_oku();
    eğer cr3 <= 0 veya cr3 >= 4294967296 veya (cr3&4095) != 0 { ver hata("AP CR3 araligi"); }
    güvensiz {
        değişken n: tam32 = smp_cekirdek_sayisi;
        değişken kayit: tam64 = uefi_surec_ayir((n*64+4095)/4096);
        eğer kayit == 0 { ver hata("AP kayitlari icin RAM yok"); }
        memset(kayit olarak *tam8,0,(n olarak tam64)*64);
        smp_ap_kayitlari = kayit;
        kem_mmio_yaz64(kayit+48,smp_bsp_verisi());
        kap_dok("SMP_SAYFA",sayfa,kem_pvh_bilgi(),cr3);
        değişken no: tam32 = 1;
        iken no < n {
            değişken alt: tam64 = uefi_surec_ayir(4);
            eğer alt == 0 { ver hata("AP yigini icin RAM yok"); }
            değişken k: tam64 = kayit + (no olarak tam64)*64;
            değişken veri: tam64 = uefi_surec_ayir(13);
            eğer veri == 0 { ver hata("AP GDT/TSS/IST icin RAM yok"); }
            memset(veri olarak *tam8,0,4096);
            kem_mmio_yaz64(k+48,veri);
            kem_mmio_yaz64(k+8,alt); kem_mmio_yaz64(k+16,alt+16384);
            no = no + 1;
        }
        no = 1;
        iken no < n {
            değişken k: tam64 = kayit + (no olarak tam64)*64;
            değişken ust: tam64 = kem_mmio_oku64(k+16);
            değişken bsp_ust: tam64 = smp_bsp_yigin_ustu();
            eğer ust != kem_mmio_oku64(k+8)+16384 veya (ust&4095) != 0 veya
                (ust-16384 < bsp_ust ve ust > bsp_ust-524288) { ver hata("AP yigin siniri"); }
            smp_trampolin_yaz(sayfa,cr3,ust,no);
            değişken id: tam32 = smp_apic_kimligi(no);
            değişken bas: tam64 = bm_tsc_oku();
            eğer değil smp_icr_yaz(id,50432) { ver hata("AP INIT teslim"); }
            smp_gecik_us(10000);
            eğer değil smp_icr_yaz(id,34048) { ver hata("AP INIT birak"); }
            değişken sipi: tam64 = 1536 | (sayfa>>12);
            eğer değil smp_icr_yaz(id,sipi) { ver hata("AP ilk SIPI teslim"); }
            smp_gecik_us(200);
            eğer değil smp_icr_yaz(id,sipi) { ver hata("AP ikinci SIPI teslim"); }
            iken kem_mmio_oku64(k) == 0 {
                eğer bm_tsc_oku()-bas > kap_tsc_ms*1000 { ver hata("AP cevrimici zaman asimi"); }
                smp_gecik_us(10);
            }
            smp_cevrimici = no+1;
            kap_dok("SMP_AP",no olarak tam64,id olarak tam64,((bm_tsc_oku()-bas)*1000)/kap_tsc_ms);
            no = no+1;
        }
    }
    ver tamam(doğru);
}

çıplak işlev smp_cevrimici_say() -> tam32 { ver smp_cevrimici; }
