// kem_mmu_hw.kem — x86_64 MMU çeviri + kurtarılabilir #PF donanım kancaları (D2b, [D-687]).
// ============================================================================
// arm64 ikizi: runtime/kem_mmu.kem (adrp/add + mrs ESR_EL1/FAR_EL1). Bu dosya AYNI
// TEST ADLARINI (kmmu_ceviri_testi, kmmu_fault_testi) ve AYNI test mantığını x86
// donanımıyla sağlar; arm64 asm YASAK (AS001) → yalnız `mimari: x86_64`.
//
// RAM yerleşimi (kem_os): heap ~17 MB; zamanlayıcı/korunmuş 48–50 MB (0x3000000+);
// MMU tabloları 56–58 MB — KXM_PD (0x3800000) yeni PD, KXM_PT (0x3801000) 4KB-sayfa
// tablosu, KMMU_CEVIRI_PA (0x3A00000) identity-eşli boş RAM. PML4[0]→PDPT zaten
// hazır (boot); bu dosya PDPT[1]'i kendi PD'mize bağlar → VA 1–2 GB aralığı
// (0x40000000–0x7FFFFFFF) bu PD üzerinden çevrilir; PD indeksi = (VA−0x40000000)/2MB.
// KMMU_CEVIRI_VA=0x50000000 → PD[128]; KMMU_FAULT_VA=0x60000000 → PD[256] (boş → #PF).

sabit KXM_PD: tam64 = 58720256;           // 0x3800000 (56 MB) yeni PD (PDPT[1] için, 1..2 GB)
sabit KXM_PT: tam64 = 58724352;           // 0x3801000 4KB-sayfa tablosu
sabit KMMU_CEVIRI_VA: tam64 = 1342177280; // 0x50000000 (PD indeksi 128, PT indeksi 0)
sabit KMMU_CEVIRI_PA: tam64 = 60817408;   // 0x3A00000 (58 MB) identity-eşli boş RAM
sabit KMMU_FAULT_VA: tam64 = 1610612736;  // 0x60000000 (PD[256] boş → #PF)

// Ham 64-bit yaz: adr → *tam64 (arm kmmu_y64 ikizi).
çıplak işlev kxm_y64(adr: tam64, deger: tam64) {
    değişken p: *tam64 = adr olarak *tam64;
    *p = deger;
}

// Ham 64-bit oku (arm kmmu_o64 ikizi).
çıplak işlev kxm_o64(adr: tam64) -> tam64 {
    değişken p: *tam64 = adr olarak *tam64;
    ver *p;
}

// CR3 oku (PML4 fiziksel tabanı) — `movq %cr3, $0`.
çıplak işlev kxm_cr3_oku() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"movq %cr3, $0"#
            çıktı("=r", &x)
        }
    }
    ver x;
}

// CR3 yaz — `movq $0, %cr3`. Aynı değeri yeniden yazmak TLB'yi temizler.
çıplak işlev kxm_cr3_yaz(v: tam64) {
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"movq $0, %cr3"#
            girdi("r", v)
            bozulan("~{memory}")
        }
    }
}

// Tablo girdisinden çerçeve adresi: alt 12 bit (bayraklar) at → g - (g % 4096).
çıplak işlev kxm_cerceve(g: tam64) -> tam64 {
    ver g - (g % 4096);
}

// MMU kur (arm64 boot eşi): PD+PT temizle; PT[0]=PA|P|RW; PD[128]=PT|P|RW;
// PDPT[1]=PD|P|RW (mevcut PML4→PDPT üzerine); CR3 yeniden yaz (TLB flush).
çıplak işlev kdl_mmu_kur_x86() {
    değişken i: tam64 = 0;
    iken i < 512 { kxm_y64(KXM_PD + i * 8, 0); i = i + 1; }
    i = 0;
    iken i < 512 { kxm_y64(KXM_PT + i * 8, 0); i = i + 1; }
    kxm_y64(KXM_PT, KMMU_CEVIRI_PA + 3);               // PT[0] = PA | P|RW
    kxm_y64(KXM_PD + 128 * 8, KXM_PT + 3);             // PD[128] = PT | P|RW
    değişken pml4: tam64 = kxm_cerceve(kxm_cr3_oku());
    değişken pdpt: tam64 = kxm_cerceve(kxm_o64(pml4)); // PML4[0] → PDPT
    kxm_y64(pdpt + 8, KXM_PD + 3);                     // PDPT[1] = PD | P|RW
    kxm_cr3_yaz(kxm_cr3_oku());                        // TLB temizle
}

// 1 = non-identity çeviri donanımda ÇALIŞIYOR (iki farklı VA aynı PA'yı görüyor).
// Sentetik DEĞİL: identity olsaydı alias testleri tutmazdı.
çıplak işlev kmmu_ceviri_testi() -> tam32 {
    kxm_y64(KMMU_CEVIRI_PA, 3735928559);            // 0xDEADBEEF → identity VA (=PA)
    değişken a: tam64 = kxm_o64(KMMU_CEVIRI_VA);    // non-identity VA'dan oku → alias mı?
    kxm_y64(KMMU_CEVIRI_VA, 3405691582);            // 0xCAFEBABE → non-identity VA (ters yön)
    değişken b: tam64 = kxm_o64(KMMU_CEVIRI_PA);    // identity VA'dan oku → alias mı?
    eğer a == 3735928559 ve b == 3405691582 {
        ver 1;
    }
    ver 0;
}

// .S kurtarma-vari: kdl_x86_pf_bekle (atlanacak #PF komut uzunluğu) — RIP-göreli yaz.
çıplak işlev kxm_bekle_yaz(v: tam64) {
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"leaq kdl_x86_pf_bekle(%rip), %r11
movq $0, (%r11)"#
            girdi("r", v)
            bozulan("~{r11}") bozulan("~{memory}")
        }
    }
}

// kdl_x86_pf_bekle oku (kurtarma gerçekleştiyse 0'a düşer; .S temizler).
çıplak işlev kxm_bekle_oku() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"leaq kdl_x86_pf_bekle(%rip), %r11
movq (%r11), $0"#
            çıktı("=r", &x)
            bozulan("~{r11}") bozulan("~{memory}")
        }
    }
    ver x;
}

// kdl_x86_pf_cr2 (yakalanan #PF CR2 değeri) — RIP-göreli yaz.
çıplak işlev kxm_cr2_yaz(v: tam64) {
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"leaq kdl_x86_pf_cr2(%rip), %r11
movq $0, (%r11)"#
            girdi("r", v)
            bozulan("~{r11}") bozulan("~{memory}")
        }
    }
}

// kdl_x86_pf_cr2 oku (kurtarma sonrası yakalanan CR2).
çıplak işlev kxm_cr2_oku() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"leaq kdl_x86_pf_cr2(%rip), %r11
movq (%r11), $0"#
            çıktı("=r", &x)
            bozulan("~{r11}") bozulan("~{memory}")
        }
    }
    ver x;
}

// Haritasız VA'yı oku → GERÇEK #PF (TEK komut; .S RIP'i 3 bayt ilerletir; .S ELR/CS
// yerine RIP-göreli kurtarma). Dönen değer ÇÖP — çağıran atar. SABİT YAZMAÇ
// `movq (%rdi), %rax` = 48 8B 07 (tam 3 bayt; bu yüzden kxm_bekle_yaz(3)).
çıplak işlev kxm_oku_faulting(adr: tam64) -> tam64 {
    değişken x: tam64 = 0;
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"movq (%rdi), %rax"#
            girdi("{di}", adr)
            çıktı("={ax}", &x)
            bozulan("~{memory}")
        }
    }
    ver x;
}

// GERÇEK #PF-gate: haritasız VA oku → .S recovery → CR2==VA + kurtarıldı mı?
// 1 = MMU zorluyor + gerçek #PF yakalandı + CR2==VA + OS devam ediyor. Sentetik DEĞİL.
çıplak işlev kmmu_fault_testi() -> tam32 {
    kxm_cr2_yaz(0);                                        // CR2 sonucu temizle
    kxm_bekle_yaz(3);                                      // .S recovery iste (3 = komut uzunluğu)
    değişken cop: tam64 = kxm_oku_faulting(KMMU_FAULT_VA); // GERÇEK #PF → .S recovery
    değişken bekle: tam64 = kxm_bekle_oku();               // .S temizledi mi? (0 = kurtarıldı)
    değişken cr2: tam64 = kxm_cr2_oku();                   // yakalanan CR2
    eğer bekle == 0 ve cr2 == KMMU_FAULT_VA {
        ver 1;
    }
    ver 0;
}

// [D-688] x86_64: süreç başına adres alanı (CR3 değişimi) + izolasyon testi.
// arm64 kem_mmu.kem `kmmu_as_olustur` / `kmmu_izolasyon_testi` ikizidir. Arenada
// her alan 4×4KB = PML4 + PDPT + PD + PT; CR3 = PML4 fiziksel adresi.
sabit KMMU_AS_TABAN: tam64 = 59768832;   // 0x3900000 (57 MB) adres-alanı tablo arenası
sabit KMMU_AS_ADIM: tam64 = 16384;       // her alan = PML4 + PDPT + PD + PT (4×4KB)
sabit KMMU_AS_AZAMI: tam64 = 6;
sabit KMMU_OZEL_VA: tam64 = 1409286144;  // 0x54000000 süreç-özel VA (PD indeksi 160)
sabit KMMU_OZEL_IDX: tam64 = 160;
sabit KMMU_OZEL_PA: tam64 = 62914560;    // 0x3C00000 (60 MB); alan i → +i*2MB (tavan 72 MB)
sabit KMMU_2MB: tam64 = 2097152;
sabit KMMU_SAYFA: tam64 = 4096;
sabit KMMU_SAYFA_SAYI: tam64 = 512;

// Alan #i'nin PML4 fiziksel adresini (CR3 değeri) kur, döner. Çekirdek eşlemesi
// KOPYALANMALI: CR3 yazan komutun ARDINDAN gelen komut da haritalı olmalı — bu
// yüzden çekirdek PDPT ve PD tabloları bire bir kopyalanır; tek fark özel VA'nın
// kendi PT'sine yönlendirilmesidir. i >= KMMU_AS_AZAMI ise 0 (sessiz taşma yok).
çıplak işlev kmmu_as_olustur(i: tam64) -> tam64 {
    eğer (i < 0) veya (i >= KMMU_AS_AZAMI) { ver 0; }
    değişken pml4: tam64 = KMMU_AS_TABAN + i * KMMU_AS_ADIM;
    değişken pdpt: tam64 = pml4 + 4096;
    değişken pd: tam64 = pml4 + 8192;
    değişken pt: tam64 = pml4 + 12288;
    değişken k: tam64 = 0;
    iken k < 512 { kxm_y64(pml4 + k * 8, 0); k = k + 1; }   // PML4 sıfırla
    kxm_y64(pml4, pdpt + 3);                                // PML4[0] → kendi PDPT'si
    // Çekirdek PDPT: CR3 → PML4[0] → PDPT (fiziksel adres)
    değişken kp: tam64 = kxm_cerceve(kxm_o64(kxm_cerceve(kxm_cr3_oku())));
    değişken n: tam64 = 0;
    iken n < 512 { kxm_y64(pdpt + n * 8, kxm_o64(kp + n * 8)); n = n + 1; }
    kxm_y64(pdpt + 8, pd + 3);                              // PDPT[1] → kendi PD'si
    // PD = çekirdek KXM_PD'nin tam kopyası; sonra özel VA → kendi PT
    değişken m: tam64 = 0;
    iken m < 512 { kxm_y64(pd + m * 8, kxm_o64(KXM_PD + m * 8)); m = m + 1; }
    kxm_y64(pd + KMMU_OZEL_IDX * 8, pt + 3);
    // PT: 512×4KB sayfa, her alan kendi 2MB fiziksel penceresine (P|RW)
    değişken pa: tam64 = KMMU_OZEL_PA + i * KMMU_2MB;
    değişken s: tam64 = 0;
    iken s < KMMU_SAYFA_SAYI {
        kxm_y64(pt + s * 8, (pa + s * KMMU_SAYFA) + 3);
        s = s + 1;
    }
    ver pml4;
}

// Alan #cr3'e geç: CR3 yazımı TLB'yi temizler (PCID yok — tam boşaltma).
çıplak işlev kmmu_as_gec(cr3: tam64) {
    kxm_cr3_yaz(cr3);
}

// İZOLASYON KANITI (falsifiye edilebilir): iki adres alanı, AYNI sanal adres,
// FARKLI fiziksel sayfa. A'ya yaz → B'ye yaz → A'ya DÖN → A'nın değeri DURUYOR mu?
// Tek adres alanında taklit edilemez: B'nin yazması A'nınkini ezerdi ve son okuma
// 0xBBBBBBBB verirdi. Ayrıca çekirdeğin identity görüşünden iki fiziksel sayfa
// BAĞIMSIZ doğrulanır — "değeri bir yerde sakladık" sahteliği elenir.
// 1 = süreç izolasyonu donanımda GERÇEK.
çıplak işlev kmmu_izolasyon_testi() -> tam32 {
    değişken k: tam64 = kxm_cr3_oku();              // çekirdek CR3 (sonunda geri yüklenir)
    değişken a: tam64 = kmmu_as_olustur(0);
    değişken b: tam64 = kmmu_as_olustur(1);
    eğer (a == 0) veya (b == 0) { ver 0; }

    kmmu_as_gec(a);
    kxm_y64(KMMU_OZEL_VA, 2863311530);              // 0xAAAAAAAA → A'nın sayfası
    kmmu_as_gec(b);
    kxm_y64(KMMU_OZEL_VA, 3149642683);              // 0xBBBBBBBB → B'nin sayfası
    değişken bv: tam64 = kxm_o64(KMMU_OZEL_VA);     // B kendi değerini görmeli
    kmmu_as_gec(a);
    değişken av: tam64 = kxm_o64(KMMU_OZEL_VA);     // ASIL KANIT: A'nınki DURUYOR mu?

    kmmu_as_gec(k);                                 // çekirdek alanına dön
    // Bağımsız doğrulama: çekirdeğin identity görüşünden iki AYRI fiziksel sayfa.
    değişken pa: tam64 = kxm_o64(KMMU_OZEL_PA);
    değişken pb: tam64 = kxm_o64(KMMU_OZEL_PA + KMMU_2MB);

    eğer (av == 2863311530) ve (bv == 3149642683)
       ve (pa == 2863311530) ve (pb == 3149642683) {
        ver 1;
    }
    ver 0;
}

// [D-689] W^X: NX — yazılabilir VERİ sayfası çalıştırılamaz (arm64 ikizi
// kmmu_kernel_wx_testi). EFER.NXE açılır; özel bölgede sayfa 0 VERİ (NX biti),
// sayfa 1 KOD. İkisine de `ret` yazılır: KOD sayfası çağrılınca döner; VERİ sayfası
// çağrılınca komut getirme #PF oluşur (hata kodu P|I/D = 17), .S "ret taklidi" ile
// çağırana döner. Taklit edilemez: NX uygulanmasaydı VERİ sayfası da sessizce dönerdi.
sabit KXM_NX_BIT: tam64 = 0 - 9223372036854775807 - 1;  // bit 63 (= INT64_MIN), sarma tanımlı
sabit KXM_RET_TAKLIDI: tam64 = 65535;
sabit KXM_PF_NX_HATA: tam64 = 17;                       // P(1) | I/D(16): NX komut getirme

// kdl_x86_pf_hata yaz (.S #PF kurtarma yolunun kaydettiği hata kodu).
çıplak işlev kxm_hata_yaz(v: tam64) {
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"leaq kdl_x86_pf_hata(%rip), %r11
movq $0, (%r11)"#
            girdi("r", v)
            bozulan("~{r11}") bozulan("~{memory}")
        }
    }
}

// kdl_x86_pf_hata oku.
çıplak işlev kxm_hata_oku() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"leaq kdl_x86_pf_hata(%rip), %r11
movq (%r11), $0"#
            çıktı("=r", &x)
            bozulan("~{r11}") bozulan("~{memory}")
        }
    }
    ver x;
}

// EFER.NXE (MSR 0xC0000080, bit 11) aç — olmadan bit 63 AYRILMIŞ sayılır (RSVD #PF).
çıplak işlev kxm_nx_ac() {
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"movl $$3221225600, %ecx
rdmsr
orl $$2048, %eax
wrmsr"#
            bozulan("~{eax}") bozulan("~{ecx}") bozulan("~{edx}") bozulan("~{memory}")
        }
    }
}

// va'yı çağır (hedef yalnız `ret` içerir); çağıran-kaydedilen yazmaçlar bozulmuş sayılır.
çıplak işlev kxm_cagir(va: tam64) {
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"call *$0"#
            girdi("r", va)
            bozulan("~{rax}") bozulan("~{rcx}") bozulan("~{rdx}") bozulan("~{rsi}")
            bozulan("~{rdi}") bozulan("~{r8}") bozulan("~{r9}") bozulan("~{r10}")
            bozulan("~{r11}") bozulan("~{memory}")
        }
    }
}

// W^X KANITI: KOD sayfası çalışır, VERİ sayfası NX #PF verir (CR2 == VA, hata == 17).
çıplak işlev kmmu_wx_testi() -> tam32 {
    kxm_nx_ac();
    değişken c: tam64 = kmmu_as_olustur(2);
    eğer c == 0 { ver 0; }
    değişken pt: tam64 = KMMU_AS_TABAN + 2 * KMMU_AS_ADIM + 12288;
    değişken pa: tam64 = KMMU_OZEL_PA + 2 * KMMU_2MB;
    kxm_y64(pa, 195);                                  // sayfa 0: `ret`
    kxm_y64(pa + KMMU_SAYFA, 195);                     // sayfa 1: `ret`
    kxm_y64(pt, KXM_NX_BIT + pa + 3);                  // sayfa 0 = VERİ (NX)
    kxm_y64(pt + 8, pa + KMMU_SAYFA + 3);              // sayfa 1 = KOD
    değişken k: tam64 = kxm_cr3_oku();
    kmmu_as_gec(c);
    kxm_cagir(KMMU_OZEL_VA + KMMU_SAYFA);              // KOD sayfası: fault yok, döner
    kxm_cr2_yaz(0);
    kxm_hata_yaz(0);
    kxm_bekle_yaz(KXM_RET_TAKLIDI);
    kxm_cagir(KMMU_OZEL_VA);                           // VERİ sayfası: komut getirme #PF
    değişken bekle: tam64 = kxm_bekle_oku();
    değişken cr2: tam64 = kxm_cr2_oku();
    değişken hk: tam64 = kxm_hata_oku();
    kmmu_as_gec(k);
    eğer (bekle == 0) ve (cr2 == KMMU_OZEL_VA) ve (hk == KXM_PF_NX_HATA) { ver 1; }
    ver 0;
}

// [D-690] kurtarılamaz istisna raporu (.kem) + PVH cmdline
// ============================================================================
// ZERO-C B1 x86 ikizi: arm64 kdl_istisna_isle (kis_* + CR2/FAR) ile AYNI biçim,
// AYNI adlar; x86 donanımı (COM1 UART, %cr2). C WEAK tanımını bu GÜÇLÜ .kem
// tanımı ezer. NaN durumu yok: tek satır rapor + hlt sonsuz.
// ============================================================================

// COM1'e tek bayt (arm'daki PL011 MMIO yerine kem_uart_bayt).
çıplak işlev kis_bayt(b: tam32) { kem_uart_bayt(b); }

// Metni COM1'e yaz.
çıplak işlev kis_metin(s: metin) {
    değişken n: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 0;
    iken i < n { kis_bayt(metin_bayt(s, i) olarak tam32); i = i + 1; }
}

// Satır sonu.
çıplak işlev kis_satir() { kis_bayt(10); }

// dtam64'ü onaltılık basamaklarla yaz (özyinelemeli, arm ile birebir).
çıplak işlev kis_hex_basamak(d: dtam64) {
    eğer d > 0 {
        kis_hex_basamak(d / 16);
        değişken r: tam32 = (d - (d / 16) * 16) olarak tam32;
        eğer r < 10 { kis_bayt(r + 48); } değilse { kis_bayt(r + 87); }
    }
}

// 0 → "0", aksi hâlde onaltılık basamaklar.
çıplak işlev kis_onaltilik(d: dtam64) {
    eğer d == 0 { kis_bayt(48); } değilse { kis_hex_basamak(d); }
}

// CR2 (son #PF hatası adresi) oku.
çıplak işlev kis_cr2_oku() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"movq %cr2, $0"# çıktı("=r", &x) } }
    ver x;
}

// .S isr_ortak çağırır (rdi=vektör, rsi=hata kodu, rdx=RIP); arm ikiziyle birebir:
// CR2 oku + "ISTISNA tip=0x.. a=0x.. b=0x.. adr=0x.." + satır + hlt sonsuz.
çıplak işlev kdl_istisna_isle(tip: tam64, a: tam64, b: tam64) {
    değişken adr: tam64 = kis_cr2_oku();
    // kis_onaltilik ISARETSIZ (dtam64) ister — adres/hata degerleri isaretsiz
    // yorumlanmali (tam64 negatif goruntusu onaltilik basamakta YANLIS olur).
    kis_metin("ISTISNA tip=0x"); kis_onaltilik(tip olarak dtam64);
    kis_metin(" a=0x"); kis_onaltilik(a olarak dtam64);
    kis_metin(" b=0x"); kis_onaltilik(b olarak dtam64);
    kis_metin(" adr=0x"); kis_onaltilik(adr olarak dtam64);
    kis_satir();
    iken 1 == 1 {
        güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"hlt"# bozulan("~{memory}") } }
    }
}

// PVH çekirdek komut satırı TAM OLARAK s mi? 1=evet, 0=hayır.
// bi+24 = cmdline_paddr (PVH boot bilgi yapısı); bayt-bayt karşılaştır + NUL sınırı.
çıplak işlev kem_pvh_cmdline_esit(s: metin) -> tam32 {
    değişken bi: tam64 = kem_pvh_bilgi();
    eğer bi == 0 { ver 0; }
    değişken c: tam64 = kem_pvh_oku64(bi + 24);      // cmdline_paddr
    eğer c == 0 { ver 0; }
    değişken n: tam32 = metin_uzunluk(s);
    değişken i: tam32 = 0;
    iken i < n {
        değişken ham: dtam64 = kem_pvh_oku64(c + (i olarak tam64)) olarak dtam64;
        eğer ham % 256 != (metin_bayt(s, i) olarak dtam64) { ver 0; }
        i = i + 1;
    }
    değişken son: dtam64 = kem_pvh_oku64(c + (n olarak tam64)) olarak dtam64;
    eğer son % 256 != 0 { ver 0; }                   // s'den sonra NUL olmalı
    ver 1;
}

// [D-691] çekirdek W^X — .text salt-okunur, geri kalan NX (CR0.WP).
// Gerekçe: .text yazılabilir olsaydı store SESSİZCE geçer, fault hiç oluşmaz,
// bayrak temizlenmez. Ayrıca CR0.WP (bit 16) olmadan çekirdek ring0 kendi
// salt-okunur sayfasına da yazabilir → salt-okunurluk tek başına yetmez.
// Sabitler araçla doğrulandı; mutlak mmu_hw ABI adlarıyla bit birebir.
sabit KXM_PT_K: tam64 = 58728448;      // 0x3802000: çekirdeğin 0..2 MB'ı için 4KB PT
sabit KXM_TEXT_BAS: tam64 = 1048576;   // 0x100000: imaj başı (.note.Xen + .text)
sabit KXM_CR0_WP: tam64 = 65536;       // CR0 bit 16
sabit KXM_PF_YAZ_HATA: tam64 = 3;      // P(1) | W(2): salt-okunur sayfaya çekirdek yazması

// __rodata_end sembolünün adresi (aşağı-hizalama tabanı).
çıplak işlev kxm_rodata_son() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"leaq __rodata_end(%rip), $0"# çıktı("=r", &x) } }
    ver x;
}

// Çalıştırılabilir (.text) bir kod adresi (pvh_entry .text içindedir).
çıplak işlev kxm_kod_adr() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"leaq pvh_entry(%rip), $0"# çıktı("=r", &x) } }
    ver x;
}

// CR0.WP (bit 16) aç — çekirdek salt-okunur sayfaya yazamaz. Satırlar ayrı asm.
çıplak işlev kxm_wp_ac() {
    // TEK blok: üç ayrı blok olsaydı derleyici aralarda %rax'ı kullanabilirdi (CR0 bozulur).
    güvensiz {
        satıriçi_asm {
            mimari: x86_64
            şablon: r#"movq %cr0, %rax
orq $$65536, %rax
movq %rax, %cr0"#
            bozulan("~{rax}") bozulan("~{memory}")
        }
    }
}

// Sabit-yazmaçlı faulting store (kodlama 48 89 07 = 3 bayt; .S RIP'i bekle kadar
// ilerletir). Salt-okunur sayfaya yazım → izin fault'u.
çıplak işlev kxm_yaz_faulting(adr: tam64, v: tam64) {
    güvensiz { satıriçi_asm { mimari: x86_64 şablon: r#"movq %rax, (%rdi)"# girdi("{di}", adr) girdi("{ax}", v) bozulan("~{memory}") } }
}

// Çekirdek 0..2 MB'ı tek 2MB sayfadan 4KB PT'ye böl: .text RO|X, geri kalan RW+NX.
çıplak işlev kmmu_kernel_wx_kur() {
    kxm_nx_ac();                                              // ÖNCE NXE: NX biti aksi halde ayrılmış → her erişim fault
    değişken ro_son: tam64 = kxm_cerceve(kxm_rodata_son());   // aşağı hizala: veriyle ortak sayfa YAZILABİLİR kalsın
    değişken s: tam64 = 0;
    iken s < 512 {
        değişken pa: tam64 = s * 4096;
        eğer (pa >= KXM_TEXT_BAS) ve (pa < ro_son) {
            kxm_y64(KXM_PT_K + s * 8, pa + 1);               // P, salt-okunur + çalıştırılabilir
        }
        değilse {
            kxm_y64(KXM_PT_K + s * 8, KXM_NX_BIT + pa + 3);  // P|RW + NX
        }
        s = s + 1;
    }
    değişken pml4: tam64 = kxm_cerceve(kxm_cr3_oku());
    değişken pdpt: tam64 = kxm_cerceve(kxm_o64(pml4));
    değişken pd: tam64 = kxm_cerceve(kxm_o64(pdpt));          // PDPT[0] → boot PD
    kxm_y64(pd, KXM_PT_K + 3);                               // PD[0] → 4KB PT
    kxm_wp_ac();                                             // CR0.WP: çekirdek RO sayfaya yazamaz
    kxm_cr3_yaz(kxm_cr3_oku());                              // TLB temizle
}

// ÇEKİRDEK W^X kapısı (arm64 kmmu_kernel_wx_testi ikizi): çekirdek KENDİ .text'ine
// yazmayı dener → izin fault'u. Taklit edilemez: .text yazılabilir olsaydı store
// SESSİZCE geçer, fault oluşmaz. Yazma gerçekten geçmedi diye kod baytı da okunur.
çıplak işlev kmmu_kernel_wx_testi() -> tam32 {
    değişken hedef: tam64 = kxm_kod_adr();         // .text içinde bir adres
    değişken once: tam64 = kxm_o64(hedef);         // okuma SERBEST (RO)
    kxm_cr2_yaz(0);
    kxm_hata_yaz(0);
    kxm_bekle_yaz(3);                              // .S recovery iste
    kxm_yaz_faulting(hedef, 3735928559);           // 0xDEADBEEF → izin fault'u
    değişken bekle: tam64 = kxm_bekle_oku();       // 0 = .S kurtardı
    değişken cr2: tam64 = kxm_cr2_oku();
    değişken hk: tam64 = kxm_hata_oku();           // `hata` anahtar kelime → `hk`
    değişken sonra: tam64 = kxm_o64(hedef);        // kod DEĞİŞMEMİŞ olmalı
    eğer (bekle == 0) ve (cr2 == hedef) ve (hk == KXM_PF_YAZ_HATA) ve (sonra == once) {
        ver 1;
    }
    ver 0;
}

// [D-692] kdl_panik — derleyicinin ürettiği çalışma zamanı kontrolleri (dizi sınırı
// D-069, sıfıra bölme D-502, kaydırma D-514, vektör lane D-546) `@kdl_panik(ptr)`
// çağırır. arm64 kem_os bunu --gc-sections ile karşılar (çağrılar satır içine açılınca
// ölü kalır); x86 bağlantısında gc yok → tanım GEREKLİ. Mesaj mimariden bağımsız
// kem_panik'e (kem_heap.kem, COM1) aktarılır: gerçek bir ihlal temiz durur.
çıplak işlev kdl_panik(m: metin) {
    kem_panik(m);
}
