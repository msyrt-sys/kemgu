// kem_gorev.kem — FAZ-A4 (D-280): SAF-.kem PREEMPTIVE scheduler (round-robin).
// ============================================================================
// Kanıtlı-C kdl_gorev.c (kdl_preempt + kdl_preempt_gorev_olustur) BİREBİR yeniden
// gerçekleştirmesi. Timer IRQ (A3) → .kem kdl_irq_isle → kem_preempt → context-switch
// (trap-frame SP swap). .S kdl_irq_ortak (mov sp,x0 + trap-frame restore + eret)
// DEĞİŞMEZ; yalnız kdl_irq_isle `ver kem_preempt(sp)` çağırır.
//
// context-switch = SP-swap: kem_preempt mevcut görevin trap-frame SP'sini kaydeder,
// sonrakinin SP'sini döner → .S o frame'i restore + eret → sonraki görev sürer.
// Yeni görev = SENTETİK trap-frame (272 bayt): ELR=giriş, SPSR=0x5 (EL1h, IRQ-açık →
// görev de preempt edilir), gerisi 0. kdl_preempt_gorev_olustur birebir.
// Adres-uzayı TEK (kem_os EL1 görevleri) → TTBR swap YOK (v1). Öncelik/blok YOK (v1).

sabit KG_PSP: tam64 = 1157636096;         // 0x45002000: psp[i] tablosu (@+i*8; page-table üstü)
sabit KG_OLU: tam64 = 1157639168;         // 0x45002c00: olu[i] tablosu (kdl_olu[] birebir; 1=bitmiş)
sabit KG_G1: tam64 = 1157640192;          // 0x45003000: görev1 sayacı (FİXED RAM, volatile deref)
sabit KG_G2: tam64 = 1157640200;          // 0x45003008: görev2 sayacı
sabit KG_AKTIF: tam64 = 1157640208;       // 0x45003010: preempt-aktif bayrağı (FİXED RAM — küresel
                                          // olsaydı store1→store0 arası IRQ-okuması clang'a görünmez →
                                          // dead-store-elim ile store1 silinir → asla switch olmaz)
sabit KG_STK1: tam64 = 1192230912;        // 0x47100000: görev1 yığın tepesi (free RAM)
sabit KG_STK2: tam64 = 1193279488;        // 0x47200000: görev2 yığın tepesi

// Scheduler durumu — YALNIZ .kem okur/yazar (.S paylaşımı yok) → küresel internal OK.
// Sayaçlar (kem_g1/g2) FİXED RAM: yalnız asm-ile-kullanılan küresel DGE ile silinir →
// fixed-adres çıplak deref (volatile) hem stripping'i hem sonsuz-döngü store-sink'i çözer.
küresel değişken kem_paktif: tam64 = 0;    // o an koşan görev
küresel değişken kem_psayi: tam64 = 0;     // görev sayısı (0=main dahil kem_preempt_baslat'ta 1)

çıplak işlev kg_psp_yaz(i: tam64, v: tam64) { değişken p: *tam64 = (KG_PSP + i * 8) olarak *tam64; *p = v; }
çıplak işlev kg_psp_oku(i: tam64) -> tam64 { değişken p: *tam64 = (KG_PSP + i * 8) olarak *tam64; ver *p; }
çıplak işlev kg_yaz64(adr: tam64, v: tam64) { değişken p: *tam64 = adr olarak *tam64; *p = v; }
çıplak işlev kg_oku64(adr: tam64) -> tam64 { değişken p: *tam64 = adr olarak *tam64; ver *p; }

// main = görev 0; ilk preempt'te gerçek trap-frame SP'si kaydedilir.
çıplak işlev kem_preempt_baslat() {
    kem_paktif = 0;
    kem_psayi = 1;
    kg_yaz64(KG_AKTIF, 0);
    kg_yaz64(KG_G1, 0);          // sayaçları sıfırla (fixed RAM)
    kg_yaz64(KG_G2, 0);
    değişken k: tam64 = 0;
    iken k < 16 { kg_yaz64(KG_OLU + k * 8, 0); k = k + 1; }   // olu[] tablosu temizle
}
çıplak işlev kem_preempt_ac() { kg_yaz64(KG_AKTIF, 1); }

// Sentetik trap-frame kur (kdl_preempt_gorev_olustur birebir): 34 slot × 8 = 272 bayt,
// tf@248=ELR=giriş, tf@256=SPSR=0x5 (EL1h IRQ-açık), gerisi 0. SP 16-hizalı. id döner.
çıplak işlev kem_gorev_olustur(giris: tam64, yigin_tepe: tam64) -> tam64 {
    değişken sp: tam64 = yigin_tepe - 272;
    sp = (sp / 16) * 16;                          // 16-hizala
    değişken k: tam64 = 0;
    iken k < 34 { kg_yaz64(sp + k * 8, 0); k = k + 1; }   // 34 slot sıfırla
    kg_yaz64(sp + 248, giris);                    // ELR_EL1 @248 = eret hedefi
    kg_yaz64(sp + 256, 5);                        // SPSR @256 = 0x5 (EL1h, IRQ açık)
    değişken i: tam64 = kem_psayi;
    kg_psp_yaz(i, sp);
    kem_psayi = kem_psayi + 1;
    ver i;
}

// Round-robin scheduler — .kem kdl_irq_isle her timer IRQ'da çağırır. sp = kesilen
// görevin trap-frame SP'si. aktif değilse/tek görevse sp (switch yok → A3 timer nötr).
// kdl_preempt birebir: bitmiş (kg_olu=1) görevler ATLANIR (round-robin sırada tara).
çıplak işlev kem_preempt(sp: tam64) -> tam64 {
    eğer (kg_oku64(KG_AKTIF) == 0) veya (kem_psayi < 2) { ver sp; }
    kg_psp_yaz(kem_paktif, sp);                   // mevcut görevin SP'sini kaydet
    değişken n: tam64 = kem_paktif;
    değişken t: tam64 = 0;
    değişken bulundu: tam64 = 0;
    iken (t < kem_psayi) ve (bulundu == 0) {      // en fazla psayi adım tara, ilk canlıda dur
        n = n + 1;
        eğer n >= kem_psayi { n = 0; }
        eğer kg_oku64(KG_OLU + n * 8) == 0 { kem_paktif = n; bulundu = 1; }
        t = t + 1;
    }
    ver kg_psp_oku(kem_paktif);                   // sonraki (canlı) görevin SP'si → .S switch
}

// Aktif görevi BİTİR (izolasyon-ihlali/exit) — kdl_gorev_bitir birebir. Scheduler bir
// daha seçmez (kem_preempt yukarıdaki tarama sırasında atlar).
çıplak işlev kem_gorev_bitir() {
    kg_yaz64(KG_OLU + kem_paktif * 8, 1);
}

// Görev gövdeleri — sonsuz sayaç (preemption ile kesilir; timer IRQ round-robin döndürür).
// Fixed-RAM volatile deref (kg_yaz64/kg_oku64) → store sink EDİLMEZ, main taze görür.
çıplak işlev kem_gorev1() { iken 1 == 1 { kg_yaz64(KG_G1, kg_oku64(KG_G1) + 1); } }
çıplak işlev kem_gorev2() { iken 1 == 1 { kg_yaz64(KG_G2, kg_oku64(KG_G2) + 1); } }

// Görev giriş adreslerini asm ile materyalize et (.kem işlev-adresi → tam64).
çıplak işlev kg_gorev1_adr() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: arm64 şablon: r#"adrp $0, kem_gorev1
add $0, $0, :lo12:kem_gorev1"# çıktı("=r", &x) } }
    ver x;
}
çıplak işlev kg_gorev2_adr() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: arm64 şablon: r#"adrp $0, kem_gorev2
add $0, $0, :lo12:kem_gorev2"# çıktı("=r", &x) } }
    ver x;
}
// A4 gate: 2 preemptive görev kur → preemption aç → main spin ederken timer-IRQ
// round-robin ile görevlere geçer → her iki sayaç ilerler (INTERLEAVE) → preemption
// çalışıyor. guard'lı (switch bozuksa hang yok). Sonra preemption'ı KAPAT → main
// [6..10]'a devam eder (görevler artık seçilmez — sonsuz döngüleri terk edilir).
çıplak işlev kem_preempt_testi() -> tam32 {
    kem_preempt_baslat();
    değişken t1: tam64 = kem_gorev_olustur(kg_gorev1_adr(), KG_STK1);
    değişken t2: tam64 = kem_gorev_olustur(kg_gorev2_adr(), KG_STK2);
    kem_preempt_ac();
    değişken guard: tam64 = 0;
    iken ((kg_oku64(KG_G1) < 2) veya (kg_oku64(KG_G2) < 2)) ve (guard < 200000000) {
        guard = guard + 1;
    }
    kg_yaz64(KG_AKTIF, 0);                        // preemption DURDUR → main devam
    eğer (kg_oku64(KG_G1) >= 2) ve (kg_oku64(KG_G2) >= 2) {
        ver 1;                                     // her iki görev de koştu → interleave
    }
    ver 0;
}

// ============================================================================
// A5 (D-281): SAF-.kem SYSCALL + EL0 USERSPACE. A4 preemptive altyapısını kullanır:
// EL0 görev = sentetik trap-frame SPSR=0x0 (EL0t, IRQ-açık) + SP_EL0=user yığını +
// ELR=EL0 stub (0x42000000, AP=01 sayfa). Timer-IRQ preemption ile EL0↔main döner.
// EL0 stub: movz x8,#7 / svc #0 / b .-8 (sonsuz syscall). SVC → .S kdl_exc_ortak
// (EC=0x15) → .kem kdl_syscall_isle → sayaç++. main sayacın ilerlediğini doğrular →
// GERÇEK EL0'dan syscall. EL0 kod DERLENMİŞ .kem değil (section yok) → runtime yazılan
// makine-kodu (llvm-mc doğrulanmış kelimeler) AP=01 sayfaya + I-cache maintenance.

sabit KG_SYSC: tam64 = 1157640216;        // 0x45003018: syscall sayacı (fixed RAM)
sabit KG_EL0_KOD: tam64 = 1107296256;     // 0x42000000: EL0 stub (AP=01, EL0-exec)
sabit KG_EL0_STK: tam64 = 1108344832;     // 0x42100000: EL0 user yığını (SP_EL0, AP=01)

çıplak işlev kg_yaz32(adr: tam64, v: tam32) { değişken p: *tam32 = adr olarak *tam32; *p = v; }

// I-cache maintenance: yazılan kodu icache'e görünür kıl (dc cvau→dsb→ic ivau→dsb→isb).
çıplak işlev kg_icache_flush(adr: tam64) {
    güvensiz {
        satıriçi_asm {
            mimari: arm64
            şablon: r#"dc cvau, $0
dsb ish
ic ivau, $0
dsb ish
isb"#
            girdi("r", adr)
            bozulan("~{memory}")
        }
    }
}

// EL0 preemptive görev: sentetik trap-frame SPSR=0x0 (EL0t) + SP_EL0@264=user_stk.
// (kem_gorev_olustur EL1 sürümü gibi ama EL0t + banked user-SP.)
çıplak işlev kem_gorev_olustur_el0(giris: tam64, kernel_tepe: tam64, user_tepe: tam64) -> tam64 {
    değişken sp: tam64 = kernel_tepe - 272;
    sp = (sp / 16) * 16;
    değişken k: tam64 = 0;
    iken k < 34 { kg_yaz64(sp + k * 8, 0); k = k + 1; }
    kg_yaz64(sp + 248, giris);                    // ELR_EL1 @248 = EL0 giriş
    kg_yaz64(sp + 256, 0);                        // SPSR @256 = 0x0 (EL0t, IRQ açık)
    kg_yaz64(sp + 264, user_tepe);                // SP_EL0 @264 = user yığını
    değişken i: tam64 = kem_psayi;
    kg_psp_yaz(i, sp);
    kem_psayi = kem_psayi + 1;
    ver i;
}

// SVC handler — .S kdl_exc_ortak (EC=0x15) `bl kdl_syscall_isle(num,arg,arg2)` çağırır.
// num=7 → syscall sayacı++ (EL0'dan gerçek syscall kanıtı). Dönüş → EL0 x0.
çıplak işlev kdl_syscall_isle(num: tam64, arg: tam64, arg2: tam64) -> tam64 {
    eğer num == 7 {
        kg_yaz64(KG_SYSC, kg_oku64(KG_SYSC) + 1);
    }
    ver arg;                                       // echo arg → EL0 x0
}

// A5 gate: EL0 stub yaz → EL0 preemptive görev → syscall sayacı ilerliyor mu (>=3)?
// Sayaç YALNIZ EL0 stub'ın svc'siyle artar → EL0'dan gerçek syscall round-trip.
çıplak işlev kem_el0_testi() -> tam32 {
    kg_yaz32(KG_EL0_KOD + 0, 3531604200 olarak tam32);   // movz x8, #7
    kg_yaz32(KG_EL0_KOD + 4, 3556769793 olarak tam32);   // svc #0
    kg_yaz32(KG_EL0_KOD + 8, 402653182 olarak tam32);    // b .-8 (loop)
    kg_icache_flush(KG_EL0_KOD);
    kg_yaz64(KG_SYSC, 0);
    kem_preempt_baslat();
    kem_gorev_olustur_el0(KG_EL0_KOD, KG_STK1, KG_EL0_STK);
    kem_preempt_ac();
    değişken guard: tam64 = 0;
    iken (kg_oku64(KG_SYSC) < 3) ve (guard < 200000000) { guard = guard + 1; }
    kg_yaz64(KG_AKTIF, 0);                          // preemption durdur → main devam
    eğer kg_oku64(KG_SYSC) >= 3 { ver 1; }
    ver 0;
}

// A5+B2 gate: GERÇEK EL0 izolasyon-ihlali. EL0 stub GIC MMIO'ya (0x08000000, Device
// AP=00, EL0-erişimi YASAK) erişir → permission-fault, EL0-kaynaklı → .S kill AÇIKSA
// kdl_el0_izolasyon_isle(.kem) çağırır → kem_gorev_bitir → KG_OLU[görev]=1. Doğrula:
// görev ölü işaretlendi + scheduler onu ATLADI (bir daha koşmadı) + OS DEVAM etti.
sabit KG_EL0_KOTU: tam64 = 1107296512;    // 0x42000100: kötü-erişim stub (syscall stub'dan uzak)

çıplak işlev kem_el0_izolasyon_testi() -> tam32 {
    kg_yaz32(KG_EL0_KOTU + 0, 3531603977 olarak tam32);   // mov x9, #0
    kg_yaz32(KG_EL0_KOTU + 4, 4070637577 olarak tam32);   // movk x9, #0x800, lsl #16
    kg_yaz32(KG_EL0_KOTU + 8, 4181721386 olarak tam32);   // ldr x10, [x9]  (GIC AP=00 → fault)
    kg_yaz32(KG_EL0_KOTU + 12, 402653181 olarak tam32);   // b .-12 (fault kill'lemezse loop)
    kg_icache_flush(KG_EL0_KOTU);
    kis_el0_kill_ac();                                     // opt-in: EL0 fault → süreç öldür
    kem_preempt_baslat();
    değişken t: tam64 = kem_gorev_olustur_el0(KG_EL0_KOTU, KG_STK2, KG_EL0_STK + 4096);
    kem_preempt_ac();
    değişken guard: tam64 = 0;
    iken (kg_oku64(KG_OLU + t * 8) == 0) ve (guard < 200000000) { guard = guard + 1; }
    kem_preempt_aktif_kapat();                             // preemption durdur → main devam
    eğer kg_oku64(KG_OLU + t * 8) == 1 { ver 1; }          // görev ölü işaretlendi = izolasyon çalıştı
    ver 0;
}
çıplak işlev kem_preempt_aktif_kapat() { kg_yaz64(KG_AKTIF, 0); }

// ============================================================================
// LINCHPIN (USERLAND_ROADMAP ADIM 1, D-286): GERÇEK .kem-DERLENMİŞ kod EL0'da koşuyor
// mu? A5/B2'nin EL0 stub'ları RUNTIME'DA YAZILAN makine-kodu (llvm-mc byte'lar) idi —
// bu, `.kem` KAYNAĞINDAN normal derlenen bir çıplak fn'in (`kul_test`) `.user` section'a
// (Makefile'daki objcopy --rename-section adımıyla, .text.kul_*→.user.kul_*) yönlendirilip
// EL0'da GERÇEKTEN yürütüldüğünü kanıtlar. Prefix `kul_` = userland-routing sözleşmesi
// (linker glob'u BUNU eşleştirir — Makefile'a bak). metin literal YOK (isim-öneksiz
// @.str.N sorunu, routing'e uymaz) — yalnız satıriçi_asm syscall.

// Sonsuz syscall-döngüsü (num=7 → .kem kdl_syscall_isle KG_SYSC++, A5'ten kanıtlı).
çıplak işlev kul_test() {
    iken 1 == 1 {
        güvensiz {
            satıriçi_asm {
                mimari: arm64
                şablon: r#"mov x8, #7
svc #0"#
                bozulan("~{x8}") bozulan("~{memory}")
            }
        }
    }
}
çıplak işlev kul_test_adr() -> tam64 {
    değişken x: tam64 = 0;
    güvensiz { satıriçi_asm { mimari: arm64 şablon: r#"adrp $0, kul_test
add $0, $0, :lo12:kul_test"# çıktı("=r", &x) } }
    ver x;
}

// Gate: kul_test'i EL0 görevi olarak spawn et → KG_SYSC GERÇEK .kem-derlenmiş koddan
// artıyor mu? (routing yanlışsa: kul_test hâlâ kernel .text'te kalır — EL0'dan
// koşturulmaya ÇALIŞILSA bile giriş adresi kernel .text=AP=00 olur → instruction-fetch
// permission-fault, KG_SYSC HİÇ ARTMAZ, guard süresi dolar, testi başarısız eder.)
çıplak işlev kem_linchpin_testi() -> tam32 {
    kg_yaz64(KG_SYSC, 0);
    kem_preempt_baslat();
    değişken t: tam64 = kem_gorev_olustur_el0(kul_test_adr(), KG_STK1, KG_EL0_STK + 8192);
    kem_preempt_ac();
    değişken guard: tam64 = 0;
    iken (kg_oku64(KG_SYSC) < 3) ve (guard < 200000000) { guard = guard + 1; }
    kg_yaz64(KG_AKTIF, 0);
    eğer kg_oku64(KG_SYSC) >= 3 { ver 1; }
    ver 0;
}
