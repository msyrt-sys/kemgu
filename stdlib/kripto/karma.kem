// KEMGU Stdlib — Kripto Karma (Hash Fonksiyonları, Constant-Time)
// =================================================================
//
// SHA-256 (FIPS 180-4) sabit-süre referans implementasyonu.
// BLAKE3 placeholder (V2: tam implementasyon ARM SIMD + tree mode).
//
// Tasarım:
//   - K round constants ve H0 initial values PUBLIC (standardize, RFC 6234)
//   - Working state ve message schedule W[64] sabitsüre<dtam32>
//   - ROTR ve mantıksal opsler tüm dallar sabit (zaten Sabitsüre Spec V1)
//   - Round indeksi `i` PUBLIC (sayim icin), K[i] erisimi PUBLIC indeks (CT-OK)
//
// Niye sabit-süre SHA?
//   - HMAC anahtarinin XOR-padding'i kendisi sabit, ama icerideki SHA
//     blok islemleri eger non-CT olursa anahtarin etkisi zamanlanir.
//   - Brumley & Tuveri 2011: ECDSA `k` SHA-truncate path'ten leak.
//
// Bu dosya saf KEMGU. `--check` ile dogrulanir.
//
// Sinirlamalar (V1):
//   - Bu modul standalone — kripto.kem'deki primitif'leri yeniden tanimlar
//     (import sistemi henuz yok; CLAUDE.md tek-dosya derleme).
//   - Sadece 1-blok SHA-256 demo; tam streaming API V2'de.

// =============================================================================
// İçsel CT yardımcıları (kripto.kem ile çakışmasın diye _karma_ önekli)
// =============================================================================

işlev _karma_rotr_u32(x: sabitsüre<dtam32>, n: tam32) -> sabitsüre<dtam32> {
    değişken sag: sabitsüre<dtam32> = x >> n;
    değişken sol: sabitsüre<dtam32> = x << (32 - n);
    ver sag | sol;
}

// SHA-256 Σ0 (Sigma0): (x ROTR 2) ^ (x ROTR 13) ^ (x ROTR 22)
işlev _karma_sigma0(x: sabitsüre<dtam32>) -> sabitsüre<dtam32> {
    değişken r2: sabitsüre<dtam32> = _karma_rotr_u32(x, 2);
    değişken r13: sabitsüre<dtam32> = _karma_rotr_u32(x, 13);
    değişken r22: sabitsüre<dtam32> = _karma_rotr_u32(x, 22);
    ver r2 ^ r13 ^ r22;
}

// SHA-256 Σ1 (Sigma1): (x ROTR 6) ^ (x ROTR 11) ^ (x ROTR 25)
işlev _karma_sigma1(x: sabitsüre<dtam32>) -> sabitsüre<dtam32> {
    değişken r6: sabitsüre<dtam32> = _karma_rotr_u32(x, 6);
    değişken r11: sabitsüre<dtam32> = _karma_rotr_u32(x, 11);
    değişken r25: sabitsüre<dtam32> = _karma_rotr_u32(x, 25);
    ver r6 ^ r11 ^ r25;
}

// SHA-256 σ0 (sigma0_low): (x ROTR 7) ^ (x ROTR 18) ^ (x SHR 3)
işlev _karma_sigma0_low(x: sabitsüre<dtam32>) -> sabitsüre<dtam32> {
    değişken r7: sabitsüre<dtam32> = _karma_rotr_u32(x, 7);
    değişken r18: sabitsüre<dtam32> = _karma_rotr_u32(x, 18);
    değişken s3: sabitsüre<dtam32> = x >> 3;
    ver r7 ^ r18 ^ s3;
}

// SHA-256 σ1 (sigma1_low): (x ROTR 17) ^ (x ROTR 19) ^ (x SHR 10)
işlev _karma_sigma1_low(x: sabitsüre<dtam32>) -> sabitsüre<dtam32> {
    değişken r17: sabitsüre<dtam32> = _karma_rotr_u32(x, 17);
    değişken r19: sabitsüre<dtam32> = _karma_rotr_u32(x, 19);
    değişken s10: sabitsüre<dtam32> = x >> 10;
    ver r17 ^ r19 ^ s10;
}

// SHA-256 Ch (choose): (x & y) ^ (~x & z) — branchless multiplexer
işlev _karma_ch(x: sabitsüre<dtam32>, y: sabitsüre<dtam32>, z: sabitsüre<dtam32>) -> sabitsüre<dtam32> {
    // ~x = x ^ 0xFFFFFFFF — sabitsüre üzerinde bitwise NOT yok, XOR ile.
    değişken hepsi: dtam32 = 4294967295;
    değişken not_x: sabitsüre<dtam32> = x ^ sabitsüre_olustur(hepsi);
    ver (x & y) ^ (not_x & z);
}

// SHA-256 Maj (majority): (x & y) ^ (x & z) ^ (y & z) — also branchless
işlev _karma_maj(x: sabitsüre<dtam32>, y: sabitsüre<dtam32>, z: sabitsüre<dtam32>) -> sabitsüre<dtam32> {
    ver (x & y) ^ (x & z) ^ (y & z);
}

// =============================================================================
// SHA-256 Round Constants K (FIPS 180-4 §4.2.2 — public)
// =============================================================================

işlev sha256_K() -> Dizi<dtam32> {
    ver [
        0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5,
        0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
        0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3,
        0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
        0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC,
        0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
        0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7,
        0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
        0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13,
        0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
        0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3,
        0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
        0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5,
        0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
        0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208,
        0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2
    ];
}

// =============================================================================
// SHA-256 Initial Hash Values H0 (FIPS 180-4 §5.3.3 — public)
// =============================================================================

işlev sha256_H0() -> Dizi<dtam32> {
    ver [
        0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A,
        0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19
    ];
}

// =============================================================================
// SHA-256 Tek Blok Sıkıştırma (512-bit blok = 16 dtam32 = 64 bayt)
// =============================================================================
//
// State (a..h) 8 dtam32 — sabitsüre, içerikleri gizli (hash intermediate)
// Block (M[0..15]) — sabitsüre, çünkü gizli mesajdan geliyor
// Schedule W[0..63] — sabitsüre, türevsel
//
// Bu fonksiyon FIPS 180-4 §6.2.2 algoritması. CT discipline:
//   - Tüm aritmetik (+ - * & | ^ >>) sabit-süre opcode'lar
//   - Hiç dallanma yok (rounds for-loop public counter)
//   - K[i] erişimi public i ile — CT002 ihlali değil

işlev sha256_blok_sikistir(
    state: Dizi<sabitsüre<dtam32>>,
    blok_w: Dizi<sabitsüre<dtam32>>
) -> tam32 {
    // Message schedule W[64] inşa et
    değişken W: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32)),
        sabitsüre_olustur((0 olarak dtam32)), sabitsüre_olustur((0 olarak dtam32))
    ];

    // İlk 16 kelime blok'tan kopyalanır (W[0..15] = blok_w[0..15])
    değişken i: tam32 = 0;
    iken i < 16 {
        W[i] = blok_w[i];
        i = i + 1;
    }

    // W[16..63] = σ1(W[i-2]) + W[i-7] + σ0(W[i-15]) + W[i-16]
    i = 16;
    iken i < 64 {
        değişken s1: sabitsüre<dtam32> = _karma_sigma1_low(W[i - 2]);
        değişken s0: sabitsüre<dtam32> = _karma_sigma0_low(W[i - 15]);
        W[i] = s1 + W[i - 7] + s0 + W[i - 16];
        i = i + 1;
    }

    // Round constants
    değişken K: Dizi<dtam32> = sha256_K();

    // Working variables a..h
    değişken a: sabitsüre<dtam32> = state[0];
    değişken b: sabitsüre<dtam32> = state[1];
    değişken c: sabitsüre<dtam32> = state[2];
    değişken d: sabitsüre<dtam32> = state[3];
    değişken e: sabitsüre<dtam32> = state[4];
    değişken f: sabitsüre<dtam32> = state[5];
    değişken g: sabitsüre<dtam32> = state[6];
    değişken h: sabitsüre<dtam32> = state[7];

    // 64 rounds
    i = 0;
    iken i < 64 {
        değişken T1: sabitsüre<dtam32> = h + _karma_sigma1(e) + _karma_ch(e, f, g) + K[i] + W[i];
        değişken T2: sabitsüre<dtam32> = _karma_sigma0(a) + _karma_maj(a, b, c);
        h = g;
        g = f;
        f = e;
        e = d + T1;
        d = c;
        c = b;
        b = a;
        a = T1 + T2;
        i = i + 1;
    }

    // Update state — H[i] = H[i] + a..h
    state[0] = state[0] + a;
    state[1] = state[1] + b;
    state[2] = state[2] + c;
    state[3] = state[3] + d;
    state[4] = state[4] + e;
    state[5] = state[5] + f;
    state[6] = state[6] + g;
    state[7] = state[7] + h;

    ver 0;
}

// =============================================================================
// BLAKE3 Placeholder — V2'de tam implementasyon
// =============================================================================
//
// BLAKE3 SHA-3 finalisti, ChaCha-tabanlı, paralelize edilebilir tree mode.
// V1'de placeholder — sadece API yüzeyi. V2'de:
//   - Compression function (8 round x 4 quarter rounds)
//   - Tree mode (chunk-parallel, SIMD-friendly)
//   - Extendable output (XOF)

// İptal işareti — V2 implementasyonu beklenir
işlev blake3_init() -> Dizi<sabitsüre<dtam32>> {
    // Stub: 8 başlangıç state'i (BLAKE3 IV — SHA-256 H0 ile aynı)
    ver [
        sabitsüre_olustur((0x6A09E667 olarak dtam32)),
        sabitsüre_olustur((0xBB67AE85 olarak dtam32)),
        sabitsüre_olustur((0x3C6EF372 olarak dtam32)),
        sabitsüre_olustur((0xA54FF53A olarak dtam32)),
        sabitsüre_olustur((0x510E527F olarak dtam32)),
        sabitsüre_olustur((0x9B05688C olarak dtam32)),
        sabitsüre_olustur((0x1F83D9AB olarak dtam32)),
        sabitsüre_olustur((0x5BE0CD19 olarak dtam32))
    ];
}

// HMAC-SHA256 Placeholder — RFC 2104, V2'de tam impl.
// inner_pad: K XOR 0x36 (block_size bytes); outer_pad: K XOR 0x5C
//
// HMAC = SHA256(K_outer || SHA256(K_inner || message))
//
// Burada sadece imza ve XOR pad'leri yapan kısım — full pipeline V2.

// HMAC pad'leri üret — K ⊕ ipad ve K ⊕ opad
işlev hmac_pad_uret(
    anahtar: Dizi<sabitsüre<dtam8>>,
    anahtar_uzunluk: tam32,
    inner: Dizi<sabitsüre<dtam8>>,
    outer: Dizi<sabitsüre<dtam8>>
) -> tam32 {
    değişken ipad: dtam8 = 0x36;
    değişken opad: dtam8 = 0x5C;
    değişken i: tam32 = 0;
    iken i < anahtar_uzunluk {
        inner[i] = anahtar[i] ^ sabitsüre_olustur(ipad);
        outer[i] = anahtar[i] ^ sabitsüre_olustur(opad);
        i = i + 1;
    }
    ver 0;
}

// =============================================================================
// D-XXX (Tur 23a) — Çok-bloklu SHA-256 + HMAC-SHA256 (RFC 2104)
// =============================================================================
//
// sha256_bayt: FIPS 180-4 §5.1 dolgusu (n bayt + 0x80 + sıfırlar + 8-baytlık
// BÜYÜK-UÇ bit uzunluğu; üst 32 bit 0 yeter; toplam 64'ün katı). Her 64-baytlık
// blok için 16 kelime BÜYÜK-UÇ kurulur (w = b0<<24 | b1<<16 | b2<<8 | b3) ve
// sha256_blok_sikistir çağrılır. Durum sha256_H0()'dan başlar; 8 kelimelik
// durum döner.
//
// hmac_sha256: RFC 2104, blok 64 bayt. anahtar > 64 ise önce sha256_bayt ile
// özetlenir (özetin 32 baytı büyük-uç), sonra 64'e sıfırla doldurulur. İç ped
// K ⊕ ipad(0x36), dış ped K ⊕ opad(0x5C). ic = ped || mesaj → sha256_bayt(ic,64+mn);
// dis = ped || iç özet (32 bayt büyük-uç) → sha256_bayt(dis,96).

işlev sha256_bayt(veri: Dizi<sabitsüre<dtam8>>, n: tam32) -> Dizi<sabitsüre<dtam32>> {
    // Toplam dolgulu uzunluk: n + 1 (0x80) + sıfırlar + 8 (uzunluk) → 64'ün katı
    değişken toplam: tam32 = ((n + 9 + 63) / 64) * 64;
    değişken tampon: Dizi<sabitsüre<dtam8>> = [];
    değişken i: tam32 = 0;
    iken i < n {
        dizi_ekle(tampon, veri[i]);
        i = i + 1;
    }
    dizi_ekle(tampon, sabitsüre_olustur(0x80 olarak dtam8));
    iken dizi_boyut(tampon) < toplam - 8 {
        dizi_ekle(tampon, sabitsüre_olustur(0 olarak dtam8));
    }
    // 8 bayt BÜYÜK-UÇ bit uzunluğu (n*8; üst 32 bit 0 yeter)
    değişken bit_uz: dtam32 = (n olarak dtam32) * 8;
    dizi_ekle(tampon, sabitsüre_olustur(0 olarak dtam8));
    dizi_ekle(tampon, sabitsüre_olustur(0 olarak dtam8));
    dizi_ekle(tampon, sabitsüre_olustur(0 olarak dtam8));
    dizi_ekle(tampon, sabitsüre_olustur(0 olarak dtam8));
    dizi_ekle(tampon, sabitsüre_olustur(((bit_uz >> 24) & 255) olarak dtam8));
    dizi_ekle(tampon, sabitsüre_olustur(((bit_uz >> 16) & 255) olarak dtam8));
    dizi_ekle(tampon, sabitsüre_olustur(((bit_uz >> 8) & 255) olarak dtam8));
    dizi_ekle(tampon, sabitsüre_olustur((bit_uz & 255) olarak dtam8));

    // Başlangıç durumu (FIPS 180-4 H0)
    değişken H: Dizi<dtam32> = sha256_H0();
    değişken state: Dizi<sabitsüre<dtam32>> = [
        sabitsüre_olustur(H[0]), sabitsüre_olustur(H[1]),
        sabitsüre_olustur(H[2]), sabitsüre_olustur(H[3]),
        sabitsüre_olustur(H[4]), sabitsüre_olustur(H[5]),
        sabitsüre_olustur(H[6]), sabitsüre_olustur(H[7])
    ];

    // Her 64-baytlık bloğu sıkıştır
    değişken blok_sayisi: tam32 = toplam / 64;
    değişken b: tam32 = 0;
    iken b < blok_sayisi {
        değişken blok: Dizi<sabitsüre<dtam32>> = [];
        değişken j: tam32 = 0;
        iken j < 16 {
            değişken off: tam32 = b * 64 + j * 4;
            // [D-709] gizli baytlar AÇIĞA ÇIKARILMADAN genişletilir (sabitsüre içinde;
            // dtam8 → dtam32 zext). ifşa yalnız çağıranın bilinçli kararıdır.
            değişken b0: sabitsüre<dtam32> = tampon[off] olarak sabitsüre<dtam32>;
            değişken b1: sabitsüre<dtam32> = tampon[off + 1] olarak sabitsüre<dtam32>;
            değişken b2: sabitsüre<dtam32> = tampon[off + 2] olarak sabitsüre<dtam32>;
            değişken b3: sabitsüre<dtam32> = tampon[off + 3] olarak sabitsüre<dtam32>;
            değişken w: sabitsüre<dtam32> = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
            dizi_ekle(blok, w);
            j = j + 1;
        }
        sha256_blok_sikistir(state, blok);
        b = b + 1;
    }
    ver state;
}

işlev hmac_sha256(
    anahtar: Dizi<sabitsüre<dtam8>>, an: tam32,
    mesaj: Dizi<sabitsüre<dtam8>>, mn: tam32
) -> Dizi<sabitsüre<dtam32>> {
    // K'yı 64 bayta normalize et (uzunsa önce hash'le → 32 bayt büyük-uç)
    değişken K: Dizi<sabitsüre<dtam8>> = [];
    değişken i: tam32 = 0;
    eğer an > 64 {
        değişken ozet: Dizi<sabitsüre<dtam32>> = sha256_bayt(anahtar, an);
        iken i < 8 {
            değişken w: sabitsüre<dtam32> = ozet[i];   // [D-709] açığa çıkarmadan bayta böl (daraltma düşük baytı tutar)
            dizi_ekle(K, (w >> 24) olarak sabitsüre<dtam8>);
            dizi_ekle(K, (w >> 16) olarak sabitsüre<dtam8>);
            dizi_ekle(K, (w >> 8) olarak sabitsüre<dtam8>);
            dizi_ekle(K, w olarak sabitsüre<dtam8>);
            i = i + 1;
        }
    } değilse {
        iken i < an {
            dizi_ekle(K, anahtar[i]);
            i = i + 1;
        }
    }
    iken dizi_boyut(K) < 64 {
        dizi_ekle(K, sabitsüre_olustur(0 olarak dtam8));
    }

    // İç: (K ⊕ ipad) || mesaj
    değişken ip: dtam8 = 0x36;
    değişken ic: Dizi<sabitsüre<dtam8>> = [];
    i = 0;
    iken i < 64 {
        dizi_ekle(ic, K[i] ^ sabitsüre_olustur(ip));
        i = i + 1;
    }
    i = 0;
    iken i < mn {
        dizi_ekle(ic, mesaj[i]);
        i = i + 1;
    }
    değişken ic_ozet: Dizi<sabitsüre<dtam32>> = sha256_bayt(ic, 64 + mn);

    // Dış: (K ⊕ opad) || iç özet (32 bayt büyük-uç)
    değişken op: dtam8 = 0x5C;
    değişken dis: Dizi<sabitsüre<dtam8>> = [];
    i = 0;
    iken i < 64 {
        dizi_ekle(dis, K[i] ^ sabitsüre_olustur(op));
        i = i + 1;
    }
    i = 0;
    iken i < 8 {
        değişken w2: sabitsüre<dtam32> = ic_ozet[i];   // [D-709] açığa çıkarmadan bayta böl
        dizi_ekle(dis, (w2 >> 24) olarak sabitsüre<dtam8>);
        dizi_ekle(dis, (w2 >> 16) olarak sabitsüre<dtam8>);
        dizi_ekle(dis, (w2 >> 8) olarak sabitsüre<dtam8>);
        dizi_ekle(dis, w2 olarak sabitsüre<dtam8>);
        i = i + 1;
    }
    ver sha256_bayt(dis, 96);
}
