// KEMGU Stdlib — Dosya I/O (iskelet)
// =====================================
//
// SINIR (KIRMIZI_QUEUE G: "stdlib::dosya syscall altyapısı gerek"):
//   Mevcut --check derleyici sadece tip kontrol modunda; runtime
//   tarafında dosya açma/okuma/yazma syscall wrapper'ları LLVM IR
//   katmanında var (test/ornekler/dosya_io.kem'de dosya_ac /
//   dosya_yazdır / dosya_kapat / dosya_tumu_oku kullanımı) ama
//   tip_kontrol built-in tablosunda yok.
//
// Bu modül tam API skeleton — runtime primitif eklendiğinde body'ler
// gerçek implementasyona çevrilecek (kullanıcı kodu kırılmayacak).
//
// API tasarımı:
//   - Tüm I/O ops sonuç<T, metin> döner (hata mesaj olarak)
//   - Açma/kapama explicit (handle = metin temsili şimdilik)
//   - Buffer/stream kavramları v2'de (LineReader, BufferedWriter)
//
// Tasarım kuralı: Java FileInputStream + checked exception tuzağına
//   düşme — her hata sonuç<T,E> ile açık, runtime patlatma yok.

// =============================================================================
// Sentinel sabitleri (handle ABI gelene kadar metin tabanlı)
// =============================================================================

// Geçersiz handle göstergesi (boş metin).
işlev gecersiz_handle() -> metin {
    ver "";
}

// Handle geçerli mi.
işlev handle_gecerli_mi(h: metin) -> mantıksal {
    ver h != "";
}

// =============================================================================
// Açma / kapama
// =============================================================================

// Mod sabitleri (string tabanlı — runtime'ın bekledigi).
işlev mod_okuma() -> metin { ver "okuma"; }
işlev mod_yazma() -> metin { ver "yazma"; }
işlev mod_ekleme() -> metin { ver "ekleme"; }

// Aç — yol ve mod ile dosya handle döner.
// YAPILACAK: dosya_ac runtime primitifi gerek (open syscall).
işlev ac(yol: metin, mod: metin) -> sonuç<metin, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    eğer mod == "" { ver hata("bos mod"); }
    // STUB: gerçek runtime'da dosya_ac(yol, mod) çağrılacak.
    ver tamam(yol);
}

// Kapat — handle'ı kapat.
// YAPILACAK: dosya_kapat runtime primitifi gerek (close syscall).
işlev kapat(h: metin) -> sonuç<tam32, metin> {
    eğer değil (handle_gecerli_mi(h)) { ver hata("gecersiz handle"); }
    ver tamam(0);
}

// =============================================================================
// Okuma
// =============================================================================

// Tüm dosyayı metin olarak oku.
// YAPILACAK: dosya_tumu_oku runtime primitifi gerek (open + read + close).
işlev oku_metin(yol: metin) -> sonuç<metin, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    // STUB: gerçek runtime: dosya_tumu_oku(yol) → metin
    ver tamam("");
}

// Satır satır oku — Dizi<metin>.
// YAPILACAK: dosya_satir_oku runtime primitifi gerek.
işlev oku_satirlar(yol: metin) -> sonuç<Dizi<metin>, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    // STUB: gerçek runtime: dosya_satirlari(yol)
    değişken bos: Dizi<metin> = [];
    ver tamam(bos);
}

// =============================================================================
// Yazma
// =============================================================================

// Dosyayı **üzerine yaz** (truncate + write).
// YAPILACAK: dosya_yaz_tam runtime primitifi gerek.
işlev yaz_metin(yol: metin, icerik: metin) -> sonuç<tam32, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    // STUB: gerçek runtime: dosya_yaz_tam(yol, icerik) → yazilan byte
    ver tamam(0);
}

// Dosyaya **ekle** (append).
// YAPILACAK: dosya_ekle runtime primitifi gerek.
işlev ekle(yol: metin, icerik: metin) -> sonuç<tam32, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    ver tamam(0);
}

// Satır ekle — append + newline.
işlev ekle_satir(yol: metin, satir: metin) -> sonuç<tam32, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    // STUB: runtime gelince satir + "\n" eklenir
    ver tamam(0);
}

// =============================================================================
// Sorgu / Yönetim
// =============================================================================

// Var mı (dosya veya dizin).
// YAPILACAK: dosya_var_mi runtime primitifi gerek (stat syscall).
işlev var_mi(yol: metin) -> mantıksal {
    eğer yol == "" { ver yanlış; }
    // STUB: runtime'da stat(yol) != -1 kontrolü
    ver yanlış;
}

// Sil (dosya — dizin değil).
// YAPILACAK: dosya_sil runtime primitifi gerek (unlink syscall).
işlev sil(yol: metin) -> sonuç<tam32, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    // STUB: runtime'da unlink(yol)
    ver tamam(0);
}

// Boyut (byte) — dosya boyutu.
// YAPILACAK: dosya_boyut runtime primitifi gerek (stat.st_size).
işlev boyut(yol: metin) -> sonuç<tam64, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    // STUB
    değişken s: tam64 = 0;
    ver tamam(s);
}

// Yeniden adlandır.
// YAPILACAK: dosya_yeniden_adlandir runtime primitifi gerek (rename).
işlev yeniden_adlandir(eski: metin, yeni: metin) -> sonuç<tam32, metin> {
    eğer eski == "" { ver hata("bos eski yol"); }
    eğer yeni == "" { ver hata("bos yeni yol"); }
    ver tamam(0);
}

// Kopyala.
// YAPILACAK: read + write loop (oku_metin + yaz_metin üzerinden).
işlev kopyala(kaynak: metin, hedef: metin) -> sonuç<tam32, metin> {
    eğer kaynak == "" { ver hata("bos kaynak"); }
    eğer hedef == "" { ver hata("bos hedef"); }
    // STUB: gerçek implementasyon: oku_metin(kaynak) → yaz_metin(hedef)
    ver tamam(0);
}
