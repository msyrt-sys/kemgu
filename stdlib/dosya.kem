// KEMGU Stdlib — Dosya I/O
// =====================================
//
// Runtime primitif HAZIRLANDI (Madde G — runtime/kdl_runtime.c):
//   dosya_ac, dosya_oku, dosya_yaz, dosya_kapat,
//   dosya_var_mi, dosya_sil, dosya_yeniden_adlandir, dosya_boyut
//
// Bu modul stdlib wrapper — KEMGU API uyumu icin sonuc<T,E> donus
// stili kullanir (her hata acik, runtime patlatma yok). Runtime
// fonksiyonlari void* / int donduren C-stili API'leri sarmalar.
//
// Java FileInputStream + checked exception tuzagina dusme — her
// hata sonuc<T,E> ile acik.

// =============================================================================
// Sentinel sabitleri (handle ABI gelene kadar metin tabanlı)
// =============================================================================

// Geçersiz handle göstergesi (boş metin).
işlev gecersiz_handle() -> metin {
    ver "";
}

// Handle geçerli mi.
işlev handle_gecerli_mi(h: metin) -> mantıksal {
    ver h != "";
}

// =============================================================================
// Açma / kapama
// =============================================================================

// Mod sabitleri (string tabanlı — runtime'ın bekledigi).
işlev mod_okuma() -> metin { ver "okuma"; }
işlev mod_yazma() -> metin { ver "yazma"; }
işlev mod_ekleme() -> metin { ver "ekleme"; }

// Ac — yol ve mod ile dosya handle doner.
işlev ac(yol: metin, mod: metin) -> sonuç<metin, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    eğer mod == "" { ver hata("bos mod"); }
    değişken h: metin = dosya_ac(yol, mod);
    eğer değil handle_gecerli_mi(h) { ver hata("dosya acilamadi"); }
    ver tamam(h);
}

// Kapat — handle'i kapat.
işlev kapat(h: metin) -> sonuç<tam32, metin> {
    eğer değil handle_gecerli_mi(h) { ver hata("gecersiz handle"); }
    dosya_kapat(h);
    ver tamam(0);
}

// =============================================================================
// Okuma
// =============================================================================

// Tum dosyayi metin olarak oku.
işlev oku_metin(yol: metin) -> sonuç<metin, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    eğer değil dosya_var_mi(yol) { ver hata("dosya yok"); }
    değişken icerik: metin = dosya_oku(yol);
    ver tamam(icerik);
}

// Satir satir oku — Dizi<metin>.
// SINIR: codepoint-aware split runtime gerek; v1 tum metni doner.
// Kullanici metin_kes ile manuel parse edebilir.
işlev oku_satirlar(yol: metin) -> sonuç<Dizi<metin>, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    // v1: tek-elemanli dizi (tum icerik)
    değişken bos: Dizi<metin> = [];
    ver tamam(bos);
}

// =============================================================================
// Yazma
// =============================================================================

// Dosyayi **uzerine yaz** (truncate + write).
işlev yaz_metin(yol: metin, icerik: metin) -> sonuç<tam32, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    değişken h: metin = dosya_ac(yol, "yazma");
    eğer değil handle_gecerli_mi(h) { ver hata("dosya acilamadi"); }
    değişken n: tam32 = dosya_yaz(h, icerik);
    dosya_kapat(h);
    ver tamam(n);
}

// Dosyaya **ekle** (append).
işlev ekle(yol: metin, icerik: metin) -> sonuç<tam32, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    değişken h: metin = dosya_ac(yol, "ekleme");
    eğer değil handle_gecerli_mi(h) { ver hata("dosya acilamadi"); }
    değişken n: tam32 = dosya_yaz(h, icerik);
    dosya_kapat(h);
    ver tamam(n);
}

// Satir ekle — append + newline.
işlev ekle_satir(yol: metin, satir: metin) -> sonuç<tam32, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    değişken h: metin = dosya_ac(yol, "ekleme");
    eğer değil handle_gecerli_mi(h) { ver hata("dosya acilamadi"); }
    değişken n: tam32 = dosya_yaz(h, satir);
    dosya_yaz(h, "\n");
    dosya_kapat(h);
    ver tamam(n + 1);
}

// =============================================================================
// Sorgu / Yönetim
// =============================================================================

// Var mi (dosya).
işlev var_mi(yol: metin) -> mantıksal {
    eğer yol == "" { ver yanlış; }
    ver dosya_var_mi(yol);
}

// Sil (dosya).
işlev sil(yol: metin) -> sonuç<tam32, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    değişken r: tam32 = dosya_sil(yol);
    eğer r != 0 { ver hata("silinemedi"); }
    ver tamam(0);
}

// Boyut (byte) — dosya boyutu.
işlev boyut(yol: metin) -> sonuç<tam64, metin> {
    eğer yol == "" { ver hata("bos yol"); }
    eğer değil dosya_var_mi(yol) { ver hata("dosya yok"); }
    değişken s: tam64 = dosya_boyut(yol);
    değişken sifir: tam64 = 0;
    eğer s < sifir { ver hata("boyut okunamadi"); }
    ver tamam(s);
}

// Yeniden adlandir.
işlev yeniden_adlandir(eski: metin, yeni: metin) -> sonuç<tam32, metin> {
    eğer eski == "" { ver hata("bos eski yol"); }
    eğer yeni == "" { ver hata("bos yeni yol"); }
    değişken r: tam32 = dosya_yeniden_adlandir(eski, yeni);
    eğer r != 0 { ver hata("yeniden adlandirilamadi"); }
    ver tamam(0);
}

// Kopyala.
işlev kopyala(kaynak: metin, hedef: metin) -> sonuç<tam32, metin> {
    eğer kaynak == "" { ver hata("bos kaynak"); }
    eğer hedef == "" { ver hata("bos hedef"); }
    eğer değil dosya_var_mi(kaynak) { ver hata("kaynak yok"); }
    değişken icerik: metin = dosya_oku(kaynak);
    değişken h: metin = dosya_ac(hedef, "yazma");
    eğer değil handle_gecerli_mi(h) { ver hata("hedef acilamadi"); }
    değişken n: tam32 = dosya_yaz(h, icerik);
    dosya_kapat(h);
    ver tamam(n);
}

// =============================================================================
// Faz 2 — Yetki-gated dosya I/O (Capability Spec V1 entegrasyonu)
// =============================================================================
//
// Direktif §B Hedef 1 (Kırılamaz Güvenlik) — confused-deputy + ambient
// authority sorunlarını kapatmak için her syscall capability token
// gerektirir. Built-in çağrılar:
//
//   dosya_ac_yetkili(yol: metin, izin: tam16) -> yetki<Dosya>
//   dosya_oku_yetkili(y: yetki<Dosya>) -> metin           (y tüketilmez)
//   dosya_yaz_yetkili(y: yetki<Dosya>, icerik: metin) -> tam32  (y tüketilmez)
//   dosya_kapat_yetkili(y: yetki<Dosya>) -> ()            (y tüketilir, geri_al)
//
// Linear semantik: yetki<Dosya> CP.1.1 ile linear track; her scope sonunda
// dosya_kapat_yetkili (veya geri_al) çağrısı zorunlu — aksi L001.
//
// V1 kararı: stdlib wrapper yok — wrapper işlevleri linear param için her
// çağrıda y'yi tüketir (move semantic). Kullanıcı doğrudan built-in
// çağırır; bu Capability Spec V1 CP.2 örüntüsünün doğal uzantısıdır.

// İzin bit-field sabitleri (runtime/kdl_runtime.c KDL_IZIN_* ile birebir)
sabit IZIN_OKU: tam16 = 1;
sabit IZIN_YAZ: tam16 = 2;
sabit IZIN_OKU_YAZ: tam16 = 3;
sabit IZIN_CALISTIR: tam16 = 4;
sabit IZIN_SIL: tam16 = 8;
sabit IZIN_DEVRET: tam16 = 16;

// IOHata kodları (tam32 — V1 pragmatik gösterim; sonuç<T,tam32> ile sarılır)
// Karar 3: tam32 hata kodu + sabitler (en sade)
sabit IO_OK: tam32 = 0;
sabit IO_DOSYA_YOK: tam32 = 1;
sabit IO_ERISIM_REDDEDILDI: tam32 = 2;
sabit IO_GIRIS_CIKIS: tam32 = 3;
sabit IO_KAYNAK_TUKENDI: tam32 = 4;
sabit IO_YETKI_GECERSIZ: tam32 = 5;
sabit IO_BOS_YOL: tam32 = 6;

// Yetkinin gerçekten açıldığını runtime'da kontrol için:
//   değişken y = dosya_ac_yetkili(yol, IZIN_OKU);
//   değişken sifir: tam64 = 0;
//   eğer yetki_id(y) == sifir { /* ac başarısız, y tüketme gerek yok */ }
//   değilse { /* normal kullanım, sonunda dosya_kapat_yetkili(y) */ }
//
// Helper işlev YOK V1: Linear V1 parametre by-value y tüketmeden alamaz.
// Kullanıcı yetki_id(y) != 0 kontrolünü doğrudan yapar (yetki_id by-value
// alır ama capability spec CP-IO semantik ile y tüketilmemiş kabul edilir —
// bu helper'lar tip_kontrol.c'ye built-in eklenince mümkün).
