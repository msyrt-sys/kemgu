// KEMGU Stdlib — Sonuç<T,E>
// ===========================
//
// Madde C — parser fix HAZIRLANDI: `tamam(v) =>` ve `hata(m) =>`
// pattern matching direkt calisir. Hem native sonuc<T,E> API
// hem geri uyumluluk icin KSonuc<T,E> yapi tabanli paralel API
// korundu. Yeni kod native sonuc<T,E> tercih etmelidir.
//
// Madde D — generic callback inference HAZIRLANDI: harita<T,U,E>,
// ya_da<T,E>, bagla<T,U,E> tam generic.
//
// Tasarim kurali: Java exception / Optional.get() tuzagina dusme —
// her hata durumu acik, deferred. C++ exception unwinding maliyeti yok.

// =============================================================================
// 1. Built-in `sonuç<T,E>` construction wrapper'ları
// =============================================================================
// Bu fonksiyonlar derleyici tip çıkarsamasını netleştirir; doğrudan
// `tamam(v)` / `hata(m)` da yazılabilir, ama generic context'te bazen
// wrapper isabetli olur.
//
// CODEGEN KISITI (mevcut, bu modülün tamamını etkiler — tip kontrolünden geçer
// ama --llvm codegen'inde): `sonuç<T, E>` DÖNDÜREN generic fonksiyonlar
// (tamam_yap, hata_yap, harita, harita_hata, bagla, opsiyonel_to_sonuc),
// E i32'ye inmeyen bir tiple (ör. `metin` -> ptr) instantiate edilince yanlış IR
// üretir (dönüş struct'ında E i32 varsayılır). E tamsayı olduğunda doğru çalışır.
// Geçici çözüm: hata tipi olarak tamsayı kod kullanın, ya da doğrudan
// `tamam(v)`/`hata(m)` yazıp sonucu hemen `eşleş` ile tüketin (struct'ı
// fonksiyon sınırından geçirmeyin). Bu codegen sınırı stdlib dışıdır.

işlev tamam_yap<T, E>(d: T) -> sonuç<T, E> {
    ver tamam(d);
}

işlev hata_yap<T, E>(h: E) -> sonuç<T, E> {
    ver hata(h);
}

// --- Sorgular (native sonuc<T,E>) ---

işlev basarili_mi<T, E>(r: sonuç<T, E>) -> mantıksal {
    eşleş r {
        tamam(v) => { ver doğru; }
        hata(e) => { ver yanlış; }
    }
    ver yanlış;
}

işlev basarisiz_mi<T, E>(r: sonuç<T, E>) -> mantıksal {
    eşleş r {
        tamam(v) => { ver yanlış; }
        hata(e) => { ver doğru; }
    }
    ver yanlış;
}

// --- Cozumleme (native sonuc<T,E>) ---

// ya_da — basarili degeri al, hatada varsayilan.
işlev ya_da<T, E>(r: sonuç<T, E>, varsayilan: T) -> T {
    eşleş r {
        tamam(v) => { ver v; }
        hata(e) => { ver varsayilan; }
    }
    ver varsayilan;
}

// Harita<T, U, E> — basarili degere f uygula, hata aynen gecer.
işlev harita<T, U, E>(r: sonuç<T, E>, f: işlev(T) -> U) -> sonuç<U, E> {
    eşleş r {
        tamam(v) => { ver tamam(f(v)); }
        hata(e) => { ver hata(e); }
    }
    /* eşleş tum kollar ver ile bittiginde tip kontrol gecer */
}

// Harita hata<T, E, F> — hatayi f ile yeni hataya cevir.
işlev harita_hata<T, E, F>(r: sonuç<T, E>, f: işlev(E) -> F) -> sonuç<T, F> {
    eşleş r {
        tamam(v) => { ver tamam(v); }
        hata(e) => { ver hata(f(e)); }
    }
}

// Bagla<T, U, E> — basarili ise f cagir (yeni sonuc doner), hata gecer.
// flatMap karsiligi — Madde D ile birlikte calisir.
işlev bagla<T, U, E>(r: sonuç<T, E>, f: işlev(T) -> sonuç<U, E>) -> sonuç<U, E> {
    eşleş r {
        tamam(v) => { ver f(v); }
        hata(e) => { ver hata(e); }
    }
}

// --- Dönüşümler: native seçimlik <-> sonuç ---
// (KSonuc için k_secimlik / k_hata_secimlik var; bunlar native sonuç içindir.)

// Sonuç -> seçimlik — başarılıysa değer, hatada hiç (hata bilgisi atılır).
işlev sonuc_to_opsiyonel<T, E>(r: sonuç<T, E>) -> seçimlik<T> {
    eşleş r {
        tamam(v) => { ver değer(v); }
        hata(e) => { ver hiç; }
    }
    ver hiç;
}

// Sonuç -> seçimlik (hata tarafı) — hatada değer, başarılıda hiç.
işlev sonuc_hata_opsiyonel<T, E>(r: sonuç<T, E>) -> seçimlik<E> {
    eşleş r {
        tamam(v) => { ver hiç; }
        hata(e) => { ver değer(e); }
    }
    ver hiç;
}

// Seçimlik -> sonuç — değer varsa tamam, yoksa verilen hata değeriyle hata.
// Bir Option'a "neden boş" bilgisi eklemenin standart yolu.
// NOT: `sonuç<T, E>` döndürür — yukarıdaki CODEGEN KISITI burada da geçerli
// (E tamsayı olmalı; metin hata kodu için şimdilik tamsayı kullanın).
işlev opsiyonel_to_sonuc<T, E>(opt: seçimlik<T>, hata_degeri: E) -> sonuç<T, E> {
    eşleş opt {
        değer(v) => { ver tamam(v); }
        hiç => { ver hata(hata_degeri); }
    }
    ver hata(hata_degeri);
}

// =============================================================================
// 2. KSonuc<T,E> — Geçici yapı tabanlı sonuç (parser fix gelene kadar)
// =============================================================================

yapı KSonuc<T, E> {
    deger_d: seçimlik<T>;
    hata_d: seçimlik<E>;
}

// --- Yapıcılar ---

işlev k_tamam<T, E>(d: T) -> KSonuc<T, E> {
    ver KSonuc { deger_d: değer(d), hata_d: hiç };
}

işlev k_hata<T, E>(h: E) -> KSonuc<T, E> {
    ver KSonuc { deger_d: hiç, hata_d: değer(h) };
}

// --- Sorgular (tam generic) ---

işlev k_basarili_mi<T, E>(r: KSonuc<T, E>) -> mantıksal {
    eşleş r.deger_d {
        değer(v) => { ver doğru; }
        hiç => { ver yanlış; }
    }
    ver yanlış;
}

işlev k_basarisiz_mi<T, E>(r: KSonuc<T, E>) -> mantıksal {
    eşleş r.hata_d {
        değer(h) => { ver doğru; }
        hiç => { ver yanlış; }
    }
    ver yanlış;
}

// --- Çözümleme (tam generic) ---

// Değer al — yoksa varsayılan.
işlev k_ya_da<T, E>(r: KSonuc<T, E>, varsayilan: T) -> T {
    eşleş r.deger_d {
        değer(v) => { ver v; }
        hiç => { ver varsayilan; }
    }
    ver varsayilan;
}

// Hata al — başarılıysa varsayılan.
işlev k_hata_ya_da<T, E>(r: KSonuc<T, E>, varsayilan: E) -> E {
    eşleş r.hata_d {
        değer(h) => { ver h; }
        hiç => { ver varsayilan; }
    }
    ver varsayilan;
}

// Sonuç → seçimlik dönüşümü.
işlev k_secimlik<T, E>(r: KSonuc<T, E>) -> seçimlik<T> {
    ver r.deger_d;
}

işlev k_hata_secimlik<T, E>(r: KSonuc<T, E>) -> seçimlik<E> {
    ver r.hata_d;
}

// --- Harita (concrete tam32 — generic callback v2'de) ---

// Harita — başarılıysa değere f uygula, başarısız aynen geçer.
işlev k_harita_tam(r: KSonuc<tam32, metin>,
                    f: işlev(tam32) -> tam32) -> KSonuc<tam32, metin> {
    eşleş r.deger_d {
        değer(v) => {
            ver k_tamam(f(v));
        }
        hiç => {
            eşleş r.hata_d {
                değer(h) => { ver k_hata(h); }
                hiç => { ver r; }
            }
            ver r;
        }
    }
    ver r;
}

// Harita_hata — başarısızsa hataya g uygula, başarılı aynen geçer.
işlev k_harita_hata_tam(r: KSonuc<tam32, metin>,
                         g: işlev(metin) -> metin) -> KSonuc<tam32, metin> {
    eşleş r.hata_d {
        değer(h) => {
            ver k_hata(g(h));
        }
        hiç => {
            eşleş r.deger_d {
                değer(v) => { ver k_tamam(v); }
                hiç => { ver r; }
            }
            ver r;
        }
    }
    ver r;
}

// Bağla — başarılıysa f çağır (yeni KSonuc döner). flatMap karşılığı.
işlev k_bagla_tam(r: KSonuc<tam32, metin>,
                   f: işlev(tam32) -> KSonuc<tam32, metin>) -> KSonuc<tam32, metin> {
    eşleş r.deger_d {
        değer(v) => { ver f(v); }
        hiç => {
            eşleş r.hata_d {
                değer(h) => { ver k_hata(h); }
                hiç => { ver r; }
            }
            ver r;
        }
    }
    ver r;
}

// Ya da (alternatif) — ilk başarılıysa onu, başarısızsa ikinciyi.
işlev k_alternatif<T, E>(a: KSonuc<T, E>, b: KSonuc<T, E>) -> KSonuc<T, E> {
    eşleş a.deger_d {
        değer(v) => { ver a; }
        hiç => { ver b; }
    }
    ver b;
}

// Dene — bir KSonuc döndüren f çağrısı, başarılıysa devam, hatalıysa aynen döner.
// "Hatayı yay" (? operatörü gibi) pattern.
işlev k_dene_tam(r: KSonuc<tam32, metin>,
                  devam: işlev(tam32) -> KSonuc<tam32, metin>) -> KSonuc<tam32, metin> {
    ver k_bagla_tam(r, devam);
}

// --- Eşitlik ---

işlev k_esit_mi<T, E>(a: KSonuc<T, E>, b: KSonuc<T, E>) -> mantıksal {
    eşleş a.deger_d {
        değer(va) => {
            eşleş b.deger_d {
                değer(vb) => { ver va == vb; }
                hiç => { ver yanlış; }
            }
            ver yanlış;
        }
        hiç => {
            eşleş a.hata_d {
                değer(ha) => {
                    eşleş b.hata_d {
                        değer(hb) => { ver ha == hb; }
                        hiç => { ver yanlış; }
                    }
                    ver yanlış;
                }
                hiç => {
                    // a tamamen boş — geçersiz durum; b de tamamen boş ise eşit
                    eşleş b.deger_d {
                        değer(vb) => { ver yanlış; }
                        hiç => {
                            eşleş b.hata_d {
                                değer(hb) => { ver yanlış; }
                                hiç => { ver doğru; }
                            }
                            ver yanlış;
                        }
                    }
                    ver yanlış;
                }
            }
            ver yanlış;
        }
    }
    ver yanlış;
}
