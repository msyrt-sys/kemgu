// KEMGU Stdlib — Opsiyonel<T>
// =============================
//
// Saf KEMGU. Hiç bir runtime/FFI bağımlılığı yok.
// seçimlik<T> yardımcıları: değer / hiç pattern matching üzerine
// fonksiyonel API.
//
// Tasarım kuralı:
//   - hiç YOK (null yok), seçimlik<T> ile değer / hiç açık biçim
//   - Pattern matching ile ayrıştırma (kapsamlı)
//   - Java equals/Optional.get() tuzağına düşme — fonksiyonel
//
// Generic callback HAZIRLANDI (Madde D — tip_kontrol multi-param inference).
// harita<T,U>, filtre<T>, bagla<T,U>, ya_da_cagir<T> tam generic.
// Concrete _tam, _metin versiyonlari geri uyumluluk icin korundu;
// yeni kod generic versiyonu kullanmali.

// --- Sorgular (tam generic) ---

// Değer var mı? (değer(v) ise doğru)
işlev var_mi<T>(opt: seçimlik<T>) -> mantıksal {
    eşleş opt {
        değer(v) => { ver doğru; }
        hiç => { ver yanlış; }
    }
    ver yanlış;
}

// Yok mu? (hiç ise doğru)
işlev yok_mu<T>(opt: seçimlik<T>) -> mantıksal {
    eşleş opt {
        değer(v) => { ver yanlış; }
        hiç => { ver doğru; }
    }
    ver doğru;
}

// Boş mu — yok_mu için alias (Türkçe okuma kolaylığı).
işlev bos_mu<T>(opt: seçimlik<T>) -> mantıksal {
    ver yok_mu(opt);
}

// --- Çözüm (tam generic) ---

// Değeri al, yoksa varsayılan döner.
işlev ya_da_varsayilan<T>(opt: seçimlik<T>, varsayilan: T) -> T {
    eşleş opt {
        değer(v) => { ver v; }
        hiç => { ver varsayilan; }
    }
    ver varsayilan;
}

// İki opsiyonel arasında ilk değer olanı döner.
işlev ilk_var<T>(a: seçimlik<T>, b: seçimlik<T>) -> seçimlik<T> {
    eşleş a {
        değer(v) => { ver a; }
        hiç => { ver b; }
    }
    ver b;
}

// İki opsiyonel arasından, ikisi de değer ise A'yı, biri eksikse hiç.
işlev her_iki_var<T>(a: seçimlik<T>, b: seçimlik<T>) -> seçimlik<T> {
    eşleş a {
        değer(v) => {
            eşleş b {
                değer(w) => { ver a; }
                hiç => { ver hiç; }
            }
            ver hiç;
        }
        hiç => { ver hiç; }
    }
    ver hiç;
}

// --- Eşitlik (her T için) ---

// İki opsiyonel değer-eşitliği. Her iki yan değer ise içerikleri karşılaştırılır.
işlev esit_mi<T>(a: seçimlik<T>, b: seçimlik<T>) -> mantıksal {
    eşleş a {
        değer(v) => {
            eşleş b {
                değer(w) => { ver v == w; }
                hiç => { ver yanlış; }
            }
            ver yanlış;
        }
        hiç => {
            eşleş b {
                değer(w) => { ver yanlış; }
                hiç => { ver doğru; }
            }
            ver yanlış;
        }
    }
    ver yanlış;
}

// --- Yapıcılar (yardımcı) ---

// Sarmala — değer<T> üret. (Doğrudan `değer(x)` kullanılabilir; bu sarmalayıcı
// fonksiyonel pipeline'larda kullanışlı.)
işlev sarmala<T>(x: T) -> seçimlik<T> {
    ver değer(x);
}

// Boş — `hiç` üreten yardımcı. Generic context'te tipini açıkça verir.
// Not: parametrik olarak boş üretmek için `<T>` bilgisi gerekiyor;
// şu an sadece concrete tipte test edilebilir.
işlev bos_olustur<T>(rumuz: T) -> seçimlik<T> {
    // rumuz tipi T'yi taşıyor; gerçekte kullanılmıyor
    ver hiç;
}

// --- Harita / Filtre / Bagla (tam generic — Madde D sonrasi) ---

// Harita<T,U> — deger ise f uygula, hic ise hic doner.
işlev harita<T, U>(opt: seçimlik<T>, f: işlev(T) -> U) -> seçimlik<U> {
    eşleş opt {
        değer(v) => { ver değer(f(v)); }
        hiç => { ver hiç; }
    }
    ver hiç;
}

// Filtre<T> — deger ise pred uygula, dogru ise koru, degilse hic.
işlev filtre<T>(opt: seçimlik<T>, pred: işlev(T) -> mantıksal) -> seçimlik<T> {
    eşleş opt {
        değer(v) => {
            eğer pred(v) { ver değer(v); }
            ver hiç;
        }
        hiç => { ver hiç; }
    }
    ver hiç;
}

// Bagla<T,U> — deger ise f cagir (yeni secimlik doner), hic ise hic.
// flatMap karsiligi.
işlev bagla<T, U>(opt: seçimlik<T>, f: işlev(T) -> seçimlik<U>) -> seçimlik<U> {
    eşleş opt {
        değer(v) => { ver f(v); }
        hiç => { ver hiç; }
    }
    ver hiç;
}

// Ya da cagir<T> — deger ise doner, hic ise lazy uretici f'i cagirir.
işlev ya_da_cagir<T>(opt: seçimlik<T>, f: işlev() -> T) -> T {
    eşleş opt {
        değer(v) => { ver v; }
        hiç => { ver f(); }
    }
    /* Asla buraya gelinmemeli — kol gövdeleri her ihtimali kapsiyor.
     * Tip cikarsama icin: f() tipini T cikarsasin. */
    ver f();
}

// Harita-ya-da<T,U> — deger ise f(v) uygula, hic ise varsayilan U doner.
// `harita` + `ya_da_varsayilan` birlesimi; tek geciste U uretir.
işlev harita_ya_da<T, U>(opt: seçimlik<T>, varsayilan: U,
                          f: işlev(T) -> U) -> U {
    eşleş opt {
        değer(v) => { ver f(v); }
        hiç => { ver varsayilan; }
    }
    ver varsayilan;
}

// Say<T> — deger varsa 1, hic ise 0 (opsiyoneli sayilabilir gibi gor).
işlev say<T>(opt: seçimlik<T>) -> tam32 {
    eşleş opt {
        değer(v) => { ver 1; }
        hiç => { ver 0; }
    }
    ver 0;
}

// NOT: `diziye<T>(opt) -> Dizi<T>` (deger->[v], hic->[]) eklenmek istendi ama
// generic dönüş konumunda dizi-literal (`[v]`/`[]`) Dizi<T>'ye çıkarsanamıyor
// (T020). Dönüş-tipi güdümlü literal çıkarsaması gelince eklenebilir.

// --- Harita / Filtre / Bagla (tam32 — concrete, geri uyumluluk) ---

// Harita — deger ise f uygula, hic ise hic doner.
işlev harita_tam(opt: seçimlik<tam32>, f: işlev(tam32) -> tam32) -> seçimlik<tam32> {
    eşleş opt {
        değer(v) => { ver değer(f(v)); }
        hiç => { ver hiç; }
    }
    ver hiç;
}

// Filtre — değer ise pred uygula, doğru ise koru, değilse hiç.
işlev filtre_tam(opt: seçimlik<tam32>, pred: işlev(tam32) -> mantıksal) -> seçimlik<tam32> {
    eşleş opt {
        değer(v) => {
            eğer pred(v) { ver değer(v); }
            ver hiç;
        }
        hiç => { ver hiç; }
    }
    ver hiç;
}

// Bağla — değer ise f çağır (yeni seçimlik döner), hiç ise hiç.
// flatMap karşılığı.
işlev bagla_tam(opt: seçimlik<tam32>, f: işlev(tam32) -> seçimlik<tam32>) -> seçimlik<tam32> {
    eşleş opt {
        değer(v) => { ver f(v); }
        hiç => { ver hiç; }
    }
    ver hiç;
}

// Ya da çağır — değer ise döner, hiç ise lazy üretici f'i çağırır.
işlev ya_da_cagir_tam(opt: seçimlik<tam32>, f: işlev() -> tam32) -> tam32 {
    eşleş opt {
        değer(v) => { ver v; }
        hiç => { ver f(); }
    }
    ver 0;
}

// --- Harita / Filtre (metin) ---

işlev harita_metin(opt: seçimlik<metin>, f: işlev(metin) -> metin) -> seçimlik<metin> {
    eşleş opt {
        değer(v) => { ver değer(f(v)); }
        hiç => { ver hiç; }
    }
    ver hiç;
}

işlev filtre_metin(opt: seçimlik<metin>, pred: işlev(metin) -> mantıksal) -> seçimlik<metin> {
    eşleş opt {
        değer(v) => {
            eğer pred(v) { ver değer(v); }
            ver hiç;
        }
        hiç => { ver hiç; }
    }
    ver hiç;
}
