// KEMGU Stdlib — Metin (String) Manipülasyon
// =============================================
//
// Runtime primitif HAZIRLANDI (Madde A — runtime/kdl_runtime.c):
//   metin_uzunluk, metin_birlestir, metin_kes, metin_kucuk,
//   metin_buyuk, metin_icerir, metin_baslar, metin_biter,
//   metin_kirp, metin_yer_degistir
//
// Bu modül stdlib wrapper — KEMGU-side fonksiyon adlandirma uyumu
// (kucukharf/buyukharf/baslar_ile/biter_ile gibi). Runtime
// fonksiyonlari direkt cagirilabilir; bu modul snake_case Turkce
// adlarla daha doga API sunar.
//
// Not: UTF-8 byte tabanli — kucukharf/buyukharf Turkce I/i pari
// destekli (I->ı, İ->i, ı->I, i->İ); icerir/baslar/biter byte
// karsilastirmasi (UTF-8 prefix-safe); kes byte indeksli
// (multi-byte sequence kirilabilir — codepoint tabanli kes_kp v2'de).

// =============================================================================
// Gerçekten çalışan ops (runtime gerekmiyor)
// =============================================================================

// İki metnin eşit olup olmadığı (== operator metin için literal eşitlik;
// gerçek hash/byte karşılaştırması derleyici dahili).
işlev esit_mi(a: metin, b: metin) -> mantıksal {
    ver a == b;
}

// Farklı mı.
işlev farkli_mi(a: metin, b: metin) -> mantıksal {
    ver a != b;
}

// Boş mu (uzunluk 0).
işlev bos_mu(s: metin) -> mantıksal {
    ver s == "";
}

// Dolu mu.
işlev dolu_mu(s: metin) -> mantıksal {
    ver s != "";
}

// Tek elemanlı opsiyonel sarmalama (helper).
işlev sarmala(s: metin) -> seçimlik<metin> {
    eğer bos_mu(s) { ver hiç; }
    ver değer(s);
}

// =============================================================================
// Runtime primitif tabanli ops (Madde A — runtime baglandi)
// =============================================================================

// Uzunluk — byte sayisi (UTF-8 codepoint sayisi degil).
işlev uzunluk(s: metin) -> tam32 {
    ver metin_uzunluk(s);
}

// Birlestir — iki metni yan yana koy (heap alloc, leak v1 OK).
işlev birlestir(a: metin, b: metin) -> metin {
    ver metin_birlestir(a, b);
}

// Uc metni birlestir.
işlev birlestir_uc(a: metin, b: metin, c: metin) -> metin {
    ver birlestir(birlestir(a, b), c);
}

// Kes (substring) — [baslangic, baslangic+uzunluk) byte aralik.
// Multi-byte UTF-8 sequence kirilabilir — kullanici dikkatli olmali.
işlev kes(s: metin, baslangic: tam32, uzunluk: tam32) -> metin {
    ver metin_kes(s, baslangic, uzunluk);
}

// Bol (split) — ayirac KARAKTERine gore.
// SINIRLAMA: `karakter` tipi tamsayi ile karsilastirilamaz (T001) ve metinden
//   karakter cikaran primitif yok; bu yuzden byte-tabanli gercek bolme bu imzayla
//   yapilamaz. v1: tek elemanli dizi (kendisi) doner. GERCEK bolme icin metin
//   ayirac alan `bol_metin` kullan (asagida) — tam islevsel.
işlev bol(s: metin, ayirac: karakter) -> Dizi<metin> {
    eğer bos_mu(s) { ver []; }
    ver [s];   // STUB: karakter ayirac ile bayt karsilastirma mumkun degil
}

// Kucuk harfe donustur — Turkce I->ı, İ->i (ASCII + UTF-8 farkindali).
işlev kucukharf(s: metin) -> metin {
    ver metin_kucuk(s);
}

// Buyuk harfe donustur — Turkce i->İ, ı->I.
işlev buyukharf(s: metin) -> metin {
    ver metin_buyuk(s);
}

// Icerir — alt metni iceriyor mu (byte tabanli, UTF-8 prefix-safe).
işlev icerir(s: metin, alt: metin) -> mantıksal {
    ver metin_icerir(s, alt);
}

// Ile baslar mi.
işlev baslar_ile(s: metin, prefix: metin) -> mantıksal {
    ver metin_baslar(s, prefix);
}

// Ile biter mi.
işlev biter_ile(s: metin, sufiks: metin) -> mantıksal {
    ver metin_biter(s, sufiks);
}

// Kirp (trim) — basindan ve sonundan ASCII whitespace sil.
işlev kirp(s: metin) -> metin {
    ver metin_kirp(s);
}

// Yer degistir — hedef altmetnin TUM eslemelerini yeni ile degistir.
işlev yer_degistir(s: metin, hedef: metin, yeni: metin) -> metin {
    ver metin_yer_degistir(s, hedef, yeni);
}

// Tekrarla — metni n kez yan yana ver.
işlev tekrarla(s: metin, n: tam32) -> metin {
    eğer n <= 0 { ver ""; }
    değişken r: metin = s;
    değişken i: tam32 = 1;
    iken i < n {
        r = birlestir(r, s);
        i = i + 1;
    }
    ver r;
}

// Bir UTF-8 codepoint'in kac bayttan olustugu — lead (oncu) byte degerinden
// (0..255 isaretsiz) cikarilir. Devam baytlari (128..191) icin guvenli 1 doner.
//   0xxxxxxx (0..127)   -> 1   ASCII
//   110xxxxx (192..223) -> 2
//   1110xxxx (224..239) -> 3
//   11110xxx (240..255) -> 4
işlev cp_bayt_sayisi(lead: tam32) -> tam32 {
    eğer lead >= 240 { ver 4; }
    eğer lead >= 224 { ver 3; }
    eğer lead >= 192 { ver 2; }
    ver 1;
}

// Karakter sayisi — UTF-8 codepoint sayisi (byte degil). Devam baytlari
// (10xxxxxx) sayilmaz; her oncu byte bir karakter. Turkce metinde dogru
// sonuc verir (ornek: "çığ" -> 6 byte ama 3 karakter).
işlev karakter_sayisi(s: metin) -> tam32 {
    değişken L: tam32 = metin_uzunluk(s);
    değişken sayi: tam32 = 0;
    değişken i: tam32 = 0;
    iken i < L {
        değişken u: tam32 = metin_bayt(s, i) olarak tam32;
        eğer u < 0 { u = u + 256; }   // tam8 isaretli -> isaretsiz 0..255   // tam8 isaretli -> isaretsiz 0..255
        eğer u < 128 {
            sayi = sayi + 1;          // ASCII
        } değilse eğer u >= 192 {
            sayi = sayi + 1;          // multibyte oncu byte
        }
        // 128..191: devam byte -> sayilmaz
        i = i + 1;
    }
    ver sayi;
}

// Yansitma (reverse) — codepoint-aware ters cevirme. Her UTF-8 codepoint'i
// bir butun olarak one ekler; multi-byte Turkce karakterler bozulmaz
// (ornek: "açb" -> "bça"). Byte tabanli ters cevirmenin aksine UTF-8 guvenli.
işlev yansit(s: metin) -> metin {
    değişken L: tam32 = metin_uzunluk(s);
    değişken r: metin = "";
    değişken i: tam32 = 0;
    iken i < L {
        değişken u: tam32 = metin_bayt(s, i) olarak tam32;
        eğer u < 0 { u = u + 256; }   // tam8 isaretli -> isaretsiz 0..255
        değişken cu: tam32 = cp_bayt_sayisi(u);
        // i'den baslayan codepoint'i mevcut sonucun ONUNE ekle
        r = birlestir(metin_kes(s, i, cu), r);
        i = i + cu;
    }
    ver r;
}

// =============================================================================
// Genişletme — gerçek bölme/birleştirme/arama (metin_bayt + metin_kes tabanlı)
// =============================================================================
//
// Hepsi byte-indeksli runtime primitifleri (metin_uzunluk, metin_bayt,
// metin_kes, metin_esit, metin_birlestir) üzerine; yeni runtime gerekmez.
// `metin` ayraç alan sürümler `karakter` tipindeki kısıtlamayı aşar
// (karakter tamsayı ile karşılaştırılamaz).

// Bol_metin (split) — `ayrac` alt metnine göre böl, Dizi<metin> ver.
// `bol`'un (karakter ayraç) gerçek işlevsel eşi. Ardışık ayraçlar boş parça
// üretir ("a,,b" -> ["a","","b"]). Boş kaynak -> boş dizi.
// Boş ayrac -> tek parça (kaynağın kendisi).
işlev bol_metin(s: metin, ayrac: metin) -> Dizi<metin> {
    değişken sonuc: Dizi<metin> = dizi_olustur(0);
    eğer bos_mu(s) { ver sonuc; }
    değişken M: tam32 = metin_uzunluk(ayrac);
    eğer M == 0 {
        dizi_ekle(sonuc, s);
        ver sonuc;
    }
    değişken L: tam32 = metin_uzunluk(s);
    değişken parca_bas: tam32 = 0;
    değişken i: tam32 = 0;
    iken i <= L - M {
        eğer metin_esit(metin_kes(s, i, M), ayrac) {
            dizi_ekle(sonuc, metin_kes(s, parca_bas, i - parca_bas));
            i = i + M;
            parca_bas = i;
        } değilse {
            i = i + 1;
        }
    }
    // Son parçayı ekle (son ayraçtan sonu).
    dizi_ekle(sonuc, metin_kes(s, parca_bas, L - parca_bas));
    ver sonuc;
}

// Birleştir_liste (join) — parçaları ayraç ile birleştir. bol_metin'in tersi.
// Boş dizi -> "". Tek eleman -> o eleman (ayraç eklenmez).
işlev birlestir_liste(parcalar: Dizi<metin>, ayrac: metin) -> metin {
    değişken r: metin = "";
    değişken ilk_mi: mantıksal = doğru;
    için p: parcalar {
        eğer ilk_mi {
            r = p;
            ilk_mi = yanlış;
        } değilse {
            r = birlestir(birlestir(r, ayrac), p);
        }
    }
    ver r;
}

// İndeks — `alt` alt metninin `s` içindeki ilk BYTE konumu (yoksa hiç).
// Boş alt -> değer(0). Byte-indeksli (codepoint değil).
işlev indeks(s: metin, alt: metin) -> seçimlik<tam32> {
    değişken M: tam32 = metin_uzunluk(alt);
    eğer M == 0 { ver değer(0); }
    değişken L: tam32 = metin_uzunluk(s);
    eğer M > L { ver hiç; }
    değişken i: tam32 = 0;
    iken i <= L - M {
        eğer metin_esit(metin_kes(s, i, M), alt) { ver değer(i); }
        i = i + 1;
    }
    ver hiç;
}

// Say — `alt` alt metninin örtüşmeyen geçiş sayısı. Boş alt -> 0.
işlev say(s: metin, alt: metin) -> tam32 {
    değişken M: tam32 = metin_uzunluk(alt);
    eğer M == 0 { ver 0; }
    değişken L: tam32 = metin_uzunluk(s);
    eğer M > L { ver 0; }
    değişken n: tam32 = 0;
    değişken i: tam32 = 0;
    iken i <= L - M {
        eğer metin_esit(metin_kes(s, i, M), alt) {
            n = n + 1;
            i = i + M;   // örtüşmeyen
        } değilse {
            i = i + 1;
        }
    }
    ver n;
}

// Ön_ek_kaldir — `on` ile başlıyorsa o ön eki sil; değilse aynen ver.
işlev on_ek_kaldir(s: metin, on: metin) -> metin {
    eğer baslar_ile(s, on) {
        değişken n: tam32 = metin_uzunluk(on);
        ver metin_kes(s, n, metin_uzunluk(s) - n);
    }
    ver s;
}

// Son_ek_kaldir — `son` ile bitiyorsa o son eki sil; değilse aynen ver.
işlev son_ek_kaldir(s: metin, son: metin) -> metin {
    eğer biter_ile(s, son) {
        değişken n: tam32 = metin_uzunluk(s) - metin_uzunluk(son);
        ver metin_kes(s, 0, n);
    }
    ver s;
}

// Doldur_sol (left pad) — `s`'yi soluna `dolgu` ekleyerek hedef KARAKTER
// uzunluğuna getir. Mevcut uzunluk >= hedef ise aynen ver. `dolgu` tek karakter
// varsayılır (codepoint sayısı bazlı). Sayı hizalama için tipik kullanım.
işlev doldur_sol(s: metin, hedef_uz: tam32, dolgu: metin) -> metin {
    değişken mevcut: tam32 = karakter_sayisi(s);
    eğer mevcut >= hedef_uz { ver s; }
    ver birlestir(tekrarla(dolgu, hedef_uz - mevcut), s);
}

// Doldur_sag (right pad) — sağına `dolgu` ekleyerek hedef uzunluğa getir.
işlev doldur_sag(s: metin, hedef_uz: tam32, dolgu: metin) -> metin {
    değişken mevcut: tam32 = karakter_sayisi(s);
    eğer mevcut >= hedef_uz { ver s; }
    ver birlestir(s, tekrarla(dolgu, hedef_uz - mevcut));
}

// Başharf_büyüt — ilk codepoint'i büyük harfe çevir, kalanı aynen bırak.
// buyukharf Türkçe-farkında (i->İ). Boş metin -> "".
işlev basharf_buyut(s: metin) -> metin {
    eğer bos_mu(s) { ver s; }
    değişken u: tam32 = metin_bayt(s, 0) olarak tam32;
    eğer u < 0 { u = u + 256; }
    değişken cu: tam32 = cp_bayt_sayisi(u);
    değişken bas: metin = buyukharf(metin_kes(s, 0, cu));
    değişken kalan: metin = metin_kes(s, cu, metin_uzunluk(s) - cu);
    ver birlestir(bas, kalan);
}

// =============================================================================
// Genişletme 2 — tüm-geçiş indeksleri + tek değiştirme + arası-kes + sınıflama
// =============================================================================
//
// Hepsi mevcut byte-indeksli runtime primitifleri (metin_uzunluk, metin_bayt,
// metin_kes, metin_esit, metin_birlestir) + modül-içi indeks/cp_bayt_sayisi
// üzerine; yeni runtime gerekmez.
//
// NOT: alt-metin sayımı için zaten `say(s, alt)` (örtüşmeyen geçiş sayısı)
// vardır — ayrı bir `say_alt` eklenmedi (tekrar olurdu).

// Bul_tüm — `alt` alt metninin TÜM (örtüşmeyen) başlangıç byte indeksleri.
// `say` ile tutarlı: eşleşince M kadar atlar. Boş alt -> boş dizi.
işlev bul_tum(s: metin, alt: metin) -> Dizi<tam32> {
    değişken sonuc: Dizi<tam32> = dizi_olustur(0);
    değişken M: tam32 = metin_uzunluk(alt);
    eğer M == 0 { ver sonuc; }
    değişken L: tam32 = metin_uzunluk(s);
    eğer M > L { ver sonuc; }
    değişken i: tam32 = 0;
    iken i <= L - M {
        eğer metin_esit(metin_kes(s, i, M), alt) {
            dizi_ekle(sonuc, i);
            i = i + M;   // örtüşmeyen
        } değilse {
            i = i + 1;
        }
    }
    ver sonuc;
}

// Değiştir_ilk — `hedef`in YALNIZ ilk geçişini `yeni` ile değiştir. `yer_degistir`
// tümünü değiştirir; bu yalnız ilkini. Bulunamaz/boş hedef -> aynen ver.
işlev degistir_ilk(s: metin, hedef: metin, yeni: metin) -> metin {
    değişken M: tam32 = metin_uzunluk(hedef);
    eğer M == 0 { ver s; }
    eşleş indeks(s, hedef) {
        değer(i) => {
            değişken L: tam32 = metin_uzunluk(s);
            değişken on: metin = metin_kes(s, 0, i);
            değişken arka: metin = metin_kes(s, i + M, L - i - M);
            ver birlestir(birlestir(on, yeni), arka);
        }
        hiç => { ver s; }
    }
    ver s;
}

// Kes_arası — `bas` ve `son` ayraçları arasındaki metin (seçimlik). `bas`
// bulunamaz veya `bas`tan sonra `son` bulunamazsa hiç. `son`, `bas`ın bittiği
// konumdan sonra aranır (örtüşme yok). Ayraçlar sonuca dahil değildir.
işlev kes_arasi(s: metin, bas: metin, son: metin) -> seçimlik<metin> {
    eşleş indeks(s, bas) {
        değer(ib) => {
            değişken L: tam32 = metin_uzunluk(s);
            değişken ic_bas: tam32 = ib + metin_uzunluk(bas);
            değişken kuyruk: metin = metin_kes(s, ic_bas, L - ic_bas);
            eşleş indeks(kuyruk, son) {
                değer(rel) => { ver değer(metin_kes(kuyruk, 0, rel)); }
                hiç => { ver hiç; }
            }
        }
        hiç => { ver hiç; }
    }
    ver hiç;
}

// ASCII harf mi (A-Z / a-z).
işlev ascii_harf_mi(u: tam32) -> mantıksal {
    eğer u >= 65 ve u <= 90 { ver doğru; }
    eğer u >= 97 ve u <= 122 { ver doğru; }
    ver yanlış;
}

// İki baytlık UTF-8 dizisi (b0, b1) Türkçe'ye özgü bir harf mi:
//   ç Ç ö Ö ü Ü (lead 0xC3) | ğ Ğ ı İ (lead 0xC4) | ş Ş (lead 0xC5).
// Türkçe alfabe dışındaki Latin-1 işaretlileri (é, à, ñ ...) kapsamaz.
işlev tr_harf_2byte(b0: tam32, b1: tam32) -> mantıksal {
    eğer b0 == 195 {                 // 0xC3
        eğer b1 == 167 { ver doğru; }   // ç
        eğer b1 == 135 { ver doğru; }   // Ç
        eğer b1 == 182 { ver doğru; }   // ö
        eğer b1 == 150 { ver doğru; }   // Ö
        eğer b1 == 188 { ver doğru; }   // ü
        eğer b1 == 156 { ver doğru; }   // Ü
        ver yanlış;
    }
    eğer b0 == 196 {                 // 0xC4
        eğer b1 == 159 { ver doğru; }   // ğ
        eğer b1 == 158 { ver doğru; }   // Ğ
        eğer b1 == 177 { ver doğru; }   // ı
        eğer b1 == 176 { ver doğru; }   // İ
        ver yanlış;
    }
    eğer b0 == 197 {                 // 0xC5
        eğer b1 == 159 { ver doğru; }   // ş
        eğer b1 == 158 { ver doğru; }   // Ş
        ver yanlış;
    }
    ver yanlış;
}

// Sadece_rakam_mı — boş olmayan metnin TÜM baytları ASCII rakam ('0'..'9') mı.
// Boş metin -> yanlış.
işlev sadece_rakam_mi(s: metin) -> mantıksal {
    değişken L: tam32 = metin_uzunluk(s);
    eğer L == 0 { ver yanlış; }
    değişken i: tam32 = 0;
    iken i < L {
        değişken u: tam32 = metin_bayt(s, i) olarak tam32;
        eğer u < 0 { u = u + 256; }
        eğer u < 48 { ver yanlış; }
        eğer u > 57 { ver yanlış; }
        i = i + 1;
    }
    ver doğru;
}

// Sadece_harf_mı — boş olmayan metnin TÜM karakterleri harf mi: ASCII A-Z/a-z
// + Türkçe (ç ğ ı i ö ş ü ve büyükleri). UTF-8 codepoint-aware; rakam, boşluk,
// noktalama ve 3+ baytlık codepoint'ler -> yanlış. Boş metin -> yanlış.
işlev sadece_harf_mi(s: metin) -> mantıksal {
    değişken L: tam32 = metin_uzunluk(s);
    eğer L == 0 { ver yanlış; }
    değişken i: tam32 = 0;
    iken i < L {
        değişken u: tam32 = metin_bayt(s, i) olarak tam32;
        eğer u < 0 { u = u + 256; }
        değişken cu: tam32 = cp_bayt_sayisi(u);
        eğer cu == 1 {
            eğer değil ascii_harf_mi(u) { ver yanlış; }
            i = i + 1;
        } değilse eğer cu == 2 {
            eğer i + 1 >= L { ver yanlış; }
            değişken b1: tam32 = metin_bayt(s, i + 1) olarak tam32;
            eğer b1 < 0 { b1 = b1 + 256; }
            eğer değil tr_harf_2byte(u, b1) { ver yanlış; }
            i = i + 2;
        } değilse {
            ver yanlış;
        }
    }
    ver doğru;
}
