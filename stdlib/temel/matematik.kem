// KEMGU Stdlib — Temel Matematik
// =================================
//
// Saf KEMGU. Hiç bir runtime/FFI bağımlılığı yok.
// Her işlev generic — derleme sırasında her tip için ayrı instantiation.
//
// Tasarım kuralı: her işlev tek bir sorumluluğa sahip, açık adlandırma,
// yan-etki yok. Diğer dillerin hatalarından kaçınılan noktalar:
//   - C: int taşması serbest; KEMGU: tipe göre kontrollü
//   - Python: sayısal tip muğlak; KEMGU: explicit tip
//   - Go: yıllarca generic yoktu; KEMGU: gün 1'den generic

işlev mutlak<T>(x: T) -> T {
    eğer x < 0 { ver 0 - x; }
    ver x;
}

işlev en_kucuk<T>(a: T, b: T) -> T {
    eğer a < b { ver a; }
    ver b;
}

işlev en_buyuk<T>(a: T, b: T) -> T {
    eğer a > b { ver a; }
    ver b;
}

// Kare: x * x. Generic; her sayısal tip için çalışır.
işlev kare<T>(x: T) -> T {
    ver x * x;
}

// Küp: x * x * x.
işlev kup<T>(x: T) -> T {
    ver x * x * x;
}

// Sınırlandır: x'i [alt, ust] aralığına çek.
işlev sinirla<T>(x: T, alt: T, ust: T) -> T {
    eğer x < alt { ver alt; }
    eğer x > ust { ver ust; }
    ver x;
}

// İşaret: -1 negatif, 0 sıfır, +1 pozitif. tam32 döndürür.
işlev isaret<T>(x: T) -> tam32 {
    eğer x < 0 { ver 0 - 1; }
    eğer x > 0 { ver 1; }
    ver 0;
}

// =============================================================================
// Genişletme — kuvvet, kök, mod, asal_mi, fibonacci, faktöriyel, çift_mi, tek_mi
// =============================================================================
//
// Bu bölümdeki işlevler yalnızca tamsayı tiplerle çalışır (kuvvet hariç).
// Literal tip çıkarsama sınırı nedeniyle prime/fib/faktöriyel için
// tam32 sabit tip kullanıyoruz (literal 2 generic T'ye atanamıyor).
// Generic versiyon constraint satisfaction (Sayı/Tam özelliği) sonrası.

// Kuvvet — x^n. n=0 için x döner (constraint sistemi yokken "bir<T>()" yazılamaz).
// [D-454] x⁰ = 1. ESKİDEN `ver x;` idi — matematiksel olarak YANLIŞTI ama
// generic `T` içinde `ver 1;` yazmak T020 veriyordu (sayısal literali T'ye
// bağlayacak constraint sistemi yok). `bir()` intrinsic'i tam bu boşluk için
// eklendi: dönüş tipi BEKLENEN'den gelir, monomorfizasyonda somutlaşır.
// D-441 bu kusuru testle SABİTLEMİŞTİ; artık gerçek değer dönüyor.
işlev kuvvet<T>(x: T, n: tam32) -> T {
    eğer n == 0 { ver bir(); }
    değişken sonuc: T = x;
    değişken i: tam32 = 1;
    iken i < n {
        sonuc = sonuc * x;
        i = i + 1;
    }
    ver sonuc;
}

// Kök — tamsayı karekök (Newton-Raphson). n < 0 için 0 döner.
işlev kok_tam(n: tam32) -> tam32 {
    eğer n < 2 { ver n; }
    değişken x: tam32 = n;
    değişken y: tam32 = (x + 1) / 2;
    iken y < x {
        x = y;
        y = (x + n / x) / 2;
    }
    ver x;
}

// Modulo — a % b (generic; tüm sayısal tipler).
işlev mod<T>(a: T, b: T) -> T {
    ver a % b;
}

// Asal mı — trial division. n <= 1 için yanlış, n == 2 için doğru.
işlev asal_mi(n: tam32) -> mantıksal {
    eğer n < 2 { ver yanlış; }
    eğer n == 2 { ver doğru; }
    eğer n % 2 == 0 { ver yanlış; }
    değişken i: tam32 = 3;
    iken i * i <= n {
        eğer n % i == 0 { ver yanlış; }
        i = i + 2;
    }
    ver doğru;
}

// Fibonacci — n. terim (0-tabanlı: fib(0)=0, fib(1)=1, fib(2)=1, ...).
// tam32 döner — overflow ~46. terimde. tam64 versiyonu için
// fibonacci_genis (tip int conversion'i olmadığı için ayrı imza).
işlev fibonacci(n: tam32) -> tam32 {
    eğer n < 2 { ver n; }
    değişken a: tam32 = 0;
    değişken b: tam32 = 1;
    değişken i: tam32 = 2;
    iken i <= n {
        değişken t: tam32 = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    ver b;
}

// Faktöriyel — n! (n < 0 için 1, n=0 için 1).
// tam32 döner — 12! sığar, 13! taşar.
işlev faktoriyel(n: tam32) -> tam32 {
    eğer n < 1 { ver 1; }
    değişken sonuc: tam32 = 1;
    değişken i: tam32 = 1;
    iken i <= n {
        sonuc = sonuc * i;
        i = i + 1;
    }
    ver sonuc;
}

// Çift mi — n % 2 == 0.
işlev cift_mi<T>(n: T) -> mantıksal {
    ver n % 2 == 0;
}

// Tek mi — n % 2 != 0.
işlev tek_mi<T>(n: T) -> mantıksal {
    ver n % 2 != 0;
}

// Negatif mi.
işlev negatif_mi<T>(x: T) -> mantıksal {
    ver x < 0;
}

// Pozitif mi (sıfır dahil değil).
işlev pozitif_mi<T>(x: T) -> mantıksal {
    ver x > 0;
}

// Sıfır mı.
işlev sifir_mi<T>(x: T) -> mantıksal {
    ver x == 0;
}

// İki kat (ikiyle çarp).
işlev iki_kat<T>(x: T) -> T {
    ver x * 2;
}

// Yarısı (ikiye böl).
işlev yarisi<T>(x: T) -> T {
    ver x / 2;
}

// =============================================================================
// Genişletme — dizi OBEB/EKOK + modüler üs + kombinatorik + sayı palindromu
// =============================================================================
//
// Saf KEMGU; yeni runtime/primitif yok. Modül self-contained (import yok) →
// OBEB/EKOK için yerel Öklid yardımcıları (sayisal.kem'deki obe/ekok'tan
// bağımsız). Taşma riski olan hesaplar (modüler üs, kombinatorik) ara
// değerleri tam64'te tutar.

// İki tamsayının OBEB'i (GCD) — Öklid; ikili_obeb(0, x) = x.
işlev ikili_obeb(a: tam32, b: tam32) -> tam32 {
    değişken x: tam32 = a;
    değişken y: tam32 = b;
    iken y != 0 {
        değişken t: tam32 = y;
        y = x % y;
        x = t;
    }
    ver x;
}

// İki tamsayının EKOK'u (LCM). a veya b sıfırsa 0 (taşmayı önlemek için
// önce böl: a / obeb * b).
işlev ikili_ekok(a: tam32, b: tam32) -> tam32 {
    eğer a == 0 { ver 0; }
    eğer b == 0 { ver 0; }
    ver (a / ikili_obeb(a, b)) * b;
}

// OBEB_dizi — dizideki tüm sayıların OBEB'i. Boş dizi -> 0; negatifler
// mutlak değere indirgenir; tek eleman -> |o eleman|.
işlev obeb_dizi(xs: Dizi<tam32>) -> tam32 {
    değişken g: tam32 = 0;
    için x: xs {
        g = ikili_obeb(g, mutlak(x));
    }
    ver g;
}

// EKOK_dizi — dizideki tüm sayıların EKOK'u. Boş dizi -> 1 (çarpımsal birim);
// herhangi bir eleman 0 ise 0; negatifler mutlak değere indirgenir.
işlev ekok_dizi(xs: Dizi<tam32>) -> tam32 {
    değişken l: tam32 = 1;
    için x: xs {
        l = ikili_ekok(l, mutlak(x));
    }
    ver l;
}

// Modüler üs — (taban^us) mod m, hızlı üs (kareleme yöntemi). Ara çarpımlar
// tam64'te hesaplanır → tam32 taşması önlenir. us >= 0, m >= 1 varsayılır;
// m == 1 -> 0. Negatif taban normalleştirilir.
işlev us_mod(taban: tam32, us: tam32, m: tam32) -> tam32 {
    değişken mm: tam64 = m olarak tam64;
    eğer mm == 1 { ver 0; }
    değişken sonuc: tam64 = 1;
    değişken t: tam64 = (taban olarak tam64) % mm;
    eğer t < 0 { t = t + mm; }
    değişken e: tam32 = us;
    iken e > 0 {
        eğer e % 2 == 1 { sonuc = (sonuc * t) % mm; }
        t = (t * t) % mm;
        e = e / 2;
    }
    ver sonuc olarak tam32;
}

// Kombinasyon — C(n, k) binom katsayısı. Çarpımsal formül (her adımda tam
// bölünme garantili) + tam64 ara değer. k < 0 veya k > n -> 0; simetri ile
// k = min(k, n-k) alınarak iterasyon azaltılır.
işlev kombinasyon(n: tam32, k: tam32) -> tam64 {
    eğer k < 0 { ver 0; }
    eğer k > n { ver 0; }
    değişken kk: tam32 = k;
    eğer kk > n - kk { kk = n - kk; }
    değişken sonuc: tam64 = 1;
    değişken i: tam32 = 0;
    iken i < kk {
        sonuc = sonuc * ((n - i) olarak tam64);
        sonuc = sonuc / ((i + 1) olarak tam64);
        i = i + 1;
    }
    ver sonuc;
}

// Permütasyon — P(n, k) = n!/(n-k)! = n·(n-1)···(n-k+1). tam64 ara değer.
// k < 0 veya k > n -> 0; k = 0 -> 1.
işlev permutasyon(n: tam32, k: tam32) -> tam64 {
    eğer k < 0 { ver 0; }
    eğer k > n { ver 0; }
    değişken sonuc: tam64 = 1;
    değişken i: tam32 = 0;
    iken i < k {
        sonuc = sonuc * ((n - i) olarak tam64);
        i = i + 1;
    }
    ver sonuc;
}

// Palindrom_mu — sayının ondalık basamakları simetrik mi. Negatif -> yanlış;
// 0 -> doğru. Ters çevirme tam64'te (tam32 ters çevirme taşabilir).
işlev palindrom_mu(n: tam32) -> mantıksal {
    eğer n < 0 { ver yanlış; }
    değişken ters: tam64 = 0;
    değişken kalan: tam32 = n;
    iken kalan > 0 {
        ters = ters * 10 + ((kalan % 10) olarak tam64);
        kalan = kalan / 10;
    }
    ver ters == (n olarak tam64);
}
