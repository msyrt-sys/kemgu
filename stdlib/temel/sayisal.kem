// KEMGU Stdlib — Sayısal Yardımcılar
// ===================================
//
// Tamsayı + kesirli için generic algoritmalar.
//
// Tasarım kuralı: Hesap makinesi seviyesinde işlevler. Compile-time'da
// her tip için ayrı specialized kod (monomorphization).

// İki sayının ortalaması (taşma riski azaltılmış: (a/2 + b/2) yerine
// basitleştirilmiş — tipler küçükse taşabilir; ileride güvenli versiyon).
işlev ortalama<T>(a: T, b: T) -> T {
    ver (a + b) / 2;
}

// Üs hesabi: x^n (n negatif olmaz). n=0 -> 1.
işlev us<T>(x: T, n: tam32) -> T {
    değişken sonuc: T = x;
    değişken i: tam32 = 1;
    eğer n == 0 {
        // n=0 icin "1" T tipinde donmemiz lazim — bu kisitlama
        // generic'lerin gercek constraint sistemine ihtiyac duyar.
        // Su an: x'i kendine bolmek 1 verir (ama 0 icin tanimsiz).
        // Pragmatik: x*0 + 1 yerine 1'i T'ye literally cevirmek icin
        // tipik bir yaklasim "sifir<T>()" + "bir<T>()" helper'i.
        // Su an: rekursif uretim — n=0 cagrilirsa x'in tipini buyutmek
        // icin sahte hesap: x - x + 1. Ama bu yine literal yorumu.
        // En basiti: kullanici n>0 ile cagirsin.
        ver sonuc;  // n=0 yerine "ozur dilerim" sonucu (1.0/0 yerine x)
    }
    iken i < n {
        sonuc = sonuc * x;
        i = i + 1;
    }
    ver sonuc;
}

// İki tamsayinin OBE'si (GCD) — Öklid algoritması, tamsayı için.
işlev obe<T>(a: T, b: T) -> T {
    değişken x: T = a;
    değişken y: T = b;
    iken y != 0 {
        değişken t: T = y;
        y = x % y;
        x = t;
    }
    ver x;
}

// İki tamsayinin EKOK'u (LCM). a*b/obe(a,b)
işlev ekok<T>(a: T, b: T) -> T {
    ver (a * b) / obe(a, b);
}
